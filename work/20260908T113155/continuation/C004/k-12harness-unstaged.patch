+# In pydantic-ai 1.106.0, a single (non-union) output type uses "final_result"
+# as the tool name (see tests/unit/test_intent_boundary.py). Both the intent
+# and narration agents have single output types.
+INTENT_TOOL = "final_result"
+NARRATION_TOOL = "final_result"
+
+
+def make_intent_model(intent: StructuredIntent) -> FunctionModel:
+    """A model that returns a fixed StructuredIntent immediately."""
+    payload = intent.model_dump()
+
+    def fn(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:
+        return ModelResponse(parts=[ToolCallPart(INTENT_TOOL, payload)])
+
+    return FunctionModel(fn)
+
+
+def make_narration_model(answer: str) -> FunctionModel:
+    """A model that returns fixed narration immediately."""
+
+    def fn(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:
+        return ModelResponse(parts=[ToolCallPart(NARRATION_TOOL, {"answer": answer})])
+
+    return FunctionModel(fn)
+
+
+def _drop_generated_utc(output: dict) -> dict:
+    """Two separate stub-emitter fetches stamp `provenance.generated_utc` with
+    the wall clock at call time (second precision), so two runs a moment apart
+    can legitimately disagree on that one field alone — the same reason
+    `evals/schema.py` notes the replay-equality rule excludes it (CR-6). Strip
+    it before comparing two records for otherwise-exact equality."""
+    out = dict(output)
+    provenance = out.get("provenance")
+    if isinstance(provenance, dict) and "generated_utc" in provenance:
+        out = dict(out)
+        out["provenance"] = {k: v for k, v in provenance.items() if k != "generated_utc"}
+    return out
+
 
