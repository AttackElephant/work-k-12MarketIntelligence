+def test_stage_intent_survives_a_live_run():
+    """The genuinely isolated intent stage: one model call, no evidence fetch,
+    no rendering — `evals.live.run_trial(..., stage="intent")`."""
+    case = CASES["answer/VC-POC-01"]
+    result, record = asyncio.run(
+        live.run_trial(case, case.phrasings[0], 1, EMITTER, stage="intent")
+    )
+    assert result.passed, result.detail
+    assert record is None, "the intent stage makes no tool calls, so there is no transcript"
+
+
+def test_stage_narration_survives_a_live_run():
+    """The genuinely isolated narration stage: one model call over the stub
+    oracle envelope (`build_client("stub", case.stub_case)`) the stage fetches
+    itself, never the model's own request and never `EMITTER` (PF-1: the
+    narration oracle is always the stub emitter, regardless of --emitter)."""
+    case = next(c for c in CASES.values() if c.stub_case is not None)
+    result, record = asyncio.run(
+        live.run_trial(case, case.phrasings[0], 1, EMITTER, stage="narration")
+    )
+    assert result.passed, result.detail
+    assert record is not None
+    assert len(record.tool_calls) == 1
+    assert record.tool_calls[0].tool == "fetch_evidence"
+
+
+def test_stage_end_to_end_survives_a_live_run():
+    """`--stage end-to-end`: the real new-pipeline `ask(deps, question)`, k=1."""
+    case = CASES["answer/VC-POC-REF-01"]
+    result, record = asyncio.run(
+        live.run_trial(case, case.phrasings[0], 1, EMITTER, stage="end-to-end")
+    )
+    assert result.passed, result.detail
+    assert record is not None
+
