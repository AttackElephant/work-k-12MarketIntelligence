+    wrong_intent = StructuredIntent(question_id="excluded", excluded_topic="finance")
+
+    result_a, record_a = asyncio.run(
+        live.run_trial(
+            case, case.phrasings[0], 1, "stub", stage="narration",
+            intent_model=make_intent_model(correct_intent),
+            narration_model=make_narration_model(reference_answer),
+        )
+    )
+    result_b, record_b = asyncio.run(
+        live.run_trial(
+            case, case.phrasings[0], 1, "stub", stage="narration",
+            intent_model=make_intent_model(wrong_intent),
+            narration_model=make_narration_model(reference_answer),
+        )
+    )
+    assert result_a.passed == result_b.passed
+    assert result_a.failed_graders == result_b.failed_graders
+    assert _drop_generated_utc(record_a.output) == _drop_generated_utc(record_b.output)
+
+
+# --------------------------------------------------------------------------
+# PF-4: the live-marked file is provably invisible to the default gate, and
+# fully covered by -m live — a missing marker fails the PR gate.
+# --------------------------------------------------------------------------
+
+
+def test_live_eval_file_is_deselected_by_default_and_fully_marked_live():
+    live_file = "tests/live/test_live_eval.py"
+    source = (PROJECT_ROOT / live_file).read_text("utf-8")
+    tree = ast.parse(source)
+    test_names = [
+        node.name
+        for node in ast.walk(tree)
+        if isinstance(node, ast.FunctionDef) and node.name.startswith("test_")
+    ]
+    assert test_names, "no test functions found — the file moved or is empty"
+
+    # Default options (this repo's addopts is `-m "not live"`): every test in
+    # the file must be deselected, not merely absent from a `-k` filter — so
+    # the check is that none of the file's OWN test names appear as a
+    # collected/selected item, not a guess at pytest's summary wording.
+    default_run = subprocess.run(
+        [sys.executable, "-m", "pytest", live_file, "--collect-only", "-q"],
+        cwd=str(PROJECT_ROOT),
+        capture_output=True,
+        text=True,
+    )
+    assert default_run.returncode in (0, 5), default_run.stdout + default_run.stderr
+    for name in test_names:
+        assert name not in default_run.stdout, (
+            f"{name!r} was collected by the DEFAULT options — a live-marked test "
+            "must never be reachable from the PR gate by accident (ADR-007)"
+        )
+
+    # `-m live` must select every test the file defines: a missing marker on any
+    # test in the file is exactly the gap PF-4 exists to catch.
+    live_run = subprocess.run(
+        [sys.executable, "-m", "pytest", live_file, "--collect-only", "-q", "-m", "live"],
+        cwd=str(PROJECT_ROOT),
+        capture_output=True,
+        text=True,
+    )
+    assert live_run.returncode == 0, live_run.stdout + live_run.stderr
+    for name in test_names:
+        assert name in live_run.stdout, (
+            f"{name!r} is missing from the `-m live` collection — a test in "
+            f"{live_file} lacks the live marker and would leak into the PR gate"
+        )
