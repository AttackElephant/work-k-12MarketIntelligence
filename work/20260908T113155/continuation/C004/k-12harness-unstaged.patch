+# --------------------------------------------------------------------------
+# isolated-stage graders (evals/live.py --stage intent|narration)
+#
+# `grade_intent`, `grade_intent_question_match` and `grade_case_narration`
+# take a `StructuredIntent`/`RunRecord` that never went through the full
+# tool-loop transcript the graders above assume, so they cannot be driven
+# through `_graded`/`grade_case`. Each gets its own runner here — and, same as
+# every grader above, a mutation that must be genuinely caught, not merely
+# declared.
+# --------------------------------------------------------------------------
+
+
+def _reference_intent(case_id: str) -> SimpleNamespace:
+    """A minimal stand-in for `StructuredIntent`: the isolated intent graders
+    only ever read `.question_id` off it."""
+    case = CASES[case_id]
+    question_id = "excluded" if case.direction == "should_refuse" else case.expected_question_id
+    return SimpleNamespace(question_id=question_id)
+
+
+def _mutate_intent(case_id: str, mutate: Callable[[Any], None]) -> SimpleNamespace:
+    intent = _reference_intent(case_id)
+    mutate(intent)
+    return intent
+
+
+def _intent_question_match_mutation() -> list[str]:
+    intent = _mutate_intent("answer/VC-POC-01", lambda i: setattr(i, "question_id", "VC-POC-04"))
+    return [r.grader for r in failures(grade_intent_question_match(CASES["answer/VC-POC-01"], intent))]
+
+
+def _intent_missing_mutation() -> list[str]:
+    return [r.grader for r in failures(grade_intent(CASES["answer/VC-POC-01"], None))]
+
+
+def _case_narration_missing_mutation() -> list[str]:
+    return [
+        r.grader
+        for r in failures(grade_case_narration(CASES["answer/VC-POC-01"], None))
+    ]
+
+
+# (label, runner, the grader that must catch it)
+ISOLATED_MUTATIONS: list[tuple[str, Callable[[], list[str]], str]] = [
+    (
+        "intent classifies the wrong registry question",
+        _intent_question_match_mutation,
+        "intent_question_match",
+    ),
+    (
+        "no StructuredIntent was produced for the trial",
+        _intent_missing_mutation,
+        "intent",
+    ),
+    (
+        "no RunRecord was produced for the narration stage",
