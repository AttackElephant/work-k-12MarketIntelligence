{"type":"stream_event","event":{"type":"message_delta","delta":{"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"container":null},"usage":{"input_tokens":2,"cache_creation_input_tokens":344,"cache_read_input_tokens":106848,"output_tokens":270,"output_tokens_details":{"thinking_tokens":0},"iterations":[{"input_tokens":2,"output_tokens":270,"cache_read_input_tokens":106848,"cache_creation_input_tokens":344,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":344},"type":"message"}]},"context_management":{"applied_edits":[]}},"session_id":"f6b19214-2bbd-4183-a2d5-2f5529676324","parent_tool_use_id":null,"uuid":"72cfa7e8-35d3-4eaa-af35-24ca9123b95e"}
