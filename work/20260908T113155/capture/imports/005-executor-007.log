{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VypYz3jJXPj733EYtWeeaX","type":"tool_result","content":"The file /Users/shane/Projects/k-12Harness/tests/live/test_live_eval.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"f6b19214-2bbd-4183-a2d5-2f5529676324","uuid":"7edef60a-be44-44c7-a3d0-2d5b5c9517d4","timestamp":"2026-09-26T00:56:48.102Z","tool_use_result":{"filePath":"/Users/shane/Projects/k-12Harness/tests/live/test_live_eval.py","oldString":"def test_a_live_run_stays_inside_the_control_envelope():","newString":"def test_stage_intent_survives_a_live_run():\n    \"\"\"The genuinely isolated intent stage: one model call, no evidence fetch,\n    no rendering — `evals.live.run_trial(..., stage=\"intent\")`.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    result, record = asyncio.run(\n        live.run_trial(case, case.phrasings[0], 1, EMITTER, stage=\"intent\")\n    )\n    assert result.passed, result.detail\n    assert record is None, \"the intent stage makes no tool calls, so there is no transcript\"\n\n\ndef test_stage_narration_survives_a_live_run():\n    \"\"\"The genuinely isolated narration stage: one model call over the oracle\n    envelope the stage fetches itself, never the model's own request.\"\"\"\n    case = next(\n        c for c in CASES.values() if c.expected_question_id and c.expected_request is not None\n    )\n    result, record = asyncio.run(\n        live.run_trial(case, case.phrasings[0], 1, EMITTER, stage=\"narration\")\n    )\n    assert result.passed, result.detail\n    assert record is not None\n    assert len(record.tool_calls) == 1\n    assert record.tool_calls[0].tool == \"fetch_evidence\"\n\n\ndef test_stage_end_to_end_survives_a_live_run():\n    \"\"\"`--stage end-to-end`: the real new-pipeline `ask(deps, question)`, k=1.\"\"\"\n    case = CASES[\"answer/VC-POC-REF-01\"]\n    result, record = asyncio.run(\n        live.run_trial(case, case.phrasings[0], 1, EMITTER, stage=\"end-to-end\")\n    )\n    assert result.passed, result.detail\n    assert record is not None\n\n\ndef test_a_live_run_stays_inside_the_control_envelope():","originalFile":"\"\"\"Paid smoke tests for the real model path.\n\nRun explicitly with::\n\n    .venv/bin/python -m pytest tests/live -m live -q\n\nThe broad pass@k/pass^k experiment remains ``python -m evals.live``.  These\ntests cover the small set of properties that cannot be observed offline:\nmodel judgement, prompt-cache reads, and the provider-backed control envelope.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport os\n\nimport pytest\n\nfrom config import settings\nfrom evals import live\nfrom evals.schema import load_cases\nfrom harness import usage\nfrom harness.agent import ask, build_agent\nfrom harness.tools import Deps\nfrom run import require_credentials\n\npytestmark = pytest.mark.live\n\nCASES = {case.case_id: case for case in load_cases()}\nEMITTER = os.getenv(\"LIVE_EVAL_EMITTER\", \"stub\")\n\n\n@pytest.fixture(scope=\"module\", autouse=True)\ndef _needs_credentials():\n    \"\"\"Use the same prerequisite as the CLI instead of re-implementing it.\n\n    The default accepts an explicit Claude Code subscription-account token.\n    The optional Anthropic SDK mode retains its own supported credential chain.\n    \"\"\"\n    try:\n        require_credentials()\n    except SystemExit as exc:\n        pytest.skip(str(exc))\n\n\n@pytest.mark.parametrize(\n    \"case_id\",\n    [\"answer/VC-POC-REF-01\", \"clarify/peer_filters\", \"refuse/finance\"],\n    ids=lambda case_id: case_id,\n)\ndef test_one_case_per_direction_survives_a_live_run(case_id):\n    \"\"\"One trial over each direction walked by the demo.\"\"\"\n    case = CASES.get(case_id)\n    if case is None:\n        pytest.skip(f\"{case_id} is not in the current case set\")\n    result, record = asyncio.run(live.run_trial(case, case.phrasings[0], 1, EMITTER))\n    assert record is not None, result.error\n    assert result.passed, result.detail\n\n\ndef test_the_frozen_prompt_is_actually_cached():\n    \"\"\"The second immediate run must read the provider prompt cache.\"\"\"\n    if settings.MODEL_PROVIDER == \"claude_account\":\n        pytest.skip(\"Claude CLI account mode does not expose cache counters\")\n    case = CASES[\"answer/VC-POC-01\"]\n    agent = build_agent()\n\n    reads = []\n    for _ in range(2):\n        deps = Deps(client=live.build_client(EMITTER, case.stub_case))\n        asyncio.run(ask(agent, deps, case.phrasings[0]))\n        records = usage.extract_request_records(\n            deps.last_messages, run_id=\"cache-check\", question=case.phrasings[0]\n        )\n        reads.append(sum(record.cache_read_tokens for record in records))\n\n    assert reads[1] > 0, (\n        f\"no cache read on the second run (writes/reads: {reads}) — the prompt is \"\n        \"either below the model's cache minimum or no longer byte-exact between runs\"\n    )\n\n\ndef test_a_live_run_stays_inside_the_control_envelope():\n    case = CASES[\"answer/VC-POC-01\"]\n    deps = Deps(client=live.build_client(EMITTER, case.stub_case))\n    output = asyncio.run(ask(build_agent(), deps, case.phrasings[0]))\n\n    assert output.kind != \"budget_exceeded\", getattr(output, \"detail\", \"\")\n    spent, complete = usage.spend_usd(deps.last_messages)\n    assert spent <= settings.LOOP_MAX_USD\n    if settings.MODEL_PROVIDER == \"anthropic_sdk\":\n        assert complete, (\n            f\"{settings.MODEL_PRIMARY} is unknown to the price database, so the spend \"\n            \"budget is not measuring anything — fix that before trusting a live run\"\n        )\n    else:\n        assert not complete, \"account plans do not expose per-request USD pricing\"\n","structuredPatch":[{"oldStart":80,"oldLines":6,"newStart":80,"newLines":42,"lines":["     )"," "," ","+def test_stage_intent_survives_a_live_run():","+    \"\"\"The genuinely isolated intent stage: one model call, no evidence fetch,","+    no rendering — `evals.live.run_trial(..., stage=\"intent\")`.\"\"\"","+    case = CASES[\"answer/VC-POC-01\"]","+    result, record = asyncio.run(","+        live.run_trial(case, case.phrasings[0], 1, EMITTER, stage=\"intent\")","+    )","+    assert result.passed, result.detail","+    assert record is None, \"the intent stage makes no tool calls, so there is no transcript\"","+","+","+def test_stage_narration_survives_a_live_run():","+    \"\"\"The genuinely isolated narration stage: one model call over the oracle","+    envelope the stage fetches itself, never the model's own request.\"\"\"","+    case = next(","+        c for c in CASES.values() if c.expected_question_id and c.expected_request is not None","+    )","+    result, record = asyncio.run(","+        live.run_trial(case, case.phrasings[0], 1, EMITTER, stage=\"narration\")","+    )","+    assert result.passed, result.detail","+    assert record is not None","+    assert len(record.tool_calls) == 1","+    assert record.tool_calls[0].tool == \"fetch_evidence\"","+","+","+def test_stage_end_to_end_survives_a_live_run():","+    \"\"\"`--stage end-to-end`: the real new-pipeline `ask(deps, question)`, k=1.\"\"\"","+    case = CASES[\"answer/VC-POC-REF-01\"]","+    result, record = asyncio.run(","+        live.run_trial(case, case.phrasings[0], 1, EMITTER, stage=\"end-to-end\")","+    )","+    assert result.passed, result.detail","+    assert record is not None","+","+"," def test_a_live_run_stays_inside_the_control_envelope():","     case = CASES[\"answer/VC-POC-01\"]","     deps = Deps(client=live.build_client(EMITTER, case.stub_case))"]}],"userModified":false,"replaceAll":false}}
