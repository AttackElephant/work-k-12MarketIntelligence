{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LMFZ6nN1AVR6ySqFkbsH8R","type":"tool_result","content":"255\t]\n256\t\n257\t\n258\t@pytest.mark.parametrize(\n259\t    \"label,case_id,mutate,grader\",\n260\t    MUTATIONS,\n261\t    ids=[m[0].replace(\" \", \"-\") for m in MUTATIONS],\n262\t)\n263\tdef test_mutation_is_caught_by_its_grader(label, case_id, mutate, grader):\n264\t    caught = _graded(case_id, mutate)\n265\t    assert grader in caught, (\n266\t        f\"{label!r} was not caught by {grader}; failing graders were {caught or 'none'}\"\n267\t    )\n268\t\n269\t\n270\t# --------------------------------------------------------------------------\n271\t# isolated-stage graders (evals/live.py --stage intent|narration)\n272\t#\n273\t# `grade_intent`, `grade_intent_question_match` and `grade_case_narration`\n274\t# take a `StructuredIntent`/`RunRecord` that never went through the full\n275\t# tool-loop transcript the graders above assume, so they cannot be driven\n276\t# through `_graded`/`grade_case`. Each gets its own runner here — and, same as\n277\t# every grader above, a mutation that must be genuinely caught, not merely\n278\t# declared.\n279\t# --------------------------------------------------------------------------\n280\t\n281\t\n282\tdef _reference_intent(case_id: str) -> SimpleNamespace:\n283\t    \"\"\"A minimal stand-in for `StructuredIntent`: the isolated intent graders\n284\t    only ever read `.question_id` off it.\"\"\"\n285\t    case = CASES[case_id]\n286\t    question_id = \"excluded\" if case.direction == \"should_refuse\" else case.expected_question_id\n287\t    return SimpleNamespace(question_id=question_id)\n288\t\n289\t\n290\tdef _mutate_intent(case_id: str, mutate: Callable[[Any], None]) -> SimpleNamespace:\n291\t    intent = _reference_intent(case_id)\n292\t    mutate(intent)\n293\t    return intent\n294\t\n295\t\n296\tdef _intent_question_match_mutation() -> list[str]:\n297\t    intent = _mutate_intent(\"answer/VC-POC-01\", lambda i: setattr(i, \"question_id\", \"VC-POC-04\"))\n298\t    return [r.grader for r in failures(grade_intent_question_match(CASES[\"answer/VC-POC-01\"], intent))]\n299\t\n300\t\n301\tdef _intent_missing_mutation() -> list[str]:\n302\t    return [r.grader for r in failures(grade_intent(CASES[\"answer/VC-POC-01\"], None))]\n303\t\n304\t\n305\tdef _case_narration_missing_mutation() -> list[str]:\n306\t    return [\n307\t        r.grader\n308\t        for r in failures(grade_case_narration(CASES[\"answer/VC-POC-01\"], None))\n309\t    ]\n310\t\n311\t\n312\t# (label, runner, the grader that must catch it)\n313\tISOLATED_MUTATIONS: list[tuple[str, Callable[[], list[str]], str]] = [\n314\t    (\n315\t        \"intent classifies the wrong registry question\",\n316\t        _intent_question_match_mutation,\n317\t        \"intent_question_match\",\n318\t    ),\n319\t    (\n320\t        \"no StructuredIntent was produced for the trial\",\n321\t        _intent_missing_mutation,\n322\t        \"intent\",\n323\t    ),\n324\t    (\n325\t        \"no RunRecord was produced for the narration stage\",\n326\t        _case_narration_missing_mutation,\n327\t        \"case_narration\",\n328\t    ),\n329\t]\n330\t\n331\t\n332\t@pytest.mark.parametrize(\n333\t    \"label,run,grader\",\n334\t    ISOLATED_MUTATIONS,\n335\t    ids=[m[0].replace(\" \", \"-\") for m in ISOLATED_MUTATIONS],\n336\t)\n337\tdef test_isolated_stage_mutation_is_caught_by_its_grader(label, run, grader):\n338\t    caught = run()\n339\t    assert grader in caught, (\n340\t        f\"{label!r} was not caught by {grader}; failing graders were {caught or 'none'}\"\n341\t    )\n342\t\n343\t\n344\tdef test_every_grader_has_at_least_one_mutation():\n345\t    \"\"\"A grader with no mutation behind it is untested code that reports\n346\t    success — the exact shape of a green suite that measures nothing.\n347\t\n348\t    Covers every module-level `grade_*` function, including the isolated-stage\n349\t    graders (`grade_intent`, `grade_intent_question_match`,\n350\t    `grade_case_narration`), whose mutations live in `ISOLATED_MUTATIONS`\n351\t    above because they are not `RunRecord`-shaped like the rest of `MUTATIONS`.\n352\t    \"\"\"\n353\t    from evals import graders\n354\t\n355\t    covered = {grader for _, _, _, grader in MUTATIONS} | {\n356\t        grader for _, _, grader in ISOLATED_MUTATIONS\n357\t    }\n358\t    declared = {\n359\t        name.removeprefix(\"grade_\")\n360\t        for name in dir(graders)\n361\t        if name.startswith(\"grade_\") and name not in {\"grade_case\", \"grade_suite\"}\n362\t    }\n363\t    assert declared <= covered, f\"graders with no adversarial case: {sorted(declared - covered)}\"\n364\t\n365\t\n366\t# --------------------------------------------------------------------------\n367\t# positive controls — things that look like failures and are not\n368\t# --------------------------------------------------------------------------\n369\t\n370\t\n371\tdef test_quoting_a_limitation_containing_forbidden_words_is_not_a_violation():\n372\t    \"\"\"VC-POC-13's limitation contains the exact phrases \"enrolment forecast\"\n373\t    and \"capacity estimate\". Rendering it verbatim is the rule, not a breach of\n374\t    it — the graders must strip the quoted limitations before scanning prose.\"\"\""}]},"parent_tool_use_id":null,"session_id":"21a5153d-702c-475a-9e3f-7f261e4f1a40","uuid":"8c363b95-f60a-428f-86cd-eb1bf32f3445","timestamp":"2026-09-26T12:52:24.591Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/tests/unit/test_graders.py","content":"]\n\n\n@pytest.mark.parametrize(\n    \"label,case_id,mutate,grader\",\n    MUTATIONS,\n    ids=[m[0].replace(\" \", \"-\") for m in MUTATIONS],\n)\ndef test_mutation_is_caught_by_its_grader(label, case_id, mutate, grader):\n    caught = _graded(case_id, mutate)\n    assert grader in caught, (\n        f\"{label!r} was not caught by {grader}; failing graders were {caught or 'none'}\"\n    )\n\n\n# --------------------------------------------------------------------------\n# isolated-stage graders (evals/live.py --stage intent|narration)\n#\n# `grade_intent`, `grade_intent_question_match` and `grade_case_narration`\n# take a `StructuredIntent`/`RunRecord` that never went through the full\n# tool-loop transcript the graders above assume, so they cannot be driven\n# through `_graded`/`grade_case`. Each gets its own runner here — and, same as\n# every grader above, a mutation that must be genuinely caught, not merely\n# declared.\n# --------------------------------------------------------------------------\n\n\ndef _reference_intent(case_id: str) -> SimpleNamespace:\n    \"\"\"A minimal stand-in for `StructuredIntent`: the isolated intent graders\n    only ever read `.question_id` off it.\"\"\"\n    case = CASES[case_id]\n    question_id = \"excluded\" if case.direction == \"should_refuse\" else case.expected_question_id\n    return SimpleNamespace(question_id=question_id)\n\n\ndef _mutate_intent(case_id: str, mutate: Callable[[Any], None]) -> SimpleNamespace:\n    intent = _reference_intent(case_id)\n    mutate(intent)\n    return intent\n\n\ndef _intent_question_match_mutation() -> list[str]:\n    intent = _mutate_intent(\"answer/VC-POC-01\", lambda i: setattr(i, \"question_id\", \"VC-POC-04\"))\n    return [r.grader for r in failures(grade_intent_question_match(CASES[\"answer/VC-POC-01\"], intent))]\n\n\ndef _intent_missing_mutation() -> list[str]:\n    return [r.grader for r in failures(grade_intent(CASES[\"answer/VC-POC-01\"], None))]\n\n\ndef _case_narration_missing_mutation() -> list[str]:\n    return [\n        r.grader\n        for r in failures(grade_case_narration(CASES[\"answer/VC-POC-01\"], None))\n    ]\n\n\n# (label, runner, the grader that must catch it)\nISOLATED_MUTATIONS: list[tuple[str, Callable[[], list[str]], str]] = [\n    (\n        \"intent classifies the wrong registry question\",\n        _intent_question_match_mutation,\n        \"intent_question_match\",\n    ),\n    (\n        \"no StructuredIntent was produced for the trial\",\n        _intent_missing_mutation,\n        \"intent\",\n    ),\n    (\n        \"no RunRecord was produced for the narration stage\",\n        _case_narration_missing_mutation,\n        \"case_narration\",\n    ),\n]\n\n\n@pytest.mark.parametrize(\n    \"label,run,grader\",\n    ISOLATED_MUTATIONS,\n    ids=[m[0].replace(\" \", \"-\") for m in ISOLATED_MUTATIONS],\n)\ndef test_isolated_stage_mutation_is_caught_by_its_grader(label, run, grader):\n    caught = run()\n    assert grader in caught, (\n        f\"{label!r} was not caught by {grader}; failing graders were {caught or 'none'}\"\n    )\n\n\ndef test_every_grader_has_at_least_one_mutation():\n    \"\"\"A grader with no mutation behind it is untested code that reports\n    success — the exact shape of a green suite that measures nothing.\n\n    Covers every module-level `grade_*` function, including the isolated-stage\n    graders (`grade_intent`, `grade_intent_question_match`,\n    `grade_case_narration`), whose mutations live in `ISOLATED_MUTATIONS`\n    above because they are not `RunRecord`-shaped like the rest of `MUTATIONS`.\n    \"\"\"\n    from evals import graders\n\n    covered = {grader for _, _, _, grader in MUTATIONS} | {\n        grader for _, _, grader in ISOLATED_MUTATIONS\n    }\n    declared = {\n        name.removeprefix(\"grade_\")\n        for name in dir(graders)\n        if name.startswith(\"grade_\") and name not in {\"grade_case\", \"grade_suite\"}\n    }\n    assert declared <= covered, f\"graders with no adversarial case: {sorted(declared - covered)}\"\n\n\n# --------------------------------------------------------------------------\n# positive controls — things that look like failures and are not\n# --------------------------------------------------------------------------\n\n\ndef test_quoting_a_limitation_containing_forbidden_words_is_not_a_violation():\n    \"\"\"VC-POC-13's limitation contains the exact phrases \"enrolment forecast\"\n    and \"capacity estimate\". Rendering it verbatim is the rule, not a breach of\n    it — the graders must strip the quoted limitations before scanning prose.\"\"\"","numLines":120,"startLine":255,"totalLines":432}}}
