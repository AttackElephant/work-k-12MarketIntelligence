{"type":"stream_event","event":{"type":"message_delta","delta":{"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"container":null},"usage":{"input_tokens":2,"cache_creation_input_tokens":715,"cache_read_input_tokens":78337,"output_tokens":192,"output_tokens_details":{"thinking_tokens":0},"iterations":[{"input_tokens":2,"output_tokens":192,"cache_read_input_tokens":78337,"cache_creation_input_tokens":715,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":715},"type":"message"}]},"context_management":{"applied_edits":[]}},"session_id":"21a5153d-702c-475a-9e3f-7f261e4f1a40","parent_tool_use_id":null,"uuid":"132a83d4-bd48-44af-897f-93fc7a776c5f"}
