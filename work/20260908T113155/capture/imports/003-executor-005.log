{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VBfkHtpnEty5VFHQzsXWnB","type":"tool_result","content":"150\t    if stub_case:\n151\t        env[\"STUB_EMITTER_CASE\"] = stub_case\n152\t    return EvidenceClient(python=Path(sys.executable), emitter=STUB_EMITTER, env=env)\n153\t\n154\t\n155\tdef _crashed_trial(\n156\t    case: GoldenCase,\n157\t    phrasing: str,\n158\t    trial: int,\n159\t    exc: Exception,\n160\t    started: float,\n161\t    deps: Deps | None = None,\n162\t) -> TrialResult:\n163\t    \"\"\"Turn an exception into a failed-trial result, or re-raise it as a suite\n164\t    interruption when it is not a measurement of model quality.\n165\t\n166\t    An auth failure is not a trial result, it is the run being impossible.\n167\t    Found the hard way: one placeholder API key produced 100 identical\n168\t    \"failed trials\", a pass@k of 0.0, and a report that looked like a model\n169\t    problem. Stop at the first one and say what is wrong. Shared by every\n170\t    stage's trial runner so the same rule applies whether the crash happened\n171\t    in the legacy loop, one isolated stage, or the new pipeline.\n172\t    \"\"\"\n173\t    classified = classify(exc)\n174\t    if isinstance(classified, AuthError):\n175\t        raise CredentialsRejected(str(classified)) from exc\n176\t    if isinstance(classified, QuotaExceeded):\n177\t        raise classified from exc\n178\t    detail = f\"{type(exc).__name__}: {exc}\"\n179\t    if deps is not None and deps.output_validation_failures:\n180\t        detail += \"; output gate: \" + \" | \".join(deps.output_validation_failures[-1])\n181\t    return TrialResult(\n182\t        case_id=case.case_id,\n183\t        direction=case.direction,\n184\t        phrasing=phrasing,\n185\t        trial=trial,\n186\t        passed=False,\n187\t        error=detail,\n188\t        duration_ms=int((time.monotonic() - started) * 1000),\n189\t    )\n190\t\n191\t\n192\tasync def run_intent_trial(\n193\t    case: GoldenCase,\n194\t    phrasing: str,\n195\t    trial: int,\n196\t    intent_model: Any = None,\n197\t) -> tuple[TrialResult, RunRecord | None]:\n198\t    \"\"\"Stage 1, genuinely isolated: one model call, no tools, no evidence\n199\t    subprocess, no planner. Nothing runs except `interpret_intent()`, so\n200\t    grading is limited to what this stage alone decides — which registry\n201\t    question (or 'excluded'/'unknown') the model chose. `intent_model` is the\n202\t    test injection point (a scripted `FunctionModel`); production passes None\n203\t    and gets the real provider wiring.\n204\t    \"\"\"\n205\t    started = time.monotonic()\n206\t    try:\n207\t        intent = await interpret_intent(phrasing, model=intent_model)\n208\t    except Exception as exc:  # noqa: BLE001 — a crashed trial is still a result\n209\t        return _crashed_trial(case, phrasing, trial, exc, started), None\n210\t\n211\t    duration_ms = int((time.monotonic() - started) * 1000)\n212\t    failed = failures(grade_intent(case, intent))\n213\t    # No `Deps`/message history exists for an isolated intent call (there is no\n214\t    # tool loop and no pipeline run object), so cost reports the same way the\n215\t    # full pipeline does for an empty history — see `usage.spend_usd`.\n216\t    spent, complete = usage.spend_usd([])\n217\t    return (\n218\t        TrialResult(\n219\t            case_id=case.case_id,\n220\t            direction=case.direction,\n221\t            phrasing=phrasing,\n222\t            trial=trial,\n223\t            passed=not failed,\n224\t            failed_graders=[r.grader for r in failed],\n225\t            detail=\"; \".join(f\"{r.grader}: {r.detail}\" for r in failed),\n226\t            output_kind=None,\n227\t            duration_ms=duration_ms,\n228\t            cost_usd=spent,\n229\t            cost_complete=complete,\n230\t        ),\n231\t        None,\n232\t    )\n233\t\n234\t\n235\tasync def run_narration_trial(\n236\t    case: GoldenCase,\n237\t    phrasing: str,\n238\t    trial: int,\n239\t    emitter: str,\n240\t    narration_model: Any = None,\n241\t) -> tuple[TrialResult, RunRecord | None]:\n242\t    \"\"\"Stage 4, genuinely isolated: one model call over a FIXED AnswerView.\n243\t    Intent and planning never run — the envelope is fetched directly from the\n244\t    emitter for the case's own declared `expected_question_id` /\n245\t    `expected_request`, bypassing the tool loop and the planner entirely, so a\n246\t    case with neither cannot be narration-graded (`select_cases` filters those\n247\t    out for `--stage narration`). Grading is `evals.graders.grade_case_narration`:\n248\t    every prose/envelope rule the full pipeline enforces, minus the ones that\n249\t    judge a decision narration never makes.\n250\t    \"\"\"\n251\t    started = time.monotonic()\n252\t    if not case.expected_question_id or case.expected_request is None:\n253\t        return (\n254\t            TrialResult(\n255\t                case_id=case.case_id,\n256\t                direction=case.direction,\n257\t                phrasing=phrasing,\n258\t                trial=trial,\n259\t                passed=False,\n260\t                error=(\n261\t                    \"case has no expected_question_id/expected_request; the \"\n262\t                    \"narration stage needs a fixed envelope to narrate\"\n263\t                ),\n264\t                duration_ms=int((time.monotonic() - started) * 1000),\n265\t            ),\n266\t            None,\n267\t        )\n268\t\n269\t    client = build_client(emitter, case.stub_case)\n270\t    deps = Deps(client=client)\n271\t    deps.user_question = phrasing\n272\t    try:\n273\t        envelope = await client.fetch_evidence(case.expected_question_id, case.expected_request)\n274\t    except Exception as exc:  # noqa: BLE001 — a crashed trial is still a result\n275\t        return _crashed_trial(case, phrasing, trial, exc, started, deps), None\n276\t\n277\t    deps.last_envelope = envelope\n278\t    deps.tool_calls.append(\n279\t        ToolInvocation(\n280\t            \"fetch_evidence\",\n281\t            {\"question_id\": case.expected_question_id, \"request\": case.expected_request},\n282\t            envelope,\n283\t        )\n284\t    )\n285\t    view = build_answer_view(envelope)\n286\t    deps.answer_view = view\n287\t\n288\t    try:\n289\t        narration = await narrate(view, deps, model=narration_model)\n290\t    except NarrationValidationError as exc:\n291\t        return (\n292\t            TrialResult(\n293\t                case_id=case.case_id,\n294\t                direction=case.direction,\n295\t                phrasing=phrasing,\n296\t                trial=trial,\n297\t                passed=False,\n298\t                failed_graders=[\"narration_validation\"],\n299\t                detail=\"; \".join(exc.problems),\n300\t                duration_ms=int((time.monotonic() - started) * 1000),\n301\t            ),\n302\t            None,\n303\t        )\n304\t    except Exception as exc:  # noqa: BLE001 — a crashed trial is still a result\n305\t        return _crashed_trial(case, phrasing, trial, exc, started, deps), None\n306\t\n307\t    output = RenderedAnswer(\n308\t        answer=narration.answer,\n309\t        question_id=view.question_id,\n310\t        contract_version=view.contract_version,\n311\t        evidence=view.evidence,\n312\t        provenance=view.provenance,\n313\t        confidence=view.confidence,\n314\t        limitations=view.limitations,\n315\t        deterministic_signals=view.deterministic_signals,\n316\t        resolved_request=view.resolved_request,\n317\t        data_status=view.data_status,\n318\t        claim_eligibility=view.claim_eligibility,\n319\t        data_status_note=view.data_status_note,\n320\t    )\n321\t    duration_ms = int((time.monotonic() - started) * 1000)\n322\t    record = replay_mod.project(case, deps, output)\n323\t    failed = failures(grade_case_narration(case, record))\n324\t    spent, complete = usage.spend_usd(deps.last_messages)\n325\t    return (\n326\t        TrialResult(\n327\t            case_id=case.case_id,\n328\t            direction=case.direction,\n329\t            phrasing=phrasing,\n330\t            trial=trial,\n331\t            passed=not failed,\n332\t            failed_graders=[r.grader for r in failed],\n333\t            detail=\"; \".join(f\"{r.grader}: {r.detail}\" for r in failed),\n334\t            output_kind=record.output_kind,\n335\t            duration_ms=duration_ms,\n336\t            cost_usd=spent,\n337\t            cost_complete=complete,\n338\t        ),\n339\t        record,\n340\t    )\n341\t\n342\t\n343\tasync def run_end_to_end_trial(\n344\t    case: GoldenCase,\n345\t    phrasing: str,\n346\t    trial: int,\n347\t    emitter: str,\n348\t    intent_model: Any = None,\n349\t    narration_model: Any = None,\n350\t) -> tuple[TrialResult, RunRecord | None]:\n351\t    \"\"\"The real 4-stage pipeline, end to end: `ask(deps, question)` — the NEW\n352\t    pipeline signature, not the legacy tool-loop `build_agent()` +\n353\t    `ask(agent, deps, question)` path the default (no `--stage`) mode still\n354\t    uses. A smoke suite, not a reliability sample: `main()` enforces k=1 for\n355\t    this stage. Graded with the full pipeline grader set, same as the default\n356\t    mode, because nothing here is isolated — it is the whole thing.\n357\t    \"\"\"\n358\t    started = time.monotonic()\n359\t    deps = Deps(client=build_client(emitter, case.stub_case))\n360\t    try:\n361\t        output = await ask(\n362\t            deps, phrasing, intent_model=intent_model, narration_model=narration_model\n363\t        )\n364\t    except Exception as exc:  # noqa: BLE001 — a crashed trial is still a result\n365\t        return _crashed_trial(case, phrasing, trial, exc, started, deps), None\n366\t\n367\t    duration_ms = int((time.monotonic() - started) * 1000)\n368\t    record = replay_mod.project(case, deps, output)\n369\t    failed = failures(grade_case(case, record))\n370\t    spent, complete = usage.spend_usd(deps.last_messages)\n371\t    return (\n372\t        TrialResult(\n373\t            case_id=case.case_id,\n374\t            direction=case.direction,\n375\t            phrasing=phrasing,\n376\t            trial=trial,\n377\t            passed=not failed,\n378\t            failed_graders=[r.grader for r in failed],\n379\t            detail=\"; \".join(f\"{r.grader}: {r.detail}\" for r in failed),\n380\t            output_kind=record.output_kind,\n381\t            duration_ms=duration_ms,\n382\t            cost_usd=spent,\n383\t            cost_complete=complete,\n384\t        ),\n385\t        record,\n386\t    )\n387\t\n388\t\n389\tasync def run_trial(\n390\t    case: GoldenCase,\n391\t    phrasing: str,\n392\t    trial: int,\n393\t    emitter: str,\n394\t    agent_factory: Any = build_agent,\n395\t    *,\n396\t    stage: str | None = None,\n397\t    intent_model: Any = None,\n398\t    narration_model: Any = None,\n399\t) -> tuple[TrialResult, RunRecord | None]:\n400\t    \"\"\"One question, one live run, graded.\n401\t\n402\t    `stage` dispatches to a genuinely isolated stage runner:\n403\t\n404\t    * ``\"intent\"``     — `run_intent_trial`: Stage 1 alone.\n405\t    * ``\"narration\"``  — `run_narration_trial`: Stage 4 alone, over a fixed envelope.\n406\t    * ``\"end-to-end\"`` — `run_end_to_end_trial`: the real new-pipeline `ask()`.\n407\t    * ``None`` (default) — unchanged: the legacy tool-loop path via `agent_factory`.\n408\t\n409\t    Ordinary faults become failed trials. Authentication and definitive account\n410\t    quota failures raise because neither is a measurement of model quality —\n411\t    `_crashed_trial` is shared by every stage so that rule cannot drift between\n412\t    them.\n413\t    \"\"\"\n414\t    if stage == \"intent\":\n415\t        return await run_intent_trial(case, phrasing, trial, intent_model=intent_model)\n416\t    if stage == \"narration\":\n417\t        return await run_narration_trial(\n418\t            case, phrasing, trial, emitter, narration_model=narration_model\n419\t        )\n420\t    if stage == \"end-to-end\":\n421\t        return await run_end_to_end_trial(\n422\t            case, phrasing, trial, emitter,\n423\t            intent_model=intent_model, narration_model=narration_model,\n424\t        )\n425\t\n426\t    started = time.monotonic()\n427\t    deps = Deps(client=build_client(emitter, case.stub_case))\n428\t    try:\n429\t        agent = agent_factory()\n430\t        output = await ask(agent, deps, phrasing)\n431\t    except Exception as exc:  # noqa: BLE001 — a crashed trial is still a result\n432\t        return _crashed_trial(case, phrasing, trial, exc, started, deps), None\n433\t\n434\t    duration_ms = int((time.monotonic() - started) * 1000)\n435\t    record = replay_mod.project(case, deps, output)\n436\t    failed = failures(grade_case(case, record))\n437\t    spent, complete = usage.spend_usd(deps.last_messages)\n438\t    return (\n439\t        TrialResult(\n440\t            case_id=case.case_id,\n441\t            direction=case.direction,\n442\t            phrasing=phrasing,\n443\t            trial=trial,\n444\t            passed=not failed,\n445\t            failed_graders=[r.grader for r in failed],\n446\t            detail=\"; \".join(f\"{r.grader}: {r.detail}\" for r in failed),\n447\t            output_kind=record.output_kind,\n448\t            duration_ms=duration_ms,\n449\t            cost_usd=spent,\n450\t            cost_complete=complete,\n451\t        ),\n452\t        record,\n453\t    )\n454\t\n455\t\n456\tdef summarise(case_id: str, direction: str, trials: list[TrialResult]) -> CaseReport:\n457\t    passes = sum(1 for t in trials if t.passed)\n458\t    counts: dict[str, int] = {}\n459\t    for trial in trials:\n460\t        for grader in trial.failed_graders or ([\"error\"] if trial.error else []):\n461\t            counts[grader] = counts.get(grader, 0) + 1\n462\t    return CaseReport(\n463\t        case_id=case_id,\n464\t        direction=direction,\n465\t        trials=len(trials),\n466\t        passes=passes,\n467\t        pass_at_k=1.0 if passes else 0.0,\n468\t        pass_hat_k=1.0 if passes == len(trials) and trials else 0.0,\n469\t        failed_graders=counts,\n470\t    )\n471\t\n472\t\n473\tdef phrasings_for(case: GoldenCase, pressure: bool, all_phrasings: bool) -> list[str]:\n474\t    base = list(case.phrasings) if all_phrasings else [case.phrasings[0]]\n475\t    if not pressure:\n476\t        return base\n477\t    # The pressure suffix rotates so a k-trial run does not probe one phrasing\n478\t    # five times; the point is coverage of ways to ask for a softer answer.\n479\t    return [\n480\t        f\"{phrasing} {suffix}\"\n481\t        for phrasing in base\n482\t        for suffix in PRESSURE_PHRASINGS\n483\t    ]\n484\t\n485\t\n486\tdef trial_slots(\n487\t    cases: list[GoldenCase], k: int, pressure: bool, all_phrasings: bool\n488\t) -> list[tuple[GoldenCase, str, int]]:\n489\t    \"\"\"The exact scheduled sample.\n490\t\n491\t    Pressure suffixes are alternative trials, not a second Cartesian sample\n492\t    dimension. Thus ``--pressure --k 5`` is five trials per case, rotating over\n493\t    five phrasings, rather than the old and misleading 25 trials labelled k=5.\n494\t    \"\"\"\n495\t    slots: list[tuple[GoldenCase, str, int]] = []\n496\t    for case in cases:\n497\t        phrasings = phrasings_for(case, pressure, all_phrasings)\n498\t        if pressure:\n499\t            for trial in range(1, k + 1):\n500\t                slots.append((case, phrasings[(trial - 1) % len(phrasings)], trial))\n501\t        else:\n502\t            for phrasing in phrasings:\n503\t                for trial in range(1, k + 1):\n504\t                    slots.append((case, phrasing, trial))\n505\t    return slots\n506\t\n507\t\n508\tdef _trial_key(case_id: str, phrasing: str, trial: int) -> tuple[str, str, int]:\n509\t    return case_id, phrasing, trial\n510\t\n511\t\n512\tdef completed_reports(\n513\t    cases: list[GoldenCase],\n514\t    slots: list[tuple[GoldenCase, str, int]],\n515\t    trials: list[TrialResult],\n516\t) -> list[CaseReport]:\n517\t    \"\"\"Summarise only cases whose entire declared sample completed.\"\"\"\n518\t    actual = {_trial_key(t.case_id, t.phrasing, t.trial): t for t in trials}\n519\t    reports: list[CaseReport] = []\n520\t    for case in cases:\n521\t        expected = [\n522\t            _trial_key(slot_case.case_id, phrasing, trial)\n523\t            for slot_case, phrasing, trial in slots\n524\t            if slot_case.case_id == case.case_id\n525\t        ]\n526\t        if expected and all(key in actual for key in expected):\n527\t            reports.append(\n528\t                summarise(case.case_id, case.direction, [actual[key] for key in expected])\n529\t            )\n530\t    return reports\n531\t\n532\t\n533\tasync def run_suite(\n534\t    cases: list[GoldenCase],\n535\t    k: int,\n536\t    emitter: str,\n537\t    pressure: bool = False,\n538\t    all_phrasings: bool = False,\n539\t    agent_factory: Any = build_agent,\n540\t    initial_trials: list[TrialResult] | None = None,\n541\t    initial_transcripts: list[RunRecord] | None = None,\n542\t    max_trials: int | None = None,\n543\t    on_progress: Callable[[list[TrialResult], list[RunRecord]], None] | None = None,\n544\t    stage: str | None = None,\n545\t    intent_model: Any = None,\n546\t    narration_model: Any = None,\n547\t) -> tuple[\n548\t    list[CaseReport], list[TrialResult], list[RunRecord], SuiteInterruption | None\n549\t]:\n550\t    slots = trial_slots(cases, k, pressure, all_phrasings)\n551\t    all_trials = list(initial_trials or [])\n552\t    transcripts = list(initial_transcripts or [])\n553\t    done = {_trial_key(t.case_id, t.phrasing, t.trial) for t in all_trials}\n554\t    new_trials = 0\n555\t    interruption: SuiteInterruption | None = None\n556\t\n557\t    for case, phrasing, trial in slots:\n558\t        if _trial_key(case.case_id, phrasing, trial) in done:\n559\t            continue\n560\t        if max_trials is not None and new_trials >= max_trials:\n561\t            interruption = SuiteInterruption(\n562\t                \"chunk_limit\", f\"completed configured chunk of {max_trials} trial(s)\",\n563\t                case.case_id, phrasing, trial,\n564\t            )\n565\t            break\n566\t        try:\n567\t            result, record = await run_trial(\n568\t                case, phrasing, trial, emitter, agent_factory,\n569\t                stage=stage, intent_model=intent_model, narration_model=narration_model,\n570\t            )\n571\t        except QuotaExceeded as exc:\n572\t            interruption = SuiteInterruption(\n573\t                \"quota_exhausted\", str(exc), case.case_id, phrasing, trial,\n574\t                reset_at=exc.reset_at,\n575\t            )\n576\t            break\n577\t        all_trials.append(result)\n578\t        done.add(_trial_key(case.case_id, phrasing, trial))\n579\t        new_trials += 1\n580\t        if record is not None:\n581\t            transcripts.append(record)\n582\t        status = \"pass\" if result.passed else \"FAIL\"\n583\t        print(\n584\t            f\"  {status}  {case.case_id} trial {trial}\"\n585\t            + (f\" — {result.detail or result.error}\" if not result.passed else \"\")\n586\t        )\n587\t        if on_progress is not None:\n588\t            on_progress(all_trials, transcripts)\n589\t"}]},"parent_tool_use_id":null,"session_id":"6a5a4bf9-713c-4453-8836-6a3d15f3b2d0","uuid":"49a3dc62-4acd-4c64-ac3c-df818e177bb4","timestamp":"2026-09-25T23:04:17.272Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/evals/live.py","content":"    if stub_case:\n        env[\"STUB_EMITTER_CASE\"] = stub_case\n    return EvidenceClient(python=Path(sys.executable), emitter=STUB_EMITTER, env=env)\n\n\ndef _crashed_trial(\n    case: GoldenCase,\n    phrasing: str,\n    trial: int,\n    exc: Exception,\n    started: float,\n    deps: Deps | None = None,\n) -> TrialResult:\n    \"\"\"Turn an exception into a failed-trial result, or re-raise it as a suite\n    interruption when it is not a measurement of model quality.\n\n    An auth failure is not a trial result, it is the run being impossible.\n    Found the hard way: one placeholder API key produced 100 identical\n    \"failed trials\", a pass@k of 0.0, and a report that looked like a model\n    problem. Stop at the first one and say what is wrong. Shared by every\n    stage's trial runner so the same rule applies whether the crash happened\n    in the legacy loop, one isolated stage, or the new pipeline.\n    \"\"\"\n    classified = classify(exc)\n    if isinstance(classified, AuthError):\n        raise CredentialsRejected(str(classified)) from exc\n    if isinstance(classified, QuotaExceeded):\n        raise classified from exc\n    detail = f\"{type(exc).__name__}: {exc}\"\n    if deps is not None and deps.output_validation_failures:\n        detail += \"; output gate: \" + \" | \".join(deps.output_validation_failures[-1])\n    return TrialResult(\n        case_id=case.case_id,\n        direction=case.direction,\n        phrasing=phrasing,\n        trial=trial,\n        passed=False,\n        error=detail,\n        duration_ms=int((time.monotonic() - started) * 1000),\n    )\n\n\nasync def run_intent_trial(\n    case: GoldenCase,\n    phrasing: str,\n    trial: int,\n    intent_model: Any = None,\n) -> tuple[TrialResult, RunRecord | None]:\n    \"\"\"Stage 1, genuinely isolated: one model call, no tools, no evidence\n    subprocess, no planner. Nothing runs except `interpret_intent()`, so\n    grading is limited to what this stage alone decides — which registry\n    question (or 'excluded'/'unknown') the model chose. `intent_model` is the\n    test injection point (a scripted `FunctionModel`); production passes None\n    and gets the real provider wiring.\n    \"\"\"\n    started = time.monotonic()\n    try:\n        intent = await interpret_intent(phrasing, model=intent_model)\n    except Exception as exc:  # noqa: BLE001 — a crashed trial is still a result\n        return _crashed_trial(case, phrasing, trial, exc, started), None\n\n    duration_ms = int((time.monotonic() - started) * 1000)\n    failed = failures(grade_intent(case, intent))\n    # No `Deps`/message history exists for an isolated intent call (there is no\n    # tool loop and no pipeline run object), so cost reports the same way the\n    # full pipeline does for an empty history — see `usage.spend_usd`.\n    spent, complete = usage.spend_usd([])\n    return (\n        TrialResult(\n            case_id=case.case_id,\n            direction=case.direction,\n            phrasing=phrasing,\n            trial=trial,\n            passed=not failed,\n            failed_graders=[r.grader for r in failed],\n            detail=\"; \".join(f\"{r.grader}: {r.detail}\" for r in failed),\n            output_kind=None,\n            duration_ms=duration_ms,\n            cost_usd=spent,\n            cost_complete=complete,\n        ),\n        None,\n    )\n\n\nasync def run_narration_trial(\n    case: GoldenCase,\n    phrasing: str,\n    trial: int,\n    emitter: str,\n    narration_model: Any = None,\n) -> tuple[TrialResult, RunRecord | None]:\n    \"\"\"Stage 4, genuinely isolated: one model call over a FIXED AnswerView.\n    Intent and planning never run — the envelope is fetched directly from the\n    emitter for the case's own declared `expected_question_id` /\n    `expected_request`, bypassing the tool loop and the planner entirely, so a\n    case with neither cannot be narration-graded (`select_cases` filters those\n    out for `--stage narration`). Grading is `evals.graders.grade_case_narration`:\n    every prose/envelope rule the full pipeline enforces, minus the ones that\n    judge a decision narration never makes.\n    \"\"\"\n    started = time.monotonic()\n    if not case.expected_question_id or case.expected_request is None:\n        return (\n            TrialResult(\n                case_id=case.case_id,\n                direction=case.direction,\n                phrasing=phrasing,\n                trial=trial,\n                passed=False,\n                error=(\n                    \"case has no expected_question_id/expected_request; the \"\n                    \"narration stage needs a fixed envelope to narrate\"\n                ),\n                duration_ms=int((time.monotonic() - started) * 1000),\n            ),\n            None,\n        )\n\n    client = build_client(emitter, case.stub_case)\n    deps = Deps(client=client)\n    deps.user_question = phrasing\n    try:\n        envelope = await client.fetch_evidence(case.expected_question_id, case.expected_request)\n    except Exception as exc:  # noqa: BLE001 — a crashed trial is still a result\n        return _crashed_trial(case, phrasing, trial, exc, started, deps), None\n\n    deps.last_envelope = envelope\n    deps.tool_calls.append(\n        ToolInvocation(\n            \"fetch_evidence\",\n            {\"question_id\": case.expected_question_id, \"request\": case.expected_request},\n            envelope,\n        )\n    )\n    view = build_answer_view(envelope)\n    deps.answer_view = view\n\n    try:\n        narration = await narrate(view, deps, model=narration_model)\n    except NarrationValidationError as exc:\n        return (\n            TrialResult(\n                case_id=case.case_id,\n                direction=case.direction,\n                phrasing=phrasing,\n                trial=trial,\n                passed=False,\n                failed_graders=[\"narration_validation\"],\n                detail=\"; \".join(exc.problems),\n                duration_ms=int((time.monotonic() - started) * 1000),\n            ),\n            None,\n        )\n    except Exception as exc:  # noqa: BLE001 — a crashed trial is still a result\n        return _crashed_trial(case, phrasing, trial, exc, started, deps), None\n\n    output = RenderedAnswer(\n        answer=narration.answer,\n        question_id=view.question_id,\n        contract_version=view.contract_version,\n        evidence=view.evidence,\n        provenance=view.provenance,\n        confidence=view.confidence,\n        limitations=view.limitations,\n        deterministic_signals=view.deterministic_signals,\n        resolved_request=view.resolved_request,\n        data_status=view.data_status,\n        claim_eligibility=view.claim_eligibility,\n        data_status_note=view.data_status_note,\n    )\n    duration_ms = int((time.monotonic() - started) * 1000)\n    record = replay_mod.project(case, deps, output)\n    failed = failures(grade_case_narration(case, record))\n    spent, complete = usage.spend_usd(deps.last_messages)\n    return (\n        TrialResult(\n            case_id=case.case_id,\n            direction=case.direction,\n            phrasing=phrasing,\n            trial=trial,\n            passed=not failed,\n            failed_graders=[r.grader for r in failed],\n            detail=\"; \".join(f\"{r.grader}: {r.detail}\" for r in failed),\n            output_kind=record.output_kind,\n            duration_ms=duration_ms,\n            cost_usd=spent,\n            cost_complete=complete,\n        ),\n        record,\n    )\n\n\nasync def run_end_to_end_trial(\n    case: GoldenCase,\n    phrasing: str,\n    trial: int,\n    emitter: str,\n    intent_model: Any = None,\n    narration_model: Any = None,\n) -> tuple[TrialResult, RunRecord | None]:\n    \"\"\"The real 4-stage pipeline, end to end: `ask(deps, question)` — the NEW\n    pipeline signature, not the legacy tool-loop `build_agent()` +\n    `ask(agent, deps, question)` path the default (no `--stage`) mode still\n    uses. A smoke suite, not a reliability sample: `main()` enforces k=1 for\n    this stage. Graded with the full pipeline grader set, same as the default\n    mode, because nothing here is isolated — it is the whole thing.\n    \"\"\"\n    started = time.monotonic()\n    deps = Deps(client=build_client(emitter, case.stub_case))\n    try:\n        output = await ask(\n            deps, phrasing, intent_model=intent_model, narration_model=narration_model\n        )\n    except Exception as exc:  # noqa: BLE001 — a crashed trial is still a result\n        return _crashed_trial(case, phrasing, trial, exc, started, deps), None\n\n    duration_ms = int((time.monotonic() - started) * 1000)\n    record = replay_mod.project(case, deps, output)\n    failed = failures(grade_case(case, record))\n    spent, complete = usage.spend_usd(deps.last_messages)\n    return (\n        TrialResult(\n            case_id=case.case_id,\n            direction=case.direction,\n            phrasing=phrasing,\n            trial=trial,\n            passed=not failed,\n            failed_graders=[r.grader for r in failed],\n            detail=\"; \".join(f\"{r.grader}: {r.detail}\" for r in failed),\n            output_kind=record.output_kind,\n            duration_ms=duration_ms,\n            cost_usd=spent,\n            cost_complete=complete,\n        ),\n        record,\n    )\n\n\nasync def run_trial(\n    case: GoldenCase,\n    phrasing: str,\n    trial: int,\n    emitter: str,\n    agent_factory: Any = build_agent,\n    *,\n    stage: str | None = None,\n    intent_model: Any = None,\n    narration_model: Any = None,\n) -> tuple[TrialResult, RunRecord | None]:\n    \"\"\"One question, one live run, graded.\n\n    `stage` dispatches to a genuinely isolated stage runner:\n\n    * ``\"intent\"``     — `run_intent_trial`: Stage 1 alone.\n    * ``\"narration\"``  — `run_narration_trial`: Stage 4 alone, over a fixed envelope.\n    * ``\"end-to-end\"`` — `run_end_to_end_trial`: the real new-pipeline `ask()`.\n    * ``None`` (default) — unchanged: the legacy tool-loop path via `agent_factory`.\n\n    Ordinary faults become failed trials. Authentication and definitive account\n    quota failures raise because neither is a measurement of model quality —\n    `_crashed_trial` is shared by every stage so that rule cannot drift between\n    them.\n    \"\"\"\n    if stage == \"intent\":\n        return await run_intent_trial(case, phrasing, trial, intent_model=intent_model)\n    if stage == \"narration\":\n        return await run_narration_trial(\n            case, phrasing, trial, emitter, narration_model=narration_model\n        )\n    if stage == \"end-to-end\":\n        return await run_end_to_end_trial(\n            case, phrasing, trial, emitter,\n            intent_model=intent_model, narration_model=narration_model,\n        )\n\n    started = time.monotonic()\n    deps = Deps(client=build_client(emitter, case.stub_case))\n    try:\n        agent = agent_factory()\n        output = await ask(agent, deps, phrasing)\n    except Exception as exc:  # noqa: BLE001 — a crashed trial is still a result\n        return _crashed_trial(case, phrasing, trial, exc, started, deps), None\n\n    duration_ms = int((time.monotonic() - started) * 1000)\n    record = replay_mod.project(case, deps, output)\n    failed = failures(grade_case(case, record))\n    spent, complete = usage.spend_usd(deps.last_messages)\n    return (\n        TrialResult(\n            case_id=case.case_id,\n            direction=case.direction,\n            phrasing=phrasing,\n            trial=trial,\n            passed=not failed,\n            failed_graders=[r.grader for r in failed],\n            detail=\"; \".join(f\"{r.grader}: {r.detail}\" for r in failed),\n            output_kind=record.output_kind,\n            duration_ms=duration_ms,\n            cost_usd=spent,\n            cost_complete=complete,\n        ),\n        record,\n    )\n\n\ndef summarise(case_id: str, direction: str, trials: list[TrialResult]) -> CaseReport:\n    passes = sum(1 for t in trials if t.passed)\n    counts: dict[str, int] = {}\n    for trial in trials:\n        for grader in trial.failed_graders or ([\"error\"] if trial.error else []):\n            counts[grader] = counts.get(grader, 0) + 1\n    return CaseReport(\n        case_id=case_id,\n        direction=direction,\n        trials=len(trials),\n        passes=passes,\n        pass_at_k=1.0 if passes else 0.0,\n        pass_hat_k=1.0 if passes == len(trials) and trials else 0.0,\n        failed_graders=counts,\n    )\n\n\ndef phrasings_for(case: GoldenCase, pressure: bool, all_phrasings: bool) -> list[str]:\n    base = list(case.phrasings) if all_phrasings else [case.phrasings[0]]\n    if not pressure:\n        return base\n    # The pressure suffix rotates so a k-trial run does not probe one phrasing\n    # five times; the point is coverage of ways to ask for a softer answer.\n    return [\n        f\"{phrasing} {suffix}\"\n        for phrasing in base\n        for suffix in PRESSURE_PHRASINGS\n    ]\n\n\ndef trial_slots(\n    cases: list[GoldenCase], k: int, pressure: bool, all_phrasings: bool\n) -> list[tuple[GoldenCase, str, int]]:\n    \"\"\"The exact scheduled sample.\n\n    Pressure suffixes are alternative trials, not a second Cartesian sample\n    dimension. Thus ``--pressure --k 5`` is five trials per case, rotating over\n    five phrasings, rather than the old and misleading 25 trials labelled k=5.\n    \"\"\"\n    slots: list[tuple[GoldenCase, str, int]] = []\n    for case in cases:\n        phrasings = phrasings_for(case, pressure, all_phrasings)\n        if pressure:\n            for trial in range(1, k + 1):\n                slots.append((case, phrasings[(trial - 1) % len(phrasings)], trial))\n        else:\n            for phrasing in phrasings:\n                for trial in range(1, k + 1):\n                    slots.append((case, phrasing, trial))\n    return slots\n\n\ndef _trial_key(case_id: str, phrasing: str, trial: int) -> tuple[str, str, int]:\n    return case_id, phrasing, trial\n\n\ndef completed_reports(\n    cases: list[GoldenCase],\n    slots: list[tuple[GoldenCase, str, int]],\n    trials: list[TrialResult],\n) -> list[CaseReport]:\n    \"\"\"Summarise only cases whose entire declared sample completed.\"\"\"\n    actual = {_trial_key(t.case_id, t.phrasing, t.trial): t for t in trials}\n    reports: list[CaseReport] = []\n    for case in cases:\n        expected = [\n            _trial_key(slot_case.case_id, phrasing, trial)\n            for slot_case, phrasing, trial in slots\n            if slot_case.case_id == case.case_id\n        ]\n        if expected and all(key in actual for key in expected):\n            reports.append(\n                summarise(case.case_id, case.direction, [actual[key] for key in expected])\n            )\n    return reports\n\n\nasync def run_suite(\n    cases: list[GoldenCase],\n    k: int,\n    emitter: str,\n    pressure: bool = False,\n    all_phrasings: bool = False,\n    agent_factory: Any = build_agent,\n    initial_trials: list[TrialResult] | None = None,\n    initial_transcripts: list[RunRecord] | None = None,\n    max_trials: int | None = None,\n    on_progress: Callable[[list[TrialResult], list[RunRecord]], None] | None = None,\n    stage: str | None = None,\n    intent_model: Any = None,\n    narration_model: Any = None,\n) -> tuple[\n    list[CaseReport], list[TrialResult], list[RunRecord], SuiteInterruption | None\n]:\n    slots = trial_slots(cases, k, pressure, all_phrasings)\n    all_trials = list(initial_trials or [])\n    transcripts = list(initial_transcripts or [])\n    done = {_trial_key(t.case_id, t.phrasing, t.trial) for t in all_trials}\n    new_trials = 0\n    interruption: SuiteInterruption | None = None\n\n    for case, phrasing, trial in slots:\n        if _trial_key(case.case_id, phrasing, trial) in done:\n            continue\n        if max_trials is not None and new_trials >= max_trials:\n            interruption = SuiteInterruption(\n                \"chunk_limit\", f\"completed configured chunk of {max_trials} trial(s)\",\n                case.case_id, phrasing, trial,\n            )\n            break\n        try:\n            result, record = await run_trial(\n                case, phrasing, trial, emitter, agent_factory,\n                stage=stage, intent_model=intent_model, narration_model=narration_model,\n            )\n        except QuotaExceeded as exc:\n            interruption = SuiteInterruption(\n                \"quota_exhausted\", str(exc), case.case_id, phrasing, trial,\n                reset_at=exc.reset_at,\n            )\n            break\n        all_trials.append(result)\n        done.add(_trial_key(case.case_id, phrasing, trial))\n        new_trials += 1\n        if record is not None:\n            transcripts.append(record)\n        status = \"pass\" if result.passed else \"FAIL\"\n        print(\n            f\"  {status}  {case.case_id} trial {trial}\"\n            + (f\" — {result.detail or result.error}\" if not result.passed else \"\")\n        )\n        if on_progress is not None:\n            on_progress(all_trials, transcripts)\n","numLines":440,"startLine":150,"totalLines":895}}}
