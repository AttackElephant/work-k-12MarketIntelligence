{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01G6N5V4pQrfNWdDpCfeUoaD","type":"tool_result","content":"570\t            case, case.phrasings[0], 1, \"stub\", stage=\"intent\", intent_model=make_intent_model(wrong)\n571\t        )\n572\t    )\n573\t    assert not result.passed\n574\t\n575\t\n576\tdef test_stage_intent_a_crashed_call_is_a_failed_trial_not_a_transcript():\n577\t    case = CASES[\"answer/VC-POC-01\"]\n578\t\n579\t    def exploding_model(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:\n580\t        raise RuntimeError(\"provider is down\")\n581\t\n582\t    result, record = asyncio.run(\n583\t        live.run_trial(\n584\t            case, case.phrasings[0], 1, \"stub\",\n585\t            stage=\"intent\", intent_model=FunctionModel(exploding_model),\n586\t        )\n587\t    )\n588\t    assert not result.passed\n589\t    assert \"provider is down\" in result.error\n590\t    assert record is None\n591\t\n592\t\n593\t# --------------------------------------------------------------------------\n594\t# --stage narration: genuinely isolated Stage 4, over a fixed envelope\n595\t# --------------------------------------------------------------------------\n596\t\n597\t\n598\tdef test_stage_narration_grades_grounded_prose_as_a_pass():\n599\t    case = CASES[\"answer/VC-POC-01\"]\n600\t    reference_answer = REFERENCES[case.case_id].output[\"answer\"]\n601\t    result, record = asyncio.run(\n602\t        live.run_trial(\n603\t            case, case.phrasings[0], 1, \"stub\",\n604\t            stage=\"narration\", narration_model=make_narration_model(reference_answer),\n605\t        )\n606\t    )\n607\t    assert result.passed, result.detail\n608\t    assert record is not None\n609\t    assert record.output_kind == \"RenderedAnswer\"\n610\t    # Isolation: narration never chose a question or sent a request — the\n611\t    # transcript's one tool call is the fixed envelope fetch this stage did\n612\t    # itself, using the case's own declared expected request.\n613\t    assert len(record.tool_calls) == 1\n614\t    assert record.tool_calls[0].tool == \"fetch_evidence\"\n615\t\n616\t\n617\tdef test_stage_narration_grades_ungrounded_prose_as_a_failure():\n618\t    \"\"\"The harness's own rendering gate (ADR-014) rejects this before the eval\n619\t    grader ever runs: `narrate()` raises `NarrationValidationError` rather than\n620\t    returning an ungrounded answer, so the failure is a validation failure, not\n621\t    a `grounding` grader result read off a completed transcript.\"\"\"\n622\t    case = CASES[\"answer/VC-POC-01\"]\n623\t    result, record = asyncio.run(\n624\t        live.run_trial(\n625\t            case, case.phrasings[0], 1, \"stub\",\n626\t            stage=\"narration\",\n627\t            narration_model=make_narration_model(\"Enrolments reached exactly 987654 students.\"),\n628\t        )\n629\t    )\n630\t    assert not result.passed\n631\t    assert result.failed_graders == [\"narration_validation\"]\n632\t    assert record is None\n633\t\n634\t\n635\tdef test_stage_narration_skips_cases_with_no_fixed_envelope():\n636\t    \"\"\"A `should_clarify`/`should_refuse` case has no expected_question_id and\n637\t    request pair, so the isolated narration stage has nothing to narrate.\"\"\"\n638\t    case = CASES[\"clarify/distance_km\"]\n639\t    result, record = asyncio.run(\n640\t        live.run_trial(case, case.phrasings[0], 1, \"stub\", stage=\"narration\")\n641\t    )\n642\t    assert not result.passed\n643\t    assert result.error is not None and \"expected_question_id\" in result.error\n644\t    assert record is None\n645\t\n646\t\n647\tdef test_select_cases_for_narration_stage_keeps_only_cases_with_a_fixed_request():\n648\t    args = live.build_parser().parse_args([\"--stage\", \"narration\"])\n649\t    selected = live.select_cases(args)\n650\t    assert selected\n651\t    assert all(c.expected_question_id and c.expected_request is not None for c in selected)\n652\t    assert \"clarify/distance_km\" not in {c.case_id for c in selected}\n653\t    assert \"refuse/finance\" not in {c.case_id for c in selected}\n654\t\n655\t\n656\t# --------------------------------------------------------------------------\n657\t# --stage end-to-end: the real new-pipeline ask(), not the legacy tool loop\n658\t# --------------------------------------------------------------------------\n659\t\n660\t\n661\tdef test_stage_end_to_end_runs_the_real_pipeline_offline():\n662\t    \"\"\"`ask(deps, question)` — the NEW pipeline signature — scripted end to\n663\t    end with the real planner, the real stub-emitter subprocess and the real\n664\t    rendering gate, exactly as `evals/replay.py` does for the legacy path.\"\"\"\n665\t    case = CASES[\"answer/VC-POC-REF-01\"]\n666\t    reference_answer = REFERENCES[case.case_id].output[\"answer\"]\n667\t    intent = StructuredIntent(question_id=\"VC-POC-REF-01\")\n668\t    result, record = asyncio.run(\n669\t        live.run_trial(\n670\t            case, case.phrasings[0], 1, \"stub\", stage=\"end-to-end\",\n671\t            intent_model=make_intent_model(intent),\n672\t            narration_model=make_narration_model(reference_answer),\n673\t        )\n674\t    )\n675\t    assert result.passed, result.detail\n676\t    assert record is not None\n677\t    assert record.output_kind == \"RenderedAnswer\"\n678\t    assert record.requested_question_id() == \"VC-POC-REF-01\"\n679\t\n680\t\n681\tdef test_stage_end_to_end_a_wrong_intent_decision_grades_as_a_failure():\n682\t    case = CASES[\"answer/VC-POC-REF-01\"]\n683\t    wrong_intent = StructuredIntent(question_id=\"excluded\", excluded_topic=\"finance\")\n684\t    result, record = asyncio.run(\n685\t        live.run_trial(\n686\t            case, case.phrasings[0], 1, \"stub\", stage=\"end-to-end\",\n687\t            intent_model=make_intent_model(wrong_intent),\n688\t        )\n689\t    )\n690\t    assert not result.passed\n691\t    assert record is not None\n692\t\n693\t\n694\tdef test_resume_with_wrong_stage_is_rejected(monkeypatch, tmp_path):\n695\t    \"\"\"Resuming a checkpoint recorded with a different stage is rejected.\"\"\"\n696\t    case = CASES[\"answer/VC-POC-01\"]\n697\t\n698\t    async def fake_suite(*args, **kwargs):\n699\t        return [], [], [], None"}]},"parent_tool_use_id":null,"session_id":"6a5a4bf9-713c-4453-8836-6a3d15f3b2d0","uuid":"fb3d8828-3035-4e71-80df-4f750d384a77","timestamp":"2026-09-25T23:04:31.645Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/tests/unit/test_live_tier.py","content":"            case, case.phrasings[0], 1, \"stub\", stage=\"intent\", intent_model=make_intent_model(wrong)\n        )\n    )\n    assert not result.passed\n\n\ndef test_stage_intent_a_crashed_call_is_a_failed_trial_not_a_transcript():\n    case = CASES[\"answer/VC-POC-01\"]\n\n    def exploding_model(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:\n        raise RuntimeError(\"provider is down\")\n\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\",\n            stage=\"intent\", intent_model=FunctionModel(exploding_model),\n        )\n    )\n    assert not result.passed\n    assert \"provider is down\" in result.error\n    assert record is None\n\n\n# --------------------------------------------------------------------------\n# --stage narration: genuinely isolated Stage 4, over a fixed envelope\n# --------------------------------------------------------------------------\n\n\ndef test_stage_narration_grades_grounded_prose_as_a_pass():\n    case = CASES[\"answer/VC-POC-01\"]\n    reference_answer = REFERENCES[case.case_id].output[\"answer\"]\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\",\n            stage=\"narration\", narration_model=make_narration_model(reference_answer),\n        )\n    )\n    assert result.passed, result.detail\n    assert record is not None\n    assert record.output_kind == \"RenderedAnswer\"\n    # Isolation: narration never chose a question or sent a request — the\n    # transcript's one tool call is the fixed envelope fetch this stage did\n    # itself, using the case's own declared expected request.\n    assert len(record.tool_calls) == 1\n    assert record.tool_calls[0].tool == \"fetch_evidence\"\n\n\ndef test_stage_narration_grades_ungrounded_prose_as_a_failure():\n    \"\"\"The harness's own rendering gate (ADR-014) rejects this before the eval\n    grader ever runs: `narrate()` raises `NarrationValidationError` rather than\n    returning an ungrounded answer, so the failure is a validation failure, not\n    a `grounding` grader result read off a completed transcript.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\",\n            stage=\"narration\",\n            narration_model=make_narration_model(\"Enrolments reached exactly 987654 students.\"),\n        )\n    )\n    assert not result.passed\n    assert result.failed_graders == [\"narration_validation\"]\n    assert record is None\n\n\ndef test_stage_narration_skips_cases_with_no_fixed_envelope():\n    \"\"\"A `should_clarify`/`should_refuse` case has no expected_question_id and\n    request pair, so the isolated narration stage has nothing to narrate.\"\"\"\n    case = CASES[\"clarify/distance_km\"]\n    result, record = asyncio.run(\n        live.run_trial(case, case.phrasings[0], 1, \"stub\", stage=\"narration\")\n    )\n    assert not result.passed\n    assert result.error is not None and \"expected_question_id\" in result.error\n    assert record is None\n\n\ndef test_select_cases_for_narration_stage_keeps_only_cases_with_a_fixed_request():\n    args = live.build_parser().parse_args([\"--stage\", \"narration\"])\n    selected = live.select_cases(args)\n    assert selected\n    assert all(c.expected_question_id and c.expected_request is not None for c in selected)\n    assert \"clarify/distance_km\" not in {c.case_id for c in selected}\n    assert \"refuse/finance\" not in {c.case_id for c in selected}\n\n\n# --------------------------------------------------------------------------\n# --stage end-to-end: the real new-pipeline ask(), not the legacy tool loop\n# --------------------------------------------------------------------------\n\n\ndef test_stage_end_to_end_runs_the_real_pipeline_offline():\n    \"\"\"`ask(deps, question)` — the NEW pipeline signature — scripted end to\n    end with the real planner, the real stub-emitter subprocess and the real\n    rendering gate, exactly as `evals/replay.py` does for the legacy path.\"\"\"\n    case = CASES[\"answer/VC-POC-REF-01\"]\n    reference_answer = REFERENCES[case.case_id].output[\"answer\"]\n    intent = StructuredIntent(question_id=\"VC-POC-REF-01\")\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"end-to-end\",\n            intent_model=make_intent_model(intent),\n            narration_model=make_narration_model(reference_answer),\n        )\n    )\n    assert result.passed, result.detail\n    assert record is not None\n    assert record.output_kind == \"RenderedAnswer\"\n    assert record.requested_question_id() == \"VC-POC-REF-01\"\n\n\ndef test_stage_end_to_end_a_wrong_intent_decision_grades_as_a_failure():\n    case = CASES[\"answer/VC-POC-REF-01\"]\n    wrong_intent = StructuredIntent(question_id=\"excluded\", excluded_topic=\"finance\")\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"end-to-end\",\n            intent_model=make_intent_model(wrong_intent),\n        )\n    )\n    assert not result.passed\n    assert record is not None\n\n\ndef test_resume_with_wrong_stage_is_rejected(monkeypatch, tmp_path):\n    \"\"\"Resuming a checkpoint recorded with a different stage is rejected.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n\n    async def fake_suite(*args, **kwargs):\n        return [], [], [], None","numLines":130,"startLine":570,"totalLines":717}}}
