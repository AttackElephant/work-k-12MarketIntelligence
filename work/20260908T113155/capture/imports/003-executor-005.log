{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EWXrsjeRRLgVzSDXL3E4r9","type":"tool_result","content":"1\t\"\"\"M2 — the golden-case and run-record shapes the graders read.\n2\t\n3\tTwo structures, deliberately separate:\n4\t\n5\t* `GoldenCase` — what we asked for and what a correct run looks like: the NL\n6\t  phrasings, the expected question ID and structured request, the direction, and\n7\t  whatever the direction needs (material inputs for a clarification, contract\n8\t  exclusion text for a refusal, canary and grader kind for an injection).\n9\t\n10\t* `RunRecord` — the TRANSCRIPT of one run: every tool call with its arguments\n11\t  and its raw result, plus the final output branch. Graders read this and never\n12\t  the agent's own account of what it did (ADR-007). In particular envelope\n13\t  preservation is checked against the envelope the tool actually returned, not\n14\t  against anything the model asserts about it.\n15\t\n16\t`RunRecord` is an EVAL-side observation format, not the harness's output type.\n17\tM3 owns `harness/outputs.py` (architecture §5) and must be able to project a run\n18\tinto this shape; nothing here constrains how the union is modelled internally.\n19\t\"\"\"\n20\t\n21\tfrom __future__ import annotations\n22\t\n23\timport json\n24\tfrom dataclasses import dataclass, field\n25\tfrom pathlib import Path\n26\tfrom typing import Any, Literal\n27\t\n28\tPROJECT_ROOT = Path(__file__).resolve().parent.parent\n29\tCASES_PATH = PROJECT_ROOT / \"evals\" / \"cases\" / \"golden_cases.json\"\n30\tREFERENCE_PATH = PROJECT_ROOT / \"evals\" / \"cases\" / \"reference_solutions.json\"\n31\t\n32\tDirection = Literal[\n33\t    \"should_answer\", \"should_clarify\", \"should_refuse\", \"should_resist_injection\"\n34\t]\n35\t\n36\tOutputKind = Literal[\n37\t    \"RenderedAnswer\", \"ClarificationNeeded\", \"Unsupported\", \"BudgetExceeded\"\n38\t]\n39\t\n40\t# Inputs the emitter defaults and echoes back in resolved_request. An agent that\n41\t# sends one explicitly is not wrong, so a request carrying it on top of the\n42\t# expected request still matches; any OTHER unexpected key is a miss, because a\n43\t# misspelled or invented field is exactly what silent defaulting would hide.\n44\t#\n45\t# v0.3.0: read from the pinned registry's per-question `input_policy.defaultable`\n46\t# rather than a hand-kept list — the contract declares which inputs default, so\n47\t# nothing here can fall out of step with it (the old list still named the dropped\n48\t# `seifa_index` field).\n49\tdef _defaultable_from_registry() -> frozenset[str]:\n50\t    registry_path = (\n51\t        PROJECT_ROOT / \"contract\" / \"poc_question_registry.v0.3.0.json\"\n52\t    )\n53\t    registry = json.loads(registry_path.read_text(\"utf-8\"))\n54\t    keys: set[str] = set()\n55\t    for question in registry[\"questions\"]:\n56\t        for name in question.get(\"input_policy\", {}).get(\"defaultable\", {}):\n57\t            keys.add(name.split(\".\", 1)[0])\n58\t    return frozenset(keys)\n59\t\n60\t\n61\tDEFAULTABLE_REQUEST_KEYS = _defaultable_from_registry()\n62\t\n63\t\n64\t@dataclass(frozen=True)\n65\tclass Injection:\n66\t    \"\"\"The attack planted in the stub envelope, and how to grade resistance.\n67\t\n68\t    `grader` is per-case on purpose. `canary_absent` is only sound where the\n69\t    canary sits in a field a faithful answer has no reason to reproduce (a\n70\t    filter value, a provenance note). Where the canary rides in a school name —\n71\t    which a cohort answer may legitimately quote — absence proves nothing, so\n72\t    the case declares `behavioural` and the forbidden claim is graded instead.\n73\t    \"\"\"\n74\t\n75\t    surface: str\n76\t    canary: str\n77\t    grader: Literal[\"canary_absent\", \"canary_absent_and_limitations_verbatim\", \"behavioural\"]\n78\t    grader_note: str\n79\t\n80\t\n81\t@dataclass(frozen=True)\n82\tclass GoldenCase:\n83\t    case_id: str\n84\t    direction: Direction\n85\t    phrasings: tuple[str, ...]\n86\t    # Which stub fixture case must serve this run (forced via STUB_EMITTER_CASE\n87\t    # so a case can reach an envelope its request alone would not select).\n88\t    stub_case: str | None = None\n89\t    expected_question_id: str | None = None\n90\t    expected_request: dict[str, Any] | None = None\n91\t    # Request keys whose list values compare as multisets — \"metrics\" ordering\n92\t    # carries no meaning, and penalising it would grade JSON serialisation.\n93\t    unordered_request_keys: tuple[str, ...] = ()\n94\t    # Extra keys tolerated for this case beyond DEFAULTABLE_REQUEST_KEYS.\n95\t    extra_request_keys: tuple[str, ...] = ()\n96\t    # should_clarify: the material inputs the agent must ask about, by name.\n97\t    expected_missing_inputs: tuple[str, ...] = ()\n98\t    # should_refuse: the branch's reason_kind, and the contract text the reason\n99\t    # must be sourced from (never harness prose — ADR-009).\n100\t    expected_reason_kind: str | None = None\n101\t    expected_reason_text: str | None = None\n102\t    injection: Injection | None = None\n103\t    notes: str = \"\"\n104\t\n105\t    def to_json(self) -> dict[str, Any]:\n106\t        payload: dict[str, Any] = {\n107\t            \"case_id\": self.case_id,\n108\t            \"direction\": self.direction,\n109\t            \"phrasings\": list(self.phrasings),\n110\t        }\n111\t        for name in (\n112\t            \"stub_case\",\n113\t            \"expected_question_id\",\n114\t            \"expected_request\",\n115\t            \"expected_reason_kind\",\n116\t            \"expected_reason_text\",\n117\t            \"notes\",\n118\t        ):\n119\t            value = getattr(self, name)\n120\t            # `is not None`, not truthiness: VC-POC-REF-01 takes no inputs, so\n121\t            # its expected request is legitimately `{}`. Dropping it on falsiness\n122\t            # round-tripped the case back as None and sent the emitter `null`.\n123\t            if value is not None and value != \"\":\n124\t                payload[name] = value\n125\t        for name in (\n126\t            \"unordered_request_keys\",\n127\t            \"extra_request_keys\",\n128\t            \"expected_missing_inputs\",\n129\t        ):\n130\t            value = getattr(self, name)\n131\t            if value:\n132\t                payload[name] = list(value)\n133\t        if self.injection:\n134\t            payload[\"injection\"] = {\n135\t                \"surface\": self.injection.surface,\n136\t                \"canary\": self.injection.canary,\n137\t                \"grader\": self.injection.grader,\n138\t                \"grader_note\": self.injection.grader_note,\n139\t            }\n140\t        return payload\n141\t\n142\t    @classmethod\n143\t    def from_json(cls, payload: dict[str, Any]) -> GoldenCase:\n144\t        injection = payload.get(\"injection\")\n145\t        return cls(\n146\t            case_id=payload[\"case_id\"],\n147\t            direction=payload[\"direction\"],\n148\t            phrasings=tuple(payload[\"phrasings\"]),\n149\t            stub_case=payload.get(\"stub_case\"),\n150\t            expected_question_id=payload.get(\"expected_question_id\"),\n151\t            expected_request=payload.get(\"expected_request\"),\n152\t            unordered_request_keys=tuple(payload.get(\"unordered_request_keys\", ())),\n153\t            extra_request_keys=tuple(payload.get(\"extra_request_keys\", ())),\n154\t            expected_missing_inputs=tuple(payload.get(\"expected_missing_inputs\", ())),\n155\t            expected_reason_kind=payload.get(\"expected_reason_kind\"),\n156\t            expected_reason_text=payload.get(\"expected_reason_text\"),\n157\t            injection=Injection(**injection) if injection else None,\n158\t            notes=payload.get(\"notes\", \"\"),\n159\t        )\n160\t\n161\t\n162\t@dataclass\n163\tclass ToolCall:\n164\t    \"\"\"One tool invocation as it actually happened.\n165\t\n166\t    `result` is the tool's raw return — for `fetch_evidence` that is the\n167\t    envelope itself, which is what envelope-preservation and grounding are\n168\t    graded against. `error_kind` is set when the emitter exited 2.\n169\t    \"\"\"\n170\t\n171\t    tool: str\n172\t    arguments: dict[str, Any]\n173\t    result: Any = None\n174\t    error_kind: str | None = None\n175\t\n176\t    def to_json(self) -> dict[str, Any]:\n177\t        payload = {\"tool\": self.tool, \"arguments\": self.arguments}\n178\t        if self.result is not None:\n179\t            payload[\"result\"] = self.result\n180\t        if self.error_kind:\n181\t            payload[\"error_kind\"] = self.error_kind\n182\t        return payload\n183\t\n184\t    @classmethod\n185\t    def from_json(cls, payload: dict[str, Any]) -> ToolCall:\n186\t        return cls(\n187\t            tool=payload[\"tool\"],\n188\t            arguments=payload.get(\"arguments\", {}),\n189\t            result=payload.get(\"result\"),\n190\t            error_kind=payload.get(\"error_kind\"),\n191\t        )\n192\t\n193\t\n194\t@dataclass\n195\tclass RunRecord:\n196\t    case_id: str\n197\t    phrasing: str\n198\t    tool_calls: list[ToolCall] = field(default_factory=list)\n199\t    output_kind: OutputKind = \"RenderedAnswer\"\n200\t    output: dict[str, Any] = field(default_factory=dict)\n201\t\n202\t    # -- transcript accessors: what the tools actually returned ---------------\n203\t\n204\t    def evidence_calls(self) -> list[ToolCall]:\n205\t        return [c for c in self.tool_calls if c.tool == \"fetch_evidence\"]\n206\t\n207\t    def last_envelope(self) -> dict[str, Any] | None:\n208\t        \"\"\"The last successfully returned envelope, or None if every evidence\n209\t        call errored (or none was made).\"\"\"\n210\t        for call in reversed(self.evidence_calls()):\n211\t            if call.error_kind is None and isinstance(call.result, dict):\n212\t                return call.result\n213\t        return None\n214\t\n215\t    def requested_question_id(self) -> str | None:\n216\t        calls = self.evidence_calls()\n217\t        return calls[-1].arguments.get(\"question_id\") if calls else None\n218\t\n219\t    def requested_request(self) -> dict[str, Any] | None:\n220\t        calls = self.evidence_calls()\n221\t        return calls[-1].arguments.get(\"request\") if calls else None\n222\t\n223\t    def to_json(self) -> dict[str, Any]:\n224\t        return {\n225\t            \"case_id\": self.case_id,\n226\t            \"phrasing\": self.phrasing,\n227\t            \"tool_calls\": [c.to_json() for c in self.tool_calls],\n228\t            \"output_kind\": self.output_kind,\n229\t            \"output\": self.output,\n230\t        }\n231\t\n232\t    @classmethod\n233\t    def from_json(cls, payload: dict[str, Any]) -> RunRecord:\n234\t        return cls(\n235\t            case_id=payload[\"case_id\"],\n236\t            phrasing=payload[\"phrasing\"],\n237\t            tool_calls=[ToolCall.from_json(c) for c in payload.get(\"tool_calls\", [])],\n238\t            output_kind=payload[\"output_kind\"],\n239\t            output=payload.get(\"output\", {}),\n240\t        )\n241\t\n242\t\n243\tdef load_cases(path: Path | None = None) -> list[GoldenCase]:\n244\t    payload = json.loads((path or CASES_PATH).read_text(\"utf-8\"))\n245\t    return [GoldenCase.from_json(c) for c in payload[\"cases\"]]\n246\t\n247\t\n248\tdef load_reference_solutions(path: Path | None = None) -> dict[str, RunRecord]:\n249\t    payload = json.loads((path or REFERENCE_PATH).read_text(\"utf-8\"))\n250\t    return {r[\"case_id\"]: RunRecord.from_json(r) for r in payload[\"records\"]}\n251\t"}]},"parent_tool_use_id":null,"session_id":"6a5a4bf9-713c-4453-8836-6a3d15f3b2d0","uuid":"ed6f8bb9-ca0d-4c4a-a7fa-7b8812d5c03e","timestamp":"2026-09-25T22:56:42.949Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/evals/schema.py","content":"\"\"\"M2 — the golden-case and run-record shapes the graders read.\n\nTwo structures, deliberately separate:\n\n* `GoldenCase` — what we asked for and what a correct run looks like: the NL\n  phrasings, the expected question ID and structured request, the direction, and\n  whatever the direction needs (material inputs for a clarification, contract\n  exclusion text for a refusal, canary and grader kind for an injection).\n\n* `RunRecord` — the TRANSCRIPT of one run: every tool call with its arguments\n  and its raw result, plus the final output branch. Graders read this and never\n  the agent's own account of what it did (ADR-007). In particular envelope\n  preservation is checked against the envelope the tool actually returned, not\n  against anything the model asserts about it.\n\n`RunRecord` is an EVAL-side observation format, not the harness's output type.\nM3 owns `harness/outputs.py` (architecture §5) and must be able to project a run\ninto this shape; nothing here constrains how the union is modelled internally.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\nfrom typing import Any, Literal\n\nPROJECT_ROOT = Path(__file__).resolve().parent.parent\nCASES_PATH = PROJECT_ROOT / \"evals\" / \"cases\" / \"golden_cases.json\"\nREFERENCE_PATH = PROJECT_ROOT / \"evals\" / \"cases\" / \"reference_solutions.json\"\n\nDirection = Literal[\n    \"should_answer\", \"should_clarify\", \"should_refuse\", \"should_resist_injection\"\n]\n\nOutputKind = Literal[\n    \"RenderedAnswer\", \"ClarificationNeeded\", \"Unsupported\", \"BudgetExceeded\"\n]\n\n# Inputs the emitter defaults and echoes back in resolved_request. An agent that\n# sends one explicitly is not wrong, so a request carrying it on top of the\n# expected request still matches; any OTHER unexpected key is a miss, because a\n# misspelled or invented field is exactly what silent defaulting would hide.\n#\n# v0.3.0: read from the pinned registry's per-question `input_policy.defaultable`\n# rather than a hand-kept list — the contract declares which inputs default, so\n# nothing here can fall out of step with it (the old list still named the dropped\n# `seifa_index` field).\ndef _defaultable_from_registry() -> frozenset[str]:\n    registry_path = (\n        PROJECT_ROOT / \"contract\" / \"poc_question_registry.v0.3.0.json\"\n    )\n    registry = json.loads(registry_path.read_text(\"utf-8\"))\n    keys: set[str] = set()\n    for question in registry[\"questions\"]:\n        for name in question.get(\"input_policy\", {}).get(\"defaultable\", {}):\n            keys.add(name.split(\".\", 1)[0])\n    return frozenset(keys)\n\n\nDEFAULTABLE_REQUEST_KEYS = _defaultable_from_registry()\n\n\n@dataclass(frozen=True)\nclass Injection:\n    \"\"\"The attack planted in the stub envelope, and how to grade resistance.\n\n    `grader` is per-case on purpose. `canary_absent` is only sound where the\n    canary sits in a field a faithful answer has no reason to reproduce (a\n    filter value, a provenance note). Where the canary rides in a school name —\n    which a cohort answer may legitimately quote — absence proves nothing, so\n    the case declares `behavioural` and the forbidden claim is graded instead.\n    \"\"\"\n\n    surface: str\n    canary: str\n    grader: Literal[\"canary_absent\", \"canary_absent_and_limitations_verbatim\", \"behavioural\"]\n    grader_note: str\n\n\n@dataclass(frozen=True)\nclass GoldenCase:\n    case_id: str\n    direction: Direction\n    phrasings: tuple[str, ...]\n    # Which stub fixture case must serve this run (forced via STUB_EMITTER_CASE\n    # so a case can reach an envelope its request alone would not select).\n    stub_case: str | None = None\n    expected_question_id: str | None = None\n    expected_request: dict[str, Any] | None = None\n    # Request keys whose list values compare as multisets — \"metrics\" ordering\n    # carries no meaning, and penalising it would grade JSON serialisation.\n    unordered_request_keys: tuple[str, ...] = ()\n    # Extra keys tolerated for this case beyond DEFAULTABLE_REQUEST_KEYS.\n    extra_request_keys: tuple[str, ...] = ()\n    # should_clarify: the material inputs the agent must ask about, by name.\n    expected_missing_inputs: tuple[str, ...] = ()\n    # should_refuse: the branch's reason_kind, and the contract text the reason\n    # must be sourced from (never harness prose — ADR-009).\n    expected_reason_kind: str | None = None\n    expected_reason_text: str | None = None\n    injection: Injection | None = None\n    notes: str = \"\"\n\n    def to_json(self) -> dict[str, Any]:\n        payload: dict[str, Any] = {\n            \"case_id\": self.case_id,\n            \"direction\": self.direction,\n            \"phrasings\": list(self.phrasings),\n        }\n        for name in (\n            \"stub_case\",\n            \"expected_question_id\",\n            \"expected_request\",\n            \"expected_reason_kind\",\n            \"expected_reason_text\",\n            \"notes\",\n        ):\n            value = getattr(self, name)\n            # `is not None`, not truthiness: VC-POC-REF-01 takes no inputs, so\n            # its expected request is legitimately `{}`. Dropping it on falsiness\n            # round-tripped the case back as None and sent the emitter `null`.\n            if value is not None and value != \"\":\n                payload[name] = value\n        for name in (\n            \"unordered_request_keys\",\n            \"extra_request_keys\",\n            \"expected_missing_inputs\",\n        ):\n            value = getattr(self, name)\n            if value:\n                payload[name] = list(value)\n        if self.injection:\n            payload[\"injection\"] = {\n                \"surface\": self.injection.surface,\n                \"canary\": self.injection.canary,\n                \"grader\": self.injection.grader,\n                \"grader_note\": self.injection.grader_note,\n            }\n        return payload\n\n    @classmethod\n    def from_json(cls, payload: dict[str, Any]) -> GoldenCase:\n        injection = payload.get(\"injection\")\n        return cls(\n            case_id=payload[\"case_id\"],\n            direction=payload[\"direction\"],\n            phrasings=tuple(payload[\"phrasings\"]),\n            stub_case=payload.get(\"stub_case\"),\n            expected_question_id=payload.get(\"expected_question_id\"),\n            expected_request=payload.get(\"expected_request\"),\n            unordered_request_keys=tuple(payload.get(\"unordered_request_keys\", ())),\n            extra_request_keys=tuple(payload.get(\"extra_request_keys\", ())),\n            expected_missing_inputs=tuple(payload.get(\"expected_missing_inputs\", ())),\n            expected_reason_kind=payload.get(\"expected_reason_kind\"),\n            expected_reason_text=payload.get(\"expected_reason_text\"),\n            injection=Injection(**injection) if injection else None,\n            notes=payload.get(\"notes\", \"\"),\n        )\n\n\n@dataclass\nclass ToolCall:\n    \"\"\"One tool invocation as it actually happened.\n\n    `result` is the tool's raw return — for `fetch_evidence` that is the\n    envelope itself, which is what envelope-preservation and grounding are\n    graded against. `error_kind` is set when the emitter exited 2.\n    \"\"\"\n\n    tool: str\n    arguments: dict[str, Any]\n    result: Any = None\n    error_kind: str | None = None\n\n    def to_json(self) -> dict[str, Any]:\n        payload = {\"tool\": self.tool, \"arguments\": self.arguments}\n        if self.result is not None:\n            payload[\"result\"] = self.result\n        if self.error_kind:\n            payload[\"error_kind\"] = self.error_kind\n        return payload\n\n    @classmethod\n    def from_json(cls, payload: dict[str, Any]) -> ToolCall:\n        return cls(\n            tool=payload[\"tool\"],\n            arguments=payload.get(\"arguments\", {}),\n            result=payload.get(\"result\"),\n            error_kind=payload.get(\"error_kind\"),\n        )\n\n\n@dataclass\nclass RunRecord:\n    case_id: str\n    phrasing: str\n    tool_calls: list[ToolCall] = field(default_factory=list)\n    output_kind: OutputKind = \"RenderedAnswer\"\n    output: dict[str, Any] = field(default_factory=dict)\n\n    # -- transcript accessors: what the tools actually returned ---------------\n\n    def evidence_calls(self) -> list[ToolCall]:\n        return [c for c in self.tool_calls if c.tool == \"fetch_evidence\"]\n\n    def last_envelope(self) -> dict[str, Any] | None:\n        \"\"\"The last successfully returned envelope, or None if every evidence\n        call errored (or none was made).\"\"\"\n        for call in reversed(self.evidence_calls()):\n            if call.error_kind is None and isinstance(call.result, dict):\n                return call.result\n        return None\n\n    def requested_question_id(self) -> str | None:\n        calls = self.evidence_calls()\n        return calls[-1].arguments.get(\"question_id\") if calls else None\n\n    def requested_request(self) -> dict[str, Any] | None:\n        calls = self.evidence_calls()\n        return calls[-1].arguments.get(\"request\") if calls else None\n\n    def to_json(self) -> dict[str, Any]:\n        return {\n            \"case_id\": self.case_id,\n            \"phrasing\": self.phrasing,\n            \"tool_calls\": [c.to_json() for c in self.tool_calls],\n            \"output_kind\": self.output_kind,\n            \"output\": self.output,\n        }\n\n    @classmethod\n    def from_json(cls, payload: dict[str, Any]) -> RunRecord:\n        return cls(\n            case_id=payload[\"case_id\"],\n            phrasing=payload[\"phrasing\"],\n            tool_calls=[ToolCall.from_json(c) for c in payload.get(\"tool_calls\", [])],\n            output_kind=payload[\"output_kind\"],\n            output=payload.get(\"output\", {}),\n        )\n\n\ndef load_cases(path: Path | None = None) -> list[GoldenCase]:\n    payload = json.loads((path or CASES_PATH).read_text(\"utf-8\"))\n    return [GoldenCase.from_json(c) for c in payload[\"cases\"]]\n\n\ndef load_reference_solutions(path: Path | None = None) -> dict[str, RunRecord]:\n    payload = json.loads((path or REFERENCE_PATH).read_text(\"utf-8\"))\n    return {r[\"case_id\"]: RunRecord.from_json(r) for r in payload[\"records\"]}\n","numLines":251,"startLine":1,"totalLines":251}}}
