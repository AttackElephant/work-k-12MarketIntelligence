{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GTtmjcmqP6QTWx2fSpdH7n","type":"tool_result","content":"1\t\"\"\"Paid smoke tests for the real model path.\n2\t\n3\tRun explicitly with::\n4\t\n5\t    .venv/bin/python -m pytest tests/live -m live -q\n6\t\n7\tThe broad pass@k/pass^k experiment remains ``python -m evals.live``.  These\n8\ttests cover the small set of properties that cannot be observed offline:\n9\tmodel judgement, prompt-cache reads, and the provider-backed control envelope.\n10\t\"\"\"\n11\t\n12\tfrom __future__ import annotations\n13\t\n14\timport asyncio\n15\timport os\n16\t\n17\timport pytest\n18\t\n19\tfrom config import settings\n20\tfrom evals import live\n21\tfrom evals.schema import load_cases\n22\tfrom harness import usage\n23\tfrom harness.agent import ask, build_agent\n24\tfrom harness.tools import Deps\n25\tfrom run import require_credentials\n26\t\n27\tpytestmark = pytest.mark.live\n28\t\n29\tCASES = {case.case_id: case for case in load_cases()}\n30\tEMITTER = os.getenv(\"LIVE_EVAL_EMITTER\", \"stub\")\n31\t\n32\t\n33\t@pytest.fixture(scope=\"module\", autouse=True)\n34\tdef _needs_credentials():\n35\t    \"\"\"Use the same prerequisite as the CLI instead of re-implementing it.\n36\t\n37\t    The default accepts an explicit Claude Code subscription-account token.\n38\t    The optional Anthropic SDK mode retains its own supported credential chain.\n39\t    \"\"\"\n40\t    try:\n41\t        require_credentials()\n42\t    except SystemExit as exc:\n43\t        pytest.skip(str(exc))\n44\t\n45\t\n46\t@pytest.mark.parametrize(\n47\t    \"case_id\",\n48\t    [\"answer/VC-POC-REF-01\", \"clarify/peer_filters\", \"refuse/finance\"],\n49\t    ids=lambda case_id: case_id,\n50\t)\n51\tdef test_one_case_per_direction_survives_a_live_run(case_id):\n52\t    \"\"\"One trial over each direction walked by the demo.\"\"\"\n53\t    case = CASES.get(case_id)\n54\t    if case is None:\n55\t        pytest.skip(f\"{case_id} is not in the current case set\")\n56\t    result, record = asyncio.run(live.run_trial(case, case.phrasings[0], 1, EMITTER))\n57\t    assert record is not None, result.error\n58\t    assert result.passed, result.detail\n59\t\n60\t\n61\tdef test_the_frozen_prompt_is_actually_cached():\n62\t    \"\"\"The second immediate run must read the provider prompt cache.\"\"\"\n63\t    if settings.MODEL_PROVIDER == \"claude_account\":\n64\t        pytest.skip(\"Claude CLI account mode does not expose cache counters\")\n65\t    case = CASES[\"answer/VC-POC-01\"]\n66\t    agent = build_agent()\n67\t\n68\t    reads = []\n69\t    for _ in range(2):\n70\t        deps = Deps(client=live.build_client(EMITTER, case.stub_case))\n71\t        asyncio.run(ask(agent, deps, case.phrasings[0]))\n72\t        records = usage.extract_request_records(\n73\t            deps.last_messages, run_id=\"cache-check\", question=case.phrasings[0]\n74\t        )\n75\t        reads.append(sum(record.cache_read_tokens for record in records))\n76\t\n77\t    assert reads[1] > 0, (\n78\t        f\"no cache read on the second run (writes/reads: {reads}) — the prompt is \"\n79\t        \"either below the model's cache minimum or no longer byte-exact between runs\"\n80\t    )\n81\t\n82\t\n83\tdef test_a_live_run_stays_inside_the_control_envelope():\n84\t    case = CASES[\"answer/VC-POC-01\"]\n85\t    deps = Deps(client=live.build_client(EMITTER, case.stub_case))\n86\t    output = asyncio.run(ask(build_agent(), deps, case.phrasings[0]))\n87\t\n88\t    assert output.kind != \"budget_exceeded\", getattr(output, \"detail\", \"\")\n89\t    spent, complete = usage.spend_usd(deps.last_messages)\n90\t    assert spent <= settings.LOOP_MAX_USD\n91\t    if settings.MODEL_PROVIDER == \"anthropic_sdk\":\n92\t        assert complete, (\n93\t            f\"{settings.MODEL_PRIMARY} is unknown to the price database, so the spend \"\n94\t            \"budget is not measuring anything — fix that before trusting a live run\"\n95\t        )\n96\t    else:\n97\t        assert not complete, \"account plans do not expose per-request USD pricing\"\n98\t"}]},"parent_tool_use_id":null,"session_id":"6a5a4bf9-713c-4453-8836-6a3d15f3b2d0","uuid":"345ab79b-a3c2-4cf8-873e-09b7db472243","timestamp":"2026-09-25T22:57:00.995Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/tests/live/test_live_eval.py","content":"\"\"\"Paid smoke tests for the real model path.\n\nRun explicitly with::\n\n    .venv/bin/python -m pytest tests/live -m live -q\n\nThe broad pass@k/pass^k experiment remains ``python -m evals.live``.  These\ntests cover the small set of properties that cannot be observed offline:\nmodel judgement, prompt-cache reads, and the provider-backed control envelope.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport os\n\nimport pytest\n\nfrom config import settings\nfrom evals import live\nfrom evals.schema import load_cases\nfrom harness import usage\nfrom harness.agent import ask, build_agent\nfrom harness.tools import Deps\nfrom run import require_credentials\n\npytestmark = pytest.mark.live\n\nCASES = {case.case_id: case for case in load_cases()}\nEMITTER = os.getenv(\"LIVE_EVAL_EMITTER\", \"stub\")\n\n\n@pytest.fixture(scope=\"module\", autouse=True)\ndef _needs_credentials():\n    \"\"\"Use the same prerequisite as the CLI instead of re-implementing it.\n\n    The default accepts an explicit Claude Code subscription-account token.\n    The optional Anthropic SDK mode retains its own supported credential chain.\n    \"\"\"\n    try:\n        require_credentials()\n    except SystemExit as exc:\n        pytest.skip(str(exc))\n\n\n@pytest.mark.parametrize(\n    \"case_id\",\n    [\"answer/VC-POC-REF-01\", \"clarify/peer_filters\", \"refuse/finance\"],\n    ids=lambda case_id: case_id,\n)\ndef test_one_case_per_direction_survives_a_live_run(case_id):\n    \"\"\"One trial over each direction walked by the demo.\"\"\"\n    case = CASES.get(case_id)\n    if case is None:\n        pytest.skip(f\"{case_id} is not in the current case set\")\n    result, record = asyncio.run(live.run_trial(case, case.phrasings[0], 1, EMITTER))\n    assert record is not None, result.error\n    assert result.passed, result.detail\n\n\ndef test_the_frozen_prompt_is_actually_cached():\n    \"\"\"The second immediate run must read the provider prompt cache.\"\"\"\n    if settings.MODEL_PROVIDER == \"claude_account\":\n        pytest.skip(\"Claude CLI account mode does not expose cache counters\")\n    case = CASES[\"answer/VC-POC-01\"]\n    agent = build_agent()\n\n    reads = []\n    for _ in range(2):\n        deps = Deps(client=live.build_client(EMITTER, case.stub_case))\n        asyncio.run(ask(agent, deps, case.phrasings[0]))\n        records = usage.extract_request_records(\n            deps.last_messages, run_id=\"cache-check\", question=case.phrasings[0]\n        )\n        reads.append(sum(record.cache_read_tokens for record in records))\n\n    assert reads[1] > 0, (\n        f\"no cache read on the second run (writes/reads: {reads}) — the prompt is \"\n        \"either below the model's cache minimum or no longer byte-exact between runs\"\n    )\n\n\ndef test_a_live_run_stays_inside_the_control_envelope():\n    case = CASES[\"answer/VC-POC-01\"]\n    deps = Deps(client=live.build_client(EMITTER, case.stub_case))\n    output = asyncio.run(ask(build_agent(), deps, case.phrasings[0]))\n\n    assert output.kind != \"budget_exceeded\", getattr(output, \"detail\", \"\")\n    spent, complete = usage.spend_usd(deps.last_messages)\n    assert spent <= settings.LOOP_MAX_USD\n    if settings.MODEL_PROVIDER == \"anthropic_sdk\":\n        assert complete, (\n            f\"{settings.MODEL_PRIMARY} is unknown to the price database, so the spend \"\n            \"budget is not measuring anything — fix that before trusting a live run\"\n        )\n    else:\n        assert not complete, \"account plans do not expose per-request USD pricing\"\n","numLines":98,"startLine":1,"totalLines":98}}}
