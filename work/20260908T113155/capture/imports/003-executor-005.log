{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HWgRd7yRDDheLmDbF9dTob","type":"tool_result","content":"590\t    reports = completed_reports(cases, slots, all_trials)\n591\t    return reports, all_trials, transcripts, interruption\n592\t\n593\t\n594\tdef aggregate(reports: list[CaseReport], trials: list[TrialResult]) -> dict[str, Any]:\n595\t    if not reports:\n596\t        return {\n597\t            \"cases\": 0,\n598\t            \"trials\": len(trials),\n599\t            \"pass_at_k\": None,\n600\t            \"pass_hat_k\": None,\n601\t            \"cost_usd\": None,\n602\t            \"cost_complete\": False,\n603\t            \"errored_trials\": sum(1 for t in trials if t.error),\n604\t        }\n605\t    priced = [t.cost_usd for t in trials if t.cost_usd is not None]\n606\t    return {\n607\t        \"cases\": len(reports),\n608\t        \"trials\": len(trials),\n609\t        \"pass_at_k\": round(sum(r.pass_at_k for r in reports) / len(reports), 4),\n610\t        \"pass_hat_k\": round(sum(r.pass_hat_k for r in reports) / len(reports), 4),\n611\t        \"cost_usd\": round(sum(priced), 6) if priced else None,\n612\t        # `complete` means every trial was priced AND there was something to\n613\t        # price. Without the second half a run where nothing reached the model\n614\t        # reported \"cost: None (complete=True)\" — a null figure asserting it was\n615\t        # the whole story.\n616\t        \"cost_complete\": bool(priced) and all(t.cost_complete for t in trials),\n617\t        \"errored_trials\": sum(1 for t in trials if t.error),\n618\t    }\n619\t\n620\t\n621\tdef write_report(\n622\t    payload: dict[str, Any],\n623\t    transcripts: list[RunRecord],\n624\t    report_dir: Path,\n625\t    path: Path | None = None,\n626\t) -> Path:\n627\t    report_dir.mkdir(parents=True, exist_ok=True)\n628\t    if path is None:\n629\t        stamp = datetime.now(timezone.utc).strftime(\"%Y%m%dT%H%M%SZ\")\n630\t        path = report_dir / f\"live-{stamp}.json\"\n631\t    sibling = path.with_name(f\"{path.stem}-transcripts.json\")\n632\t    # Replace both files atomically so a killed process leaves the most recent\n633\t    # complete checkpoint rather than half-written JSON.\n634\t    report_tmp = path.with_suffix(path.suffix + \".tmp\")\n635\t    transcript_tmp = sibling.with_suffix(sibling.suffix + \".tmp\")\n636\t    report_tmp.write_text(json.dumps(payload, indent=2) + \"\\n\", encoding=\"utf-8\")\n637\t    transcript_tmp.write_text(\n638\t        json.dumps({\"records\": [r.to_json() for r in transcripts]}, indent=2) + \"\\n\",\n639\t        encoding=\"utf-8\",\n640\t    )\n641\t    transcript_tmp.replace(sibling)\n642\t    report_tmp.replace(path)\n643\t    return path\n644\t\n645\t\n646\tdef build_parser() -> argparse.ArgumentParser:\n647\t    parser = argparse.ArgumentParser(\n648\t        prog=\"python -m evals.live\",\n649\t        description=\"Run the golden cases against a real model. Spends real tokens.\",\n650\t    )\n651\t    parser.add_argument(\n652\t        \"--k\", type=int, default=3,\n653\t        help=\"trials per case (default 3; repeated per base with --all-phrasings)\",\n654\t    )\n655\t    parser.add_argument(\n656\t        \"--emitter\",\n657\t        choices=(\"stub\", \"real\"),\n658\t        default=\"stub\",\n659\t        help=\"stub fixtures (default) or the data project's real emitter\",\n660\t    )\n661\t    parser.add_argument(\"--case\", action=\"append\", default=[], help=\"run only these case IDs\")\n662\t    parser.add_argument(\n663\t        \"--direction\",\n664\t        action=\"append\",\n665\t        default=[],\n666\t        help=\"run only these directions (should_answer, should_clarify, ...)\",\n667\t    )\n668\t    parser.add_argument(\n669\t        \"--pressure\",\n670\t        action=\"store_true\",\n671\t        help=\"append red-team softening phrasings (the O-10 probe)\",\n672\t    )\n673\t    parser.add_argument(\n674\t        \"--all-phrasings\", action=\"store_true\", help=\"run every phrasing, not just the first\"\n675\t    )\n676\t    parser.add_argument(\n677\t        \"--stage\",\n678\t        choices=(\"intent\", \"narration\", \"end-to-end\"),\n679\t        default=None,\n680\t        help=(\n681\t            \"which pipeline stage to evaluate: \"\n682\t            \"'intent' (NL→StructuredIntent), \"\n683\t            \"'narration' (AnswerView→narrative), \"\n684\t            \"'end-to-end' (full pipeline, k=1 only). \"\n685\t            \"Omit to run the full pipeline with any k (the default mode).\"\n686\t        ),\n687\t    )\n688\t    parser.add_argument(\"--report-dir\", type=Path, default=REPORT_DIR)\n689\t    parser.add_argument(\"--resume\", type=Path, help=\"resume an interrupted live report\")"}]},"parent_tool_use_id":null,"session_id":"6a5a4bf9-713c-4453-8836-6a3d15f3b2d0","uuid":"c831840e-e84e-4f6a-8f89-227839bb8667","timestamp":"2026-09-25T23:04:22.278Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/evals/live.py","content":"    reports = completed_reports(cases, slots, all_trials)\n    return reports, all_trials, transcripts, interruption\n\n\ndef aggregate(reports: list[CaseReport], trials: list[TrialResult]) -> dict[str, Any]:\n    if not reports:\n        return {\n            \"cases\": 0,\n            \"trials\": len(trials),\n            \"pass_at_k\": None,\n            \"pass_hat_k\": None,\n            \"cost_usd\": None,\n            \"cost_complete\": False,\n            \"errored_trials\": sum(1 for t in trials if t.error),\n        }\n    priced = [t.cost_usd for t in trials if t.cost_usd is not None]\n    return {\n        \"cases\": len(reports),\n        \"trials\": len(trials),\n        \"pass_at_k\": round(sum(r.pass_at_k for r in reports) / len(reports), 4),\n        \"pass_hat_k\": round(sum(r.pass_hat_k for r in reports) / len(reports), 4),\n        \"cost_usd\": round(sum(priced), 6) if priced else None,\n        # `complete` means every trial was priced AND there was something to\n        # price. Without the second half a run where nothing reached the model\n        # reported \"cost: None (complete=True)\" — a null figure asserting it was\n        # the whole story.\n        \"cost_complete\": bool(priced) and all(t.cost_complete for t in trials),\n        \"errored_trials\": sum(1 for t in trials if t.error),\n    }\n\n\ndef write_report(\n    payload: dict[str, Any],\n    transcripts: list[RunRecord],\n    report_dir: Path,\n    path: Path | None = None,\n) -> Path:\n    report_dir.mkdir(parents=True, exist_ok=True)\n    if path is None:\n        stamp = datetime.now(timezone.utc).strftime(\"%Y%m%dT%H%M%SZ\")\n        path = report_dir / f\"live-{stamp}.json\"\n    sibling = path.with_name(f\"{path.stem}-transcripts.json\")\n    # Replace both files atomically so a killed process leaves the most recent\n    # complete checkpoint rather than half-written JSON.\n    report_tmp = path.with_suffix(path.suffix + \".tmp\")\n    transcript_tmp = sibling.with_suffix(sibling.suffix + \".tmp\")\n    report_tmp.write_text(json.dumps(payload, indent=2) + \"\\n\", encoding=\"utf-8\")\n    transcript_tmp.write_text(\n        json.dumps({\"records\": [r.to_json() for r in transcripts]}, indent=2) + \"\\n\",\n        encoding=\"utf-8\",\n    )\n    transcript_tmp.replace(sibling)\n    report_tmp.replace(path)\n    return path\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(\n        prog=\"python -m evals.live\",\n        description=\"Run the golden cases against a real model. Spends real tokens.\",\n    )\n    parser.add_argument(\n        \"--k\", type=int, default=3,\n        help=\"trials per case (default 3; repeated per base with --all-phrasings)\",\n    )\n    parser.add_argument(\n        \"--emitter\",\n        choices=(\"stub\", \"real\"),\n        default=\"stub\",\n        help=\"stub fixtures (default) or the data project's real emitter\",\n    )\n    parser.add_argument(\"--case\", action=\"append\", default=[], help=\"run only these case IDs\")\n    parser.add_argument(\n        \"--direction\",\n        action=\"append\",\n        default=[],\n        help=\"run only these directions (should_answer, should_clarify, ...)\",\n    )\n    parser.add_argument(\n        \"--pressure\",\n        action=\"store_true\",\n        help=\"append red-team softening phrasings (the O-10 probe)\",\n    )\n    parser.add_argument(\n        \"--all-phrasings\", action=\"store_true\", help=\"run every phrasing, not just the first\"\n    )\n    parser.add_argument(\n        \"--stage\",\n        choices=(\"intent\", \"narration\", \"end-to-end\"),\n        default=None,\n        help=(\n            \"which pipeline stage to evaluate: \"\n            \"'intent' (NL→StructuredIntent), \"\n            \"'narration' (AnswerView→narrative), \"\n            \"'end-to-end' (full pipeline, k=1 only). \"\n            \"Omit to run the full pipeline with any k (the default mode).\"\n        ),\n    )\n    parser.add_argument(\"--report-dir\", type=Path, default=REPORT_DIR)\n    parser.add_argument(\"--resume\", type=Path, help=\"resume an interrupted live report\")","numLines":100,"startLine":590,"totalLines":895}}}
