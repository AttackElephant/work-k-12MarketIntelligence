{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SN5mDJkefFdgwizWdq7hnp","type":"tool_result","content":"440\t\n441\tdef test_the_stub_client_forces_the_case_fixture_it_declares():\n442\t    \"\"\"A case that exists to test an empty or gappy series must reach that\n443\t    envelope even when a live model's request differs in a defaultable way. The\n444\t    request itself is still graded, from the transcript.\"\"\"\n445\t    client = live.build_client(\"stub\", \"VC-POC-01/empty-series\")\n446\t    assert client.env[\"STUB_EMITTER_CASE\"] == \"VC-POC-01/empty-series\"\n447\t    assert \"STUB_EMITTER_CASE\" not in live.build_client(\"stub\", None).env\n448\t\n449\t\n450\t# --------------------------------------------------------------------------\n451\t# --stage CLI validation\n452\t# --------------------------------------------------------------------------\n453\t\n454\t\n455\tdef test_stage_intent_with_pressure_is_rejected():\n456\t    \"\"\"--stage intent --pressure is rejected: pressure applies to narration, not intent.\"\"\"\n457\t    with pytest.raises(SystemExit, match=\"--pressure is not valid\"):\n458\t        live.main([\"--stage\", \"intent\", \"--pressure\"])\n459\t\n460\t\n461\tdef test_stage_end_to_end_with_k_greater_than_1_is_rejected():\n462\t    \"\"\"--stage end-to-end --k 5 is rejected: the smoke suite must be k=1.\"\"\"\n463\t    with pytest.raises(SystemExit, match=\"--stage end-to-end requires --k 1\"):\n464\t        live.main([\"--stage\", \"end-to-end\", \"--k\", \"5\"])\n465\t\n466\t\n467\tdef test_stage_end_to_end_with_k_1_parses_without_rejection():\n468\t    \"\"\"--stage end-to-end --k 1 is a valid combination (the argument parsing accepts it).\"\"\"\n469\t    parser = live.build_parser()\n470\t    args = parser.parse_args([\"--stage\", \"end-to-end\", \"--k\", \"1\"])\n471\t    assert args.stage == \"end-to-end\"\n472\t    assert args.k == 1\n473\t\n474\t\n475\tdef test_stage_narration_with_pressure_parses_without_rejection():\n476\t    \"\"\"--stage narration --pressure is valid (pressure probes the prose stage).\"\"\"\n477\t    parser = live.build_parser()\n478\t    args = parser.parse_args([\"--stage\", \"narration\", \"--pressure\"])\n479\t    assert args.stage == \"narration\"\n480\t    assert args.pressure is True\n481\t\n482\t\n483\tdef test_stage_none_is_the_default():\n484\t    \"\"\"No --stage means None (the existing full-pipeline mode).\"\"\"\n485\t    parser = live.build_parser()\n486\t    args = parser.parse_args([])\n487\t    assert args.stage is None\n488\t\n489\t\n490\tdef test_stage_is_included_in_checkpoint_payload(monkeypatch, tmp_path):\n491\t    \"\"\"The stage field is written into the checkpoint for resume compatibility.\"\"\"\n492\t    case = CASES[\"answer/VC-POC-01\"]\n493\t\n494\t    async def fake_suite(*args, **kwargs):\n495\t        return [], [], [], None\n496\t\n497\t    monkeypatch.setattr(live, \"run_suite\", fake_suite)\n498\t    monkeypatch.setattr(\"run.require_credentials\", lambda: None)\n499\t\n500\t    live.main(\n501\t        [\"--stage\", \"intent\", \"--k\", \"1\", \"--case\", case.case_id,\n502\t         \"--report-dir\", str(tmp_path)]\n503\t    )\n504\t    report_path = next(\n505\t        path for path in tmp_path.glob(\"live-*.json\")\n506\t        if not path.stem.endswith(\"-transcripts\")\n507\t    )\n508\t    payload = json.loads(report_path.read_text(\"utf-8\"))\n509\t    assert payload.get(\"stage\") == \"intent\"\n510\t    assert payload.get(\"selection\", {}).get(\"stage\") == \"intent\"\n511\t\n512\t\n513\tdef test_stage_none_still_uses_the_legacy_tool_loop():\n514\t    \"\"\"The default (no --stage) mode is unchanged: `run_trial` still drives the\n515\t    legacy `build_agent()` + `ask(agent, deps, question)` path.\"\"\"\n516\t    case = CASES[\"answer/VC-POC-01\"]\n517\t    result, record = asyncio.run(\n518\t        live.run_trial(case, case.phrasings[0], 1, \"stub\", scripted_factory(case.case_id))\n519\t    )\n520\t    assert result.passed, result.detail\n521\t    assert record is not None\n522\t\n523\t\n524\t# --------------------------------------------------------------------------\n525\t# --stage intent: genuinely isolated Stage 1, no tools, no evidence subprocess\n526\t# --------------------------------------------------------------------------\n527\t\n528\t\n529\tdef test_stage_intent_grades_a_correct_classification_as_a_pass():\n530\t    case = CASES[\"answer/VC-POC-01\"]\n531\t    intent = StructuredIntent(question_id=\"VC-POC-01\", school_mentions=[\"Alpha College\"])\n532\t    result, record = asyncio.run(\n533\t        live.run_trial(\n534\t            case, case.phrasings[0], 1, \"stub\", stage=\"intent\", intent_model=make_intent_model(intent)\n535\t        )\n536\t    )\n537\t    assert result.passed, result.detail\n538\t    assert record is None, \"the intent stage makes no tool calls, so there is no transcript\"\n539\t    assert result.cost_complete is not None\n540\t\n541\t\n542\tdef test_stage_intent_grades_a_wrong_classification_as_a_failure():\n543\t    case = CASES[\"answer/VC-POC-01\"]\n544\t    wrong = StructuredIntent(question_id=\"VC-POC-02\")\n545\t    result, record = asyncio.run(\n546\t        live.run_trial(\n547\t            case, case.phrasings[0], 1, \"stub\", stage=\"intent\", intent_model=make_intent_model(wrong)\n548\t        )\n549\t    )\n550\t    assert not result.passed\n551\t    assert result.failed_graders == [\"intent_question_match\"]\n552\t    assert record is None\n553\t\n554\t\n555\tdef test_stage_intent_grades_a_refusal_case_by_the_excluded_classification():\n556\t    \"\"\"`should_refuse` cases have no `expected_question_id` — the isolated\n557\t    check is that the model recognised the topic as excluded.\"\"\"\n558\t    case = CASES[\"refuse/finance\"]\n559\t    intent = StructuredIntent(question_id=\"excluded\", excluded_topic=\"finance\")\n560\t    result, _ = asyncio.run(\n561\t        live.run_trial(\n562\t            case, case.phrasings[0], 1, \"stub\", stage=\"intent\", intent_model=make_intent_model(intent)\n563\t        )\n564\t    )\n565\t    assert result.passed, result.detail\n566\t\n567\t    wrong = StructuredIntent(question_id=\"VC-POC-01\")\n568\t    result, _ = asyncio.run(\n569\t        live.run_trial("}]},"parent_tool_use_id":null,"session_id":"6a5a4bf9-713c-4453-8836-6a3d15f3b2d0","uuid":"c08e6dd6-b336-4a9b-a23b-5de90d395e9d","timestamp":"2026-09-25T23:04:25.964Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/tests/unit/test_live_tier.py","content":"\ndef test_the_stub_client_forces_the_case_fixture_it_declares():\n    \"\"\"A case that exists to test an empty or gappy series must reach that\n    envelope even when a live model's request differs in a defaultable way. The\n    request itself is still graded, from the transcript.\"\"\"\n    client = live.build_client(\"stub\", \"VC-POC-01/empty-series\")\n    assert client.env[\"STUB_EMITTER_CASE\"] == \"VC-POC-01/empty-series\"\n    assert \"STUB_EMITTER_CASE\" not in live.build_client(\"stub\", None).env\n\n\n# --------------------------------------------------------------------------\n# --stage CLI validation\n# --------------------------------------------------------------------------\n\n\ndef test_stage_intent_with_pressure_is_rejected():\n    \"\"\"--stage intent --pressure is rejected: pressure applies to narration, not intent.\"\"\"\n    with pytest.raises(SystemExit, match=\"--pressure is not valid\"):\n        live.main([\"--stage\", \"intent\", \"--pressure\"])\n\n\ndef test_stage_end_to_end_with_k_greater_than_1_is_rejected():\n    \"\"\"--stage end-to-end --k 5 is rejected: the smoke suite must be k=1.\"\"\"\n    with pytest.raises(SystemExit, match=\"--stage end-to-end requires --k 1\"):\n        live.main([\"--stage\", \"end-to-end\", \"--k\", \"5\"])\n\n\ndef test_stage_end_to_end_with_k_1_parses_without_rejection():\n    \"\"\"--stage end-to-end --k 1 is a valid combination (the argument parsing accepts it).\"\"\"\n    parser = live.build_parser()\n    args = parser.parse_args([\"--stage\", \"end-to-end\", \"--k\", \"1\"])\n    assert args.stage == \"end-to-end\"\n    assert args.k == 1\n\n\ndef test_stage_narration_with_pressure_parses_without_rejection():\n    \"\"\"--stage narration --pressure is valid (pressure probes the prose stage).\"\"\"\n    parser = live.build_parser()\n    args = parser.parse_args([\"--stage\", \"narration\", \"--pressure\"])\n    assert args.stage == \"narration\"\n    assert args.pressure is True\n\n\ndef test_stage_none_is_the_default():\n    \"\"\"No --stage means None (the existing full-pipeline mode).\"\"\"\n    parser = live.build_parser()\n    args = parser.parse_args([])\n    assert args.stage is None\n\n\ndef test_stage_is_included_in_checkpoint_payload(monkeypatch, tmp_path):\n    \"\"\"The stage field is written into the checkpoint for resume compatibility.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n\n    async def fake_suite(*args, **kwargs):\n        return [], [], [], None\n\n    monkeypatch.setattr(live, \"run_suite\", fake_suite)\n    monkeypatch.setattr(\"run.require_credentials\", lambda: None)\n\n    live.main(\n        [\"--stage\", \"intent\", \"--k\", \"1\", \"--case\", case.case_id,\n         \"--report-dir\", str(tmp_path)]\n    )\n    report_path = next(\n        path for path in tmp_path.glob(\"live-*.json\")\n        if not path.stem.endswith(\"-transcripts\")\n    )\n    payload = json.loads(report_path.read_text(\"utf-8\"))\n    assert payload.get(\"stage\") == \"intent\"\n    assert payload.get(\"selection\", {}).get(\"stage\") == \"intent\"\n\n\ndef test_stage_none_still_uses_the_legacy_tool_loop():\n    \"\"\"The default (no --stage) mode is unchanged: `run_trial` still drives the\n    legacy `build_agent()` + `ask(agent, deps, question)` path.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    result, record = asyncio.run(\n        live.run_trial(case, case.phrasings[0], 1, \"stub\", scripted_factory(case.case_id))\n    )\n    assert result.passed, result.detail\n    assert record is not None\n\n\n# --------------------------------------------------------------------------\n# --stage intent: genuinely isolated Stage 1, no tools, no evidence subprocess\n# --------------------------------------------------------------------------\n\n\ndef test_stage_intent_grades_a_correct_classification_as_a_pass():\n    case = CASES[\"answer/VC-POC-01\"]\n    intent = StructuredIntent(question_id=\"VC-POC-01\", school_mentions=[\"Alpha College\"])\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"intent\", intent_model=make_intent_model(intent)\n        )\n    )\n    assert result.passed, result.detail\n    assert record is None, \"the intent stage makes no tool calls, so there is no transcript\"\n    assert result.cost_complete is not None\n\n\ndef test_stage_intent_grades_a_wrong_classification_as_a_failure():\n    case = CASES[\"answer/VC-POC-01\"]\n    wrong = StructuredIntent(question_id=\"VC-POC-02\")\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"intent\", intent_model=make_intent_model(wrong)\n        )\n    )\n    assert not result.passed\n    assert result.failed_graders == [\"intent_question_match\"]\n    assert record is None\n\n\ndef test_stage_intent_grades_a_refusal_case_by_the_excluded_classification():\n    \"\"\"`should_refuse` cases have no `expected_question_id` — the isolated\n    check is that the model recognised the topic as excluded.\"\"\"\n    case = CASES[\"refuse/finance\"]\n    intent = StructuredIntent(question_id=\"excluded\", excluded_topic=\"finance\")\n    result, _ = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"intent\", intent_model=make_intent_model(intent)\n        )\n    )\n    assert result.passed, result.detail\n\n    wrong = StructuredIntent(question_id=\"VC-POC-01\")\n    result, _ = asyncio.run(\n        live.run_trial(","numLines":130,"startLine":440,"totalLines":717}}}
