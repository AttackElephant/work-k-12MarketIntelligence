{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019BxY1ybR2q23PvaHAPDrrg","type":"tool_result","content":"1\t\"\"\"Run a golden case through the REAL machinery, with the model scripted.\n2\t\n3\tM3's problem: the agent's judgement needs a live model (that is M4's tier), but\n4\teverything around the judgement — tool wiring, the subprocess emitter, the\n5\t`error_kind` branching, the rendering gate, the envelope assembly, the output\n6\tunion — is deterministic and must be provable offline.\n7\t\n8\tSo the model is replaced by a `FunctionModel` that replays the DECISIONS a\n9\treference solution recorded (search this name, fetch this question with this\n10\trequest, then return this output), and everything else runs for real: the real\n11\ttools, the real `evals/stub_emitter.py` subprocess, the real validators, the\n12\treal assembly. The run is then projected back into a `RunRecord` from what the\n13\tTOOLS recorded as they ran — not from anything the model or the output says\n14\tabout the run — and handed to the same graders (ADR-007, ADR-013).\n15\t\n16\tWhat that proves, and what it does not: it proves the machinery carries a\n17\tcorrect decision through to a correct rendered answer, and that the guardrails\n18\tfire on the transcripts they are supposed to. It proves nothing about whether a\n19\treal model makes those decisions. That gap is M4's, by design.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import Any, Callable\n25\t\n26\tfrom pydantic_ai.messages import ModelMessage, ModelResponse, ToolCallPart\n27\tfrom pydantic_ai.models.function import AgentInfo, FunctionModel\n28\t\n29\tfrom evals.schema import GoldenCase, RunRecord, ToolCall\n30\tfrom harness.agent import ask, build_agent\n31\tfrom harness.evidence import EvidenceClient\n32\tfrom harness.outputs import BudgetExceeded, ClarificationNeeded, RenderedAnswer, Unsupported\n33\tfrom harness.tools import Deps\n34\t\n35\tOUTPUT_TOOL = {\n36\t    \"RenderedAnswer\": \"final_result_AnswerDraft\",\n37\t    \"ClarificationNeeded\": \"final_result_ClarificationNeeded\",\n38\t    \"Unsupported\": \"final_result_Unsupported\",\n39\t}\n40\t\n41\t\n42\tdef draft_args(record: RunRecord) -> dict[str, Any]:\n43\t    \"\"\"The payload the MODEL would have produced, stripped of everything the\n44\t    harness attaches itself. A reference record carries the whole rendered\n45\t    answer; the model only ever authors these three fields (ADR-013).\"\"\"\n46\t    out = record.output\n47\t    if record.output_kind == \"RenderedAnswer\":\n48\t        return {\n49\t            \"question_id\": out[\"question_id\"],\n50\t            \"answer\": out[\"answer\"],\n51\t            \"data_status_note\": out.get(\"data_status_note\", \"\"),\n52\t        }\n53\t    if record.output_kind == \"ClarificationNeeded\":\n54\t        return {\n55\t            \"question_id\": out[\"question_id\"],\n56\t            \"missing\": out[\"missing\"],\n57\t            \"prompt_to_user\": out[\"prompt_to_user\"],\n58\t        }\n59\t    return {\n60\t        \"reason_kind\": out[\"reason_kind\"],\n61\t        \"reason\": out[\"reason\"],\n62\t        \"nearest_supported\": out.get(\"nearest_supported\"),\n63\t    }\n64\t\n65\t\n66\tdef scripted_model(record: RunRecord) -> FunctionModel:\n67\t    \"\"\"A model that makes the reference run's calls, in order, then answers.\n68\t\n69\t    Steps are indexed by how many responses the model has already produced, so a\n70\t    `ModelRetry` — which adds a request but no response — replays the same step\n71\t    rather than silently skipping ahead. A guardrail test that wants retry\n72\t    behaviour scripts its own model instead.\n73\t    \"\"\"\n74\t    steps: list[Callable[[], ModelResponse]] = []\n75\t    for call in record.tool_calls:\n76\t        args = dict(call.arguments)\n77\t        steps.append(lambda a=args, n=call.tool: ModelResponse(parts=[ToolCallPart(n, a)]))\n78\t    final_tool = OUTPUT_TOOL[record.output_kind]\n79\t    final_args = draft_args(record)\n80\t    steps.append(\n81\t        lambda: ModelResponse(parts=[ToolCallPart(final_tool, final_args)])\n82\t    )\n83\t\n84\t    def script(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:\n85\t        produced = sum(1 for m in messages if isinstance(m, ModelResponse))\n86\t        return steps[min(produced, len(steps) - 1)]()\n87\t\n88\t    return FunctionModel(script)\n89\t\n90\t\n91\tdef project(case: GoldenCase, deps: Deps, output: Any) -> RunRecord:\n92\t    \"\"\"Build the transcript from what the TOOLS recorded, not from the model.\n93\t\n94\t    `deps.tool_calls` is written by the tool wrappers as they run, so it holds\n95\t    the arguments each tool was actually given and the raw value it actually\n96\t    returned — and unlike the model message history it survives a run that\n97\t    aborts on a refusal short-circuit or a budget trip, which are exactly the\n98\t    branches most worth grading.\n99\t    \"\"\"\n100\t    calls = [\n101\t        ToolCall(\n102\t            tool=call.tool,\n103\t            arguments=call.arguments,\n104\t            result=call.result,\n105\t            error_kind=call.error_kind,\n106\t        )\n107\t        for call in deps.tool_calls\n108\t    ]\n109\t\n110\t    if isinstance(output, RenderedAnswer):\n111\t        kind, payload = \"RenderedAnswer\", output.model_dump()\n112\t    elif isinstance(output, ClarificationNeeded):\n113\t        kind, payload = \"ClarificationNeeded\", output.model_dump()\n114\t    elif isinstance(output, Unsupported):\n115\t        kind, payload = \"Unsupported\", output.model_dump()\n116\t    elif isinstance(output, BudgetExceeded):\n117\t        kind, payload = \"BudgetExceeded\", output.model_dump()\n118\t    else:  # pragma: no cover - the union is closed\n119\t        raise TypeError(f\"unexpected output type {type(output)!r}\")\n120\t\n121\t    return RunRecord(\n122\t        case_id=case.case_id,\n123\t        phrasing=case.phrasings[0],\n124\t        tool_calls=calls,\n125\t        output_kind=kind,  # type: ignore[arg-type]\n126\t        output=payload,\n127\t    )\n128\t\n129\t\n130\tasync def replay(\n131\t    case: GoldenCase, record: RunRecord, client: EvidenceClient\n132\t) -> RunRecord:\n133\t    \"\"\"Run one case end to end through the production path and return the\n134\t    transcript, ready to hand to the graders.\"\"\"\n135\t    agent = build_agent(model=scripted_model(record))\n136\t    deps = Deps(client=client)\n137\t    # No usage record: a scripted `FunctionModel` spends nothing, and writing its\n138\t    # zero-cost \"usage\" into the same JSONL the live tier reads would put runs\n139\t    # that never happened into the cost reports (ADR-005).\n140\t    output = await ask(agent, deps, case.phrasings[0], record_usage=False)\n141\t    return project(case, deps, output)\n142\t"}]},"parent_tool_use_id":null,"session_id":"6a5a4bf9-713c-4453-8836-6a3d15f3b2d0","uuid":"f08d259c-a313-40b6-89a7-a8dc572d06ac","timestamp":"2026-09-25T22:56:43.284Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/evals/replay.py","content":"\"\"\"Run a golden case through the REAL machinery, with the model scripted.\n\nM3's problem: the agent's judgement needs a live model (that is M4's tier), but\neverything around the judgement — tool wiring, the subprocess emitter, the\n`error_kind` branching, the rendering gate, the envelope assembly, the output\nunion — is deterministic and must be provable offline.\n\nSo the model is replaced by a `FunctionModel` that replays the DECISIONS a\nreference solution recorded (search this name, fetch this question with this\nrequest, then return this output), and everything else runs for real: the real\ntools, the real `evals/stub_emitter.py` subprocess, the real validators, the\nreal assembly. The run is then projected back into a `RunRecord` from what the\nTOOLS recorded as they ran — not from anything the model or the output says\nabout the run — and handed to the same graders (ADR-007, ADR-013).\n\nWhat that proves, and what it does not: it proves the machinery carries a\ncorrect decision through to a correct rendered answer, and that the guardrails\nfire on the transcripts they are supposed to. It proves nothing about whether a\nreal model makes those decisions. That gap is M4's, by design.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any, Callable\n\nfrom pydantic_ai.messages import ModelMessage, ModelResponse, ToolCallPart\nfrom pydantic_ai.models.function import AgentInfo, FunctionModel\n\nfrom evals.schema import GoldenCase, RunRecord, ToolCall\nfrom harness.agent import ask, build_agent\nfrom harness.evidence import EvidenceClient\nfrom harness.outputs import BudgetExceeded, ClarificationNeeded, RenderedAnswer, Unsupported\nfrom harness.tools import Deps\n\nOUTPUT_TOOL = {\n    \"RenderedAnswer\": \"final_result_AnswerDraft\",\n    \"ClarificationNeeded\": \"final_result_ClarificationNeeded\",\n    \"Unsupported\": \"final_result_Unsupported\",\n}\n\n\ndef draft_args(record: RunRecord) -> dict[str, Any]:\n    \"\"\"The payload the MODEL would have produced, stripped of everything the\n    harness attaches itself. A reference record carries the whole rendered\n    answer; the model only ever authors these three fields (ADR-013).\"\"\"\n    out = record.output\n    if record.output_kind == \"RenderedAnswer\":\n        return {\n            \"question_id\": out[\"question_id\"],\n            \"answer\": out[\"answer\"],\n            \"data_status_note\": out.get(\"data_status_note\", \"\"),\n        }\n    if record.output_kind == \"ClarificationNeeded\":\n        return {\n            \"question_id\": out[\"question_id\"],\n            \"missing\": out[\"missing\"],\n            \"prompt_to_user\": out[\"prompt_to_user\"],\n        }\n    return {\n        \"reason_kind\": out[\"reason_kind\"],\n        \"reason\": out[\"reason\"],\n        \"nearest_supported\": out.get(\"nearest_supported\"),\n    }\n\n\ndef scripted_model(record: RunRecord) -> FunctionModel:\n    \"\"\"A model that makes the reference run's calls, in order, then answers.\n\n    Steps are indexed by how many responses the model has already produced, so a\n    `ModelRetry` — which adds a request but no response — replays the same step\n    rather than silently skipping ahead. A guardrail test that wants retry\n    behaviour scripts its own model instead.\n    \"\"\"\n    steps: list[Callable[[], ModelResponse]] = []\n    for call in record.tool_calls:\n        args = dict(call.arguments)\n        steps.append(lambda a=args, n=call.tool: ModelResponse(parts=[ToolCallPart(n, a)]))\n    final_tool = OUTPUT_TOOL[record.output_kind]\n    final_args = draft_args(record)\n    steps.append(\n        lambda: ModelResponse(parts=[ToolCallPart(final_tool, final_args)])\n    )\n\n    def script(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:\n        produced = sum(1 for m in messages if isinstance(m, ModelResponse))\n        return steps[min(produced, len(steps) - 1)]()\n\n    return FunctionModel(script)\n\n\ndef project(case: GoldenCase, deps: Deps, output: Any) -> RunRecord:\n    \"\"\"Build the transcript from what the TOOLS recorded, not from the model.\n\n    `deps.tool_calls` is written by the tool wrappers as they run, so it holds\n    the arguments each tool was actually given and the raw value it actually\n    returned — and unlike the model message history it survives a run that\n    aborts on a refusal short-circuit or a budget trip, which are exactly the\n    branches most worth grading.\n    \"\"\"\n    calls = [\n        ToolCall(\n            tool=call.tool,\n            arguments=call.arguments,\n            result=call.result,\n            error_kind=call.error_kind,\n        )\n        for call in deps.tool_calls\n    ]\n\n    if isinstance(output, RenderedAnswer):\n        kind, payload = \"RenderedAnswer\", output.model_dump()\n    elif isinstance(output, ClarificationNeeded):\n        kind, payload = \"ClarificationNeeded\", output.model_dump()\n    elif isinstance(output, Unsupported):\n        kind, payload = \"Unsupported\", output.model_dump()\n    elif isinstance(output, BudgetExceeded):\n        kind, payload = \"BudgetExceeded\", output.model_dump()\n    else:  # pragma: no cover - the union is closed\n        raise TypeError(f\"unexpected output type {type(output)!r}\")\n\n    return RunRecord(\n        case_id=case.case_id,\n        phrasing=case.phrasings[0],\n        tool_calls=calls,\n        output_kind=kind,  # type: ignore[arg-type]\n        output=payload,\n    )\n\n\nasync def replay(\n    case: GoldenCase, record: RunRecord, client: EvidenceClient\n) -> RunRecord:\n    \"\"\"Run one case end to end through the production path and return the\n    transcript, ready to hand to the graders.\"\"\"\n    agent = build_agent(model=scripted_model(record))\n    deps = Deps(client=client)\n    # No usage record: a scripted `FunctionModel` spends nothing, and writing its\n    # zero-cost \"usage\" into the same JSONL the live tier reads would put runs\n    # that never happened into the cost reports (ADR-005).\n    output = await ask(agent, deps, case.phrasings[0], record_usage=False)\n    return project(case, deps, output)\n","numLines":142,"startLine":1,"totalLines":142}}}
