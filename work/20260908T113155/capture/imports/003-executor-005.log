{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PSqvFaLTHVqTQAPZWtrQ4u","type":"tool_result","content":"1\t\"\"\"Stage 2 of the 4-stage pipeline: deterministic planning and execution.\n2\t\n3\t`plan_and_execute()` takes a StructuredIntent and returns either:\n4\t- a dict (the evidence envelope) — the happy path\n5\t- ClarificationNeeded — an input the caller must supply or correct\n6\t- Unsupported — an exclusion or an unknown question\n7\t\n8\tNo model calls. Every branch is a pure function of the intent, the pinned\n9\tcontract artefacts, and the evidence client's responses.\n10\t\n11\tWhat Stage 2 now guarantees (work item 20260908T113118):\n12\t\n13\t- Required, material, and applicable conditional-material inputs are derived\n14\t  from the pinned question policy and the assembled request. The intent\n15\t  model's `missing_material_inputs` claim is never trusted.\n16\t- Named schools resolve through the pinned directory and must match exactly\n17\t  one record each. IDs are staged in mention order, deduplicated without\n18\t  reordering, and committed to `Deps` only after every mention resolves; a\n19\t  zero or ambiguous match clarifies with no evidence call and no partial\n20\t  identity mutation. Caller-supplied numeric IDs bypass the preflight (the\n21\t  bounded resolution of the pinned Definition-Pack conflict) and any conflict\n22\t  with name-resolved identities fails closed before dispatch.\n23\t- Selector labels are Unicode-case-folded and separator-normalized, matched\n24\t  against pinned static vocabularies (registry `metric_list` where declared;\n25\t  otherwise the input-catalog schema's field mapping and embedded enums), and\n26\t  routed to the question's own request field: `metrics` for VC-POC-01/04/11,\n27\t  `ratios` for VC-POC-03, `grades` for VC-POC-02/07. Unsupplied selectors are\n28\t  omitted — the emitter keeps default ownership (no invented defaults).\n29\t- Every request is validated against its registered pinned per-question\n30\t  schema before dispatch. A planner-produced request that cannot satisfy its\n31\t  schema raises TerminalError — planner defects are never dressed up as\n32\t  Unsupported user outcomes.\n33\t- Error origins are separated: a bad_request against a request containing only\n34\t  caller-supplied numeric school identity is an identity clarification; any\n35\t  other bad_request after deterministic validation is planner/contract drift\n36\t  and raises TerminalError. excluded/unknown/unanswerable keep their typed\n37\t  abstentions; data_unavailable/internal remain operational stops.\n38\t\"\"\"\n39\t\n40\tfrom __future__ import annotations\n41\t\n42\timport json\n43\timport logging\n44\timport math\n45\timport re\n46\tfrom copy import deepcopy\n47\tfrom functools import lru_cache\n48\tfrom pathlib import Path\n49\tfrom typing import Any\n50\t\n51\tfrom jsonschema import Draft202012Validator\n52\tfrom jsonschema.exceptions import SchemaError\n53\tfrom referencing import Registry, Resource\n54\tfrom referencing.exceptions import CannotDetermineSpecification, Unresolvable\n55\t\n56\tfrom harness import contract\n57\tfrom harness.errors import TerminalError\n58\tfrom harness.evidence import EvidenceClient, EvidenceError\n59\tfrom harness.intent import StructuredIntent\n60\tfrom harness.outputs import ClarificationNeeded, MissingInput, Unsupported\n61\tfrom harness.tools import Deps, ToolInvocation, request_scope_problem\n62\t\n63\tlogger = logging.getLogger(\"harness.planner\")\n64\t\n65\t# Pinned contract artefacts. Static vocabularies and per-question schemas are\n66\t# read from the vendored, hash-pinned directory `harness.contract` reads —\n67\t# never from the runtime emitter.\n68\t_SCHEMA_DIR = contract.CONTRACT_DIR / \"question_schemas\" / \"v0.3.0\"\n69\t\n70\t# Keyword hints the intent model may use for excluded topics, mapped to a search\n71\t# term that appears in the corresponding contract exclusion text. The mapping is\n72\t# fuzzy: the planner searches for any exclusion text that contains the keyword.\n73\t_EXCLUSION_KEYWORD_MAP: dict[str, str] = {\n74\t    \"finance\": \"fees\",\n75\t    \"fees\": \"fees\",\n76\t    \"cricos\": \"CRICOS\",\n77\t    \"operations\": \"capacity\",\n78\t    \"capacity\": \"capacity\",\n79\t    \"transport\": \"public transport\",\n80\t    \"crosswalk\": \"School_No\",\n81\t    \"sa1\": \"SA1 fact\",\n82\t    \"mesh_block\": \"Mesh Block\",\n83\t    \"sa2\": \"SA2\",\n84\t    \"gtfs\": \"GTFS\",\n85\t}\n86\t\n87\t# The one pinned semantic alias (prompts/rules.md): for school-profile\n88\t# requests \"teaching staff\" means teaching_fte. Keyed by the normalized label,\n89\t# so \"Teaching Staff\" and \"teaching-staff\" match the same alias.\n90\t_PINNED_SELECTOR_ALIASES: dict[str, str] = {\"teaching staff\": \"teaching_fte\"}\n91\t\n92\t_SCHOOL_FIELDS = (\"acara_sml_id\", \"acara_sml_ids\")\n93\t\n94\t# Label-selector request fields the requested label bag can be routed into.\n95\t_SELECTOR_BAG_FIELDS = (\"metrics\", \"ratios\", \"grades\")\n96\t\n97\t# The only conditional-material declaration currently authorized by the pinned\n98\t# contract. It belongs only to these questions; other operators, punctuation or\n99\t# question IDs are drift, not prose for the planner to interpret.\n100\t_DISTANCE_CONDITION = \"market_definition equals distance\"\n101\t_DISTANCE_CONDITION_QUESTIONS = frozenset(\n102\t    {\"VC-POC-05\", \"VC-POC-06\", \"VC-POC-07\"}\n103\t)\n104\t\n105\t_SEPARATOR_RE = re.compile(r\"[\\W_]+\", re.UNICODE)\n106\t\n107\t\n108\tdef _find_exclusion_text(excluded_topic: str | None) -> str:\n109\t    \"\"\"Find the contract exclusion text matching a topic hint.\n110\t\n111\t    Searches the exclusion texts for a case-insensitive substring match on the\n112\t    mapped keyword, then on the raw hint. Falls back to the first text in sorted\n113\t    order so there is always a contract-text reason (never harness prose).\n114\t    \"\"\"\n115\t    texts = sorted(contract.exclusion_texts())\n116\t    if not texts:\n117\t        return \"\"\n118\t\n119\t    if excluded_topic:\n120\t        # Try the mapped keyword first, then the raw hint\n121\t        search_terms = []\n122\t        hint_lower = excluded_topic.lower()\n123\t        for key, mapped in _EXCLUSION_KEYWORD_MAP.items():\n124\t            if key in hint_lower:\n125\t                search_terms.append(mapped.lower())\n126\t        search_terms.append(hint_lower)\n127\t\n128\t        for term in search_terms:\n129\t            for text in texts:\n130\t                if term in text.lower():\n131\t                    return text\n132\t\n133\t    # Fallback: first exclusion text alphabetically\n134\t    return texts[0]\n135\t\n136\t\n137\t# --------------------------------------------------------------------------- #\n138\t# Pinned artefact loading (fail-closed: load failures are TerminalError)\n139\t# --------------------------------------------------------------------------- #\n140\t\n141\t\n142\tdef _load_pinned_json(path: Path) -> Any:\n143\t    try:\n144\t        return json.loads(path.read_text(encoding=\"utf-8\"))\n145\t    except (OSError, ValueError) as exc:\n146\t        raise TerminalError(\n147\t            f\"pinned contract artefact could not be loaded ({path.name}): {exc}\"\n148\t        ) from exc\n149\t\n150\t\n151\t@lru_cache(maxsize=1)\n152\tdef _schema_index() -> dict[str, Any]:\n153\t    index = _load_pinned_json(_SCHEMA_DIR / \"_index.json\")\n154\t    if not isinstance(index, dict) or not isinstance(index.get(\"questions\"), dict):\n155\t        raise TerminalError(\"pinned question-schema index is malformed\")\n156\t    return index\n157\t\n158\t\n159\t@lru_cache(maxsize=1)\n160\tdef _input_catalog_schema() -> dict[str, Any]:\n161\t    schema = _load_pinned_json(contract.CONTRACT_DIR / \"poc_input_catalog.v0.3.0.schema.json\")\n162\t    if not isinstance(schema, dict):\n163\t        raise TerminalError(\"pinned input-catalog schema is malformed\")\n164\t    return schema\n165\t\n166\t\n167\tdef _registered_request_schema_path(question_id: str) -> Path:\n168\t    \"\"\"Resolve the question's registered request-schema path.\n169\t\n170\t    Only paths registered in the pinned index, beneath the pinned contract\n171\t    directory, may be loaded — anything else is contract drift.\n172\t    \"\"\"\n173\t    entry = _schema_index()[\"questions\"].get(question_id)\n174\t    if not isinstance(entry, dict):\n175\t        raise TerminalError(f\"{question_id} has no registered request schema\")\n176\t    filename = entry.get(\"request_schema\")\n177\t    if not isinstance(filename, str) or filename != f\"{question_id}.request.schema.json\":\n178\t        raise TerminalError(\n179\t            f\"{question_id} request-schema registration is inconsistent: {filename!r}\"\n180\t        )\n181\t    path = (_SCHEMA_DIR / filename).resolve()\n182\t    pinned = contract.CONTRACT_DIR.resolve()\n183\t    if pinned not in path.parents:\n184\t        raise TerminalError(\n185\t            \"refusing to load a request schema from outside the pinned contract \"\n186\t            f\"directory: {filename}\"\n187\t        )\n188\t    return path\n189\t\n190\t\n191\t@lru_cache(maxsize=None)\n192\tdef _request_schema(question_id: str) -> dict[str, Any]:\n193\t    schema = _load_pinned_json(_registered_request_schema_path(question_id))\n194\t    if not isinstance(schema, dict):\n195\t        raise TerminalError(f\"{question_id} request schema is malformed\")\n196\t    return schema\n197\t\n198\t\n199\t# --------------------------------------------------------------------------- #\n200\t# Static vocabularies (registry metric_list; catalog field mapping + enums)\n201\t# --------------------------------------------------------------------------- #\n202\t\n203\t\n204\t@lru_cache(maxsize=1)\n205\tdef _field_to_catalog_list() -> dict[str, str]:\n206\t    mapping = _input_catalog_schema().get(\"x-poc-request-field-to-catalog-list\")\n207\t    if not isinstance(mapping, dict):\n208\t        return {}\n209\t    return {\n210\t        str(field): str(list_name)\n211\t        for field, list_name in mapping.items()\n212\t        if isinstance(field, str) and isinstance(list_name, str)\n213\t    }\n214\t\n215\t\n216\tdef _static_enum(list_name: str) -> list[str] | None:\n217\t    \"\"\"The embedded static enum for a catalog list, or None when the list is\n218\t    release-derived (shape-checked only, never enum-enforced — OD-03).\"\"\"\n219\t    if list_name.startswith(\"release_derived_values.\"):\n220\t        return None\n221\t    prop = _input_catalog_schema().get(\"properties\", {}).get(list_name)\n222\t    if isinstance(prop, dict) and isinstance(prop.get(\"items\"), dict):\n223\t        enum = prop[\"items\"].get(\"enum\")\n224\t        if isinstance(enum, list):\n225\t            return [str(value) for value in enum]\n226\t    return None\n227\t\n228\t\n229\tdef _static_vocabulary_for_field(question_id: str, field: str) -> list[str] | None:\n230\t    list_name = _field_to_catalog_list().get(f\"{question_id}.{field}\")\n231\t    if list_name is None:\n232\t        return None\n233\t    return _static_enum(list_name)\n234\t\n235\t\n236\tdef _selector_route(question_id: str) -> tuple[str, list[str]] | None:\n237\t    \"\"\"(request field, static vocabulary) for the question's label-selector bag.\n238\t\n239\t    The registry's `metric_list` is authoritative where declared (VC-POC-01/04\n240\t    → profile_metrics, VC-POC-11 → student_context_metrics); otherwise the\n241\t    input-catalog schema's field mapping routes e.g. VC-POC-03 to `ratios` and\n242\t    VC-POC-02/07 to `grades`.\n243\t    \"\"\"\n244\t    entry = contract.questions().get(question_id) or {}\n245\t    metric_list = entry.get(\"metric_list\")\n246\t    if metric_list:\n247\t        values = contract.registry().get(\"metric_lists\", {}).get(metric_list)\n248\t        if not isinstance(values, list) or not values:\n249\t            raise TerminalError(\n250\t                f\"{question_id} declares metric_list {metric_list!r} with no pinned values\"\n251\t            )\n252\t        return \"metrics\", [str(value) for value in values]\n253\t    field_to_list = _field_to_catalog_list()\n254\t    for key in sorted(field_to_list):\n255\t        prefix = f\"{question_id}.\"\n256\t        if not key.startswith(prefix):\n257\t            continue\n258\t        field = key[len(prefix):]\n259\t        if field in _SELECTOR_BAG_FIELDS:\n260\t            vocabulary = _static_enum(field_to_list[key])\n261\t            if vocabulary is None:\n262\t                raise TerminalError(\n263\t                    f\"{question_id}.{field} routes to a non-static vocabulary\"\n264\t                )\n265\t            return field, vocabulary\n266\t    return None\n267\t\n268\t\n269\t# --------------------------------------------------------------------------- #\n270\t# Label normalization\n271\t# --------------------------------------------------------------------------- #\n272\t\n273\t\n274\tdef _normalize_label(label: Any) -> str:\n275\t    \"\"\"Unicode-safe case folding plus separator normalization.\n276\t\n277\t    `total_enrolments`, `Total Enrolments` and `total-enrolments` all fold to\n278\t    `total enrolments`; Unicode letters survive the fold.\n279\t    \"\"\"\n280\t    folded = _SEPARATOR_RE.sub(\" \", str(label).casefold())\n281\t    return folded.strip()\n282\t\n283\t\n284\tdef _canonical_for(label: Any, vocabulary: list[str]) -> str | None:\n285\t    \"\"\"Match a label against a pinned static vocabulary.\n286\t\n287\t    Direct normalized matches win; beyond that only the pinned semantic\n288\t    aliases apply. Canonical values are returned unchanged.\n289\t    \"\"\"\n290\t    wanted = _normalize_label(label)\n291\t    for value in vocabulary:\n292\t        if _normalize_label(value) == wanted:\n293\t            return value\n294\t    alias = _PINNED_SELECTOR_ALIASES.get(wanted)\n295\t    if alias is not None and alias in vocabulary:\n296\t        return alias\n297\t    return None\n298\t\n299\t\n300\tdef _dedupe(values: list[Any]) -> list[Any]:\n301\t    \"\"\"Order-preserving deduplication.\"\"\"\n302\t    seen: set[Any] = set()\n303\t    unique: list[Any] = []\n304\t    for value in values:\n305\t        if value not in seen:\n306\t            seen.add(value)\n307\t            unique.append(value)\n308\t    return unique\n309\t\n310\t\n311\t# --------------------------------------------------------------------------- #\n312\t# Pinned-schema validation (complete draft 2020-12, local references only)\n313\t# --------------------------------------------------------------------------- #\n314\t\n315\t\n316\t@lru_cache(maxsize=1)\n317\tdef _request_validators() -> dict[str, Draft202012Validator]:\n318\t    \"\"\"Build validators from only the locally pinned, registered schemas.\n319\t\n320\t    The registry has no retrieval callback: an unregistered or external\n321\t    reference therefore fails closed instead of fetching a schema at runtime.\n322\t    \"\"\"\n323\t    schemas: dict[str, dict[str, Any]] = {}\n324\t    resources: list[tuple[str, Resource[Any]]] = []\n325\t    try:\n326\t        for question_id in _schema_index()[\"questions\"]:\n327\t            schema = _request_schema(question_id)\n328\t            Draft202012Validator.check_schema(schema)\n329\t            schema_id = schema.get(\"$id\")\n330\t            if not isinstance(schema_id, str) or not schema_id:\n331\t                raise TerminalError(f\"{question_id} request schema has no valid $id\")\n332\t            schemas[question_id] = schema\n333\t            resources.append((schema_id, Resource.from_contents(schema)))\n334\t        registry = Registry().with_resources(resources)\n335\t        return {\n336\t            question_id: Draft202012Validator(\n337\t                schema,\n338\t                registry=registry,\n339\t                format_checker=Draft202012Validator.FORMAT_CHECKER,\n340\t            )\n341\t            for question_id, schema in schemas.items()\n342\t        }\n343\t    except TerminalError:\n344\t        raise\n345\t    except (CannotDetermineSpecification, SchemaError, Unresolvable, ValueError) as exc:\n346\t        raise TerminalError(f\"pinned request schemas could not be resolved: {exc}\") from exc\n347\t\n348\t\n349\tdef _instance_path(parts: Any) -> str:\n350\t    path = \"$request\"\n351\t    for part in parts:\n352\t        path += f\"[{part}]\" if isinstance(part, int) else f\".{part}\"\n353\t    return path\n354\t\n355\t\n356\tdef _schema_error_message(error: Any) -> str:\n357\t    path = _instance_path(error.absolute_path)\n358\t    if error.validator == \"additionalProperties\" and isinstance(error.instance, dict):\n359\t        properties = error.schema.get(\"properties\", {})\n360\t        known = set(properties) if isinstance(properties, dict) else set()\n361\t        unknown = sorted(key for key in error.instance if key not in known)\n362\t        return f\"{path}: unknown properties {unknown}\"\n363\t    return f\"{path}: {error.message}\"\n364\t\n365\t\n366\tdef _non_finite_paths(value: Any, path: str = \"$request\") -> list[str]:\n367\t    \"\"\"Reject Python-only NaN/infinities, which are not JSON numbers.\"\"\"\n368\t    if isinstance(value, float) and not math.isfinite(value):\n369\t        return [path]\n370\t    if isinstance(value, dict):\n371\t        return [\n372\t            problem\n373\t            for key, child in value.items()\n374\t            for problem in _non_finite_paths(child, f\"{path}.{key}\")\n375\t        ]\n376\t    if isinstance(value, list):\n377\t        return [\n378\t            problem\n379\t            for index, child in enumerate(value)\n380\t            for problem in _non_finite_paths(child, f\"{path}[{index}]\")\n381\t        ]\n382\t    return []\n383\t\n384\t\n385\tdef _validate_request(question_id: str, request: dict[str, Any]) -> None:\n386\t    \"\"\"Validate the planner-built request against its registered pinned schema.\n387\t\n388\t    Any failure — including schema load or resolution failure — is a\n389\t    TerminalError before dispatch, never an Unsupported user outcome.\n390\t    \"\"\"\n391\t    validator = _request_validators().get(question_id)\n392\t    if validator is None:\n393\t        raise TerminalError(f\"{question_id} has no registered request validator\")\n394\t    problems = [f\"{path}: value must be finite\" for path in _non_finite_paths(request)]\n395\t    try:\n396\t        errors = sorted(\n397\t            validator.iter_errors(request),\n398\t            key=lambda error: tuple(str(part) for part in error.absolute_path),\n399\t        )\n400\t    except Unresolvable as exc:\n401\t        raise TerminalError(\n402\t            f\"{question_id}: registered request schema reference could not be resolved: {exc}\"\n403\t        ) from exc\n404\t    problems.extend(_schema_error_message(error) for error in errors)\n405\t    if problems:\n406\t        raise TerminalError(\n407\t            f\"{question_id}: the planner-built request does not satisfy its \"\n408\t            f\"registered request schema: \" + \"; \".join(problems)\n409\t        )\n410\t\n411\t\n412\t# --------------------------------------------------------------------------- #\n413\t# School identity resolution (transactional, exactly-one-match)\n414\t# --------------------------------------------------------------------------- #\n415\t\n416\t\n417\tasync def _resolve_mentions(\n418\t    question_id: str,\n419\t    mentions: list[str],\n420\t    client: EvidenceClient,\n421\t    deps: Deps,\n422\t) -> tuple[list[int], ClarificationNeeded | None]:\n423\t    \"\"\"Resolve each mention through the pinned directory, exactly one match each.\n424\t\n425\t    Every preflight is recorded, including failures. IDs are staged locally in\n426\t    mention order and deduplicated without reordering; nothing is committed\n427\t    here — the caller commits to `Deps` only after every mention resolves.\n428\t    \"\"\"\n429\t    staged: list[int] = []\n430\t    for mention in mentions:\n431\t        arguments = {\"search\": mention, \"limit\": 25}\n432\t        try:\n433\t            records = await client.school_directory(search=mention, limit=25)\n434\t        except Exception as exc:\n435\t            deps.tool_calls.append(\n436\t                ToolInvocation(\"search_schools\", arguments, error_kind=type(exc).__name__)\n437\t            )\n438\t            raise\n439\t        deps.tool_calls.append(ToolInvocation(\"search_schools\", arguments, records))\n440\t        if not records:\n441\t            return [], _school_match_clarification(\n442\t                question_id,\n443\t                mention,\n444\t                f\"'{mention}' matched no school in the pinned directory.\",\n445\t                \"I couldn't find that school. Could you check the name — or give me \"\n446\t                \"the school's public ACARA ID?\",\n447\t            )\n448\t        if len(records) > 1:\n449\t            return [], _school_match_clarification(\n450\t                question_id,\n451\t                mention,\n452\t                f\"'{mention}' matched {len(records)} schools; a request needs exactly one.\",\n453\t                f\"More than one school matches '{mention}'. Which one did you mean?\",\n454\t            )\n455\t        record = records[0]\n456\t        school_id = record.get(\"acara_sml_id\") if isinstance(record, dict) else None\n457\t        if (\n458\t            not isinstance(school_id, int)\n459\t            or isinstance(school_id, bool)\n460\t            or school_id <= 0\n461\t        ):\n462\t            raise TerminalError(\n463\t                f\"{question_id}: malformed school-directory record for {mention!r}; \"\n464\t                \"exactly one positive integer acara_sml_id is required\"\n465\t            )\n466\t        if school_id not in staged:\n467\t            staged.append(school_id)\n468\t    return staged, None\n469\t\n470\t\n471\tdef _school_match_clarification(\n472\t    question_id: str, mention: str, why_material: str, prompt_to_user: str\n473\t) -> ClarificationNeeded:\n474\t    return ClarificationNeeded(\n475\t        question_id=question_id,\n476\t        missing=[\n477\t            MissingInput(input=\"acara_sml_id\", why_material=why_material, allowed_values=[])\n478\t        ],\n479\t        prompt_to_user=prompt_to_user,\n480\t    )\n481\t\n482\t\n483\tdef _adapt_explicit_school_fields(request: dict[str, Any], school_required: list[str]) -> None:\n484\t    \"\"\"Let a caller-supplied identity in either school field satisfy the\n485\t    question's own selector field, without inventing values.\"\"\"\n486\t    if not school_required:\n487\t        return\n488\t    if \"acara_sml_ids\" in school_required:\n489\t        if \"acara_sml_ids\" not in request and isinstance(request.get(\"acara_sml_id\"), int):\n490\t            request[\"acara_sml_ids\"] = [request.pop(\"acara_sml_id\")]\n491\t    elif \"acara_sml_id\" in school_required:\n492\t        if \"acara_sml_id\" not in request and isinstance(request.get(\"acara_sml_ids\"), list):\n493\t            ids = request[\"acara_sml_ids\"]\n494\t            if len(ids) == 1 and isinstance(ids[0], int) and not isinstance(ids[0], bool):\n495\t                request[\"acara_sml_id\"] = ids[0]\n496\t                del request[\"acara_sml_ids\"]\n497\t            else:\n498\t                raise TerminalError(\n499\t                    \"caller supplied multiple acara_sml_ids for a question whose schema \"\n500\t                    \"takes a single acara_sml_id\"\n501\t                )\n502\t\n503\t\n504\tdef _attach_school_ids(\n505\t    request: dict[str, Any], school_required: list[str], ids: list[int]\n506\t) -> None:\n507\t    if not ids:\n508\t        return\n509\t    if \"acara_sml_ids\" in school_required:\n510\t        request.setdefault(\"acara_sml_ids\", list(ids))\n511\t    elif \"acara_sml_id\" in school_required:\n512\t        request.setdefault(\"acara_sml_id\", ids[0])\n513\t\n514\t\n515\tdef _explicit_id_values(request: dict[str, Any], school_required: list[str]) -> list[int]:\n516\t    if \"acara_sml_ids\" in school_required:\n517\t        value = request.get(\"acara_sml_ids\")\n518\t        if isinstance(value, list):\n519\t            return [v for v in value if isinstance(v, int) and not isinstance(v, bool)]\n520\t        return []\n521\t    if \"acara_sml_id\" in school_required:\n522\t        value = request.get(\"acara_sml_id\")\n523\t        if isinstance(value, int) and not isinstance(value, bool):\n524\t            return [value]\n525\t    return []\n526\t\n527\t\n528\tdef _requires_two_distinct_ids(entry: dict[str, Any]) -> bool:\n529\t    constraints = entry.get(\"input_policy\", {}).get(\"constraints\", [])\n530\t    return any(\"at least two\" in str(constraint) for constraint in constraints)\n531\t\n532\t\n533\tdef _insufficient_schools_clarification(question_id: str) -> ClarificationNeeded:\n534\t    return ClarificationNeeded(\n535\t        question_id=question_id,\n536\t        missing=[\n537\t            MissingInput(\n538\t                input=\"acara_sml_ids\",\n539\t                why_material=\"This comparison needs at least two distinct schools.\",\n540\t                allowed_values=[],\n541\t            )\n542\t        ],\n543\t        prompt_to_user=\"Which distinct schools should be compared? Name at least two.\",\n544\t    )\n545\t\n546\t\n547\t# --------------------------------------------------------------------------- #\n548\t# Selector normalization and routing\n549\t# --------------------------------------------------------------------------- #\n550\t\n551\t\n552\tdef _selector_clarification(\n553\t    question_id: str, field: str, value: Any, vocabulary: list[str]\n554\t) -> ClarificationNeeded:\n555\t    return ClarificationNeeded(\n556\t        question_id=question_id,\n557\t        missing=[\n558\t            MissingInput(\n559\t                input=field,\n560\t                why_material=f\"'{value}' is not an allowed {field} value for {question_id}.\",\n561\t                allowed_values=vocabulary,\n562\t            )\n563\t        ],\n564\t        prompt_to_user=(\n565\t            f\"Which {field} did you mean? Allowed values: \"\n566\t            + \", \".join(vocabulary)\n567\t            + \".\"\n568\t        ),\n569\t    )\n570\t\n571\t\n572\tdef _request_field_schema(question_id: str, path: list[str]) -> dict[str, Any]:\n573\t    \"\"\"Return the registered schema node for a mapped request-field path.\"\"\"\n574\t\n575\t    node: Any = _request_schema(question_id)\n576\t    for part in path:\n577\t        properties = node.get(\"properties\") if isinstance(node, dict) else None\n578\t        node = properties.get(part) if isinstance(properties, dict) else None\n579\t        if not isinstance(node, dict):\n580\t            raise TerminalError(\n581\t                f\"{question_id}: pinned selector mapping has no request-schema field \"\n582\t                f\"{'.'.join(path)}\"\n583\t            )\n584\t    return node\n585\t\n586\t\n587\tdef _normalize_filter_selectors(\n588\t    question_id: str, request: dict[str, Any]\n589\t) -> ClarificationNeeded | None:\n590\t    \"\"\"Normalize every explicitly supplied selector backed by a static pin.\n591\t\n592\t    Release-derived/open fields retain their values and schema validation owns\n593\t    wrong types and unknown keys. Static scalar, list and nested-list fields are\n594\t    canonicalized with stable-order deduplication; unknown labels clarify.\n595\t    \"\"\"\n596\t    prefix = f\"{question_id}.\"\n597\t    for mapped_field, list_name in _field_to_catalog_list().items():\n598\t        if not mapped_field.startswith(prefix) or \"<keys>\" in mapped_field:\n599\t            continue\n600\t        vocabulary = _static_enum(list_name)\n601\t        if vocabulary is None:\n602\t            continue\n603\t        path = mapped_field[len(prefix):].split(\".\")\n604\t        owner: Any = request\n605\t        for part in path[:-1]:\n606\t            if not isinstance(owner, dict):\n607\t                raise TerminalError(\n608\t                    f\"{question_id}: invalid selector shape for {'.'.join(path)}\"\n609\t                )\n610\t            if part not in owner:\n611\t                owner = None\n612\t                break\n613\t            owner = owner[part]\n614\t        if owner is None:\n615\t            continue\n616\t        if not isinstance(owner, dict):\n617\t            raise TerminalError(\n618\t                f\"{question_id}: invalid selector shape for {'.'.join(path)}\"\n619\t            )\n620\t        if path[-1] not in owner:\n621\t            continue\n622\t        field = \".\".join(path)\n623\t        value = owner[path[-1]]\n624\t        field_schema = _request_field_schema(question_id, path)\n625\t        expected_type = field_schema.get(\"type\")\n626\t        if expected_type == \"string\":\n627\t            if not isinstance(value, str):\n628\t                raise TerminalError(\n629\t                    f\"{question_id}: invalid selector shape for {field}; expected string\"\n630\t                )\n631\t            canonical = _canonical_for(value, vocabulary)\n632\t            if canonical is None:\n633\t                return _selector_clarification(question_id, field, value, vocabulary)\n634\t            owner[path[-1]] = canonical\n635\t        elif expected_type == \"array\":\n636\t            if not isinstance(value, list) or not all(\n637\t                isinstance(item, str) for item in value\n638\t            ):\n639\t                raise TerminalError(\n640\t                    f\"{question_id}: invalid selector shape for {field}; \"\n641\t                    \"expected an array of strings\"\n642\t                )\n643\t            canonical_values: list[str] = []\n644\t            for item in value:\n645\t                canonical = _canonical_for(item, vocabulary)\n646\t                if canonical is None:\n647\t                    return _selector_clarification(question_id, field, item, vocabulary)\n648\t                canonical_values.append(canonical)\n649\t            owner[path[-1]] = _dedupe(canonical_values)\n650\t        else:\n651\t            raise TerminalError(\n652\t                f\"{question_id}: unsupported pinned selector shape for {field}\"\n653\t            )\n654\t    return None\n655\t\n656\t\n657\tdef _route_selectors(\n658\t    question_id: str,\n659\t    intent: StructuredIntent,\n660\t    request: dict[str, Any],\n661\t    deps: Deps,\n662\t) -> ClarificationNeeded | None:\n663\t    \"\"\"Route requested selector labels to the question's own request field.\n664\t\n665\t    Static vocabularies come from pinned artefacts (registry metric_list where\n666\t    declared, otherwise the input-catalog schema's field mapping and embedded\n667\t    enums) — never from the runtime emitter. Selectors the user named none of\n668\t    are omitted so the emitter keeps default ownership.\n669\t    \"\"\"\n670\t    labels = [str(label) for label in (intent.requested_metrics or []) if str(label).strip()]\n671\t    if not labels:\n672\t        return None\n673\t    route = _selector_route(question_id)\n674\t    if route is None:\n675\t        return ClarificationNeeded(\n676\t            question_id=question_id,\n677\t            missing=[\n678\t                MissingInput(\n679\t                    input=\"metrics\",\n680\t                    why_material=(\n681\t                        f\"{question_id} takes no metric selector, so the requested \"\n682\t                        \"labels cannot be applied to this request.\"\n683\t                    ),\n684\t                    allowed_values=[],\n685\t                )\n686\t            ],\n687\t            prompt_to_user=\"This question does not take metric selectors. Should I answer it as asked?\",\n688\t        )\n689\t    field, vocabulary = route\n690\t    canonical: list[str] = []\n691\t    for label in labels:\n692\t        matched = _canonical_for(label, vocabulary)\n693\t        if matched is None:\n694\t            return ClarificationNeeded(\n695\t                question_id=question_id,\n696\t                missing=[\n697\t                    MissingInput(\n698\t                        input=field,\n699\t                        why_material=(\n700\t                            f\"'{label}' is not an allowed {field} value for {question_id}.\"\n701\t                        ),\n702\t                        allowed_values=vocabulary,\n703\t                    )\n704\t                ],\n705\t                prompt_to_user=(\n706\t                    f\"Which {field} did you mean? Allowed values: \"\n707\t                    + \", \".join(vocabulary)\n708\t                    + \".\"\n709\t                ),\n710\t            )\n711\t        canonical.append(matched)\n712\t    canonical = _dedupe(canonical)\n713\t\n714\t    if field == \"metrics\":\n715\t        # Final scope enforcement happens after filter and bag assembly so both\n716\t        # sources receive the same rule.\n717\t        pass\n718\t    request[field] = canonical\n719\t    return None\n720\t\n721\t\n722\tdef _enforce_metric_scope(\n723\t    question_id: str, request: dict[str, Any], deps: Deps\n724\t) -> ClarificationNeeded | None:\n725\t    metrics = request.get(\"metrics\")\n726\t    if question_id not in {\"VC-POC-01\", \"VC-POC-04\"} or not isinstance(metrics, list):\n727\t        return None\n728\t    if not metrics or not all(isinstance(metric, str) for metric in metrics):\n729\t        return None  # the pinned schema owns malformed shapes\n730\t    admissible = [\n731\t        metric\n732\t        for metric in metrics\n733\t        if request_scope_problem(\n734\t            getattr(deps, \"_scope_user_question\", deps.user_question),\n735\t            question_id,\n736\t            {**request, \"metrics\": [metric]},\n737\t        )\n738\t        is None\n739\t    ]\n740\t    if not admissible:\n741\t        vocabulary = _selector_route(question_id)\n742\t        return ClarificationNeeded(\n743\t            question_id=question_id,\n744\t            missing=[\n745\t                MissingInput(\n746\t                    input=\"metrics\",\n747\t                    why_material=(\n748\t                        \"None of the explicitly selected metrics is supported by the \"\n749\t                        \"scope stated in the user's request.\"\n750\t                    ),\n751\t                    allowed_values=vocabulary[1] if vocabulary else [],\n752\t                )\n753\t            ],\n754\t            prompt_to_user=(\n755\t                \"Which profile metric should I use? Headcount and non-teaching \"\n756\t                \"metrics must be requested explicitly.\"\n757\t            ),\n758\t        )\n759\t    request[\"metrics\"] = admissible\n760\t    return None\n761\t\n762\t\n763\t# --------------------------------------------------------------------------- #\n764\t# Registry-owned explicit-filter constraints (VC-POC-09/10, OD-07)\n765\t# --------------------------------------------------------------------------- #\n766\t\n767\t\n768\tdef _enforce_explicit_filter_constraints(\n769\t    question_id: str, entry: dict[str, Any], request: dict[str, Any]\n770\t) -> ClarificationNeeded | None:\n771\t    \"\"\"The registry-owned VC-POC-09/10 rule: a cohort definition must contain\n772\t    at least one explicit filter — the sector default alone does not define a\n773\t    peer group. Enforced exactly as pinned, not generalised into a condition\n774\t    language. Absent fields are left to policy derivation.\"\"\"\n775\t    policy = entry.get(\"input_policy\") or {}\n776\t    required = [f for f in policy.get(\"required\", []) if isinstance(f, str)]\n777\t\n778\t    if \"peer_filters\" in required and isinstance(request.get(\"peer_filters\"), dict):\n779\t        filters = request[\"peer_filters\"]\n780\t        if not filters:\n781\t            return _cohort_definition_clarification(\n782\t                question_id,\n783\t                \"peer_filters\",\n784\t                \"The peer group definition is empty; at least one explicit filter \"\n785\t                \"is required.\",\n786\t            )\n787\t        default_sectors = policy.get(\"defaultable\", {}).get(\"peer_filters.sectors\")\n788\t        if (\n789\t            set(filters) == {\"sectors\"}\n790\t            and isinstance(default_sectors, list)\n791\t            and isinstance(filters.get(\"sectors\"), list)\n792\t            and sorted(str(s) for s in filters[\"sectors\"])\n793\t            == sorted(str(s) for s in default_sectors)\n794\t        ):\n795\t            return _cohort_definition_clarification(\n796\t                question_id,\n797\t                \"peer_filters\",\n798\t                \"The sector default alone does not define a peer group; at least one \"\n799\t                \"explicit filter beyond the sector default is required.\",\n800\t            )\n801\t\n802\t    if \"segment_filters\" in required and isinstance(request.get(\"segment_filters\"), dict):\n803\t        if not request[\"segment_filters\"]:\n804\t            return _cohort_definition_clarification(\n805\t                question_id,\n806\t                \"segment_filters\",\n807\t                \"The segment definition is empty; at least one explicit filter \"\n808\t                \"is required.\",\n809\t            )\n810\t    return None\n811\t\n812\t\n813\tdef _cohort_definition_clarification(\n814\t    question_id: str, field: str, why_material: str\n815\t) -> ClarificationNeeded:\n816\t    return ClarificationNeeded(\n817\t        question_id=question_id,\n818\t        missing=[MissingInput(input=field, why_material=why_material, allowed_values=[])],\n819\t        prompt_to_user=(\n820\t            \"Which rule should define this cohort — for example a sector, school \"\n821\t            \"type, enrolment band, ICSEA range, remoteness or suburb?\"\n822\t        ),\n823\t    )\n824\t\n825\t\n826\t# --------------------------------------------------------------------------- #\n827\t# Derived missing inputs (pinned policy order)\n828\t# --------------------------------------------------------------------------- #\n829\t\n830\t\n831\tdef _derive_missing_inputs(\n832\t    question_id: str, entry: dict[str, Any], request: dict[str, Any]\n833\t) -> list[str]:\n834\t    \"\"\"Missing required, material, then applicable conditional-material fields,\n835\t    in pinned policy order — derived from policy and the assembled request,\n836\t    never taken from the model's missing-input claim.\"\"\"\n837\t    policy = entry.get(\"input_policy\") or {}\n838\t    missing: list[str] = []\n839\t    seen: set[str] = set()\n840\t\n841\t    def consider(field: str) -> None:\n842\t        if field in seen:\n843\t            return\n844\t        seen.add(field)\n845\t        if field not in request:\n846\t            missing.append(field)\n847\t\n848\t    for field in policy.get(\"required\", []):\n849\t        if isinstance(field, str):\n850\t            consider(field)\n851\t    for field in policy.get(\"material\", []):\n852\t        if isinstance(field, str):\n853\t            consider(field)\n854\t\n855\t    conditional = policy.get(\"conditional_material\", {})\n856\t    if not isinstance(conditional, dict):\n857\t        raise TerminalError(\n858\t            f\"{question_id}: conditional-material policy is malformed — contract drift\"\n859\t        )\n860\t    for field, condition in conditional.items():\n861\t        if (\n862\t            question_id not in _DISTANCE_CONDITION_QUESTIONS\n863\t            or field != \"distance_km\"\n864\t            or condition != _DISTANCE_CONDITION\n865\t        ):\n866\t            raise TerminalError(\n867\t                f\"{question_id}: unsupported conditional-material expression \"\n868\t                f\"{condition!r} for {field} — contract drift, refusing to interpret it\"\n869\t            )\n870\t        if request.get(\"market_definition\") == \"distance\" and \"distance_km\" not in request:\n871\t            consider(field)\n872\t    return missing\n873\t\n874\t\n875\t# --------------------------------------------------------------------------- #\n876\t# Stage 2 entry point\n877\t# --------------------------------------------------------------------------- #\n878\t\n879\t\n880\tasync def plan_and_execute(\n881\t    intent: StructuredIntent,\n882\t    client: EvidenceClient,\n883\t    deps: Deps,\n884\t) -> dict[str, Any] | ClarificationNeeded | Unsupported:\n885\t    \"\"\"Deterministic Stage 2: intent → evidence envelope or typed outcome.\n886\t\n887\t    Returns:\n888\t        dict — the evidence envelope (happy path)\n889\t        ClarificationNeeded — a caller-suppliable input is missing or wrong\n890\t        Unsupported — an exclusion or an unknown question\n891\t    May raise:\n892\t        TerminalError — planner/schema defects and operational stops\n893\t    \"\"\"\n894\t    question_id = intent.question_id\n895\t\n896\t    # ------------------------------------------------------------------ #\n897\t    # 1. Excluded topic (intent model classified it as out of scope)\n898\t    # ------------------------------------------------------------------ #\n899\t    if question_id == \"excluded\":\n900\t        exclusion_text = _find_exclusion_text(intent.excluded_topic)\n901\t        logger.debug(\n902\t            \"intent classified as excluded topic\",\n903\t            extra={\"subsystem\": \"planner\", \"excluded_topic\": intent.excluded_topic},\n904\t        )\n905\t        return Unsupported(\n906\t            reason_kind=\"excluded_by_contract\",\n907\t            reason=exclusion_text,\n908\t        )\n909\t\n910\t    # ------------------------------------------------------------------ #\n911\t    # 2. Registry-owned excluded question (e.g. VC-POC-TRANSPORT-01)\n912\t    # ------------------------------------------------------------------ #\n913\t    excluded = contract.excluded_questions().get(question_id)\n914\t    if excluded:\n915\t        reason_code = excluded.get(\"reason_code\")\n916\t        reason_kind = (\n917\t            \"not_yet_validated\"\n918\t            if reason_code == \"not_yet_validated\"\n919\t            else \"excluded_by_contract\"\n920\t        )\n921\t        return Unsupported(\n922\t            reason_kind=reason_kind,\n923\t            reason=excluded.get(\"message\", \"\"),\n924\t            reason_code=reason_code,\n925\t        )\n926\t\n927\t    # ------------------------------------------------------------------ #\n928\t    # 3. Registered but gated question (e.g. VC-POC-14 via availability)\n929\t    # ------------------------------------------------------------------ #\n930\t    if question_id in contract.questions():\n931\t        refusal = contract.refusal_for(question_id)\n932\t        if refusal is not None:\n933\t            reason_code = refusal.get(\"reason_code\")\n934\t            reason_kind = (\n935\t                \"not_yet_validated\"\n936\t                if reason_code == \"not_yet_validated\"\n937\t                else \"excluded_by_contract\"\n938\t            )\n939\t            return Unsupported(\n940\t                reason_kind=reason_kind,\n941\t                reason=refusal.get(\"message\", \"\"),\n942\t                reason_code=reason_code,\n943\t            )\n944\t\n945\t    # ------------------------------------------------------------------ #\n946\t    # 4. Not in registry at all (unknown question)\n947\t    # ------------------------------------------------------------------ #\n948\t    if question_id not in contract.questions() and question_id not in contract.excluded_questions():\n949\t        if question_id == \"unknown\":\n950\t            return Unsupported(\n951\t                reason_kind=\"not_in_registry\",\n952\t                reason=\"The question does not map to any approved registry question.\",\n953\t            )\n954\t        return Unsupported(\n955\t            reason_kind=\"not_in_registry\",\n956\t            reason=f\"{question_id} is not a registry question.\",\n957\t        )\n958\t\n959\t    # ------------------------------------------------------------------ #\n960\t    # 5. Pinned policy and assembled request\n961\t    # ------------------------------------------------------------------ #\n962\t    entry = contract.questions().get(question_id)\n963\t    if entry is None:\n964\t        raise TerminalError(\n965\t            f\"{question_id} has a registered request schema but is absent from \"\n966\t            \"the pinned registry — contract drift\"\n967\t        )\n968\t    policy = entry.get(\"input_policy\") or {}\n969\t    required_fields = [f for f in policy.get(\"required\", []) if isinstance(f, str)]\n970\t    school_required = [f for f in required_fields if f in _SCHOOL_FIELDS]\n971\t\n972\t    # Fresh request from explicit intent fields only; planner-owned selectors\n973\t    # are added below. Unsupplied defaultables stay omitted — the emitter owns\n974\t    # defaults and resolved_request.\n975\t    request: dict[str, Any] = deepcopy(intent.filters)\n976\t\n977\t    scalar_clarification = _normalize_filter_selectors(question_id, request)\n978\t    if scalar_clarification is not None:\n979\t        return scalar_clarification\n980\t\n981\t    _adapt_explicit_school_fields(request, school_required)\n982\t    identity_from_caller = any(field in request for field in school_required)\n983\t\n984\t    # ------------------------------------------------------------------ #\n985\t    # 6. Transactional named-school resolution\n986\t    # ------------------------------------------------------------------ #\n987\t    mentions = [\n988\t        mention for mention in (intent.school_mentions or [])\n989\t        if isinstance(mention, str) and mention.strip()\n990\t    ]\n991\t    if school_required and mentions:\n992\t        resolved_ids, failure = await _resolve_mentions(question_id, mentions, client, deps)\n993\t        if failure is not None:\n994\t            return failure\n995\t        if \"acara_sml_id\" in school_required and len(resolved_ids) > 1:\n996\t            raise TerminalError(\n997\t                f\"{question_id}: multiple resolved schools cannot form the schema's \"\n998\t                \"single acara_sml_id request\"\n999\t            )\n1000\t        if _requires_two_distinct_ids(entry) and len(resolved_ids) < 2:\n1001\t            return _insufficient_schools_clarification(question_id)\n1002\t        if identity_from_caller:\n1003\t            explicit_ids = _explicit_id_values(request, school_required)\n1004\t            if sorted(resolved_ids) != sorted(explicit_ids):\n1005\t                raise TerminalError(\n1006\t                    f\"{question_id}: explicit school identities {explicit_ids} conflict \"\n1007\t                    f\"with directory-resolved identities {resolved_ids}\"\n1008\t                )\n1009\t            if \"acara_sml_ids\" in school_required:\n1010\t                request[\"acara_sml_ids\"] = list(resolved_ids)\n1011\t            else:\n1012\t                request[\"acara_sml_id\"] = resolved_ids[0]\n1013\t        else:\n1014\t            _attach_school_ids(request, school_required, resolved_ids)\n1015\t        for school_id in resolved_ids:\n1016\t            if school_id not in deps.resolved_school_ids:\n1017\t                deps.resolved_school_ids.append(school_id)\n1018\t        deps.searched = True\n1019\t    elif school_required and identity_from_caller and \"acara_sml_ids\" in school_required:\n1020\t        explicit_ids = _explicit_id_values(request, school_required)\n1021\t        raw_ids = request.get(\"acara_sml_ids\")\n1022\t        if (\n1023\t            _requires_two_distinct_ids(entry)\n1024\t            and isinstance(raw_ids, list)\n1025\t            and len(explicit_ids) == len(raw_ids)\n1026\t            and len(_dedupe(explicit_ids)) < 2\n1027\t        ):\n1028\t            return _insufficient_schools_clarification(question_id)\n1029\t\n1030\t    # ------------------------------------------------------------------ #\n1031\t    # 7. Selector normalization and routing (clarifies unnormalizable labels)\n1032\t    # ------------------------------------------------------------------ #\n1033\t    selector_clarification = _route_selectors(question_id, intent, request, deps)\n1034\t    if selector_clarification is not None:\n1035\t        return selector_clarification\n1036\t\n1037\t    metric_clarification = _enforce_metric_scope(question_id, request, deps)\n1038\t    if metric_clarification is not None:\n1039\t        return metric_clarification\n1040\t\n1041\t    # ------------------------------------------------------------------ #\n1042\t    # 8. Registry-owned explicit-filter constraints (VC-POC-09/10)\n1043\t    # ------------------------------------------------------------------ #\n1044\t    constraint_clarification = _enforce_explicit_filter_constraints(\n1045\t        question_id, entry, request\n1046\t    )\n1047\t    if constraint_clarification is not None:\n1048\t        return constraint_clarification\n1049\t\n1050\t    # ------------------------------------------------------------------ #\n1051\t    # 9. Derive missing inputs from the pinned policy (stable order)\n1052\t    # ------------------------------------------------------------------ #\n1053\t    missing = _derive_missing_inputs(question_id, entry, request)\n1054\t    if missing:\n1055\t        missing_items = [\n1056\t            MissingInput(\n1057\t                input=field,\n1058\t                why_material=_material_why(question_id, field),\n1059\t                allowed_values=_static_vocabulary_for_field(question_id, field) or [],\n1060\t            )\n1061\t            for field in missing\n1062\t        ]\n1063\t        prompt_to_user = (\n1064\t            \"To answer this question I need \"\n1065\t            + \", \".join(f\"the {field}\" for field in missing)\n1066\t            + \". Could you provide \"\n1067\t            + (\"it\" if len(missing) == 1 else \"them\")\n1068\t            + \"?\"\n1069\t        )\n1070\t        logger.debug(\n1071\t            \"planner clarification\",\n1072\t            extra={\"subsystem\": \"planner\", \"question_id\": question_id, \"missing\": missing},\n1073\t        )\n1074\t        return ClarificationNeeded(\n1075\t            question_id=question_id,\n1076\t            missing=missing_items,\n1077\t            prompt_to_user=prompt_to_user,\n1078\t        )\n1079\t\n1080\t    # ------------------------------------------------------------------ #\n1081\t    # 10. Pinned-schema validation before dispatch\n1082\t    # ------------------------------------------------------------------ #\n1083\t    _validate_request(question_id, request)\n1084\t    caller_identity_only = _caller_identity_only_field(request, identity_from_caller)\n1085\t\n1086\t    # ------------------------------------------------------------------ #\n1087\t    # 11. Fetch evidence (failures recorded before branching)\n1088\t    # ------------------------------------------------------------------ #\n1089\t    arguments = {\"question_id\": question_id, \"request\": request}\n1090\t    try:\n1091\t        envelope = await client.fetch_evidence(question_id, request)\n1092\t    except EvidenceError as exc:\n1093\t        deps.tool_calls.append(\n1094\t            ToolInvocation(\"fetch_evidence\", arguments, error_kind=exc.error_kind)\n1095\t        )\n1096\t        return _branch_evidence_error(question_id, exc, caller_identity_only)\n1097\t    except Exception:\n1098\t        deps.tool_calls.append(\n1099\t            ToolInvocation(\"fetch_evidence\", arguments, error_kind=\"operational\")\n1100\t        )\n1101\t        raise\n1102\t\n1103\t    deps.tool_calls.append(ToolInvocation(\"fetch_evidence\", arguments, envelope))\n1104\t    deps.last_envelope = envelope\n1105\t    logger.debug(\n1106\t        \"evidence fetched by planner\",\n1107\t        extra={\"subsystem\": \"planner\", \"question_id\": question_id},\n1108\t    )\n1109\t    return envelope\n1110\t\n1111\t\n1112\tdef _material_why(question_id: str, input_name: str) -> str:\n1113\t    \"\"\"A one-sentence human-readable explanation of why an input is material.\"\"\"\n1114\t    explanations: dict[str, str] = {\n1115\t        \"market_definition\": \"The market boundary changes which schools are compared.\",\n1116\t        \"distance_km\": \"\\\"Near\\\" is not a distance — the radius determines which schools qualify.\",\n1117\t        \"grades\": \"The grade selection determines which year levels are included.\",\n1118\t        \"peer_filters\": \"The peer group definition determines which schools are compared.\",\n1119\t        \"segment_filters\": \"The segment definition determines which schools are included.\",\n1120\t        \"sa2_codes\": \"The SA2 area determines which geographic area is analysed.\",\n1121\t        \"zone_entity_code\": \"The zone entity code identifies the government zone to look up.\",\n1122\t        \"acara_sml_id\": \"The school must be identified before evidence can be fetched.\",\n1123\t        \"acara_sml_ids\": \"The schools must be identified before evidence can be fetched.\",\n1124\t    }\n1125\t    return explanations.get(\n1126\t        input_name,\n1127\t        f\"{input_name} is required by the data layer and cannot be defaulted for this question.\",\n1128\t    )\n1129\t\n1130\t\n1131\tdef _caller_identity_only_field(\n1132\t    request: dict[str, Any], identity_from_caller: bool\n1133\t) -> str | None:\n1134\t    \"\"\"Return the sole caller-supplied ACARA identity field, if there is one.\"\"\"\n1135\t    if not identity_from_caller or len(request) != 1:\n1136\t        return None\n1137\t    if isinstance(request.get(\"acara_sml_id\"), int) and not isinstance(\n1138\t        request[\"acara_sml_id\"], bool\n1139\t    ):\n1140\t        return \"acara_sml_id\"\n1141\t    ids = request.get(\"acara_sml_ids\")\n1142\t    if isinstance(ids, list) and ids and all(\n1143\t        isinstance(value, int) and not isinstance(value, bool) for value in ids\n1144\t    ):\n1145\t        return \"acara_sml_ids\"\n1146\t    return None\n1147\t\n1148\t\n1149\tdef _branch_evidence_error(\n1150\t    question_id: str,\n1151\t    exc: EvidenceError,\n1152\t    caller_identity_only: str | None,\n1153\t) -> Unsupported | ClarificationNeeded:\n1154\t    \"\"\"Translate an EvidenceError into the pipeline's typed outcomes.\n1155\t\n1156\t    Origin-aware: bad_request clarifies only when the validated request contains\n1157\t    nothing except caller-supplied numeric school identity. Any other\n1158\t    bad_request is planner/contract drift. excluded/unknown/unanswerable keep\n1159\t    their contract-owned refusals; data_unavailable/internal are operational\n1160\t    stops, never refusals.\n1161\t    \"\"\"\n1162\t    kind = exc.error_kind\n1163\t    logger.debug(\n1164\t        \"evidence error in planner\",\n1165\t        extra={\"subsystem\": \"planner\", \"error_kind\": kind, \"question_id\": question_id},\n1166\t    )\n1167\t\n1168\t    if kind == \"excluded_question\":\n1169\t        reason_code = exc.reason_code or contract.reason_code_for(question_id)\n1170\t        reason_kind = (\n1171\t            \"not_yet_validated\"\n1172\t            if reason_code == \"not_yet_validated\"\n1173\t            else \"excluded_by_contract\"\n1174\t        )\n1175\t        return Unsupported(\n1176\t            reason_kind=reason_kind,\n1177\t            reason=exc.message,\n1178\t            reason_code=reason_code,\n1179\t        )\n1180\t\n1181\t    if kind == \"unknown_question\":\n1182\t        return Unsupported(reason_kind=\"not_in_registry\", reason=exc.message)\n1183\t\n1184\t    if kind == \"unanswerable\":\n1185\t        return Unsupported(reason_kind=\"unanswerable\", reason=exc.message)\n1186\t\n1187\t    if kind == \"bad_request\":\n1188\t        if caller_identity_only is not None:\n1189\t            return ClarificationNeeded(\n1190\t                question_id=question_id,\n1191\t                missing=[\n1192\t                    MissingInput(\n1193\t                        input=caller_identity_only,\n1194\t                        why_material=(\n1195\t                            \"The data layer rejected the supplied school identity \"\n1196\t                            f\"({exc.message}). Confirm the school's current public \"\n1197\t                            \"ACARA_SML_ID.\"\n1198\t                        ),\n1199\t                        allowed_values=[],\n1200\t                    )\n1201\t                ],\n1202\t                prompt_to_user=(\n1203\t                    \"The school identity supplied for this question was rejected by the \"\n1204\t                    \"data layer. Could you confirm the school?\"\n1205\t                ),\n1206\t            )\n1207\t        raise TerminalError(\n1208\t            f\"{question_id}: the evidence emitter returned bad_request for a \"\n1209\t            f\"deterministic, schema-valid request — planner/contract drift: {exc.message}\"\n1210\t        )\n1211\t\n1212\t    # data_unavailable | internal — operational stop, not a refusal.\n1213\t    raise TerminalError(f\"evidence emitter reported {kind}: {exc.message}\")\n1214\t"}]},"parent_tool_use_id":null,"session_id":"6a5a4bf9-713c-4453-8836-6a3d15f3b2d0","uuid":"dcb47b7e-042b-4c2a-bf16-a0a6cc0fdbf5","timestamp":"2026-09-25T22:57:59.538Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/harness/planner.py","content":"\"\"\"Stage 2 of the 4-stage pipeline: deterministic planning and execution.\n\n`plan_and_execute()` takes a StructuredIntent and returns either:\n- a dict (the evidence envelope) — the happy path\n- ClarificationNeeded — an input the caller must supply or correct\n- Unsupported — an exclusion or an unknown question\n\nNo model calls. Every branch is a pure function of the intent, the pinned\ncontract artefacts, and the evidence client's responses.\n\nWhat Stage 2 now guarantees (work item 20260908T113118):\n\n- Required, material, and applicable conditional-material inputs are derived\n  from the pinned question policy and the assembled request. The intent\n  model's `missing_material_inputs` claim is never trusted.\n- Named schools resolve through the pinned directory and must match exactly\n  one record each. IDs are staged in mention order, deduplicated without\n  reordering, and committed to `Deps` only after every mention resolves; a\n  zero or ambiguous match clarifies with no evidence call and no partial\n  identity mutation. Caller-supplied numeric IDs bypass the preflight (the\n  bounded resolution of the pinned Definition-Pack conflict) and any conflict\n  with name-resolved identities fails closed before dispatch.\n- Selector labels are Unicode-case-folded and separator-normalized, matched\n  against pinned static vocabularies (registry `metric_list` where declared;\n  otherwise the input-catalog schema's field mapping and embedded enums), and\n  routed to the question's own request field: `metrics` for VC-POC-01/04/11,\n  `ratios` for VC-POC-03, `grades` for VC-POC-02/07. Unsupplied selectors are\n  omitted — the emitter keeps default ownership (no invented defaults).\n- Every request is validated against its registered pinned per-question\n  schema before dispatch. A planner-produced request that cannot satisfy its\n  schema raises TerminalError — planner defects are never dressed up as\n  Unsupported user outcomes.\n- Error origins are separated: a bad_request against a request containing only\n  caller-supplied numeric school identity is an identity clarification; any\n  other bad_request after deterministic validation is planner/contract drift\n  and raises TerminalError. excluded/unknown/unanswerable keep their typed\n  abstentions; data_unavailable/internal remain operational stops.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport logging\nimport math\nimport re\nfrom copy import deepcopy\nfrom functools import lru_cache\nfrom pathlib import Path\nfrom typing import Any\n\nfrom jsonschema import Draft202012Validator\nfrom jsonschema.exceptions import SchemaError\nfrom referencing import Registry, Resource\nfrom referencing.exceptions import CannotDetermineSpecification, Unresolvable\n\nfrom harness import contract\nfrom harness.errors import TerminalError\nfrom harness.evidence import EvidenceClient, EvidenceError\nfrom harness.intent import StructuredIntent\nfrom harness.outputs import ClarificationNeeded, MissingInput, Unsupported\nfrom harness.tools import Deps, ToolInvocation, request_scope_problem\n\nlogger = logging.getLogger(\"harness.planner\")\n\n# Pinned contract artefacts. Static vocabularies and per-question schemas are\n# read from the vendored, hash-pinned directory `harness.contract` reads —\n# never from the runtime emitter.\n_SCHEMA_DIR = contract.CONTRACT_DIR / \"question_schemas\" / \"v0.3.0\"\n\n# Keyword hints the intent model may use for excluded topics, mapped to a search\n# term that appears in the corresponding contract exclusion text. The mapping is\n# fuzzy: the planner searches for any exclusion text that contains the keyword.\n_EXCLUSION_KEYWORD_MAP: dict[str, str] = {\n    \"finance\": \"fees\",\n    \"fees\": \"fees\",\n    \"cricos\": \"CRICOS\",\n    \"operations\": \"capacity\",\n    \"capacity\": \"capacity\",\n    \"transport\": \"public transport\",\n    \"crosswalk\": \"School_No\",\n    \"sa1\": \"SA1 fact\",\n    \"mesh_block\": \"Mesh Block\",\n    \"sa2\": \"SA2\",\n    \"gtfs\": \"GTFS\",\n}\n\n# The one pinned semantic alias (prompts/rules.md): for school-profile\n# requests \"teaching staff\" means teaching_fte. Keyed by the normalized label,\n# so \"Teaching Staff\" and \"teaching-staff\" match the same alias.\n_PINNED_SELECTOR_ALIASES: dict[str, str] = {\"teaching staff\": \"teaching_fte\"}\n\n_SCHOOL_FIELDS = (\"acara_sml_id\", \"acara_sml_ids\")\n\n# Label-selector request fields the requested label bag can be routed into.\n_SELECTOR_BAG_FIELDS = (\"metrics\", \"ratios\", \"grades\")\n\n# The only conditional-material declaration currently authorized by the pinned\n# contract. It belongs only to these questions; other operators, punctuation or\n# question IDs are drift, not prose for the planner to interpret.\n_DISTANCE_CONDITION = \"market_definition equals distance\"\n_DISTANCE_CONDITION_QUESTIONS = frozenset(\n    {\"VC-POC-05\", \"VC-POC-06\", \"VC-POC-07\"}\n)\n\n_SEPARATOR_RE = re.compile(r\"[\\W_]+\", re.UNICODE)\n\n\ndef _find_exclusion_text(excluded_topic: str | None) -> str:\n    \"\"\"Find the contract exclusion text matching a topic hint.\n\n    Searches the exclusion texts for a case-insensitive substring match on the\n    mapped keyword, then on the raw hint. Falls back to the first text in sorted\n    order so there is always a contract-text reason (never harness prose).\n    \"\"\"\n    texts = sorted(contract.exclusion_texts())\n    if not texts:\n        return \"\"\n\n    if excluded_topic:\n        # Try the mapped keyword first, then the raw hint\n        search_terms = []\n        hint_lower = excluded_topic.lower()\n        for key, mapped in _EXCLUSION_KEYWORD_MAP.items():\n            if key in hint_lower:\n                search_terms.append(mapped.lower())\n        search_terms.append(hint_lower)\n\n        for term in search_terms:\n            for text in texts:\n                if term in text.lower():\n                    return text\n\n    # Fallback: first exclusion text alphabetically\n    return texts[0]\n\n\n# --------------------------------------------------------------------------- #\n# Pinned artefact loading (fail-closed: load failures are TerminalError)\n# --------------------------------------------------------------------------- #\n\n\ndef _load_pinned_json(path: Path) -> Any:\n    try:\n        return json.loads(path.read_text(encoding=\"utf-8\"))\n    except (OSError, ValueError) as exc:\n        raise TerminalError(\n            f\"pinned contract artefact could not be loaded ({path.name}): {exc}\"\n        ) from exc\n\n\n@lru_cache(maxsize=1)\ndef _schema_index() -> dict[str, Any]:\n    index = _load_pinned_json(_SCHEMA_DIR / \"_index.json\")\n    if not isinstance(index, dict) or not isinstance(index.get(\"questions\"), dict):\n        raise TerminalError(\"pinned question-schema index is malformed\")\n    return index\n\n\n@lru_cache(maxsize=1)\ndef _input_catalog_schema() -> dict[str, Any]:\n    schema = _load_pinned_json(contract.CONTRACT_DIR / \"poc_input_catalog.v0.3.0.schema.json\")\n    if not isinstance(schema, dict):\n        raise TerminalError(\"pinned input-catalog schema is malformed\")\n    return schema\n\n\ndef _registered_request_schema_path(question_id: str) -> Path:\n    \"\"\"Resolve the question's registered request-schema path.\n\n    Only paths registered in the pinned index, beneath the pinned contract\n    directory, may be loaded — anything else is contract drift.\n    \"\"\"\n    entry = _schema_index()[\"questions\"].get(question_id)\n    if not isinstance(entry, dict):\n        raise TerminalError(f\"{question_id} has no registered request schema\")\n    filename = entry.get(\"request_schema\")\n    if not isinstance(filename, str) or filename != f\"{question_id}.request.schema.json\":\n        raise TerminalError(\n            f\"{question_id} request-schema registration is inconsistent: {filename!r}\"\n        )\n    path = (_SCHEMA_DIR / filename).resolve()\n    pinned = contract.CONTRACT_DIR.resolve()\n    if pinned not in path.parents:\n        raise TerminalError(\n            \"refusing to load a request schema from outside the pinned contract \"\n            f\"directory: {filename}\"\n        )\n    return path\n\n\n@lru_cache(maxsize=None)\ndef _request_schema(question_id: str) -> dict[str, Any]:\n    schema = _load_pinned_json(_registered_request_schema_path(question_id))\n    if not isinstance(schema, dict):\n        raise TerminalError(f\"{question_id} request schema is malformed\")\n    return schema\n\n\n# --------------------------------------------------------------------------- #\n# Static vocabularies (registry metric_list; catalog field mapping + enums)\n# --------------------------------------------------------------------------- #\n\n\n@lru_cache(maxsize=1)\ndef _field_to_catalog_list() -> dict[str, str]:\n    mapping = _input_catalog_schema().get(\"x-poc-request-field-to-catalog-list\")\n    if not isinstance(mapping, dict):\n        return {}\n    return {\n        str(field): str(list_name)\n        for field, list_name in mapping.items()\n        if isinstance(field, str) and isinstance(list_name, str)\n    }\n\n\ndef _static_enum(list_name: str) -> list[str] | None:\n    \"\"\"The embedded static enum for a catalog list, or None when the list is\n    release-derived (shape-checked only, never enum-enforced — OD-03).\"\"\"\n    if list_name.startswith(\"release_derived_values.\"):\n        return None\n    prop = _input_catalog_schema().get(\"properties\", {}).get(list_name)\n    if isinstance(prop, dict) and isinstance(prop.get(\"items\"), dict):\n        enum = prop[\"items\"].get(\"enum\")\n        if isinstance(enum, list):\n            return [str(value) for value in enum]\n    return None\n\n\ndef _static_vocabulary_for_field(question_id: str, field: str) -> list[str] | None:\n    list_name = _field_to_catalog_list().get(f\"{question_id}.{field}\")\n    if list_name is None:\n        return None\n    return _static_enum(list_name)\n\n\ndef _selector_route(question_id: str) -> tuple[str, list[str]] | None:\n    \"\"\"(request field, static vocabulary) for the question's label-selector bag.\n\n    The registry's `metric_list` is authoritative where declared (VC-POC-01/04\n    → profile_metrics, VC-POC-11 → student_context_metrics); otherwise the\n    input-catalog schema's field mapping routes e.g. VC-POC-03 to `ratios` and\n    VC-POC-02/07 to `grades`.\n    \"\"\"\n    entry = contract.questions().get(question_id) or {}\n    metric_list = entry.get(\"metric_list\")\n    if metric_list:\n        values = contract.registry().get(\"metric_lists\", {}).get(metric_list)\n        if not isinstance(values, list) or not values:\n            raise TerminalError(\n                f\"{question_id} declares metric_list {metric_list!r} with no pinned values\"\n            )\n        return \"metrics\", [str(value) for value in values]\n    field_to_list = _field_to_catalog_list()\n    for key in sorted(field_to_list):\n        prefix = f\"{question_id}.\"\n        if not key.startswith(prefix):\n            continue\n        field = key[len(prefix):]\n        if field in _SELECTOR_BAG_FIELDS:\n            vocabulary = _static_enum(field_to_list[key])\n            if vocabulary is None:\n                raise TerminalError(\n                    f\"{question_id}.{field} routes to a non-static vocabulary\"\n                )\n            return field, vocabulary\n    return None\n\n\n# --------------------------------------------------------------------------- #\n# Label normalization\n# --------------------------------------------------------------------------- #\n\n\ndef _normalize_label(label: Any) -> str:\n    \"\"\"Unicode-safe case folding plus separator normalization.\n\n    `total_enrolments`, `Total Enrolments` and `total-enrolments` all fold to\n    `total enrolments`; Unicode letters survive the fold.\n    \"\"\"\n    folded = _SEPARATOR_RE.sub(\" \", str(label).casefold())\n    return folded.strip()\n\n\ndef _canonical_for(label: Any, vocabulary: list[str]) -> str | None:\n    \"\"\"Match a label against a pinned static vocabulary.\n\n    Direct normalized matches win; beyond that only the pinned semantic\n    aliases apply. Canonical values are returned unchanged.\n    \"\"\"\n    wanted = _normalize_label(label)\n    for value in vocabulary:\n        if _normalize_label(value) == wanted:\n            return value\n    alias = _PINNED_SELECTOR_ALIASES.get(wanted)\n    if alias is not None and alias in vocabulary:\n        return alias\n    return None\n\n\ndef _dedupe(values: list[Any]) -> list[Any]:\n    \"\"\"Order-preserving deduplication.\"\"\"\n    seen: set[Any] = set()\n    unique: list[Any] = []\n    for value in values:\n        if value not in seen:\n            seen.add(value)\n            unique.append(value)\n    return unique\n\n\n# --------------------------------------------------------------------------- #\n# Pinned-schema validation (complete draft 2020-12, local references only)\n# --------------------------------------------------------------------------- #\n\n\n@lru_cache(maxsize=1)\ndef _request_validators() -> dict[str, Draft202012Validator]:\n    \"\"\"Build validators from only the locally pinned, registered schemas.\n\n    The registry has no retrieval callback: an unregistered or external\n    reference therefore fails closed instead of fetching a schema at runtime.\n    \"\"\"\n    schemas: dict[str, dict[str, Any]] = {}\n    resources: list[tuple[str, Resource[Any]]] = []\n    try:\n        for question_id in _schema_index()[\"questions\"]:\n            schema = _request_schema(question_id)\n            Draft202012Validator.check_schema(schema)\n            schema_id = schema.get(\"$id\")\n            if not isinstance(schema_id, str) or not schema_id:\n                raise TerminalError(f\"{question_id} request schema has no valid $id\")\n            schemas[question_id] = schema\n            resources.append((schema_id, Resource.from_contents(schema)))\n        registry = Registry().with_resources(resources)\n        return {\n            question_id: Draft202012Validator(\n                schema,\n                registry=registry,\n                format_checker=Draft202012Validator.FORMAT_CHECKER,\n            )\n            for question_id, schema in schemas.items()\n        }\n    except TerminalError:\n        raise\n    except (CannotDetermineSpecification, SchemaError, Unresolvable, ValueError) as exc:\n        raise TerminalError(f\"pinned request schemas could not be resolved: {exc}\") from exc\n\n\ndef _instance_path(parts: Any) -> str:\n    path = \"$request\"\n    for part in parts:\n        path += f\"[{part}]\" if isinstance(part, int) else f\".{part}\"\n    return path\n\n\ndef _schema_error_message(error: Any) -> str:\n    path = _instance_path(error.absolute_path)\n    if error.validator == \"additionalProperties\" and isinstance(error.instance, dict):\n        properties = error.schema.get(\"properties\", {})\n        known = set(properties) if isinstance(properties, dict) else set()\n        unknown = sorted(key for key in error.instance if key not in known)\n        return f\"{path}: unknown properties {unknown}\"\n    return f\"{path}: {error.message}\"\n\n\ndef _non_finite_paths(value: Any, path: str = \"$request\") -> list[str]:\n    \"\"\"Reject Python-only NaN/infinities, which are not JSON numbers.\"\"\"\n    if isinstance(value, float) and not math.isfinite(value):\n        return [path]\n    if isinstance(value, dict):\n        return [\n            problem\n            for key, child in value.items()\n            for problem in _non_finite_paths(child, f\"{path}.{key}\")\n        ]\n    if isinstance(value, list):\n        return [\n            problem\n            for index, child in enumerate(value)\n            for problem in _non_finite_paths(child, f\"{path}[{index}]\")\n        ]\n    return []\n\n\ndef _validate_request(question_id: str, request: dict[str, Any]) -> None:\n    \"\"\"Validate the planner-built request against its registered pinned schema.\n\n    Any failure — including schema load or resolution failure — is a\n    TerminalError before dispatch, never an Unsupported user outcome.\n    \"\"\"\n    validator = _request_validators().get(question_id)\n    if validator is None:\n        raise TerminalError(f\"{question_id} has no registered request validator\")\n    problems = [f\"{path}: value must be finite\" for path in _non_finite_paths(request)]\n    try:\n        errors = sorted(\n            validator.iter_errors(request),\n            key=lambda error: tuple(str(part) for part in error.absolute_path),\n        )\n    except Unresolvable as exc:\n        raise TerminalError(\n            f\"{question_id}: registered request schema reference could not be resolved: {exc}\"\n        ) from exc\n    problems.extend(_schema_error_message(error) for error in errors)\n    if problems:\n        raise TerminalError(\n            f\"{question_id}: the planner-built request does not satisfy its \"\n            f\"registered request schema: \" + \"; \".join(problems)\n        )\n\n\n# --------------------------------------------------------------------------- #\n# School identity resolution (transactional, exactly-one-match)\n# --------------------------------------------------------------------------- #\n\n\nasync def _resolve_mentions(\n    question_id: str,\n    mentions: list[str],\n    client: EvidenceClient,\n    deps: Deps,\n) -> tuple[list[int], ClarificationNeeded | None]:\n    \"\"\"Resolve each mention through the pinned directory, exactly one match each.\n\n    Every preflight is recorded, including failures. IDs are staged locally in\n    mention order and deduplicated without reordering; nothing is committed\n    here — the caller commits to `Deps` only after every mention resolves.\n    \"\"\"\n    staged: list[int] = []\n    for mention in mentions:\n        arguments = {\"search\": mention, \"limit\": 25}\n        try:\n            records = await client.school_directory(search=mention, limit=25)\n        except Exception as exc:\n            deps.tool_calls.append(\n                ToolInvocation(\"search_schools\", arguments, error_kind=type(exc).__name__)\n            )\n            raise\n        deps.tool_calls.append(ToolInvocation(\"search_schools\", arguments, records))\n        if not records:\n            return [], _school_match_clarification(\n                question_id,\n                mention,\n                f\"'{mention}' matched no school in the pinned directory.\",\n                \"I couldn't find that school. Could you check the name — or give me \"\n                \"the school's public ACARA ID?\",\n            )\n        if len(records) > 1:\n            return [], _school_match_clarification(\n                question_id,\n                mention,\n                f\"'{mention}' matched {len(records)} schools; a request needs exactly one.\",\n                f\"More than one school matches '{mention}'. Which one did you mean?\",\n            )\n        record = records[0]\n        school_id = record.get(\"acara_sml_id\") if isinstance(record, dict) else None\n        if (\n            not isinstance(school_id, int)\n            or isinstance(school_id, bool)\n            or school_id <= 0\n        ):\n            raise TerminalError(\n                f\"{question_id}: malformed school-directory record for {mention!r}; \"\n                \"exactly one positive integer acara_sml_id is required\"\n            )\n        if school_id not in staged:\n            staged.append(school_id)\n    return staged, None\n\n\ndef _school_match_clarification(\n    question_id: str, mention: str, why_material: str, prompt_to_user: str\n) -> ClarificationNeeded:\n    return ClarificationNeeded(\n        question_id=question_id,\n        missing=[\n            MissingInput(input=\"acara_sml_id\", why_material=why_material, allowed_values=[])\n        ],\n        prompt_to_user=prompt_to_user,\n    )\n\n\ndef _adapt_explicit_school_fields(request: dict[str, Any], school_required: list[str]) -> None:\n    \"\"\"Let a caller-supplied identity in either school field satisfy the\n    question's own selector field, without inventing values.\"\"\"\n    if not school_required:\n        return\n    if \"acara_sml_ids\" in school_required:\n        if \"acara_sml_ids\" not in request and isinstance(request.get(\"acara_sml_id\"), int):\n            request[\"acara_sml_ids\"] = [request.pop(\"acara_sml_id\")]\n    elif \"acara_sml_id\" in school_required:\n        if \"acara_sml_id\" not in request and isinstance(request.get(\"acara_sml_ids\"), list):\n            ids = request[\"acara_sml_ids\"]\n            if len(ids) == 1 and isinstance(ids[0], int) and not isinstance(ids[0], bool):\n                request[\"acara_sml_id\"] = ids[0]\n                del request[\"acara_sml_ids\"]\n            else:\n                raise TerminalError(\n                    \"caller supplied multiple acara_sml_ids for a question whose schema \"\n                    \"takes a single acara_sml_id\"\n                )\n\n\ndef _attach_school_ids(\n    request: dict[str, Any], school_required: list[str], ids: list[int]\n) -> None:\n    if not ids:\n        return\n    if \"acara_sml_ids\" in school_required:\n        request.setdefault(\"acara_sml_ids\", list(ids))\n    elif \"acara_sml_id\" in school_required:\n        request.setdefault(\"acara_sml_id\", ids[0])\n\n\ndef _explicit_id_values(request: dict[str, Any], school_required: list[str]) -> list[int]:\n    if \"acara_sml_ids\" in school_required:\n        value = request.get(\"acara_sml_ids\")\n        if isinstance(value, list):\n            return [v for v in value if isinstance(v, int) and not isinstance(v, bool)]\n        return []\n    if \"acara_sml_id\" in school_required:\n        value = request.get(\"acara_sml_id\")\n        if isinstance(value, int) and not isinstance(value, bool):\n            return [value]\n    return []\n\n\ndef _requires_two_distinct_ids(entry: dict[str, Any]) -> bool:\n    constraints = entry.get(\"input_policy\", {}).get(\"constraints\", [])\n    return any(\"at least two\" in str(constraint) for constraint in constraints)\n\n\ndef _insufficient_schools_clarification(question_id: str) -> ClarificationNeeded:\n    return ClarificationNeeded(\n        question_id=question_id,\n        missing=[\n            MissingInput(\n                input=\"acara_sml_ids\",\n                why_material=\"This comparison needs at least two distinct schools.\",\n                allowed_values=[],\n            )\n        ],\n        prompt_to_user=\"Which distinct schools should be compared? Name at least two.\",\n    )\n\n\n# --------------------------------------------------------------------------- #\n# Selector normalization and routing\n# --------------------------------------------------------------------------- #\n\n\ndef _selector_clarification(\n    question_id: str, field: str, value: Any, vocabulary: list[str]\n) -> ClarificationNeeded:\n    return ClarificationNeeded(\n        question_id=question_id,\n        missing=[\n            MissingInput(\n                input=field,\n                why_material=f\"'{value}' is not an allowed {field} value for {question_id}.\",\n                allowed_values=vocabulary,\n            )\n        ],\n        prompt_to_user=(\n            f\"Which {field} did you mean? Allowed values: \"\n            + \", \".join(vocabulary)\n            + \".\"\n        ),\n    )\n\n\ndef _request_field_schema(question_id: str, path: list[str]) -> dict[str, Any]:\n    \"\"\"Return the registered schema node for a mapped request-field path.\"\"\"\n\n    node: Any = _request_schema(question_id)\n    for part in path:\n        properties = node.get(\"properties\") if isinstance(node, dict) else None\n        node = properties.get(part) if isinstance(properties, dict) else None\n        if not isinstance(node, dict):\n            raise TerminalError(\n                f\"{question_id}: pinned selector mapping has no request-schema field \"\n                f\"{'.'.join(path)}\"\n            )\n    return node\n\n\ndef _normalize_filter_selectors(\n    question_id: str, request: dict[str, Any]\n) -> ClarificationNeeded | None:\n    \"\"\"Normalize every explicitly supplied selector backed by a static pin.\n\n    Release-derived/open fields retain their values and schema validation owns\n    wrong types and unknown keys. Static scalar, list and nested-list fields are\n    canonicalized with stable-order deduplication; unknown labels clarify.\n    \"\"\"\n    prefix = f\"{question_id}.\"\n    for mapped_field, list_name in _field_to_catalog_list().items():\n        if not mapped_field.startswith(prefix) or \"<keys>\" in mapped_field:\n            continue\n        vocabulary = _static_enum(list_name)\n        if vocabulary is None:\n            continue\n        path = mapped_field[len(prefix):].split(\".\")\n        owner: Any = request\n        for part in path[:-1]:\n            if not isinstance(owner, dict):\n                raise TerminalError(\n                    f\"{question_id}: invalid selector shape for {'.'.join(path)}\"\n                )\n            if part not in owner:\n                owner = None\n                break\n            owner = owner[part]\n        if owner is None:\n            continue\n        if not isinstance(owner, dict):\n            raise TerminalError(\n                f\"{question_id}: invalid selector shape for {'.'.join(path)}\"\n            )\n        if path[-1] not in owner:\n            continue\n        field = \".\".join(path)\n        value = owner[path[-1]]\n        field_schema = _request_field_schema(question_id, path)\n        expected_type = field_schema.get(\"type\")\n        if expected_type == \"string\":\n            if not isinstance(value, str):\n                raise TerminalError(\n                    f\"{question_id}: invalid selector shape for {field}; expected string\"\n                )\n            canonical = _canonical_for(value, vocabulary)\n            if canonical is None:\n                return _selector_clarification(question_id, field, value, vocabulary)\n            owner[path[-1]] = canonical\n        elif expected_type == \"array\":\n            if not isinstance(value, list) or not all(\n                isinstance(item, str) for item in value\n            ):\n                raise TerminalError(\n                    f\"{question_id}: invalid selector shape for {field}; \"\n                    \"expected an array of strings\"\n                )\n            canonical_values: list[str] = []\n            for item in value:\n                canonical = _canonical_for(item, vocabulary)\n                if canonical is None:\n                    return _selector_clarification(question_id, field, item, vocabulary)\n                canonical_values.append(canonical)\n            owner[path[-1]] = _dedupe(canonical_values)\n        else:\n            raise TerminalError(\n                f\"{question_id}: unsupported pinned selector shape for {field}\"\n            )\n    return None\n\n\ndef _route_selectors(\n    question_id: str,\n    intent: StructuredIntent,\n    request: dict[str, Any],\n    deps: Deps,\n) -> ClarificationNeeded | None:\n    \"\"\"Route requested selector labels to the question's own request field.\n\n    Static vocabularies come from pinned artefacts (registry metric_list where\n    declared, otherwise the input-catalog schema's field mapping and embedded\n    enums) — never from the runtime emitter. Selectors the user named none of\n    are omitted so the emitter keeps default ownership.\n    \"\"\"\n    labels = [str(label) for label in (intent.requested_metrics or []) if str(label).strip()]\n    if not labels:\n        return None\n    route = _selector_route(question_id)\n    if route is None:\n        return ClarificationNeeded(\n            question_id=question_id,\n            missing=[\n                MissingInput(\n                    input=\"metrics\",\n                    why_material=(\n                        f\"{question_id} takes no metric selector, so the requested \"\n                        \"labels cannot be applied to this request.\"\n                    ),\n                    allowed_values=[],\n                )\n            ],\n            prompt_to_user=\"This question does not take metric selectors. Should I answer it as asked?\",\n        )\n    field, vocabulary = route\n    canonical: list[str] = []\n    for label in labels:\n        matched = _canonical_for(label, vocabulary)\n        if matched is None:\n            return ClarificationNeeded(\n                question_id=question_id,\n                missing=[\n                    MissingInput(\n                        input=field,\n                        why_material=(\n                            f\"'{label}' is not an allowed {field} value for {question_id}.\"\n                        ),\n                        allowed_values=vocabulary,\n                    )\n                ],\n                prompt_to_user=(\n                    f\"Which {field} did you mean? Allowed values: \"\n                    + \", \".join(vocabulary)\n                    + \".\"\n                ),\n            )\n        canonical.append(matched)\n    canonical = _dedupe(canonical)\n\n    if field == \"metrics\":\n        # Final scope enforcement happens after filter and bag assembly so both\n        # sources receive the same rule.\n        pass\n    request[field] = canonical\n    return None\n\n\ndef _enforce_metric_scope(\n    question_id: str, request: dict[str, Any], deps: Deps\n) -> ClarificationNeeded | None:\n    metrics = request.get(\"metrics\")\n    if question_id not in {\"VC-POC-01\", \"VC-POC-04\"} or not isinstance(metrics, list):\n        return None\n    if not metrics or not all(isinstance(metric, str) for metric in metrics):\n        return None  # the pinned schema owns malformed shapes\n    admissible = [\n        metric\n        for metric in metrics\n        if request_scope_problem(\n            getattr(deps, \"_scope_user_question\", deps.user_question),\n            question_id,\n            {**request, \"metrics\": [metric]},\n        )\n        is None\n    ]\n    if not admissible:\n        vocabulary = _selector_route(question_id)\n        return ClarificationNeeded(\n            question_id=question_id,\n            missing=[\n                MissingInput(\n                    input=\"metrics\",\n                    why_material=(\n                        \"None of the explicitly selected metrics is supported by the \"\n                        \"scope stated in the user's request.\"\n                    ),\n                    allowed_values=vocabulary[1] if vocabulary else [],\n                )\n            ],\n            prompt_to_user=(\n                \"Which profile metric should I use? Headcount and non-teaching \"\n                \"metrics must be requested explicitly.\"\n            ),\n        )\n    request[\"metrics\"] = admissible\n    return None\n\n\n# --------------------------------------------------------------------------- #\n# Registry-owned explicit-filter constraints (VC-POC-09/10, OD-07)\n# --------------------------------------------------------------------------- #\n\n\ndef _enforce_explicit_filter_constraints(\n    question_id: str, entry: dict[str, Any], request: dict[str, Any]\n) -> ClarificationNeeded | None:\n    \"\"\"The registry-owned VC-POC-09/10 rule: a cohort definition must contain\n    at least one explicit filter — the sector default alone does not define a\n    peer group. Enforced exactly as pinned, not generalised into a condition\n    language. Absent fields are left to policy derivation.\"\"\"\n    policy = entry.get(\"input_policy\") or {}\n    required = [f for f in policy.get(\"required\", []) if isinstance(f, str)]\n\n    if \"peer_filters\" in required and isinstance(request.get(\"peer_filters\"), dict):\n        filters = request[\"peer_filters\"]\n        if not filters:\n            return _cohort_definition_clarification(\n                question_id,\n                \"peer_filters\",\n                \"The peer group definition is empty; at least one explicit filter \"\n                \"is required.\",\n            )\n        default_sectors = policy.get(\"defaultable\", {}).get(\"peer_filters.sectors\")\n        if (\n            set(filters) == {\"sectors\"}\n            and isinstance(default_sectors, list)\n            and isinstance(filters.get(\"sectors\"), list)\n            and sorted(str(s) for s in filters[\"sectors\"])\n            == sorted(str(s) for s in default_sectors)\n        ):\n            return _cohort_definition_clarification(\n                question_id,\n                \"peer_filters\",\n                \"The sector default alone does not define a peer group; at least one \"\n                \"explicit filter beyond the sector default is required.\",\n            )\n\n    if \"segment_filters\" in required and isinstance(request.get(\"segment_filters\"), dict):\n        if not request[\"segment_filters\"]:\n            return _cohort_definition_clarification(\n                question_id,\n                \"segment_filters\",\n                \"The segment definition is empty; at least one explicit filter \"\n                \"is required.\",\n            )\n    return None\n\n\ndef _cohort_definition_clarification(\n    question_id: str, field: str, why_material: str\n) -> ClarificationNeeded:\n    return ClarificationNeeded(\n        question_id=question_id,\n        missing=[MissingInput(input=field, why_material=why_material, allowed_values=[])],\n        prompt_to_user=(\n            \"Which rule should define this cohort — for example a sector, school \"\n            \"type, enrolment band, ICSEA range, remoteness or suburb?\"\n        ),\n    )\n\n\n# --------------------------------------------------------------------------- #\n# Derived missing inputs (pinned policy order)\n# --------------------------------------------------------------------------- #\n\n\ndef _derive_missing_inputs(\n    question_id: str, entry: dict[str, Any], request: dict[str, Any]\n) -> list[str]:\n    \"\"\"Missing required, material, then applicable conditional-material fields,\n    in pinned policy order — derived from policy and the assembled request,\n    never taken from the model's missing-input claim.\"\"\"\n    policy = entry.get(\"input_policy\") or {}\n    missing: list[str] = []\n    seen: set[str] = set()\n\n    def consider(field: str) -> None:\n        if field in seen:\n            return\n        seen.add(field)\n        if field not in request:\n            missing.append(field)\n\n    for field in policy.get(\"required\", []):\n        if isinstance(field, str):\n            consider(field)\n    for field in policy.get(\"material\", []):\n        if isinstance(field, str):\n            consider(field)\n\n    conditional = policy.get(\"conditional_material\", {})\n    if not isinstance(conditional, dict):\n        raise TerminalError(\n            f\"{question_id}: conditional-material policy is malformed — contract drift\"\n        )\n    for field, condition in conditional.items():\n        if (\n            question_id not in _DISTANCE_CONDITION_QUESTIONS\n            or field != \"distance_km\"\n            or condition != _DISTANCE_CONDITION\n        ):\n            raise TerminalError(\n                f\"{question_id}: unsupported conditional-material expression \"\n                f\"{condition!r} for {field} — contract drift, refusing to interpret it\"\n            )\n        if request.get(\"market_definition\") == \"distance\" and \"distance_km\" not in request:\n            consider(field)\n    return missing\n\n\n# --------------------------------------------------------------------------- #\n# Stage 2 entry point\n# --------------------------------------------------------------------------- #\n\n\nasync def plan_and_execute(\n    intent: StructuredIntent,\n    client: EvidenceClient,\n    deps: Deps,\n) -> dict[str, Any] | ClarificationNeeded | Unsupported:\n    \"\"\"Deterministic Stage 2: intent → evidence envelope or typed outcome.\n\n    Returns:\n        dict — the evidence envelope (happy path)\n        ClarificationNeeded — a caller-suppliable input is missing or wrong\n        Unsupported — an exclusion or an unknown question\n    May raise:\n        TerminalError — planner/schema defects and operational stops\n    \"\"\"\n    question_id = intent.question_id\n\n    # ------------------------------------------------------------------ #\n    # 1. Excluded topic (intent model classified it as out of scope)\n    # ------------------------------------------------------------------ #\n    if question_id == \"excluded\":\n        exclusion_text = _find_exclusion_text(intent.excluded_topic)\n        logger.debug(\n            \"intent classified as excluded topic\",\n            extra={\"subsystem\": \"planner\", \"excluded_topic\": intent.excluded_topic},\n        )\n        return Unsupported(\n            reason_kind=\"excluded_by_contract\",\n            reason=exclusion_text,\n        )\n\n    # ------------------------------------------------------------------ #\n    # 2. Registry-owned excluded question (e.g. VC-POC-TRANSPORT-01)\n    # ------------------------------------------------------------------ #\n    excluded = contract.excluded_questions().get(question_id)\n    if excluded:\n        reason_code = excluded.get(\"reason_code\")\n        reason_kind = (\n            \"not_yet_validated\"\n            if reason_code == \"not_yet_validated\"\n            else \"excluded_by_contract\"\n        )\n        return Unsupported(\n            reason_kind=reason_kind,\n            reason=excluded.get(\"message\", \"\"),\n            reason_code=reason_code,\n        )\n\n    # ------------------------------------------------------------------ #\n    # 3. Registered but gated question (e.g. VC-POC-14 via availability)\n    # ------------------------------------------------------------------ #\n    if question_id in contract.questions():\n        refusal = contract.refusal_for(question_id)\n        if refusal is not None:\n            reason_code = refusal.get(\"reason_code\")\n            reason_kind = (\n                \"not_yet_validated\"\n                if reason_code == \"not_yet_validated\"\n                else \"excluded_by_contract\"\n            )\n            return Unsupported(\n                reason_kind=reason_kind,\n                reason=refusal.get(\"message\", \"\"),\n                reason_code=reason_code,\n            )\n\n    # ------------------------------------------------------------------ #\n    # 4. Not in registry at all (unknown question)\n    # ------------------------------------------------------------------ #\n    if question_id not in contract.questions() and question_id not in contract.excluded_questions():\n        if question_id == \"unknown\":\n            return Unsupported(\n                reason_kind=\"not_in_registry\",\n                reason=\"The question does not map to any approved registry question.\",\n            )\n        return Unsupported(\n            reason_kind=\"not_in_registry\",\n            reason=f\"{question_id} is not a registry question.\",\n        )\n\n    # ------------------------------------------------------------------ #\n    # 5. Pinned policy and assembled request\n    # ------------------------------------------------------------------ #\n    entry = contract.questions().get(question_id)\n    if entry is None:\n        raise TerminalError(\n            f\"{question_id} has a registered request schema but is absent from \"\n            \"the pinned registry — contract drift\"\n        )\n    policy = entry.get(\"input_policy\") or {}\n    required_fields = [f for f in policy.get(\"required\", []) if isinstance(f, str)]\n    school_required = [f for f in required_fields if f in _SCHOOL_FIELDS]\n\n    # Fresh request from explicit intent fields only; planner-owned selectors\n    # are added below. Unsupplied defaultables stay omitted — the emitter owns\n    # defaults and resolved_request.\n    request: dict[str, Any] = deepcopy(intent.filters)\n\n    scalar_clarification = _normalize_filter_selectors(question_id, request)\n    if scalar_clarification is not None:\n        return scalar_clarification\n\n    _adapt_explicit_school_fields(request, school_required)\n    identity_from_caller = any(field in request for field in school_required)\n\n    # ------------------------------------------------------------------ #\n    # 6. Transactional named-school resolution\n    # ------------------------------------------------------------------ #\n    mentions = [\n        mention for mention in (intent.school_mentions or [])\n        if isinstance(mention, str) and mention.strip()\n    ]\n    if school_required and mentions:\n        resolved_ids, failure = await _resolve_mentions(question_id, mentions, client, deps)\n        if failure is not None:\n            return failure\n        if \"acara_sml_id\" in school_required and len(resolved_ids) > 1:\n            raise TerminalError(\n                f\"{question_id}: multiple resolved schools cannot form the schema's \"\n                \"single acara_sml_id request\"\n            )\n        if _requires_two_distinct_ids(entry) and len(resolved_ids) < 2:\n            return _insufficient_schools_clarification(question_id)\n        if identity_from_caller:\n            explicit_ids = _explicit_id_values(request, school_required)\n            if sorted(resolved_ids) != sorted(explicit_ids):\n                raise TerminalError(\n                    f\"{question_id}: explicit school identities {explicit_ids} conflict \"\n                    f\"with directory-resolved identities {resolved_ids}\"\n                )\n            if \"acara_sml_ids\" in school_required:\n                request[\"acara_sml_ids\"] = list(resolved_ids)\n            else:\n                request[\"acara_sml_id\"] = resolved_ids[0]\n        else:\n            _attach_school_ids(request, school_required, resolved_ids)\n        for school_id in resolved_ids:\n            if school_id not in deps.resolved_school_ids:\n                deps.resolved_school_ids.append(school_id)\n        deps.searched = True\n    elif school_required and identity_from_caller and \"acara_sml_ids\" in school_required:\n        explicit_ids = _explicit_id_values(request, school_required)\n        raw_ids = request.get(\"acara_sml_ids\")\n        if (\n            _requires_two_distinct_ids(entry)\n            and isinstance(raw_ids, list)\n            and len(explicit_ids) == len(raw_ids)\n            and len(_dedupe(explicit_ids)) < 2\n        ):\n            return _insufficient_schools_clarification(question_id)\n\n    # ------------------------------------------------------------------ #\n    # 7. Selector normalization and routing (clarifies unnormalizable labels)\n    # ------------------------------------------------------------------ #\n    selector_clarification = _route_selectors(question_id, intent, request, deps)\n    if selector_clarification is not None:\n        return selector_clarification\n\n    metric_clarification = _enforce_metric_scope(question_id, request, deps)\n    if metric_clarification is not None:\n        return metric_clarification\n\n    # ------------------------------------------------------------------ #\n    # 8. Registry-owned explicit-filter constraints (VC-POC-09/10)\n    # ------------------------------------------------------------------ #\n    constraint_clarification = _enforce_explicit_filter_constraints(\n        question_id, entry, request\n    )\n    if constraint_clarification is not None:\n        return constraint_clarification\n\n    # ------------------------------------------------------------------ #\n    # 9. Derive missing inputs from the pinned policy (stable order)\n    # ------------------------------------------------------------------ #\n    missing = _derive_missing_inputs(question_id, entry, request)\n    if missing:\n        missing_items = [\n            MissingInput(\n                input=field,\n                why_material=_material_why(question_id, field),\n                allowed_values=_static_vocabulary_for_field(question_id, field) or [],\n            )\n            for field in missing\n        ]\n        prompt_to_user = (\n            \"To answer this question I need \"\n            + \", \".join(f\"the {field}\" for field in missing)\n            + \". Could you provide \"\n            + (\"it\" if len(missing) == 1 else \"them\")\n            + \"?\"\n        )\n        logger.debug(\n            \"planner clarification\",\n            extra={\"subsystem\": \"planner\", \"question_id\": question_id, \"missing\": missing},\n        )\n        return ClarificationNeeded(\n            question_id=question_id,\n            missing=missing_items,\n            prompt_to_user=prompt_to_user,\n        )\n\n    # ------------------------------------------------------------------ #\n    # 10. Pinned-schema validation before dispatch\n    # ------------------------------------------------------------------ #\n    _validate_request(question_id, request)\n    caller_identity_only = _caller_identity_only_field(request, identity_from_caller)\n\n    # ------------------------------------------------------------------ #\n    # 11. Fetch evidence (failures recorded before branching)\n    # ------------------------------------------------------------------ #\n    arguments = {\"question_id\": question_id, \"request\": request}\n    try:\n        envelope = await client.fetch_evidence(question_id, request)\n    except EvidenceError as exc:\n        deps.tool_calls.append(\n            ToolInvocation(\"fetch_evidence\", arguments, error_kind=exc.error_kind)\n        )\n        return _branch_evidence_error(question_id, exc, caller_identity_only)\n    except Exception:\n        deps.tool_calls.append(\n            ToolInvocation(\"fetch_evidence\", arguments, error_kind=\"operational\")\n        )\n        raise\n\n    deps.tool_calls.append(ToolInvocation(\"fetch_evidence\", arguments, envelope))\n    deps.last_envelope = envelope\n    logger.debug(\n        \"evidence fetched by planner\",\n        extra={\"subsystem\": \"planner\", \"question_id\": question_id},\n    )\n    return envelope\n\n\ndef _material_why(question_id: str, input_name: str) -> str:\n    \"\"\"A one-sentence human-readable explanation of why an input is material.\"\"\"\n    explanations: dict[str, str] = {\n        \"market_definition\": \"The market boundary changes which schools are compared.\",\n        \"distance_km\": \"\\\"Near\\\" is not a distance — the radius determines which schools qualify.\",\n        \"grades\": \"The grade selection determines which year levels are included.\",\n        \"peer_filters\": \"The peer group definition determines which schools are compared.\",\n        \"segment_filters\": \"The segment definition determines which schools are included.\",\n        \"sa2_codes\": \"The SA2 area determines which geographic area is analysed.\",\n        \"zone_entity_code\": \"The zone entity code identifies the government zone to look up.\",\n        \"acara_sml_id\": \"The school must be identified before evidence can be fetched.\",\n        \"acara_sml_ids\": \"The schools must be identified before evidence can be fetched.\",\n    }\n    return explanations.get(\n        input_name,\n        f\"{input_name} is required by the data layer and cannot be defaulted for this question.\",\n    )\n\n\ndef _caller_identity_only_field(\n    request: dict[str, Any], identity_from_caller: bool\n) -> str | None:\n    \"\"\"Return the sole caller-supplied ACARA identity field, if there is one.\"\"\"\n    if not identity_from_caller or len(request) != 1:\n        return None\n    if isinstance(request.get(\"acara_sml_id\"), int) and not isinstance(\n        request[\"acara_sml_id\"], bool\n    ):\n        return \"acara_sml_id\"\n    ids = request.get(\"acara_sml_ids\")\n    if isinstance(ids, list) and ids and all(\n        isinstance(value, int) and not isinstance(value, bool) for value in ids\n    ):\n        return \"acara_sml_ids\"\n    return None\n\n\ndef _branch_evidence_error(\n    question_id: str,\n    exc: EvidenceError,\n    caller_identity_only: str | None,\n) -> Unsupported | ClarificationNeeded:\n    \"\"\"Translate an EvidenceError into the pipeline's typed outcomes.\n\n    Origin-aware: bad_request clarifies only when the validated request contains\n    nothing except caller-supplied numeric school identity. Any other\n    bad_request is planner/contract drift. excluded/unknown/unanswerable keep\n    their contract-owned refusals; data_unavailable/internal are operational\n    stops, never refusals.\n    \"\"\"\n    kind = exc.error_kind\n    logger.debug(\n        \"evidence error in planner\",\n        extra={\"subsystem\": \"planner\", \"error_kind\": kind, \"question_id\": question_id},\n    )\n\n    if kind == \"excluded_question\":\n        reason_code = exc.reason_code or contract.reason_code_for(question_id)\n        reason_kind = (\n            \"not_yet_validated\"\n            if reason_code == \"not_yet_validated\"\n            else \"excluded_by_contract\"\n        )\n        return Unsupported(\n            reason_kind=reason_kind,\n            reason=exc.message,\n            reason_code=reason_code,\n        )\n\n    if kind == \"unknown_question\":\n        return Unsupported(reason_kind=\"not_in_registry\", reason=exc.message)\n\n    if kind == \"unanswerable\":\n        return Unsupported(reason_kind=\"unanswerable\", reason=exc.message)\n\n    if kind == \"bad_request\":\n        if caller_identity_only is not None:\n            return ClarificationNeeded(\n                question_id=question_id,\n                missing=[\n                    MissingInput(\n                        input=caller_identity_only,\n                        why_material=(\n                            \"The data layer rejected the supplied school identity \"\n                            f\"({exc.message}). Confirm the school's current public \"\n                            \"ACARA_SML_ID.\"\n                        ),\n                        allowed_values=[],\n                    )\n                ],\n                prompt_to_user=(\n                    \"The school identity supplied for this question was rejected by the \"\n                    \"data layer. Could you confirm the school?\"\n                ),\n            )\n        raise TerminalError(\n            f\"{question_id}: the evidence emitter returned bad_request for a \"\n            f\"deterministic, schema-valid request — planner/contract drift: {exc.message}\"\n        )\n\n    # data_unavailable | internal — operational stop, not a refusal.\n    raise TerminalError(f\"evidence emitter reported {kind}: {exc.message}\")\n","numLines":1214,"startLine":1,"totalLines":1214}}}
