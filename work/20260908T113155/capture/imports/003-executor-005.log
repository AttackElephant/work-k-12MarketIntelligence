{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T7DyySdUHUGwWyW3S4XAzS","type":"tool_result","content":"1\t\"\"\"M4 — the live tier's machinery, exercised offline.\n2\t\n3\tThe live tier spends real tokens, so it runs manually and never gates a PR. But\n4\tits *arithmetic* must not wait for a paid run to be checked: a reporting bug in\n5\t`pass@k` / `pass^k` would misreport every live result afterwards, and the number\n6\tthat gets misreported is always the flattering one.\n7\t\n8\tSo everything here runs the real runner — `run_trial`, `run_suite`, the\n9\tsummariser, the report writer — with the model scripted. What is NOT proved here\n10\tis the only thing the live tier exists to measure: whether a real model makes\n11\tthe right decisions. That gap is the point of the tier, not an omission.\n12\t\n13\tThe paid tier itself is `tests/live/test_live_eval.py`, marked `live` and\n14\texcluded by `pytest.ini`.\n15\t\"\"\"\n16\t\n17\tfrom __future__ import annotations\n18\t\n19\timport asyncio\n20\timport json\n21\t\n22\timport pytest\n23\t\n24\tfrom evals import live, replay as replay_mod\n25\tfrom evals.live import CaseReport, TrialResult, aggregate, summarise\n26\tfrom evals.schema import load_cases, load_reference_solutions\n27\tfrom harness.agent import build_agent\n28\t\n29\tCASES = {c.case_id: c for c in load_cases()}\n30\tREFERENCES = load_reference_solutions()\n31\t\n32\t\n33\tdef trial(passed: bool, graders: list[str] | None = None, **kwargs) -> TrialResult:\n34\t    return TrialResult(\n35\t        case_id=\"c\",\n36\t        direction=\"should_answer\",\n37\t        phrasing=\"p\",\n38\t        trial=1,\n39\t        passed=passed,\n40\t        failed_graders=graders or [],\n41\t        **kwargs,\n42\t    )\n43\t\n44\t\n45\t# --------------------------------------------------------------------------\n46\t# pass@k and pass^k measure different things, and the difference is the point\n47\t# --------------------------------------------------------------------------\n48\t\n49\t\n50\tdef test_one_pass_in_three_is_capability_without_reliability():\n51\t    report = summarise(\"c\", \"should_answer\", [trial(True), trial(False), trial(False)])\n52\t    assert report.pass_at_k == 1.0, \"it managed it once — that is capability\"\n53\t    assert report.pass_hat_k == 0.0, \"it failed twice — that is not shippable\"\n54\t\n55\t\n56\tdef test_all_passing_is_reliable():\n57\t    report = summarise(\"c\", \"should_answer\", [trial(True), trial(True), trial(True)])\n58\t    assert (report.pass_at_k, report.pass_hat_k) == (1.0, 1.0)\n59\t\n60\t\n61\tdef test_none_passing_scores_zero_on_both():\n62\t    report = summarise(\"c\", \"should_answer\", [trial(False), trial(False)])\n63\t    assert (report.pass_at_k, report.pass_hat_k) == (0.0, 0.0)\n64\t\n65\t\n66\tdef test_a_single_trial_cannot_look_reliable_by_being_alone():\n67\t    \"\"\"k=1 makes pass@k and pass^k identical, which is honest — it just means a\n68\t    k=1 run has measured capability and nothing about reliability.\"\"\"\n69\t    report = summarise(\"c\", \"should_answer\", [trial(True)])\n70\t    assert report.pass_at_k == report.pass_hat_k == 1.0\n71\t\n72\t\n73\tdef test_failed_graders_are_counted_for_error_analysis():\n74\t    report = summarise(\n75\t        \"c\",\n76\t        \"should_answer\",\n77\t        [trial(False, [\"grounding\"]), trial(False, [\"grounding\", \"empty_stated\"])],\n78\t    )\n79\t    assert report.failed_graders == {\"grounding\": 2, \"empty_stated\": 1}\n80\t\n81\t\n82\tdef test_a_crashed_trial_counts_as_a_failure_not_a_skip():\n83\t    \"\"\"An eval that drops the runs that blew up reports a better score than it\n84\t    earned — the same rule `grade_suite` follows for missing records.\"\"\"\n85\t    crashed = trial(False)\n86\t    crashed.error = \"EmitterFailure: exit 3\"\n87\t    report = summarise(\"c\", \"should_answer\", [trial(True), crashed])\n88\t    assert report.passes == 1\n89\t    assert report.pass_hat_k == 0.0\n90\t    assert report.failed_graders == {\"error\": 1}\n91\t\n92\t\n93\tdef test_aggregate_averages_over_cases_and_counts_errors():\n94\t    reports = [\n95\t        CaseReport(\"a\", \"should_answer\", 2, 2, 1.0, 1.0),\n96\t        CaseReport(\"b\", \"should_answer\", 2, 1, 1.0, 0.0),\n97\t    ]\n98\t    errored = trial(False)\n99\t    errored.error = \"boom\"\n100\t    totals = aggregate(reports, [trial(True), errored])\n101\t    assert totals[\"pass_at_k\"] == 1.0\n102\t    assert totals[\"pass_hat_k\"] == 0.5\n103\t    assert totals[\"errored_trials\"] == 1\n104\t\n105\t\n106\tdef test_aggregate_survives_an_empty_selection():\n107\t    assert aggregate([], [])[\"cases\"] == 0\n108\t\n109\t\n110\tdef test_an_unpriced_run_does_not_claim_its_cost_is_complete():\n111\t    \"\"\"`cost: None (complete=True)` asserted that a null figure was the whole\n112\t    story. `complete` now means every trial was priced AND something was.\"\"\"\n113\t    totals = aggregate([CaseReport(\"a\", \"should_answer\", 1, 0, 0.0, 0.0)], [trial(False)])\n114\t    assert totals[\"cost_usd\"] is None\n115\t    assert totals[\"cost_complete\"] is False\n116\t\n117\t\n118\tdef test_a_priced_run_reports_its_cost_as_complete():\n119\t    priced = trial(True, cost_usd=0.02, cost_complete=True)\n120\t    totals = aggregate([CaseReport(\"a\", \"should_answer\", 1, 1, 1.0, 1.0)], [priced])\n121\t    assert totals[\"cost_usd\"] == 0.02\n122\t    assert totals[\"cost_complete\"] is True\n123\t\n124\t\n125\t# --------------------------------------------------------------------------\n126\t# a rejected credential ends the run; it is not a measurement\n127\t# --------------------------------------------------------------------------\n128\t\n129\t\n130\tdef test_a_rejected_credential_stops_the_run_instead_of_scoring_it():\n131\t    \"\"\"The M4 first-run failure: one placeholder key produced 100 identical\n132\t    \"failed trials\", pass@k 0.0, and a report that read as a model problem. An\n133\t    auth failure says nothing about judgement, so it must not enter the score.\"\"\"\n134\t    from pydantic_ai.exceptions import ModelHTTPError\n135\t\n136\t    case = CASES[\"answer/VC-POC-01\"]\n137\t\n138\t    def rejecting_factory():\n139\t        raise ModelHTTPError(\n140\t            status_code=401,\n141\t            model_name=\"claude-sonnet-4-6\",\n142\t            body={\"error\": {\"message\": \"API key is invalid.\"}},\n143\t        )\n144\t\n145\t    with pytest.raises(live.CredentialsRejected):\n146\t        asyncio.run(live.run_trial(case, case.phrasings[0], 1, \"stub\", rejecting_factory))\n147\t\n148\t\n149\tdef test_a_rejected_credential_aborts_the_whole_suite():\n150\t    from pydantic_ai.exceptions import ModelHTTPError\n151\t\n152\t    def rejecting_factory():\n153\t        raise ModelHTTPError(status_code=401, model_name=\"x\", body={})\n154\t\n155\t    with pytest.raises(live.CredentialsRejected):\n156\t        asyncio.run(\n157\t            live.run_suite(\n158\t                list(CASES.values())[:3], k=3, emitter=\"stub\", agent_factory=rejecting_factory\n159\t            )\n160\t        )\n161\t\n162\t\n163\tdef test_other_provider_failures_are_still_ordinary_failed_trials():\n164\t    \"\"\"Only auth aborts. A 500 or a timeout is a trial result — the tier exists\n165\t    to measure a flaky world, not to give up on it.\"\"\"\n166\t    from pydantic_ai.exceptions import ModelHTTPError\n167\t\n168\t    case = CASES[\"answer/VC-POC-01\"]\n169\t\n170\t    def failing_factory():\n171\t        raise ModelHTTPError(status_code=500, model_name=\"x\", body={})\n172\t\n173\t    result, record = asyncio.run(\n174\t        live.run_trial(case, case.phrasings[0], 1, \"stub\", failing_factory)\n175\t    )\n176\t    assert not result.passed and result.error and record is None\n177\t\n178\t\n179\t# --------------------------------------------------------------------------\n180\t# the runner, with the model scripted\n181\t# --------------------------------------------------------------------------\n182\t\n183\t\n184\tdef scripted_factory(case_id: str):\n185\t    record = REFERENCES[case_id]\n186\t    return lambda: build_agent(model=replay_mod.scripted_model(record))\n187\t\n188\t\n189\tdef test_a_correct_run_grades_as_a_pass_through_the_real_runner():\n190\t    case = CASES[\"answer/VC-POC-01\"]\n191\t    result, record = asyncio.run(\n192\t        live.run_trial(case, case.phrasings[0], 1, \"stub\", scripted_factory(case.case_id))\n193\t    )\n194\t    assert result.passed, result.detail\n195\t    assert result.output_kind == \"RenderedAnswer\"\n196\t    assert record is not None\n197\t\n198\t\n199\tdef test_a_wrong_decision_grades_as_a_failure_and_says_which_grader():\n200\t    \"\"\"A run that completes but decides wrongly — here, asking about a radius\n201\t    when the question needed a peer filter. The runner must name the grader that\n202\t    objected: a live failure with no named grader is a transcript nobody reads.\"\"\"\n203\t    case = CASES[\"clarify/peer_filters\"]\n204\t    wrong = CASES[\"clarify/distance_km\"]\n205\t    result, record = asyncio.run(\n206\t        live.run_trial(case, case.phrasings[0], 1, \"stub\", scripted_factory(wrong.case_id))\n207\t    )\n208\t    assert not result.passed\n209\t    assert result.error is None, \"this run completed — it was wrong, not broken\"\n210\t    assert result.failed_graders\n211\t    assert result.detail\n212\t    assert record is not None, \"a wrong answer is exactly the transcript to keep\"\n213\t\n214\t\n215\tdef test_a_run_that_breaks_is_distinguishable_from_a_run_that_is_wrong():\n216\t    \"\"\"`error` set means the run never produced a gradeable outcome. Collapsing\n217\t    the two would put provider outages into the pass^k denominator as model\n218\t    failures.\"\"\"\n219\t    case = CASES[\"answer/VC-POC-02\"]\n220\t    incompatible = CASES[\"answer/VC-POC-01\"]\n221\t    result, _ = asyncio.run(\n222\t        live.run_trial(\n223\t            case, case.phrasings[0], 1, \"stub\", scripted_factory(incompatible.case_id)\n224\t        )\n225\t    )\n226\t    assert not result.passed\n227\t    assert result.error and not result.failed_graders\n228\t\n229\t\n230\tdef test_a_trial_that_raises_is_recorded_rather_than_lost():\n231\t    case = CASES[\"answer/VC-POC-01\"]\n232\t\n233\t    def exploding_factory():\n234\t        raise RuntimeError(\"provider is down\")\n235\t\n236\t    result, record = asyncio.run(\n237\t        live.run_trial(case, case.phrasings[0], 1, \"stub\", exploding_factory)\n238\t    )\n239\t    assert not result.passed\n240\t    assert \"provider is down\" in result.error\n241\t    assert record is None\n242\t\n243\t\n244\tdef test_run_suite_reports_every_trial_and_writes_readable_transcripts(tmp_path):\n245\t    case = CASES[\"answer/VC-POC-01\"]\n246\t    reports, trials, transcripts, interruption = asyncio.run(\n247\t        live.run_suite([case], k=2, emitter=\"stub\", agent_factory=scripted_factory(case.case_id))\n248\t    )\n249\t    assert interruption is None\n250\t    assert reports[0].trials == 2 and reports[0].passes == 2\n251\t    assert len(trials) == 2\n252\t    path = live.write_report(\n253\t        {\"totals\": aggregate(reports, trials)}, transcripts, tmp_path\n254\t    )\n255\t    saved = json.loads(path.read_text(\"utf-8\"))\n256\t    assert saved[\"totals\"][\"pass_hat_k\"] == 1.0\n257\t    sibling = json.loads(\n258\t        next(tmp_path.glob(\"*-transcripts.json\")).read_text(\"utf-8\")\n259\t    )\n260\t    # The prose is what a human reads when a case fails; a report that dropped it\n261\t    # would make error analysis impossible.\n262\t    assert sibling[\"records\"][0][\"output\"][\"answer\"]\n263\t\n264\t\n265\t# --------------------------------------------------------------------------\n266\t# selection and the O-10 pressure probe\n267\t# --------------------------------------------------------------------------\n268\t\n269\t\n270\tdef test_pressure_appends_the_red_team_phrasings():\n271\t    case = CASES[\"answer/VC-POC-01\"]\n272\t    phrasings = live.phrasings_for(case, pressure=True, all_phrasings=False)\n273\t    assert len(phrasings) == len(live.PRESSURE_PHRASINGS)\n274\t    assert all(p.startswith(case.phrasings[0]) for p in phrasings)\n275\t\n276\t\n277\tdef test_pressure_k_is_total_trials_not_phrasings_times_trials():\n278\t    case = CASES[\"answer/VC-POC-01\"]\n279\t    slots = live.trial_slots([case], k=5, pressure=True, all_phrasings=False)\n280\t    assert len(slots) == 5\n281\t    assert len({phrasing for _, phrasing, _ in slots}) == 5\n282\t\n283\t\n284\tdef test_quota_stops_without_recording_a_model_failure():\n285\t    from harness.errors import QuotaExceeded\n286\t\n287\t    case = CASES[\"answer/VC-POC-01\"]\n288\t\n289\t    def exhausted_factory():\n290\t        raise QuotaExceeded(\n291\t            \"Claude subscription quota exhausted; resets tonight\",\n292\t            provider=\"claude-account\",\n293\t            reset_at=\"tonight\",\n294\t        )\n295\t\n296\t    reports, trials, transcripts, interruption = asyncio.run(\n297\t        live.run_suite([case], k=3, emitter=\"stub\", agent_factory=exhausted_factory)\n298\t    )\n299\t    assert not reports and not trials and not transcripts\n300\t    assert interruption and interruption.kind == \"quota_exhausted\"\n301\t    assert interruption.reset_at == \"tonight\"\n302\t    assert live.aggregate(reports, trials)[\"pass_at_k\"] is None\n303\t\n304\t\n305\tdef test_chunked_suite_resumes_without_repeating_completed_trials():\n306\t    case = CASES[\"answer/VC-POC-01\"]\n307\t    factory = scripted_factory(case.case_id)\n308\t    reports, first, transcripts, interruption = asyncio.run(\n309\t        live.run_suite([case], k=3, emitter=\"stub\", agent_factory=factory, max_trials=2)\n310\t    )\n311\t    assert not reports\n312\t    assert len(first) == 2\n313\t    assert interruption and interruption.kind == \"chunk_limit\"\n314\t\n315\t    reports, resumed, _, interruption = asyncio.run(\n316\t        live.run_suite(\n317\t            [case], k=3, emitter=\"stub\", agent_factory=factory,\n318\t            initial_trials=first, initial_transcripts=transcripts,\n319\t        )\n320\t    )\n321\t    assert interruption is None\n322\t    assert len(resumed) == 3\n323\t    assert reports[0].trials == reports[0].passes == 3\n324\t\n325\t\n326\tdef test_cli_checkpoint_can_be_resumed_without_repeating_a_trial(monkeypatch, tmp_path):\n327\t    import run as run_cli\n328\t\n329\t    case = CASES[\"answer/VC-POC-01\"]\n330\t    first = TrialResult(\n331\t        case_id=case.case_id,\n332\t        direction=case.direction,\n333\t        phrasing=case.phrasings[0],\n334\t        trial=1,\n335\t        passed=True,\n336\t        output_kind=\"RenderedAnswer\",\n337\t    )\n338\t    monkeypatch.setattr(run_cli, \"require_credentials\", lambda: None)\n339\t\n340\t    async def first_chunk(*args, **kwargs):\n341\t        return (\n342\t            [],\n343\t            [first],\n344\t            [],\n345\t            live.SuiteInterruption(\n346\t                \"chunk_limit\", \"one trial\", case.case_id, case.phrasings[0], 2\n347\t            ),\n348\t        )\n349\t\n350\t    monkeypatch.setattr(live, \"run_suite\", first_chunk)\n351\t    assert live.main(\n352\t        [\n353\t            \"--k\", \"2\", \"--case\", case.case_id, \"--max-trials\", \"1\",\n354\t            \"--report-dir\", str(tmp_path),\n355\t        ]\n356\t    ) == 2\n357\t    report_path = next(\n358\t        path for path in tmp_path.glob(\"live-*.json\") if not path.stem.endswith(\"-transcripts\")\n359\t    )\n360\t    checkpoint = json.loads(report_path.read_text(\"utf-8\"))\n361\t    assert checkpoint[\"status\"] == \"interrupted\"\n362\t    assert checkpoint[\"completed_trials\"] == 1\n363\t    assert checkpoint[\"totals\"][\"pass_at_k\"] is None\n364\t\n365\t    second = TrialResult(\n366\t        case_id=case.case_id,\n367\t        direction=case.direction,\n368\t        phrasing=case.phrasings[0],\n369\t        trial=2,\n370\t        passed=True,\n371\t        output_kind=\"RenderedAnswer\",\n372\t    )\n373\t\n374\t    async def resumed(*args, **kwargs):\n375\t        assert kwargs[\"initial_trials\"] == [first]\n376\t        trials = [first, second]\n377\t        return [summarise(case.case_id, case.direction, trials)], trials, [], None\n378\t\n379\t    monkeypatch.setattr(live, \"run_suite\", resumed)\n380\t    assert live.main([\"--resume\", str(report_path)]) == 0\n381\t    completed = json.loads(report_path.read_text(\"utf-8\"))\n382\t    assert completed[\"status\"] == \"complete\"\n383\t    assert completed[\"completed_trials\"] == 2\n384\t    assert completed[\"totals\"][\"pass_hat_k\"] == 1.0\n385\t\n386\t\n387\tdef test_without_pressure_one_phrasing_is_used():\n388\t    case = CASES[\"answer/VC-POC-01\"]\n389\t    assert live.phrasings_for(case, pressure=False, all_phrasings=False) == [\n390\t        case.phrasings[0]\n391\t    ]\n392\t\n393\t\n394\tdef test_pressure_selects_only_cases_with_an_answer_to_soften():\n395\t    args = live.build_parser().parse_args([\"--pressure\"])\n396\t    selected = live.select_cases(args)\n397\t    assert selected\n398\t    assert {c.direction for c in selected} <= {\"should_answer\", \"should_resist_injection\"}\n399\t\n400\t\n401\tdef test_an_unknown_case_id_fails_loudly():\n402\t    args = live.build_parser().parse_args([\"--case\", \"no/such/case\"])\n403\t    with pytest.raises(SystemExit):\n404\t        live.select_cases(args)\n405\t\n406\t\n407\tdef test_a_direction_filter_selects_that_direction():\n408\t    args = live.build_parser().parse_args([\"--direction\", \"should_refuse\"])\n409\t    selected = live.select_cases(args)\n410\t    assert selected and all(c.direction == \"should_refuse\" for c in selected)\n411\t\n412\t\n413\tdef test_the_stub_client_forces_the_case_fixture_it_declares():\n414\t    \"\"\"A case that exists to test an empty or gappy series must reach that\n415\t    envelope even when a live model's request differs in a defaultable way. The\n416\t    request itself is still graded, from the transcript.\"\"\"\n417\t    client = live.build_client(\"stub\", \"VC-POC-01/empty-series\")\n418\t    assert client.env[\"STUB_EMITTER_CASE\"] == \"VC-POC-01/empty-series\"\n419\t    assert \"STUB_EMITTER_CASE\" not in live.build_client(\"stub\", None).env\n420\t\n421\t\n422\t# --------------------------------------------------------------------------\n423\t# --stage CLI validation\n424\t# --------------------------------------------------------------------------\n425\t\n426\t\n427\tdef test_stage_intent_with_pressure_is_rejected():\n428\t    \"\"\"--stage intent --pressure is rejected: pressure applies to narration, not intent.\"\"\"\n429\t    with pytest.raises(SystemExit, match=\"--pressure is not valid\"):\n430\t        live.main([\"--stage\", \"intent\", \"--pressure\"])\n431\t\n432\t\n433\tdef test_stage_end_to_end_with_k_greater_than_1_is_rejected():\n434\t    \"\"\"--stage end-to-end --k 5 is rejected: the smoke suite must be k=1.\"\"\"\n435\t    with pytest.raises(SystemExit, match=\"--stage end-to-end requires --k 1\"):\n436\t        live.main([\"--stage\", \"end-to-end\", \"--k\", \"5\"])\n437\t\n438\t\n439\tdef test_stage_end_to_end_with_k_1_parses_without_rejection():\n440\t    \"\"\"--stage end-to-end --k 1 is a valid combination (the argument parsing accepts it).\"\"\"\n441\t    parser = live.build_parser()\n442\t    args = parser.parse_args([\"--stage\", \"end-to-end\", \"--k\", \"1\"])\n443\t    assert args.stage == \"end-to-end\"\n444\t    assert args.k == 1\n445\t\n446\t\n447\tdef test_stage_narration_with_pressure_parses_without_rejection():\n448\t    \"\"\"--stage narration --pressure is valid (pressure probes the prose stage).\"\"\"\n449\t    parser = live.build_parser()\n450\t    args = parser.parse_args([\"--stage\", \"narration\", \"--pressure\"])\n451\t    assert args.stage == \"narration\"\n452\t    assert args.pressure is True\n453\t\n454\t\n455\tdef test_stage_none_is_the_default():\n456\t    \"\"\"No --stage means None (the existing full-pipeline mode).\"\"\"\n457\t    parser = live.build_parser()\n458\t    args = parser.parse_args([])\n459\t    assert args.stage is None\n460\t\n461\t\n462\tdef test_stage_is_included_in_checkpoint_payload(monkeypatch, tmp_path):\n463\t    \"\"\"The stage field is written into the checkpoint for resume compatibility.\"\"\"\n464\t    case = CASES[\"answer/VC-POC-01\"]\n465\t\n466\t    async def fake_suite(*args, **kwargs):\n467\t        return [], [], [], None\n468\t\n469\t    monkeypatch.setattr(live, \"run_suite\", fake_suite)\n470\t    monkeypatch.setattr(\"run.require_credentials\", lambda: None)\n471\t\n472\t    live.main(\n473\t        [\"--stage\", \"intent\", \"--k\", \"1\", \"--case\", case.case_id,\n474\t         \"--report-dir\", str(tmp_path)]\n475\t    )\n476\t    report_path = next(\n477\t        path for path in tmp_path.glob(\"live-*.json\")\n478\t        if not path.stem.endswith(\"-transcripts\")\n479\t    )\n480\t    payload = json.loads(report_path.read_text(\"utf-8\"))\n481\t    assert payload.get(\"stage\") == \"intent\"\n482\t    assert payload.get(\"selection\", {}).get(\"stage\") == \"intent\"\n483\t\n484\t\n485\tdef test_resume_with_wrong_stage_is_rejected(monkeypatch, tmp_path):\n486\t    \"\"\"Resuming a checkpoint recorded with a different stage is rejected.\"\"\"\n487\t    case = CASES[\"answer/VC-POC-01\"]\n488\t\n489\t    async def fake_suite(*args, **kwargs):\n490\t        return [], [], [], None\n491\t\n492\t    monkeypatch.setattr(live, \"run_suite\", fake_suite)\n493\t    monkeypatch.setattr(\"run.require_credentials\", lambda: None)\n494\t\n495\t    # Record a checkpoint with --stage intent\n496\t    live.main(\n497\t        [\"--stage\", \"intent\", \"--k\", \"1\", \"--case\", case.case_id,\n498\t         \"--report-dir\", str(tmp_path)]\n499\t    )\n500\t    report_path = next(\n501\t        path for path in tmp_path.glob(\"live-*.json\")\n502\t        if not path.stem.endswith(\"-transcripts\")\n503\t    )\n504\t\n505\t    # Trying to resume it with --stage narration must fail\n506\t    with pytest.raises(SystemExit, match=\"recorded with --stage 'intent'\"):\n507\t        live.main([\"--stage\", \"narration\", \"--resume\", str(report_path)])\n508\t"}]},"parent_tool_use_id":null,"session_id":"6a5a4bf9-713c-4453-8836-6a3d15f3b2d0","uuid":"adfa00c6-d052-41b5-a509-34d15c159e11","timestamp":"2026-09-25T22:57:00.563Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/tests/unit/test_live_tier.py","content":"\"\"\"M4 — the live tier's machinery, exercised offline.\n\nThe live tier spends real tokens, so it runs manually and never gates a PR. But\nits *arithmetic* must not wait for a paid run to be checked: a reporting bug in\n`pass@k` / `pass^k` would misreport every live result afterwards, and the number\nthat gets misreported is always the flattering one.\n\nSo everything here runs the real runner — `run_trial`, `run_suite`, the\nsummariser, the report writer — with the model scripted. What is NOT proved here\nis the only thing the live tier exists to measure: whether a real model makes\nthe right decisions. That gap is the point of the tier, not an omission.\n\nThe paid tier itself is `tests/live/test_live_eval.py`, marked `live` and\nexcluded by `pytest.ini`.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport json\n\nimport pytest\n\nfrom evals import live, replay as replay_mod\nfrom evals.live import CaseReport, TrialResult, aggregate, summarise\nfrom evals.schema import load_cases, load_reference_solutions\nfrom harness.agent import build_agent\n\nCASES = {c.case_id: c for c in load_cases()}\nREFERENCES = load_reference_solutions()\n\n\ndef trial(passed: bool, graders: list[str] | None = None, **kwargs) -> TrialResult:\n    return TrialResult(\n        case_id=\"c\",\n        direction=\"should_answer\",\n        phrasing=\"p\",\n        trial=1,\n        passed=passed,\n        failed_graders=graders or [],\n        **kwargs,\n    )\n\n\n# --------------------------------------------------------------------------\n# pass@k and pass^k measure different things, and the difference is the point\n# --------------------------------------------------------------------------\n\n\ndef test_one_pass_in_three_is_capability_without_reliability():\n    report = summarise(\"c\", \"should_answer\", [trial(True), trial(False), trial(False)])\n    assert report.pass_at_k == 1.0, \"it managed it once — that is capability\"\n    assert report.pass_hat_k == 0.0, \"it failed twice — that is not shippable\"\n\n\ndef test_all_passing_is_reliable():\n    report = summarise(\"c\", \"should_answer\", [trial(True), trial(True), trial(True)])\n    assert (report.pass_at_k, report.pass_hat_k) == (1.0, 1.0)\n\n\ndef test_none_passing_scores_zero_on_both():\n    report = summarise(\"c\", \"should_answer\", [trial(False), trial(False)])\n    assert (report.pass_at_k, report.pass_hat_k) == (0.0, 0.0)\n\n\ndef test_a_single_trial_cannot_look_reliable_by_being_alone():\n    \"\"\"k=1 makes pass@k and pass^k identical, which is honest — it just means a\n    k=1 run has measured capability and nothing about reliability.\"\"\"\n    report = summarise(\"c\", \"should_answer\", [trial(True)])\n    assert report.pass_at_k == report.pass_hat_k == 1.0\n\n\ndef test_failed_graders_are_counted_for_error_analysis():\n    report = summarise(\n        \"c\",\n        \"should_answer\",\n        [trial(False, [\"grounding\"]), trial(False, [\"grounding\", \"empty_stated\"])],\n    )\n    assert report.failed_graders == {\"grounding\": 2, \"empty_stated\": 1}\n\n\ndef test_a_crashed_trial_counts_as_a_failure_not_a_skip():\n    \"\"\"An eval that drops the runs that blew up reports a better score than it\n    earned — the same rule `grade_suite` follows for missing records.\"\"\"\n    crashed = trial(False)\n    crashed.error = \"EmitterFailure: exit 3\"\n    report = summarise(\"c\", \"should_answer\", [trial(True), crashed])\n    assert report.passes == 1\n    assert report.pass_hat_k == 0.0\n    assert report.failed_graders == {\"error\": 1}\n\n\ndef test_aggregate_averages_over_cases_and_counts_errors():\n    reports = [\n        CaseReport(\"a\", \"should_answer\", 2, 2, 1.0, 1.0),\n        CaseReport(\"b\", \"should_answer\", 2, 1, 1.0, 0.0),\n    ]\n    errored = trial(False)\n    errored.error = \"boom\"\n    totals = aggregate(reports, [trial(True), errored])\n    assert totals[\"pass_at_k\"] == 1.0\n    assert totals[\"pass_hat_k\"] == 0.5\n    assert totals[\"errored_trials\"] == 1\n\n\ndef test_aggregate_survives_an_empty_selection():\n    assert aggregate([], [])[\"cases\"] == 0\n\n\ndef test_an_unpriced_run_does_not_claim_its_cost_is_complete():\n    \"\"\"`cost: None (complete=True)` asserted that a null figure was the whole\n    story. `complete` now means every trial was priced AND something was.\"\"\"\n    totals = aggregate([CaseReport(\"a\", \"should_answer\", 1, 0, 0.0, 0.0)], [trial(False)])\n    assert totals[\"cost_usd\"] is None\n    assert totals[\"cost_complete\"] is False\n\n\ndef test_a_priced_run_reports_its_cost_as_complete():\n    priced = trial(True, cost_usd=0.02, cost_complete=True)\n    totals = aggregate([CaseReport(\"a\", \"should_answer\", 1, 1, 1.0, 1.0)], [priced])\n    assert totals[\"cost_usd\"] == 0.02\n    assert totals[\"cost_complete\"] is True\n\n\n# --------------------------------------------------------------------------\n# a rejected credential ends the run; it is not a measurement\n# --------------------------------------------------------------------------\n\n\ndef test_a_rejected_credential_stops_the_run_instead_of_scoring_it():\n    \"\"\"The M4 first-run failure: one placeholder key produced 100 identical\n    \"failed trials\", pass@k 0.0, and a report that read as a model problem. An\n    auth failure says nothing about judgement, so it must not enter the score.\"\"\"\n    from pydantic_ai.exceptions import ModelHTTPError\n\n    case = CASES[\"answer/VC-POC-01\"]\n\n    def rejecting_factory():\n        raise ModelHTTPError(\n            status_code=401,\n            model_name=\"claude-sonnet-4-6\",\n            body={\"error\": {\"message\": \"API key is invalid.\"}},\n        )\n\n    with pytest.raises(live.CredentialsRejected):\n        asyncio.run(live.run_trial(case, case.phrasings[0], 1, \"stub\", rejecting_factory))\n\n\ndef test_a_rejected_credential_aborts_the_whole_suite():\n    from pydantic_ai.exceptions import ModelHTTPError\n\n    def rejecting_factory():\n        raise ModelHTTPError(status_code=401, model_name=\"x\", body={})\n\n    with pytest.raises(live.CredentialsRejected):\n        asyncio.run(\n            live.run_suite(\n                list(CASES.values())[:3], k=3, emitter=\"stub\", agent_factory=rejecting_factory\n            )\n        )\n\n\ndef test_other_provider_failures_are_still_ordinary_failed_trials():\n    \"\"\"Only auth aborts. A 500 or a timeout is a trial result — the tier exists\n    to measure a flaky world, not to give up on it.\"\"\"\n    from pydantic_ai.exceptions import ModelHTTPError\n\n    case = CASES[\"answer/VC-POC-01\"]\n\n    def failing_factory():\n        raise ModelHTTPError(status_code=500, model_name=\"x\", body={})\n\n    result, record = asyncio.run(\n        live.run_trial(case, case.phrasings[0], 1, \"stub\", failing_factory)\n    )\n    assert not result.passed and result.error and record is None\n\n\n# --------------------------------------------------------------------------\n# the runner, with the model scripted\n# --------------------------------------------------------------------------\n\n\ndef scripted_factory(case_id: str):\n    record = REFERENCES[case_id]\n    return lambda: build_agent(model=replay_mod.scripted_model(record))\n\n\ndef test_a_correct_run_grades_as_a_pass_through_the_real_runner():\n    case = CASES[\"answer/VC-POC-01\"]\n    result, record = asyncio.run(\n        live.run_trial(case, case.phrasings[0], 1, \"stub\", scripted_factory(case.case_id))\n    )\n    assert result.passed, result.detail\n    assert result.output_kind == \"RenderedAnswer\"\n    assert record is not None\n\n\ndef test_a_wrong_decision_grades_as_a_failure_and_says_which_grader():\n    \"\"\"A run that completes but decides wrongly — here, asking about a radius\n    when the question needed a peer filter. The runner must name the grader that\n    objected: a live failure with no named grader is a transcript nobody reads.\"\"\"\n    case = CASES[\"clarify/peer_filters\"]\n    wrong = CASES[\"clarify/distance_km\"]\n    result, record = asyncio.run(\n        live.run_trial(case, case.phrasings[0], 1, \"stub\", scripted_factory(wrong.case_id))\n    )\n    assert not result.passed\n    assert result.error is None, \"this run completed — it was wrong, not broken\"\n    assert result.failed_graders\n    assert result.detail\n    assert record is not None, \"a wrong answer is exactly the transcript to keep\"\n\n\ndef test_a_run_that_breaks_is_distinguishable_from_a_run_that_is_wrong():\n    \"\"\"`error` set means the run never produced a gradeable outcome. Collapsing\n    the two would put provider outages into the pass^k denominator as model\n    failures.\"\"\"\n    case = CASES[\"answer/VC-POC-02\"]\n    incompatible = CASES[\"answer/VC-POC-01\"]\n    result, _ = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", scripted_factory(incompatible.case_id)\n        )\n    )\n    assert not result.passed\n    assert result.error and not result.failed_graders\n\n\ndef test_a_trial_that_raises_is_recorded_rather_than_lost():\n    case = CASES[\"answer/VC-POC-01\"]\n\n    def exploding_factory():\n        raise RuntimeError(\"provider is down\")\n\n    result, record = asyncio.run(\n        live.run_trial(case, case.phrasings[0], 1, \"stub\", exploding_factory)\n    )\n    assert not result.passed\n    assert \"provider is down\" in result.error\n    assert record is None\n\n\ndef test_run_suite_reports_every_trial_and_writes_readable_transcripts(tmp_path):\n    case = CASES[\"answer/VC-POC-01\"]\n    reports, trials, transcripts, interruption = asyncio.run(\n        live.run_suite([case], k=2, emitter=\"stub\", agent_factory=scripted_factory(case.case_id))\n    )\n    assert interruption is None\n    assert reports[0].trials == 2 and reports[0].passes == 2\n    assert len(trials) == 2\n    path = live.write_report(\n        {\"totals\": aggregate(reports, trials)}, transcripts, tmp_path\n    )\n    saved = json.loads(path.read_text(\"utf-8\"))\n    assert saved[\"totals\"][\"pass_hat_k\"] == 1.0\n    sibling = json.loads(\n        next(tmp_path.glob(\"*-transcripts.json\")).read_text(\"utf-8\")\n    )\n    # The prose is what a human reads when a case fails; a report that dropped it\n    # would make error analysis impossible.\n    assert sibling[\"records\"][0][\"output\"][\"answer\"]\n\n\n# --------------------------------------------------------------------------\n# selection and the O-10 pressure probe\n# --------------------------------------------------------------------------\n\n\ndef test_pressure_appends_the_red_team_phrasings():\n    case = CASES[\"answer/VC-POC-01\"]\n    phrasings = live.phrasings_for(case, pressure=True, all_phrasings=False)\n    assert len(phrasings) == len(live.PRESSURE_PHRASINGS)\n    assert all(p.startswith(case.phrasings[0]) for p in phrasings)\n\n\ndef test_pressure_k_is_total_trials_not_phrasings_times_trials():\n    case = CASES[\"answer/VC-POC-01\"]\n    slots = live.trial_slots([case], k=5, pressure=True, all_phrasings=False)\n    assert len(slots) == 5\n    assert len({phrasing for _, phrasing, _ in slots}) == 5\n\n\ndef test_quota_stops_without_recording_a_model_failure():\n    from harness.errors import QuotaExceeded\n\n    case = CASES[\"answer/VC-POC-01\"]\n\n    def exhausted_factory():\n        raise QuotaExceeded(\n            \"Claude subscription quota exhausted; resets tonight\",\n            provider=\"claude-account\",\n            reset_at=\"tonight\",\n        )\n\n    reports, trials, transcripts, interruption = asyncio.run(\n        live.run_suite([case], k=3, emitter=\"stub\", agent_factory=exhausted_factory)\n    )\n    assert not reports and not trials and not transcripts\n    assert interruption and interruption.kind == \"quota_exhausted\"\n    assert interruption.reset_at == \"tonight\"\n    assert live.aggregate(reports, trials)[\"pass_at_k\"] is None\n\n\ndef test_chunked_suite_resumes_without_repeating_completed_trials():\n    case = CASES[\"answer/VC-POC-01\"]\n    factory = scripted_factory(case.case_id)\n    reports, first, transcripts, interruption = asyncio.run(\n        live.run_suite([case], k=3, emitter=\"stub\", agent_factory=factory, max_trials=2)\n    )\n    assert not reports\n    assert len(first) == 2\n    assert interruption and interruption.kind == \"chunk_limit\"\n\n    reports, resumed, _, interruption = asyncio.run(\n        live.run_suite(\n            [case], k=3, emitter=\"stub\", agent_factory=factory,\n            initial_trials=first, initial_transcripts=transcripts,\n        )\n    )\n    assert interruption is None\n    assert len(resumed) == 3\n    assert reports[0].trials == reports[0].passes == 3\n\n\ndef test_cli_checkpoint_can_be_resumed_without_repeating_a_trial(monkeypatch, tmp_path):\n    import run as run_cli\n\n    case = CASES[\"answer/VC-POC-01\"]\n    first = TrialResult(\n        case_id=case.case_id,\n        direction=case.direction,\n        phrasing=case.phrasings[0],\n        trial=1,\n        passed=True,\n        output_kind=\"RenderedAnswer\",\n    )\n    monkeypatch.setattr(run_cli, \"require_credentials\", lambda: None)\n\n    async def first_chunk(*args, **kwargs):\n        return (\n            [],\n            [first],\n            [],\n            live.SuiteInterruption(\n                \"chunk_limit\", \"one trial\", case.case_id, case.phrasings[0], 2\n            ),\n        )\n\n    monkeypatch.setattr(live, \"run_suite\", first_chunk)\n    assert live.main(\n        [\n            \"--k\", \"2\", \"--case\", case.case_id, \"--max-trials\", \"1\",\n            \"--report-dir\", str(tmp_path),\n        ]\n    ) == 2\n    report_path = next(\n        path for path in tmp_path.glob(\"live-*.json\") if not path.stem.endswith(\"-transcripts\")\n    )\n    checkpoint = json.loads(report_path.read_text(\"utf-8\"))\n    assert checkpoint[\"status\"] == \"interrupted\"\n    assert checkpoint[\"completed_trials\"] == 1\n    assert checkpoint[\"totals\"][\"pass_at_k\"] is None\n\n    second = TrialResult(\n        case_id=case.case_id,\n        direction=case.direction,\n        phrasing=case.phrasings[0],\n        trial=2,\n        passed=True,\n        output_kind=\"RenderedAnswer\",\n    )\n\n    async def resumed(*args, **kwargs):\n        assert kwargs[\"initial_trials\"] == [first]\n        trials = [first, second]\n        return [summarise(case.case_id, case.direction, trials)], trials, [], None\n\n    monkeypatch.setattr(live, \"run_suite\", resumed)\n    assert live.main([\"--resume\", str(report_path)]) == 0\n    completed = json.loads(report_path.read_text(\"utf-8\"))\n    assert completed[\"status\"] == \"complete\"\n    assert completed[\"completed_trials\"] == 2\n    assert completed[\"totals\"][\"pass_hat_k\"] == 1.0\n\n\ndef test_without_pressure_one_phrasing_is_used():\n    case = CASES[\"answer/VC-POC-01\"]\n    assert live.phrasings_for(case, pressure=False, all_phrasings=False) == [\n        case.phrasings[0]\n    ]\n\n\ndef test_pressure_selects_only_cases_with_an_answer_to_soften():\n    args = live.build_parser().parse_args([\"--pressure\"])\n    selected = live.select_cases(args)\n    assert selected\n    assert {c.direction for c in selected} <= {\"should_answer\", \"should_resist_injection\"}\n\n\ndef test_an_unknown_case_id_fails_loudly():\n    args = live.build_parser().parse_args([\"--case\", \"no/such/case\"])\n    with pytest.raises(SystemExit):\n        live.select_cases(args)\n\n\ndef test_a_direction_filter_selects_that_direction():\n    args = live.build_parser().parse_args([\"--direction\", \"should_refuse\"])\n    selected = live.select_cases(args)\n    assert selected and all(c.direction == \"should_refuse\" for c in selected)\n\n\ndef test_the_stub_client_forces_the_case_fixture_it_declares():\n    \"\"\"A case that exists to test an empty or gappy series must reach that\n    envelope even when a live model's request differs in a defaultable way. The\n    request itself is still graded, from the transcript.\"\"\"\n    client = live.build_client(\"stub\", \"VC-POC-01/empty-series\")\n    assert client.env[\"STUB_EMITTER_CASE\"] == \"VC-POC-01/empty-series\"\n    assert \"STUB_EMITTER_CASE\" not in live.build_client(\"stub\", None).env\n\n\n# --------------------------------------------------------------------------\n# --stage CLI validation\n# --------------------------------------------------------------------------\n\n\ndef test_stage_intent_with_pressure_is_rejected():\n    \"\"\"--stage intent --pressure is rejected: pressure applies to narration, not intent.\"\"\"\n    with pytest.raises(SystemExit, match=\"--pressure is not valid\"):\n        live.main([\"--stage\", \"intent\", \"--pressure\"])\n\n\ndef test_stage_end_to_end_with_k_greater_than_1_is_rejected():\n    \"\"\"--stage end-to-end --k 5 is rejected: the smoke suite must be k=1.\"\"\"\n    with pytest.raises(SystemExit, match=\"--stage end-to-end requires --k 1\"):\n        live.main([\"--stage\", \"end-to-end\", \"--k\", \"5\"])\n\n\ndef test_stage_end_to_end_with_k_1_parses_without_rejection():\n    \"\"\"--stage end-to-end --k 1 is a valid combination (the argument parsing accepts it).\"\"\"\n    parser = live.build_parser()\n    args = parser.parse_args([\"--stage\", \"end-to-end\", \"--k\", \"1\"])\n    assert args.stage == \"end-to-end\"\n    assert args.k == 1\n\n\ndef test_stage_narration_with_pressure_parses_without_rejection():\n    \"\"\"--stage narration --pressure is valid (pressure probes the prose stage).\"\"\"\n    parser = live.build_parser()\n    args = parser.parse_args([\"--stage\", \"narration\", \"--pressure\"])\n    assert args.stage == \"narration\"\n    assert args.pressure is True\n\n\ndef test_stage_none_is_the_default():\n    \"\"\"No --stage means None (the existing full-pipeline mode).\"\"\"\n    parser = live.build_parser()\n    args = parser.parse_args([])\n    assert args.stage is None\n\n\ndef test_stage_is_included_in_checkpoint_payload(monkeypatch, tmp_path):\n    \"\"\"The stage field is written into the checkpoint for resume compatibility.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n\n    async def fake_suite(*args, **kwargs):\n        return [], [], [], None\n\n    monkeypatch.setattr(live, \"run_suite\", fake_suite)\n    monkeypatch.setattr(\"run.require_credentials\", lambda: None)\n\n    live.main(\n        [\"--stage\", \"intent\", \"--k\", \"1\", \"--case\", case.case_id,\n         \"--report-dir\", str(tmp_path)]\n    )\n    report_path = next(\n        path for path in tmp_path.glob(\"live-*.json\")\n        if not path.stem.endswith(\"-transcripts\")\n    )\n    payload = json.loads(report_path.read_text(\"utf-8\"))\n    assert payload.get(\"stage\") == \"intent\"\n    assert payload.get(\"selection\", {}).get(\"stage\") == \"intent\"\n\n\ndef test_resume_with_wrong_stage_is_rejected(monkeypatch, tmp_path):\n    \"\"\"Resuming a checkpoint recorded with a different stage is rejected.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n\n    async def fake_suite(*args, **kwargs):\n        return [], [], [], None\n\n    monkeypatch.setattr(live, \"run_suite\", fake_suite)\n    monkeypatch.setattr(\"run.require_credentials\", lambda: None)\n\n    # Record a checkpoint with --stage intent\n    live.main(\n        [\"--stage\", \"intent\", \"--k\", \"1\", \"--case\", case.case_id,\n         \"--report-dir\", str(tmp_path)]\n    )\n    report_path = next(\n        path for path in tmp_path.glob(\"live-*.json\")\n        if not path.stem.endswith(\"-transcripts\")\n    )\n\n    # Trying to resume it with --stage narration must fail\n    with pytest.raises(SystemExit, match=\"recorded with --stage 'intent'\"):\n        live.main([\"--stage\", \"narration\", \"--resume\", str(report_path)])\n","numLines":508,"startLine":1,"totalLines":508}}}
