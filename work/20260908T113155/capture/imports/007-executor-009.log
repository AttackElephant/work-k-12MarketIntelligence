{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FodiKoNmW1sFNLJPMtDZoi","type":"tool_result","content":"815\t        reports, trials, transcripts, interruption = asyncio.run(\n816\t            run_suite(\n817\t                cases,\n818\t                k=args.k,\n819\t                emitter=args.emitter,\n820\t                pressure=args.pressure,\n821\t                all_phrasings=args.all_phrasings,\n822\t                initial_trials=initial_trials,\n823\t                initial_transcripts=initial_transcripts,\n824\t                max_trials=args.max_trials,\n825\t                on_progress=checkpoint,\n826\t                stage=args.stage,\n827\t            )\n828\t        )\n829\t    except CredentialsRejected as exc:\n830\t        # PF-2: tell the truth about what is on disk. `report_path` is written\n831\t        # atomically by `checkpoint()` after every completed trial, so if one or\n832\t        # more trials finished before the rejection it already exists as a\n833\t        # resumable \"running\" checkpoint and this branch leaves it byte-for-byte\n834\t        # unchanged — no final report is written over it, and the message must\n835\t        # not claim otherwise.\n836\t        if report_path.exists():\n837\t            raise SystemExit(\n838\t                f\"The provider rejected the credential, so no further case was \"\n839\t                f\"measured: {exc}\\n\"\n840\t                \"Run authcheck.py for the configured provider.\\n\"\n841\t                f\"A checkpoint from before the rejection exists: {report_path}\\n\"\n842\t                f\"resume: {sys.executable} -m evals.live --resume {report_path}\"\n843\t            ) from exc\n844\t        raise SystemExit(\n845\t            f\"The provider rejected the credential, so no case was measured: {exc}\\n\"\n846\t            \"Run authcheck.py for the configured provider. No report was written.\"\n847\t        ) from exc\n848\t\n849\t    totals = aggregate(reports, trials)\n850\t    status = \"interrupted\" if interruption else \"complete\"\n851\t    payload = payload_for(trials, transcripts, interruption, status)\n852\t    path = write_report(payload, transcripts, args.report_dir, path=report_path)\n853\t\n854\t    print(\n855\t        f\"complete cases: {len(reports)}/{len(cases)}; \"\n856\t        f\"completed trials: {len(trials)}/{len(slots)}\"\n857\t    )\n858\t    if totals[\"pass_at_k\"] is None:\n859\t        print(\"\\nno complete cases yet; aggregate model-quality scores withheld\")\n860\t    else:\n861\t        print(\n862\t            f\"\\ncomplete-case pass@{args.k}: {totals['pass_at_k']}   \"\n863\t            f\"pass^{args.k}: {totals['pass_hat_k']}\"\n864\t        )\n865\t    if settings.MODEL_PROVIDER == \"claude_account\":\n866\t        print(\"cost: account-plan usage (no per-request USD amount exposed)\")\n867\t    else:\n868\t        print(f\"cost: {totals['cost_usd']} USD (complete={totals['cost_complete']})\")\n869\t    unreliable = [r.case_id for r in reports if r.pass_hat_k < 1.0]\n870\t    if unreliable:\n871\t        print(f\"not reliable at k={args.k}: {', '.join(unreliable)}\")\n872\t    print(f\"report: {path}\")\n873\t    if interruption:\n874\t        print(f\"interrupted ({interruption.kind}): {interruption.detail}\")\n875\t        print(f\"resume: {sys.executable} -m evals.live --resume {path}\")\n876\t        return 2\n877\t    # Exit non-zero when any case is unreliable — a live run that always exits 0\n878\t    # is a run nobody reads.\n879\t    return 0 if not unreliable else 1\n880\t\n881\t\n882\tif __name__ == \"__main__\":\n883\t    raise SystemExit(main())\n884\t"}]},"parent_tool_use_id":null,"session_id":"2e8b7dde-8bb0-4345-aaad-7bcee95758ae","uuid":"f727e86c-3913-419e-bb03-e5e64f75fa5d","timestamp":"2026-09-26T10:03:46.959Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/evals/live.py","content":"        reports, trials, transcripts, interruption = asyncio.run(\n            run_suite(\n                cases,\n                k=args.k,\n                emitter=args.emitter,\n                pressure=args.pressure,\n                all_phrasings=args.all_phrasings,\n                initial_trials=initial_trials,\n                initial_transcripts=initial_transcripts,\n                max_trials=args.max_trials,\n                on_progress=checkpoint,\n                stage=args.stage,\n            )\n        )\n    except CredentialsRejected as exc:\n        # PF-2: tell the truth about what is on disk. `report_path` is written\n        # atomically by `checkpoint()` after every completed trial, so if one or\n        # more trials finished before the rejection it already exists as a\n        # resumable \"running\" checkpoint and this branch leaves it byte-for-byte\n        # unchanged — no final report is written over it, and the message must\n        # not claim otherwise.\n        if report_path.exists():\n            raise SystemExit(\n                f\"The provider rejected the credential, so no further case was \"\n                f\"measured: {exc}\\n\"\n                \"Run authcheck.py for the configured provider.\\n\"\n                f\"A checkpoint from before the rejection exists: {report_path}\\n\"\n                f\"resume: {sys.executable} -m evals.live --resume {report_path}\"\n            ) from exc\n        raise SystemExit(\n            f\"The provider rejected the credential, so no case was measured: {exc}\\n\"\n            \"Run authcheck.py for the configured provider. No report was written.\"\n        ) from exc\n\n    totals = aggregate(reports, trials)\n    status = \"interrupted\" if interruption else \"complete\"\n    payload = payload_for(trials, transcripts, interruption, status)\n    path = write_report(payload, transcripts, args.report_dir, path=report_path)\n\n    print(\n        f\"complete cases: {len(reports)}/{len(cases)}; \"\n        f\"completed trials: {len(trials)}/{len(slots)}\"\n    )\n    if totals[\"pass_at_k\"] is None:\n        print(\"\\nno complete cases yet; aggregate model-quality scores withheld\")\n    else:\n        print(\n            f\"\\ncomplete-case pass@{args.k}: {totals['pass_at_k']}   \"\n            f\"pass^{args.k}: {totals['pass_hat_k']}\"\n        )\n    if settings.MODEL_PROVIDER == \"claude_account\":\n        print(\"cost: account-plan usage (no per-request USD amount exposed)\")\n    else:\n        print(f\"cost: {totals['cost_usd']} USD (complete={totals['cost_complete']})\")\n    unreliable = [r.case_id for r in reports if r.pass_hat_k < 1.0]\n    if unreliable:\n        print(f\"not reliable at k={args.k}: {', '.join(unreliable)}\")\n    print(f\"report: {path}\")\n    if interruption:\n        print(f\"interrupted ({interruption.kind}): {interruption.detail}\")\n        print(f\"resume: {sys.executable} -m evals.live --resume {path}\")\n        return 2\n    # Exit non-zero when any case is unreliable — a live run that always exits 0\n    # is a run nobody reads.\n    return 0 if not unreliable else 1\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","numLines":70,"startLine":815,"totalLines":884}}}
