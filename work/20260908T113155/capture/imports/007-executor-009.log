{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EM9CdmPvMkHi3DpUv4ZaDX","type":"tool_result","content":"754\tdef test_resume_with_wrong_stage_is_rejected(monkeypatch, tmp_path):\n755\t    \"\"\"Resuming a checkpoint recorded with a different stage is rejected.\"\"\"\n756\t    case = CASES[\"answer/VC-POC-01\"]\n757\t\n758\t    async def fake_suite(*args, **kwargs):\n759\t        return [], [], [], None\n760\t\n761\t    monkeypatch.setattr(live, \"run_suite\", fake_suite)\n762\t    monkeypatch.setattr(\"run.require_credentials\", lambda: None)\n763\t\n764\t    # Record a checkpoint with --stage intent\n765\t    live.main(\n766\t        [\"--stage\", \"intent\", \"--k\", \"1\", \"--case\", case.case_id,\n767\t         \"--report-dir\", str(tmp_path)]\n768\t    )\n769\t    report_path = next(\n770\t        path for path in tmp_path.glob(\"live-*.json\")\n771\t        if not path.stem.endswith(\"-transcripts\")\n772\t    )\n773\t\n774\t    # Trying to resume it with --stage narration must fail\n775\t    with pytest.raises(SystemExit, match=\"recorded with --stage 'intent'\"):\n776\t        live.main([\"--stage\", \"narration\", \"--resume\", str(report_path)])\n777\t"}]},"parent_tool_use_id":null,"session_id":"2e8b7dde-8bb0-4345-aaad-7bcee95758ae","uuid":"41055e24-0bb0-4e92-9491-10758bff9db7","timestamp":"2026-09-26T10:05:10.091Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/tests/unit/test_live_tier.py","content":"def test_resume_with_wrong_stage_is_rejected(monkeypatch, tmp_path):\n    \"\"\"Resuming a checkpoint recorded with a different stage is rejected.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n\n    async def fake_suite(*args, **kwargs):\n        return [], [], [], None\n\n    monkeypatch.setattr(live, \"run_suite\", fake_suite)\n    monkeypatch.setattr(\"run.require_credentials\", lambda: None)\n\n    # Record a checkpoint with --stage intent\n    live.main(\n        [\"--stage\", \"intent\", \"--k\", \"1\", \"--case\", case.case_id,\n         \"--report-dir\", str(tmp_path)]\n    )\n    report_path = next(\n        path for path in tmp_path.glob(\"live-*.json\")\n        if not path.stem.endswith(\"-transcripts\")\n    )\n\n    # Trying to resume it with --stage narration must fail\n    with pytest.raises(SystemExit, match=\"recorded with --stage 'intent'\"):\n        live.main([\"--stage\", \"narration\", \"--resume\", str(report_path)])\n","numLines":24,"startLine":754,"totalLines":777}}}
