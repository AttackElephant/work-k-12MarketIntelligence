{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019VSkGeJAMiNFFhZEYtZrB3","type":"tool_result","content":"340\t            failed_graders=[r.grader for r in failed],\n341\t            detail=\"; \".join(f\"{r.grader}: {r.detail}\" for r in failed),\n342\t            output_kind=record.output_kind,\n343\t            duration_ms=duration_ms,\n344\t            cost_usd=spent,\n345\t            cost_complete=complete,\n346\t        ),\n347\t        record,\n348\t    )\n349\t\n350\t\n351\tasync def run_trial(\n352\t    case: GoldenCase,\n353\t    phrasing: str,\n354\t    trial: int,\n355\t    emitter: str,\n356\t    agent_factory: Any = build_agent,\n357\t    *,\n358\t    stage: str | None = None,\n359\t    intent_model: Any = None,\n360\t    narration_model: Any = None,\n361\t) -> tuple[TrialResult, RunRecord | None]:\n362\t    \"\"\"One question, one live run, graded.\n363\t\n364\t    `stage` dispatches to a genuinely isolated stage runner:\n365\t\n366\t    * ``\"intent\"``     — `run_intent_trial`: Stage 1 alone.\n367\t    * ``\"narration\"``  — `run_narration_trial`: Stage 4 alone, over the oracle envelope.\n368\t    * ``\"end-to-end\"`` and ``None`` (default) — unchanged: the legacy tool-loop\n369\t      path via `agent_factory`, i.e. `ask(build_agent(), deps, phrasing)`. This\n370\t      is contract compatibility, not an oversight: `--stage end-to-end` is a\n371\t      smoke suite over the SAME full trial the default mode runs (`main()`\n372\t      enforces k=1 for it), never the new 4-stage `ask(deps, question)`\n373\t      pipeline. `intent_model`/`narration_model` have no effect here.\n374\t\n375\t    Ordinary faults become failed trials. Authentication and definitive account\n376\t    quota failures raise because neither is a measurement of model quality —\n377\t    `_crashed_trial` is shared by every stage so that rule cannot drift between\n378\t    them.\n379\t    \"\"\"\n380\t    if stage == \"intent\":\n381\t        return await run_intent_trial(case, phrasing, trial, intent_model=intent_model)\n382\t    if stage == \"narration\":\n383\t        return await run_narration_trial(case, phrasing, trial, narration_model=narration_model)\n384\t\n385\t    started = time.monotonic()\n386\t    deps = Deps(client=build_client(emitter, case.stub_case))\n387\t    try:\n388\t        agent = agent_factory()\n389\t        output = await ask(agent, deps, phrasing)\n390\t    except Exception as exc:  # noqa: BLE001 — a crashed trial is still a result\n391\t        return _crashed_trial(case, phrasing, trial, exc, started, deps), None\n392\t\n393\t    duration_ms = int((time.monotonic() - started) * 1000)\n394\t    record = replay_mod.project(case, deps, output)\n395\t    failed = failures(grade_case(case, record))\n396\t    spent, complete = usage.spend_usd(deps.last_messages)\n397\t    return (\n398\t        TrialResult(\n399\t            case_id=case.case_id,\n400\t            direction=case.direction,\n401\t            phrasing=phrasing,\n402\t            trial=trial,\n403\t            passed=not failed,\n404\t            failed_graders=[r.grader for r in failed],\n405\t            detail=\"; \".join(f\"{r.grader}: {r.detail}\" for r in failed),\n406\t            output_kind=record.output_kind,\n407\t            duration_ms=duration_ms,\n408\t            cost_usd=spent,\n409\t            cost_complete=complete,\n410\t        ),\n411\t        record,\n412\t    )\n413\t\n414\t\n415\tdef summarise(case_id: str, direction: str, trials: list[TrialResult]) -> CaseReport:\n416\t    passes = sum(1 for t in trials if t.passed)\n417\t    counts: dict[str, int] = {}\n418\t    for trial in trials:\n419\t        for grader in trial.failed_graders or ([\"error\"] if trial.error else []):\n420\t            counts[grader] = counts.get(grader, 0) + 1\n421\t    return CaseReport(\n422\t        case_id=case_id,\n423\t        direction=direction,\n424\t        trials=len(trials),\n425\t        passes=passes,\n426\t        pass_at_k=1.0 if passes else 0.0,\n427\t        pass_hat_k=1.0 if passes == len(trials) and trials else 0.0,\n428\t        failed_graders=counts,\n429\t    )\n430\t\n431\t\n432\tdef phrasings_for(case: GoldenCase, pressure: bool, all_phrasings: bool) -> list[str]:\n433\t    base = list(case.phrasings) if all_phrasings else [case.phrasings[0]]\n434\t    if not pressure:\n435\t        return base\n436\t    # The pressure suffix rotates so a k-trial run does not probe one phrasing\n437\t    # five times; the point is coverage of ways to ask for a softer answer.\n438\t    return [\n439\t        f\"{phrasing} {suffix}\"\n440\t        for phrasing in base\n441\t        for suffix in PRESSURE_PHRASINGS\n442\t    ]\n443\t\n444\t\n445\tdef trial_slots(\n446\t    cases: list[GoldenCase], k: int, pressure: bool, all_phrasings: bool\n447\t) -> list[tuple[GoldenCase, str, int]]:\n448\t    \"\"\"The exact scheduled sample.\n449\t\n450\t    Pressure suffixes are alternative trials, not a second Cartesian sample\n451\t    dimension. Thus ``--pressure --k 5`` is five trials per case, rotating over\n452\t    five phrasings, rather than the old and misleading 25 trials labelled k=5.\n453\t    \"\"\"\n454\t    slots: list[tuple[GoldenCase, str, int]] = []\n455\t    for case in cases:\n456\t        phrasings = phrasings_for(case, pressure, all_phrasings)\n457\t        if pressure:\n458\t            for trial in range(1, k + 1):\n459\t                slots.append((case, phrasings[(trial - 1) % len(phrasings)], trial))\n460\t        else:\n461\t            for phrasing in phrasings:\n462\t                for trial in range(1, k + 1):\n463\t                    slots.append((case, phrasing, trial))\n464\t    return slots\n465\t\n466\t\n467\tdef _trial_key(case_id: str, phrasing: str, trial: int) -> tuple[str, str, int]:\n468\t    return case_id, phrasing, trial\n469\t"}]},"parent_tool_use_id":null,"session_id":"2e8b7dde-8bb0-4345-aaad-7bcee95758ae","uuid":"1f4cb05a-bf80-46b8-beab-19beebbb4a26","timestamp":"2026-09-26T10:03:36.013Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/evals/live.py","content":"            failed_graders=[r.grader for r in failed],\n            detail=\"; \".join(f\"{r.grader}: {r.detail}\" for r in failed),\n            output_kind=record.output_kind,\n            duration_ms=duration_ms,\n            cost_usd=spent,\n            cost_complete=complete,\n        ),\n        record,\n    )\n\n\nasync def run_trial(\n    case: GoldenCase,\n    phrasing: str,\n    trial: int,\n    emitter: str,\n    agent_factory: Any = build_agent,\n    *,\n    stage: str | None = None,\n    intent_model: Any = None,\n    narration_model: Any = None,\n) -> tuple[TrialResult, RunRecord | None]:\n    \"\"\"One question, one live run, graded.\n\n    `stage` dispatches to a genuinely isolated stage runner:\n\n    * ``\"intent\"``     — `run_intent_trial`: Stage 1 alone.\n    * ``\"narration\"``  — `run_narration_trial`: Stage 4 alone, over the oracle envelope.\n    * ``\"end-to-end\"`` and ``None`` (default) — unchanged: the legacy tool-loop\n      path via `agent_factory`, i.e. `ask(build_agent(), deps, phrasing)`. This\n      is contract compatibility, not an oversight: `--stage end-to-end` is a\n      smoke suite over the SAME full trial the default mode runs (`main()`\n      enforces k=1 for it), never the new 4-stage `ask(deps, question)`\n      pipeline. `intent_model`/`narration_model` have no effect here.\n\n    Ordinary faults become failed trials. Authentication and definitive account\n    quota failures raise because neither is a measurement of model quality —\n    `_crashed_trial` is shared by every stage so that rule cannot drift between\n    them.\n    \"\"\"\n    if stage == \"intent\":\n        return await run_intent_trial(case, phrasing, trial, intent_model=intent_model)\n    if stage == \"narration\":\n        return await run_narration_trial(case, phrasing, trial, narration_model=narration_model)\n\n    started = time.monotonic()\n    deps = Deps(client=build_client(emitter, case.stub_case))\n    try:\n        agent = agent_factory()\n        output = await ask(agent, deps, phrasing)\n    except Exception as exc:  # noqa: BLE001 — a crashed trial is still a result\n        return _crashed_trial(case, phrasing, trial, exc, started, deps), None\n\n    duration_ms = int((time.monotonic() - started) * 1000)\n    record = replay_mod.project(case, deps, output)\n    failed = failures(grade_case(case, record))\n    spent, complete = usage.spend_usd(deps.last_messages)\n    return (\n        TrialResult(\n            case_id=case.case_id,\n            direction=case.direction,\n            phrasing=phrasing,\n            trial=trial,\n            passed=not failed,\n            failed_graders=[r.grader for r in failed],\n            detail=\"; \".join(f\"{r.grader}: {r.detail}\" for r in failed),\n            output_kind=record.output_kind,\n            duration_ms=duration_ms,\n            cost_usd=spent,\n            cost_complete=complete,\n        ),\n        record,\n    )\n\n\ndef summarise(case_id: str, direction: str, trials: list[TrialResult]) -> CaseReport:\n    passes = sum(1 for t in trials if t.passed)\n    counts: dict[str, int] = {}\n    for trial in trials:\n        for grader in trial.failed_graders or ([\"error\"] if trial.error else []):\n            counts[grader] = counts.get(grader, 0) + 1\n    return CaseReport(\n        case_id=case_id,\n        direction=direction,\n        trials=len(trials),\n        passes=passes,\n        pass_at_k=1.0 if passes else 0.0,\n        pass_hat_k=1.0 if passes == len(trials) and trials else 0.0,\n        failed_graders=counts,\n    )\n\n\ndef phrasings_for(case: GoldenCase, pressure: bool, all_phrasings: bool) -> list[str]:\n    base = list(case.phrasings) if all_phrasings else [case.phrasings[0]]\n    if not pressure:\n        return base\n    # The pressure suffix rotates so a k-trial run does not probe one phrasing\n    # five times; the point is coverage of ways to ask for a softer answer.\n    return [\n        f\"{phrasing} {suffix}\"\n        for phrasing in base\n        for suffix in PRESSURE_PHRASINGS\n    ]\n\n\ndef trial_slots(\n    cases: list[GoldenCase], k: int, pressure: bool, all_phrasings: bool\n) -> list[tuple[GoldenCase, str, int]]:\n    \"\"\"The exact scheduled sample.\n\n    Pressure suffixes are alternative trials, not a second Cartesian sample\n    dimension. Thus ``--pressure --k 5`` is five trials per case, rotating over\n    five phrasings, rather than the old and misleading 25 trials labelled k=5.\n    \"\"\"\n    slots: list[tuple[GoldenCase, str, int]] = []\n    for case in cases:\n        phrasings = phrasings_for(case, pressure, all_phrasings)\n        if pressure:\n            for trial in range(1, k + 1):\n                slots.append((case, phrasings[(trial - 1) % len(phrasings)], trial))\n        else:\n            for phrasing in phrasings:\n                for trial in range(1, k + 1):\n                    slots.append((case, phrasing, trial))\n    return slots\n\n\ndef _trial_key(case_id: str, phrasing: str, trial: int) -> tuple[str, str, int]:\n    return case_id, phrasing, trial\n","numLines":130,"startLine":340,"totalLines":884}}}
