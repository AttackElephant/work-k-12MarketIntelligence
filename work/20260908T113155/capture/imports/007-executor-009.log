{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CxwK6d1tJVoVzy7cLrXQ4B","type":"tool_result","content":"1\t\"\"\"Harness error hierarchy + SDK exception classifier.\n2\t\n3\tThe classes carry the *retry semantics* (``retryable``) that the single retry\n4\towner (``harness.retry``) and the structured logger key off: Tenacity retries\n5\t``TransientError`` and never ``TerminalError``/``AuthError``.\n6\t\n7\t``classify()`` maps transport exceptions into this hierarchy. Both wrappers are\n8\thandled, and that distinction is load-bearing:\n9\t\n10\t* **Anthropic SDK exceptions** — raised when the harness calls the SDK directly.\n11\t* **PydanticAI's ``ModelHTTPError``** — what a *run through the agent* actually\n12\t  raises. PydanticAI catches the SDK's own exception and re-raises its own type,\n13\t  so a classifier that only knew the SDK's classes returned ``None`` for every\n14\t  live failure: no 429 was ever retried, no 401 ever failed fast, and the whole\n15\t  of ADR-003 was inert on the one path that matters. Found on M4's first live\n16\t  run (a 401 replayed as 100 \"failed trials\"); both are now routed by status\n17\t  code through the same table.\n18\t\n19\t``anthropic`` and ``pydantic_ai`` are imported lazily so this module stays\n20\timportable — and unit-testable — without either, and so an *unrecognised*\n21\texception is never silently swallowed as transient: it is returned as ``None``\n22\tfor the caller to re-raise unchanged (local bugs must surface, not masquerade\n23\tas a service blip).\n24\t\"\"\"\n25\t\n26\tfrom __future__ import annotations\n27\t\n28\t\n29\tclass HarnessError(Exception):\n30\t    \"\"\"Base for all harness-classified errors. Not retryable by default.\"\"\"\n31\t\n32\t    retryable: bool = False\n33\t\n34\t    def __init__(\n35\t        self,\n36\t        message: str = \"\",\n37\t        *,\n38\t        status_code: int | None = None,\n39\t        request_id: str | None = None,\n40\t        retry_after: float | None = None,\n41\t    ) -> None:\n42\t        super().__init__(message)\n43\t        self.status_code = status_code\n44\t        self.request_id = request_id\n45\t        self.retry_after = retry_after\n46\t\n47\t\n48\tclass TransientError(HarnessError):\n49\t    \"\"\"Retry-eligible: 429, 5xx, connection reset, timeout.\"\"\"\n50\t\n51\t    retryable = True\n52\t\n53\t\n54\tclass TerminalError(HarnessError):\n55\t    \"\"\"Never retry: 400, 403, invalid input.\"\"\"\n56\t\n57\t    retryable = False\n58\t\n59\t\n60\tclass AuthError(TerminalError):\n61\t    \"\"\"Never retry: 401, credential/OAuth refresh failure.\"\"\"\n62\t\n63\t    retryable = False\n64\t\n65\t\n66\tclass QuotaExceeded(TerminalError):\n67\t    \"\"\"A provider account/session allowance is exhausted until a reset.\n68\t\n69\t    This is deliberately distinct from an ordinary retryable 429. Retrying a\n70\t    session-limit response cannot succeed before the provider's reset and can\n71\t    otherwise turn one unavailable account into hundreds of bogus eval misses.\n72\t    \"\"\"\n73\t\n74\t    retryable = False\n75\t\n76\t    def __init__(\n77\t        self,\n78\t        message: str,\n79\t        *,\n80\t        provider: str,\n81\t        reset_at: str | None = None,\n82\t        status_code: int = 429,\n83\t    ) -> None:\n84\t        super().__init__(message, status_code=status_code)\n85\t        self.provider = provider\n86\t        self.reset_at = reset_at\n87\t\n88\t\n89\tclass RemoteAPIError(HarnessError):\n90\t    \"\"\"Generic HTTP protocol failure from any remote API.\n91\t\n92\t    Carries the documented protocol fields. The classifier returns the\n93\t    retry-semantic subclasses above (so Tenacity can route on type); this stays\n94\t    in the hierarchy for callers that raise a protocol error directly.\n95\t    \"\"\"\n96\t\n97\t\n98\tdef _retry_after_seconds(exc: object) -> float | None:\n99\t    \"\"\"Best-effort parse of a Retry-After header off an SDK exception.\"\"\"\n100\t    response = getattr(exc, \"response\", None)\n101\t    headers = getattr(response, \"headers\", None)\n102\t    if headers is None:\n103\t        return None\n104\t    value = headers.get(\"retry-after\")\n105\t    if value is None:\n106\t        return None\n107\t    try:\n108\t        return float(value)\n109\t    except (TypeError, ValueError):\n110\t        # HTTP-date form (rare from Anthropic); fall back to backoff schedule.\n111\t        return None\n112\t\n113\t\n114\tdef _by_status(\n115\t    status_code: int | None,\n116\t    message: str,\n117\t    request_id: str | None,\n118\t    exc: BaseException,\n119\t) -> HarnessError:\n120\t    \"\"\"The one status-code routing table, shared by every transport wrapper.\n121\t\n122\t    One table, not one per library: a second copy is how a wrapper gets added\n123\t    and quietly routes nothing.\n124\t    \"\"\"\n125\t    if status_code is not None and status_code >= 500:\n126\t        return TransientError(message, status_code=status_code, request_id=request_id)\n127\t    if status_code == 429:\n128\t        return TransientError(\n129\t            message,\n130\t            status_code=status_code,\n131\t            request_id=request_id,\n132\t            retry_after=_retry_after_seconds(exc),\n133\t        )\n134\t    if status_code == 401:\n135\t        return AuthError(message, status_code=status_code, request_id=request_id)\n136\t    return TerminalError(message, status_code=status_code, request_id=request_id)\n137\t\n138\t\n139\tdef classify(exc: BaseException) -> HarnessError | None:\n140\t    \"\"\"Map a raw exception to the harness hierarchy, or None if unrecognised.\n141\t\n142\t    Returning None (rather than a TransientError) for unknown exceptions is\n143\t    deliberate: the retry owner re-raises them unchanged so local bugs are not\n144\t    masked as retryable transport faults.\n145\t    \"\"\"\n146\t    if isinstance(exc, HarnessError):\n147\t        return exc\n148\t\n149\t    status_code = getattr(exc, \"status_code\", None)\n150\t    request_id = getattr(exc, \"request_id\", None)\n151\t    message = str(exc)\n152\t\n153\t    # PydanticAI's wrapper. Checked FIRST and independently of the SDK import:\n154\t    # this is the type a real `agent.run()` raises, so it must classify even in\n155\t    # an environment where `anthropic` is absent. It carries `status_code` but\n156\t    # no response object, so a 429 falls back to the jittered backoff schedule\n157\t    # rather than an honoured Retry-After.\n158\t    try:\n159\t        from pydantic_ai.exceptions import ModelHTTPError\n160\t    except ImportError:\n161\t        pass\n162\t    else:\n163\t        if isinstance(exc, ModelHTTPError):\n164\t            return _by_status(status_code, message, request_id, exc)\n165\t\n166\t    try:\n167\t        import anthropic\n168\t    except ImportError:\n169\t        return None\n170\t\n171\t    # Connection/timeout faults carry no HTTP status. APITimeoutError subclasses\n172\t    # APIConnectionError, so the one check covers both.\n173\t    if isinstance(exc, anthropic.APIConnectionError):\n174\t        return TransientError(message or \"connection error\", request_id=request_id)\n175\t\n176\t    # Specific status errors first — each subclasses APIStatusError, so they must\n177\t    # be checked before the generic fallback below.\n178\t    if isinstance(exc, anthropic.RateLimitError):  # 429\n179\t        return TransientError(\n180\t            message,\n181\t            status_code=status_code,\n182\t            request_id=request_id,\n183\t            retry_after=_retry_after_seconds(exc),\n184\t        )\n185\t    if isinstance(exc, anthropic.InternalServerError):  # 5xx\n186\t        return TransientError(message, status_code=status_code, request_id=request_id)\n187\t    if isinstance(exc, anthropic.AuthenticationError):  # 401\n188\t        return AuthError(message, status_code=status_code, request_id=request_id)\n189\t    if isinstance(exc, anthropic.PermissionDeniedError):  # 403\n190\t        return TerminalError(message, status_code=status_code, request_id=request_id)\n191\t    if isinstance(exc, anthropic.BadRequestError):  # 400\n192\t        return TerminalError(message, status_code=status_code, request_id=request_id)\n193\t\n194\t    # Generic HTTP status error: route by code (covers 404/409/422/5xx variants).\n195\t    if isinstance(exc, anthropic.APIStatusError):\n196\t        return _by_status(status_code, message, request_id, exc)\n197\t\n198\t    return None\n199\t"}]},"parent_tool_use_id":null,"session_id":"2e8b7dde-8bb0-4345-aaad-7bcee95758ae","uuid":"0ba1feaf-19fa-4bdb-aa1c-074e29dd8297","timestamp":"2026-09-26T09:59:54.960Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/harness/errors.py","content":"\"\"\"Harness error hierarchy + SDK exception classifier.\n\nThe classes carry the *retry semantics* (``retryable``) that the single retry\nowner (``harness.retry``) and the structured logger key off: Tenacity retries\n``TransientError`` and never ``TerminalError``/``AuthError``.\n\n``classify()`` maps transport exceptions into this hierarchy. Both wrappers are\nhandled, and that distinction is load-bearing:\n\n* **Anthropic SDK exceptions** — raised when the harness calls the SDK directly.\n* **PydanticAI's ``ModelHTTPError``** — what a *run through the agent* actually\n  raises. PydanticAI catches the SDK's own exception and re-raises its own type,\n  so a classifier that only knew the SDK's classes returned ``None`` for every\n  live failure: no 429 was ever retried, no 401 ever failed fast, and the whole\n  of ADR-003 was inert on the one path that matters. Found on M4's first live\n  run (a 401 replayed as 100 \"failed trials\"); both are now routed by status\n  code through the same table.\n\n``anthropic`` and ``pydantic_ai`` are imported lazily so this module stays\nimportable — and unit-testable — without either, and so an *unrecognised*\nexception is never silently swallowed as transient: it is returned as ``None``\nfor the caller to re-raise unchanged (local bugs must surface, not masquerade\nas a service blip).\n\"\"\"\n\nfrom __future__ import annotations\n\n\nclass HarnessError(Exception):\n    \"\"\"Base for all harness-classified errors. Not retryable by default.\"\"\"\n\n    retryable: bool = False\n\n    def __init__(\n        self,\n        message: str = \"\",\n        *,\n        status_code: int | None = None,\n        request_id: str | None = None,\n        retry_after: float | None = None,\n    ) -> None:\n        super().__init__(message)\n        self.status_code = status_code\n        self.request_id = request_id\n        self.retry_after = retry_after\n\n\nclass TransientError(HarnessError):\n    \"\"\"Retry-eligible: 429, 5xx, connection reset, timeout.\"\"\"\n\n    retryable = True\n\n\nclass TerminalError(HarnessError):\n    \"\"\"Never retry: 400, 403, invalid input.\"\"\"\n\n    retryable = False\n\n\nclass AuthError(TerminalError):\n    \"\"\"Never retry: 401, credential/OAuth refresh failure.\"\"\"\n\n    retryable = False\n\n\nclass QuotaExceeded(TerminalError):\n    \"\"\"A provider account/session allowance is exhausted until a reset.\n\n    This is deliberately distinct from an ordinary retryable 429. Retrying a\n    session-limit response cannot succeed before the provider's reset and can\n    otherwise turn one unavailable account into hundreds of bogus eval misses.\n    \"\"\"\n\n    retryable = False\n\n    def __init__(\n        self,\n        message: str,\n        *,\n        provider: str,\n        reset_at: str | None = None,\n        status_code: int = 429,\n    ) -> None:\n        super().__init__(message, status_code=status_code)\n        self.provider = provider\n        self.reset_at = reset_at\n\n\nclass RemoteAPIError(HarnessError):\n    \"\"\"Generic HTTP protocol failure from any remote API.\n\n    Carries the documented protocol fields. The classifier returns the\n    retry-semantic subclasses above (so Tenacity can route on type); this stays\n    in the hierarchy for callers that raise a protocol error directly.\n    \"\"\"\n\n\ndef _retry_after_seconds(exc: object) -> float | None:\n    \"\"\"Best-effort parse of a Retry-After header off an SDK exception.\"\"\"\n    response = getattr(exc, \"response\", None)\n    headers = getattr(response, \"headers\", None)\n    if headers is None:\n        return None\n    value = headers.get(\"retry-after\")\n    if value is None:\n        return None\n    try:\n        return float(value)\n    except (TypeError, ValueError):\n        # HTTP-date form (rare from Anthropic); fall back to backoff schedule.\n        return None\n\n\ndef _by_status(\n    status_code: int | None,\n    message: str,\n    request_id: str | None,\n    exc: BaseException,\n) -> HarnessError:\n    \"\"\"The one status-code routing table, shared by every transport wrapper.\n\n    One table, not one per library: a second copy is how a wrapper gets added\n    and quietly routes nothing.\n    \"\"\"\n    if status_code is not None and status_code >= 500:\n        return TransientError(message, status_code=status_code, request_id=request_id)\n    if status_code == 429:\n        return TransientError(\n            message,\n            status_code=status_code,\n            request_id=request_id,\n            retry_after=_retry_after_seconds(exc),\n        )\n    if status_code == 401:\n        return AuthError(message, status_code=status_code, request_id=request_id)\n    return TerminalError(message, status_code=status_code, request_id=request_id)\n\n\ndef classify(exc: BaseException) -> HarnessError | None:\n    \"\"\"Map a raw exception to the harness hierarchy, or None if unrecognised.\n\n    Returning None (rather than a TransientError) for unknown exceptions is\n    deliberate: the retry owner re-raises them unchanged so local bugs are not\n    masked as retryable transport faults.\n    \"\"\"\n    if isinstance(exc, HarnessError):\n        return exc\n\n    status_code = getattr(exc, \"status_code\", None)\n    request_id = getattr(exc, \"request_id\", None)\n    message = str(exc)\n\n    # PydanticAI's wrapper. Checked FIRST and independently of the SDK import:\n    # this is the type a real `agent.run()` raises, so it must classify even in\n    # an environment where `anthropic` is absent. It carries `status_code` but\n    # no response object, so a 429 falls back to the jittered backoff schedule\n    # rather than an honoured Retry-After.\n    try:\n        from pydantic_ai.exceptions import ModelHTTPError\n    except ImportError:\n        pass\n    else:\n        if isinstance(exc, ModelHTTPError):\n            return _by_status(status_code, message, request_id, exc)\n\n    try:\n        import anthropic\n    except ImportError:\n        return None\n\n    # Connection/timeout faults carry no HTTP status. APITimeoutError subclasses\n    # APIConnectionError, so the one check covers both.\n    if isinstance(exc, anthropic.APIConnectionError):\n        return TransientError(message or \"connection error\", request_id=request_id)\n\n    # Specific status errors first — each subclasses APIStatusError, so they must\n    # be checked before the generic fallback below.\n    if isinstance(exc, anthropic.RateLimitError):  # 429\n        return TransientError(\n            message,\n            status_code=status_code,\n            request_id=request_id,\n            retry_after=_retry_after_seconds(exc),\n        )\n    if isinstance(exc, anthropic.InternalServerError):  # 5xx\n        return TransientError(message, status_code=status_code, request_id=request_id)\n    if isinstance(exc, anthropic.AuthenticationError):  # 401\n        return AuthError(message, status_code=status_code, request_id=request_id)\n    if isinstance(exc, anthropic.PermissionDeniedError):  # 403\n        return TerminalError(message, status_code=status_code, request_id=request_id)\n    if isinstance(exc, anthropic.BadRequestError):  # 400\n        return TerminalError(message, status_code=status_code, request_id=request_id)\n\n    # Generic HTTP status error: route by code (covers 404/409/422/5xx variants).\n    if isinstance(exc, anthropic.APIStatusError):\n        return _by_status(status_code, message, request_id, exc)\n\n    return None\n","numLines":199,"startLine":1,"totalLines":199}}}
