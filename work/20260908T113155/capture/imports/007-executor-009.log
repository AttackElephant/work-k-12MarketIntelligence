{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Kk1VnZuFrrHzBcJ56jzxVq","type":"tool_result","content":"655\t    fixed question/request — every eligible case in the current golden set\n656\t    happens to carry both, but the primary gate is `stub_case`.\"\"\"\n657\t    args = live.build_parser().parse_args([\"--stage\", \"narration\"])\n658\t    selected = live.select_cases(args)\n659\t    assert selected\n660\t    assert all(c.stub_case is not None for c in selected)\n661\t    assert all(c.expected_question_id and c.expected_request is not None for c in selected)\n662\t    assert \"clarify/distance_km\" not in {c.case_id for c in selected}\n663\t    assert \"refuse/finance\" not in {c.case_id for c in selected}\n664\t\n665\t\n666\tdef test_select_cases_for_narration_stage_prints_the_excluded_count(capsys):\n667\t    args = live.build_parser().parse_args([\"--stage\", \"narration\"])\n668\t    all_cases = live.build_parser().parse_args([])\n669\t    total = len(live.select_cases(all_cases))\n670\t    selected = live.select_cases(args)\n671\t    excluded = total - len(selected)\n672\t    out = capsys.readouterr().out\n673\t    assert f\"excluded {excluded} case(s)\" in out\n674\t\n675\t\n676\tdef test_select_cases_for_narration_stage_exits_non_zero_when_nothing_is_eligible():\n677\t    \"\"\"Every case that direction/case filters could select has no stub_case, so\n678\t    the narration selection ends up empty and the run must fail loudly rather\n679\t    than silently reporting an empty success.\"\"\"\n680\t    args = live.build_parser().parse_args(\n681\t        [\"--stage\", \"narration\", \"--direction\", \"should_clarify\"]\n682\t    )\n683\t    with pytest.raises(SystemExit, match=\"no cases selected\"):\n684\t        live.select_cases(args)\n685\t\n686\t\n687\tdef test_stage_narration_with_emitter_real_is_refused_at_argument_validation():\n688\t    \"\"\"PF-1: the narration oracle is always the stub emitter; --emitter real is\n689\t    refused up front rather than silently ignored.\"\"\"\n690\t    with pytest.raises(SystemExit, match=\"--stage narration is defined over the stub oracle\"):\n691\t        live.main([\"--stage\", \"narration\", \"--emitter\", \"real\"])\n692\t\n693\t\n694\t# --------------------------------------------------------------------------"}]},"parent_tool_use_id":null,"session_id":"2e8b7dde-8bb0-4345-aaad-7bcee95758ae","uuid":"b1c0a86a-649e-4026-9bd3-d6417e852fce","timestamp":"2026-09-26T10:05:56.012Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/tests/unit/test_live_tier.py","content":"    fixed question/request — every eligible case in the current golden set\n    happens to carry both, but the primary gate is `stub_case`.\"\"\"\n    args = live.build_parser().parse_args([\"--stage\", \"narration\"])\n    selected = live.select_cases(args)\n    assert selected\n    assert all(c.stub_case is not None for c in selected)\n    assert all(c.expected_question_id and c.expected_request is not None for c in selected)\n    assert \"clarify/distance_km\" not in {c.case_id for c in selected}\n    assert \"refuse/finance\" not in {c.case_id for c in selected}\n\n\ndef test_select_cases_for_narration_stage_prints_the_excluded_count(capsys):\n    args = live.build_parser().parse_args([\"--stage\", \"narration\"])\n    all_cases = live.build_parser().parse_args([])\n    total = len(live.select_cases(all_cases))\n    selected = live.select_cases(args)\n    excluded = total - len(selected)\n    out = capsys.readouterr().out\n    assert f\"excluded {excluded} case(s)\" in out\n\n\ndef test_select_cases_for_narration_stage_exits_non_zero_when_nothing_is_eligible():\n    \"\"\"Every case that direction/case filters could select has no stub_case, so\n    the narration selection ends up empty and the run must fail loudly rather\n    than silently reporting an empty success.\"\"\"\n    args = live.build_parser().parse_args(\n        [\"--stage\", \"narration\", \"--direction\", \"should_clarify\"]\n    )\n    with pytest.raises(SystemExit, match=\"no cases selected\"):\n        live.select_cases(args)\n\n\ndef test_stage_narration_with_emitter_real_is_refused_at_argument_validation():\n    \"\"\"PF-1: the narration oracle is always the stub emitter; --emitter real is\n    refused up front rather than silently ignored.\"\"\"\n    with pytest.raises(SystemExit, match=\"--stage narration is defined over the stub oracle\"):\n        live.main([\"--stage\", \"narration\", \"--emitter\", \"real\"])\n\n\n# --------------------------------------------------------------------------","numLines":40,"startLine":655,"totalLines":989}}}
