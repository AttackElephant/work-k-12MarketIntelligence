{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K3vWF2DmU7zgsqtQHrWS5f","type":"tool_result","content":"838\t    with pytest.raises(SystemExit) as excinfo:\n839\t        live.main(argv)\n840\t    message = str(excinfo.value)\n841\t    assert \"No report was written\" not in message\n842\t    assert \"checkpoint from before the rejection exists\" in message.lower()\n843\t    assert \"resume:\" in message.lower()\n844\t\n845\t    report_path = next(\n846\t        path for path in tmp_path.glob(\"live-*.json\") if not path.stem.endswith(\"-transcripts\")\n847\t    )\n848\t    checkpoint = json.loads(report_path.read_text(\"utf-8\"))\n849\t    assert checkpoint[\"status\"] == \"running\"\n850\t    assert checkpoint[\"completed_trials\"] == 1\n851\t    assert str(report_path) in message\n852\t\n853\t\n854\t# --------------------------------------------------------------------------\n855\t# PF-3: the isolation test is falsifiable — spies prove no cross-stage call\n856\t# happens, not just that the score came out right.\n857\t# --------------------------------------------------------------------------\n858\t\n859\t\n860\tdef test_narration_trial_never_calls_interpret_intent_or_builds_an_agent(monkeypatch):\n861\t    \"\"\"A narration-stage trial never runs Stage 1 and never builds the\n862\t    tool-loop agent (so its evidence tool is never registered, let alone\n863\t    invoked) — the only fetch is the oracle acquired directly from the stub\n864\t    client before `narrate()` runs.\"\"\"\n865\t    case = CASES[\"answer/VC-POC-01\"]\n866\t    reference_answer = REFERENCES[case.case_id].output[\"answer\"]\n867\t\n868\t    def boom_interpret_intent(question, model=None):\n869\t        raise AssertionError(\n870\t            \"interpret_intent must not be called during a narration-stage trial\"\n871\t        )\n872\t\n873\t    def boom_build_agent(*args, **kwargs):\n874\t        raise AssertionError(\n875\t            \"build_agent (and therefore its evidence tool) must not be invoked \"\n876\t            \"during a narration-stage trial\"\n877\t        )\n878\t\n879\t    monkeypatch.setattr(live, \"interpret_intent\", boom_interpret_intent)\n880\t    monkeypatch.setattr(live, \"build_agent\", boom_build_agent)\n881\t\n882\t    result, record = asyncio.run(\n883\t        live.run_trial(\n884\t            case, case.phrasings[0], 1, \"stub\", stage=\"narration\",\n885\t            narration_model=make_narration_model(reference_answer),\n886\t        )\n887\t    )\n888\t    assert result.passed, result.detail\n889\t    assert record is not None\n890\t\n891\t\n892\tdef test_intent_trial_never_fetches_evidence_or_calls_narrate(monkeypatch):\n893\t    \"\"\"The converse: an intent-stage trial never builds an evidence client and\n894\t    never calls narration.\"\"\"\n895\t    case = CASES[\"answer/VC-POC-01\"]\n896\t    intent = StructuredIntent(question_id=\"VC-POC-01\", school_mentions=[\"Alpha College\"])\n897\t\n898\t    def boom_build_client(*args, **kwargs):\n899\t        raise AssertionError(\n900\t            \"build_client (an evidence fetch) must not be called during an \"\n901\t            \"intent-stage trial\"\n902\t        )\n903\t\n904\t    async def boom_narrate(*args, **kwargs):\n905\t        raise AssertionError(\"narrate must not be called during an intent-stage trial\")\n906\t\n907\t    monkeypatch.setattr(live, \"build_client\", boom_build_client)\n908\t    monkeypatch.setattr(live, \"narrate\", boom_narrate)\n909\t\n910\t    result, record = asyncio.run(\n911\t        live.run_trial(\n912\t            case, case.phrasings[0], 1, \"stub\", stage=\"intent\",\n913\t            intent_model=make_intent_model(intent),\n914\t        )\n915\t    )\n916\t    assert result.passed, result.detail\n917\t    assert record is None\n918\t\n919\t\n920\tdef test_narration_stage_is_unaffected_by_a_wrong_scripted_intent():\n921\t    \"\"\"The defining isolation check: two narration runs of the same case, whose\n922\t    scripted models differ only in what intent they would produce IF intent\n923\t    interpretation were invoked, must produce identical output and grades —\n924\t    because narration never invokes it.\"\"\"\n925\t    case = CASES[\"answer/VC-POC-01\"]\n926\t    reference_answer = REFERENCES[case.case_id].output[\"answer\"]\n927\t    correct_intent = StructuredIntent(question_id=\"VC-POC-01\", school_mentions=[\"Alpha College\"])\n928\t    wrong_intent = StructuredIntent(question_id=\"excluded\", excluded_topic=\"finance\")\n929\t\n930\t    result_a, record_a = asyncio.run(\n931\t        live.run_trial(\n932\t            case, case.phrasings[0], 1, \"stub\", stage=\"narration\",\n933\t            intent_model=make_intent_model(correct_intent),\n934\t            narration_model=make_narration_model(reference_answer),\n935\t        )\n936\t    )\n937\t    result_b, record_b = asyncio.run(\n938\t        live.run_trial(\n939\t            case, case.phrasings[0], 1, \"stub\", stage=\"narration\",\n940\t            intent_model=make_intent_model(wrong_intent),\n941\t            narration_model=make_narration_model(reference_answer),\n942\t        )\n943\t    )\n944\t    assert result_a.passed == result_b.passed\n945\t    assert result_a.failed_graders == result_b.failed_graders\n946\t    assert record_a.output == record_b.output\n947\t\n948\t\n949\t# --------------------------------------------------------------------------\n950\t# PF-4: the live-marked file is provably invisible to the default gate, and\n951\t# fully covered by -m live — a missing marker fails the PR gate.\n952\t# --------------------------------------------------------------------------\n953\t\n954\t\n955\tdef test_live_eval_file_is_deselected_by_default_and_fully_marked_live():\n956\t    live_file = \"tests/live/test_live_eval.py\"\n957\t    source = (PROJECT_ROOT / live_file).read_text(\"utf-8\")\n958\t    tree = ast.parse(source)\n959\t    test_names = [\n960\t        node.name\n961\t        for node in ast.walk(tree)\n962\t        if isinstance(node, ast.FunctionDef) and node.name.startswith(\"test_\")\n963\t    ]\n964\t    assert test_names, \"no test functions found — the file moved or is empty\"\n965\t\n966\t    # Default options (this repo's addopts is `-m \"not live\"`): every test in\n967\t    # the file must be deselected, not merely absent from a `-k` filter — so\n968\t    # the check is that none of the file's OWN test names appear as a\n969\t    # collected/selected item, not a guess at pytest's summary wording.\n970\t    default_run = subprocess.run(\n971\t        [sys.executable, \"-m\", \"pytest\", live_file, \"--collect-only\", \"-q\"],\n972\t        cwd=str(PROJECT_ROOT),\n973\t        capture_output=True,\n974\t        text=True,\n975\t    )\n976\t    assert default_run.returncode in (0, 5), default_run.stdout + default_run.stderr\n977\t    for name in test_names:\n978\t        assert name not in default_run.stdout, (\n979\t            f\"{name!r} was collected by the DEFAULT options — a live-marked test \"\n980\t            \"must never be reachable from the PR gate by accident (ADR-007)\"\n981\t        )\n982\t\n983\t    # `-m live` must select every test the file defines: a missing marker on any\n984\t    # test in the file is exactly the gap PF-4 exists to catch.\n985\t    live_run = subprocess.run(\n986\t        [sys.executable, \"-m\", \"pytest\", live_file, \"--collect-only\", \"-q\", \"-m\", \"live\"],\n987\t        cwd=str(PROJECT_ROOT),\n988\t        capture_output=True,\n989\t        text=True,\n990\t    )\n991\t    assert live_run.returncode == 0, live_run.stdout + live_run.stderr\n992\t    for name in test_names:\n993\t        assert name in live_run.stdout, (\n994\t            f\"{name!r} is missing from the `-m live` collection — a test in \"\n995\t            f\"{live_file} lacks the live marker and would leak into the PR gate\"\n996\t        )\n997\t"}]},"parent_tool_use_id":null,"session_id":"2e8b7dde-8bb0-4345-aaad-7bcee95758ae","uuid":"c5fb8cfe-4955-445f-8b6a-085557de6912","timestamp":"2026-09-26T10:08:03.211Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/tests/unit/test_live_tier.py","content":"    with pytest.raises(SystemExit) as excinfo:\n        live.main(argv)\n    message = str(excinfo.value)\n    assert \"No report was written\" not in message\n    assert \"checkpoint from before the rejection exists\" in message.lower()\n    assert \"resume:\" in message.lower()\n\n    report_path = next(\n        path for path in tmp_path.glob(\"live-*.json\") if not path.stem.endswith(\"-transcripts\")\n    )\n    checkpoint = json.loads(report_path.read_text(\"utf-8\"))\n    assert checkpoint[\"status\"] == \"running\"\n    assert checkpoint[\"completed_trials\"] == 1\n    assert str(report_path) in message\n\n\n# --------------------------------------------------------------------------\n# PF-3: the isolation test is falsifiable — spies prove no cross-stage call\n# happens, not just that the score came out right.\n# --------------------------------------------------------------------------\n\n\ndef test_narration_trial_never_calls_interpret_intent_or_builds_an_agent(monkeypatch):\n    \"\"\"A narration-stage trial never runs Stage 1 and never builds the\n    tool-loop agent (so its evidence tool is never registered, let alone\n    invoked) — the only fetch is the oracle acquired directly from the stub\n    client before `narrate()` runs.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    reference_answer = REFERENCES[case.case_id].output[\"answer\"]\n\n    def boom_interpret_intent(question, model=None):\n        raise AssertionError(\n            \"interpret_intent must not be called during a narration-stage trial\"\n        )\n\n    def boom_build_agent(*args, **kwargs):\n        raise AssertionError(\n            \"build_agent (and therefore its evidence tool) must not be invoked \"\n            \"during a narration-stage trial\"\n        )\n\n    monkeypatch.setattr(live, \"interpret_intent\", boom_interpret_intent)\n    monkeypatch.setattr(live, \"build_agent\", boom_build_agent)\n\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"narration\",\n            narration_model=make_narration_model(reference_answer),\n        )\n    )\n    assert result.passed, result.detail\n    assert record is not None\n\n\ndef test_intent_trial_never_fetches_evidence_or_calls_narrate(monkeypatch):\n    \"\"\"The converse: an intent-stage trial never builds an evidence client and\n    never calls narration.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    intent = StructuredIntent(question_id=\"VC-POC-01\", school_mentions=[\"Alpha College\"])\n\n    def boom_build_client(*args, **kwargs):\n        raise AssertionError(\n            \"build_client (an evidence fetch) must not be called during an \"\n            \"intent-stage trial\"\n        )\n\n    async def boom_narrate(*args, **kwargs):\n        raise AssertionError(\"narrate must not be called during an intent-stage trial\")\n\n    monkeypatch.setattr(live, \"build_client\", boom_build_client)\n    monkeypatch.setattr(live, \"narrate\", boom_narrate)\n\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"intent\",\n            intent_model=make_intent_model(intent),\n        )\n    )\n    assert result.passed, result.detail\n    assert record is None\n\n\ndef test_narration_stage_is_unaffected_by_a_wrong_scripted_intent():\n    \"\"\"The defining isolation check: two narration runs of the same case, whose\n    scripted models differ only in what intent they would produce IF intent\n    interpretation were invoked, must produce identical output and grades —\n    because narration never invokes it.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    reference_answer = REFERENCES[case.case_id].output[\"answer\"]\n    correct_intent = StructuredIntent(question_id=\"VC-POC-01\", school_mentions=[\"Alpha College\"])\n    wrong_intent = StructuredIntent(question_id=\"excluded\", excluded_topic=\"finance\")\n\n    result_a, record_a = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"narration\",\n            intent_model=make_intent_model(correct_intent),\n            narration_model=make_narration_model(reference_answer),\n        )\n    )\n    result_b, record_b = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"narration\",\n            intent_model=make_intent_model(wrong_intent),\n            narration_model=make_narration_model(reference_answer),\n        )\n    )\n    assert result_a.passed == result_b.passed\n    assert result_a.failed_graders == result_b.failed_graders\n    assert record_a.output == record_b.output\n\n\n# --------------------------------------------------------------------------\n# PF-4: the live-marked file is provably invisible to the default gate, and\n# fully covered by -m live — a missing marker fails the PR gate.\n# --------------------------------------------------------------------------\n\n\ndef test_live_eval_file_is_deselected_by_default_and_fully_marked_live():\n    live_file = \"tests/live/test_live_eval.py\"\n    source = (PROJECT_ROOT / live_file).read_text(\"utf-8\")\n    tree = ast.parse(source)\n    test_names = [\n        node.name\n        for node in ast.walk(tree)\n        if isinstance(node, ast.FunctionDef) and node.name.startswith(\"test_\")\n    ]\n    assert test_names, \"no test functions found — the file moved or is empty\"\n\n    # Default options (this repo's addopts is `-m \"not live\"`): every test in\n    # the file must be deselected, not merely absent from a `-k` filter — so\n    # the check is that none of the file's OWN test names appear as a\n    # collected/selected item, not a guess at pytest's summary wording.\n    default_run = subprocess.run(\n        [sys.executable, \"-m\", \"pytest\", live_file, \"--collect-only\", \"-q\"],\n        cwd=str(PROJECT_ROOT),\n        capture_output=True,\n        text=True,\n    )\n    assert default_run.returncode in (0, 5), default_run.stdout + default_run.stderr\n    for name in test_names:\n        assert name not in default_run.stdout, (\n            f\"{name!r} was collected by the DEFAULT options — a live-marked test \"\n            \"must never be reachable from the PR gate by accident (ADR-007)\"\n        )\n\n    # `-m live` must select every test the file defines: a missing marker on any\n    # test in the file is exactly the gap PF-4 exists to catch.\n    live_run = subprocess.run(\n        [sys.executable, \"-m\", \"pytest\", live_file, \"--collect-only\", \"-q\", \"-m\", \"live\"],\n        cwd=str(PROJECT_ROOT),\n        capture_output=True,\n        text=True,\n    )\n    assert live_run.returncode == 0, live_run.stdout + live_run.stderr\n    for name in test_names:\n        assert name in live_run.stdout, (\n            f\"{name!r} is missing from the `-m live` collection — a test in \"\n            f\"{live_file} lacks the live marker and would leak into the PR gate\"\n        )\n","numLines":160,"startLine":838,"totalLines":997}}}
