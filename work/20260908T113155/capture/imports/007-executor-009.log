{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L4z6ivsTX6JTjFUU2v6YtK","type":"tool_result","content":"778\t\n779\t# --------------------------------------------------------------------------\n780\t# PF-2: a rejected credential tells the truth about what is on disk, for\n781\t# every stage — it does not always say \"No report was written\".\n782\t# --------------------------------------------------------------------------\n783\t\n784\t\n785\t@pytest.mark.parametrize(\"stage\", [None, \"intent\", \"narration\", \"end-to-end\"])\n786\tdef test_credentials_rejected_before_any_trial_writes_no_report(monkeypatch, tmp_path, stage):\n787\t    case = CASES[\"answer/VC-POC-01\"]\n788\t\n789\t    async def immediately_rejected(*args, **kwargs):\n790\t        raise live.CredentialsRejected(\"the credential is invalid\")\n791\t\n792\t    monkeypatch.setattr(live, \"run_suite\", immediately_rejected)\n793\t    monkeypatch.setattr(\"run.require_credentials\", lambda: None)\n794\t\n795\t    argv = [\"--k\", \"1\", \"--case\", case.case_id, \"--report-dir\", str(tmp_path)]\n796\t    if stage:\n797\t        argv += [\"--stage\", stage]\n798\t\n799\t    with pytest.raises(SystemExit) as excinfo:\n800\t        live.main(argv)\n801\t    message = str(excinfo.value)\n802\t    assert \"No report was written\" in message\n803\t    assert not any(\n804\t        path for path in tmp_path.glob(\"live-*.json\") if not path.stem.endswith(\"-transcripts\")\n805\t    )\n806\t\n807\t\n808\t@pytest.mark.parametrize(\"stage\", [None, \"intent\", \"narration\", \"end-to-end\"])\n809\tdef test_credentials_rejected_after_a_completed_trial_leaves_the_checkpoint_untouched(\n810\t    monkeypatch, tmp_path, stage\n811\t):\n812\t    \"\"\"The last 'running' checkpoint, written by `on_progress` after the one\n813\t    trial that completed before the rejection, must survive byte-for-byte —\n814\t    and the exit message must say so and give the resume command, instead of\n815\t    the (false, for this case) claim that no report was written.\"\"\"\n816\t    case = CASES[\"answer/VC-POC-01\"]\n817\t    completed = TrialResult(\n818\t        case_id=case.case_id,\n819\t        direction=case.direction,\n820\t        phrasing=case.phrasings[0],\n821\t        trial=1,\n822\t        passed=True,\n823\t        output_kind=\"RenderedAnswer\",\n824\t    )\n825\t\n826\t    async def one_trial_then_rejected(*args, on_progress=None, **kwargs):\n827\t        if on_progress is not None:\n828\t            on_progress([completed], [])\n829\t        raise live.CredentialsRejected(\"the credential is invalid\")\n830\t\n831\t    monkeypatch.setattr(live, \"run_suite\", one_trial_then_rejected)\n832\t    monkeypatch.setattr(\"run.require_credentials\", lambda: None)\n833\t\n834\t    argv = [\"--k\", \"1\", \"--case\", case.case_id, \"--report-dir\", str(tmp_path)]\n835\t    if stage:\n836\t        argv += [\"--stage\", stage]\n837\t"}]},"parent_tool_use_id":null,"session_id":"2e8b7dde-8bb0-4345-aaad-7bcee95758ae","uuid":"63768eb7-c920-4bd0-af14-0061090cf3be","timestamp":"2026-09-26T10:07:58.284Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/tests/unit/test_live_tier.py","content":"\n# --------------------------------------------------------------------------\n# PF-2: a rejected credential tells the truth about what is on disk, for\n# every stage — it does not always say \"No report was written\".\n# --------------------------------------------------------------------------\n\n\n@pytest.mark.parametrize(\"stage\", [None, \"intent\", \"narration\", \"end-to-end\"])\ndef test_credentials_rejected_before_any_trial_writes_no_report(monkeypatch, tmp_path, stage):\n    case = CASES[\"answer/VC-POC-01\"]\n\n    async def immediately_rejected(*args, **kwargs):\n        raise live.CredentialsRejected(\"the credential is invalid\")\n\n    monkeypatch.setattr(live, \"run_suite\", immediately_rejected)\n    monkeypatch.setattr(\"run.require_credentials\", lambda: None)\n\n    argv = [\"--k\", \"1\", \"--case\", case.case_id, \"--report-dir\", str(tmp_path)]\n    if stage:\n        argv += [\"--stage\", stage]\n\n    with pytest.raises(SystemExit) as excinfo:\n        live.main(argv)\n    message = str(excinfo.value)\n    assert \"No report was written\" in message\n    assert not any(\n        path for path in tmp_path.glob(\"live-*.json\") if not path.stem.endswith(\"-transcripts\")\n    )\n\n\n@pytest.mark.parametrize(\"stage\", [None, \"intent\", \"narration\", \"end-to-end\"])\ndef test_credentials_rejected_after_a_completed_trial_leaves_the_checkpoint_untouched(\n    monkeypatch, tmp_path, stage\n):\n    \"\"\"The last 'running' checkpoint, written by `on_progress` after the one\n    trial that completed before the rejection, must survive byte-for-byte —\n    and the exit message must say so and give the resume command, instead of\n    the (false, for this case) claim that no report was written.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    completed = TrialResult(\n        case_id=case.case_id,\n        direction=case.direction,\n        phrasing=case.phrasings[0],\n        trial=1,\n        passed=True,\n        output_kind=\"RenderedAnswer\",\n    )\n\n    async def one_trial_then_rejected(*args, on_progress=None, **kwargs):\n        if on_progress is not None:\n            on_progress([completed], [])\n        raise live.CredentialsRejected(\"the credential is invalid\")\n\n    monkeypatch.setattr(live, \"run_suite\", one_trial_then_rejected)\n    monkeypatch.setattr(\"run.require_credentials\", lambda: None)\n\n    argv = [\"--k\", \"1\", \"--case\", case.case_id, \"--report-dir\", str(tmp_path)]\n    if stage:\n        argv += [\"--stage\", stage]\n","numLines":60,"startLine":778,"totalLines":997}}}
