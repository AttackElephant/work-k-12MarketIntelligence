{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EnDtv2mcj6qzwrEuRovuTR","type":"tool_result","content":"190\t    )\n191\t\n192\t\n193\tasync def run_intent_trial(\n194\t    case: GoldenCase,\n195\t    phrasing: str,\n196\t    trial: int,\n197\t    intent_model: Any = None,\n198\t) -> tuple[TrialResult, RunRecord | None]:\n199\t    \"\"\"Stage 1, genuinely isolated: one model call, no tools, no evidence\n200\t    subprocess, no planner. Nothing runs except `interpret_intent()`, so\n201\t    grading is limited to what this stage alone decides — which registry\n202\t    question (or 'excluded'/'unknown') the model chose. `intent_model` is the\n203\t    test injection point (a scripted `FunctionModel`); production passes None\n204\t    and gets the real provider wiring.\n205\t    \"\"\"\n206\t    started = time.monotonic()\n207\t    try:\n208\t        intent = await interpret_intent(phrasing, model=intent_model)\n209\t    except Exception as exc:  # noqa: BLE001 — a crashed trial is still a result\n210\t        return _crashed_trial(case, phrasing, trial, exc, started), None\n211\t\n212\t    duration_ms = int((time.monotonic() - started) * 1000)\n213\t    failed = failures(grade_intent(case, intent))\n214\t    # No `Deps`/message history exists for an isolated intent call (there is no\n215\t    # tool loop and no pipeline run object), so cost reports the same way the\n216\t    # full pipeline does for an empty history — see `usage.spend_usd`.\n217\t    spent, complete = usage.spend_usd([])\n218\t    return (\n219\t        TrialResult(\n220\t            case_id=case.case_id,\n221\t            direction=case.direction,\n222\t            phrasing=phrasing,\n223\t            trial=trial,\n224\t            passed=not failed,\n225\t            failed_graders=[r.grader for r in failed],\n226\t            detail=\"; \".join(f\"{r.grader}: {r.detail}\" for r in failed),\n227\t            output_kind=None,\n228\t            duration_ms=duration_ms,\n229\t            cost_usd=spent,\n230\t            cost_complete=complete,\n231\t        ),\n232\t        None,\n233\t    )\n234\t\n235\t\n236\tasync def run_narration_trial(\n237\t    case: GoldenCase,\n238\t    phrasing: str,\n239\t    trial: int,\n240\t    narration_model: Any = None,\n241\t) -> tuple[TrialResult, RunRecord | None]:\n242\t    \"\"\"Stage 4, genuinely isolated: one model call over a FIXED AnswerView.\n243\t\n244\t    The oracle envelope is ALWAYS `build_client(\"stub\", case.stub_case)` — the\n245\t    stub emitter forced to the case's own canned fixture, the same offline\n246\t    mechanism the golden cases were generated with (Planning review 1, PF-1). It\n247\t    is never the real emitter and never a model-driven fetch, and it does not\n248\t    depend on whatever `--emitter` the rest of the suite is using: narration is\n249\t    defined over the oracle, not the data project. Intent and planning never\n250\t    run — the envelope is fetched directly from the stub for the case's own\n251\t    declared `expected_question_id`/`expected_request`, bypassing the tool loop\n252\t    and the planner entirely. A case with no `stub_case` (or no fixed\n253\t    question/request to fetch it with) is not narration-eligible and\n254\t    `select_cases` excludes it for `--stage narration`. Grading is\n255\t    `evals.graders.grade_case(..., stage=\"narration\")`: every prose/envelope\n256\t    rule the full pipeline enforces, minus the ones that judge a decision\n257\t    narration never makes.\n258\t    \"\"\"\n259\t    started = time.monotonic()\n260\t    if case.stub_case is None or not case.expected_question_id or case.expected_request is None:\n261\t        return (\n262\t            TrialResult(\n263\t                case_id=case.case_id,\n264\t                direction=case.direction,\n265\t                phrasing=phrasing,\n266\t                trial=trial,\n267\t                passed=False,\n268\t                error=(\n269\t                    \"case has no stub_case/expected_question_id/expected_request; the \"\n270\t                    \"narration stage needs a fixed oracle envelope to narrate\"\n271\t                ),\n272\t                duration_ms=int((time.monotonic() - started) * 1000),\n273\t            ),\n274\t            None,\n275\t        )\n276\t\n277\t    client = build_client(\"stub\", case.stub_case)\n278\t    deps = Deps(client=client)\n279\t    deps.user_question = phrasing\n280\t    try:\n281\t        envelope = await client.fetch_evidence(case.expected_question_id, case.expected_request)\n282\t    except Exception as exc:  # noqa: BLE001 — a crashed trial is still a result\n283\t        return _crashed_trial(case, phrasing, trial, exc, started, deps), None\n284\t\n285\t    deps.last_envelope = envelope\n286\t    deps.tool_calls.append(\n287\t        ToolInvocation(\n288\t            \"fetch_evidence\",\n289\t            {\"question_id\": case.expected_question_id, \"request\": case.expected_request},\n290\t            envelope,\n291\t        )\n292\t    )\n293\t    view = build_answer_view(envelope)\n294\t    deps.answer_view = view\n295\t\n296\t    try:\n297\t        narration = await narrate(view, deps, model=narration_model)\n298\t    except NarrationValidationError as exc:\n299\t        return (\n300\t            TrialResult(\n301\t                case_id=case.case_id,\n302\t                direction=case.direction,\n303\t                phrasing=phrasing,\n304\t                trial=trial,\n305\t                passed=False,\n306\t                failed_graders=[\"narration_validation\"],\n307\t                detail=\"; \".join(exc.problems),\n308\t                duration_ms=int((time.monotonic() - started) * 1000),\n309\t            ),\n310\t            None,\n311\t        )\n312\t    except Exception as exc:  # noqa: BLE001 — a crashed trial is still a result\n313\t        return _crashed_trial(case, phrasing, trial, exc, started, deps), None\n314\t\n315\t    output = RenderedAnswer(\n316\t        answer=narration.answer,\n317\t        question_id=view.question_id,\n318\t        contract_version=view.contract_version,\n319\t        evidence=view.evidence,\n320\t        provenance=view.provenance,\n321\t        confidence=view.confidence,\n322\t        limitations=view.limitations,\n323\t        deterministic_signals=view.deterministic_signals,\n324\t        resolved_request=view.resolved_request,\n325\t        data_status=view.data_status,\n326\t        claim_eligibility=view.claim_eligibility,\n327\t        data_status_note=view.data_status_note,\n328\t    )\n329\t    duration_ms = int((time.monotonic() - started) * 1000)\n330\t    record = replay_mod.project(case, deps, output)\n331\t    failed = failures(grade_case(case, record, stage=\"narration\"))\n332\t    spent, complete = usage.spend_usd(deps.last_messages)\n333\t    return (\n334\t        TrialResult(\n335\t            case_id=case.case_id,\n336\t            direction=case.direction,\n337\t            phrasing=phrasing,\n338\t            trial=trial,\n339\t            passed=not failed,"}]},"parent_tool_use_id":null,"session_id":"2e8b7dde-8bb0-4345-aaad-7bcee95758ae","uuid":"4422c39c-635b-4751-ac1f-a2e23be134da","timestamp":"2026-09-26T10:06:17.097Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/evals/live.py","content":"    )\n\n\nasync def run_intent_trial(\n    case: GoldenCase,\n    phrasing: str,\n    trial: int,\n    intent_model: Any = None,\n) -> tuple[TrialResult, RunRecord | None]:\n    \"\"\"Stage 1, genuinely isolated: one model call, no tools, no evidence\n    subprocess, no planner. Nothing runs except `interpret_intent()`, so\n    grading is limited to what this stage alone decides — which registry\n    question (or 'excluded'/'unknown') the model chose. `intent_model` is the\n    test injection point (a scripted `FunctionModel`); production passes None\n    and gets the real provider wiring.\n    \"\"\"\n    started = time.monotonic()\n    try:\n        intent = await interpret_intent(phrasing, model=intent_model)\n    except Exception as exc:  # noqa: BLE001 — a crashed trial is still a result\n        return _crashed_trial(case, phrasing, trial, exc, started), None\n\n    duration_ms = int((time.monotonic() - started) * 1000)\n    failed = failures(grade_intent(case, intent))\n    # No `Deps`/message history exists for an isolated intent call (there is no\n    # tool loop and no pipeline run object), so cost reports the same way the\n    # full pipeline does for an empty history — see `usage.spend_usd`.\n    spent, complete = usage.spend_usd([])\n    return (\n        TrialResult(\n            case_id=case.case_id,\n            direction=case.direction,\n            phrasing=phrasing,\n            trial=trial,\n            passed=not failed,\n            failed_graders=[r.grader for r in failed],\n            detail=\"; \".join(f\"{r.grader}: {r.detail}\" for r in failed),\n            output_kind=None,\n            duration_ms=duration_ms,\n            cost_usd=spent,\n            cost_complete=complete,\n        ),\n        None,\n    )\n\n\nasync def run_narration_trial(\n    case: GoldenCase,\n    phrasing: str,\n    trial: int,\n    narration_model: Any = None,\n) -> tuple[TrialResult, RunRecord | None]:\n    \"\"\"Stage 4, genuinely isolated: one model call over a FIXED AnswerView.\n\n    The oracle envelope is ALWAYS `build_client(\"stub\", case.stub_case)` — the\n    stub emitter forced to the case's own canned fixture, the same offline\n    mechanism the golden cases were generated with (Planning review 1, PF-1). It\n    is never the real emitter and never a model-driven fetch, and it does not\n    depend on whatever `--emitter` the rest of the suite is using: narration is\n    defined over the oracle, not the data project. Intent and planning never\n    run — the envelope is fetched directly from the stub for the case's own\n    declared `expected_question_id`/`expected_request`, bypassing the tool loop\n    and the planner entirely. A case with no `stub_case` (or no fixed\n    question/request to fetch it with) is not narration-eligible and\n    `select_cases` excludes it for `--stage narration`. Grading is\n    `evals.graders.grade_case(..., stage=\"narration\")`: every prose/envelope\n    rule the full pipeline enforces, minus the ones that judge a decision\n    narration never makes.\n    \"\"\"\n    started = time.monotonic()\n    if case.stub_case is None or not case.expected_question_id or case.expected_request is None:\n        return (\n            TrialResult(\n                case_id=case.case_id,\n                direction=case.direction,\n                phrasing=phrasing,\n                trial=trial,\n                passed=False,\n                error=(\n                    \"case has no stub_case/expected_question_id/expected_request; the \"\n                    \"narration stage needs a fixed oracle envelope to narrate\"\n                ),\n                duration_ms=int((time.monotonic() - started) * 1000),\n            ),\n            None,\n        )\n\n    client = build_client(\"stub\", case.stub_case)\n    deps = Deps(client=client)\n    deps.user_question = phrasing\n    try:\n        envelope = await client.fetch_evidence(case.expected_question_id, case.expected_request)\n    except Exception as exc:  # noqa: BLE001 — a crashed trial is still a result\n        return _crashed_trial(case, phrasing, trial, exc, started, deps), None\n\n    deps.last_envelope = envelope\n    deps.tool_calls.append(\n        ToolInvocation(\n            \"fetch_evidence\",\n            {\"question_id\": case.expected_question_id, \"request\": case.expected_request},\n            envelope,\n        )\n    )\n    view = build_answer_view(envelope)\n    deps.answer_view = view\n\n    try:\n        narration = await narrate(view, deps, model=narration_model)\n    except NarrationValidationError as exc:\n        return (\n            TrialResult(\n                case_id=case.case_id,\n                direction=case.direction,\n                phrasing=phrasing,\n                trial=trial,\n                passed=False,\n                failed_graders=[\"narration_validation\"],\n                detail=\"; \".join(exc.problems),\n                duration_ms=int((time.monotonic() - started) * 1000),\n            ),\n            None,\n        )\n    except Exception as exc:  # noqa: BLE001 — a crashed trial is still a result\n        return _crashed_trial(case, phrasing, trial, exc, started, deps), None\n\n    output = RenderedAnswer(\n        answer=narration.answer,\n        question_id=view.question_id,\n        contract_version=view.contract_version,\n        evidence=view.evidence,\n        provenance=view.provenance,\n        confidence=view.confidence,\n        limitations=view.limitations,\n        deterministic_signals=view.deterministic_signals,\n        resolved_request=view.resolved_request,\n        data_status=view.data_status,\n        claim_eligibility=view.claim_eligibility,\n        data_status_note=view.data_status_note,\n    )\n    duration_ms = int((time.monotonic() - started) * 1000)\n    record = replay_mod.project(case, deps, output)\n    failed = failures(grade_case(case, record, stage=\"narration\"))\n    spent, complete = usage.spend_usd(deps.last_messages)\n    return (\n        TrialResult(\n            case_id=case.case_id,\n            direction=case.direction,\n            phrasing=phrasing,\n            trial=trial,\n            passed=not failed,","numLines":150,"startLine":190,"totalLines":884}}}
