{"type":"stream_event","event":{"type":"message_delta","delta":{"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"container":null},"usage":{"input_tokens":2,"cache_creation_input_tokens":505,"cache_read_input_tokens":194660,"output_tokens":252,"output_tokens_details":{"thinking_tokens":0},"iterations":[{"input_tokens":2,"output_tokens":252,"cache_read_input_tokens":194660,"cache_creation_input_tokens":505,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":505},"type":"message"}]},"context_management":{"applied_edits":[]}},"session_id":"2e8b7dde-8bb0-4345-aaad-7bcee95758ae","parent_tool_use_id":null,"uuid":"183c64dd-e345-48a9-b932-ad4767bf37df"}
