{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BWSPeNVRr4y93wXJQaDkBz","type":"tool_result","content":"1\t[pytest]\n2\t# Markers are registered so a typo becomes an error rather than a silently\n3\t# ignored filter. `live` is excluded by default: live eval runs spend real\n4\t# tokens and are manual by design (ADR-007), so they must never be reachable\n5\t# from the PR gate by accident.\n6\tmarkers =\n7\t    live: needs real credentials and spends real tokens (never a PR gate)\n8\t    slow: takes more than a second or two\n9\t    contract: needs data project / real emitter (skips gracefully offline)\n10\t\n11\taddopts = -m \"not live\"\n12\ttestpaths = tests\n13\t"}]},"parent_tool_use_id":null,"session_id":"2e8b7dde-8bb0-4345-aaad-7bcee95758ae","uuid":"50c2ccb4-d9f0-48b9-b218-c8d1821f3017","timestamp":"2026-09-26T10:01:19.918Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/pytest.ini","content":"[pytest]\n# Markers are registered so a typo becomes an error rather than a silently\n# ignored filter. `live` is excluded by default: live eval runs spend real\n# tokens and are manual by design (ADR-007), so they must never be reachable\n# from the PR gate by accident.\nmarkers =\n    live: needs real credentials and spends real tokens (never a PR gate)\n    slow: takes more than a second or two\n    contract: needs data project / real emitter (skips gracefully offline)\n\naddopts = -m \"not live\"\ntestpaths = tests\n","numLines":13,"startLine":1,"totalLines":13}}}
