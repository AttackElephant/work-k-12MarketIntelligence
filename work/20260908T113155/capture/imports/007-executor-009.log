{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018Vw72dHgQ5STZ6K6qNQGp5","type":"tool_result","content":"600\t    transcript_tmp.replace(sibling)\n601\t    report_tmp.replace(path)\n602\t    return path\n603\t\n604\t\n605\tdef build_parser() -> argparse.ArgumentParser:\n606\t    parser = argparse.ArgumentParser(\n607\t        prog=\"python -m evals.live\",\n608\t        description=\"Run the golden cases against a real model. Spends real tokens.\",\n609\t    )\n610\t    parser.add_argument(\n611\t        \"--k\", type=int, default=3,\n612\t        help=\"trials per case (default 3; repeated per base with --all-phrasings)\",\n613\t    )\n614\t    parser.add_argument(\n615\t        \"--emitter\",\n616\t        choices=(\"stub\", \"real\"),\n617\t        default=\"stub\",\n618\t        help=\"stub fixtures (default) or the data project's real emitter\",\n619\t    )\n620\t    parser.add_argument(\"--case\", action=\"append\", default=[], help=\"run only these case IDs\")\n621\t    parser.add_argument(\n622\t        \"--direction\",\n623\t        action=\"append\",\n624\t        default=[],\n625\t        help=\"run only these directions (should_answer, should_clarify, ...)\",\n626\t    )\n627\t    parser.add_argument(\n628\t        \"--pressure\",\n629\t        action=\"store_true\",\n630\t        help=\"append red-team softening phrasings (the O-10 probe)\",\n631\t    )\n632\t    parser.add_argument(\n633\t        \"--all-phrasings\", action=\"store_true\", help=\"run every phrasing, not just the first\"\n634\t    )\n635\t    parser.add_argument(\n636\t        \"--stage\",\n637\t        choices=(\"intent\", \"narration\", \"end-to-end\"),\n638\t        default=None,\n639\t        help=(\n640\t            \"which pipeline stage to evaluate: \"\n641\t            \"'intent' (NL→StructuredIntent), \"\n642\t            \"'narration' (AnswerView→narrative), \"\n643\t            \"'end-to-end' (full pipeline, k=1 only). \"\n644\t            \"Omit to run the full pipeline with any k (the default mode).\"\n645\t        ),\n646\t    )\n647\t    parser.add_argument(\"--report-dir\", type=Path, default=REPORT_DIR)\n648\t    parser.add_argument(\"--resume\", type=Path, help=\"resume an interrupted live report\")\n649\t    parser.add_argument(\n650\t        \"--max-trials\", type=int, default=None,\n651\t        help=\"run at most this many new trials, then save a resumable checkpoint\",\n652\t    )\n653\t    return parser\n654\t\n655\t\n656\tdef select_cases(args: argparse.Namespace) -> list[GoldenCase]:\n657\t    cases = load_cases()\n658\t    if args.case:\n659\t        wanted = set(args.case)\n660\t        cases = [c for c in cases if c.case_id in wanted]\n661\t        missing = wanted - {c.case_id for c in cases}\n662\t        if missing:\n663\t            raise SystemExit(f\"no such case(s): {sorted(missing)}\")\n664\t    if args.direction:\n665\t        cases = [c for c in cases if c.direction in set(args.direction)]\n666\t    if args.pressure:\n667\t        # Pressure only means something where there is an answer to soften.\n668\t        cases = [c for c in cases if c.direction in (\"should_answer\", \"should_resist_injection\")]\n669\t    if getattr(args, \"stage\", None) == \"narration\":\n670\t        # The narration stage is genuinely isolated (harness.narration alone,\n671\t        # over the oracle envelope `build_client(\"stub\", case.stub_case)`\n672\t        # fetches): a case with no `stub_case` fixture — or no fixed\n673\t        # question/request to fetch it with — gives the stage nothing to\n674\t        # narrate, so it is excluded (Planning review 1, PF-1).\n675\t        before = len(cases)\n676\t        cases = [\n677\t            c for c in cases\n678\t            if c.stub_case is not None and c.expected_question_id and c.expected_request is not None\n679\t        ]\n680\t        excluded = before - len(cases)\n681\t        print(f\"narration stage: excluded {excluded} case(s) with no stub_case oracle fixture\")\n682\t    if not cases:\n683\t        raise SystemExit(\"no cases selected\")\n684\t    return cases\n685\t\n686\t\n687\tdef main(argv: list[str] | None = None) -> int:\n688\t    from harness.logging_config import configure_logging\n689\t    from run import require_credentials\n690\t\n691\t    configure_logging()  # once per entry point\n692\t    args = build_parser().parse_args(argv)\n693\t    if args.k < 1:\n694\t        raise SystemExit(\"--k must be at least 1\")\n695\t    if args.max_trials is not None and args.max_trials < 1:\n696\t        raise SystemExit(\"--max-trials must be at least 1\")\n697\t    # Stage-specific validation: rules that protect deterministic tests and quota.\n698\t    if args.stage == \"intent\" and args.pressure:\n699\t        raise SystemExit(\n700\t            \"--pressure is not valid with --stage intent: pressure tests apply to \"\n701\t            \"prose grounding (narration), not to intent classification.\"\n702\t        )\n703\t    if args.stage == \"end-to-end\" and args.k > 1:\n704\t        raise SystemExit(\n705\t            \"--stage end-to-end requires --k 1. The end-to-end stage is a smoke \"\n706\t            \"suite, not a reliability sample — use the default mode (no --stage) \"\n707\t            \"for pass^k reliability measurement.\"\n708\t        )\n709\t    if args.stage == \"narration\" and args.emitter == \"real\":\n710\t        raise SystemExit(\n711\t            \"--stage narration is defined over the stub oracle envelope \"\n712\t            \"(build_client('stub', case.stub_case)), never the --emitter value: \"\n713\t            \"narration quality is scored against the canned fixture the case \"\n714\t            \"declares, not against a live data-project fetch. Drop --emitter real \"\n715\t            \"for --stage narration.\"\n716\t        )\n717\t\n718\t    initial_trials: list[TrialResult] = []\n719\t    initial_transcripts: list[RunRecord] = []"}]},"parent_tool_use_id":null,"session_id":"2e8b7dde-8bb0-4345-aaad-7bcee95758ae","uuid":"6af7e17e-3d74-49eb-98e4-f042ed48a64f","timestamp":"2026-09-26T10:03:39.546Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/evals/live.py","content":"    transcript_tmp.replace(sibling)\n    report_tmp.replace(path)\n    return path\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(\n        prog=\"python -m evals.live\",\n        description=\"Run the golden cases against a real model. Spends real tokens.\",\n    )\n    parser.add_argument(\n        \"--k\", type=int, default=3,\n        help=\"trials per case (default 3; repeated per base with --all-phrasings)\",\n    )\n    parser.add_argument(\n        \"--emitter\",\n        choices=(\"stub\", \"real\"),\n        default=\"stub\",\n        help=\"stub fixtures (default) or the data project's real emitter\",\n    )\n    parser.add_argument(\"--case\", action=\"append\", default=[], help=\"run only these case IDs\")\n    parser.add_argument(\n        \"--direction\",\n        action=\"append\",\n        default=[],\n        help=\"run only these directions (should_answer, should_clarify, ...)\",\n    )\n    parser.add_argument(\n        \"--pressure\",\n        action=\"store_true\",\n        help=\"append red-team softening phrasings (the O-10 probe)\",\n    )\n    parser.add_argument(\n        \"--all-phrasings\", action=\"store_true\", help=\"run every phrasing, not just the first\"\n    )\n    parser.add_argument(\n        \"--stage\",\n        choices=(\"intent\", \"narration\", \"end-to-end\"),\n        default=None,\n        help=(\n            \"which pipeline stage to evaluate: \"\n            \"'intent' (NL→StructuredIntent), \"\n            \"'narration' (AnswerView→narrative), \"\n            \"'end-to-end' (full pipeline, k=1 only). \"\n            \"Omit to run the full pipeline with any k (the default mode).\"\n        ),\n    )\n    parser.add_argument(\"--report-dir\", type=Path, default=REPORT_DIR)\n    parser.add_argument(\"--resume\", type=Path, help=\"resume an interrupted live report\")\n    parser.add_argument(\n        \"--max-trials\", type=int, default=None,\n        help=\"run at most this many new trials, then save a resumable checkpoint\",\n    )\n    return parser\n\n\ndef select_cases(args: argparse.Namespace) -> list[GoldenCase]:\n    cases = load_cases()\n    if args.case:\n        wanted = set(args.case)\n        cases = [c for c in cases if c.case_id in wanted]\n        missing = wanted - {c.case_id for c in cases}\n        if missing:\n            raise SystemExit(f\"no such case(s): {sorted(missing)}\")\n    if args.direction:\n        cases = [c for c in cases if c.direction in set(args.direction)]\n    if args.pressure:\n        # Pressure only means something where there is an answer to soften.\n        cases = [c for c in cases if c.direction in (\"should_answer\", \"should_resist_injection\")]\n    if getattr(args, \"stage\", None) == \"narration\":\n        # The narration stage is genuinely isolated (harness.narration alone,\n        # over the oracle envelope `build_client(\"stub\", case.stub_case)`\n        # fetches): a case with no `stub_case` fixture — or no fixed\n        # question/request to fetch it with — gives the stage nothing to\n        # narrate, so it is excluded (Planning review 1, PF-1).\n        before = len(cases)\n        cases = [\n            c for c in cases\n            if c.stub_case is not None and c.expected_question_id and c.expected_request is not None\n        ]\n        excluded = before - len(cases)\n        print(f\"narration stage: excluded {excluded} case(s) with no stub_case oracle fixture\")\n    if not cases:\n        raise SystemExit(\"no cases selected\")\n    return cases\n\n\ndef main(argv: list[str] | None = None) -> int:\n    from harness.logging_config import configure_logging\n    from run import require_credentials\n\n    configure_logging()  # once per entry point\n    args = build_parser().parse_args(argv)\n    if args.k < 1:\n        raise SystemExit(\"--k must be at least 1\")\n    if args.max_trials is not None and args.max_trials < 1:\n        raise SystemExit(\"--max-trials must be at least 1\")\n    # Stage-specific validation: rules that protect deterministic tests and quota.\n    if args.stage == \"intent\" and args.pressure:\n        raise SystemExit(\n            \"--pressure is not valid with --stage intent: pressure tests apply to \"\n            \"prose grounding (narration), not to intent classification.\"\n        )\n    if args.stage == \"end-to-end\" and args.k > 1:\n        raise SystemExit(\n            \"--stage end-to-end requires --k 1. The end-to-end stage is a smoke \"\n            \"suite, not a reliability sample — use the default mode (no --stage) \"\n            \"for pass^k reliability measurement.\"\n        )\n    if args.stage == \"narration\" and args.emitter == \"real\":\n        raise SystemExit(\n            \"--stage narration is defined over the stub oracle envelope \"\n            \"(build_client('stub', case.stub_case)), never the --emitter value: \"\n            \"narration quality is scored against the canned fixture the case \"\n            \"declares, not against a live data-project fetch. Drop --emitter real \"\n            \"for --stage narration.\"\n        )\n\n    initial_trials: list[TrialResult] = []\n    initial_transcripts: list[RunRecord] = []","numLines":120,"startLine":600,"totalLines":884}}}
