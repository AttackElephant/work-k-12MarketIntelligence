{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0127HwzKziBu79fghf6KyGWM","type":"tool_result","content":"1\t\"\"\"M4 — the live tier's machinery, exercised offline.\n2\t\n3\tThe live tier spends real tokens, so it runs manually and never gates a PR. But\n4\tits *arithmetic* must not wait for a paid run to be checked: a reporting bug in\n5\t`pass@k` / `pass^k` would misreport every live result afterwards, and the number\n6\tthat gets misreported is always the flattering one.\n7\t\n8\tSo everything here runs the real runner — `run_trial`, `run_suite`, the\n9\tsummariser, the report writer — with the model scripted. What is NOT proved here\n10\tis the only thing the live tier exists to measure: whether a real model makes\n11\tthe right decisions. That gap is the point of the tier, not an omission.\n12\t\n13\tThe paid tier itself is `tests/live/test_live_eval.py`, marked `live` and\n14\texcluded by `pytest.ini`.\n15\t\"\"\"\n16\t\n17\tfrom __future__ import annotations\n18\t\n19\timport asyncio\n20\timport json\n21\t\n22\timport pytest\n23\tfrom pydantic_ai.messages import ModelMessage, ModelResponse, ToolCallPart\n24\tfrom pydantic_ai.models.function import AgentInfo, FunctionModel\n25\t\n26\tfrom evals import live, replay as replay_mod\n27\tfrom evals.live import CaseReport, TrialResult, aggregate, summarise\n28\tfrom evals.schema import load_cases, load_reference_solutions\n29\tfrom harness.agent import build_agent\n30\tfrom harness.intent import StructuredIntent\n31\t\n32\tCASES = {c.case_id: c for c in load_cases()}\n33\tREFERENCES = load_reference_solutions()\n34\t\n35\t# In pydantic-ai 1.106.0, a single (non-union) output type uses \"final_result\"\n36\t# as the tool name (see tests/unit/test_intent_boundary.py). Both the intent\n37\t# and narration agents have single output types.\n38\tINTENT_TOOL = \"final_result\"\n39\tNARRATION_TOOL = \"final_result\"\n40\t\n41\t\n42\tdef make_intent_model(intent: StructuredIntent) -> FunctionModel:\n43\t    \"\"\"A model that returns a fixed StructuredIntent immediately.\"\"\"\n44\t    payload = intent.model_dump()\n45\t\n46\t    def fn(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:\n47\t        return ModelResponse(parts=[ToolCallPart(INTENT_TOOL, payload)])\n48\t\n49\t    return FunctionModel(fn)\n50\t\n51\t\n52\tdef make_narration_model(answer: str) -> FunctionModel:\n53\t    \"\"\"A model that returns fixed narration immediately.\"\"\"\n54\t\n55\t    def fn(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:\n56\t        return ModelResponse(parts=[ToolCallPart(NARRATION_TOOL, {\"answer\": answer})])\n57\t\n58\t    return FunctionModel(fn)\n59\t\n60\t\n61\tdef trial(passed: bool, graders: list[str] | None = None, **kwargs) -> TrialResult:\n62\t    return TrialResult(\n63\t        case_id=\"c\",\n64\t        direction=\"should_answer\",\n65\t        phrasing=\"p\",\n66\t        trial=1,\n67\t        passed=passed,\n68\t        failed_graders=graders or [],\n69\t        **kwargs,\n70\t    )\n71\t\n72\t\n73\t# --------------------------------------------------------------------------\n74\t# pass@k and pass^k measure different things, and the difference is the point\n75\t# --------------------------------------------------------------------------\n76\t\n77\t\n78\tdef test_one_pass_in_three_is_capability_without_reliability():\n79\t    report = summarise(\"c\", \"should_answer\", [trial(True), trial(False), trial(False)])\n80\t    assert report.pass_at_k == 1.0, \"it managed it once — that is capability\"\n81\t    assert report.pass_hat_k == 0.0, \"it failed twice — that is not shippable\"\n82\t\n83\t\n84\tdef test_all_passing_is_reliable():\n85\t    report = summarise(\"c\", \"should_answer\", [trial(True), trial(True), trial(True)])\n86\t    assert (report.pass_at_k, report.pass_hat_k) == (1.0, 1.0)\n87\t\n88\t\n89\tdef test_none_passing_scores_zero_on_both():\n90\t    report = summarise(\"c\", \"should_answer\", [trial(False), trial(False)])\n91\t    assert (report.pass_at_k, report.pass_hat_k) == (0.0, 0.0)\n92\t\n93\t\n94\tdef test_a_single_trial_cannot_look_reliable_by_being_alone():\n95\t    \"\"\"k=1 makes pass@k and pass^k identical, which is honest — it just means a\n96\t    k=1 run has measured capability and nothing about reliability.\"\"\"\n97\t    report = summarise(\"c\", \"should_answer\", [trial(True)])\n98\t    assert report.pass_at_k == report.pass_hat_k == 1.0\n99\t\n100\t\n101\tdef test_failed_graders_are_counted_for_error_analysis():\n102\t    report = summarise(\n103\t        \"c\",\n104\t        \"should_answer\",\n105\t        [trial(False, [\"grounding\"]), trial(False, [\"grounding\", \"empty_stated\"])],\n106\t    )\n107\t    assert report.failed_graders == {\"grounding\": 2, \"empty_stated\": 1}\n108\t\n109\t\n110\tdef test_a_crashed_trial_counts_as_a_failure_not_a_skip():\n111\t    \"\"\"An eval that drops the runs that blew up reports a better score than it\n112\t    earned — the same rule `grade_suite` follows for missing records.\"\"\"\n113\t    crashed = trial(False)\n114\t    crashed.error = \"EmitterFailure: exit 3\"\n115\t    report = summarise(\"c\", \"should_answer\", [trial(True), crashed])\n116\t    assert report.passes == 1\n117\t    assert report.pass_hat_k == 0.0\n118\t    assert report.failed_graders == {\"error\": 1}\n119\t\n120\t\n121\tdef test_aggregate_averages_over_cases_and_counts_errors():\n122\t    reports = [\n123\t        CaseReport(\"a\", \"should_answer\", 2, 2, 1.0, 1.0),\n124\t        CaseReport(\"b\", \"should_answer\", 2, 1, 1.0, 0.0),\n125\t    ]\n126\t    errored = trial(False)\n127\t    errored.error = \"boom\"\n128\t    totals = aggregate(reports, [trial(True), errored])\n129\t    assert totals[\"pass_at_k\"] == 1.0\n130\t    assert totals[\"pass_hat_k\"] == 0.5\n131\t    assert totals[\"errored_trials\"] == 1\n132\t\n133\t\n134\tdef test_aggregate_survives_an_empty_selection():\n135\t    assert aggregate([], [])[\"cases\"] == 0\n136\t\n137\t\n138\tdef test_an_unpriced_run_does_not_claim_its_cost_is_complete():\n139\t    \"\"\"`cost: None (complete=True)` asserted that a null figure was the whole\n140\t    story. `complete` now means every trial was priced AND something was.\"\"\"\n141\t    totals = aggregate([CaseReport(\"a\", \"should_answer\", 1, 0, 0.0, 0.0)], [trial(False)])\n142\t    assert totals[\"cost_usd\"] is None\n143\t    assert totals[\"cost_complete\"] is False\n144\t\n145\t\n146\tdef test_a_priced_run_reports_its_cost_as_complete():\n147\t    priced = trial(True, cost_usd=0.02, cost_complete=True)\n148\t    totals = aggregate([CaseReport(\"a\", \"should_answer\", 1, 1, 1.0, 1.0)], [priced])\n149\t    assert totals[\"cost_usd\"] == 0.02\n150\t    assert totals[\"cost_complete\"] is True\n151\t\n152\t\n153\t# --------------------------------------------------------------------------\n154\t# a rejected credential ends the run; it is not a measurement\n155\t# --------------------------------------------------------------------------\n156\t\n157\t\n158\tdef test_a_rejected_credential_stops_the_run_instead_of_scoring_it():\n159\t    \"\"\"The M4 first-run failure: one placeholder key produced 100 identical\n160\t    \"failed trials\", pass@k 0.0, and a report that read as a model problem. An\n161\t    auth failure says nothing about judgement, so it must not enter the score.\"\"\"\n162\t    from pydantic_ai.exceptions import ModelHTTPError\n163\t\n164\t    case = CASES[\"answer/VC-POC-01\"]\n165\t\n166\t    def rejecting_factory():\n167\t        raise ModelHTTPError(\n168\t            status_code=401,\n169\t            model_name=\"claude-sonnet-4-6\",\n170\t            body={\"error\": {\"message\": \"API key is invalid.\"}},\n171\t        )\n172\t\n173\t    with pytest.raises(live.CredentialsRejected):\n174\t        asyncio.run(live.run_trial(case, case.phrasings[0], 1, \"stub\", rejecting_factory))\n175\t\n176\t\n177\tdef test_a_rejected_credential_aborts_the_whole_suite():\n178\t    from pydantic_ai.exceptions import ModelHTTPError\n179\t\n180\t    def rejecting_factory():\n181\t        raise ModelHTTPError(status_code=401, model_name=\"x\", body={})\n182\t\n183\t    with pytest.raises(live.CredentialsRejected):\n184\t        asyncio.run(\n185\t            live.run_suite(\n186\t                list(CASES.values())[:3], k=3, emitter=\"stub\", agent_factory=rejecting_factory\n187\t            )\n188\t        )\n189\t\n190\t\n191\tdef test_other_provider_failures_are_still_ordinary_failed_trials():\n192\t    \"\"\"Only auth aborts. A 500 or a timeout is a trial result — the tier exists\n193\t    to measure a flaky world, not to give up on it.\"\"\"\n194\t    from pydantic_ai.exceptions import ModelHTTPError\n195\t\n196\t    case = CASES[\"answer/VC-POC-01\"]\n197\t\n198\t    def failing_factory():\n199\t        raise ModelHTTPError(status_code=500, model_name=\"x\", body={})\n200\t\n201\t    result, record = asyncio.run(\n202\t        live.run_trial(case, case.phrasings[0], 1, \"stub\", failing_factory)\n203\t    )\n204\t    assert not result.passed and result.error and record is None\n205\t\n206\t\n207\t# --------------------------------------------------------------------------\n208\t# the runner, with the model scripted\n209\t# --------------------------------------------------------------------------\n210\t\n211\t\n212\tdef scripted_factory(case_id: str):\n213\t    record = REFERENCES[case_id]\n214\t    return lambda: build_agent(model=replay_mod.scripted_model(record))\n215\t\n216\t\n217\tdef test_a_correct_run_grades_as_a_pass_through_the_real_runner():\n218\t    case = CASES[\"answer/VC-POC-01\"]\n219\t    result, record = asyncio.run(\n220\t        live.run_trial(case, case.phrasings[0], 1, \"stub\", scripted_factory(case.case_id))\n221\t    )\n222\t    assert result.passed, result.detail\n223\t    assert result.output_kind == \"RenderedAnswer\"\n224\t    assert record is not None\n225\t\n226\t\n227\tdef test_a_wrong_decision_grades_as_a_failure_and_says_which_grader():\n228\t    \"\"\"A run that completes but decides wrongly — here, asking about a radius\n229\t    when the question needed a peer filter. The runner must name the grader that\n230\t    objected: a live failure with no named grader is a transcript nobody reads.\"\"\"\n231\t    case = CASES[\"clarify/peer_filters\"]\n232\t    wrong = CASES[\"clarify/distance_km\"]\n233\t    result, record = asyncio.run(\n234\t        live.run_trial(case, case.phrasings[0], 1, \"stub\", scripted_factory(wrong.case_id))\n235\t    )\n236\t    assert not result.passed\n237\t    assert result.error is None, \"this run completed — it was wrong, not broken\"\n238\t    assert result.failed_graders\n239\t    assert result.detail\n240\t    assert record is not None, \"a wrong answer is exactly the transcript to keep\"\n241\t\n242\t\n243\tdef test_a_run_that_breaks_is_distinguishable_from_a_run_that_is_wrong():\n244\t    \"\"\"`error` set means the run never produced a gradeable outcome. Collapsing\n245\t    the two would put provider outages into the pass^k denominator as model\n246\t    failures.\"\"\"\n247\t    case = CASES[\"answer/VC-POC-02\"]\n248\t    incompatible = CASES[\"answer/VC-POC-01\"]\n249\t    result, _ = asyncio.run(\n250\t        live.run_trial(\n251\t            case, case.phrasings[0], 1, \"stub\", scripted_factory(incompatible.case_id)\n252\t        )\n253\t    )\n254\t    assert not result.passed\n255\t    assert result.error and not result.failed_graders\n256\t\n257\t\n258\tdef test_a_trial_that_raises_is_recorded_rather_than_lost():\n259\t    case = CASES[\"answer/VC-POC-01\"]\n260\t\n261\t    def exploding_factory():\n262\t        raise RuntimeError(\"provider is down\")\n263\t\n264\t    result, record = asyncio.run(\n265\t        live.run_trial(case, case.phrasings[0], 1, \"stub\", exploding_factory)\n266\t    )\n267\t    assert not result.passed\n268\t    assert \"provider is down\" in result.error\n269\t    assert record is None\n270\t\n271\t\n272\tdef test_run_suite_reports_every_trial_and_writes_readable_transcripts(tmp_path):\n273\t    case = CASES[\"answer/VC-POC-01\"]\n274\t    reports, trials, transcripts, interruption = asyncio.run(\n275\t        live.run_suite([case], k=2, emitter=\"stub\", agent_factory=scripted_factory(case.case_id))\n276\t    )\n277\t    assert interruption is None\n278\t    assert reports[0].trials == 2 and reports[0].passes == 2\n279\t    assert len(trials) == 2\n280\t    path = live.write_report(\n281\t        {\"totals\": aggregate(reports, trials)}, transcripts, tmp_path\n282\t    )\n283\t    saved = json.loads(path.read_text(\"utf-8\"))\n284\t    assert saved[\"totals\"][\"pass_hat_k\"] == 1.0\n285\t    sibling = json.loads(\n286\t        next(tmp_path.glob(\"*-transcripts.json\")).read_text(\"utf-8\")\n287\t    )\n288\t    # The prose is what a human reads when a case fails; a report that dropped it\n289\t    # would make error analysis impossible.\n290\t    assert sibling[\"records\"][0][\"output\"][\"answer\"]\n291\t\n292\t\n293\t# --------------------------------------------------------------------------\n294\t# selection and the O-10 pressure probe\n295\t# --------------------------------------------------------------------------\n296\t\n297\t\n298\tdef test_pressure_appends_the_red_team_phrasings():\n299\t    case = CASES[\"answer/VC-POC-01\"]\n300\t    phrasings = live.phrasings_for(case, pressure=True, all_phrasings=False)\n301\t    assert len(phrasings) == len(live.PRESSURE_PHRASINGS)\n302\t    assert all(p.startswith(case.phrasings[0]) for p in phrasings)\n303\t\n304\t\n305\tdef test_pressure_k_is_total_trials_not_phrasings_times_trials():\n306\t    case = CASES[\"answer/VC-POC-01\"]\n307\t    slots = live.trial_slots([case], k=5, pressure=True, all_phrasings=False)\n308\t    assert len(slots) == 5\n309\t    assert len({phrasing for _, phrasing, _ in slots}) == 5\n310\t\n311\t\n312\tdef test_quota_stops_without_recording_a_model_failure():\n313\t    from harness.errors import QuotaExceeded\n314\t\n315\t    case = CASES[\"answer/VC-POC-01\"]\n316\t\n317\t    def exhausted_factory():\n318\t        raise QuotaExceeded(\n319\t            \"Claude subscription quota exhausted; resets tonight\",\n320\t            provider=\"claude-account\",\n321\t            reset_at=\"tonight\",\n322\t        )\n323\t\n324\t    reports, trials, transcripts, interruption = asyncio.run(\n325\t        live.run_suite([case], k=3, emitter=\"stub\", agent_factory=exhausted_factory)\n326\t    )\n327\t    assert not reports and not trials and not transcripts\n328\t    assert interruption and interruption.kind == \"quota_exhausted\"\n329\t    assert interruption.reset_at == \"tonight\"\n330\t    assert live.aggregate(reports, trials)[\"pass_at_k\"] is None\n331\t\n332\t\n333\tdef test_chunked_suite_resumes_without_repeating_completed_trials():\n334\t    case = CASES[\"answer/VC-POC-01\"]\n335\t    factory = scripted_factory(case.case_id)\n336\t    reports, first, transcripts, interruption = asyncio.run(\n337\t        live.run_suite([case], k=3, emitter=\"stub\", agent_factory=factory, max_trials=2)\n338\t    )\n339\t    assert not reports\n340\t    assert len(first) == 2\n341\t    assert interruption and interruption.kind == \"chunk_limit\"\n342\t\n343\t    reports, resumed, _, interruption = asyncio.run(\n344\t        live.run_suite(\n345\t            [case], k=3, emitter=\"stub\", agent_factory=factory,\n346\t            initial_trials=first, initial_transcripts=transcripts,\n347\t        )\n348\t    )\n349\t    assert interruption is None\n350\t    assert len(resumed) == 3\n351\t    assert reports[0].trials == reports[0].passes == 3\n352\t\n353\t\n354\tdef test_cli_checkpoint_can_be_resumed_without_repeating_a_trial(monkeypatch, tmp_path):\n355\t    import run as run_cli\n356\t\n357\t    case = CASES[\"answer/VC-POC-01\"]\n358\t    first = TrialResult(\n359\t        case_id=case.case_id,\n360\t        direction=case.direction,\n361\t        phrasing=case.phrasings[0],\n362\t        trial=1,\n363\t        passed=True,\n364\t        output_kind=\"RenderedAnswer\",\n365\t    )\n366\t    monkeypatch.setattr(run_cli, \"require_credentials\", lambda: None)\n367\t\n368\t    async def first_chunk(*args, **kwargs):\n369\t        return (\n370\t            [],\n371\t            [first],\n372\t            [],\n373\t            live.SuiteInterruption(\n374\t                \"chunk_limit\", \"one trial\", case.case_id, case.phrasings[0], 2\n375\t            ),\n376\t        )\n377\t\n378\t    monkeypatch.setattr(live, \"run_suite\", first_chunk)\n379\t    assert live.main(\n380\t        [\n381\t            \"--k\", \"2\", \"--case\", case.case_id, \"--max-trials\", \"1\",\n382\t            \"--report-dir\", str(tmp_path),\n383\t        ]\n384\t    ) == 2\n385\t    report_path = next(\n386\t        path for path in tmp_path.glob(\"live-*.json\") if not path.stem.endswith(\"-transcripts\")\n387\t    )\n388\t    checkpoint = json.loads(report_path.read_text(\"utf-8\"))\n389\t    assert checkpoint[\"status\"] == \"interrupted\"\n390\t    assert checkpoint[\"completed_trials\"] == 1\n391\t    assert checkpoint[\"totals\"][\"pass_at_k\"] is None\n392\t\n393\t    second = TrialResult(\n394\t        case_id=case.case_id,\n395\t        direction=case.direction,\n396\t        phrasing=case.phrasings[0],\n397\t        trial=2,\n398\t        passed=True,\n399\t        output_kind=\"RenderedAnswer\",\n400\t    )\n401\t\n402\t    async def resumed(*args, **kwargs):\n403\t        assert kwargs[\"initial_trials\"] == [first]\n404\t        trials = [first, second]\n405\t        return [summarise(case.case_id, case.direction, trials)], trials, [], None\n406\t\n407\t    monkeypatch.setattr(live, \"run_suite\", resumed)\n408\t    assert live.main([\"--resume\", str(report_path)]) == 0\n409\t    completed = json.loads(report_path.read_text(\"utf-8\"))\n410\t    assert completed[\"status\"] == \"complete\"\n411\t    assert completed[\"completed_trials\"] == 2\n412\t    assert completed[\"totals\"][\"pass_hat_k\"] == 1.0\n413\t\n414\t\n415\tdef test_without_pressure_one_phrasing_is_used():\n416\t    case = CASES[\"answer/VC-POC-01\"]\n417\t    assert live.phrasings_for(case, pressure=False, all_phrasings=False) == [\n418\t        case.phrasings[0]\n419\t    ]\n420\t\n421\t\n422\tdef test_pressure_selects_only_cases_with_an_answer_to_soften():\n423\t    args = live.build_parser().parse_args([\"--pressure\"])\n424\t    selected = live.select_cases(args)\n425\t    assert selected\n426\t    assert {c.direction for c in selected} <= {\"should_answer\", \"should_resist_injection\"}\n427\t\n428\t\n429\tdef test_an_unknown_case_id_fails_loudly():\n430\t    args = live.build_parser().parse_args([\"--case\", \"no/such/case\"])\n431\t    with pytest.raises(SystemExit):\n432\t        live.select_cases(args)\n433\t\n434\t\n435\tdef test_a_direction_filter_selects_that_direction():\n436\t    args = live.build_parser().parse_args([\"--direction\", \"should_refuse\"])\n437\t    selected = live.select_cases(args)\n438\t    assert selected and all(c.direction == \"should_refuse\" for c in selected)\n439\t\n440\t\n441\tdef test_the_stub_client_forces_the_case_fixture_it_declares():\n442\t    \"\"\"A case that exists to test an empty or gappy series must reach that\n443\t    envelope even when a live model's request differs in a defaultable way. The\n444\t    request itself is still graded, from the transcript.\"\"\"\n445\t    client = live.build_client(\"stub\", \"VC-POC-01/empty-series\")\n446\t    assert client.env[\"STUB_EMITTER_CASE\"] == \"VC-POC-01/empty-series\"\n447\t    assert \"STUB_EMITTER_CASE\" not in live.build_client(\"stub\", None).env\n448\t\n449\t\n450\t# --------------------------------------------------------------------------\n451\t# --stage CLI validation\n452\t# --------------------------------------------------------------------------\n453\t\n454\t\n455\tdef test_stage_intent_with_pressure_is_rejected():\n456\t    \"\"\"--stage intent --pressure is rejected: pressure applies to narration, not intent.\"\"\"\n457\t    with pytest.raises(SystemExit, match=\"--pressure is not valid\"):\n458\t        live.main([\"--stage\", \"intent\", \"--pressure\"])\n459\t\n460\t\n461\tdef test_stage_end_to_end_with_k_greater_than_1_is_rejected():\n462\t    \"\"\"--stage end-to-end --k 5 is rejected: the smoke suite must be k=1.\"\"\"\n463\t    with pytest.raises(SystemExit, match=\"--stage end-to-end requires --k 1\"):\n464\t        live.main([\"--stage\", \"end-to-end\", \"--k\", \"5\"])\n465\t\n466\t\n467\tdef test_stage_end_to_end_with_k_1_parses_without_rejection():\n468\t    \"\"\"--stage end-to-end --k 1 is a valid combination (the argument parsing accepts it).\"\"\"\n469\t    parser = live.build_parser()\n470\t    args = parser.parse_args([\"--stage\", \"end-to-end\", \"--k\", \"1\"])\n471\t    assert args.stage == \"end-to-end\"\n472\t    assert args.k == 1\n473\t\n474\t\n475\tdef test_stage_narration_with_pressure_parses_without_rejection():\n476\t    \"\"\"--stage narration --pressure is valid (pressure probes the prose stage).\"\"\"\n477\t    parser = live.build_parser()\n478\t    args = parser.parse_args([\"--stage\", \"narration\", \"--pressure\"])\n479\t    assert args.stage == \"narration\"\n480\t    assert args.pressure is True\n481\t\n482\t\n483\tdef test_stage_none_is_the_default():\n484\t    \"\"\"No --stage means None (the existing full-pipeline mode).\"\"\"\n485\t    parser = live.build_parser()\n486\t    args = parser.parse_args([])\n487\t    assert args.stage is None\n488\t\n489\t\n490\tdef test_stage_is_included_in_checkpoint_payload(monkeypatch, tmp_path):\n491\t    \"\"\"The stage field is written into the checkpoint for resume compatibility.\"\"\"\n492\t    case = CASES[\"answer/VC-POC-01\"]\n493\t\n494\t    async def fake_suite(*args, **kwargs):\n495\t        return [], [], [], None\n496\t\n497\t    monkeypatch.setattr(live, \"run_suite\", fake_suite)\n498\t    monkeypatch.setattr(\"run.require_credentials\", lambda: None)\n499\t\n500\t    live.main(\n501\t        [\"--stage\", \"intent\", \"--k\", \"1\", \"--case\", case.case_id,\n502\t         \"--report-dir\", str(tmp_path)]\n503\t    )\n504\t    report_path = next(\n505\t        path for path in tmp_path.glob(\"live-*.json\")\n506\t        if not path.stem.endswith(\"-transcripts\")\n507\t    )\n508\t    payload = json.loads(report_path.read_text(\"utf-8\"))\n509\t    assert payload.get(\"stage\") == \"intent\"\n510\t    assert payload.get(\"selection\", {}).get(\"stage\") == \"intent\"\n511\t\n512\t\n513\tdef test_stage_none_still_uses_the_legacy_tool_loop():\n514\t    \"\"\"The default (no --stage) mode is unchanged: `run_trial` still drives the\n515\t    legacy `build_agent()` + `ask(agent, deps, question)` path.\"\"\"\n516\t    case = CASES[\"answer/VC-POC-01\"]\n517\t    result, record = asyncio.run(\n518\t        live.run_trial(case, case.phrasings[0], 1, \"stub\", scripted_factory(case.case_id))\n519\t    )\n520\t    assert result.passed, result.detail\n521\t    assert record is not None\n522\t\n523\t\n524\t# --------------------------------------------------------------------------\n525\t# --stage intent: genuinely isolated Stage 1, no tools, no evidence subprocess\n526\t# --------------------------------------------------------------------------\n527\t\n528\t\n529\tdef test_stage_intent_grades_a_correct_classification_as_a_pass():\n530\t    case = CASES[\"answer/VC-POC-01\"]\n531\t    intent = StructuredIntent(question_id=\"VC-POC-01\", school_mentions=[\"Alpha College\"])\n532\t    result, record = asyncio.run(\n533\t        live.run_trial(\n534\t            case, case.phrasings[0], 1, \"stub\", stage=\"intent\", intent_model=make_intent_model(intent)\n535\t        )\n536\t    )\n537\t    assert result.passed, result.detail\n538\t    assert record is None, \"the intent stage makes no tool calls, so there is no transcript\"\n539\t    assert result.cost_complete is not None\n540\t\n541\t\n542\tdef test_stage_intent_grades_a_wrong_classification_as_a_failure():\n543\t    case = CASES[\"answer/VC-POC-01\"]\n544\t    wrong = StructuredIntent(question_id=\"VC-POC-02\")\n545\t    result, record = asyncio.run(\n546\t        live.run_trial(\n547\t            case, case.phrasings[0], 1, \"stub\", stage=\"intent\", intent_model=make_intent_model(wrong)\n548\t        )\n549\t    )\n550\t    assert not result.passed\n551\t    assert result.failed_graders == [\"intent_question_match\"]\n552\t    assert record is None\n553\t\n554\t\n555\tdef test_stage_intent_grades_a_refusal_case_by_the_excluded_classification():\n556\t    \"\"\"`should_refuse` cases have no `expected_question_id` — the isolated\n557\t    check is that the model recognised the topic as excluded.\"\"\"\n558\t    case = CASES[\"refuse/finance\"]\n559\t    intent = StructuredIntent(question_id=\"excluded\", excluded_topic=\"finance\")\n560\t    result, _ = asyncio.run(\n561\t        live.run_trial(\n562\t            case, case.phrasings[0], 1, \"stub\", stage=\"intent\", intent_model=make_intent_model(intent)\n563\t        )\n564\t    )\n565\t    assert result.passed, result.detail\n566\t\n567\t    wrong = StructuredIntent(question_id=\"VC-POC-01\")\n568\t    result, _ = asyncio.run(\n569\t        live.run_trial(\n570\t            case, case.phrasings[0], 1, \"stub\", stage=\"intent\", intent_model=make_intent_model(wrong)\n571\t        )\n572\t    )\n573\t    assert not result.passed\n574\t\n575\t\n576\tdef test_stage_intent_a_crashed_call_is_a_failed_trial_not_a_transcript():\n577\t    case = CASES[\"answer/VC-POC-01\"]\n578\t\n579\t    def exploding_model(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:\n580\t        raise RuntimeError(\"provider is down\")\n581\t\n582\t    result, record = asyncio.run(\n583\t        live.run_trial(\n584\t            case, case.phrasings[0], 1, \"stub\",\n585\t            stage=\"intent\", intent_model=FunctionModel(exploding_model),\n586\t        )\n587\t    )\n588\t    assert not result.passed\n589\t    assert \"provider is down\" in result.error\n590\t    assert record is None\n591\t\n592\t\n593\t# --------------------------------------------------------------------------\n594\t# --stage narration: genuinely isolated Stage 4, over a fixed envelope\n595\t# --------------------------------------------------------------------------\n596\t\n597\t\n598\tdef test_stage_narration_grades_grounded_prose_as_a_pass():\n599\t    case = CASES[\"answer/VC-POC-01\"]\n600\t    reference_answer = REFERENCES[case.case_id].output[\"answer\"]\n601\t    result, record = asyncio.run(\n602\t        live.run_trial(\n603\t            case, case.phrasings[0], 1, \"stub\",\n604\t            stage=\"narration\", narration_model=make_narration_model(reference_answer),\n605\t        )\n606\t    )\n607\t    assert result.passed, result.detail\n608\t    assert record is not None\n609\t    assert record.output_kind == \"RenderedAnswer\"\n610\t    # Isolation: narration never chose a question or sent a request — the\n611\t    # transcript's one tool call is the fixed envelope fetch this stage did\n612\t    # itself, using the case's own declared expected request.\n613\t    assert len(record.tool_calls) == 1\n614\t    assert record.tool_calls[0].tool == \"fetch_evidence\"\n615\t\n616\t\n617\tdef test_stage_narration_grades_ungrounded_prose_as_a_failure():\n618\t    \"\"\"The harness's own rendering gate (ADR-014) rejects this before the eval\n619\t    grader ever runs: `narrate()` raises `NarrationValidationError` rather than\n620\t    returning an ungrounded answer, so the failure is a validation failure, not\n621\t    a `grounding` grader result read off a completed transcript.\"\"\"\n622\t    case = CASES[\"answer/VC-POC-01\"]\n623\t    result, record = asyncio.run(\n624\t        live.run_trial(\n625\t            case, case.phrasings[0], 1, \"stub\",\n626\t            stage=\"narration\",\n627\t            narration_model=make_narration_model(\"Enrolments reached exactly 987654 students.\"),\n628\t        )\n629\t    )\n630\t    assert not result.passed\n631\t    assert result.failed_graders == [\"narration_validation\"]\n632\t    assert record is None\n633\t\n634\t\n635\tdef test_stage_narration_skips_cases_with_no_fixed_envelope():\n636\t    \"\"\"A `should_clarify`/`should_refuse` case has no expected_question_id and\n637\t    request pair, so the isolated narration stage has nothing to narrate.\"\"\"\n638\t    case = CASES[\"clarify/distance_km\"]\n639\t    result, record = asyncio.run(\n640\t        live.run_trial(case, case.phrasings[0], 1, \"stub\", stage=\"narration\")\n641\t    )\n642\t    assert not result.passed\n643\t    assert result.error is not None and \"expected_question_id\" in result.error\n644\t    assert record is None\n645\t\n646\t\n647\tdef test_select_cases_for_narration_stage_keeps_only_cases_with_a_fixed_request():\n648\t    args = live.build_parser().parse_args([\"--stage\", \"narration\"])\n649\t    selected = live.select_cases(args)\n650\t    assert selected\n651\t    assert all(c.expected_question_id and c.expected_request is not None for c in selected)\n652\t    assert \"clarify/distance_km\" not in {c.case_id for c in selected}\n653\t    assert \"refuse/finance\" not in {c.case_id for c in selected}\n654\t\n655\t\n656\t# --------------------------------------------------------------------------\n657\t# --stage end-to-end: the real new-pipeline ask(), not the legacy tool loop\n658\t# --------------------------------------------------------------------------\n659\t\n660\t\n661\tdef test_stage_end_to_end_runs_the_real_pipeline_offline():\n662\t    \"\"\"`ask(deps, question)` — the NEW pipeline signature — scripted end to\n663\t    end with the real planner, the real stub-emitter subprocess and the real\n664\t    rendering gate, exactly as `evals/replay.py` does for the legacy path.\"\"\"\n665\t    case = CASES[\"answer/VC-POC-REF-01\"]\n666\t    reference_answer = REFERENCES[case.case_id].output[\"answer\"]\n667\t    intent = StructuredIntent(question_id=\"VC-POC-REF-01\")\n668\t    result, record = asyncio.run(\n669\t        live.run_trial(\n670\t            case, case.phrasings[0], 1, \"stub\", stage=\"end-to-end\",\n671\t            intent_model=make_intent_model(intent),\n672\t            narration_model=make_narration_model(reference_answer),\n673\t        )\n674\t    )\n675\t    assert result.passed, result.detail\n676\t    assert record is not None\n677\t    assert record.output_kind == \"RenderedAnswer\"\n678\t    assert record.requested_question_id() == \"VC-POC-REF-01\"\n679\t\n680\t\n681\tdef test_stage_end_to_end_a_wrong_intent_decision_grades_as_a_failure():\n682\t    case = CASES[\"answer/VC-POC-REF-01\"]\n683\t    wrong_intent = StructuredIntent(question_id=\"excluded\", excluded_topic=\"finance\")\n684\t    result, record = asyncio.run(\n685\t        live.run_trial(\n686\t            case, case.phrasings[0], 1, \"stub\", stage=\"end-to-end\",\n687\t            intent_model=make_intent_model(wrong_intent),\n688\t        )\n689\t    )\n690\t    assert not result.passed\n691\t    assert record is not None\n692\t\n693\t\n694\tdef test_resume_with_wrong_stage_is_rejected(monkeypatch, tmp_path):\n695\t    \"\"\"Resuming a checkpoint recorded with a different stage is rejected.\"\"\"\n696\t    case = CASES[\"answer/VC-POC-01\"]\n697\t\n698\t    async def fake_suite(*args, **kwargs):\n699\t        return [], [], [], None\n700\t\n701\t    monkeypatch.setattr(live, \"run_suite\", fake_suite)\n702\t    monkeypatch.setattr(\"run.require_credentials\", lambda: None)\n703\t\n704\t    # Record a checkpoint with --stage intent\n705\t    live.main(\n706\t        [\"--stage\", \"intent\", \"--k\", \"1\", \"--case\", case.case_id,\n707\t         \"--report-dir\", str(tmp_path)]\n708\t    )\n709\t    report_path = next(\n710\t        path for path in tmp_path.glob(\"live-*.json\")\n711\t        if not path.stem.endswith(\"-transcripts\")\n712\t    )\n713\t\n714\t    # Trying to resume it with --stage narration must fail\n715\t    with pytest.raises(SystemExit, match=\"recorded with --stage 'intent'\"):\n716\t        live.main([\"--stage\", \"narration\", \"--resume\", str(report_path)])\n717\t"}]},"parent_tool_use_id":null,"session_id":"2e8b7dde-8bb0-4345-aaad-7bcee95758ae","uuid":"9e0ce058-8e41-40cb-ae8a-0a9467227ed5","timestamp":"2026-09-26T09:59:58.435Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/tests/unit/test_live_tier.py","content":"\"\"\"M4 — the live tier's machinery, exercised offline.\n\nThe live tier spends real tokens, so it runs manually and never gates a PR. But\nits *arithmetic* must not wait for a paid run to be checked: a reporting bug in\n`pass@k` / `pass^k` would misreport every live result afterwards, and the number\nthat gets misreported is always the flattering one.\n\nSo everything here runs the real runner — `run_trial`, `run_suite`, the\nsummariser, the report writer — with the model scripted. What is NOT proved here\nis the only thing the live tier exists to measure: whether a real model makes\nthe right decisions. That gap is the point of the tier, not an omission.\n\nThe paid tier itself is `tests/live/test_live_eval.py`, marked `live` and\nexcluded by `pytest.ini`.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport json\n\nimport pytest\nfrom pydantic_ai.messages import ModelMessage, ModelResponse, ToolCallPart\nfrom pydantic_ai.models.function import AgentInfo, FunctionModel\n\nfrom evals import live, replay as replay_mod\nfrom evals.live import CaseReport, TrialResult, aggregate, summarise\nfrom evals.schema import load_cases, load_reference_solutions\nfrom harness.agent import build_agent\nfrom harness.intent import StructuredIntent\n\nCASES = {c.case_id: c for c in load_cases()}\nREFERENCES = load_reference_solutions()\n\n# In pydantic-ai 1.106.0, a single (non-union) output type uses \"final_result\"\n# as the tool name (see tests/unit/test_intent_boundary.py). Both the intent\n# and narration agents have single output types.\nINTENT_TOOL = \"final_result\"\nNARRATION_TOOL = \"final_result\"\n\n\ndef make_intent_model(intent: StructuredIntent) -> FunctionModel:\n    \"\"\"A model that returns a fixed StructuredIntent immediately.\"\"\"\n    payload = intent.model_dump()\n\n    def fn(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:\n        return ModelResponse(parts=[ToolCallPart(INTENT_TOOL, payload)])\n\n    return FunctionModel(fn)\n\n\ndef make_narration_model(answer: str) -> FunctionModel:\n    \"\"\"A model that returns fixed narration immediately.\"\"\"\n\n    def fn(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:\n        return ModelResponse(parts=[ToolCallPart(NARRATION_TOOL, {\"answer\": answer})])\n\n    return FunctionModel(fn)\n\n\ndef trial(passed: bool, graders: list[str] | None = None, **kwargs) -> TrialResult:\n    return TrialResult(\n        case_id=\"c\",\n        direction=\"should_answer\",\n        phrasing=\"p\",\n        trial=1,\n        passed=passed,\n        failed_graders=graders or [],\n        **kwargs,\n    )\n\n\n# --------------------------------------------------------------------------\n# pass@k and pass^k measure different things, and the difference is the point\n# --------------------------------------------------------------------------\n\n\ndef test_one_pass_in_three_is_capability_without_reliability():\n    report = summarise(\"c\", \"should_answer\", [trial(True), trial(False), trial(False)])\n    assert report.pass_at_k == 1.0, \"it managed it once — that is capability\"\n    assert report.pass_hat_k == 0.0, \"it failed twice — that is not shippable\"\n\n\ndef test_all_passing_is_reliable():\n    report = summarise(\"c\", \"should_answer\", [trial(True), trial(True), trial(True)])\n    assert (report.pass_at_k, report.pass_hat_k) == (1.0, 1.0)\n\n\ndef test_none_passing_scores_zero_on_both():\n    report = summarise(\"c\", \"should_answer\", [trial(False), trial(False)])\n    assert (report.pass_at_k, report.pass_hat_k) == (0.0, 0.0)\n\n\ndef test_a_single_trial_cannot_look_reliable_by_being_alone():\n    \"\"\"k=1 makes pass@k and pass^k identical, which is honest — it just means a\n    k=1 run has measured capability and nothing about reliability.\"\"\"\n    report = summarise(\"c\", \"should_answer\", [trial(True)])\n    assert report.pass_at_k == report.pass_hat_k == 1.0\n\n\ndef test_failed_graders_are_counted_for_error_analysis():\n    report = summarise(\n        \"c\",\n        \"should_answer\",\n        [trial(False, [\"grounding\"]), trial(False, [\"grounding\", \"empty_stated\"])],\n    )\n    assert report.failed_graders == {\"grounding\": 2, \"empty_stated\": 1}\n\n\ndef test_a_crashed_trial_counts_as_a_failure_not_a_skip():\n    \"\"\"An eval that drops the runs that blew up reports a better score than it\n    earned — the same rule `grade_suite` follows for missing records.\"\"\"\n    crashed = trial(False)\n    crashed.error = \"EmitterFailure: exit 3\"\n    report = summarise(\"c\", \"should_answer\", [trial(True), crashed])\n    assert report.passes == 1\n    assert report.pass_hat_k == 0.0\n    assert report.failed_graders == {\"error\": 1}\n\n\ndef test_aggregate_averages_over_cases_and_counts_errors():\n    reports = [\n        CaseReport(\"a\", \"should_answer\", 2, 2, 1.0, 1.0),\n        CaseReport(\"b\", \"should_answer\", 2, 1, 1.0, 0.0),\n    ]\n    errored = trial(False)\n    errored.error = \"boom\"\n    totals = aggregate(reports, [trial(True), errored])\n    assert totals[\"pass_at_k\"] == 1.0\n    assert totals[\"pass_hat_k\"] == 0.5\n    assert totals[\"errored_trials\"] == 1\n\n\ndef test_aggregate_survives_an_empty_selection():\n    assert aggregate([], [])[\"cases\"] == 0\n\n\ndef test_an_unpriced_run_does_not_claim_its_cost_is_complete():\n    \"\"\"`cost: None (complete=True)` asserted that a null figure was the whole\n    story. `complete` now means every trial was priced AND something was.\"\"\"\n    totals = aggregate([CaseReport(\"a\", \"should_answer\", 1, 0, 0.0, 0.0)], [trial(False)])\n    assert totals[\"cost_usd\"] is None\n    assert totals[\"cost_complete\"] is False\n\n\ndef test_a_priced_run_reports_its_cost_as_complete():\n    priced = trial(True, cost_usd=0.02, cost_complete=True)\n    totals = aggregate([CaseReport(\"a\", \"should_answer\", 1, 1, 1.0, 1.0)], [priced])\n    assert totals[\"cost_usd\"] == 0.02\n    assert totals[\"cost_complete\"] is True\n\n\n# --------------------------------------------------------------------------\n# a rejected credential ends the run; it is not a measurement\n# --------------------------------------------------------------------------\n\n\ndef test_a_rejected_credential_stops_the_run_instead_of_scoring_it():\n    \"\"\"The M4 first-run failure: one placeholder key produced 100 identical\n    \"failed trials\", pass@k 0.0, and a report that read as a model problem. An\n    auth failure says nothing about judgement, so it must not enter the score.\"\"\"\n    from pydantic_ai.exceptions import ModelHTTPError\n\n    case = CASES[\"answer/VC-POC-01\"]\n\n    def rejecting_factory():\n        raise ModelHTTPError(\n            status_code=401,\n            model_name=\"claude-sonnet-4-6\",\n            body={\"error\": {\"message\": \"API key is invalid.\"}},\n        )\n\n    with pytest.raises(live.CredentialsRejected):\n        asyncio.run(live.run_trial(case, case.phrasings[0], 1, \"stub\", rejecting_factory))\n\n\ndef test_a_rejected_credential_aborts_the_whole_suite():\n    from pydantic_ai.exceptions import ModelHTTPError\n\n    def rejecting_factory():\n        raise ModelHTTPError(status_code=401, model_name=\"x\", body={})\n\n    with pytest.raises(live.CredentialsRejected):\n        asyncio.run(\n            live.run_suite(\n                list(CASES.values())[:3], k=3, emitter=\"stub\", agent_factory=rejecting_factory\n            )\n        )\n\n\ndef test_other_provider_failures_are_still_ordinary_failed_trials():\n    \"\"\"Only auth aborts. A 500 or a timeout is a trial result — the tier exists\n    to measure a flaky world, not to give up on it.\"\"\"\n    from pydantic_ai.exceptions import ModelHTTPError\n\n    case = CASES[\"answer/VC-POC-01\"]\n\n    def failing_factory():\n        raise ModelHTTPError(status_code=500, model_name=\"x\", body={})\n\n    result, record = asyncio.run(\n        live.run_trial(case, case.phrasings[0], 1, \"stub\", failing_factory)\n    )\n    assert not result.passed and result.error and record is None\n\n\n# --------------------------------------------------------------------------\n# the runner, with the model scripted\n# --------------------------------------------------------------------------\n\n\ndef scripted_factory(case_id: str):\n    record = REFERENCES[case_id]\n    return lambda: build_agent(model=replay_mod.scripted_model(record))\n\n\ndef test_a_correct_run_grades_as_a_pass_through_the_real_runner():\n    case = CASES[\"answer/VC-POC-01\"]\n    result, record = asyncio.run(\n        live.run_trial(case, case.phrasings[0], 1, \"stub\", scripted_factory(case.case_id))\n    )\n    assert result.passed, result.detail\n    assert result.output_kind == \"RenderedAnswer\"\n    assert record is not None\n\n\ndef test_a_wrong_decision_grades_as_a_failure_and_says_which_grader():\n    \"\"\"A run that completes but decides wrongly — here, asking about a radius\n    when the question needed a peer filter. The runner must name the grader that\n    objected: a live failure with no named grader is a transcript nobody reads.\"\"\"\n    case = CASES[\"clarify/peer_filters\"]\n    wrong = CASES[\"clarify/distance_km\"]\n    result, record = asyncio.run(\n        live.run_trial(case, case.phrasings[0], 1, \"stub\", scripted_factory(wrong.case_id))\n    )\n    assert not result.passed\n    assert result.error is None, \"this run completed — it was wrong, not broken\"\n    assert result.failed_graders\n    assert result.detail\n    assert record is not None, \"a wrong answer is exactly the transcript to keep\"\n\n\ndef test_a_run_that_breaks_is_distinguishable_from_a_run_that_is_wrong():\n    \"\"\"`error` set means the run never produced a gradeable outcome. Collapsing\n    the two would put provider outages into the pass^k denominator as model\n    failures.\"\"\"\n    case = CASES[\"answer/VC-POC-02\"]\n    incompatible = CASES[\"answer/VC-POC-01\"]\n    result, _ = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", scripted_factory(incompatible.case_id)\n        )\n    )\n    assert not result.passed\n    assert result.error and not result.failed_graders\n\n\ndef test_a_trial_that_raises_is_recorded_rather_than_lost():\n    case = CASES[\"answer/VC-POC-01\"]\n\n    def exploding_factory():\n        raise RuntimeError(\"provider is down\")\n\n    result, record = asyncio.run(\n        live.run_trial(case, case.phrasings[0], 1, \"stub\", exploding_factory)\n    )\n    assert not result.passed\n    assert \"provider is down\" in result.error\n    assert record is None\n\n\ndef test_run_suite_reports_every_trial_and_writes_readable_transcripts(tmp_path):\n    case = CASES[\"answer/VC-POC-01\"]\n    reports, trials, transcripts, interruption = asyncio.run(\n        live.run_suite([case], k=2, emitter=\"stub\", agent_factory=scripted_factory(case.case_id))\n    )\n    assert interruption is None\n    assert reports[0].trials == 2 and reports[0].passes == 2\n    assert len(trials) == 2\n    path = live.write_report(\n        {\"totals\": aggregate(reports, trials)}, transcripts, tmp_path\n    )\n    saved = json.loads(path.read_text(\"utf-8\"))\n    assert saved[\"totals\"][\"pass_hat_k\"] == 1.0\n    sibling = json.loads(\n        next(tmp_path.glob(\"*-transcripts.json\")).read_text(\"utf-8\")\n    )\n    # The prose is what a human reads when a case fails; a report that dropped it\n    # would make error analysis impossible.\n    assert sibling[\"records\"][0][\"output\"][\"answer\"]\n\n\n# --------------------------------------------------------------------------\n# selection and the O-10 pressure probe\n# --------------------------------------------------------------------------\n\n\ndef test_pressure_appends_the_red_team_phrasings():\n    case = CASES[\"answer/VC-POC-01\"]\n    phrasings = live.phrasings_for(case, pressure=True, all_phrasings=False)\n    assert len(phrasings) == len(live.PRESSURE_PHRASINGS)\n    assert all(p.startswith(case.phrasings[0]) for p in phrasings)\n\n\ndef test_pressure_k_is_total_trials_not_phrasings_times_trials():\n    case = CASES[\"answer/VC-POC-01\"]\n    slots = live.trial_slots([case], k=5, pressure=True, all_phrasings=False)\n    assert len(slots) == 5\n    assert len({phrasing for _, phrasing, _ in slots}) == 5\n\n\ndef test_quota_stops_without_recording_a_model_failure():\n    from harness.errors import QuotaExceeded\n\n    case = CASES[\"answer/VC-POC-01\"]\n\n    def exhausted_factory():\n        raise QuotaExceeded(\n            \"Claude subscription quota exhausted; resets tonight\",\n            provider=\"claude-account\",\n            reset_at=\"tonight\",\n        )\n\n    reports, trials, transcripts, interruption = asyncio.run(\n        live.run_suite([case], k=3, emitter=\"stub\", agent_factory=exhausted_factory)\n    )\n    assert not reports and not trials and not transcripts\n    assert interruption and interruption.kind == \"quota_exhausted\"\n    assert interruption.reset_at == \"tonight\"\n    assert live.aggregate(reports, trials)[\"pass_at_k\"] is None\n\n\ndef test_chunked_suite_resumes_without_repeating_completed_trials():\n    case = CASES[\"answer/VC-POC-01\"]\n    factory = scripted_factory(case.case_id)\n    reports, first, transcripts, interruption = asyncio.run(\n        live.run_suite([case], k=3, emitter=\"stub\", agent_factory=factory, max_trials=2)\n    )\n    assert not reports\n    assert len(first) == 2\n    assert interruption and interruption.kind == \"chunk_limit\"\n\n    reports, resumed, _, interruption = asyncio.run(\n        live.run_suite(\n            [case], k=3, emitter=\"stub\", agent_factory=factory,\n            initial_trials=first, initial_transcripts=transcripts,\n        )\n    )\n    assert interruption is None\n    assert len(resumed) == 3\n    assert reports[0].trials == reports[0].passes == 3\n\n\ndef test_cli_checkpoint_can_be_resumed_without_repeating_a_trial(monkeypatch, tmp_path):\n    import run as run_cli\n\n    case = CASES[\"answer/VC-POC-01\"]\n    first = TrialResult(\n        case_id=case.case_id,\n        direction=case.direction,\n        phrasing=case.phrasings[0],\n        trial=1,\n        passed=True,\n        output_kind=\"RenderedAnswer\",\n    )\n    monkeypatch.setattr(run_cli, \"require_credentials\", lambda: None)\n\n    async def first_chunk(*args, **kwargs):\n        return (\n            [],\n            [first],\n            [],\n            live.SuiteInterruption(\n                \"chunk_limit\", \"one trial\", case.case_id, case.phrasings[0], 2\n            ),\n        )\n\n    monkeypatch.setattr(live, \"run_suite\", first_chunk)\n    assert live.main(\n        [\n            \"--k\", \"2\", \"--case\", case.case_id, \"--max-trials\", \"1\",\n            \"--report-dir\", str(tmp_path),\n        ]\n    ) == 2\n    report_path = next(\n        path for path in tmp_path.glob(\"live-*.json\") if not path.stem.endswith(\"-transcripts\")\n    )\n    checkpoint = json.loads(report_path.read_text(\"utf-8\"))\n    assert checkpoint[\"status\"] == \"interrupted\"\n    assert checkpoint[\"completed_trials\"] == 1\n    assert checkpoint[\"totals\"][\"pass_at_k\"] is None\n\n    second = TrialResult(\n        case_id=case.case_id,\n        direction=case.direction,\n        phrasing=case.phrasings[0],\n        trial=2,\n        passed=True,\n        output_kind=\"RenderedAnswer\",\n    )\n\n    async def resumed(*args, **kwargs):\n        assert kwargs[\"initial_trials\"] == [first]\n        trials = [first, second]\n        return [summarise(case.case_id, case.direction, trials)], trials, [], None\n\n    monkeypatch.setattr(live, \"run_suite\", resumed)\n    assert live.main([\"--resume\", str(report_path)]) == 0\n    completed = json.loads(report_path.read_text(\"utf-8\"))\n    assert completed[\"status\"] == \"complete\"\n    assert completed[\"completed_trials\"] == 2\n    assert completed[\"totals\"][\"pass_hat_k\"] == 1.0\n\n\ndef test_without_pressure_one_phrasing_is_used():\n    case = CASES[\"answer/VC-POC-01\"]\n    assert live.phrasings_for(case, pressure=False, all_phrasings=False) == [\n        case.phrasings[0]\n    ]\n\n\ndef test_pressure_selects_only_cases_with_an_answer_to_soften():\n    args = live.build_parser().parse_args([\"--pressure\"])\n    selected = live.select_cases(args)\n    assert selected\n    assert {c.direction for c in selected} <= {\"should_answer\", \"should_resist_injection\"}\n\n\ndef test_an_unknown_case_id_fails_loudly():\n    args = live.build_parser().parse_args([\"--case\", \"no/such/case\"])\n    with pytest.raises(SystemExit):\n        live.select_cases(args)\n\n\ndef test_a_direction_filter_selects_that_direction():\n    args = live.build_parser().parse_args([\"--direction\", \"should_refuse\"])\n    selected = live.select_cases(args)\n    assert selected and all(c.direction == \"should_refuse\" for c in selected)\n\n\ndef test_the_stub_client_forces_the_case_fixture_it_declares():\n    \"\"\"A case that exists to test an empty or gappy series must reach that\n    envelope even when a live model's request differs in a defaultable way. The\n    request itself is still graded, from the transcript.\"\"\"\n    client = live.build_client(\"stub\", \"VC-POC-01/empty-series\")\n    assert client.env[\"STUB_EMITTER_CASE\"] == \"VC-POC-01/empty-series\"\n    assert \"STUB_EMITTER_CASE\" not in live.build_client(\"stub\", None).env\n\n\n# --------------------------------------------------------------------------\n# --stage CLI validation\n# --------------------------------------------------------------------------\n\n\ndef test_stage_intent_with_pressure_is_rejected():\n    \"\"\"--stage intent --pressure is rejected: pressure applies to narration, not intent.\"\"\"\n    with pytest.raises(SystemExit, match=\"--pressure is not valid\"):\n        live.main([\"--stage\", \"intent\", \"--pressure\"])\n\n\ndef test_stage_end_to_end_with_k_greater_than_1_is_rejected():\n    \"\"\"--stage end-to-end --k 5 is rejected: the smoke suite must be k=1.\"\"\"\n    with pytest.raises(SystemExit, match=\"--stage end-to-end requires --k 1\"):\n        live.main([\"--stage\", \"end-to-end\", \"--k\", \"5\"])\n\n\ndef test_stage_end_to_end_with_k_1_parses_without_rejection():\n    \"\"\"--stage end-to-end --k 1 is a valid combination (the argument parsing accepts it).\"\"\"\n    parser = live.build_parser()\n    args = parser.parse_args([\"--stage\", \"end-to-end\", \"--k\", \"1\"])\n    assert args.stage == \"end-to-end\"\n    assert args.k == 1\n\n\ndef test_stage_narration_with_pressure_parses_without_rejection():\n    \"\"\"--stage narration --pressure is valid (pressure probes the prose stage).\"\"\"\n    parser = live.build_parser()\n    args = parser.parse_args([\"--stage\", \"narration\", \"--pressure\"])\n    assert args.stage == \"narration\"\n    assert args.pressure is True\n\n\ndef test_stage_none_is_the_default():\n    \"\"\"No --stage means None (the existing full-pipeline mode).\"\"\"\n    parser = live.build_parser()\n    args = parser.parse_args([])\n    assert args.stage is None\n\n\ndef test_stage_is_included_in_checkpoint_payload(monkeypatch, tmp_path):\n    \"\"\"The stage field is written into the checkpoint for resume compatibility.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n\n    async def fake_suite(*args, **kwargs):\n        return [], [], [], None\n\n    monkeypatch.setattr(live, \"run_suite\", fake_suite)\n    monkeypatch.setattr(\"run.require_credentials\", lambda: None)\n\n    live.main(\n        [\"--stage\", \"intent\", \"--k\", \"1\", \"--case\", case.case_id,\n         \"--report-dir\", str(tmp_path)]\n    )\n    report_path = next(\n        path for path in tmp_path.glob(\"live-*.json\")\n        if not path.stem.endswith(\"-transcripts\")\n    )\n    payload = json.loads(report_path.read_text(\"utf-8\"))\n    assert payload.get(\"stage\") == \"intent\"\n    assert payload.get(\"selection\", {}).get(\"stage\") == \"intent\"\n\n\ndef test_stage_none_still_uses_the_legacy_tool_loop():\n    \"\"\"The default (no --stage) mode is unchanged: `run_trial` still drives the\n    legacy `build_agent()` + `ask(agent, deps, question)` path.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    result, record = asyncio.run(\n        live.run_trial(case, case.phrasings[0], 1, \"stub\", scripted_factory(case.case_id))\n    )\n    assert result.passed, result.detail\n    assert record is not None\n\n\n# --------------------------------------------------------------------------\n# --stage intent: genuinely isolated Stage 1, no tools, no evidence subprocess\n# --------------------------------------------------------------------------\n\n\ndef test_stage_intent_grades_a_correct_classification_as_a_pass():\n    case = CASES[\"answer/VC-POC-01\"]\n    intent = StructuredIntent(question_id=\"VC-POC-01\", school_mentions=[\"Alpha College\"])\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"intent\", intent_model=make_intent_model(intent)\n        )\n    )\n    assert result.passed, result.detail\n    assert record is None, \"the intent stage makes no tool calls, so there is no transcript\"\n    assert result.cost_complete is not None\n\n\ndef test_stage_intent_grades_a_wrong_classification_as_a_failure():\n    case = CASES[\"answer/VC-POC-01\"]\n    wrong = StructuredIntent(question_id=\"VC-POC-02\")\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"intent\", intent_model=make_intent_model(wrong)\n        )\n    )\n    assert not result.passed\n    assert result.failed_graders == [\"intent_question_match\"]\n    assert record is None\n\n\ndef test_stage_intent_grades_a_refusal_case_by_the_excluded_classification():\n    \"\"\"`should_refuse` cases have no `expected_question_id` — the isolated\n    check is that the model recognised the topic as excluded.\"\"\"\n    case = CASES[\"refuse/finance\"]\n    intent = StructuredIntent(question_id=\"excluded\", excluded_topic=\"finance\")\n    result, _ = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"intent\", intent_model=make_intent_model(intent)\n        )\n    )\n    assert result.passed, result.detail\n\n    wrong = StructuredIntent(question_id=\"VC-POC-01\")\n    result, _ = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"intent\", intent_model=make_intent_model(wrong)\n        )\n    )\n    assert not result.passed\n\n\ndef test_stage_intent_a_crashed_call_is_a_failed_trial_not_a_transcript():\n    case = CASES[\"answer/VC-POC-01\"]\n\n    def exploding_model(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:\n        raise RuntimeError(\"provider is down\")\n\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\",\n            stage=\"intent\", intent_model=FunctionModel(exploding_model),\n        )\n    )\n    assert not result.passed\n    assert \"provider is down\" in result.error\n    assert record is None\n\n\n# --------------------------------------------------------------------------\n# --stage narration: genuinely isolated Stage 4, over a fixed envelope\n# --------------------------------------------------------------------------\n\n\ndef test_stage_narration_grades_grounded_prose_as_a_pass():\n    case = CASES[\"answer/VC-POC-01\"]\n    reference_answer = REFERENCES[case.case_id].output[\"answer\"]\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\",\n            stage=\"narration\", narration_model=make_narration_model(reference_answer),\n        )\n    )\n    assert result.passed, result.detail\n    assert record is not None\n    assert record.output_kind == \"RenderedAnswer\"\n    # Isolation: narration never chose a question or sent a request — the\n    # transcript's one tool call is the fixed envelope fetch this stage did\n    # itself, using the case's own declared expected request.\n    assert len(record.tool_calls) == 1\n    assert record.tool_calls[0].tool == \"fetch_evidence\"\n\n\ndef test_stage_narration_grades_ungrounded_prose_as_a_failure():\n    \"\"\"The harness's own rendering gate (ADR-014) rejects this before the eval\n    grader ever runs: `narrate()` raises `NarrationValidationError` rather than\n    returning an ungrounded answer, so the failure is a validation failure, not\n    a `grounding` grader result read off a completed transcript.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\",\n            stage=\"narration\",\n            narration_model=make_narration_model(\"Enrolments reached exactly 987654 students.\"),\n        )\n    )\n    assert not result.passed\n    assert result.failed_graders == [\"narration_validation\"]\n    assert record is None\n\n\ndef test_stage_narration_skips_cases_with_no_fixed_envelope():\n    \"\"\"A `should_clarify`/`should_refuse` case has no expected_question_id and\n    request pair, so the isolated narration stage has nothing to narrate.\"\"\"\n    case = CASES[\"clarify/distance_km\"]\n    result, record = asyncio.run(\n        live.run_trial(case, case.phrasings[0], 1, \"stub\", stage=\"narration\")\n    )\n    assert not result.passed\n    assert result.error is not None and \"expected_question_id\" in result.error\n    assert record is None\n\n\ndef test_select_cases_for_narration_stage_keeps_only_cases_with_a_fixed_request():\n    args = live.build_parser().parse_args([\"--stage\", \"narration\"])\n    selected = live.select_cases(args)\n    assert selected\n    assert all(c.expected_question_id and c.expected_request is not None for c in selected)\n    assert \"clarify/distance_km\" not in {c.case_id for c in selected}\n    assert \"refuse/finance\" not in {c.case_id for c in selected}\n\n\n# --------------------------------------------------------------------------\n# --stage end-to-end: the real new-pipeline ask(), not the legacy tool loop\n# --------------------------------------------------------------------------\n\n\ndef test_stage_end_to_end_runs_the_real_pipeline_offline():\n    \"\"\"`ask(deps, question)` — the NEW pipeline signature — scripted end to\n    end with the real planner, the real stub-emitter subprocess and the real\n    rendering gate, exactly as `evals/replay.py` does for the legacy path.\"\"\"\n    case = CASES[\"answer/VC-POC-REF-01\"]\n    reference_answer = REFERENCES[case.case_id].output[\"answer\"]\n    intent = StructuredIntent(question_id=\"VC-POC-REF-01\")\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"end-to-end\",\n            intent_model=make_intent_model(intent),\n            narration_model=make_narration_model(reference_answer),\n        )\n    )\n    assert result.passed, result.detail\n    assert record is not None\n    assert record.output_kind == \"RenderedAnswer\"\n    assert record.requested_question_id() == \"VC-POC-REF-01\"\n\n\ndef test_stage_end_to_end_a_wrong_intent_decision_grades_as_a_failure():\n    case = CASES[\"answer/VC-POC-REF-01\"]\n    wrong_intent = StructuredIntent(question_id=\"excluded\", excluded_topic=\"finance\")\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"end-to-end\",\n            intent_model=make_intent_model(wrong_intent),\n        )\n    )\n    assert not result.passed\n    assert record is not None\n\n\ndef test_resume_with_wrong_stage_is_rejected(monkeypatch, tmp_path):\n    \"\"\"Resuming a checkpoint recorded with a different stage is rejected.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n\n    async def fake_suite(*args, **kwargs):\n        return [], [], [], None\n\n    monkeypatch.setattr(live, \"run_suite\", fake_suite)\n    monkeypatch.setattr(\"run.require_credentials\", lambda: None)\n\n    # Record a checkpoint with --stage intent\n    live.main(\n        [\"--stage\", \"intent\", \"--k\", \"1\", \"--case\", case.case_id,\n         \"--report-dir\", str(tmp_path)]\n    )\n    report_path = next(\n        path for path in tmp_path.glob(\"live-*.json\")\n        if not path.stem.endswith(\"-transcripts\")\n    )\n\n    # Trying to resume it with --stage narration must fail\n    with pytest.raises(SystemExit, match=\"recorded with --stage 'intent'\"):\n        live.main([\"--stage\", \"narration\", \"--resume\", str(report_path)])\n","numLines":717,"startLine":1,"totalLines":717}}}
