{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GTxTwZK9Q1ybrybWZKtF6K","type":"tool_result","content":"1\t\"\"\"Stage 3 of the 4-stage pipeline: deterministic answer view assembly.\n2\t\n3\t`build_answer_view()` takes an evidence envelope and produces an `AnswerView` —\n4\ta compact, structured representation of the evidence that the narration stage\n5\treceives as its sole input. No model calls. Pure function.\n6\t\n7\tWhy a separate view rather than handing the raw envelope to narration? Two reasons:\n8\t\n9\t1. The envelope can be large. `summary_rows` caps the rows passed to the model\n10\t   (mirroring `_truncate_rows()` in tools.py), while `build_answer_view()` records\n11\t   the full envelope on `deps.last_envelope` for grounding validation.\n12\t\n13\t2. Separation of concerns: the narration model receives exactly what the answer\n14\t   view exposes — no more, no less. A future change to what narration sees is a\n15\t   change to `AnswerView`, not a change scattered across the pipeline.\n16\t\n17\t`data_status_note` is pre-computed here from `rendering.coverage_status()` and\n18\t`rendering.absent_years()`, so the narration model can copy it verbatim rather\n19\tthan reconstructing it from coverage data it was not given.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import Any\n25\t\n26\tfrom pydantic import BaseModel, Field\n27\t\n28\tfrom config import settings\n29\tfrom harness import rendering\n30\t\n31\tMAX_ROWS_IN_CONTEXT = settings.MAX_ROWS_IN_CONTEXT\n32\t\n33\t\n34\tclass AnswerView(BaseModel):\n35\t    \"\"\"A compact, model-ready view of a fetched evidence envelope.\n36\t\n37\t    Every field here is deterministically assembled from the envelope in code.\n38\t    The narration model receives this and nothing else; it cannot access the\n39\t    raw envelope.\n40\t    \"\"\"\n41\t\n42\t    question_id: str\n43\t    contract_version: str\n44\t    evidence: list[dict[str, Any]]\n45\t    provenance: dict[str, Any]\n46\t    confidence: dict[str, Any]\n47\t    limitations: list[str]\n48\t    deterministic_signals: list[dict[str, Any]] = Field(default_factory=list)\n49\t    resolved_request: dict[str, Any] = Field(default_factory=dict)\n50\t    data_status: dict[str, Any] = Field(default_factory=dict)\n51\t    claim_eligibility: dict[str, Any] = Field(default_factory=dict)\n52\t    # Pre-computed from envelope — the narration model copies this verbatim.\n53\t    data_status_note: str = Field(\n54\t        default=\"\",\n55\t        description=(\n56\t            \"What was empty or gappy, as the data layer stated it. \"\n57\t            \"Empty string when the series is complete.\"\n58\t        ),\n59\t    )\n60\t    # Capped rows for context. The full envelope is on deps.last_envelope for\n61\t    # grounding validation (the validator grounds against the full envelope,\n62\t    # not against these rows).\n63\t    summary_rows: list[dict[str, Any]] = Field(\n64\t        default_factory=list,\n65\t        description=(\n66\t            f\"First {MAX_ROWS_IN_CONTEXT} rows from the result data, \"\n67\t            \"for narration context. Never the full dataset.\"\n68\t        ),\n69\t    )\n70\t    # Reserved for a future chart specification; None for now.\n71\t    chart_spec: dict[str, Any] | None = Field(\n72\t        default=None,\n73\t        description=\"Reserved. Always None in v1.\",\n74\t    )\n75\t\n76\t\n77\tdef _extract_summary_rows(envelope: dict[str, Any]) -> list[dict[str, Any]]:\n78\t    \"\"\"Cap the data rows handed to the narration model, always with a marker.\n79\t\n80\t    Mirrors `_truncate_rows()` in tools.py: the narration model sees at most\n81\t    `MAX_ROWS_IN_CONTEXT` rows. The full data is on deps for grounding validation.\n82\t    \"\"\"\n83\t    data = envelope.get(\"result\", {}).get(\"data\")\n84\t    if not isinstance(data, dict):\n85\t        if isinstance(data, list):\n86\t            return data[:MAX_ROWS_IN_CONTEXT]\n87\t        return []\n88\t\n89\t    # Find the first list-valued key in the data dict\n90\t    for value in data.values():\n91\t        if isinstance(value, list):\n92\t            return value[:MAX_ROWS_IN_CONTEXT]\n93\t    return []\n94\t\n95\t\n96\tdef _compute_data_status_note(envelope: dict[str, Any]) -> str:\n97\t    \"\"\"Pre-compute the data_status_note the narration model must copy verbatim.\n98\t\n99\t    Mirrors the logic the old AnswerDraft.data_status_note field carried, but\n100\t    computed deterministically rather than authored by the model.\n101\t    \"\"\"\n102\t    status = rendering.coverage_status(envelope)\n103\t    if not status or status == \"complete\":\n104\t        return \"\"\n105\t\n106\t    if status == \"empty\":\n107\t        return \"The data layer returned no data for this request.\"\n108\t\n109\t    if status == \"partial\":\n110\t        absent = rendering.absent_years(envelope)\n111\t        if absent:\n112\t            years_str = \", \".join(str(y) for y in absent)\n113\t            return (\n114\t                f\"Coverage is partial: no data was returned for \"\n115\t                f\"{years_str}. The data layer states no cause.\"\n116\t            )\n117\t        return \"Coverage is partial: the data layer returned incomplete data.\"\n118\t\n119\t    return \"\"\n120\t\n121\t\n122\tdef build_answer_view(envelope: dict[str, Any]) -> AnswerView:\n123\t    \"\"\"Deterministically build an AnswerView from an evidence envelope.\n124\t\n125\t    This is a pure function: same envelope in, same AnswerView out. It never\n126\t    calls a model, opens a file, or raises — all fields have safe defaults.\n127\t    \"\"\"\n128\t    return AnswerView(\n129\t        question_id=envelope.get(\"question_id\", \"\"),\n130\t        contract_version=envelope.get(\"contract_version\", \"\"),\n131\t        evidence=envelope.get(\"evidence\", []),\n132\t        provenance=envelope.get(\"provenance\", {}),\n133\t        confidence=envelope.get(\"confidence\", {}),\n134\t        limitations=envelope.get(\"limitations\", []),\n135\t        deterministic_signals=envelope.get(\"deterministic_signals\", []),\n136\t        resolved_request=envelope.get(\"resolved_request\", {}),\n137\t        data_status=envelope.get(\"data_status\", {}),\n138\t        claim_eligibility=envelope.get(\"claim_eligibility\", {}),\n139\t        data_status_note=_compute_data_status_note(envelope),\n140\t        summary_rows=_extract_summary_rows(envelope),\n141\t        chart_spec=None,\n142\t    )\n143\t"}]},"parent_tool_use_id":null,"session_id":"2e8b7dde-8bb0-4345-aaad-7bcee95758ae","uuid":"949d2586-722b-43a9-8906-780a4af903e0","timestamp":"2026-09-26T09:59:48.055Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/harness/answer_view.py","content":"\"\"\"Stage 3 of the 4-stage pipeline: deterministic answer view assembly.\n\n`build_answer_view()` takes an evidence envelope and produces an `AnswerView` —\na compact, structured representation of the evidence that the narration stage\nreceives as its sole input. No model calls. Pure function.\n\nWhy a separate view rather than handing the raw envelope to narration? Two reasons:\n\n1. The envelope can be large. `summary_rows` caps the rows passed to the model\n   (mirroring `_truncate_rows()` in tools.py), while `build_answer_view()` records\n   the full envelope on `deps.last_envelope` for grounding validation.\n\n2. Separation of concerns: the narration model receives exactly what the answer\n   view exposes — no more, no less. A future change to what narration sees is a\n   change to `AnswerView`, not a change scattered across the pipeline.\n\n`data_status_note` is pre-computed here from `rendering.coverage_status()` and\n`rendering.absent_years()`, so the narration model can copy it verbatim rather\nthan reconstructing it from coverage data it was not given.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any\n\nfrom pydantic import BaseModel, Field\n\nfrom config import settings\nfrom harness import rendering\n\nMAX_ROWS_IN_CONTEXT = settings.MAX_ROWS_IN_CONTEXT\n\n\nclass AnswerView(BaseModel):\n    \"\"\"A compact, model-ready view of a fetched evidence envelope.\n\n    Every field here is deterministically assembled from the envelope in code.\n    The narration model receives this and nothing else; it cannot access the\n    raw envelope.\n    \"\"\"\n\n    question_id: str\n    contract_version: str\n    evidence: list[dict[str, Any]]\n    provenance: dict[str, Any]\n    confidence: dict[str, Any]\n    limitations: list[str]\n    deterministic_signals: list[dict[str, Any]] = Field(default_factory=list)\n    resolved_request: dict[str, Any] = Field(default_factory=dict)\n    data_status: dict[str, Any] = Field(default_factory=dict)\n    claim_eligibility: dict[str, Any] = Field(default_factory=dict)\n    # Pre-computed from envelope — the narration model copies this verbatim.\n    data_status_note: str = Field(\n        default=\"\",\n        description=(\n            \"What was empty or gappy, as the data layer stated it. \"\n            \"Empty string when the series is complete.\"\n        ),\n    )\n    # Capped rows for context. The full envelope is on deps.last_envelope for\n    # grounding validation (the validator grounds against the full envelope,\n    # not against these rows).\n    summary_rows: list[dict[str, Any]] = Field(\n        default_factory=list,\n        description=(\n            f\"First {MAX_ROWS_IN_CONTEXT} rows from the result data, \"\n            \"for narration context. Never the full dataset.\"\n        ),\n    )\n    # Reserved for a future chart specification; None for now.\n    chart_spec: dict[str, Any] | None = Field(\n        default=None,\n        description=\"Reserved. Always None in v1.\",\n    )\n\n\ndef _extract_summary_rows(envelope: dict[str, Any]) -> list[dict[str, Any]]:\n    \"\"\"Cap the data rows handed to the narration model, always with a marker.\n\n    Mirrors `_truncate_rows()` in tools.py: the narration model sees at most\n    `MAX_ROWS_IN_CONTEXT` rows. The full data is on deps for grounding validation.\n    \"\"\"\n    data = envelope.get(\"result\", {}).get(\"data\")\n    if not isinstance(data, dict):\n        if isinstance(data, list):\n            return data[:MAX_ROWS_IN_CONTEXT]\n        return []\n\n    # Find the first list-valued key in the data dict\n    for value in data.values():\n        if isinstance(value, list):\n            return value[:MAX_ROWS_IN_CONTEXT]\n    return []\n\n\ndef _compute_data_status_note(envelope: dict[str, Any]) -> str:\n    \"\"\"Pre-compute the data_status_note the narration model must copy verbatim.\n\n    Mirrors the logic the old AnswerDraft.data_status_note field carried, but\n    computed deterministically rather than authored by the model.\n    \"\"\"\n    status = rendering.coverage_status(envelope)\n    if not status or status == \"complete\":\n        return \"\"\n\n    if status == \"empty\":\n        return \"The data layer returned no data for this request.\"\n\n    if status == \"partial\":\n        absent = rendering.absent_years(envelope)\n        if absent:\n            years_str = \", \".join(str(y) for y in absent)\n            return (\n                f\"Coverage is partial: no data was returned for \"\n                f\"{years_str}. The data layer states no cause.\"\n            )\n        return \"Coverage is partial: the data layer returned incomplete data.\"\n\n    return \"\"\n\n\ndef build_answer_view(envelope: dict[str, Any]) -> AnswerView:\n    \"\"\"Deterministically build an AnswerView from an evidence envelope.\n\n    This is a pure function: same envelope in, same AnswerView out. It never\n    calls a model, opens a file, or raises — all fields have safe defaults.\n    \"\"\"\n    return AnswerView(\n        question_id=envelope.get(\"question_id\", \"\"),\n        contract_version=envelope.get(\"contract_version\", \"\"),\n        evidence=envelope.get(\"evidence\", []),\n        provenance=envelope.get(\"provenance\", {}),\n        confidence=envelope.get(\"confidence\", {}),\n        limitations=envelope.get(\"limitations\", []),\n        deterministic_signals=envelope.get(\"deterministic_signals\", []),\n        resolved_request=envelope.get(\"resolved_request\", {}),\n        data_status=envelope.get(\"data_status\", {}),\n        claim_eligibility=envelope.get(\"claim_eligibility\", {}),\n        data_status_note=_compute_data_status_note(envelope),\n        summary_rows=_extract_summary_rows(envelope),\n        chart_spec=None,\n    )\n","numLines":143,"startLine":1,"totalLines":143}}}
