{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DG63rbmQeimMG4h5DCSJHT","type":"tool_result","content":"40\t\n41\t# In pydantic-ai 1.106.0, a single (non-union) output type uses \"final_result\"\n42\t# as the tool name (see tests/unit/test_intent_boundary.py). Both the intent\n43\t# and narration agents have single output types.\n44\tINTENT_TOOL = \"final_result\"\n45\tNARRATION_TOOL = \"final_result\"\n46\t\n47\t\n48\tdef make_intent_model(intent: StructuredIntent) -> FunctionModel:\n49\t    \"\"\"A model that returns a fixed StructuredIntent immediately.\"\"\"\n50\t    payload = intent.model_dump()\n51\t\n52\t    def fn(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:\n53\t        return ModelResponse(parts=[ToolCallPart(INTENT_TOOL, payload)])\n54\t\n55\t    return FunctionModel(fn)\n56\t\n57\t\n58\tdef make_narration_model(answer: str) -> FunctionModel:\n59\t    \"\"\"A model that returns fixed narration immediately.\"\"\"\n60\t\n61\t    def fn(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:\n62\t        return ModelResponse(parts=[ToolCallPart(NARRATION_TOOL, {\"answer\": answer})])\n63\t\n64\t    return FunctionModel(fn)\n65\t\n66\t\n67\tdef _drop_generated_utc(output: dict) -> dict:\n68\t    \"\"\"Two separate stub-emitter fetches stamp `provenance.generated_utc` with\n69\t    the wall clock at call time (second precision), so two runs a moment apart\n70\t    can legitimately disagree on that one field alone — the same reason\n71\t    `evals/schema.py` notes the replay-equality rule excludes it (CR-6). Strip\n72\t    it before comparing two records for otherwise-exact equality.\"\"\"\n73\t    out = dict(output)\n74\t    provenance = out.get(\"provenance\")\n75\t    if isinstance(provenance, dict) and \"generated_utc\" in provenance:\n76\t        out = dict(out)\n77\t        out[\"provenance\"] = {k: v for k, v in provenance.items() if k != \"generated_utc\"}\n78\t    return out\n79\t\n80\t\n81\tdef trial(passed: bool, graders: list[str] | None = None, **kwargs) -> TrialResult:\n82\t    return TrialResult(\n83\t        case_id=\"c\",\n84\t        direction=\"should_answer\","}]},"parent_tool_use_id":null,"session_id":"2e8b7dde-8bb0-4345-aaad-7bcee95758ae","uuid":"6956e6af-a348-4be5-bdba-d0d189c01f01","timestamp":"2026-09-26T10:09:05.536Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/tests/unit/test_live_tier.py","content":"\n# In pydantic-ai 1.106.0, a single (non-union) output type uses \"final_result\"\n# as the tool name (see tests/unit/test_intent_boundary.py). Both the intent\n# and narration agents have single output types.\nINTENT_TOOL = \"final_result\"\nNARRATION_TOOL = \"final_result\"\n\n\ndef make_intent_model(intent: StructuredIntent) -> FunctionModel:\n    \"\"\"A model that returns a fixed StructuredIntent immediately.\"\"\"\n    payload = intent.model_dump()\n\n    def fn(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:\n        return ModelResponse(parts=[ToolCallPart(INTENT_TOOL, payload)])\n\n    return FunctionModel(fn)\n\n\ndef make_narration_model(answer: str) -> FunctionModel:\n    \"\"\"A model that returns fixed narration immediately.\"\"\"\n\n    def fn(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:\n        return ModelResponse(parts=[ToolCallPart(NARRATION_TOOL, {\"answer\": answer})])\n\n    return FunctionModel(fn)\n\n\ndef _drop_generated_utc(output: dict) -> dict:\n    \"\"\"Two separate stub-emitter fetches stamp `provenance.generated_utc` with\n    the wall clock at call time (second precision), so two runs a moment apart\n    can legitimately disagree on that one field alone — the same reason\n    `evals/schema.py` notes the replay-equality rule excludes it (CR-6). Strip\n    it before comparing two records for otherwise-exact equality.\"\"\"\n    out = dict(output)\n    provenance = out.get(\"provenance\")\n    if isinstance(provenance, dict) and \"generated_utc\" in provenance:\n        out = dict(out)\n        out[\"provenance\"] = {k: v for k, v in provenance.items() if k != \"generated_utc\"}\n    return out\n\n\ndef trial(passed: bool, graders: list[str] | None = None, **kwargs) -> TrialResult:\n    return TrialResult(\n        case_id=\"c\",\n        direction=\"should_answer\",","numLines":45,"startLine":40,"totalLines":1011}}}
