{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KSczsCqHYtAuJc229EKnXF","type":"tool_result","content":"440\t\n441\tdef test_a_direction_filter_selects_that_direction():\n442\t    args = live.build_parser().parse_args([\"--direction\", \"should_refuse\"])\n443\t    selected = live.select_cases(args)\n444\t    assert selected and all(c.direction == \"should_refuse\" for c in selected)\n445\t\n446\t\n447\tdef test_the_stub_client_forces_the_case_fixture_it_declares():\n448\t    \"\"\"A case that exists to test an empty or gappy series must reach that\n449\t    envelope even when a live model's request differs in a defaultable way. The\n450\t    request itself is still graded, from the transcript.\"\"\"\n451\t    client = live.build_client(\"stub\", \"VC-POC-01/empty-series\")\n452\t    assert client.env[\"STUB_EMITTER_CASE\"] == \"VC-POC-01/empty-series\"\n453\t    assert \"STUB_EMITTER_CASE\" not in live.build_client(\"stub\", None).env\n454\t\n455\t\n456\t# --------------------------------------------------------------------------\n457\t# --stage CLI validation\n458\t# --------------------------------------------------------------------------\n459\t\n460\t\n461\tdef test_stage_intent_with_pressure_is_rejected():\n462\t    \"\"\"--stage intent --pressure is rejected: pressure applies to narration, not intent.\"\"\"\n463\t    with pytest.raises(SystemExit, match=\"--pressure is not valid\"):\n464\t        live.main([\"--stage\", \"intent\", \"--pressure\"])\n465\t\n466\t\n467\tdef test_stage_end_to_end_with_k_greater_than_1_is_rejected():\n468\t    \"\"\"--stage end-to-end --k 5 is rejected: the smoke suite must be k=1.\"\"\"\n469\t    with pytest.raises(SystemExit, match=\"--stage end-to-end requires --k 1\"):\n470\t        live.main([\"--stage\", \"end-to-end\", \"--k\", \"5\"])\n471\t\n472\t\n473\tdef test_stage_end_to_end_with_k_1_parses_without_rejection():\n474\t    \"\"\"--stage end-to-end --k 1 is a valid combination (the argument parsing accepts it).\"\"\"\n475\t    parser = live.build_parser()\n476\t    args = parser.parse_args([\"--stage\", \"end-to-end\", \"--k\", \"1\"])\n477\t    assert args.stage == \"end-to-end\"\n478\t    assert args.k == 1\n479\t\n480\t\n481\tdef test_stage_narration_with_pressure_parses_without_rejection():\n482\t    \"\"\"--stage narration --pressure is valid (pressure probes the prose stage).\"\"\"\n483\t    parser = live.build_parser()\n484\t    args = parser.parse_args([\"--stage\", \"narration\", \"--pressure\"])\n485\t    assert args.stage == \"narration\"\n486\t    assert args.pressure is True\n487\t\n488\t\n489\tdef test_stage_none_is_the_default():\n490\t    \"\"\"No --stage means None (the existing full-pipeline mode).\"\"\"\n491\t    parser = live.build_parser()\n492\t    args = parser.parse_args([])\n493\t    assert args.stage is None\n494\t\n495\t\n496\tdef test_stage_is_included_in_checkpoint_payload(monkeypatch, tmp_path):\n497\t    \"\"\"The stage field is written into the checkpoint for resume compatibility.\"\"\"\n498\t    case = CASES[\"answer/VC-POC-01\"]\n499\t\n500\t    async def fake_suite(*args, **kwargs):\n501\t        return [], [], [], None\n502\t\n503\t    monkeypatch.setattr(live, \"run_suite\", fake_suite)\n504\t    monkeypatch.setattr(\"run.require_credentials\", lambda: None)\n505\t\n506\t    live.main(\n507\t        [\"--stage\", \"intent\", \"--k\", \"1\", \"--case\", case.case_id,\n508\t         \"--report-dir\", str(tmp_path)]\n509\t    )"}]},"parent_tool_use_id":null,"session_id":"2e8b7dde-8bb0-4345-aaad-7bcee95758ae","uuid":"ef79bba0-35aa-4cd7-b625-01c0e2bcc73f","timestamp":"2026-09-26T10:05:52.346Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/tests/unit/test_live_tier.py","content":"\ndef test_a_direction_filter_selects_that_direction():\n    args = live.build_parser().parse_args([\"--direction\", \"should_refuse\"])\n    selected = live.select_cases(args)\n    assert selected and all(c.direction == \"should_refuse\" for c in selected)\n\n\ndef test_the_stub_client_forces_the_case_fixture_it_declares():\n    \"\"\"A case that exists to test an empty or gappy series must reach that\n    envelope even when a live model's request differs in a defaultable way. The\n    request itself is still graded, from the transcript.\"\"\"\n    client = live.build_client(\"stub\", \"VC-POC-01/empty-series\")\n    assert client.env[\"STUB_EMITTER_CASE\"] == \"VC-POC-01/empty-series\"\n    assert \"STUB_EMITTER_CASE\" not in live.build_client(\"stub\", None).env\n\n\n# --------------------------------------------------------------------------\n# --stage CLI validation\n# --------------------------------------------------------------------------\n\n\ndef test_stage_intent_with_pressure_is_rejected():\n    \"\"\"--stage intent --pressure is rejected: pressure applies to narration, not intent.\"\"\"\n    with pytest.raises(SystemExit, match=\"--pressure is not valid\"):\n        live.main([\"--stage\", \"intent\", \"--pressure\"])\n\n\ndef test_stage_end_to_end_with_k_greater_than_1_is_rejected():\n    \"\"\"--stage end-to-end --k 5 is rejected: the smoke suite must be k=1.\"\"\"\n    with pytest.raises(SystemExit, match=\"--stage end-to-end requires --k 1\"):\n        live.main([\"--stage\", \"end-to-end\", \"--k\", \"5\"])\n\n\ndef test_stage_end_to_end_with_k_1_parses_without_rejection():\n    \"\"\"--stage end-to-end --k 1 is a valid combination (the argument parsing accepts it).\"\"\"\n    parser = live.build_parser()\n    args = parser.parse_args([\"--stage\", \"end-to-end\", \"--k\", \"1\"])\n    assert args.stage == \"end-to-end\"\n    assert args.k == 1\n\n\ndef test_stage_narration_with_pressure_parses_without_rejection():\n    \"\"\"--stage narration --pressure is valid (pressure probes the prose stage).\"\"\"\n    parser = live.build_parser()\n    args = parser.parse_args([\"--stage\", \"narration\", \"--pressure\"])\n    assert args.stage == \"narration\"\n    assert args.pressure is True\n\n\ndef test_stage_none_is_the_default():\n    \"\"\"No --stage means None (the existing full-pipeline mode).\"\"\"\n    parser = live.build_parser()\n    args = parser.parse_args([])\n    assert args.stage is None\n\n\ndef test_stage_is_included_in_checkpoint_payload(monkeypatch, tmp_path):\n    \"\"\"The stage field is written into the checkpoint for resume compatibility.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n\n    async def fake_suite(*args, **kwargs):\n        return [], [], [], None\n\n    monkeypatch.setattr(live, \"run_suite\", fake_suite)\n    monkeypatch.setattr(\"run.require_credentials\", lambda: None)\n\n    live.main(\n        [\"--stage\", \"intent\", \"--k\", \"1\", \"--case\", case.case_id,\n         \"--report-dir\", str(tmp_path)]\n    )","numLines":70,"startLine":440,"totalLines":989}}}
