{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0129SnMUSFjcpsrqWrzawrAA","type":"tool_result","content":"1\t\"\"\"Stage 1 of the 4-stage pipeline: intent interpretation.\n2\t\n3\tThe model sees the user's question once and returns a StructuredIntent — a\n4\tmachine-readable map of what the user is asking, which schools they named, and\n5\twhich inputs they supplied or omitted. No tools. One model call. The pipeline\n6\tbranches deterministically from there.\n7\t\n8\tWhy one call and no tools? Tools make intent interpretation retryable and\n9\tself-correcting, but intent extraction is not the kind of task that benefits from\n10\texploration: it is a classification over a closed registry. One call is also the\n11\tonly shape the pipeline's budget model supports — the intent budget is separate\n12\tfrom the narration budget, and the planner between them costs nothing.\n13\t\n14\t`build_intent_agent()` and `interpret_intent()` are the two injection points\n15\ttests need: pass a `FunctionModel` as `model` to script a deterministic intent\n16\twithout a network call. The production path calls them with `model=None`, which\n17\tresolves to the same provider wiring as `build_agent()`.\n18\t\"\"\"\n19\t\n20\tfrom __future__ import annotations\n21\t\n22\timport asyncio\n23\timport logging\n24\tfrom typing import Any\n25\t\n26\tfrom pydantic import BaseModel, Field\n27\tfrom pydantic_ai import Agent\n28\tfrom pydantic_ai.exceptions import UsageLimitExceeded\n29\tfrom pydantic_ai.usage import UsageLimits\n30\t\n31\tfrom config import settings\n32\tfrom harness.claude_account_cli import build_claude_account_model\n33\t\n34\tlogger = logging.getLogger(\"harness.intent\")\n35\t\n36\t\n37\tclass StructuredIntent(BaseModel):\n38\t    \"\"\"What the model extracted from the user's question.\n39\t\n40\t    This is the ONLY interface between Stage 1 (model) and Stage 2 (planner).\n41\t    The planner is deterministic from here: it never re-reads the question.\n42\t    \"\"\"\n43\t\n44\t    question_id: str = Field(\n45\t        description=(\n46\t            \"The registry question ID the user is asking about, e.g. 'VC-POC-01'. \"\n47\t            \"Use 'excluded' when the topic is in the excluded list. \"\n48\t            \"Use 'unknown' when no registry question covers it.\"\n49\t        )\n50\t    )\n51\t    excluded_topic: str | None = Field(\n52\t        default=None,\n53\t        description=(\n54\t            \"When question_id == 'excluded': a short keyword hint matching the \"\n55\t            \"excluded topic, e.g. 'finance', 'transport', 'sa1'. None otherwise.\"\n56\t        ),\n57\t    )\n58\t    school_mentions: list[str] = Field(\n59\t        default_factory=list,\n60\t        description=(\n61\t            \"Raw school names from the user's question, as the user wrote them. \"\n62\t            \"Empty when no school is named.\"\n63\t        ),\n64\t    )\n65\t    requested_metrics: list[str] = Field(\n66\t        default_factory=list,\n67\t        description=(\n68\t            \"Natural-language metric names the user explicitly mentioned. \"\n69\t            \"Empty when the user named no metric.\"\n70\t        ),\n71\t    )\n72\t    filters: dict[str, Any] = Field(\n73\t        default_factory=dict,\n74\t        description=(\n75\t            \"Explicit filter values the user provided (e.g. market_definition, \"\n76\t            \"distance_km, grades, sa2_codes). Do not invent values the user did not supply.\"\n77\t        ),\n78\t    )\n79\t    presentation: str = Field(\n80\t        default=\"snapshot\",\n81\t        description=(\n82\t            \"How the user wants the answer presented: \"\n83\t            \"'trend' (over time), 'comparison' (across schools), \"\n84\t            \"'snapshot' (one school, latest), 'area' (SA2-based), \"\n85\t            \"'reference' (glossary/lookup).\"\n86\t        ),\n87\t    )\n88\t    missing_material_inputs: list[str] = Field(\n89\t        default_factory=list,\n90\t        description=(\n91\t            \"Material input names that the question requires but the user did not supply. \"\n92\t            \"Only list inputs that are declared material for this question_id. \"\n93\t            \"Empty when all material inputs are present.\"\n94\t        ),\n95\t    )\n96\t\n97\t\n98\tdef _build_intent_model(model: object | None = None) -> object:\n99\t    \"\"\"Resolve the model for the intent agent, same logic as build_agent().\"\"\"\n100\t    if model is not None:\n101\t        return model\n102\t    if settings.MODEL_PROVIDER == \"claude_account\":\n103\t        return build_claude_account_model(\n104\t            binary=settings.CLAUDE_CLI,\n105\t            model=settings.CLAUDE_ACCOUNT_MODEL,\n106\t            timeout_seconds=settings.CLAUDE_CLI_TIMEOUT_SECONDS,\n107\t        )\n108\t    from anthropic import AsyncAnthropic\n109\t    from pydantic_ai.models.anthropic import AnthropicModel\n110\t    from pydantic_ai.providers.anthropic import AnthropicProvider\n111\t\n112\t    from harness.agent import build_anthropic_client\n113\t\n114\t    client = build_anthropic_client()\n115\t    return AnthropicModel(\n116\t        settings.ANTHROPIC_MODEL,\n117\t        provider=AnthropicProvider(anthropic_client=client),\n118\t    )\n119\t\n120\t\n121\tdef _intent_instructions() -> str:\n122\t    \"\"\"The frozen intent prompt, read from prompts/intent.md.\"\"\"\n123\t    from harness.prompt import SYSTEM_PROMPT_PATH\n124\t\n125\t    intent_path = SYSTEM_PROMPT_PATH.parent / \"intent.md\"\n126\t    if not intent_path.exists():\n127\t        raise FileNotFoundError(\n128\t            f\"{intent_path} is missing. It should have been committed with the pipeline refactor.\"\n129\t        )\n130\t    return intent_path.read_text(\"utf-8\")\n131\t\n132\t\n133\tdef build_intent_agent(model: object | None = None) -> Agent[None, StructuredIntent]:\n134\t    \"\"\"A single-call, no-tool agent that interprets a question into a StructuredIntent.\n135\t\n136\t    `UsageLimits(request_limit=1)` is the contract: intent interpretation is\n137\t    classification, not exploration, and the pipeline's budget model gives it\n138\t    exactly one model call.\n139\t    \"\"\"\n140\t    resolved = _build_intent_model(model)\n141\t    agent: Agent[None, StructuredIntent] = Agent(\n142\t        resolved,  # type: ignore[arg-type]\n143\t        output_type=StructuredIntent,\n144\t        instructions=_intent_instructions(),\n145\t    )\n146\t    return agent\n147\t\n148\t\n149\tasync def interpret_intent(\n150\t    question: str,\n151\t    model: object | None = None,\n152\t) -> StructuredIntent:\n153\t    \"\"\"Run Stage 1: one model call, returns a StructuredIntent.\n154\t\n155\t    Wraps the agent with a wall-clock timeout matching `LOOP_MAX_SECONDS` (the\n156\t    whole pipeline shares one budget envelope). A `UsageLimitExceeded` means the\n157\t    agent tried more than one model call, which is a programming error in the\n158\t    intent agent — surfaced as RuntimeError so the planner can treat it as a\n159\t    fatal configuration problem rather than a retryable fault.\n160\t    \"\"\"\n161\t    agent = build_intent_agent(model)\n162\t    limits = UsageLimits(request_limit=1)\n163\t    try:\n164\t        result = await asyncio.wait_for(\n165\t            agent.run(question, usage_limits=limits),\n166\t            timeout=settings.LOOP_MAX_SECONDS,\n167\t        )\n168\t    except UsageLimitExceeded as exc:\n169\t        raise RuntimeError(\"intent exceeded 1 model request\") from exc\n170\t    logger.debug(\n171\t        \"intent interpreted\",\n172\t        extra={\n173\t            \"subsystem\": \"intent\",\n174\t            \"question_id\": result.output.question_id,\n175\t            \"school_mentions\": result.output.school_mentions,\n176\t        },\n177\t    )\n178\t    return result.output\n179\t"}]},"parent_tool_use_id":null,"session_id":"2e8b7dde-8bb0-4345-aaad-7bcee95758ae","uuid":"d4c6df43-eb44-4e08-915f-b576a7b16ba4","timestamp":"2026-09-26T09:59:47.196Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/harness/intent.py","content":"\"\"\"Stage 1 of the 4-stage pipeline: intent interpretation.\n\nThe model sees the user's question once and returns a StructuredIntent — a\nmachine-readable map of what the user is asking, which schools they named, and\nwhich inputs they supplied or omitted. No tools. One model call. The pipeline\nbranches deterministically from there.\n\nWhy one call and no tools? Tools make intent interpretation retryable and\nself-correcting, but intent extraction is not the kind of task that benefits from\nexploration: it is a classification over a closed registry. One call is also the\nonly shape the pipeline's budget model supports — the intent budget is separate\nfrom the narration budget, and the planner between them costs nothing.\n\n`build_intent_agent()` and `interpret_intent()` are the two injection points\ntests need: pass a `FunctionModel` as `model` to script a deterministic intent\nwithout a network call. The production path calls them with `model=None`, which\nresolves to the same provider wiring as `build_agent()`.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport logging\nfrom typing import Any\n\nfrom pydantic import BaseModel, Field\nfrom pydantic_ai import Agent\nfrom pydantic_ai.exceptions import UsageLimitExceeded\nfrom pydantic_ai.usage import UsageLimits\n\nfrom config import settings\nfrom harness.claude_account_cli import build_claude_account_model\n\nlogger = logging.getLogger(\"harness.intent\")\n\n\nclass StructuredIntent(BaseModel):\n    \"\"\"What the model extracted from the user's question.\n\n    This is the ONLY interface between Stage 1 (model) and Stage 2 (planner).\n    The planner is deterministic from here: it never re-reads the question.\n    \"\"\"\n\n    question_id: str = Field(\n        description=(\n            \"The registry question ID the user is asking about, e.g. 'VC-POC-01'. \"\n            \"Use 'excluded' when the topic is in the excluded list. \"\n            \"Use 'unknown' when no registry question covers it.\"\n        )\n    )\n    excluded_topic: str | None = Field(\n        default=None,\n        description=(\n            \"When question_id == 'excluded': a short keyword hint matching the \"\n            \"excluded topic, e.g. 'finance', 'transport', 'sa1'. None otherwise.\"\n        ),\n    )\n    school_mentions: list[str] = Field(\n        default_factory=list,\n        description=(\n            \"Raw school names from the user's question, as the user wrote them. \"\n            \"Empty when no school is named.\"\n        ),\n    )\n    requested_metrics: list[str] = Field(\n        default_factory=list,\n        description=(\n            \"Natural-language metric names the user explicitly mentioned. \"\n            \"Empty when the user named no metric.\"\n        ),\n    )\n    filters: dict[str, Any] = Field(\n        default_factory=dict,\n        description=(\n            \"Explicit filter values the user provided (e.g. market_definition, \"\n            \"distance_km, grades, sa2_codes). Do not invent values the user did not supply.\"\n        ),\n    )\n    presentation: str = Field(\n        default=\"snapshot\",\n        description=(\n            \"How the user wants the answer presented: \"\n            \"'trend' (over time), 'comparison' (across schools), \"\n            \"'snapshot' (one school, latest), 'area' (SA2-based), \"\n            \"'reference' (glossary/lookup).\"\n        ),\n    )\n    missing_material_inputs: list[str] = Field(\n        default_factory=list,\n        description=(\n            \"Material input names that the question requires but the user did not supply. \"\n            \"Only list inputs that are declared material for this question_id. \"\n            \"Empty when all material inputs are present.\"\n        ),\n    )\n\n\ndef _build_intent_model(model: object | None = None) -> object:\n    \"\"\"Resolve the model for the intent agent, same logic as build_agent().\"\"\"\n    if model is not None:\n        return model\n    if settings.MODEL_PROVIDER == \"claude_account\":\n        return build_claude_account_model(\n            binary=settings.CLAUDE_CLI,\n            model=settings.CLAUDE_ACCOUNT_MODEL,\n            timeout_seconds=settings.CLAUDE_CLI_TIMEOUT_SECONDS,\n        )\n    from anthropic import AsyncAnthropic\n    from pydantic_ai.models.anthropic import AnthropicModel\n    from pydantic_ai.providers.anthropic import AnthropicProvider\n\n    from harness.agent import build_anthropic_client\n\n    client = build_anthropic_client()\n    return AnthropicModel(\n        settings.ANTHROPIC_MODEL,\n        provider=AnthropicProvider(anthropic_client=client),\n    )\n\n\ndef _intent_instructions() -> str:\n    \"\"\"The frozen intent prompt, read from prompts/intent.md.\"\"\"\n    from harness.prompt import SYSTEM_PROMPT_PATH\n\n    intent_path = SYSTEM_PROMPT_PATH.parent / \"intent.md\"\n    if not intent_path.exists():\n        raise FileNotFoundError(\n            f\"{intent_path} is missing. It should have been committed with the pipeline refactor.\"\n        )\n    return intent_path.read_text(\"utf-8\")\n\n\ndef build_intent_agent(model: object | None = None) -> Agent[None, StructuredIntent]:\n    \"\"\"A single-call, no-tool agent that interprets a question into a StructuredIntent.\n\n    `UsageLimits(request_limit=1)` is the contract: intent interpretation is\n    classification, not exploration, and the pipeline's budget model gives it\n    exactly one model call.\n    \"\"\"\n    resolved = _build_intent_model(model)\n    agent: Agent[None, StructuredIntent] = Agent(\n        resolved,  # type: ignore[arg-type]\n        output_type=StructuredIntent,\n        instructions=_intent_instructions(),\n    )\n    return agent\n\n\nasync def interpret_intent(\n    question: str,\n    model: object | None = None,\n) -> StructuredIntent:\n    \"\"\"Run Stage 1: one model call, returns a StructuredIntent.\n\n    Wraps the agent with a wall-clock timeout matching `LOOP_MAX_SECONDS` (the\n    whole pipeline shares one budget envelope). A `UsageLimitExceeded` means the\n    agent tried more than one model call, which is a programming error in the\n    intent agent — surfaced as RuntimeError so the planner can treat it as a\n    fatal configuration problem rather than a retryable fault.\n    \"\"\"\n    agent = build_intent_agent(model)\n    limits = UsageLimits(request_limit=1)\n    try:\n        result = await asyncio.wait_for(\n            agent.run(question, usage_limits=limits),\n            timeout=settings.LOOP_MAX_SECONDS,\n        )\n    except UsageLimitExceeded as exc:\n        raise RuntimeError(\"intent exceeded 1 model request\") from exc\n    logger.debug(\n        \"intent interpreted\",\n        extra={\n            \"subsystem\": \"intent\",\n            \"question_id\": result.output.question_id,\n            \"school_mentions\": result.output.school_mentions,\n        },\n    )\n    return result.output\n","numLines":179,"startLine":1,"totalLines":179}}}
