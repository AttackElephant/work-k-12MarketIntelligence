{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015GbuhbD1AXddvGSUJBHhWE","type":"tool_result","content":"1\t\"\"\"Stub evidence emitter — the offline substrate for M2/M3 (architecture §11).\n2\t\n3\tIt satisfies the data project's emitter CLI contract (POC_HARNESS_HANDOFF.md,\n4\t\"Interface protocol\") and serves canned envelopes and canned exit-2 errors from\n5\t`evals/fixtures/stub_envelopes.json`. Golden runs therefore need no data\n6\tproject, no DuckDB and no network. It is NOT a simulation of the data layer: it\n7\tcomputes nothing, and every value it returns was written down in advance.\n8\t\n9\tArgv is byte-identical to the real emitter, so the harness invokes both the same\n10\tway and only DATA_PROJECT_ROOT changes:\n11\t\n12\t    python evals/stub_emitter.py --question-id VC-POC-01 --request-json '{...}'\n13\t    python evals/stub_emitter.py --question-id VC-POC-01 --request-file req.json\n14\t    python evals/stub_emitter.py --input-catalog\n15\t    python evals/stub_emitter.py --school-directory --school-search Learning --directory-limit 25\n16\t    python evals/stub_emitter.py --list-questions\n17\t\n18\tExit codes:\n19\t\n20\t    0   success; response JSON on stdout (or to --output)\n21\t    2   contract error; error JSON on stderr, carrying a v0.2.0 `error_kind`\n22\t    3   STUB-ONLY: no fixture case matched. Never returned by the real emitter,\n23\t        deliberately outside the contract's codes, and loud — a stub that\n24\t        invented an envelope for an unforeseen request would be a silent lie,\n25\t        which is the failure mode this whole substrate exists to avoid.\n26\t\n27\tStub-only controls are environment variables, never flags, so no call site can\n28\taccidentally depend on an argument the real emitter does not have:\n29\t\n30\t    STUB_EMITTER_FIXTURES   path to an alternative bundle (default: the one above)\n31\t    STUB_EMITTER_CASE       force one case by name, bypassing request matching\n32\t\"\"\"\n33\t\n34\tfrom __future__ import annotations\n35\t\n36\timport argparse\n37\timport copy\n38\timport json\n39\timport os\n40\timport sys\n41\tfrom datetime import datetime, timezone\n42\tfrom pathlib import Path\n43\tfrom typing import Any\n44\t\n45\tPROJECT_ROOT = Path(__file__).resolve().parent.parent\n46\tDEFAULT_BUNDLE = PROJECT_ROOT / \"evals\" / \"fixtures\" / \"stub_envelopes.json\"\n47\t\n48\tCONTRACT_VERSION = \"0.3.0\"\n49\tREGISTRY_PATH = PROJECT_ROOT / \"contract\" / f\"poc_question_registry.v{CONTRACT_VERSION}.json\"\n50\t\n51\tEXIT_OK = 0\n52\tEXIT_CONTRACT_ERROR = 2\n53\tEXIT_NO_FIXTURE = 3\n54\t\n55\t\n56\tclass NoFixture(Exception):\n57\t    \"\"\"No canned case covers this invocation — a stub failure, not a contract error.\"\"\"\n58\t\n59\t\n60\tdef load_bundle(path: Path | None = None) -> dict[str, Any]:\n61\t    bundle_path = path or Path(os.getenv(\"STUB_EMITTER_FIXTURES\", DEFAULT_BUNDLE))\n62\t    if not bundle_path.is_file():\n63\t        raise NoFixture(f\"fixture bundle not found: {bundle_path}\")\n64\t    bundle = json.loads(bundle_path.read_text(\"utf-8\"))\n65\t    if bundle.get(\"contract_version\") != CONTRACT_VERSION:\n66\t        raise NoFixture(\n67\t            f\"fixture bundle is contract {bundle.get('contract_version')!r}, \"\n68\t            f\"stub emitter serves {CONTRACT_VERSION!r}\"\n69\t        )\n70\t    return bundle\n71\t\n72\t\n73\tdef registry_question_ids() -> set[str]:\n74\t    registry = json.loads(REGISTRY_PATH.read_text(\"utf-8\"))\n75\t    return {q[\"question_id\"] for q in registry[\"questions\"]}\n76\t\n77\t\n78\tdef matches(case: dict[str, Any], question_id: str, request: dict[str, Any]) -> bool:\n79\t    \"\"\"Case selection: same question, every `match` key present and equal in the\n80\t    request, and every `match_absent` key genuinely absent.\n81\t\n82\t    Subset matching (not equality) is what lets one canned case answer the\n83\t    several equivalent requests a model produces for the same question — an\n84\t    extra defaulted key must not miss the fixture.\n85\t    \"\"\"\n86\t    if case[\"question_id\"] != question_id:\n87\t        return False\n88\t    for key, expected in case.get(\"match\", {}).items():\n89\t        if key not in request or request[key] != expected:\n90\t            return False\n91\t    for key in case.get(\"match_absent\", []):\n92\t        if key in request:\n93\t            return False\n94\t    return True\n95\t\n96\t\n97\tdef select_case(\n98\t    bundle: dict[str, Any], question_id: str, request: dict[str, Any]\n99\t) -> dict[str, Any]:\n100\t    forced = os.getenv(\"STUB_EMITTER_CASE\")\n101\t    if forced:\n102\t        for case in bundle[\"cases\"]:\n103\t            if case[\"name\"] == forced:\n104\t                return case\n105\t        raise NoFixture(f\"STUB_EMITTER_CASE={forced!r} names no case in the bundle\")\n106\t\n107\t    for case in bundle[\"cases\"]:\n108\t        if matches(case, question_id, request):\n109\t            return case\n110\t\n111\t    # Mechanical, and the real emitter's own behaviour: an ID outside the\n112\t    # registry is unknown_question, not a stub failure.\n113\t    if question_id not in registry_question_ids():\n114\t        return {\n115\t            \"name\": f\"{question_id}/unknown-question\",\n116\t            \"question_id\": question_id,\n117\t            \"error\": {\n118\t                \"contract_version\": CONTRACT_VERSION,\n119\t                \"error_kind\": \"unknown_question\",\n120\t                \"error\": f\"{question_id} is not in registry version {CONTRACT_VERSION}.\",\n121\t            },\n122\t        }\n123\t\n124\t    raise NoFixture(\n125\t        f\"no fixture case matches question {question_id} with request \"\n126\t        f\"{json.dumps(request, sort_keys=True)} — add a case to the bundle \"\n127\t        \"rather than letting the stub invent an envelope\"\n128\t    )\n129\t\n130\t\n131\tdef finalise_response(case: dict[str, Any], request: dict[str, Any]) -> dict[str, Any]:\n132\t    \"\"\"Return the canned envelope with the two run-scoped fields applied.\n133\t\n134\t    `request` is overwritten with what was actually supplied, because the\n135\t    contract defines that field as the harness's own request echoed back;\n136\t    `provenance.generated_utc` is stamped with the wall clock, matching the real\n137\t    emitter and giving the replay-equality rule (CR-6) something to exclude.\n138\t    \"\"\"\n139\t    envelope = copy.deepcopy(case[\"response\"])\n140\t    envelope[\"request\"] = request\n141\t    if isinstance(envelope.get(\"provenance\"), dict):\n142\t        envelope[\"provenance\"][\"generated_utc\"] = (\n143\t            datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace(\"+00:00\", \"Z\")\n144\t        )\n145\t    return envelope\n146\t\n147\t\n148\tdef _emit(payload: Any, output: Path | None) -> None:\n149\t    text = json.dumps(payload, indent=2) + \"\\n\"\n150\t    if output:\n151\t        output.write_text(text, \"utf-8\")\n152\t    else:\n153\t        sys.stdout.write(text)\n154\t\n155\t\n156\tdef _fail_contract(error_envelope: dict[str, Any]) -> int:\n157\t    sys.stderr.write(json.dumps(error_envelope, indent=2) + \"\\n\")\n158\t    return EXIT_CONTRACT_ERROR\n159\t\n160\t\n161\tdef _read_request(args: argparse.Namespace) -> dict[str, Any] | dict[str, Any]:\n162\t    \"\"\"Parse --request-json / --request-file, or return the bad_request the real\n163\t    emitter would return for unparseable or non-object request text.\"\"\"\n164\t    if args.request_file:\n165\t        raw = Path(args.request_file).read_text(\"utf-8\")\n166\t    elif args.request_json:\n167\t        raw = args.request_json\n168\t    else:\n169\t        raw = \"{}\"\n170\t    try:\n171\t        request = json.loads(raw)\n172\t    except json.JSONDecodeError as exc:\n173\t        raise ValueError(f\"request is not valid JSON: {exc}\") from exc\n174\t    if not isinstance(request, dict):\n175\t        raise ValueError(\"request must be a JSON object.\")\n176\t    return request\n177\t\n178\t\n179\tdef build_parser() -> argparse.ArgumentParser:\n180\t    parser = argparse.ArgumentParser(\n181\t        prog=\"stub_emitter.py\",\n182\t        description=\"Stub deterministic evidence emitter (contract v0.2.0).\",\n183\t    )\n184\t    parser.add_argument(\"--question-id\")\n185\t    parser.add_argument(\"--request-json\")\n186\t    parser.add_argument(\"--request-file\")\n187\t    parser.add_argument(\"--output\")\n188\t    parser.add_argument(\"--list-questions\", action=\"store_true\")\n189\t    parser.add_argument(\"--input-catalog\", action=\"store_true\")\n190\t    parser.add_argument(\"--school-directory\", action=\"store_true\")\n191\t    parser.add_argument(\"--school-search\")\n192\t    parser.add_argument(\"--directory-limit\", type=int, default=25)\n193\t    return parser\n194\t\n195\t\n196\tdef run_school_directory(bundle: dict[str, Any], search: str | None, limit: int) -> dict:\n197\t    \"\"\"Filter the canned directory envelope and return it with updated request metadata.\"\"\"\n198\t    directory_envelope = bundle[\"preflight\"][\"school_directory\"]\n199\t    records = list(directory_envelope[\"records\"])\n200\t    if search:\n201\t        needle = search.casefold()\n202\t        records = [r for r in records if needle in r[\"school_name\"].casefold()]\n203\t    if limit is not None and limit >= 0:\n204\t        records = records[:limit]\n205\t    result = copy.deepcopy(directory_envelope)\n206\t    result[\"records\"] = records\n207\t    result[\"request\"] = {\n208\t        \"school_search\": search,\n209\t        \"school_sector\": [],\n210\t        \"school_type\": [],\n211\t        \"limit\": limit,\n212\t    }\n213\t    if isinstance(result.get(\"provenance\"), dict):\n214\t        result[\"provenance\"][\"generated_utc\"] = (\n215\t            datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace(\"+00:00\", \"Z\")\n216\t        )\n217\t    return result\n218\t\n219\t\n220\tdef main(argv: list[str] | None = None) -> int:\n221\t    args = build_parser().parse_args(argv)\n222\t    output = Path(args.output) if args.output else None\n223\t\n224\t    try:\n225\t        bundle = load_bundle()\n226\t    except NoFixture as exc:\n227\t        sys.stderr.write(f\"stub emitter: {exc}\\n\")\n228\t        return EXIT_NO_FIXTURE\n229\t\n230\t    if args.list_questions:\n231\t        _emit(sorted(registry_question_ids()), output)\n232\t        return EXIT_OK\n233\t\n234\t    if args.input_catalog:\n235\t        _emit(bundle[\"preflight\"][\"input_catalog\"], output)\n236\t        return EXIT_OK\n237\t\n238\t    if args.school_directory:\n239\t        _emit(run_school_directory(bundle, args.school_search, args.directory_limit), output)\n240\t        return EXIT_OK\n241\t\n242\t    if not args.question_id:\n243\t        return _fail_contract(\n244\t            {\n245\t                \"contract_version\": CONTRACT_VERSION,\n246\t                \"error_kind\": \"bad_request\",\n247\t                \"error\": \"--question-id is required unless a preflight interface is requested.\",\n248\t            }\n249\t        )\n250\t\n251\t    try:\n252\t        request = _read_request(args)\n253\t    except (ValueError, OSError) as exc:\n254\t        return _fail_contract(\n255\t            {\n256\t                \"contract_version\": CONTRACT_VERSION,\n257\t                \"error_kind\": \"bad_request\",\n258\t                \"error\": str(exc),\n259\t            }\n260\t        )\n261\t\n262\t    try:\n263\t        case = select_case(bundle, args.question_id, request)\n264\t    except NoFixture as exc:\n265\t        sys.stderr.write(f\"stub emitter: {exc}\\n\")\n266\t        return EXIT_NO_FIXTURE\n267\t\n268\t    if \"error\" in case:\n269\t        return _fail_contract(case[\"error\"])\n270\t\n271\t    _emit(finalise_response(case, request), output)\n272\t    return EXIT_OK\n273\t\n274\t\n275\tif __name__ == \"__main__\":\n276\t    raise SystemExit(main())\n277\t"}]},"parent_tool_use_id":null,"session_id":"2e8b7dde-8bb0-4345-aaad-7bcee95758ae","uuid":"2f81cada-1200-42b6-8793-49b91b80ebda","timestamp":"2026-09-26T09:59:41.960Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/evals/stub_emitter.py","content":"\"\"\"Stub evidence emitter — the offline substrate for M2/M3 (architecture §11).\n\nIt satisfies the data project's emitter CLI contract (POC_HARNESS_HANDOFF.md,\n\"Interface protocol\") and serves canned envelopes and canned exit-2 errors from\n`evals/fixtures/stub_envelopes.json`. Golden runs therefore need no data\nproject, no DuckDB and no network. It is NOT a simulation of the data layer: it\ncomputes nothing, and every value it returns was written down in advance.\n\nArgv is byte-identical to the real emitter, so the harness invokes both the same\nway and only DATA_PROJECT_ROOT changes:\n\n    python evals/stub_emitter.py --question-id VC-POC-01 --request-json '{...}'\n    python evals/stub_emitter.py --question-id VC-POC-01 --request-file req.json\n    python evals/stub_emitter.py --input-catalog\n    python evals/stub_emitter.py --school-directory --school-search Learning --directory-limit 25\n    python evals/stub_emitter.py --list-questions\n\nExit codes:\n\n    0   success; response JSON on stdout (or to --output)\n    2   contract error; error JSON on stderr, carrying a v0.2.0 `error_kind`\n    3   STUB-ONLY: no fixture case matched. Never returned by the real emitter,\n        deliberately outside the contract's codes, and loud — a stub that\n        invented an envelope for an unforeseen request would be a silent lie,\n        which is the failure mode this whole substrate exists to avoid.\n\nStub-only controls are environment variables, never flags, so no call site can\naccidentally depend on an argument the real emitter does not have:\n\n    STUB_EMITTER_FIXTURES   path to an alternative bundle (default: the one above)\n    STUB_EMITTER_CASE       force one case by name, bypassing request matching\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport copy\nimport json\nimport os\nimport sys\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nPROJECT_ROOT = Path(__file__).resolve().parent.parent\nDEFAULT_BUNDLE = PROJECT_ROOT / \"evals\" / \"fixtures\" / \"stub_envelopes.json\"\n\nCONTRACT_VERSION = \"0.3.0\"\nREGISTRY_PATH = PROJECT_ROOT / \"contract\" / f\"poc_question_registry.v{CONTRACT_VERSION}.json\"\n\nEXIT_OK = 0\nEXIT_CONTRACT_ERROR = 2\nEXIT_NO_FIXTURE = 3\n\n\nclass NoFixture(Exception):\n    \"\"\"No canned case covers this invocation — a stub failure, not a contract error.\"\"\"\n\n\ndef load_bundle(path: Path | None = None) -> dict[str, Any]:\n    bundle_path = path or Path(os.getenv(\"STUB_EMITTER_FIXTURES\", DEFAULT_BUNDLE))\n    if not bundle_path.is_file():\n        raise NoFixture(f\"fixture bundle not found: {bundle_path}\")\n    bundle = json.loads(bundle_path.read_text(\"utf-8\"))\n    if bundle.get(\"contract_version\") != CONTRACT_VERSION:\n        raise NoFixture(\n            f\"fixture bundle is contract {bundle.get('contract_version')!r}, \"\n            f\"stub emitter serves {CONTRACT_VERSION!r}\"\n        )\n    return bundle\n\n\ndef registry_question_ids() -> set[str]:\n    registry = json.loads(REGISTRY_PATH.read_text(\"utf-8\"))\n    return {q[\"question_id\"] for q in registry[\"questions\"]}\n\n\ndef matches(case: dict[str, Any], question_id: str, request: dict[str, Any]) -> bool:\n    \"\"\"Case selection: same question, every `match` key present and equal in the\n    request, and every `match_absent` key genuinely absent.\n\n    Subset matching (not equality) is what lets one canned case answer the\n    several equivalent requests a model produces for the same question — an\n    extra defaulted key must not miss the fixture.\n    \"\"\"\n    if case[\"question_id\"] != question_id:\n        return False\n    for key, expected in case.get(\"match\", {}).items():\n        if key not in request or request[key] != expected:\n            return False\n    for key in case.get(\"match_absent\", []):\n        if key in request:\n            return False\n    return True\n\n\ndef select_case(\n    bundle: dict[str, Any], question_id: str, request: dict[str, Any]\n) -> dict[str, Any]:\n    forced = os.getenv(\"STUB_EMITTER_CASE\")\n    if forced:\n        for case in bundle[\"cases\"]:\n            if case[\"name\"] == forced:\n                return case\n        raise NoFixture(f\"STUB_EMITTER_CASE={forced!r} names no case in the bundle\")\n\n    for case in bundle[\"cases\"]:\n        if matches(case, question_id, request):\n            return case\n\n    # Mechanical, and the real emitter's own behaviour: an ID outside the\n    # registry is unknown_question, not a stub failure.\n    if question_id not in registry_question_ids():\n        return {\n            \"name\": f\"{question_id}/unknown-question\",\n            \"question_id\": question_id,\n            \"error\": {\n                \"contract_version\": CONTRACT_VERSION,\n                \"error_kind\": \"unknown_question\",\n                \"error\": f\"{question_id} is not in registry version {CONTRACT_VERSION}.\",\n            },\n        }\n\n    raise NoFixture(\n        f\"no fixture case matches question {question_id} with request \"\n        f\"{json.dumps(request, sort_keys=True)} — add a case to the bundle \"\n        \"rather than letting the stub invent an envelope\"\n    )\n\n\ndef finalise_response(case: dict[str, Any], request: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Return the canned envelope with the two run-scoped fields applied.\n\n    `request` is overwritten with what was actually supplied, because the\n    contract defines that field as the harness's own request echoed back;\n    `provenance.generated_utc` is stamped with the wall clock, matching the real\n    emitter and giving the replay-equality rule (CR-6) something to exclude.\n    \"\"\"\n    envelope = copy.deepcopy(case[\"response\"])\n    envelope[\"request\"] = request\n    if isinstance(envelope.get(\"provenance\"), dict):\n        envelope[\"provenance\"][\"generated_utc\"] = (\n            datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace(\"+00:00\", \"Z\")\n        )\n    return envelope\n\n\ndef _emit(payload: Any, output: Path | None) -> None:\n    text = json.dumps(payload, indent=2) + \"\\n\"\n    if output:\n        output.write_text(text, \"utf-8\")\n    else:\n        sys.stdout.write(text)\n\n\ndef _fail_contract(error_envelope: dict[str, Any]) -> int:\n    sys.stderr.write(json.dumps(error_envelope, indent=2) + \"\\n\")\n    return EXIT_CONTRACT_ERROR\n\n\ndef _read_request(args: argparse.Namespace) -> dict[str, Any] | dict[str, Any]:\n    \"\"\"Parse --request-json / --request-file, or return the bad_request the real\n    emitter would return for unparseable or non-object request text.\"\"\"\n    if args.request_file:\n        raw = Path(args.request_file).read_text(\"utf-8\")\n    elif args.request_json:\n        raw = args.request_json\n    else:\n        raw = \"{}\"\n    try:\n        request = json.loads(raw)\n    except json.JSONDecodeError as exc:\n        raise ValueError(f\"request is not valid JSON: {exc}\") from exc\n    if not isinstance(request, dict):\n        raise ValueError(\"request must be a JSON object.\")\n    return request\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(\n        prog=\"stub_emitter.py\",\n        description=\"Stub deterministic evidence emitter (contract v0.2.0).\",\n    )\n    parser.add_argument(\"--question-id\")\n    parser.add_argument(\"--request-json\")\n    parser.add_argument(\"--request-file\")\n    parser.add_argument(\"--output\")\n    parser.add_argument(\"--list-questions\", action=\"store_true\")\n    parser.add_argument(\"--input-catalog\", action=\"store_true\")\n    parser.add_argument(\"--school-directory\", action=\"store_true\")\n    parser.add_argument(\"--school-search\")\n    parser.add_argument(\"--directory-limit\", type=int, default=25)\n    return parser\n\n\ndef run_school_directory(bundle: dict[str, Any], search: str | None, limit: int) -> dict:\n    \"\"\"Filter the canned directory envelope and return it with updated request metadata.\"\"\"\n    directory_envelope = bundle[\"preflight\"][\"school_directory\"]\n    records = list(directory_envelope[\"records\"])\n    if search:\n        needle = search.casefold()\n        records = [r for r in records if needle in r[\"school_name\"].casefold()]\n    if limit is not None and limit >= 0:\n        records = records[:limit]\n    result = copy.deepcopy(directory_envelope)\n    result[\"records\"] = records\n    result[\"request\"] = {\n        \"school_search\": search,\n        \"school_sector\": [],\n        \"school_type\": [],\n        \"limit\": limit,\n    }\n    if isinstance(result.get(\"provenance\"), dict):\n        result[\"provenance\"][\"generated_utc\"] = (\n            datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace(\"+00:00\", \"Z\")\n        )\n    return result\n\n\ndef main(argv: list[str] | None = None) -> int:\n    args = build_parser().parse_args(argv)\n    output = Path(args.output) if args.output else None\n\n    try:\n        bundle = load_bundle()\n    except NoFixture as exc:\n        sys.stderr.write(f\"stub emitter: {exc}\\n\")\n        return EXIT_NO_FIXTURE\n\n    if args.list_questions:\n        _emit(sorted(registry_question_ids()), output)\n        return EXIT_OK\n\n    if args.input_catalog:\n        _emit(bundle[\"preflight\"][\"input_catalog\"], output)\n        return EXIT_OK\n\n    if args.school_directory:\n        _emit(run_school_directory(bundle, args.school_search, args.directory_limit), output)\n        return EXIT_OK\n\n    if not args.question_id:\n        return _fail_contract(\n            {\n                \"contract_version\": CONTRACT_VERSION,\n                \"error_kind\": \"bad_request\",\n                \"error\": \"--question-id is required unless a preflight interface is requested.\",\n            }\n        )\n\n    try:\n        request = _read_request(args)\n    except (ValueError, OSError) as exc:\n        return _fail_contract(\n            {\n                \"contract_version\": CONTRACT_VERSION,\n                \"error_kind\": \"bad_request\",\n                \"error\": str(exc),\n            }\n        )\n\n    try:\n        case = select_case(bundle, args.question_id, request)\n    except NoFixture as exc:\n        sys.stderr.write(f\"stub emitter: {exc}\\n\")\n        return EXIT_NO_FIXTURE\n\n    if \"error\" in case:\n        return _fail_contract(case[\"error\"])\n\n    _emit(finalise_response(case, request), output)\n    return EXIT_OK\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","numLines":277,"startLine":1,"totalLines":277}}}
