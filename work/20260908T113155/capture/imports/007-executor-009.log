{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011CfRrz9S1nZuwfzLwKmEyV","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Hx7cVvbDVBXPx2Vwt8PAXr","name":"Edit","input":{"replace_all":false,"file_path":"/Users/shane/Projects/k-12Harness/tests/unit/test_live_tier.py","old_string":"    # Trying to resume it with --stage narration must fail\n    with pytest.raises(SystemExit, match=\"recorded with --stage 'intent'\"):\n        live.main([\"--stage\", \"narration\", \"--resume\", str(report_path)])","new_string":"    # Trying to resume it with --stage narration must fail\n    with pytest.raises(SystemExit, match=\"recorded with --stage 'intent'\"):\n        live.main([\"--stage\", \"narration\", \"--resume\", str(report_path)])\n\n\n# --------------------------------------------------------------------------\n# PF-2: a rejected credential tells the truth about what is on disk, for\n# every stage — it does not always say \"No report was written\".\n# --------------------------------------------------------------------------\n\n\n@pytest.mark.parametrize(\"stage\", [None, \"intent\", \"narration\", \"end-to-end\"])\ndef test_credentials_rejected_before_any_trial_writes_no_report(monkeypatch, tmp_path, stage):\n    case = CASES[\"answer/VC-POC-01\"]\n\n    async def immediately_rejected(*args, **kwargs):\n        raise live.CredentialsRejected(\"the credential is invalid\")\n\n    monkeypatch.setattr(live, \"run_suite\", immediately_rejected)\n    monkeypatch.setattr(\"run.require_credentials\", lambda: None)\n\n    argv = [\"--k\", \"1\", \"--case\", case.case_id, \"--report-dir\", str(tmp_path)]\n    if stage:\n        argv += [\"--stage\", stage]\n\n    with pytest.raises(SystemExit) as excinfo:\n        live.main(argv)\n    message = str(excinfo.value)\n    assert \"No report was written\" in message\n    assert not any(\n        path for path in tmp_path.glob(\"live-*.json\") if not path.stem.endswith(\"-transcripts\")\n    )\n\n\n@pytest.mark.parametrize(\"stage\", [None, \"intent\", \"narration\", \"end-to-end\"])\ndef test_credentials_rejected_after_a_completed_trial_leaves_the_checkpoint_untouched(\n    monkeypatch, tmp_path, stage\n):\n    \"\"\"The last 'running' checkpoint, written by `on_progress` after the one\n    trial that completed before the rejection, must survive byte-for-byte —\n    and the exit message must say so and give the resume command, instead of\n    the (false, for this case) claim that no report was written.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    completed = TrialResult(\n        case_id=case.case_id,\n        direction=case.direction,\n        phrasing=case.phrasings[0],\n        trial=1,\n        passed=True,\n        output_kind=\"RenderedAnswer\",\n    )\n\n    async def one_trial_then_rejected(*args, on_progress=None, **kwargs):\n        if on_progress is not None:\n            on_progress([completed], [])\n        raise live.CredentialsRejected(\"the credential is invalid\")\n\n    monkeypatch.setattr(live, \"run_suite\", one_trial_then_rejected)\n    monkeypatch.setattr(\"run.require_credentials\", lambda: None)\n\n    argv = [\"--k\", \"1\", \"--case\", case.case_id, \"--report-dir\", str(tmp_path)]\n    if stage:\n        argv += [\"--stage\", stage]\n\n    with pytest.raises(SystemExit) as excinfo:\n        live.main(argv)\n    message = str(excinfo.value)\n    assert \"No report was written\" not in message\n    assert \"checkpoint from before the rejection exists\" in message.lower()\n    assert \"resume:\" in message.lower()\n\n    report_path = next(\n        path for path in tmp_path.glob(\"live-*.json\") if not path.stem.endswith(\"-transcripts\")\n    )\n    checkpoint = json.loads(report_path.read_text(\"utf-8\"))\n    assert checkpoint[\"status\"] == \"running\"\n    assert checkpoint[\"completed_trials\"] == 1\n    assert str(report_path) in message\n\n\n# --------------------------------------------------------------------------\n# PF-3: the isolation test is falsifiable — spies prove no cross-stage call\n# happens, not just that the score came out right.\n# --------------------------------------------------------------------------\n\n\ndef test_narration_trial_never_calls_interpret_intent_or_builds_an_agent(monkeypatch):\n    \"\"\"A narration-stage trial never runs Stage 1 and never builds the\n    tool-loop agent (so its evidence tool is never registered, let alone\n    invoked) — the only fetch is the oracle acquired directly from the stub\n    client before `narrate()` runs.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    reference_answer = REFERENCES[case.case_id].output[\"answer\"]\n\n    def boom_interpret_intent(question, model=None):\n        raise AssertionError(\n            \"interpret_intent must not be called during a narration-stage trial\"\n        )\n\n    def boom_build_agent(*args, **kwargs):\n        raise AssertionError(\n            \"build_agent (and therefore its evidence tool) must not be invoked \"\n            \"during a narration-stage trial\"\n        )\n\n    monkeypatch.setattr(live, \"interpret_intent\", boom_interpret_intent)\n    monkeypatch.setattr(live, \"build_agent\", boom_build_agent)\n\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"narration\",\n            narration_model=make_narration_model(reference_answer),\n        )\n    )\n    assert result.passed, result.detail\n    assert record is not None\n\n\ndef test_intent_trial_never_fetches_evidence_or_calls_narrate(monkeypatch):\n    \"\"\"The converse: an intent-stage trial never builds an evidence client and\n    never calls narration.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    intent = StructuredIntent(question_id=\"VC-POC-01\", school_mentions=[\"Alpha College\"])\n\n    def boom_build_client(*args, **kwargs):\n        raise AssertionError(\n            \"build_client (an evidence fetch) must not be called during an \"\n            \"intent-stage trial\"\n        )\n\n    async def boom_narrate(*args, **kwargs):\n        raise AssertionError(\"narrate must not be called during an intent-stage trial\")\n\n    monkeypatch.setattr(live, \"build_client\", boom_build_client)\n    monkeypatch.setattr(live, \"narrate\", boom_narrate)\n\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"intent\",\n            intent_model=make_intent_model(intent),\n        )\n    )\n    assert result.passed, result.detail\n    assert record is None\n\n\ndef test_narration_stage_is_unaffected_by_a_wrong_scripted_intent():\n    \"\"\"The defining isolation check: two narration runs of the same case, whose\n    scripted models differ only in what intent they would produce IF intent\n    interpretation were invoked, must produce identical output and grades —\n    because narration never invokes it.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    reference_answer = REFERENCES[case.case_id].output[\"answer\"]\n    correct_intent = StructuredIntent(question_id=\"VC-POC-01\", school_mentions=[\"Alpha College\"])\n    wrong_intent = StructuredIntent(question_id=\"excluded\", excluded_topic=\"finance\")\n\n    result_a, record_a = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"narration\",\n            intent_model=make_intent_model(correct_intent),\n            narration_model=make_narration_model(reference_answer),\n        )\n    )\n    result_b, record_b = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"narration\",\n            intent_model=make_intent_model(wrong_intent),\n            narration_model=make_narration_model(reference_answer),\n        )\n    )\n    assert result_a.passed == result_b.passed\n    assert result_a.failed_graders == result_b.failed_graders\n    assert record_a.output == record_b.output\n\n\n# --------------------------------------------------------------------------\n# PF-4: the live-marked file is provably invisible to the default gate, and\n# fully covered by -m live — a missing marker fails the PR gate.\n# --------------------------------------------------------------------------\n\n\ndef test_live_eval_file_is_deselected_by_default_and_fully_marked_live():\n    live_file = \"tests/live/test_live_eval.py\"\n\n    default_run = subprocess.run(\n        [sys.executable, \"-m\", \"pytest\", live_file, \"--collect-only\", \"-q\"],\n        cwd=str(PROJECT_ROOT),\n        capture_output=True,\n        text=True,\n    )\n    assert default_run.returncode in (0, 5), default_run.stdout + default_run.stderr\n    lowered = default_run.stdout.lower()\n    assert \"no tests ran\" in lowered or \"collected 0 items\" in lowered\n\n    live_run = subprocess.run(\n        [sys.executable, \"-m\", \"pytest\", live_file, \"--collect-only\", \"-q\", \"-m\", \"live\"],\n        cwd=str(PROJECT_ROOT),\n        capture_output=True,\n        text=True,\n    )\n    assert live_run.returncode == 0, live_run.stdout + live_run.stderr\n\n    source = (PROJECT_ROOT / live_file).read_text(\"utf-8\")\n    tree = ast.parse(source)\n    test_names = [\n        node.name\n        for node in ast.walk(tree)\n        if isinstance(node, ast.FunctionDef) and node.name.startswith(\"test_\")\n    ]\n    assert test_names, \"no test functions found — the file moved or is empty\"\n    for name in test_names:\n        assert name in live_run.stdout, (\n            f\"{name!r} is missing from the `-m live` collection — a test in \"\n            f\"{live_file} lacks the live marker and would leak into the PR gate\"\n        )"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":570,"cache_read_input_tokens":164437,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":570},"output_tokens":17,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2e8b7dde-8bb0-4345-aaad-7bcee95758ae","uuid":"5d4140b8-19fa-4784-a3f6-ba116ecbe7a4","request_id":"req_011CfRrz8esxQgbJiBe1xDnL"}
