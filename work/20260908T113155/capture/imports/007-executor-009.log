{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QkybWZGofpTEmYP4JujWv1","type":"tool_result","content":"1\t\"\"\"Stage 4 of the 4-stage pipeline: narration.\n2\t\n3\t`narrate()` takes an AnswerView and produces a NarrationOutput — narrative prose\n4\tgrounded in the view. One model call. No tools. No retry.\n5\t\n6\tWhy one call and no retry? The narration model is not exploring or using tools; it\n7\tis writing prose from a compact structured input. A narration that fails grounding\n8\tvalidation raises `NarrationValidationError` — the pipeline never turns it into a\n9\trendered answer or loops the model until the prose passes.\n10\t\n11\tThe narration model receives a JSON-serialised `AnswerView` as its only input.\n12\tIt must:\n13\t1. Write narrative prose grounded in the view's figures.\n14\t2. Never use forecast framing for VC-POC-13.\n15\t3. Never use recommendation or ranking language.\n16\t4. Never compute, total, average, or project a figure.\n17\t\"\"\"\n18\t\n19\tfrom __future__ import annotations\n20\t\n21\timport asyncio\n22\timport json\n23\timport logging\n24\tfrom typing import Any\n25\t\n26\tfrom pydantic import BaseModel, Field\n27\tfrom pydantic_ai import Agent\n28\tfrom pydantic_ai.exceptions import UsageLimitExceeded\n29\tfrom pydantic_ai.usage import UsageLimits\n30\t\n31\tfrom config import settings\n32\tfrom harness import rendering\n33\tfrom harness.answer_view import AnswerView\n34\tfrom harness.claude_account_cli import build_claude_account_model\n35\tfrom harness.tools import Deps\n36\t\n37\tlogger = logging.getLogger(\"harness.narration\")\n38\t\n39\t\n40\tclass NarrationValidationError(Exception):\n41\t    \"\"\"A narration failed the deterministic rendering boundary.\"\"\"\n42\t\n43\t    def __init__(self, problems: list[str]) -> None:\n44\t        self.problems = list(problems)\n45\t        super().__init__(\"Narration validation failed: \" + \"; \".join(self.problems))\n46\t\n47\t\n48\tclass NarrationOutput(BaseModel):\n49\t    \"\"\"The narrative prose authored by the narration model.\"\"\"\n50\t\n51\t    answer: str = Field(\n52\t        description=(\n53\t            \"Narrative prose summarising the evidence. Every number must appear \"\n54\t            \"in the AnswerView you received. Never compute, total, or project a figure.\"\n55\t        )\n56\t    )\n57\t\n58\t\n59\tdef _build_narration_model(model: object | None = None) -> object:\n60\t    \"\"\"Resolve the model for the narration agent, same logic as build_agent().\"\"\"\n61\t    if model is not None:\n62\t        return model\n63\t    if settings.MODEL_PROVIDER == \"claude_account\":\n64\t        return build_claude_account_model(\n65\t            binary=settings.CLAUDE_CLI,\n66\t            model=settings.CLAUDE_ACCOUNT_MODEL,\n67\t            timeout_seconds=settings.CLAUDE_CLI_TIMEOUT_SECONDS,\n68\t        )\n69\t    from harness.agent import build_anthropic_client\n70\t    from pydantic_ai.models.anthropic import AnthropicModel\n71\t    from pydantic_ai.providers.anthropic import AnthropicProvider\n72\t\n73\t    client = build_anthropic_client()\n74\t    return AnthropicModel(\n75\t        settings.ANTHROPIC_MODEL,\n76\t        provider=AnthropicProvider(anthropic_client=client),\n77\t    )\n78\t\n79\t\n80\tdef _narration_instructions() -> str:\n81\t    \"\"\"The frozen narration prompt, read from prompts/narration.md.\"\"\"\n82\t    from harness.prompt import SYSTEM_PROMPT_PATH\n83\t\n84\t    narration_path = SYSTEM_PROMPT_PATH.parent / \"narration.md\"\n85\t    if not narration_path.exists():\n86\t        raise FileNotFoundError(\n87\t            f\"{narration_path} is missing. It should have been committed with the pipeline refactor.\"\n88\t        )\n89\t    return narration_path.read_text(\"utf-8\")\n90\t\n91\t\n92\tdef build_narration_agent(model: object | None = None) -> Agent[None, NarrationOutput]:\n93\t    \"\"\"A single-call, no-tool agent that narrates an AnswerView into prose.\n94\t\n95\t    `UsageLimits(request_limit=1)` is the contract: narration is prose generation\n96\t    from a compact structured input, not exploration.\n97\t    \"\"\"\n98\t    resolved = _build_narration_model(model)\n99\t    agent: Agent[None, NarrationOutput] = Agent(\n100\t        resolved,  # type: ignore[arg-type]\n101\t        output_type=NarrationOutput,\n102\t        instructions=_narration_instructions(),\n103\t    )\n104\t    return agent\n105\t\n106\t\n107\tasync def narrate(\n108\t    view: AnswerView,\n109\t    deps: Deps,\n110\t    model: object | None = None,\n111\t) -> NarrationOutput:\n112\t    \"\"\"Run Stage 4: one model call, returns NarrationOutput.\n113\t\n114\t    Validates the narration output against the full envelope (deps.last_envelope),\n115\t    not the capped summary_rows. The deterministic status note comes from the\n116\t    view, never from model output. A validation failure is recorded for\n117\t    diagnostics and raised without retrying the model.\n118\t    \"\"\"\n119\t    agent = build_narration_agent(model)\n120\t    limits = UsageLimits(request_limit=1)\n121\t    prompt_text = json.dumps(view.model_dump(), ensure_ascii=False, separators=(\",\", \":\"))\n122\t    try:\n123\t        result = await asyncio.wait_for(\n124\t            agent.run(prompt_text, usage_limits=limits),\n125\t            timeout=settings.LOOP_MAX_SECONDS,\n126\t        )\n127\t    except UsageLimitExceeded as exc:\n128\t        raise RuntimeError(\"narration exceeded 1 model request\") from exc\n129\t\n130\t    narration = result.output\n131\t\n132\t    _validate_narration(view, deps, narration)\n133\t\n134\t    logger.debug(\n135\t        \"narration complete\",\n136\t        extra={\"subsystem\": \"narration\", \"question_id\": view.question_id},\n137\t    )\n138\t    return narration\n139\t\n140\t\n141\tdef _validate_narration(\n142\t    view: AnswerView,\n143\t    deps: Deps,\n144\t    narration: NarrationOutput,\n145\t) -> None:\n146\t    \"\"\"Validate prose against the full envelope and deterministic view fields.\"\"\"\n147\t    if deps.last_envelope is None:\n148\t        problems = [\"No evidence envelope is available for narration validation.\"]\n149\t    else:\n150\t        problems = rendering.validate_answer(\n151\t            answer=narration.answer,\n152\t            data_status_note=view.data_status_note,\n153\t            question_id=view.question_id,\n154\t            envelope=deps.last_envelope,\n155\t            user_question=deps.user_question,\n156\t        )\n157\t\n158\t    if not problems:\n159\t        return\n160\t\n161\t    deps.output_validation_failures.append(problems)\n162\t    logger.warning(\n163\t        \"narration failed grounding validation\",\n164\t        extra={\n165\t            \"subsystem\": \"narration\",\n166\t            \"question_id\": view.question_id,\n167\t            \"validation_problems\": problems,\n168\t        },\n169\t    )\n170\t    raise NarrationValidationError(problems)\n171\t"}]},"parent_tool_use_id":null,"session_id":"2e8b7dde-8bb0-4345-aaad-7bcee95758ae","uuid":"5199cfdc-574b-42c1-8716-6d2b3e7af2cc","timestamp":"2026-09-26T09:59:47.698Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/harness/narration.py","content":"\"\"\"Stage 4 of the 4-stage pipeline: narration.\n\n`narrate()` takes an AnswerView and produces a NarrationOutput — narrative prose\ngrounded in the view. One model call. No tools. No retry.\n\nWhy one call and no retry? The narration model is not exploring or using tools; it\nis writing prose from a compact structured input. A narration that fails grounding\nvalidation raises `NarrationValidationError` — the pipeline never turns it into a\nrendered answer or loops the model until the prose passes.\n\nThe narration model receives a JSON-serialised `AnswerView` as its only input.\nIt must:\n1. Write narrative prose grounded in the view's figures.\n2. Never use forecast framing for VC-POC-13.\n3. Never use recommendation or ranking language.\n4. Never compute, total, average, or project a figure.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport json\nimport logging\nfrom typing import Any\n\nfrom pydantic import BaseModel, Field\nfrom pydantic_ai import Agent\nfrom pydantic_ai.exceptions import UsageLimitExceeded\nfrom pydantic_ai.usage import UsageLimits\n\nfrom config import settings\nfrom harness import rendering\nfrom harness.answer_view import AnswerView\nfrom harness.claude_account_cli import build_claude_account_model\nfrom harness.tools import Deps\n\nlogger = logging.getLogger(\"harness.narration\")\n\n\nclass NarrationValidationError(Exception):\n    \"\"\"A narration failed the deterministic rendering boundary.\"\"\"\n\n    def __init__(self, problems: list[str]) -> None:\n        self.problems = list(problems)\n        super().__init__(\"Narration validation failed: \" + \"; \".join(self.problems))\n\n\nclass NarrationOutput(BaseModel):\n    \"\"\"The narrative prose authored by the narration model.\"\"\"\n\n    answer: str = Field(\n        description=(\n            \"Narrative prose summarising the evidence. Every number must appear \"\n            \"in the AnswerView you received. Never compute, total, or project a figure.\"\n        )\n    )\n\n\ndef _build_narration_model(model: object | None = None) -> object:\n    \"\"\"Resolve the model for the narration agent, same logic as build_agent().\"\"\"\n    if model is not None:\n        return model\n    if settings.MODEL_PROVIDER == \"claude_account\":\n        return build_claude_account_model(\n            binary=settings.CLAUDE_CLI,\n            model=settings.CLAUDE_ACCOUNT_MODEL,\n            timeout_seconds=settings.CLAUDE_CLI_TIMEOUT_SECONDS,\n        )\n    from harness.agent import build_anthropic_client\n    from pydantic_ai.models.anthropic import AnthropicModel\n    from pydantic_ai.providers.anthropic import AnthropicProvider\n\n    client = build_anthropic_client()\n    return AnthropicModel(\n        settings.ANTHROPIC_MODEL,\n        provider=AnthropicProvider(anthropic_client=client),\n    )\n\n\ndef _narration_instructions() -> str:\n    \"\"\"The frozen narration prompt, read from prompts/narration.md.\"\"\"\n    from harness.prompt import SYSTEM_PROMPT_PATH\n\n    narration_path = SYSTEM_PROMPT_PATH.parent / \"narration.md\"\n    if not narration_path.exists():\n        raise FileNotFoundError(\n            f\"{narration_path} is missing. It should have been committed with the pipeline refactor.\"\n        )\n    return narration_path.read_text(\"utf-8\")\n\n\ndef build_narration_agent(model: object | None = None) -> Agent[None, NarrationOutput]:\n    \"\"\"A single-call, no-tool agent that narrates an AnswerView into prose.\n\n    `UsageLimits(request_limit=1)` is the contract: narration is prose generation\n    from a compact structured input, not exploration.\n    \"\"\"\n    resolved = _build_narration_model(model)\n    agent: Agent[None, NarrationOutput] = Agent(\n        resolved,  # type: ignore[arg-type]\n        output_type=NarrationOutput,\n        instructions=_narration_instructions(),\n    )\n    return agent\n\n\nasync def narrate(\n    view: AnswerView,\n    deps: Deps,\n    model: object | None = None,\n) -> NarrationOutput:\n    \"\"\"Run Stage 4: one model call, returns NarrationOutput.\n\n    Validates the narration output against the full envelope (deps.last_envelope),\n    not the capped summary_rows. The deterministic status note comes from the\n    view, never from model output. A validation failure is recorded for\n    diagnostics and raised without retrying the model.\n    \"\"\"\n    agent = build_narration_agent(model)\n    limits = UsageLimits(request_limit=1)\n    prompt_text = json.dumps(view.model_dump(), ensure_ascii=False, separators=(\",\", \":\"))\n    try:\n        result = await asyncio.wait_for(\n            agent.run(prompt_text, usage_limits=limits),\n            timeout=settings.LOOP_MAX_SECONDS,\n        )\n    except UsageLimitExceeded as exc:\n        raise RuntimeError(\"narration exceeded 1 model request\") from exc\n\n    narration = result.output\n\n    _validate_narration(view, deps, narration)\n\n    logger.debug(\n        \"narration complete\",\n        extra={\"subsystem\": \"narration\", \"question_id\": view.question_id},\n    )\n    return narration\n\n\ndef _validate_narration(\n    view: AnswerView,\n    deps: Deps,\n    narration: NarrationOutput,\n) -> None:\n    \"\"\"Validate prose against the full envelope and deterministic view fields.\"\"\"\n    if deps.last_envelope is None:\n        problems = [\"No evidence envelope is available for narration validation.\"]\n    else:\n        problems = rendering.validate_answer(\n            answer=narration.answer,\n            data_status_note=view.data_status_note,\n            question_id=view.question_id,\n            envelope=deps.last_envelope,\n            user_question=deps.user_question,\n        )\n\n    if not problems:\n        return\n\n    deps.output_validation_failures.append(problems)\n    logger.warning(\n        \"narration failed grounding validation\",\n        extra={\n            \"subsystem\": \"narration\",\n            \"question_id\": view.question_id,\n            \"validation_problems\": problems,\n        },\n    )\n    raise NarrationValidationError(problems)\n","numLines":171,"startLine":1,"totalLines":171}}}
