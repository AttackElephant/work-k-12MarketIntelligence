, stage=\"end-to-end\")\n    )\n    with_overrides_result, with_overrides_record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", factory, stage=\"end-to-end\",\n            intent_model=make_intent_model(StructuredIntent(question_id=\"excluded\")),\n            narration_model=make_narration_model(\"irrelevant\"),\n        )\n    )\n    assert plain_result.passed == with_overrides_result.passed\n    assert plain_record.output == with_overrides_record.output\n\n\ndef test_resume_with_wrong_stage_is_rejected(monkeypatch, tmp_path):\n    \"\"\"Resuming a checkpoint recorded with a different stage is rejected.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n\n    async def fake_suite(*args, **kwargs):\n        return [], [], [], None\n\n    monkeypatch.setattr(live, \"run_suite\", fake_suite)\n    monkeypatch.setattr(\"run.require_credentials\", lambda: None)\n\n    # Record a checkpoint with --stage intent\n    live.main(\n        [\"--stage\", \"intent\", \"--k\", \"1\", \"--case\", case.case_id,\n         \"--report-dir\", str(tmp_path)]\n    )","numLines":30,"startLine":739,"totalLines":777}}}
