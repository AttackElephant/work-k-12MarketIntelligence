{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VcwVxNJe1NdU3qX9HcjBUJ","type":"tool_result","content":"690\t    with pytest.raises(SystemExit, match=\"--stage narration is defined over the stub oracle\"):\n691\t        live.main([\"--stage\", \"narration\", \"--emitter\", \"real\"])\n692\t\n693\t\n694\t# --------------------------------------------------------------------------\n695\t# --stage end-to-end: contract compatibility — stays on the LEGACY tool-loop\n696\t# ask(build_agent(), deps, phrasing), never the new 4-stage pipeline\n697\t# --------------------------------------------------------------------------\n698\t\n699\t\n700\tdef test_stage_end_to_end_uses_the_legacy_tool_loop_like_the_default_stage():\n701\t    \"\"\"Contract compatibility (Planning review 1 / human guidance item 6):\n702\t    `--stage end-to-end` must NOT switch to the new `ask(deps, question)`\n703\t    pipeline. It stays `ask(build_agent(), deps, phrasing)` — the same legacy\n704\t    tool-loop path the default (no `--stage`) mode uses — and `main()`'s k=1\n705\t    constraint is the only thing that distinguishes it.\"\"\"\n706\t    case = CASES[\"answer/VC-POC-01\"]\n707\t    result, record = asyncio.run(\n708\t        live.run_trial(\n709\t            case, case.phrasings[0], 1, \"stub\", scripted_factory(case.case_id),\n710\t            stage=\"end-to-end\",\n711\t        )\n712\t    )\n713\t    assert result.passed, result.detail\n714\t    assert record is not None\n715\t    assert record.output_kind == \"RenderedAnswer\"\n716\t\n717\t\n718\tdef test_stage_end_to_end_and_default_produce_identical_results():\n719\t    \"\"\"Same case, same scripted agent, only `stage` differs: the two must agree\n720\t    exactly, because both run the identical code path.\"\"\"\n721\t    case = CASES[\"answer/VC-POC-01\"]\n722\t    factory = scripted_factory(case.case_id)\n723\t    default_result, default_record = asyncio.run(\n724\t        live.run_trial(case, case.phrasings[0], 1, \"stub\", factory)\n725\t    )\n726\t    e2e_result, e2e_record = asyncio.run(\n727\t        live.run_trial(case, case.phrasings[0], 1, \"stub\", factory, stage=\"end-to-end\")\n728\t    )\n729\t    assert default_result.passed == e2e_result.passed\n730\t    assert default_result.failed_graders == e2e_result.failed_graders\n731\t    assert default_record.output == e2e_record.output\n732\t\n733\t\n734\tdef test_stage_end_to_end_ignores_intent_and_narration_model_overrides():\n735\t    \"\"\"`intent_model`/`narration_model` are pipeline-only injection points; the\n736\t    legacy path `--stage end-to-end` runs has no such hooks, so passing them\n737\t    must not change the outcome versus omitting them.\"\"\"\n738\t    case = CASES[\"answer/VC-POC-01\"]\n739\t    factory = scripted_factory(case.case_id)"}]},"parent_tool_use_id":null,"session_id":"2e8b7dde-8bb0-4345-aaad-7bcee95758ae","uuid":"1df4fefa-ea00-43f6-81ad-e2a88f7acb8b","timestamp":"2026-09-26T10:05:03.325Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/tests/unit/test_live_tier.py","content":"    with pytest.raises(SystemExit, match=\"--stage narration is defined over the stub oracle\"):\n        live.main([\"--stage\", \"narration\", \"--emitter\", \"real\"])\n\n\n# --------------------------------------------------------------------------\n# --stage end-to-end: contract compatibility — stays on the LEGACY tool-loop\n# ask(build_agent(), deps, phrasing), never the new 4-stage pipeline\n# --------------------------------------------------------------------------\n\n\ndef test_stage_end_to_end_uses_the_legacy_tool_loop_like_the_default_stage():\n    \"\"\"Contract compatibility (Planning review 1 / human guidance item 6):\n    `--stage end-to-end` must NOT switch to the new `ask(deps, question)`\n    pipeline. It stays `ask(build_agent(), deps, phrasing)` — the same legacy\n    tool-loop path the default (no `--stage`) mode uses — and `main()`'s k=1\n    constraint is the only thing that distinguishes it.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", scripted_factory(case.case_id),\n            stage=\"end-to-end\",\n        )\n    )\n    assert result.passed, result.detail\n    assert record is not None\n    assert record.output_kind == \"RenderedAnswer\"\n\n\ndef test_stage_end_to_end_and_default_produce_identical_results():\n    \"\"\"Same case, same scripted agent, only `stage` differs: the two must agree\n    exactly, because both run the identical code path.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    factory = scripted_factory(case.case_id)\n    default_result, default_record = asyncio.run(\n        live.run_trial(case, case.phrasings[0], 1, \"stub\", factory)\n    )\n    e2e_result, e2e_record = asyncio.run(\n        live.run_trial(case, case.phrasings[0], 1, \"stub\", factory, stage=\"end-to-end\")\n    )\n    assert default_result.passed == e2e_result.passed\n    assert default_result.failed_graders == e2e_result.failed_graders\n    assert default_record.output == e2e_record.output\n\n\ndef test_stage_end_to_end_ignores_intent_and_narration_model_overrides():\n    \"\"\"`intent_model`/`narration_model` are pipeline-only injection points; the\n    legacy path `--stage end-to-end` runs has no such hooks, so passing them\n    must not change the outcome versus omitting them.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    factory = scripted_factory(case.case_id)","numLines":50,"startLine":690,"totalLines":777}}}
