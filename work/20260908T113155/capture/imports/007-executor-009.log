{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011CfRrt1tfqBPAZxnmkquTX","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0189Pn4HsjYcUeHNCT1FMNxf","name":"Edit","input":{"replace_all":false,"file_path":"/Users/shane/Projects/k-12Harness/tests/unit/test_live_tier.py","old_string":"def test_select_cases_for_narration_stage_keeps_only_cases_with_a_fixed_request():\n    args = live.build_parser().parse_args([\"--stage\", \"narration\"])\n    selected = live.select_cases(args)\n    assert selected\n    assert all(c.expected_question_id and c.expected_request is not None for c in selected)\n    assert \"clarify/distance_km\" not in {c.case_id for c in selected}\n    assert \"refuse/finance\" not in {c.case_id for c in selected}","new_string":"def test_select_cases_for_narration_stage_keeps_only_cases_with_a_stub_oracle():\n    \"\"\"PF-1: eligibility is having a `stub_case` oracle fixture, not merely a\n    fixed question/request — every eligible case in the current golden set\n    happens to carry both, but the primary gate is `stub_case`.\"\"\"\n    args = live.build_parser().parse_args([\"--stage\", \"narration\"])\n    selected = live.select_cases(args)\n    assert selected\n    assert all(c.stub_case is not None for c in selected)\n    assert all(c.expected_question_id and c.expected_request is not None for c in selected)\n    assert \"clarify/distance_km\" not in {c.case_id for c in selected}\n    assert \"refuse/finance\" not in {c.case_id for c in selected}\n\n\ndef test_select_cases_for_narration_stage_prints_the_excluded_count(capsys):\n    args = live.build_parser().parse_args([\"--stage\", \"narration\"])\n    all_cases = live.build_parser().parse_args([])\n    total = len(live.select_cases(all_cases))\n    selected = live.select_cases(args)\n    excluded = total - len(selected)\n    out = capsys.readouterr().out\n    assert f\"excluded {excluded} case(s)\" in out\n\n\ndef test_select_cases_for_narration_stage_exits_non_zero_when_nothing_is_eligible():\n    \"\"\"Every case that direction/case filters could select has no stub_case, so\n    the narration selection ends up empty and the run must fail loudly rather\n    than silently reporting an empty success.\"\"\"\n    args = live.build_parser().parse_args(\n        [\"--stage\", \"narration\", \"--direction\", \"should_clarify\"]\n    )\n    with pytest.raises(SystemExit, match=\"no cases selected\"):\n        live.select_cases(args)\n\n\ndef test_stage_narration_with_emitter_real_is_refused_at_argument_validation():\n    \"\"\"PF-1: the narration oracle is always the stub emitter; --emitter real is\n    refused up front rather than silently ignored.\"\"\"\n    with pytest.raises(SystemExit, match=\"--stage narration is defined over the stub oracle\"):\n        live.main([\"--stage\", \"narration\", \"--emitter\", \"real\"])"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1463,"cache_read_input_tokens":152167,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1463},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2e8b7dde-8bb0-4345-aaad-7bcee95758ae","uuid":"be859a0f-562f-427a-a7a5-37e4cc22cacf","request_id":"req_011CfRrt1CVeUnRMB1LLaf2J"}
