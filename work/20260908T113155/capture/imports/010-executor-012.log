{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WiBMAwR4B1boKy62MuQpQK","type":"tool_result","content":"255\t\n256\t@pytest.mark.parametrize(\n257\t    \"label,case_id,mutate,grader\",\n258\t    MUTATIONS,\n259\t    ids=[m[0].replace(\" \", \"-\") for m in MUTATIONS],\n260\t)\n261\tdef test_mutation_is_caught_by_its_grader(label, case_id, mutate, grader):\n262\t    caught = _graded(case_id, mutate)\n263\t    assert grader in caught, (\n264\t        f\"{label!r} was not caught by {grader}; failing graders were {caught or 'none'}\"\n265\t    )\n266\t\n267\t\n268\t# --------------------------------------------------------------------------\n269\t# isolated-stage graders (evals/live.py --stage intent|narration)\n270\t#\n271\t# `grade_intent_question_match` takes a `StructuredIntent` that never went\n272\t# through the full tool-loop transcript the graders above assume, so it\n273\t# cannot be driven through `_graded`/`grade_case`'s default dispatch. It gets\n274\t# its own runner here — and, same as every grader above, a mutation that must\n275\t# be genuinely caught, not merely declared.\n276\t# --------------------------------------------------------------------------\n277\t\n278\t\n279\tdef _reference_intent(case_id: str) -> SimpleNamespace:\n280\t    \"\"\"A minimal stand-in for `StructuredIntent`: the isolated intent graders\n281\t    only ever read `.question_id` off it.\"\"\"\n282\t    case = CASES[case_id]\n283\t    question_id = \"excluded\" if case.direction == \"should_refuse\" else case.expected_question_id\n284\t    return SimpleNamespace(question_id=question_id)\n285\t\n286\t\n287\tdef _mutate_intent(case_id: str, mutate: Callable[[Any], None]) -> SimpleNamespace:\n288\t    intent = _reference_intent(case_id)\n289\t    mutate(intent)\n290\t    return intent\n291\t\n292\t\n293\tdef _intent_question_match_mutation() -> list[str]:\n294\t    intent = _mutate_intent(\"answer/VC-POC-01\", lambda i: setattr(i, \"question_id\", \"VC-POC-04\"))\n295\t    return [\n296\t        r.grader\n297\t        for r in failures([grade_intent_question_match(CASES[\"answer/VC-POC-01\"], intent)])\n298\t    ]\n299\t\n300\t\n301\t# (label, runner, the grader that must catch it)\n302\tISOLATED_MUTATIONS: list[tuple[str, Callable[[], list[str]], str]] = [\n303\t    (\n304\t        \"intent classifies the wrong registry question\",\n305\t        _intent_question_match_mutation,\n306\t        \"intent_question_match\",\n307\t    ),\n308\t]\n309\t\n310\t\n311\t@pytest.mark.parametrize(\n312\t    \"label,run,grader\",\n313\t    ISOLATED_MUTATIONS,\n314\t    ids=[m[0].replace(\" \", \"-\") for m in ISOLATED_MUTATIONS],\n315\t)\n316\tdef test_isolated_stage_mutation_is_caught_by_its_grader(label, run, grader):\n317\t    caught = run()\n318\t    assert grader in caught, (\n319\t        f\"{label!r} was not caught by {grader}; failing graders were {caught or 'none'}\"\n320\t    )\n321\t\n322\t\n323\tdef test_every_grader_has_at_least_one_mutation():\n324\t    \"\"\"A grader with no mutation behind it is untested code that reports\n325\t    success — the exact shape of a green suite that measures nothing.\n326\t\n327\t    Covers every module-level `grade_*` function, including the isolated-stage\n328\t    grader (`grade_intent_question_match`), whose mutation lives in\n329\t    `ISOLATED_MUTATIONS` above because it is not `RunRecord`-shaped like the\n330\t    rest of `MUTATIONS`.\n331\t    \"\"\"\n332\t    from evals import graders\n333\t\n334\t    covered = {grader for _, _, _, grader in MUTATIONS} | {"}]},"parent_tool_use_id":null,"session_id":"bb87d7c1-606f-403f-bd3c-0f85dd399119","uuid":"a4a36bd2-c78b-4dee-ac8b-931d9642245f","timestamp":"2026-09-26T13:35:42.386Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/tests/unit/test_graders.py","content":"\n@pytest.mark.parametrize(\n    \"label,case_id,mutate,grader\",\n    MUTATIONS,\n    ids=[m[0].replace(\" \", \"-\") for m in MUTATIONS],\n)\ndef test_mutation_is_caught_by_its_grader(label, case_id, mutate, grader):\n    caught = _graded(case_id, mutate)\n    assert grader in caught, (\n        f\"{label!r} was not caught by {grader}; failing graders were {caught or 'none'}\"\n    )\n\n\n# --------------------------------------------------------------------------\n# isolated-stage graders (evals/live.py --stage intent|narration)\n#\n# `grade_intent_question_match` takes a `StructuredIntent` that never went\n# through the full tool-loop transcript the graders above assume, so it\n# cannot be driven through `_graded`/`grade_case`'s default dispatch. It gets\n# its own runner here — and, same as every grader above, a mutation that must\n# be genuinely caught, not merely declared.\n# --------------------------------------------------------------------------\n\n\ndef _reference_intent(case_id: str) -> SimpleNamespace:\n    \"\"\"A minimal stand-in for `StructuredIntent`: the isolated intent graders\n    only ever read `.question_id` off it.\"\"\"\n    case = CASES[case_id]\n    question_id = \"excluded\" if case.direction == \"should_refuse\" else case.expected_question_id\n    return SimpleNamespace(question_id=question_id)\n\n\ndef _mutate_intent(case_id: str, mutate: Callable[[Any], None]) -> SimpleNamespace:\n    intent = _reference_intent(case_id)\n    mutate(intent)\n    return intent\n\n\ndef _intent_question_match_mutation() -> list[str]:\n    intent = _mutate_intent(\"answer/VC-POC-01\", lambda i: setattr(i, \"question_id\", \"VC-POC-04\"))\n    return [\n        r.grader\n        for r in failures([grade_intent_question_match(CASES[\"answer/VC-POC-01\"], intent)])\n    ]\n\n\n# (label, runner, the grader that must catch it)\nISOLATED_MUTATIONS: list[tuple[str, Callable[[], list[str]], str]] = [\n    (\n        \"intent classifies the wrong registry question\",\n        _intent_question_match_mutation,\n        \"intent_question_match\",\n    ),\n]\n\n\n@pytest.mark.parametrize(\n    \"label,run,grader\",\n    ISOLATED_MUTATIONS,\n    ids=[m[0].replace(\" \", \"-\") for m in ISOLATED_MUTATIONS],\n)\ndef test_isolated_stage_mutation_is_caught_by_its_grader(label, run, grader):\n    caught = run()\n    assert grader in caught, (\n        f\"{label!r} was not caught by {grader}; failing graders were {caught or 'none'}\"\n    )\n\n\ndef test_every_grader_has_at_least_one_mutation():\n    \"\"\"A grader with no mutation behind it is untested code that reports\n    success — the exact shape of a green suite that measures nothing.\n\n    Covers every module-level `grade_*` function, including the isolated-stage\n    grader (`grade_intent_question_match`), whose mutation lives in\n    `ISOLATED_MUTATIONS` above because it is not `RunRecord`-shaped like the\n    rest of `MUTATIONS`.\n    \"\"\"\n    from evals import graders\n\n    covered = {grader for _, _, _, grader in MUTATIONS} | {","numLines":80,"startLine":255,"totalLines":411}}}
