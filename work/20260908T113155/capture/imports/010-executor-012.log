{"type":"stream_event","event":{"type":"message_delta","delta":{"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"container":null},"usage":{"input_tokens":2,"cache_creation_input_tokens":2726,"cache_read_input_tokens":67830,"output_tokens":204,"output_tokens_details":{"thinking_tokens":0},"iterations":[{"input_tokens":2,"output_tokens":204,"cache_read_input_tokens":67830,"cache_creation_input_tokens":2726,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2726},"type":"message"}]},"context_management":{"applied_edits":[]}},"session_id":"bb87d7c1-606f-403f-bd3c-0f85dd399119","parent_tool_use_id":null,"uuid":"dbead723-0d5b-45f1-9c17-ad9585eea1d6"}
