{"at": "2026-09-25T14:25:12Z", "data": {"authorised_by": "shane", "classification_preserved": null, "disposition": "remediate", "finding": "PF-2", "improvement": null, "origin": "planning", "rationale": "Plan: no final report on rejection; existing checkpoint kept unchanged and resumable; truthful exit message; both cases tested per stage.", "reference": null, "residual_risk": null, "review": "PR1", "round": 1, "severity": "blocking", "successor": null, "summary": "“CredentialsRejected writes no report” conflicts with checkpoint-after-every-completed-trial semantics.", "work_package": null}, "previous_sha256": "bfb6a8ecf68262c423a73bb4afaacae6ec1b343b157ca88cae06f47b6e65348a", "seq": 43, "sha256": "67b57288ddbe2a5580feec2a976bc86eed86576be1712bd8ece74f751a3a3631", "source": {"method_commit": "e9cb570881b15fb5108f031d6fe3dd11fe14f180", "method_dirty": false, "method_version": "0.5.0", "tool": "coding-harness", "tool_version": "0.2.0"}, "type": "finding.dispositioned"}
{"at": "2026-09-25T14:25:13Z", "data": {"authorised_by": "shane", "classification_preserved": null, "disposition": "remediate", "finding": "PF-3", "improvement": null, "origin": "planning", "rationale": "Plan: isolation test replaced by intent-perturbation equality plus spies proving interpret_intent and evidence fetch are never called in narration.", "reference": null, "residual_risk": null, "review": "PR1", "round": 1, "severity": "material", "successor": null, "summary": "The defining narration-isolation test injects an intent into a stage that is specified not to execute or consume intent.", "work_package": null}, "previous_sha256": "67b57288ddbe2a5580feec2a976bc86eed86576be1712bd8ece74f751a3a3631", "seq": 44, "sha256": "c4bfb0413f94c2686dedca891e2c8a935ecfdc470d7f97c5ae6bd7d37a8f2378", "source": {"method_commit": "e9cb570881b15fb5108f031d6fe3dd11fe14f180", "method_dirty": false, "method_version": "0.5.0", "tool": "coding-harness", "tool_version": "0.2.0"}, "type": "finding.dispositioned"}
