ASSISTANT 
ASSISTANT def _load_request_schema(question_id: str) -> dict[str, Any]:
ASSISTANT     """Load the pinned request schema for a question."""
ASSISTANT     schema_path = Path(__file__).resolve().parents[2] / "contract" / "question_schemas" / "v0.3.0" / f"{question_id}.request.schema.json"
ASSISTANT     if not schema_path.exists():
ASSISTANT         raise TerminalError(f"Request schema not found for {question_id}: {schema_path}")
ASSISTANT     
ASSISTANT     try:
ASSISTANT         with open(schema_path) as f:
ASSISTANT             return json.load(f)
ASSISTANT     except (json.JSONDecodeError, OSError) as exc:
ASSISTANT         raise TerminalError(f"Failed to load request schema for {question_id}: {exc}")
ASSISTANT 
ASSISTANT 
ASSISTANT def _validate_request(question_id: str, request: dict[str, Any]) -> None:
ASSISTANT     """Validate the request against its registered pinned request schema.
ASSISTANT     
ASSISTANT     Raises TerminalError for planner-produced schema violations.
ASSISTANT     Raises ClarificationNeeded for user-correctable value problems (handled earlier).
ASSISTANT     """
ASSISTANT     schema = _load_request_schema(question_id)
ASSISTANT     
ASSISTANT     try:
ASSISTANT         Draft202012Validator(schema).validate(request)
ASSISTANT     except jsonschema.ValidationError as exc:
ASSISTANT         # This is a planner/contract defect - the planner built an invalid request
ASSISTANT         raise TerminalError(
ASSISTANT             f"Planner-produced request for {question_id} violates its schema: {exc.message}"
ASSISTANT         )
ASSISTANT 
ASSISTANT 
ASSISTANT async def plan_and_execute(
ASSISTANT     intent: StructuredIntent,
ASSISTANT     client: EvidenceClient,
ASSISTANT     deps: Deps,
ASSISTANT ) -> dict[str, Any] | ClarificationNeeded | Unsupported:
ASSISTANT     """Deterministic Stage 2: intent → evidence envelope or typed refusal.
ASSISTANT     
ASSISTANT     Returns:
ASSISTANT         dict — the evidence envelope (happy path)
ASSISTANT         ClarificationNeeded — a material input is missing or a user selector cannot be normalized
ASSISTANT         Unsupported — an exclusion, unknown question, or unanswerable request
ASSISTANT     May raise:
ASSISTANT         TerminalError — an operational stop (data_unavailable, internal) or planner/contract defect
ASSISTANT     """
ASSISTANT     question_id = intent.question_id
ASSISTANT     deps.intent = intent  # Store for downstream use
ASSISTANT     
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     # 1. Excluded topic (intent model classified it as out of scope)
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     if question_id == "excluded":
ASSISTANT         exclusion_text = _find_exclusion_text(intent.excluded_topic)
ASSISTANT         logger.debug(
ASSISTANT             "intent classified as excluded topic",
ASSISTANT             extra={"subsystem": "planner", "excluded_topic": intent.excluded_topic},
ASSISTANT         )
ASSISTANT         return Unsupported(
ASSISTANT             reason_kind="excluded_by_contract",
ASSISTANT             reason=exclusion_text,
ASSISTANT         )
ASSISTANT 
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     # 2. Registry-owned excluded question (e.g. VC-POC-TRANSPORT-01)
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     excluded = contract.excluded_questions().get(question_id)
ASSISTANT     if excluded:
ASSISTANT         reason_code = excluded.get("reason_code")
ASSISTANT         reason_kind = (
ASSISTANT             "not_yet_validated"
ASSISTANT             if reason_code == "not_yet_validated"
ASSISTANT             else "excluded_by_contract"
ASSISTANT         )
ASSISTANT         return Unsupported(
ASSISTANT             reason_kind=reason_kind,
ASSISTANT             reason=excluded.get("message", ""),
ASSISTANT             reason_code=reason_code,
ASSISTANT         )
ASSISTANT 
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     # 3. Registered but gated question (e.g. VC-POC-14 via availability)
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     if question_id in contract.questions():
ASSISTANT         refusal = contract.refusal_for(question_id)
ASSISTANT         if refusal is not None:
ASSISTANT             reason_code = refusal.get("reason_code")
ASSISTANT             reason_kind = (
ASSISTANT                 "not_yet_validated"
ASSISTANT                 if reason_code == "not_yet_validated"
ASSISTANT                 else "excluded_by_contract"
ASSISTANT             )
ASSISTANT             return Unsupported(
ASSISTANT                 reason_kind=reason_kind,
ASSISTANT                 reason=refusal.get("message", ""),
ASSISTANT                 reason_code=reason_code,
ASSISTANT             )
ASSISTANT 
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     # 4. Not in registry at all (unknown question)
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     if question_id not in contract.questions() and question_id not in contract.excluded_questions():
ASSISTANT         if question_id == "unknown":
ASSISTANT             return Unsupported(
ASSISTANT                 reason_kind="not_in_registry",
ASSISTANT                 reason="The question does not map to any approved registry question.",
ASSISTANT             )
ASSISTANT         return Unsupported(
ASSISTANT             reason_kind="not_in_registry",
ASSISTANT             reason=f"{question_id} is not a registry question.",
ASSISTANT         )
ASSISTANT 
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     # 5. Resolve schools (if any mentions)
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     resolved_ids: list[int] = []
ASSISTANT     if intent.school_mentions:
ASSISTANT         try:
ASSISTANT             resolved_ids = await _resolve_school_mentions(client, intent.school_mentions, deps)
ASSISTANT         except ClarificationNeeded:
ASSISTANT             raise  # Re-raise clarification for school resolution failures
ASSISTANT         except Exception:
ASSISTANT             raise  # Re-raise other exceptions (operational)
ASSISTANT 
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     # 6. Build the evidence request
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     try:
ASSISTANT         request = _build_request(question_id, intent, resolved_ids)
ASSISTANT     except ClarificationNeeded:
ASSISTANT         raise  # Re-raise clarification for selector normalization failures
ASSISTANT 
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     # 7. Derive missing required/material/conditional-material inputs
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     missing_inputs = _derive_missing_inputs(question_id, request, intent)
ASSISTANT     if missing_inputs:
ASSISTANT         prompt_to_user = (
ASSISTANT             f"To answer this question I need "
ASSISTANT             + ", ".join(f"the {m.input}" for m in missing_inputs)
ASSISTANT             + ". Could you provide "
ASSISTANT             + ("it" if len(missing_inputs) == 1 else "them")
ASSISTANT             + "?"
ASSISTANT         )
ASSISTANT         raise ClarificationNeeded(
ASSISTANT             question_id=question_id,
ASSISTANT             missing=missing_inputs,
ASSISTANT             prompt_to_user=prompt_to_user,
ASSISTANT         )
ASSISTANT 
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     # 8. Validate request against pinned schema
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     try:
ASSISTANT         _validate_request(question_id, request)
ASSISTANT     except TerminalError:
ASSISTANT         raise  # Re-raise planner schema defects
ASSISTANT     except ClarificationNeeded:
ASSISTANT         raise  # Re-raise (shouldn't happen here but safe)
ASSISTANT 
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     # 9. Fetch evidence
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     arguments = {"question_id": question_id, "request": request}
ASSISTANT     try:
ASSISTANT         envelope = await client.fetch_evidence(question_id, request)
ASSISTANT     except EvidenceError as exc:
ASSISTANT         deps.tool_calls.append(
ASSISTANT             ToolInvocation("fetch_evidence", arguments, error_kind=exc.error_kind)
ASSISTANT         )
ASSISTANT         return _branch_evidence_error(question_id, exc, request)
ASSISTANT     except Exception:
ASSISTANT         deps.tool_calls.append(
ASSISTANT             ToolInvocation("fetch_evidence", arguments, error_kind="operational")
ASSISTANT         )
ASSISTANT         raise
ASSISTANT 
ASSISTANT     deps.tool_calls.append(ToolInvocation("fetch_evidence", arguments, envelope))
ASSISTANT     deps.last_envelope = envelope
ASSISTANT     logger.debug(
ASSISTANT         "evidence fetched by planner",
ASSISTANT         extra={"subsystem": "planner", "question_id": question_id},
ASSISTANT     )
ASSISTANT     return envelope
ASSISTANT 
ASSISTANT 
ASSISTANT def _branch_evidence_error(
ASSISTANT     question_id: str,
ASSISTANT     exc: EvidenceError,
ASSISTANT     request: dict[str, Any],
ASSISTANT ) -> Unsupported:
ASSISTANT     """Translate an EvidenceError into an Unsupported outcome or raise TerminalError.
ASSISTANT     
ASSISTANT     - Caller-supplied numeric ID that produces bad_request → identity clarification
ASSISTANT     - Any other bad_request after local schema validation → TerminalError (planner/contract drift)
ASSISTANT     - excluded_question, unknown_question, unanswerable → Unsupported (typed abstention)
ASSISTANT     - data_unavailable, internal → TerminalError (operational stop)
ASSISTANT     """
ASSISTANT     kind = exc.error_kind
ASSISTANT     logger.debug(
ASSISTANT         "evidence error in planner",
ASSISTANT         extra={"subsystem": "planner", "error_kind": kind, "question_id": question_id},
ASSISTANT     )
ASSISTANT 
ASSISTANT     if kind == "excluded_question":
ASSISTANT         reason_code = exc.reason_code or contract.reason_code_for(question_id)
ASSISTANT         reason_kind = (
ASSISTANT             "not_yet_validated"
ASSISTANT             if reason_code == "not_yet_validated"
ASSISTANT             else "excluded_by_contract"
ASSISTANT         )
ASSISTANT         return Unsupported(
ASSISTANT             reason_kind=reason_kind,
ASSISTANT             reason=exc.message,
ASSISTANT             reason_code=reason_code,
ASSISTANT         )
ASSISTANT 
ASSISTANT     if kind == "unknown_question":
ASSISTANT         return Unsupported(reason_kind="not_in_registry", reason=exc.message)
ASSISTANT 
ASSISTANT     if kind == "unanswerable":
ASSISTANT         return Unsupported(reason_kind="unanswerable", reason=exc.message)
ASSISTANT 
ASSISTANT     if kind == "bad_request":
ASSISTANT         # Check if this is a caller-supplied numeric ID that failed
ASSISTANT         # (explicit ACARA ID in request that emitter says is absent from directory)
ASSISTANT         has_explicit_id = (
ASSISTANT             "acara_sml_id" in request or "acara_sml_ids" in request
ASSISTANT         )
ASSISTANT         # The emitter returns bad_request for IDs absent from pinned directory
ASSISTANT         # Per plan: treat as identity clarification for explicit IDs
ASSISTANT         if has_explicit_id:
ASSISTANT             return Unsupported(
ASSISTANT                 reason_kind="identity_clarification",
ASSISTANT                 reason=exc.message,
ASSISTANT             )
ASSISTANT         # Any other bad_request after local validation = planner/contract drift
ASSISTANT         raise TerminalError(
ASSISTANT             f"Schema-valid request for {question_id} received bad_request from emitter: {exc.message}. "
ASSISTANT             f"This indicates planner/contract drift."
ASSISTANT         )
ASSISTANT 
ASSISTANT     # data_unavailable | internal — operational stop, not a refusal.
ASSISTANT     raise TerminalError(f"evidence emitter reported {kind}: {exc.message}")
ASSISTANT ```
ASSISTANT 
ASSISTANT ## 2. run.py - Route default CLI through deterministic pipeline
ASSISTANT 
ASSISTANT ```python
ASSISTANT #!/usr/bin/env python
ASSISTANT """Ask the harness a question from a terminal (architecture §3).
ASSISTANT 
ASSISTANT     .venv/bin/python run.py "How many students at Alpha College?"
ASSISTANT     .venv/bin/python run.py --stub "..."     # canned fixtures, no data project
ASSISTANT     .venv/bin/python run.py --json "..."     # the HarnessOutput, machine-readable
ASSISTANT 
ASSISTANT This is the entry point the live eval tier and the M5 demo both need, and the
ASSISTANT first thing in the repo that lets a human ask a question at all.
ASSISTANT 
ASSISTANT What it does, and deliberately does not do:
ASSISTANT 
ASSISTANT * It **renders**, it does not compose. Limitations and confidence are printed
ASSISTANT   from the fields the harness attached out of the envelope (ADR-009). Nothing
ASSISTANT   here paraphrases them, reorders them, or drops one for brevity — and there is
ASSISTANT   no `--brief` that would.
ASSISTANT * It carries **one clarification round-trip** by default (O-3): a
ASSISTANT   `ClarificationNeeded` is put to the user, the reply is appended to the message
ASSISTANT   history, and the run continues. A question still ambiguous after the last
ASSISTANT   round returns the clarification unanswered rather than guessing.
ASSISTANT * It **configures logging once**, here, as every entry point must.
ASSISTANT 
ASSISTANT Exit codes are outcomes, not errors — a refusal and a clarification are correct
ASSISTANT results of a working system:
ASSISTANT 
ASSISTANT     0  answered            3  unsupported (an honest refusal)
ASSISTANT     2  clarification open  4  a budget tripped        1  operational failure
ASSISTANT """
ASSISTANT 
ASSISTANT from __future__ import annotations
ASSISTANT 
ASSISTANT import argparse
ASSISTANT import asyncio
ASSISTANT import json
ASSISTANT import sys
ASSISTANT from pathlib import Path
ASSISTANT from typing import Any, Callable
ASSISTANT 
ASSISTANT PROJECT_ROOT = Path(__file__).resolve().parent
ASSISTANT if str(PROJECT_ROOT) not in sys.path:
ASSISTANT     sys.path.insert(0, str(PROJECT_ROOT))
ASSISTANT 
