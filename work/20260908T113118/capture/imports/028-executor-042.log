ASSISTANT """M4 — the CLI entry point renders faithfully and carries a clarification.
ASSISTANT 
ASSISTANT `run.py` is where a human meets this system, so the two things graded here are
ASSISTANT the two things a demo could quietly get wrong:
ASSISTANT 
ASSISTANT 1. **It renders what the harness preserved.** Every limitation string appears in
ASSISTANT    the output, verbatim; the confidence axes appear as the data layer stated
ASSISTANT    them, with no overall grade added; provenance is shown. A renderer that
ASSISTANT    summarised any of these would pass the agent's own gates and break the
ASSISTANT    contract at the last inch (ADR-009).
ASSISTANT 2. **It carries one clarification round-trip on real message history** — and
ASSISTANT    stops rather than guessing when there is no answer to be had (O-3).
ASSISTANT 
ASSISTANT The model is scripted throughout; nothing here needs a network or a credential.
ASSISTANT """
ASSISTANT 
ASSISTANT from __future__ import annotations
ASSISTANT 
ASSISTANT import asyncio
ASSISTANT import json
ASSISTANT import sys
ASSISTANT from pathlib import Path
ASSISTANT from typing import Any
ASSISTANT 
ASSISTANT import pytest
ASSISTANT from pydantic_ai.messages import ModelMessage, ModelResponse, ToolCallPart
ASSISTANT from pydantic_ai.models.function import AgentInfo, FunctionModel
ASSISTANT 
ASSISTANT import run as cli
ASSISTANT from evals import replay as replay_mod
ASSISTANT from evals.schema import load_cases, load_reference_solutions
ASSISTANT from harness.agent import ask, build_agent
ASSISTANT from harness.evidence import EvidenceClient
ASSISTANT from harness.outputs import BudgetExceeded, ClarificationNeeded, MissingInput, Unsupported
ASSISTANT from harness.tools import Deps
ASSISTANT 
ASSISTANT PROJECT_ROOT = Path(__file__).resolve().parents[2]
ASSISTANT STUB = PROJECT_ROOT / "evals" / "stub_emitter.py"
ASSISTANT 
ASSISTANT CASES = {c.case_id: c for c in load_cases()}
ASSISTANT REFERENCES = load_reference_solutions()
ASSISTANT 
ASSISTANT 
ASSISTANT def stub_client() -> EvidenceClient:
ASSISTANT     return EvidenceClient(python=Path(sys.executable), emitter=STUB)
ASSISTANT 
ASSISTANT 
ASSISTANT def answered() -> Any:
ASSISTANT     """A real RenderedAnswer, produced by replaying a golden case through the
ASSISTANT     production path — not a hand-built object that might not be reachable."""
ASSISTANT     case = CASES["answer/VC-POC-01"]
ASSISTANT     agent = build_agent(model=replay_mod.scripted_model(REFERENCES[case.case_id]))
ASSISTANT     deps = Deps(client=stub_client())
ASSISTANT     return asyncio.run(ask(agent, deps, case.phrasings[0], record_usage=False))
