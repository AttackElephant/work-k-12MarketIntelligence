ASSISTANT def _derive_missing_inputs(
ASSISTANT     question_id: str, request: dict[str, Any], intent: StructuredIntent
ASSISTANT ) -> list[MissingInput]:
ASSISTANT     """Derive missing required, material, and applicable conditional-material inputs
ASSISTANT     from the pinned question policy and assembled request.
ASSISTANT     
ASSISTANT     Ignores StructuredIntent.missing_material_inputs entirely.
ASSISTANT     """
ASSISTANT     policy = contract.input_policy_for(question_id)
ASSISTANT     required = set(policy.get("required", []))
ASSISTANT     material = set(policy.get("material", []))
ASSISTANT     conditional_material = policy.get("conditional_material", {})
ASSISTANT     defaultable = policy.get("defaultable", {})
ASSISTANT     
ASSISTANT     # Inputs that are defaultable by the emitter are not user-material
ASSISTANT     user_material = (required | material) - set(defaultable.keys())
ASSISTANT     
ASSISTANT     # Evaluate conditional materiality
ASSISTANT     for cond_input, condition in conditional_material.items():
ASSISTANT         # Only known condition: distance_km when market_definition == "distance"
ASSISTANT         if cond_input == "distance_km" and condition == "market_definition == distance":
ASSISTANT             if request.get("market_definition") == "distance":
ASSISTANT                 user_material.add(cond_input)
ASSISTANT         else:
ASSISTANT             # Unknown conditional expression = contract drift
ASSISTANT             raise TerminalError(
ASSISTANT                 f"Unknown conditional material expression for {question_id}: "
ASSISTANT                 f"{cond_input} when {condition}"
ASSISTANT             )
ASSISTANT     
ASSISTANT     missing = []
ASSISTANT     for input_name in sorted(user_material):  # Stable policy order
ASSISTANT         if input_name not in request or request[input_name] is None:
ASSISTANT             # For array fields, empty array counts as missing
ASSISTANT             if input_name in request and isinstance(request[input_name], list) and len(request[input_name]) == 0:
ASSISTANT                 missing.append(MissingInput(
ASSISTANT                     input=input_name,
ASSISTANT                     why_material=_material_why(question_id, input_name),
ASSISTANT                     allowed_values=_allowed_values_for_input(question_id, input_name),
ASSISTANT                 ))
ASSISTANT             elif input_name not in request:
ASSISTANT                 missing.append(MissingInput(
ASSISTANT                     input=input_name,
ASSISTANT                     why_material=_material_why(question_id, input_name),
ASSISTANT                     allowed_values=_allowed_values_for_input(question_id, input_name),
ASSISTANT                 ))
ASSISTANT     
ASSISTANT     return missing
ASSISTANT 
ASSISTANT 
ASSISTANT def _allowed_values_for_input(question_id: str, input_name: str) -> list[str]:
ASSISTANT     """Get allowed values for a material input from static vocabularies."""
ASSISTANT     # Check selector routing for this question
ASSISTANT     routing = _SELECTOR_ROUTING.get(question_id, {})
ASSISTANT     for field, vocab_key in routing.items():
ASSISTANT         if field == input_name or (field.endswith(".<keys>") and input_name in field):
ASSISTANT             if vocab_key in _STATIC_VOCABULARIES:
ASSISTANT                 return _STATIC_VOCABULARIES[vocab_key]
ASSISTANT             # Handle nested vocab keys like release_derived_values.erp_age
ASSISTANT             if vocab_key.startswith("release_derived_values."):
ASSISTANT                 # These are release-derived, not static enums - return empty for clarification
ASSISTANT                 return []
ASSISTANT     
ASSISTANT     # Special cases
ASSISTANT     if input_name == "distance_km":
ASSISTANT         return []  # Positive finite number, no enum
ASSISTANT     if input_name in ("acara_sml_id", "acara_sml_ids", "sa2_codes", "lga_codes", "zone_entity_code"):
ASSISTANT         return []  # Release-derived or open values
ASSISTANT     
ASSISTANT     return []
ASSISTANT 
ASSISTANT 
ASSISTANT def _material_why(question_id: str, input_name: str) -> str:
ASSISTANT     """A one-sentence human-readable explanation of why an input is material."""
ASSISTANT     explanations: dict[str, str] = {
ASSISTANT         "market_definition": "The market boundary changes which schools are compared.",
ASSISTANT         "distance_km": "\"Near\" is not a distance — the radius determines which schools qualify.",
ASSISTANT         "grades": "The grade selection determines which year levels are included.",
ASSISTANT         "peer_filters": "The peer group definition determines which schools are compared.",
ASSISTANT         "segment_filters": "The segment definition determines which schools are included.",
ASSISTANT         "sa2_codes": "The SA2 area determines which geographic area is analysed.",
ASSISTANT         "zone_entity_code": "The zone entity code identifies the government zone to look up.",
ASSISTANT         "acara_sml_id": "The school identity is required to fetch its profile.",
ASSISTANT         "acara_sml_ids": "At least two school identities are required for comparison.",
ASSISTANT     }
ASSISTANT     return explanations.get(
ASSISTANT         input_name,
ASSISTANT         f"{input_name} is required by the data layer and cannot be defaulted for this question.",
ASSISTANT     )
ASSISTANT 
