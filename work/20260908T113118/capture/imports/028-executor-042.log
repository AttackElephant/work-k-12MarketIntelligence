ASSISTANT     # All mentions resolved successfully - commit to Deps
ASSISTANT     deps.resolved_school_ids.extend(staged_ids)
ASSISTANT     deps.searched = True
ASSISTANT     
ASSISTANT     return staged_ids
ASSISTANT 
ASSISTANT 
ASSISTANT def _build_request(
ASSISTANT     question_id: str, intent: StructuredIntent, resolved_ids: list[int]
ASSISTANT ) -> dict[str, Any]:
ASSISTANT     """Build the evidence request from explicit intent fields and planner-owned selectors.
ASSISTANT     
ASSISTANT     Omits unsupplied defaultable values (emitter owns defaults).
ASSISTANT     Normalizes and routes selectors to question-specific fields.
ASSISTANT     """
ASSISTANT     request: dict[str, Any] = dict(intent.filters)
ASSISTANT     
ASSISTANT     # Attach resolved school IDs using the right field name for this question
ASSISTANT     q_entry = contract.questions().get(question_id, {})
ASSISTANT     required = q_entry.get("input_policy", {}).get("required", [])
ASSISTANT     
ASSISTANT     if resolved_ids:
ASSISTANT         if "acara_sml_ids" in required:
ASSISTANT             request["acara_sml_ids"] = resolved_ids
ASSISTANT         elif "acara_sml_id" in required and resolved_ids:
ASSISTANT             request["acara_sml_id"] = resolved_ids[0]
ASSISTANT     
ASSISTANT     # Handle explicit IDs from intent.filters (caller-supplied numeric IDs)
ASSISTANT     # These take precedence over name-resolved IDs if both present
ASSISTANT     if "acara_sml_id" in intent.filters and "acara_sml_id" in required:
ASSISTANT         request["acara_sml_id"] = intent.filters["acara_sml_id"]
ASSISTANT     if "acara_sml_ids" in intent.filters and "acara_sml_ids" in required:
ASSISTANT         request["acara_sml_ids"] = intent.filters["acara_sml_ids"]
ASSISTANT     
ASSISTANT     # Normalize and route requested metrics/selectors
ASSISTANT     if intent.requested_metrics:
ASSISTANT         routing = _SELECTOR_ROUTING.get(question_id, {})
ASSISTANT         
ASSISTANT         if "metrics" in routing:
ASSISTANT             vocab_key = routing["metrics"]
ASSISTANT             if vocab_key in _STATIC_VOCABULARIES:
ASSISTANT                 canonical, unnormalizable = _apply_aliases_and_validate(
ASSISTANT                     intent.requested_metrics, _STATIC_VOCABULARIES[vocab_key], "metrics"
ASSISTANT                 )
ASSISTANT                 if unnormalizable:
ASSISTANT                     raise ClarificationNeeded(
ASSISTANT                         question_id=question_id,
ASSISTANT                         missing=[MissingInput(
ASSISTANT                             input="metrics",
ASSISTANT                             why_material=f"Unknown metric(s): {', '.join(unnormalizable)}. Allowed: {', '.join(_STATIC_VOCABULARIES[vocab_key])}",
ASSISTANT                             allowed_values=_STATIC_VOCABULARIES[vocab_key],
ASSISTANT                         )],
ASSISTANT                         prompt_to_user=f"Unknown metric(s): {', '.join(unnormalizable)}. Please choose from: {', '.join(_STATIC_VOCABULARIES[vocab_key])}",
ASSISTANT                     )
ASSISTANT                 if canonical:
ASSISTANT                     request["metrics"] = canonical
ASSISTANT         
ASSISTANT         elif "ratios" in routing:
ASSISTANT             vocab_key = routing["ratios"]
ASSISTANT             if vocab_key in _STATIC_VOCABULARIES:
ASSISTANT                 canonical, unnormalizable = _apply_aliases_and_validate(
ASSISTANT                     intent.requested_metrics, _STATIC_VOCABULARIES[vocab_key], "ratios"
ASSISTANT                 )
ASSISTANT                 if unnormalizable:
ASSISTANT                     raise ClarificationNeeded(
ASSISTANT                         question_id=question_id,
ASSISTANT                         missing=[MissingInput(
ASSISTANT                             input="ratios",
ASSISTANT                             why_material=f"Unknown ratio(s): {', '.join(unnormalizable)}. Allowed: {', '.join(_STATIC_VOCABULARIES[vocab_key])}",
ASSISTANT                             allowed_values=_STATIC_VOCABULARIES[vocab_key],
ASSISTANT                         )],
ASSISTANT                         prompt_to_user=f"Unknown ratio(s): {', '.join(unnormalizable)}. Please choose from: {', '.join(_STATIC_VOCABULARIES[vocab_key])}",
ASSISTANT                     )
ASSISTANT                 if canonical:
ASSISTANT                     request["ratios"] = canonical
ASSISTANT         
ASSISTANT         elif "grades" in routing:
ASSISTANT             vocab_key = routing["grades"]
ASSISTANT             if vocab_key in _STATIC_VOCABULARIES:
ASSISTANT                 canonical, unnormalizable = _apply_aliases_and_validate(
ASSISTANT                     intent.requested_metrics, _STATIC_VOCABULARIES[vocab_key], "grades"
ASSISTANT                 )
ASSISTANT                 if unnormalizable:
ASSISTANT                     raise ClarificationNeeded(
ASSISTANT                         question_id=question_id,
ASSISTANT                         missing=[MissingInput(
ASSISTANT                             input="grades",
ASSISTANT                             why_material=f"Unknown grade(s): {', '.join(unnormalizable)}. Allowed: {', '.join(_STATIC_VOCABULARIES[vocab_key])}",
ASSISTANT                             allowed_values=_STATIC_VOCABULARIES[vocab_key],
ASSISTANT                         )],
ASSISTANT                         prompt_to_user=f"Unknown grade(s): {', '.join(unnormalizable)}. Please choose from: {', '.join(_STATIC_VOCABULARIES[vocab_key])}",
ASSISTANT                     )
ASSISTANT                 if canonical:
ASSISTANT                     request["grades"] = canonical
ASSISTANT     
ASSISTANT     # Handle other selector fields from intent.filters that need normalization
ASSISTANT     # (market_definition, peer_filters, segment_filters, etc.)
ASSISTANT     for field_name, vocab_key in routing.items():
ASSISTANT         if field_name in ("metrics", "ratios", "grades"):
ASSISTANT             continue  # Handled above via requested_metrics
ASSISTANT         
ASSISTANT         if field_name in intent.filters:
ASSISTANT             value = intent.filters[field_name]
ASSISTANT             if field_name == "market_definition":
ASSISTANT                 if value not in _STATIC_VOCABULARIES.get("market_definitions", []):
ASSISTANT                     raise ClarificationNeeded(
ASSISTANT                         question_id=question_id,
ASSISTANT                         missing=[MissingInput(
ASSISTANT                             input="market_definition",
ASSISTANT                             why_material=f"Unknown market definition: {value}. Allowed: {', '.join(_STATIC_VOCABULARIES['market_definitions'])}",
ASSISTANT                             allowed_values=_STATIC_VOCABULARIES["market_definitions"],
ASSISTANT                         )],
ASSISTANT                         prompt_to_user=f"Unknown market definition: {value}. Please choose from: {', '.join(_STATIC_VOCABULARIES['market_definitions'])}",
ASSISTANT                     )
ASSISTANT             elif field_name == "peer_filters" and isinstance(value, dict):
ASSISTANT                 # Validate peer filter keys
ASSISTANT                 unknown_keys = set(value.keys()) - set(_STATIC_VOCABULARIES["peer_filter_keys"])
ASSISTANT                 if unknown_keys:
ASSISTANT                     raise ClarificationNeeded(
ASSISTANT                         question_id=question_id,
ASSISTANT                         missing=[MissingInput(
ASSISTANT                             input="peer_filters",
ASSISTANT                             why_material=f"Unknown peer filter key(s): {', '.join(unknown_keys)}. Allowed: {', '.join(_STATIC_VOCABULARIES['peer_filter_keys'])}",
ASSISTANT                             allowed_values=_STATIC_VOCABULARIES["peer_filter_keys"],
ASSISTANT                         )],
ASSISTANT                         prompt_to_user=f"Unknown peer filter key(s): {', '.join(unknown_keys)}. Please choose from: {', '.join(_STATIC_VOCABULARIES['peer_filter_keys'])}",
ASSISTANT                     )
ASSISTANT                 # Check explicit filter constraint (at least one non-default filter)
ASSISTANT                 if question_id == "VC-POC-09":
ASSISTANT                     non_default = {k: v for k, v in value.items() if k != "sectors" or v != _DEFAULT_PEER_SECTORS}
ASSISTANT                     if not non_default:
ASSISTANT                         raise ClarificationNeeded(
ASSISTANT                             question_id=question_id,
ASSISTANT                             missing=[MissingInput(
ASSISTANT                                 input="peer_filters",
ASSISTANT                                 why_material="At least one explicit filter beyond the default sector scope (Catholic, Independent) is required.",
ASSISTANT                                 allowed_values=_STATIC_VOCABULARIES["peer_filter_keys"],
ASSISTANT                             )],
ASSISTANT                             prompt_to_user="A peer group requires at least one explicit filter beyond the default sectors (Catholic, Independent). Please add a filter such as enrolments_min, school_types, etc.",
ASSISTANT                         )
ASSISTANT             elif field_name == "segment_filters" and isinstance(value, dict):
ASSISTANT                 # Validate segment filter keys
ASSISTANT                 unknown_keys = set(value.keys()) - set(_STATIC_VOCABULARIES["segment_filter_keys"])
ASSISTANT                 if unknown_keys:
ASSISTANT                     raise ClarificationNeeded(
ASSISTANT                         question_id=question_id,
ASSISTANT                         missing=[MissingInput(
ASSISTANT                             input="segment_filters",
ASSISTANT                             why_material=f"Unknown segment filter key(s): {', '.join(unknown_keys)}. Allowed: {', '.join(_STATIC_VOCABULARIES['segment_filter_keys'])}",
ASSISTANT                             allowed_values=_STATIC_VOCABULARIES["segment_filter_keys"],
ASSISTANT                         )],
ASSISTANT                         prompt_to_user=f"Unknown segment filter key(s): {', '.join(unknown_keys)}. Please choose from: {', '.join(_STATIC_VOCABULARIES['segment_filter_keys'])}",
ASSISTANT                     )
ASSISTANT                 # Check explicit filter constraint (at least one explicit filter)
ASSISTANT                 if question_id == "VC-POC-10":
ASSISTANT                     if not value:
ASSISTANT                         raise ClarificationNeeded(
ASSISTANT                             question_id=question_id,
ASSISTANT                             missing=[MissingInput(
ASSISTANT                                 input="segment_filters",
ASSISTANT                                 why_material="At least one explicit segment filter is required.",
ASSISTANT                                 allowed_values=_STATIC_VOCABULARIES["segment_filter_keys"],
ASSISTANT                             )],
ASSISTANT                             prompt_to_user="A segment definition requires at least one explicit filter. Please add a filter such as sectors, enrolments_min, etc.",
ASSISTANT                         )
ASSISTANT     
ASSISTANT     # Apply metric scope check for VC-POC-01 and VC-POC-04 (from tools.py)
ASSISTANT     scope_problem = request_scope_problem(deps.user_question if 'deps' in locals() else "", question_id, request)
ASSISTANT     if scope_problem and "metrics" in request and isinstance(request["metrics"], list):
ASSISTANT         cleaned = [
ASSISTANT             m for m in request["metrics"]
ASSISTANT             if not (str(m).endswith("_headcount") or str(m).startswith("non_teaching_"))
ASSISTANT         ]
ASSISTANT         request["metrics"] = cleaned or request["metrics"]
