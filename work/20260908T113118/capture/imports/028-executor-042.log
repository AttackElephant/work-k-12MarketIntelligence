                            allowed_values=_STATIC_VOCABULARIES["peer_filter_keys"],
                        )],
                        prompt_to_user=f"Unknown peer filter key(s): {', '.join(unknown_keys)}. Please choose from: {', '.join(_STATIC_VOCABULARIES['peer_filter_keys'])}",
                    )
                # Check explicit filter constraint (at least one non-default filter)
                if question_id == "VC-POC-09":
