ASSISTANT from harness.planner import plan_and_execute  # noqa: E402
ASSISTANT from harness.tools import Deps  # noqa: E402
ASSISTANT 
ASSISTANT STUB_EMITTER = PROJECT_ROOT / "evals" / "stub_emitter.py"
ASSISTANT 
ASSISTANT EXIT_ANSWERED = 0
ASSISTANT EXIT_FAILED = 1
ASSISTANT EXIT_CLARIFICATION = 2
ASSISTANT EXIT_UNSUPPORTED = 3
ASSISTANT EXIT_BUDGET = 4
ASSISTANT 
ASSISTANT EXIT_BY_BRANCH = {
ASSISTANT     RenderedAnswer: EXIT_ANSWERED,
ASSISTANT     ClarificationNeeded: EXIT_CLARIFICATION,
ASSISTANT     Unsupported: EXIT_UNSUPPORTED,
ASSISTANT     BudgetExceeded: EXIT_BUDGET,
ASSISTANT }
ASSISTANT 
ASSISTANT 
ASSISTANT # ---------------------------------------------------------------------------
ASSISTANT # rendering
ASSISTANT # ---------------------------------------------------------------------------
ASSISTANT 
ASSISTANT 
ASSISTANT def _bullets(lines: list[str]) -> str:
ASSISTANT     return "\n".join(f"  - {line}" for line in lines)
ASSISTANT 
ASSISTANT 
ASSISTANT def render_answer(output: RenderedAnswer) -> str:
ASSISTANT     """Prose, then the provenance the contract obliges us to show with it.
ASSISTANT 
ASSISTANT     Every section here is printed from a preserved field. The four confidence
ASSISTANT     axes render as the data layer stated them and carry no overall grade — the
ASSISTANT     harness has no authority to assign one (ADR-009).
ASSISTANT     """
ASSISTANT     blocks = [output.answer.strip()]
ASSISTANT 
ASSISTANT     if output.data_status_note.strip():
ASSISTANT         blocks.append(f"Data status:\n  {output.data_status_note.strip()}")
ASSISTANT 
ASSISTANT     if output.deterministic_signals:
ASSISTANT         signals = [
ASSISTANT             json.dumps(signal, ensure_ascii=False, sort_keys=True)
ASSISTANT             for signal in output.deterministic_signals
ASSISTANT         ]
ASSISTANT         blocks.append("Deterministic signals (disclosed calculations):\n" + _bullets(signals))
ASSISTANT 
ASSISTANT     axes = [f"{axis}: {rating}" for axis, rating in sorted(output.confidence.items())]
ASSISTANT     blocks.append("Confidence (as stated by the data layer):\n" + _bullets(axes))
ASSISTANT 
ASSISTANT     if output.limitations:
ASSISTANT         blocks.append("Limitations:\n" + _bullets(output.limitations))
ASSISTANT 
ASSISTANT     provenance = [
ASSISTANT         f"{key}: {json.dumps(value, ensure_ascii=False, sort_keys=True) if isinstance(value, (dict, list)) else value}"
ASSISTANT         for key, value in sorted(output.provenance.items())
ASSISTANT     ]
ASSISTANT     blocks.append("Provenance:\n" + _bullets(provenance))
ASSISTANT     blocks.append(f"Question {output.question_id} · contract {output.contract_version}")
ASSISTANT     return "\n\n".join(blocks)
ASSISTANT 
ASSISTANT 
ASSISTANT def render_clarification(output: ClarificationNeeded) -> str:
ASSISTANT     missing = [
ASSISTANT         f"{item.input} — {item.why_material}"
ASSISTANT         + (f" (allowed: {', '.join(item.allowed_values)})" if item.allowed_values else "")
ASSISTANT         for item in output.missing
ASSISTANT     ]
ASSISTANT     return "\n\n".join(
ASSISTANT         [
ASSISTANT             output.prompt_to_user.strip(),
ASSISTANT             "Needed before this can be answered:\n" + _bullets(missing),
ASSISTANT             f"Question {output.question_id} (tentative)",
ASSISTANT         ]
ASSISTANT     )
ASSISTANT 
ASSISTANT 
ASSISTANT def render_unsupported(output: Unsupported) -> str:
ASSISTANT     blocks = [f"Not answerable ({output.reason_kind}):", f"  {output.reason}"]
ASSISTANT     if output.nearest_supported:
ASSISTANT         blocks.append(f"Closest supported question: {output.nearest_supported}")
ASSISTANT     return "\n".join(blocks)
ASSISTANT 
ASSISTANT 
ASSISTANT def render_budget(output: BudgetExceeded) -> str:
ASSISTANT     blocks = [f"Stopped on the {output.limit} budget: {output.detail}"]
ASSISTANT     if output.learned_so_far:
ASSISTANT         blocks.append(f"Established before stopping: {output.learned_so_far}")
ASSISTANT     blocks.append("No partial answer is shown — a half-rendered figure is worse than none.")
ASSISTANT     return "\n".join(blocks)
ASSISTANT 
ASSISTANT 
ASSISTANT def render_text(output: HarnessOutput) -> str:
ASSISTANT     if isinstance(output, RenderedAnswer):
ASSISTANT         return render_answer(output)
ASSISTANT     if isinstance(output, ClarificationNeeded):
ASSISTANT         return render_clarification(output)
ASSISTANT     if isinstance(output, Unsupported):
ASSISTANT         return render_unsupported(output)
ASSISTANT     return render_budget(output)
ASSISTANT 
ASSISTANT 
ASSISTANT # ---------------------------------------------------------------------------
ASSISTANT # the conversation
ASSISTANT # ---------------------------------------------------------------------------
ASSISTANT 
ASSISTANT 
ASSISTANT async def converse(
ASSISTANT     agent: Any | None,
ASSISTANT     deps: Deps,
ASSISTANT     question: str,
ASSISTANT     ask_user: Callable[[ClarificationNeeded], str | None] | None = None,
ASSISTANT     max_clarifications: int = 1,
ASSISTANT     record_usage: bool = True,
ASSISTANT ) -> HarnessOutput:
ASSISTANT     """Run the question, carrying up to `max_clarifications` round-trips.
ASSISTANT 
ASSISTANT     The state between turns is PydanticAI's own message history, handed back on
ASSISTANT     `deps.last_messages` — no bespoke session store (architecture §7). An
ASSISTANT     `ask_user` that returns None (or is absent) ends the conversation with the
ASSISTANT     clarification unanswered, which is the honest outcome for a non-interactive
ASSISTANT     caller.
ASSISTANT 
ASSISTANT     `record_usage=False` is for callers driving a scripted `FunctionModel`
ASSISTANT     (`demo.py --replay`, `evals/replay.py`): those runs cost nothing, and writing
ASSISTANT     their zero-price "usage" into the JSONL the cost report reads would put runs
ASSISTANT     that never happened into the spend record (ADR-005).
ASSISTANT 
ASSISTANT     `agent` may be a PydanticAI `Agent` (legacy tool-loop path) or `None`
ASSISTANT     (pipeline path). When `None`, the new 4-stage pipeline is used via `ask(deps, question)`.
ASSISTANT     """
ASSISTANT     history: list[Any] | None = None
ASSISTANT     reply = question
ASSISTANT     for _round in range(max_clarifications + 1):
ASSISTANT         if agent is not None:
ASSISTANT             output = await ask(
ASSISTANT                 agent, deps, reply, message_history=history, record_usage=record_usage
ASSISTANT             )
ASSISTANT         else:
ASSISTANT             # Pipeline path: ask(deps, question, ...) — no agent, no message_history
ASSISTANT             from harness.agent import ask as pipeline_ask
ASSISTANT             output = await pipeline_ask(deps, reply, record_usage=record_usage)
ASSISTANT         if not isinstance(output, ClarificationNeeded) or ask_user is None:
ASSISTANT             return output
ASSISTANT         answer = ask_user(output)
ASSISTANT         if answer is None or not answer.strip():
ASSISTANT             return output
ASSISTANT         history = deps.last_messages
ASSISTANT         reply = answer
ASSISTANT     return output
ASSISTANT 
ASSISTANT 
ASSISTANT def _prompt_on_terminal(output: ClarificationNeeded) -> str | None:
ASSISTANT     print(render_clarification(output))
ASSISTANT     print()
ASSISTANT     try:
ASSISTANT         return input("> ")
ASSISTANT     except EOFError:
ASSISTANT         return None
ASSISTANT 
ASSISTANT 
ASSISTANT def build_client(use_stub: bool) -> EvidenceClient:
ASSISTANT     if use_stub:
ASSISTANT         # The same emitter the golden suite runs against: canned envelopes, no
ASSISTANT         # data project, no database. Exercises the whole path except the data.
ASSISTANT         return EvidenceClient(python=Path(sys.executable), emitter=STUB_EMITTER)
ASSISTANT     if not settings.DATA_PROJECT_ROOT or not settings.EVIDENCE_EMITTER.exists():
ASSISTANT         raise SystemExit(
ASSISTANT             "No evidence emitter found. Set DATA_PROJECT_ROOT (env or .env) to the "
ASSISTANT             f"data project — expected {settings.EVIDENCE_EMITTER} — or pass --stub to "
ASSISTANT             "run against the canned fixture bundle."
ASSISTANT         )
ASSISTANT     return EvidenceClient.from_settings()
ASSISTANT 
ASSISTANT 
ASSISTANT def require_credentials() -> None:
ASSISTANT     """Fail with a sentence, not a stack trace, when nothing is configured.
ASSISTANT 
ASSISTANT     The SDK's own failure for this is a `TypeError` about header resolution,
ASSISTANT     raised deep inside the first request — after the emitter has been located
ASSISTANT     and the agent built. For the first thing a person runs in this repo, that is
ASSISTANT     the wrong first impression of an otherwise working system.
ASSISTANT 
ASSISTANT     **An unset env var does not mean there is no credential** — with neither
ASSISTANT     set, the SDK falls back to a profile written by `ant auth login`. But
ASSISTANT     checking that by asking "is the `ant` CLI on PATH" was wrong: it treated
ASSISTANT     `claude` (Claude Code) as interchangeable with `ant` (the Anthropic SDK's
ASSISTANT     own login CLI), and `claude auth login` populates neither the env vars nor
ASSISTANT     the profile file the SDK reads — confirmed by reading
ASSISTANT     `anthropic.default_credentials()` in the installed SDK. A `claude
ASSISTANT     auth login` session bridges into this SDK only via `claude setup-token`,
ASSISTANT     which mints an explicit `ANTHROPIC_AUTH_TOKEN`.
ASSISTANT 
ASSISTANT     So the check calls the SDK's own resolver — ground truth, not a guess from
ASSISTANT     which binary happens to be installed.
ASSISTANT     """
ASSISTANT     if settings.MODEL_PROVIDER == "claude_account":
ASSISTANT         ok, detail = claude_account_status(settings.CLAUDE_CLI)
ASSISTANT         if ok:
ASSISTANT             return
ASSISTANT         raise SystemExit(
ASSISTANT             "No usable Claude subscription-account token is available. Source the "
ASSISTANT             "machine-level environment containing CLAUDE_CODE_OAUTH_TOKEN, then "
ASSISTANT             f"retry. Diagnostic: {detail}"
ASSISTANT         )
ASSISTANT 
ASSISTANT     if settings.ANTHROPIC_API_KEY or settings.ANTHROPIC_AUTH_TOKEN:
ASSISTANT         return
ASSISTANT     import anthropic
ASSISTANT 
ASSISTANT     if anthropic.default_credentials(base_url="https://api.anthropic.com") is not None:
ASSISTANT         return  # a real SDK-readable profile exists (ant auth login, or WIF env vars)
ASSISTANT     raise SystemExit(
ASSISTANT         "No Anthropic credential found. A `claude auth login` (Claude Code) session, "
ASSISTANT         "if you have one, does not count — it is not something this SDK can read. "
ASSISTANT         "Run `claude setup-token` and put the token it prints in .env as "
ASSISTANT         "ANTHROPIC_AUTH_TOKEN, or set ANTHROPIC_API_KEY (metered API), or "
ASSISTANT         "`ant auth login` for an SDK-native profile. "
ASSISTANT         "`.venv/bin/python authcheck.py` says which one is in play and whether the "
ASSISTANT         "provider accepts it."
ASSISTANT     )
ASSISTANT 
ASSISTANT 
ASSISTANT def build_parser() -> argparse.ArgumentParser:
ASSISTANT     parser = argparse.ArgumentParser(
ASSISTANT         prog="run.py",
ASSISTANT         description="Ask the K-12 market intelligence harness one question.",
ASSISTANT     )
ASSISTANT     parser.add_argument("question", help="the question, in plain English")
ASSISTANT     parser.add_argument(
ASSISTANT         "--stub",
ASSISTANT         action="store_true",
ASSISTANT         help="use evals/stub_emitter.py instead of the data project's emitter",
ASSISTANT     )
ASSISTANT     parser.add_argument(
ASSISTANT         "--json", action="store_true", help="print the output branch as JSON"
ASSISTANT     )
ASSISTANT     parser.add_argument(
ASSISTANT         "--max-clarifications",
ASSISTANT         type=int,
ASSISTANT         default=1,
ASSISTANT         help="clarification round-trips before giving up (default 1, per O-3)",
ASSISTANT     )
ASSISTANT     parser.add_argument(
ASSISTANT         "--no-interactive",
ASSISTANT         action="store_true",
ASSISTANT         help="never prompt; report a clarification and exit 2",
ASSISTANT     )
ASSISTANT     return parser
ASSISTANT 
ASSISTANT 
ASSISTANT def main(argv: list[str] | None = None) -> int:
ASSISTANT     configure_logging()  # once per entry point, before anything else logs
ASSISTANT     args = build_parser().parse_args(argv)
ASSISTANT 
ASSISTANT     require_credentials()
ASSISTANT     client = build_client(args.stub)
ASSISTANT     # Default CLI path: no legacy agent, use deterministic pipeline
ASSISTANT     agent = None
ASSISTANT     deps = Deps(client=client)
ASSISTANT     ask_user = None if args.no_interactive else _prompt_on_terminal
ASSISTANT 
ASSISTANT     try:
ASSISTANT         output = asyncio.run(
ASSISTANT             converse(
ASSISTANT                 agent,
ASSISTANT                 deps,
ASSISTANT                 args.question,
ASSISTANT                 ask_user=ask_user,
ASSISTANT                 max_clarifications=args.max_clarifications,
ASSISTANT             )
ASSISTANT         )
ASSISTANT     except (HarnessError, EmitterFailure, ClaudeAccountCliError) as exc:
ASSISTANT         # Classified and already logged at the retry boundary; the caller gets
ASSISTANT         # the operational failure, never a fabricated answer.
ASSISTANT         print(f"{type(exc).__name__}: {exc}", file=sys.stderr)
ASSISTANT         return EXIT_FAILED
ASSISTANT 
ASSISTANT     if args.json:
ASSISTANT         print(output.model_dump_json(indent=2))
ASSISTANT     else:
ASSISTANT         print(render_text(output))
ASSISTANT     return EXIT_BY_BRANCH[type(output)]
ASSISTANT 
ASSISTANT 
ASSISTANT if __name__ == "__main__":
ASSISTANT     raise SystemExit(main())
ASSISTANT ```
