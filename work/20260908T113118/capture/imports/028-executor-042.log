ASSISTANT async def _resolve_school_mentions(
ASSISTANT     client: EvidenceClient, school_mentions: list[str], deps: Deps
ASSISTANT ) -> list[int]:
ASSISTANT     """Resolve each school mention through the directory, requiring exactly one match.
ASSISTANT     
ASSISTANT     Stages IDs locally in mention order, deduplicates without reordering,
ASSISTANT     commits to Deps only after all mentions succeed.
ASSISTANT     
ASSISTANT     Returns list of resolved ACARA_SML_IDs in mention order (deduplicated).
ASSISTANT     Raises ClarificationNeeded for zero or multiple matches.
ASSISTANT     """
ASSISTANT     staged_ids: list[int] = []
ASSISTANT     seen: set[int] = set()
ASSISTANT     
ASSISTANT     for school_name in school_mentions:
ASSISTANT         try:
ASSISTANT             records = await client.school_directory(search=school_name, limit=25)
ASSISTANT         except Exception as exc:
ASSISTANT             deps.tool_calls.append(
ASSISTANT                 ToolInvocation(
ASSISTANT                     "search_schools",
ASSISTANT                     {"search": school_name, "limit": 25},
ASSISTANT                     error_kind=type(exc).__name__,
ASSISTANT                 )
ASSISTANT             )
ASSISTANT             raise
ASSISTANT         
ASSISTANT         deps.tool_calls.append(
ASSISTANT             ToolInvocation(
ASSISTANT                 "search_schools",
ASSISTANT                 {"search": school_name, "limit": 25},
ASSISTANT                 records,
ASSISTANT             )
ASSISTANT         )
ASSISTANT         
ASSISTANT         resolved = [r["acara_sml_id"] for r in records if "acara_sml_id" in r]
ASSISTANT         
ASSISTANT         if len(resolved) == 0:
ASSISTANT             raise ClarificationNeeded(
ASSISTANT                 question_id=deps.intent.question_id if deps.intent else "unknown",
ASSISTANT                 missing=[MissingInput(
ASSISTANT                     input="school_name",
ASSISTANT                     why_material=f"No school found matching '{school_name}'",
ASSISTANT                     allowed_values=[],
ASSISTANT                 )],
ASSISTANT                 prompt_to_user=f"No school found matching '{school_name}'. Please check the name and try again.",
ASSISTANT             )
ASSISTANT         
ASSISTANT         if len(resolved) > 1:
ASSISTANT             # Multiple matches - clarify with the matches found
ASSISTANT             match_names = [r.get("school_name", str(r.get("acara_sml_id", "?"))) for r in resolved]
ASSISTANT             raise ClarificationNeeded(
ASSISTANT                 question_id=deps.intent.question_id if deps.intent else "unknown",
ASSISTANT                 missing=[MissingInput(
ASSISTANT                     input="school_name",
ASSISTANT                     why_material=f"Multiple schools match '{school_name}': {', '.join(match_names)}",
ASSISTANT                     allowed_values=[],
ASSISTANT                 )],
ASSISTANT                 prompt_to_user=f"Multiple schools match '{school_name}': {', '.join(match_names)}. Please specify which one.",
ASSISTANT             )
ASSISTANT         
ASSISTANT         # Exactly one match
ASSISTANT         school_id = resolved[0]
ASSISTANT         if school_id not in seen:
ASSISTANT             staged_ids.append(school_id)
ASSISTANT             seen.add(school_id)
ASSISTANT     
ASSISTANT     # All mentions resolved successfully - commit to Deps
ASSISTANT     deps.resolved_school_ids.extend(staged_ids)
ASSISTANT     deps.searched = True
ASSISTANT     
ASSISTANT     return staged_ids
ASSISTANT 
ASSISTANT 
ASSISTANT def _build_request(
ASSISTANT     question_id: str, intent: StructuredIntent, resolved_ids: list[int], user_question: str
ASSISTANT ) -> dict[str, Any]:
ASSISTANT     """Build the evidence request from explicit intent fields and planner-owned selectors.
ASSISTANT     
ASSISTANT     Omits unsupplied defaultable values (emitter owns defaults).
ASSISTANT     Normalizes and routes selectors to question-specific fields.
ASSISTANT     """
ASSISTANT     request: dict[str, Any] = dict(intent.filters)
ASSISTANT     
ASSISTANT     # Attach resolved school IDs using the right field name for this question
ASSISTANT     q_entry = contract.questions().get(question_id, {})
ASSISTANT     required = q_entry.get("input_policy", {}).get("required", [])
ASSISTANT     
ASSISTANT     if resolved_ids:
ASSISTANT         if "acara_sml_ids" in required:
ASSISTANT             request["acara_sml_ids"] = resolved_ids
ASSISTANT         elif "acara_sml_id" in required and resolved_ids:
ASSISTANT             request["acara_sml_id"] = resolved_ids[0]
ASSISTANT     
ASSISTANT     # Handle explicit IDs from intent.filters (caller-supplied numeric IDs)
ASSISTANT     # These take precedence over name-resolved IDs if both present
ASSISTANT     if "acara_sml_id" in intent.filters and "acara_sml_id" in required:
ASSISTANT         request["acara_sml_id"] = intent.filters["acara_sml_id"]
ASSISTANT     if "acara_sml_ids" in intent.filters and "acara_sml_ids" in required:
ASSISTANT         request["acara_sml_ids"] = intent.filters["acara_sml_ids"]
ASSISTANT     
ASSISTANT     # Normalize and route requested metrics/selectors
ASSISTANT     if intent.requested_metrics:
ASSISTANT         routing = _SELECTOR_ROUTING.get(question_id, {})
ASSISTANT         
ASSISTANT         if "metrics" in routing:
ASSISTANT             vocab_key = routing["metrics"]
