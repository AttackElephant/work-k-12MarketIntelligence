USER ````
USER {
USER   "$schema": "https://json-schema.org/draft/2020-12/schema",
USER   "$id": "https://k12-data-discovery.local/contracts/poc-evidence-error/0.3.0",
USER   "title": "Victorian public-data POC deterministic evidence error (v0.3.0)",
USER   "type": "object",
USER   "additionalProperties": false,
USER   "required": [
USER     "contract_version",
USER     "error_kind",
USER     "error"
USER   ],
USER   "properties": {
USER     "contract_version": {
USER       "const": "0.3.0"
USER     },
USER     "error_kind": {
USER       "enum": [
USER         "bad_request",
USER         "unknown_question",
USER         "excluded_question",
USER         "unanswerable",
USER         "data_unavailable",
USER         "internal"
USER       ]
USER     },
USER     "error": {
USER       "type": "string",
USER       "minLength": 1
USER     },
USER     "question_id": {
USER       "type": "string",
USER       "pattern": "^VC-POC-",
USER       "description": "Present when the error is scoped to a question."
USER     },
USER     "registry_version": {
USER       "const": "0.3.0"
USER     },
USER     "reason_code": {
USER       "type": "string",
USER       "enum": [
USER         "not_yet_validated",
USER         "deferred_capability",
USER         "out_of_scope_domain",
USER         "prohibited_crosswalk"
USER       ],
USER       "description": "Registry-owned refusal reason. Required when error_kind == excluded_question."
USER     },
USER     "retryable": {
USER       "type": "boolean",
USER       "description": "Advisory: bad_request/data_unavailable/internal may be retried after repair or recovery; unknown/excluded/unanswerable must not."
USER     }
USER   },
USER   "allOf": [
USER     {
USER       "if": {
USER         "properties": {
USER           "error_kind": {
USER             "const": "excluded_question"
USER           }
USER         },
USER         "required": [
USER           "error_kind"
USER         ]
USER       },
USER       "then": {
USER         "required": [
USER           "reason_code"
USER         ]
USER       }
USER     }
USER   ]
USER }
USER ````
