ASSISTANT     """interpret_intent() with a FunctionModel returns the typed StructuredIntent."""
ASSISTANT     intent_in = StructuredIntent(
ASSISTANT         question_id="VC-POC-01",
ASSISTANT         school_mentions=["Oak Park Primary"],
ASSISTANT         requested_metrics=["total_enrolments"],
ASSISTANT         presentation="trend",
ASSISTANT     )
