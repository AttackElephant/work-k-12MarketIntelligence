def test_caller_correctable_identity_clarifies_not_unsupported():
    """Invalid explicit ACARA ID → identity clarification (Unsupported with reason_kind=identity_clarification)."""
    class _BadRequestClient:
        async def school_directory(self, search: str, limit: int = 25) -> list[dict]:
            return []
        
        async def fetch_evidence(self, question_id: str, request: dict) -> dict:
            raise EvidenceError("bad_request", "acara_sml_id 99999 not found in directory")
    
    from harness.evidence import EvidenceError
    intent = StructuredIntent(
        question_id="VC-POC-01",
        filters={"acara_sml_id": 99999},
