ASSISTANT def _find_exclusion_text(excluded_topic: str | None) -> str:
ASSISTANT     """Find the contract exclusion text matching a topic hint."""
ASSISTANT     texts = sorted(contract.exclusion_texts())
ASSISTANT     if not texts:
ASSISTANT         return ""
ASSISTANT 
ASSISTANT     if excluded_topic:
ASSISTANT         search_terms = []
ASSISTANT         hint_lower = excluded_topic.lower()
ASSISTANT         for key, mapped in _EXCLUSION_KEYWORD_MAP.items():
ASSISTANT             if key in hint_lower:
ASSISTANT                 search_terms.append(mapped.lower())
ASSISTANT         search_terms.append(hint_lower)
ASSISTANT 
ASSISTANT         for term in search_terms:
ASSISTANT             for text in texts:
ASSISTANT                 if term in text.lower():
ASSISTANT                     return text
ASSISTANT 
ASSISTANT     return texts[0]
ASSISTANT 
ASSISTANT 
ASSISTANT def _normalize_selector_label(label: str) -> str:
ASSISTANT     """Normalize a selector label: Unicode-safe case folding, separator normalization."""
ASSISTANT     # Case fold (Unicode-aware)
ASSISTANT     normalized = label.casefold()
ASSISTANT     # Replace separators (spaces, hyphens, underscores) with single underscore
ASSISTANT     normalized = re.sub(r"[\s\-_]+", "_", normalized)
ASSISTANT     # Strip leading/trailing underscores
ASSISTANT     normalized = normalized.strip("_")
ASSISTANT     return normalized
ASSISTANT 
ASSISTANT 
ASSISTANT def _apply_aliases_and_validate(
ASSISTANT     raw_selectors: list[str], vocabulary: list[str], field_name: str
ASSISTANT ) -> tuple[list[str], list[str]]:
ASSISTANT     """Apply pinned aliases, normalize, validate against static vocabulary.
ASSISTANT     
ASSISTANT     Returns (canonical_selectors, unnormalizable_selectors).
ASSISTANT     """
ASSISTANT     canonical = []
ASSISTANT     unnormalizable = []
ASSISTANT     vocab_set = set(vocabulary)
ASSISTANT     
ASSISTANT     for selector in raw_selectors:
ASSISTANT         normalized = _normalize_selector_label(selector)
ASSISTANT         # Apply pinned aliases
ASSISTANT         canonical_value = _SELECTOR_ALIASES.get(normalized, normalized)
ASSISTANT         
ASSISTANT         if canonical_value in vocab_set:
ASSISTANT             if canonical_value not in canonical:
ASSISTANT                 canonical.append(canonical_value)
ASSISTANT         else:
ASSISTANT             unnormalizable.append(selector)
ASSISTANT     
ASSISTANT     return canonical, unnormalizable
ASSISTANT 
