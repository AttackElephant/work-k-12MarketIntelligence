USER         reason_kind="excluded_by_contract",
USER         reason="school costs, financial ratios, fees, revenue, assets, liabilities, "
USER         "cash, or ACNC school comparisons",
USER         nearest_supported="VC-POC-01",
USER     )
USER     text = cli.render_text(refusal)
USER     assert refusal.reason in text
USER     assert "VC-POC-01" in text
