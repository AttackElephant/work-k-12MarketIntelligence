ASSISTANT # --------------------------------------------------------------------------
ASSISTANT # the clarification round-trip
ASSISTANT # --------------------------------------------------------------------------
ASSISTANT 
ASSISTANT 
ASSISTANT def _clarify_then_answer() -> FunctionModel:
ASSISTANT     """Ask for a radius on the first turn; on the second — with the user's reply
ASSISTANT     in the history — fetch and answer."""
ASSISTANT 
ASSISTANT     def script(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:
ASSISTANT         turns = sum(1 for m in messages if isinstance(m, ModelResponse))
ASSISTANT         if turns == 0:
ASSISTANT             return ModelResponse(
ASSISTANT                 parts=[
ASSISTANT                     ToolCallPart(
ASSISTANT                         "final_result_ClarificationNeeded",
ASSISTANT                         {
ASSISTANT                             "question_id": "VC-POC-08",
ASSISTANT                             "missing": [
ASSISTANT                                 {
ASSISTANT                                     "input": "distance_km",
ASSISTANT                                     "why_material": '"Near" is not a distance.',
ASSISTANT                                     "allowed_values": [],
ASSISTANT                                 }
ASSISTANT                             ],
ASSISTANT                             "prompt_to_user": "What radius should I use?",
ASSISTANT                         },
ASSISTANT                     )
ASSISTANT                 ]
ASSISTANT             )
ASSISTANT         if turns == 1:
ASSISTANT             return ModelResponse(
ASSISTANT                 parts=[
ASSISTANT                     ToolCallPart(
ASSISTANT                         "fetch_evidence",
ASSISTANT                         {
ASSISTANT                             "question_id": "VC-POC-08",
ASSISTANT                             "request": {"acara_sml_id": 40387, "distance_km": 10},
ASSISTANT                         },
ASSISTANT                     )
ASSISTANT                 ]
ASSISTANT             )
ASSISTANT         return ModelResponse(
ASSISTANT             parts=[
ASSISTANT                 ToolCallPart(
ASSISTANT                     "final_result_AnswerDraft",
ASSISTANT                     {
ASSISTANT                         "question_id": "VC-POC-08",
ASSISTANT                         "answer": "Within 10 km the returned cohort is listed above.",
ASSISTANT                         "data_status_note": "",
ASSISTANT                     },
ASSISTANT                 )
ASSISTANT             ]
ASSISTANT         )
ASSISTANT 
ASSISTANT     return FunctionModel(script)
ASSISTANT 
ASSISTANT 
ASSISTANT def test_one_clarification_round_trip_answers_the_question():
ASSISTANT     agent = build_agent(model=_clarify_then_answer())
ASSISTANT     deps = Deps(client=stub_client())
ASSISTANT     replies = iter(["10 km"])
ASSISTANT     output = asyncio.run(
ASSISTANT         cli.converse(
ASSISTANT             agent,
ASSISTANT             deps,
ASSISTANT             "Which schools are near Alpha College?",
ASSISTANT             ask_user=lambda _clarification: next(replies),
ASSISTANT             max_clarifications=1,
ASSISTANT         )
ASSISTANT     )
ASSISTANT     assert output.kind == "answer"
ASSISTANT     assert output.question_id == "VC-POC-08"
ASSISTANT 
