ASSISTANT def _static_vocabulary_for_field(question_id: str, field: str) -> list[str] | None:
ASSISTANT     list_name = _field_to_catalog_list().get(f"{question_id}.{field}")
ASSISTANT     if list_name is None:
ASSISTANT         return None
ASSISTANT     return _static_enum(list_name)
