USER     "capacity, facilities, applications, offers, student flows, attendance, outcomes, wellbeing, behaviour, or retention",
USER     "public transport, train, tram, bus, walking access, drive time, traffic, catchments, or campus locations",
USER     "School_No to ACARA crosswalks"
USER   ],
USER   "replay_equality": {
USER     "scope": "Entire successful response as semantic JSON within the same contract version and data release.",
USER     "excluded_paths": [
USER       "provenance.generated_utc"
USER     ]
USER   }
USER }
USER ````
