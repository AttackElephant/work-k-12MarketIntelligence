+def _cohort_definition_clarification(
+    question_id: str, field: str, why_material: str
+) -> ClarificationNeeded:
+    return ClarificationNeeded(
+        question_id=question_id,
+        missing=[MissingInput(input=field, why_material=why_material, 
allowed_values=[])],
+        prompt_to_user=(
