USER async def ask(  # type: ignore[return]
USER     agent_or_deps: Any,
USER     deps_or_question: Any = None,
USER     question_or_record_usage: Any = None,
USER     message_history: list[Any] | None = None,
USER     record_usage: bool = True,
USER     *,
USER     # New pipeline-only keyword arguments
USER     intent_override: Any = None,
USER     narration_override: Any = None,
USER     intent_model: object | None = None,
USER     narration_model: object | None = None,
