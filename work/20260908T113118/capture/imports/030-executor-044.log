USER         if ok:
USER             print("\nAccount works. `pytest tests/live -m live -q` is ready to run.")
USER             return 0
USER         print("\nSource the machine-level file containing CLAUDE_CODE_OAUTH_TOKEN, then retry.")
USER         return 1
USER 
USER     print("Credential sources, in the order the SDK resolves them:")
USER     describe_secret("ANTHROPIC_API_KEY", settings.ANTHROPIC_API_KEY)
USER     describe_secret("ANTHROPIC_AUTH_TOKEN", settings.ANTHROPIC_AUTH_TOKEN)
USER     cli_status()
USER     print()
USER 
USER     profile_found, profile_detail = sdk_finds_a_profile()
USER     line(OK if profile_found else MEH, f"SDK profile fallback: {profile_detail}")
USER     print()
USER 
USER     usable_source = settings.ANTHROPIC_AUTH_MODE != "profile" or profile_found
USER     line(
USER         OK if usable_source else BAD,
USER         f"configured SDK auth mode: {settings.ANTHROPIC_AUTH_MODE}",
USER     )
USER     if not usable_source:
USER         line(
USER             BAD,
USER             "profile mode is the fallback because no environment credential is set, "
USER             "but the SDK finds no profile to use — the "
USER             "next request WILL fail with a TypeError before any HTTP call is "
USER             "made. See 'What a failure here means' below.",
