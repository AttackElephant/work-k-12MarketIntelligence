USER harness/outputs.py
USER ````
USER """The output contract — a four-branch union (architecture §5).
USER 
USER     HarnessOutput = RenderedAnswer | ClarificationNeeded | Unsupported | BudgetExceeded
USER 
USER The split between what the MODEL returns and what the HARNESS returns is the
USER load-bearing design here, and it comes straight out of M2's grader work:
USER 
USER * `AnswerDraft` is what the model may author — the narrative, the question it
USER   answered, and its statement of what was missing or empty. It is one of the
USER   three branches in the agent's `output_type`.
USER * `RenderedAnswer` is what a caller receives. The harness builds it by attaching
USER   the six preserved contract fields **from the envelope the tool actually
USER   returned**, in code.
USER 
USER The reason is recorded in ADR-013: `limitations_verbatim` can prove the strings
USER survived intact, but nothing deterministic can prove a model did not paraphrase
USER them on the way through. So the model never gets the chance — it does not carry
USER those fields at all. The same argument covers `confidence` (ADR-009: the harness
USER displays what the data layer stated and never assigns a grade), `provenance`,
USER and `evidence`.
USER 
USER `BudgetExceeded` is likewise never model-selectable: it is produced by the
USER control envelope in `ask()` when a budget trips (ADR-004).
USER """
USER 
USER from __future__ import annotations
USER 
USER from typing import Any, Literal, Union
USER 
USER from pydantic import BaseModel, Field
USER 
USER 
USER class AnswerDraft(BaseModel):
USER     """What the model returns when it can answer from the returned evidence.
USER 
USER     Deliberately small. Everything the contract obliges the harness to preserve
USER     is attached afterwards from the envelope, so there is no field here a model
USER     could paraphrase, soften, or invent.
USER     """
USER 
USER     kind: Literal["answer"] = "answer"
USER     question_id: str = Field(
USER         description="The registry question ID the evidence was fetched for."
USER     )
USER     answer: str = Field(
USER         description=(
USER             "The narrative. Every number in it must appear in the returned "
USER             "evidence or in the user's own question."
USER         )
USER     )
USER     data_status_note: str = Field(
USER         default="",
USER         description=(
USER             "What came back empty or gappy, stated plainly at the point the "
USER             "number would have been. Empty string when the series is complete."
USER         ),
USER     )
USER 
USER 
USER class ClarificationNeeded(BaseModel):
USER     """A material input is missing and must not be invented (architecture §7)."""
USER 
USER     kind: Literal["clarification"] = "clarification"
USER     question_id: str = Field(
USER         description="The registry question this would map to, tentatively."
USER     )
USER     missing: list["MissingInput"] = Field(
USER         description="The material inputs the user has to supply. Never empty."
USER     )
USER     prompt_to_user: str = Field(description="The question to put to the user.")
USER 
USER 
USER class MissingInput(BaseModel):
USER     input: str = Field(description="The request field name, as the contract names it.")
USER     why_material: str = Field(
USER         description="Why this cannot be defaulted — one sentence, in the user's terms."
USER     )
USER     allowed_values: list[str] = Field(
USER         default_factory=list,
USER         description="Allow-listed values from the input catalog, when the field has them.",
USER     )
USER 
USER 
USER class Unsupported(BaseModel):
USER     """The honest refusal. `reason` is CONTRACT TEXT, not harness prose (ADR-009).
USER 
USER     `not_yet_validated` is the v0.3.0 case of a registered capability awaiting a
USER     passing backtest (VC-POC-14); it must never be rendered as "we do not answer
USER     that". `unanswerable` is the v0.3.0 abstention for a valid, registered
USER     request whose required fact is absent for the given inputs — distinct from a
USER     contract exclusion and from an empty result.
USER     """
USER 
USER     kind: Literal["unsupported"] = "unsupported"
USER     reason_kind: Literal[
USER         "excluded_by_contract",
USER         "not_in_registry",
USER         "out_of_scope",
USER         "not_yet_validated",
USER         "unanswerable",
USER     ]
USER     reason: str = Field(
USER         description=(
USER             "For a contract exclusion, the exclusion text itself, copied verbatim "
USER             "from the registry or the emitter's error envelope."
USER         )
USER     )
USER     reason_code: str | None = Field(
USER         default=None,
USER         description=(
USER             "The registry-owned refusal reason code (v0.3.0), attached by the harness "
USER             "when the data layer excludes a registered question — e.g. deferred_capability "
USER             "or not_yet_validated. None for a model-authored refusal or a non-exclusion abstention."
USER         ),
USER     )
USER     nearest_supported: str | None = Field(
USER         default=None, description="A registry question ID that CAN be answered, if one is close."
USER     )
USER 
USER 
USER class RenderedAnswer(BaseModel):
USER     """What a caller receives for an answered question.
USER 
USER     The six preserved fields are attached by the harness from the envelope. A
USER     caller that renders this object is rendering the data layer's own words for
USER     limitations and confidence, by construction rather than by good behaviour.
USER     """
USER 
USER     kind: Literal["answer"] = "answer"
USER     answer: str
USER     question_id: str
USER     contract_version: str
USER     evidence: list[dict[str, Any]]
USER     provenance: dict[str, Any]
USER     confidence: dict[str, Any]
USER     limitations: list[str]
USER     deterministic_signals: list[dict[str, Any]] = Field(default_factory=list)
USER     # v0.3.0 preserved fields, attached from the envelope in code (never authored
USER     # by the model): the resolved request the data layer actually ran, the
USER     # structured coverage of what came back, and the per-claim eligibility. The
USER     # five-grade label and its detail ride inside `confidence` as the data layer
USER     # stated them — the harness still assigns no grade of its own (ADR-009).
USER     resolved_request: dict[str, Any] = Field(default_factory=dict)
USER     data_status: dict[str, Any] = Field(default_factory=dict)
USER     claim_eligibility: dict[str, Any] = Field(default_factory=dict)
USER     data_status_note: str = ""
USER 
USER     @classmethod
USER     def from_envelope(cls, draft: AnswerDraft, envelope: dict[str, Any]) -> RenderedAnswer:
USER         return cls(
USER             answer=draft.answer,
USER             question_id=envelope["question_id"],
USER             contract_version=envelope["contract_version"],
USER             evidence=envelope["evidence"],
USER             provenance=envelope["provenance"],
USER             confidence=envelope["confidence"],
USER             limitations=envelope["limitations"],
USER             deterministic_signals=envelope.get("deterministic_signals", []),
USER             resolved_request=envelope.get("resolved_request", {}),
USER             data_status=envelope.get("data_status", {}),
USER             claim_eligibility=envelope.get("claim_eligibility", {}),
USER             data_status_note=draft.data_status_note,
USER         )
USER 
USER 
USER class BudgetExceeded(BaseModel):
USER     """The control envelope tripped (ADR-004). A typed outcome, never a crash,
USER     and never selectable by the model."""
USER 
USER     kind: Literal["budget_exceeded"] = "budget_exceeded"
USER     limit: Literal["steps", "tool_calls", "seconds", "usd"]
USER     detail: str = ""
USER     learned_so_far: str = Field(
USER         default="",
USER         description="What the run established before the budget tripped, if anything.",
USER     )
USER 
USER 
USER ClarificationNeeded.model_rebuild()
USER 
USER # What the model may choose between.
USER AgentOutput = Union[AnswerDraft, ClarificationNeeded, Unsupported]
USER 
USER # What `ask()` returns.
USER HarnessOutput = Union[RenderedAnswer, ClarificationNeeded, Unsupported, BudgetExceeded]
USER ````
