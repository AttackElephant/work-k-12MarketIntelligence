USER tests/unit/test_intent_boundary.py
USER ````
USER """Stage 1 — intent boundary tests.
USER 
USER Proves that `interpret_intent()` is a single-call, no-tools extraction that
USER returns a typed `StructuredIntent`, and that the pipeline path of `ask()`
USER correctly wires the intent stage.
USER 
USER All tests are fully offline: models are scripted `FunctionModel` instances that
USER return canned responses, and the evidence client uses the stub emitter.
USER Nothing here touches the network, the credential store, or the data project.
USER """
USER 
USER from __future__ import annotations
USER 
USER import asyncio
USER import sys
USER from pathlib import Path
USER from typing import Any
USER 
USER import pytest
USER from pydantic_ai.messages import ModelMessage, ModelResponse, ToolCallPart
USER from pydantic_ai.models.function import AgentInfo, FunctionModel
USER 
USER from harness.agent import ask
USER from harness.intent import StructuredIntent, build_intent_agent, interpret_intent
USER from harness.narration import NarrationOutput, NarrationValidationError
USER from harness.outputs import ClarificationNeeded, RenderedAnswer, Unsupported
USER from harness.tools import Deps
USER 
USER PROJECT_ROOT = Path(__file__).resolve().parents[2]
USER STUB = PROJECT_ROOT / "evals" / "stub_emitter.py"
USER 
USER # In pydantic-ai 1.106.0, a single (non-union) output type uses "final_result"
USER # as the tool name. Union output types (like AgentOutput) use per-member names
USER # like "final_result_AnswerDraft". These agents have single output types.
USER INTENT_TOOL = "final_result"
USER NARRATION_TOOL = "final_result"
USER 
USER 
USER def stub_client(**kwargs):
USER     from harness.evidence import EvidenceClient
USER     return EvidenceClient(python=Path(sys.executable), emitter=STUB, **kwargs)
USER 
USER 
USER def make_intent_model(intent: StructuredIntent) -> FunctionModel:
USER     """A model that returns a fixed StructuredIntent immediately."""
USER     payload = intent.model_dump()
USER 
USER     def fn(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:
USER         return ModelResponse(parts=[ToolCallPart(INTENT_TOOL, payload)])
USER 
USER     return FunctionModel(fn)
USER 
USER 
USER def make_narration_model(answer: str, data_status_note: str | None = None) -> FunctionModel:
USER     """A model that returns fixed narration, optionally with a stale extra field."""
USER     payload = {"answer": answer}
USER     if data_status_note is not None:
USER         payload["data_status_note"] = data_status_note
USER 
USER     def fn(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:
USER         return ModelResponse(parts=[ToolCallPart(NARRATION_TOOL, payload)])
USER 
USER     return FunctionModel(fn)
USER 
USER 
USER def make_two_call_model() -> FunctionModel:
USER     """A model that refuses to finish on the first call (triggers second request)."""
USER     calls: list[int] = [0]
USER 
USER     def fn(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:
USER         calls[0] += 1
USER         # First call: return a plausible-but-wrong tool name to force a retry
USER         # Second call: return the real tool
USER         if calls[0] < 2:
USER             return ModelResponse(parts=[ToolCallPart("not_an_output_tool", {})])
USER         return ModelResponse(parts=[ToolCallPart(INTENT_TOOL, {
USER             "question_id": "VC-POC-01",
USER             "school_mentions": [],
USER         })])
USER 
USER     return FunctionModel(fn)
USER 
USER 
USER # ---------------------------------------------------------------------------
USER # 1. interpret_intent() with a scripted model
USER # ---------------------------------------------------------------------------
USER 
USER 
USER def test_interpret_intent_returns_structured_intent():
USER     """interpret_intent() with a FunctionModel returns the typed StructuredIntent."""
USER     intent_in = StructuredIntent(
USER         question_id="VC-POC-01",
USER         school_mentions=["Oak Park Primary"],
USER         requested_metrics=["total_enrolments"],
USER         presentation="trend",
USER     )
USER     result = asyncio.run(interpret_intent("some question", model=make_intent_model(intent_in)))
USER     assert isinstance(result, StructuredIntent)
USER     assert result.question_id == "VC-POC-01"
USER     assert "Oak Park Primary" in result.school_mentions
USER     assert result.presentation == "trend"
USER 
USER 
USER def test_interpret_intent_preserves_all_fields():
USER     """Every field on StructuredIntent round-trips through the model correctly."""
USER     intent_in = StructuredIntent(
USER         question_id="VC-POC-05",
USER         excluded_topic=None,
USER         school_mentions=["Alpha College", "Beta High"],
USER         requested_metrics=["market_share"],
USER         filters={"market_definition": "distance", "distance_km": 2.5},
USER         presentation="comparison",
USER         missing_material_inputs=["market_definition"],
USER     )
USER     result = asyncio.run(interpret_intent("q", model=make_intent_model(intent_in)))
USER     assert result.question_id == "VC-POC-05"
USER     assert result.school_mentions == ["Alpha College", "Beta High"]
USER     assert result.filters == {"market_definition": "distance", "distance_km": 2.5}
USER     assert result.missing_material_inputs == ["market_definition"]
USER 
USER 
USER def test_interpret_intent_excluded_topic():
USER     """The intent model may classify a question as excluded."""
USER     intent_in = StructuredIntent(question_id="excluded", excluded_topic="finance")
USER     result = asyncio.run(interpret_intent("q", model=make_intent_model(intent_in)))
USER     assert result.question_id == "excluded"
USER     assert result.excluded_topic == "finance"
USER 
USER 
USER def test_interpret_intent_unknown_question():
USER     """The intent model may classify a question as unknown."""
USER     intent_in = StructuredIntent(question_id="unknown")
USER     result = asyncio.run(interpret_intent("q", model=make_intent_model(intent_in)))
USER     assert result.question_id == "unknown"
USER 
USER 
USER def test_interpret_intent_enforces_request_limit():
USER     """request_limit=1 is enforced: a model that calls twice raises RuntimeError."""
USER     two_call_model = make_two_call_model()
USER     with pytest.raises(RuntimeError, match="exceeded 1 model request"):
USER         asyncio.run(interpret_intent("q", model=two_call_model))
