ASSISTANT # rendering
ASSISTANT # --------------------------------------------------------------------------
ASSISTANT 
ASSISTANT 
ASSISTANT def test_every_limitation_is_rendered_verbatim():
ASSISTANT     output = answered()
ASSISTANT     assert output.limitations, "the fixture should carry limitations to preserve"
ASSISTANT     text = cli.render_text(output)
ASSISTANT     for limitation in output.limitations:
ASSISTANT         assert limitation in text
ASSISTANT 
ASSISTANT 
ASSISTANT def test_confidence_renders_as_the_axes_the_data_layer_stated():
ASSISTANT     output = answered()
ASSISTANT     text = cli.render_text(output)
ASSISTANT     for axis, rating in output.confidence.items():
ASSISTANT         assert f"{axis}: {rating}" in text
ASSISTANT     # Exactly the axes the envelope carried — nothing dropped, and nothing added.
ASSISTANT     # ADR-009: the harness has no authority to assign an overall grade, so a
ASSISTANT     # renderer that invented one would show up here as an extra entry.
ASSISTANT     section = text.split("Confidence (as stated by the data layer):")[1].split("\n\n")[0]
ASSISTANT     rendered = {line.strip("- ").split(":")[0] for line in section.strip().splitlines()}
ASSISTANT     assert rendered == set(output.confidence)
