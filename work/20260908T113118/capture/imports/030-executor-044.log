ASSISTANT def _selector_route(question_id: str) -> tuple[str, list[str]] | None:
ASSISTANT     """(request field, static vocabulary) for the question's label-selector bag.
ASSISTANT 
ASSISTANT     The registry's `metric_list` is authoritative where declared (VC-POC-01/04
ASSISTANT     → profile_metrics, VC-POC-11 → student_context_metrics); otherwise the
ASSISTANT     input-catalog schema's field mapping routes e.g. VC-POC-03 to `ratios` and
ASSISTANT     VC-POC-02/07 to `grades`.
ASSISTANT     """
ASSISTANT     entry = contract.questions().get(question_id) or {}
ASSISTANT     metric_list = entry.get("metric_list")
ASSISTANT     if metric_list:
ASSISTANT         values = contract.registry().get("metric_lists", {}).get(metric_list)
ASSISTANT         if not isinstance(values, list) or not values:
ASSISTANT             raise TerminalError(
ASSISTANT                 f"{question_id} declares metric_list {metric_list!r} with no pinned values"
ASSISTANT             )
ASSISTANT         return "metrics", [str(value) for value in values]
ASSISTANT     field_to_list = _field_to_catalog_list()
ASSISTANT     for key in sorted(field_to_list):
ASSISTANT         prefix = f"{question_id}."
ASSISTANT         if not key.startswith(prefix):
ASSISTANT             continue
ASSISTANT         field = key[len(prefix):]
ASSISTANT         if field in _SELECTOR_BAG_FIELDS:
ASSISTANT             vocabulary = _static_enum(field_to_list[key])
ASSISTANT             if vocabulary is None:
ASSISTANT                 raise TerminalError(
ASSISTANT                     f"{question_id}.{field} routes to a non-static vocabulary"
ASSISTANT                 )
ASSISTANT             return field, vocabulary
ASSISTANT     return None
ASSISTANT 
