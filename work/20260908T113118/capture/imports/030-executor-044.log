ASSISTANT def _static_enum(list_name: str) -> list[str] | None:
ASSISTANT     """The embedded static enum for a catalog list, or None when the list is
ASSISTANT     release-derived (shape-checked only, never enum-enforced — OD-03)."""
ASSISTANT     if list_name.startswith("release_derived_values."):
ASSISTANT         return None
ASSISTANT     prop = _input_catalog_schema().get("properties", {}).get(list_name)
ASSISTANT     if isinstance(prop, dict) and isinstance(prop.get("items"), dict):
ASSISTANT         enum = prop["items"].get("enum")
ASSISTANT         if isinstance(enum, list):
ASSISTANT             return [str(value) for value in enum]
ASSISTANT     return None
ASSISTANT 
