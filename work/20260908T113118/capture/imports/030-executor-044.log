ASSISTANT def require_credentials() -> None:
ASSISTANT     """Fail with a sentence, not a stack trace, when nothing is configured.
ASSISTANT 
ASSISTANT     The SDK's own failure for this is a `TypeError` about header resolution,
ASSISTANT     raised deep inside the first request — after the emitter has been located
ASSISTANT     and the agent built. For the first thing a person runs in this repo, that is
ASSISTANT     the wrong first impression of an otherwise working system.
ASSISTANT 
ASSISTANT     **An unset env var does not mean there is no credential** — with neither
ASSISTANT     set, the SDK falls back to a profile written by `ant auth login`. But
ASSISTANT     checking that by asking "is the `ant` CLI on PATH" was wrong: it treated
ASSISTANT     `claude` (Claude Code) as interchangeable with `ant` (the Anthropic SDK's
ASSISTANT     own login CLI), and `claude auth login` populates neither the env vars nor
ASSISTANT     the profile file the SDK reads — confirmed by reading
ASSISTANT     `anthropic.default_credentials()` in the installed SDK. A `claude
ASSISTANT     auth login` session bridges into this SDK only via `claude setup-token`,
ASSISTANT     which mints an explicit `ANTHROPIC_AUTH_TOKEN`.
ASSISTANT 
ASSISTANT     So the check calls the SDK's own resolver — ground truth, not a guess from
ASSISTANT     which binary happens to be installed.
ASSISTANT     """
ASSISTANT     if settings.MODEL_PROVIDER == "claude_account":
ASSISTANT         ok, detail = claude_account_status(settings.CLAUDE_CLI)
ASSISTANT         if ok:
ASSISTANT             return
ASSISTANT         raise SystemExit(
ASSISTANT             "No usable Claude subscription-account token is available. Source the "
ASSISTANT             "machine-level environment containing CLAUDE_CODE_OAUTH_TOKEN, then "
ASSISTANT             f"retry. Diagnostic: {detail}"
ASSISTANT         )
ASSISTANT 
ASSISTANT     if settings.ANTHROPIC_API_KEY or settings.ANTHROPIC_AUTH_TOKEN:
ASSISTANT         return
ASSISTANT     import anthropic
ASSISTANT 
ASSISTANT     if anthropic.default_credentials(base_url="https://api.anthropic.com") is not None:
ASSISTANT         return  # a real SDK-readable profile exists (ant auth login, or WIF env vars)
ASSISTANT     raise SystemExit(
ASSISTANT         "No Anthropic credential found. A `claude auth login` (Claude Code) session, "
ASSISTANT         "if you have one, does not count — it is not something this SDK can read. "
ASSISTANT         "Run `claude setup-token` and put the token it prints in .env as "
ASSISTANT         "ANTHROPIC_AUTH_TOKEN, or set ANTHROPIC_API_KEY (metered API), or "
ASSISTANT         "`ant auth login` for an SDK-native profile. "
ASSISTANT         "`.venv/bin/python authcheck.py` says which one is in play and whether the "
ASSISTANT         "provider accepts it."
ASSISTANT     )
ASSISTANT 
ASSISTANT 
ASSISTANT def build_parser() -> argparse.ArgumentParser:
ASSISTANT     parser = argparse.ArgumentParser(
ASSISTANT         prog="run.py",
ASSISTANT         description="Ask the K-12 market intelligence harness one question.",
ASSISTANT     )
ASSISTANT     parser.add_argument("question", help="the question, in plain English")
ASSISTANT     parser.add_argument(
ASSISTANT         "--stub",
ASSISTANT         action="store_true",
ASSISTANT         help="use evals/stub_emitter.py instead of the data project's emitter",
ASSISTANT     )
ASSISTANT     parser.add_argument(
