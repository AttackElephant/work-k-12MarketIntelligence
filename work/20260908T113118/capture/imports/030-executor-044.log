ASSISTANT     if not texts:
ASSISTANT         return ""
ASSISTANT 
ASSISTANT     if excluded_topic:
ASSISTANT         # Try the mapped keyword first, then the raw hint
ASSISTANT         search_terms = []
ASSISTANT         hint_lower = excluded_topic.lower()
ASSISTANT         for key, mapped in _EXCLUSION_KEYWORD_MAP.items():
ASSISTANT             if key in hint_lower:
ASSISTANT                 search_terms.append(mapped.lower())
ASSISTANT         search_terms.append(hint_lower)
ASSISTANT 
ASSISTANT         for term in search_terms:
ASSISTANT             for text in texts:
ASSISTANT                 if term in text.lower():
ASSISTANT                     return text
ASSISTANT 
ASSISTANT     # Fallback: first exclusion text alphabetically
ASSISTANT     return texts[0]
ASSISTANT 
ASSISTANT 
ASSISTANT # --------------------------------------------------------------------------- #
ASSISTANT # Pinned artefact loading (fail-closed: load failures are TerminalError)
ASSISTANT # --------------------------------------------------------------------------- #
ASSISTANT 
ASSISTANT 
ASSISTANT def _load_pinned_json(path: Path) -> Any:
ASSISTANT     try:
ASSISTANT         return json.loads(path.read_text(encoding="utf-8"))
ASSISTANT     except (OSError, ValueError) as exc:
ASSISTANT         raise TerminalError(
ASSISTANT             f"pinned contract artefact could not be loaded ({path.name}): {exc}"
ASSISTANT         ) from exc
ASSISTANT 
ASSISTANT 
ASSISTANT @lru_cache(maxsize=1)
ASSISTANT def _schema_index() -> dict[str, Any]:
ASSISTANT     index = _load_pinned_json(_SCHEMA_DIR / "_index.json")
ASSISTANT     if not isinstance(index, dict) or not isinstance(index.get("questions"), dict):
ASSISTANT         raise TerminalError("pinned question-schema index is malformed")
ASSISTANT     return index
ASSISTANT 
ASSISTANT 
ASSISTANT @lru_cache(maxsize=1)
ASSISTANT def _input_catalog_schema() -> dict[str, Any]:
ASSISTANT     schema = _load_pinned_json(contract.CONTRACT_DIR / "poc_input_catalog.v0.3.0.schema.json")
ASSISTANT     if not isinstance(schema, dict):
ASSISTANT         raise TerminalError("pinned input-catalog schema is malformed")
ASSISTANT     return schema
ASSISTANT 
ASSISTANT 
ASSISTANT def _registered_request_schema_path(question_id: str) -> Path:
ASSISTANT     """Resolve the question's registered request-schema path.
ASSISTANT 
ASSISTANT     Only paths registered in the pinned index, beneath the pinned contract
ASSISTANT     directory, may be loaded — anything else is contract drift.
ASSISTANT     """
ASSISTANT     entry = _schema_index()["questions"].get(question_id)
ASSISTANT     if not isinstance(entry, dict):
ASSISTANT         raise TerminalError(f"{question_id} has no registered request schema")
ASSISTANT     filename = entry.get("request_schema")
ASSISTANT     if not isinstance(filename, str) or filename != f"{question_id}.request.schema.json":
ASSISTANT         raise TerminalError(
ASSISTANT             f"{question_id} request-schema registration is inconsistent: {filename!r}"
ASSISTANT         )
ASSISTANT     path = (_SCHEMA_DIR / filename).resolve()
ASSISTANT     pinned = contract.CONTRACT_DIR.resolve()
ASSISTANT     if pinned not in path.parents:
ASSISTANT         raise TerminalError(
ASSISTANT             "refusing to load a request schema from outside the pinned contract "
ASSISTANT             f"directory: {filename}"
ASSISTANT         )
ASSISTANT     return path
ASSISTANT 
ASSISTANT 
ASSISTANT @lru_cache(maxsize=None)
ASSISTANT def _request_schema(question_id: str) -> dict[str, Any]:
ASSISTANT     schema = _load_pinned_json(_registered_request_schema_path(question_id))
ASSISTANT     if not isinstance(schema, dict):
ASSISTANT         raise TerminalError(f"{question_id} request schema is malformed")
ASSISTANT     return schema
ASSISTANT 
ASSISTANT 
ASSISTANT # --------------------------------------------------------------------------- #
ASSISTANT # Static vocabularies (registry metric_list; catalog field mapping + enums)
ASSISTANT # --------------------------------------------------------------------------- #
ASSISTANT 
ASSISTANT 
ASSISTANT @lru_cache(maxsize=1)
ASSISTANT def _field_to_catalog_list() -> dict[str, str]:
ASSISTANT     mapping = _input_catalog_schema().get("x-poc-request-field-to-catalog-list")
ASSISTANT     if not isinstance(mapping, dict):
ASSISTANT         return {}
ASSISTANT     return {
ASSISTANT         str(field): str(list_name)
ASSISTANT         for field, list_name in mapping.items()
ASSISTANT         if isinstance(field, str) and isinstance(list_name, str)
ASSISTANT     }
ASSISTANT 
ASSISTANT 
ASSISTANT def _static_enum(list_name: str) -> list[str] | None:
ASSISTANT     """The embedded static enum for a catalog list, or None when the list is
ASSISTANT     release-derived (shape-checked only, never enum-enforced — OD-03)."""
ASSISTANT     if list_name.startswith("release_derived_values."):
ASSISTANT         return None
ASSISTANT     prop = _input_catalog_schema().get("properties", {}).get(list_name)
ASSISTANT     if isinstance(prop, dict) and isinstance(prop.get("items"), dict):
ASSISTANT         enum = prop["items"].get("enum")
ASSISTANT         if isinstance(enum, list):
ASSISTANT             return [str(value) for value in enum]
ASSISTANT     return None
ASSISTANT 
ASSISTANT 
ASSISTANT def _static_vocabulary_for_field(question_id: str, field: str) -> list[str] | None:
ASSISTANT     list_name = _field_to_catalog_list().get(f"{question_id}.{field}")
ASSISTANT     if list_name is None:
ASSISTANT         return None
ASSISTANT     return _static_enum(list_name)
ASSISTANT 
ASSISTANT 
ASSISTANT def _selector_route(question_id: str) -> tuple[str, list[str]] | None:
ASSISTANT     """(request field, static vocabulary) for the question's label-selector bag.
ASSISTANT 
ASSISTANT     The registry's `metric_list` is authoritative where declared (VC-POC-01/04
ASSISTANT     → profile_metrics, VC-POC-11 → student_context_metrics); otherwise the
ASSISTANT     input-catalog schema's field mapping routes e.g. VC-POC-03 to `ratios` and
ASSISTANT     VC-POC-02/07 to `grades`.
ASSISTANT     """
ASSISTANT     entry = contract.questions().get(question_id) or {}
ASSISTANT     metric_list = entry.get("metric_list")
ASSISTANT     if metric_list:
ASSISTANT         values = contract.registry().get("metric_lists", {}).get(metric_list)
ASSISTANT         if not isinstance(values, list) or not values:
ASSISTANT             raise TerminalError(
ASSISTANT                 f"{question_id} declares metric_list {metric_list!r} with no pinned values"
ASSISTANT             )
ASSISTANT         return "metrics", [str(value) for value in values]
ASSISTANT     field_to_list = _field_to_catalog_list()
ASSISTANT     for key in sorted(field_to_list):
ASSISTANT         prefix = f"{question_id}."
ASSISTANT         if not key.startswith(prefix):
ASSISTANT             continue
ASSISTANT         field = key[len(prefix):]
ASSISTANT         if field in _SELECTOR_BAG_FIELDS:
ASSISTANT             vocabulary = _static_enum(field_to_list[key])
ASSISTANT             if vocabulary is None:
ASSISTANT                 raise TerminalError(
ASSISTANT                     f"{question_id}.{field} routes to a non-static vocabulary"
ASSISTANT                 )
ASSISTANT             return field, vocabulary
ASSISTANT     return None
ASSISTANT 
ASSISTANT 
ASSISTANT # --------------------------------------------------------------------------- #
ASSISTANT # Label normalization
ASSISTANT # --------------------------------------------------------------------------- #
ASSISTANT 
ASSISTANT 
ASSISTANT def _normalize_label(label: Any) -> str:
ASSISTANT     """Unicode-safe case folding plus separator normalization.
ASSISTANT 
ASSISTANT     `total_enrolments`, `Total Enrolments` and `total-enrolments` all fold to
ASSISTANT     `total enrolments`; Unicode letters survive the fold.
ASSISTANT     """
ASSISTANT     folded = _SEPARATOR_RE.sub(" ", str(label).casefold())
ASSISTANT     return folded.strip()
ASSISTANT 
ASSISTANT 
ASSISTANT def _canonical_for(label: Any, vocabulary: list[str]) -> str | None:
ASSISTANT     """Match a label against a pinned static vocabulary.
ASSISTANT 
ASSISTANT     Direct normalized matches win; beyond that only the pinned semantic
ASSISTANT     aliases apply. Canonical values are returned unchanged.
ASSISTANT     """
ASSISTANT     wanted = _normalize_label(label)
ASSISTANT     for value in vocabulary:
ASSISTANT         if _normalize_label(value) == wanted:
ASSISTANT             return value
ASSISTANT     alias = _PINNED_SELECTOR_ALIASES.get(wanted)
ASSISTANT     if alias is not None and alias in vocabulary:
ASSISTANT         return alias
ASSISTANT     return None
ASSISTANT 
ASSISTANT 
ASSISTANT def _dedupe(values: list[Any]) -> list[Any]:
ASSISTANT     """Order-preserving deduplication."""
ASSISTANT     seen: set[Any] = set()
ASSISTANT     unique: list[Any] = []
ASSISTANT     for value in values:
ASSISTANT         if value not in seen:
ASSISTANT             seen.add(value)
ASSISTANT             unique.append(value)
ASSISTANT     return unique
ASSISTANT 
ASSISTANT 
ASSISTANT # --------------------------------------------------------------------------- #
ASSISTANT # Pinned-schema validation (draft 2020-12 subset, dependency-free)
ASSISTANT # --------------------------------------------------------------------------- #
ASSISTANT 
ASSISTANT 
ASSISTANT def _json_key(value: Any) -> str:
ASSISTANT     return json.dumps(value, sort_keys=True, ensure_ascii=False, default=str)
ASSISTANT 
ASSISTANT 
ASSISTANT def _type_matches(value: Any, expected: str) -> bool:
ASSISTANT     if expected == "object":
ASSISTANT         return isinstance(value, dict)
ASSISTANT     if expected == "array":
ASSISTANT         return isinstance(value, list)
ASSISTANT     if expected == "string":
ASSISTANT         return isinstance(value, str)
ASSISTANT     if expected == "integer":
ASSISTANT         if isinstance(value, bool):
ASSISTANT             return False
ASSISTANT         if isinstance(value, int):
ASSISTANT             return True
ASSISTANT         return isinstance(value, float) and value.is_integer()
ASSISTANT     if expected == "number":
ASSISTANT         return isinstance(value, (int, float)) and not isinstance(value, bool)
ASSISTANT     if expected == "boolean":
ASSISTANT         return isinstance(value, bool)
ASSISTANT     if expected == "null":
ASSISTANT         return value is None
ASSISTANT     return True  # unknown type keyword: leave to the remaining checks
ASSISTANT 
ASSISTANT 
ASSISTANT def _schema_problems(value: Any, schema: Any, path: str) -> list[str]:
ASSISTANT     """Validate `value` against the pinned request schema.
ASSISTANT 
ASSISTANT     Supports the draft-2020-12 keywords the generated v0.3 request schemas
ASSISTANT     use: types, required/properties/additionalProperties, items, enum/const,
ASSISTANT     numeric bounds, cardinality, uniqueness, patterns, string lengths, and the
ASSISTANT     allOf/anyOf/oneOf and if/then/else combinators. Annotation keywords are
ASSISTANT     ignored.
ASSISTANT     """
ASSISTANT     problems: list[str] = []
ASSISTANT     if not isinstance(schema, dict):
ASSISTANT         return problems
ASSISTANT 
ASSISTANT     expected_type = schema.get("type")
ASSISTANT     if expected_type is not None:
ASSISTANT         expected_types = expected_type if isinstance(expected_type, list) else [expected_type]
ASSISTANT         if not any(_type_matches(value, str(t)) for t in expected_types):
ASSISTANT             problems.append(
ASSISTANT                 f"{path}: expected type {expected_type!r}, got {type(value).__name__}"
ASSISTANT             )
ASSISTANT             return problems
ASSISTANT 
ASSISTANT     if "const" in schema and _json_key(value) != _json_key(schema["const"]):
ASSISTANT         problems.append(f"{path}: must equal {schema['const']!r}")
ASSISTANT 
ASSISTANT     enum = schema.get("enum")
ASSISTANT     if isinstance(enum, list):
ASSISTANT         if not any(_json_key(value) == _json_key(candidate) for candidate in enum):
ASSISTANT             problems.append(f"{path}: {value!r} is not an allowed value")
ASSISTANT 
ASSISTANT     if isinstance(value, dict):
ASSISTANT         properties = schema.get("properties")
ASSISTANT         properties = properties if isinstance(properties, dict) else {}
ASSISTANT         for key, sub_schema in properties.items():
ASSISTANT             if key in value:
ASSISTANT                 problems.extend(_schema_problems(value[key], sub_schema, f"{path}.{key}"))
ASSISTANT         additional = schema.get("additionalProperties", True)
ASSISTANT         unknown = [key for key in value if key not in properties]
ASSISTANT         if unknown and additional is False:
ASSISTANT             problems.append(f"{path}: unknown properties {sorted(unknown)}")
ASSISTANT         elif isinstance(additional, dict):
ASSISTANT             for key in unknown:
ASSISTANT                 problems.extend(_schema_problems(value[key], additional, f"{path}.{key}"))
ASSISTANT         required = schema.get("required")
ASSISTANT         if isinstance(required, list):
ASSISTANT             for key in required:
ASSISTANT                 if key not in value:
ASSISTANT                     problems.append(f"{path}: missing required property {key!r}")
ASSISTANT         min_properties = schema.get("minProperties")
ASSISTANT         if isinstance(min_properties, int) and len(value) < min_properties:
ASSISTANT             problems.append(f"{path}: needs at least {min_properties} properties")
ASSISTANT         max_properties = schema.get("maxProperties")
ASSISTANT         if isinstance(max_properties, int) and len(value) > max_properties:
ASSISTANT             problems.append(f"{path}: allows at most {max_properties} properties")
ASSISTANT 
ASSISTANT     if isinstance(value, list):
ASSISTANT         min_items = schema.get("minItems")
ASSISTANT         if isinstance(min_items, int) and len(value) < min_items:
ASSISTANT             problems.append(f"{path}: needs at least {min_items} items")
ASSISTANT         max_items = schema.get("maxItems")
ASSISTANT         if isinstance(max_items, int) and len(value) > max_items:
ASSISTANT             problems.append(f"{path}: allows at most {max_items} items")
ASSISTANT         if schema.get("uniqueItems"):
ASSISTANT             item_keys = [_json_key(item) for item in value]
ASSISTANT             if len(set(item_keys)) != len(item_keys):
ASSISTANT                 problems.append(f"{path}: items must be unique")
ASSISTANT         items = schema.get("items")
ASSISTANT         if isinstance(items, dict):
ASSISTANT             for index, element in enumerate(value):
ASSISTANT                 problems.extend(_schema_problems(element, items, f"{path}[{index}]"))
ASSISTANT 
ASSISTANT     if isinstance(value, str):
ASSISTANT         pattern = schema.get("pattern")
ASSISTANT         if isinstance(pattern, str) and re.search(pattern, value) is None:
ASSISTANT             problems.append(f"{path}: does not match the required pattern")
ASSISTANT         min_length = schema.get("minLength")
ASSISTANT         if isinstance(min_length, int) and len(value) < min_length:
ASSISTANT             problems.append(f"{path}: shorter than the required minimum length")
ASSISTANT         max_length = schema.get("maxLength")
ASSISTANT         if isinstance(max_length, int) and len(value) > max_length:
ASSISTANT             problems.append(f"{path}: longer than the required maximum length")
ASSISTANT 
ASSISTANT     if isinstance(value, (int, float)) and not isinstance(value, bool):
ASSISTANT         minimum = schema.get("minimum")
ASSISTANT         if isinstance(minimum, (int, float)) and value < minimum:
ASSISTANT             problems.append(f"{path}: below the minimum {minimum}")
ASSISTANT         maximum = schema.get("maximum")
ASSISTANT         if isinstance(maximum, (int, float)) and value > maximum:
ASSISTANT             problems.append(f"{path}: above the maximum {maximum}")
ASSISTANT 
ASSISTANT     def _check(sub_schema: Any) -> list[str]:
ASSISTANT         return _schema_problems(value, sub_schema, path)
ASSISTANT 
ASSISTANT     all_of = schema.get("allOf")
ASSISTANT     if isinstance(all_of, list):
ASSISTANT         for sub_schema in all_of:
ASSISTANT             problems.extend(_check(sub_schema))
ASSISTANT     any_of = schema.get("anyOf")
ASSISTANT     if isinstance(any_of, list) and any_of:
ASSISTANT         if all(len(_check(sub_schema)) > 0 for sub_schema in any_of):
ASSISTANT             problems.append(f"{path}: matches none of the allowed variants")
ASSISTANT     one_of = schema.get("oneOf")
ASSISTANT     if isinstance(one_of, list) and one_of:
ASSISTANT         matches = sum(1 for sub_schema in one_of if not _check(sub_schema))
ASSISTANT         if matches != 1:
ASSISTANT             problems.append(
ASSISTANT                 f"{path}: must match exactly one allowed variant (matched {matches})"
ASSISTANT             )
ASSISTANT     if "if" in schema:
ASSISTANT         condition_holds = not _check(schema["if"])
ASSISTANT         branch = schema.get("then") if condition_holds else schema.get("else")
ASSISTANT         if isinstance(branch, dict):
ASSISTANT             problems.extend(_check(branch))
ASSISTANT     not_schema = schema.get("not")
ASSISTANT     if isinstance(not_schema, dict) and not _check(not_schema):
ASSISTANT         problems.append(f"{path}: matches a forbidden variant")
ASSISTANT 
ASSISTANT     return problems
ASSISTANT 
ASSISTANT 
ASSISTANT def _validate_request(question_id: str, request: dict[str, Any]) -> None:
ASSISTANT     """Validate the planner-built request against its registered pinned schema.
ASSISTANT 
ASSISTANT     Any failure — including schema load or resolution failure — is a
ASSISTANT     TerminalError before dispatch, never an Unsupported user outcome.
ASSISTANT     """
ASSISTANT     schema = _request_schema(question_id)
ASSISTANT     problems = _schema_problems(request, schema, "$request")
ASSISTANT     if problems:
ASSISTANT         raise TerminalError(
ASSISTANT             f"{question_id}: the planner-built request does not satisfy its "
ASSISTANT             f"registered request schema: " + "; ".join(problems)
ASSISTANT         )
ASSISTANT 
ASSISTANT 
ASSISTANT # --------------------------------------------------------------------------- #
ASSISTANT # School identity resolution (transactional, exactly-one-match)
ASSISTANT # --------------------------------------------------------------------------- #
ASSISTANT 
ASSISTANT 
ASSISTANT async def _resolve_mentions(
ASSISTANT     question_id: str,
ASSISTANT     mentions: list[str],
ASSISTANT     client: EvidenceClient,
ASSISTANT     deps: Deps,
ASSISTANT ) -> tuple[list[int], ClarificationNeeded | None]:
ASSISTANT     """Resolve each mention through the pinned directory, exactly one match each.
ASSISTANT 
ASSISTANT     Every preflight is recorded, including failures. IDs are staged locally in
ASSISTANT     mention order and deduplicated without reordering; nothing is committed
ASSISTANT     here — the caller commits to `Deps` only after every mention resolves.
ASSISTANT     """
ASSISTANT     staged: list[int] = []
ASSISTANT     for mention in mentions:
ASSISTANT         arguments = {"search": mention, "limit": 25}
ASSISTANT         try:
ASSISTANT             records = await client.school_directory(search=mention, limit=25)
ASSISTANT         except Exception as exc:
ASSISTANT             deps.tool_calls.append(
ASSISTANT                 ToolInvocation("search_schools", arguments, error_kind=type(exc).__name__)
ASSISTANT             )
ASSISTANT             raise
ASSISTANT         deps.tool_calls.append(ToolInvocation("search_schools", arguments, records))
ASSISTANT         ids = [
ASSISTANT             record["acara_sml_id"]
ASSISTANT             for record in records
ASSISTANT             if isinstance(record, dict)
ASSISTANT             and isinstance(record.get("acara_sml_id"), int)
ASSISTANT             and not isinstance(record["acara_sml_id"], bool)
ASSISTANT         ]
ASSISTANT         if not ids:
ASSISTANT             return [], _school_match_clarification(
ASSISTANT                 question_id,
ASSISTANT                 mention,
ASSISTANT                 f"'{mention}' matched no school in the pinned directory.",
ASSISTANT                 "I couldn't find that school. Could you check the name — or give me "
ASSISTANT                 "the school's public ACARA ID?",
ASSISTANT             )
ASSISTANT         if len(ids) > 1:
ASSISTANT             return [], _school_match_clarification(
ASSISTANT                 question_id,
ASSISTANT                 mention,
ASSISTANT                 f"'{mention}' matched {len(ids)} schools; a request needs exactly one.",
ASSISTANT                 f"More than one school matches '{mention}'. Which one did you mean?",
ASSISTANT             )
ASSISTANT         school_id = ids[0]
ASSISTANT         if school_id not in staged:
ASSISTANT             staged.append(school_id)
ASSISTANT     return staged, None
ASSISTANT 
ASSISTANT 
ASSISTANT def _school_match_clarification(
ASSISTANT     question_id: str, mention: str, why_material: str, prompt_to_user: str
ASSISTANT ) -> ClarificationNeeded:
ASSISTANT     return ClarificationNeeded(
ASSISTANT         question_id=question_id,
ASSISTANT         missing=[
ASSISTANT             MissingInput(input="acara_sml_id", why_material=why_material, allowed_values=[])
ASSISTANT         ],
ASSISTANT         prompt_to_user=prompt_to_user,
ASSISTANT     )
ASSISTANT 
ASSISTANT 
ASSISTANT def _adapt_explicit_school_fields(request: dict[str, Any], school_required: list[str]) -> None:
ASSISTANT     """Let a caller-supplied identity in either school field satisfy the
ASSISTANT     question's own selector field, without inventing values."""
ASSISTANT     if not school_required:
ASSISTANT         return
ASSISTANT     if "acara_sml_ids" in school_required:
ASSISTANT         if "acara_sml_ids" not in request and isinstance(request.get("acara_sml_id"), int):
ASSISTANT             request["acara_sml_ids"] = [request.pop("acara_sml_id")]
ASSISTANT     elif "acara_sml_id" in school_required:
ASSISTANT         if "acara_sml_id" not in request and isinstance(request.get("acara_sml_ids"), list):
ASSISTANT             ids = request["acara_sml_ids"]
ASSISTANT             if len(ids) == 1 and isinstance(ids[0], int) and not isinstance(ids[0], bool):
ASSISTANT                 request["acara_sml_id"] = ids[0]
ASSISTANT                 del request["acara_sml_ids"]
ASSISTANT             else:
ASSISTANT                 raise TerminalError(
ASSISTANT                     "caller supplied multiple acara_sml_ids for a question whose schema "
ASSISTANT                     "takes a single acara_sml_id"
ASSISTANT                 )
ASSISTANT 
ASSISTANT 
ASSISTANT def _attach_school_ids(
ASSISTANT     request: dict[str, Any], school_required: list[str], ids: list[int]
ASSISTANT ) -> None:
ASSISTANT     if not ids:
ASSISTANT         return
ASSISTANT     if "acara_sml_ids" in school_required:
ASSISTANT         request.setdefault("acara_sml_ids", list(ids))
ASSISTANT     elif "acara_sml_id" in school_required:
ASSISTANT         request.setdefault("acara_sml_id", ids[0])
ASSISTANT 
ASSISTANT 
ASSISTANT def _explicit_id_values(request: dict[str, Any], school_required: list[str]) -> list[int]:
ASSISTANT     if "acara_sml_ids" in school_required:
ASSISTANT         value = request.get("acara_sml_ids")
ASSISTANT         if isinstance(value, list):
ASSISTANT             return [v for v in value if isinstance(v, int) and not isinstance(v, bool)]
ASSISTANT         return []
ASSISTANT     if "acara_sml_id" in school_required:
ASSISTANT         value = request.get("acara_sml_id")
ASSISTANT         if isinstance(value, int) and not isinstance(value, bool):
ASSISTANT             return [value]
ASSISTANT     return []
ASSISTANT 
ASSISTANT 
ASSISTANT def _requires_two_distinct_ids(entry: dict[str, Any]) -> bool:
ASSISTANT     constraints = entry.get("input_policy", {}).get("constraints", [])
ASSISTANT     return any("at least two" in str(constraint) for constraint in constraints)
ASSISTANT 
ASSISTANT 
ASSISTANT def _insufficient_schools_clarification(question_id: str) -> ClarificationNeeded:
ASSISTANT     return ClarificationNeeded(
ASSISTANT         question_id=question_id,
ASSISTANT         missing=[
ASSISTANT             MissingInput(
ASSISTANT                 input="acara_sml_ids",
ASSISTANT                 why_material="This comparison needs at least two distinct schools.",
ASSISTANT                 allowed_values=[],
ASSISTANT             )
ASSISTANT         ],
ASSISTANT         prompt_to_user="Which distinct schools should be compared? Name at least two.",
ASSISTANT     )
ASSISTANT 
ASSISTANT 
ASSISTANT # --------------------------------------------------------------------------- #
ASSISTANT # Selector normalization and routing
ASSISTANT # --------------------------------------------------------------------------- #
ASSISTANT 
ASSISTANT 
ASSISTANT def _normalize_scalar_selectors(
ASSISTANT     question_id: str, request: dict[str, Any]
ASSISTANT ) -> ClarificationNeeded | None:
ASSISTANT     """Normalize static-closed scalar selectors (market_definition) against
ASSISTANT     their pinned vocabulary. Unnormalizable values clarify before dispatch."""
ASSISTANT     if "market_definition" not in request:
ASSISTANT         return None
ASSISTANT     value = request["market_definition"]
ASSISTANT     if not isinstance(value, str):
ASSISTANT         return None  # shape-checked by the pinned schema
ASSISTANT     vocabulary = _static_vocabulary_for_field(question_id, "market_definition")
ASSISTANT     if vocabulary is None:
ASSISTANT         return None
ASSISTANT     canonical = _canonical_for(value, vocabulary)
ASSISTANT     if canonical is None:
ASSISTANT         return ClarificationNeeded(
ASSISTANT             question_id=question_id,
ASSISTANT             missing=[
ASSISTANT                 MissingInput(
ASSISTANT                     input="market_definition",
ASSISTANT                     why_material=(
ASSISTANT                         f"'{value}' is not an allowed market definition for {question_id}."
ASSISTANT                     ),
ASSISTANT                     allowed_values=vocabulary,
ASSISTANT                 )
ASSISTANT             ],
ASSISTANT             prompt_to_user=(
ASSISTANT                 "Which market definition should I use? Allowed values: "
ASSISTANT                 + ", ".join(vocabulary)
ASSISTANT                 + "."
ASSISTANT             ),
ASSISTANT         )
ASSISTANT     request["market_definition"] = canonical
ASSISTANT     return None
ASSISTANT 
ASSISTANT 
ASSISTANT def _route_selectors(
ASSISTANT     question_id: str,
ASSISTANT     intent: StructuredIntent,
ASSISTANT     request: dict[str, Any],
ASSISTANT     deps: Deps,
ASSISTANT ) -> ClarificationNeeded | None:
ASSISTANT     """Route requested selector labels to the question's own request field.
ASSISTANT 
ASSISTANT     Static vocabularies come from pinned artefacts (registry metric_list where
ASSISTANT     declared, otherwise the input-catalog schema's field mapping and embedded
ASSISTANT     enums) — never from the runtime emitter. Selectors the user named none of
ASSISTANT     are omitted so the emitter keeps default ownership.
ASSISTANT     """
ASSISTANT     labels = [str(label) for label in (intent.requested_metrics or []) if str(label).strip()]
ASSISTANT     if not labels:
ASSISTANT         return None
ASSISTANT     route = _selector_route(question_id)
ASSISTANT     if route is None:
ASSISTANT         return ClarificationNeeded(
ASSISTANT             question_id=question_id,
ASSISTANT             missing=[
ASSISTANT                 MissingInput(
ASSISTANT                     input="metrics",
ASSISTANT                     why_material=(
ASSISTANT                         f"{question_id} takes no metric selector, so the requested "
ASSISTANT                         "labels cannot be applied to this request."
ASSISTANT                     ),
ASSISTANT                     allowed_values=[],
ASSISTANT                 )
ASSISTANT             ],
ASSISTANT             prompt_to_user="This question does not take metric selectors. Should I answer it as asked?",
ASSISTANT         )
ASSISTANT     field, vocabulary = route
ASSISTANT     canonical: list[str] = []
ASSISTANT     for label in labels:
ASSISTANT         matched = _canonical_for(label, vocabulary)
ASSISTANT         if matched is None:
ASSISTANT             return ClarificationNeeded(
ASSISTANT                 question_id=question_id,
ASSISTANT                 missing=[
ASSISTANT                     MissingInput(
ASSISTANT                         input=field,
ASSISTANT                         why_material=(
ASSISTANT                             f"'{label}' is not an allowed {field} value for {question_id}."
ASSISTANT                         ),
ASSISTANT                         allowed_values=vocabulary,
ASSISTANT                     )
ASSISTANT                 ],
ASSISTANT                 prompt_to_user=(
ASSISTANT                     f"Which {field} did you mean? Allowed values: "
ASSISTANT                     + ", ".join(vocabulary)
ASSISTANT                     + "."
ASSISTANT                 ),
ASSISTANT             )
ASSISTANT         canonical.append(matched)
ASSISTANT     canonical = _dedupe(canonical)
ASSISTANT 
ASSISTANT     if field == "metrics":
ASSISTANT         # Existing raw-question scope rule: a user who never asked about
ASSISTANT         # headcounts or non-teaching staff gets neither, even if a label was
ASSISTANT         # requested. Applied before validation, as before.
ASSISTANT         scope_problem = request_scope_problem(
ASSISTANT             deps.user_question, question_id, {**request, "metrics": canonical}
ASSISTANT         )
ASSISTANT         if scope_problem:
ASSISTANT             cleaned = [
ASSISTANT                 metric
ASSISTANT                 for metric in canonical
ASSISTANT                 if not (metric.endswith("_headcount") or metric.startswith("non_teaching_"))
ASSISTANT             ]
ASSISTANT             canonical = cleaned or canonical
ASSISTANT 
ASSISTANT     request[field] = canonical
ASSISTANT     return None
ASSISTANT 
ASSISTANT 
ASSISTANT # --------------------------------------------------------------------------- #
ASSISTANT # Registry-owned explicit-filter constraints (VC-POC-09/10, OD-07)
ASSISTANT # --------------------------------------------------------------------------- #
ASSISTANT 
ASSISTANT 
ASSISTANT def _enforce_explicit_filter_constraints(
ASSISTANT     question_id: str, entry: dict[str, Any], request: dict[str, Any]
ASSISTANT ) -> ClarificationNeeded | None:
ASSISTANT     """The registry-owned VC-POC-09/10 rule: a cohort definition must contain
ASSISTANT     at least one explicit filter — the sector default alone does not define a
ASSISTANT     peer group. Enforced exactly as pinned, not generalised into a condition
ASSISTANT     language. Absent fields are left to policy derivation."""
ASSISTANT     policy = entry.get("input_policy") or {}
ASSISTANT     required = [f for f in policy.get("required", []) if isinstance(f, str)]
ASSISTANT 
ASSISTANT     if "peer_filters" in required and isinstance(request.get("peer_filters"), dict):
ASSISTANT         filters = request["peer_filters"]
ASSISTANT         if not filters:
ASSISTANT             return _cohort_definition_clarification(
ASSISTANT                 question_id,
ASSISTANT                 "peer_filters",
ASSISTANT                 "The peer group definition is empty; at least one explicit filter "
ASSISTANT                 "is required.",
ASSISTANT             )
ASSISTANT         default_sectors = policy.get("defaultable", {}).get("peer_filters.sectors")
ASSISTANT         if (
ASSISTANT             set(filters) == {"sectors"}
ASSISTANT             and isinstance(default_sectors, list)
ASSISTANT             and isinstance(filters.get("sectors"), list)
ASSISTANT             and sorted(str(s) for s in filters["sectors"])
ASSISTANT             == sorted(str(s) for s in default_sectors)
ASSISTANT         ):
ASSISTANT             return _cohort_definition_clarification(
ASSISTANT                 question_id,
ASSISTANT                 "peer_filters",
ASSISTANT                 "The sector default alone does not define a peer group; at least one "
ASSISTANT                 "explicit filter beyond the sector default is required.",
ASSISTANT             )
ASSISTANT 
ASSISTANT     if "segment_filters" in required and isinstance(request.get("segment_filters"), dict):
ASSISTANT         if not request["segment_filters"]:
ASSISTANT             return _cohort_definition_clarification(
ASSISTANT                 question_id,
ASSISTANT                 "segment_filters",
ASSISTANT                 "The segment definition is empty; at least one explicit filter "
ASSISTANT                 "is required.",
ASSISTANT             )
ASSISTANT     return None
ASSISTANT 
ASSISTANT 
ASSISTANT def _cohort_definition_clarification(
ASSISTANT     question_id: str, field: str, why_material: str
ASSISTANT ) -> ClarificationNeeded:
ASSISTANT     return ClarificationNeeded(
ASSISTANT         question_id=question_id,
ASSISTANT         missing=[MissingInput(input=field, why_material=why_material, allowed_values=[])],
ASSISTANT         prompt_to_user=(
ASSISTANT             "Which rule should define this cohort — for example a sector, school "
ASSISTANT             "type, enrolment band, ICSEA range, remoteness or suburb?"
ASSISTANT         ),
ASSISTANT     )
ASSISTANT 
ASSISTANT 
ASSISTANT # --------------------------------------------------------------------------- #
ASSISTANT # Derived missing inputs (pinned policy order)
ASSISTANT # --------------------------------------------------------------------------- #
ASSISTANT 
ASSISTANT 
ASSISTANT def _derive_missing_inputs(
ASSISTANT     question_id: str, entry: dict[str, Any], request: dict[str, Any]
ASSISTANT ) -> list[str]:
ASSISTANT     """Missing required, material, then applicable conditional-material fields,
ASSISTANT     in pinned policy order — derived from policy and the assembled request,
ASSISTANT     never taken from the model's missing-input claim."""
ASSISTANT     policy = entry.get("input_policy") or {}
ASSISTANT     missing: list[str] = []
ASSISTANT     seen: set[str] = set()
ASSISTANT 
ASSISTANT     def consider(field: str) -> None:
ASSISTANT         if field in seen:
ASSISTANT             return
ASSISTANT         seen.add(field)
ASSISTANT         if field not in request:
ASSISTANT             missing.append(field)
ASSISTANT 
ASSISTANT     for field in policy.get("required", []):
ASSISTANT         if isinstance(field, str):
ASSISTANT             consider(field)
ASSISTANT     for field in policy.get("material", []):
ASSISTANT         if isinstance(field, str):
ASSISTANT             consider(field)
ASSISTANT 
ASSISTANT     conditional = policy.get("conditional_material") or {}
ASSISTANT     if isinstance(conditional, dict):
ASSISTANT         for field, condition in conditional.items():
ASSISTANT             if not isinstance(field, str):
ASSISTANT                 continue
ASSISTANT             normalized_condition = _SEPARATOR_RE.sub(" ", str(condition).casefold()).strip()
ASSISTANT             if field == "distance_km" and normalized_condition in _KNOWN_DISTANCE_CONDITIONS:
ASSISTANT                 if request.get("market_definition") == "distance" and "distance_km" not in request:
ASSISTANT                     consider(field)
ASSISTANT             else:
ASSISTANT                 raise TerminalError(
ASSISTANT                     f"{question_id}: unsupported conditional-material expression "
ASSISTANT                     f"{condition!r} for {field} — contract drift, refusing to interpret it"
ASSISTANT                 )
ASSISTANT     return missing
ASSISTANT 
ASSISTANT 
ASSISTANT # --------------------------------------------------------------------------- #
ASSISTANT # Stage 2 entry point
ASSISTANT # --------------------------------------------------------------------------- #
ASSISTANT 
ASSISTANT 
ASSISTANT async def plan_and_execute(
ASSISTANT     intent: StructuredIntent,
ASSISTANT     client: EvidenceClient,
ASSISTANT     deps: Deps,
ASSISTANT ) -> dict[str, Any] | ClarificationNeeded | Unsupported:
ASSISTANT     """Deterministic Stage 2: intent → evidence envelope or typed outcome.
ASSISTANT 
ASSISTANT     Returns:
ASSISTANT         dict — the evidence envelope (happy path)
ASSISTANT         ClarificationNeeded — a caller-suppliable input is missing or wrong
ASSISTANT         Unsupported — an exclusion or an unknown question
ASSISTANT     May raise:
ASSISTANT         TerminalError — planner/schema defects and operational stops
ASSISTANT     """
ASSISTANT     question_id = intent.question_id
ASSISTANT 
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     # 1. Excluded topic (intent model classified it as out of scope)
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     if question_id == "excluded":
ASSISTANT         exclusion_text = _find_exclusion_text(intent.excluded_topic)
ASSISTANT         logger.debug(
ASSISTANT             "intent classified as excluded topic",
ASSISTANT             extra={"subsystem": "planner", "excluded_topic": intent.excluded_topic},
ASSISTANT         )
ASSISTANT         return Unsupported(
ASSISTANT             reason_kind="excluded_by_contract",
ASSISTANT             reason=exclusion_text,
ASSISTANT         )
ASSISTANT 
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     # 2. Registry-owned excluded question (e.g. VC-POC-TRANSPORT-01)
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     excluded = contract.excluded_questions().get(question_id)
ASSISTANT     if excluded:
ASSISTANT         reason_code = excluded.get("reason_code")
ASSISTANT         reason_kind = (
ASSISTANT             "not_yet_validated"
ASSISTANT             if reason_code == "not_yet_validated"
ASSISTANT             else "excluded_by_contract"
ASSISTANT         )
ASSISTANT         return Unsupported(
ASSISTANT             reason_kind=reason_kind,
ASSISTANT             reason=excluded.get("message", ""),
ASSISTANT             reason_code=reason_code,
ASSISTANT         )
ASSISTANT 
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     # 3. Registered but gated question (e.g. VC-POC-14 via availability)
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     if question_id in contract.questions():
ASSISTANT         refusal = contract.refusal_for(question_id)
ASSISTANT         if refusal is not None:
ASSISTANT             reason_code = refusal.get("reason_code")
ASSISTANT             reason_kind = (
ASSISTANT                 "not_yet_validated"
ASSISTANT                 if reason_code == "not_yet_validated"
ASSISTANT                 else "excluded_by_contract"
ASSISTANT             )
ASSISTANT             return Unsupported(
ASSISTANT                 reason_kind=reason_kind,
ASSISTANT                 reason=refusal.get("message", ""),
ASSISTANT                 reason_code=reason_code,
ASSISTANT             )
ASSISTANT 
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     # 4. Not in registry at all (unknown question)
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     if question_id not in contract.questions() and question_id not in contract.excluded_questions():
ASSISTANT         if question_id == "unknown":
ASSISTANT             return Unsupported(
ASSISTANT                 reason_kind="not_in_registry",
ASSISTANT                 reason="The question does not map to any approved registry question.",
ASSISTANT             )
ASSISTANT         return Unsupported(
ASSISTANT             reason_kind="not_in_registry",
ASSISTANT             reason=f"{question_id} is not a registry question.",
ASSISTANT         )
ASSISTANT 
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     # 5. Pinned policy and assembled request
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     entry = contract.questions().get(question_id)
ASSISTANT     if entry is None:
ASSISTANT         raise TerminalError(
ASSISTANT             f"{question_id} has a registered request schema but is absent from "
ASSISTANT             "the pinned registry — contract drift"
ASSISTANT         )
ASSISTANT     policy = entry.get("input_policy") or {}
ASSISTANT     required_fields = [f for f in policy.get("required", []) if isinstance(f, str)]
ASSISTANT     school_required = [f for f in required_fields if f in _SCHOOL_FIELDS]
ASSISTANT 
ASSISTANT     # Fresh request from explicit intent fields only; planner-owned selectors
ASSISTANT     # are added below. Unsupplied defaultables stay omitted — the emitter owns
ASSISTANT     # defaults and resolved_request.
ASSISTANT     request: dict[str, Any] = dict(intent.filters)
ASSISTANT 
ASSISTANT     scalar_clarification = _normalize_scalar_selectors(question_id, request)
ASSISTANT     if scalar_clarification is not None:
ASSISTANT         return scalar_clarification
ASSISTANT 
ASSISTANT     _adapt_explicit_school_fields(request, school_required)
ASSISTANT     identity_from_caller = any(field in request for field in school_required)
ASSISTANT 
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     # 6. Transactional named-school resolution
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     mentions = [
ASSISTANT         mention for mention in (intent.school_mentions or [])
ASSISTANT         if isinstance(mention, str) and mention.strip()
ASSISTANT     ]
ASSISTANT     if school_required and mentions:
ASSISTANT         resolved_ids, failure = await _resolve_mentions(question_id, mentions, client, deps)
ASSISTANT         if failure is not None:
ASSISTANT             return failure
ASSISTANT         if identity_from_caller:
ASSISTANT             explicit_ids = _explicit_id_values(request, school_required)
ASSISTANT             if sorted(resolved_ids) != sorted(explicit_ids):
ASSISTANT                 raise TerminalError(
ASSISTANT                     f"{question_id}: explicit school identities {explicit_ids} conflict "
ASSISTANT                     f"with directory-resolved identities {resolved_ids}"
ASSISTANT                 )
ASSISTANT             deps.searched = True
ASSISTANT         else:
ASSISTANT             if _requires_two_distinct_ids(entry) and len(resolved_ids) < 2:
ASSISTANT                 return _insufficient_schools_clarification(question_id)
ASSISTANT             for school_id in resolved_ids:
ASSISTANT                 if school_id not in deps.resolved_school_ids:
ASSISTANT                     deps.resolved_school_ids.append(school_id)
ASSISTANT             deps.searched = True
ASSISTANT             _attach_school_ids(request, school_required, resolved_ids)
ASSISTANT     elif school_required and identity_from_caller and "acara_sml_ids" in school_required:
ASSISTANT         explicit_ids = _explicit_id_values(request, school_required)
ASSISTANT         raw_ids = request.get("acara_sml_ids")
ASSISTANT         if (
ASSISTANT             _requires_two_distinct_ids(entry)
ASSISTANT             and isinstance(raw_ids, list)
ASSISTANT             and len(explicit_ids) == len(raw_ids)
ASSISTANT             and len(_dedupe(explicit_ids)) < 2
ASSISTANT         ):
ASSISTANT             return _insufficient_schools_clarification(question_id)
ASSISTANT 
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     # 7. Selector normalization and routing (clarifies unnormalizable labels)
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     selector_clarification = _route_selectors(question_id, intent, request, deps)
ASSISTANT     if selector_clarification is not None:
ASSISTANT         return selector_clarification
ASSISTANT 
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     # 8. Registry-owned explicit-filter constraints (VC-POC-09/10)
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     constraint_clarification = _enforce_explicit_filter_constraints(
ASSISTANT         question_id, entry, request
ASSISTANT     )
ASSISTANT     if constraint_clarification is not None:
ASSISTANT         return constraint_clarification
ASSISTANT 
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     # 9. Derive missing inputs from the pinned policy (stable order)
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     missing = _derive_missing_inputs(question_id, entry, request)
ASSISTANT     if missing:
ASSISTANT         missing_items = [
ASSISTANT             MissingInput(
ASSISTANT                 input=field,
ASSISTANT                 why_material=_material_why(question_id, field),
ASSISTANT                 allowed_values=_static_vocabulary_for_field(question_id, field) or [],
ASSISTANT             )
ASSISTANT             for field in missing
ASSISTANT         ]
ASSISTANT         prompt_to_user = (
ASSISTANT             "To answer this question I need "
ASSISTANT             + ", ".join(f"the {field}" for field in missing)
ASSISTANT             + ". Could you provide "
ASSISTANT             + ("it" if len(missing) == 1 else "them")
ASSISTANT             + "?"
ASSISTANT         )
ASSISTANT         logger.debug(
ASSISTANT             "planner clarification",
ASSISTANT             extra={"subsystem": "planner", "question_id": question_id, "missing": missing},
ASSISTANT         )
ASSISTANT         return ClarificationNeeded(
ASSISTANT             question_id=question_id,
ASSISTANT             missing=missing_items,
ASSISTANT             prompt_to_user=prompt_to_user,
ASSISTANT         )
ASSISTANT 
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     # 10. Pinned-schema validation before dispatch
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     _validate_request(question_id, request)
ASSISTANT 
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     # 11. Fetch evidence (failures recorded before branching)
ASSISTANT     # ------------------------------------------------------------------ #
ASSISTANT     arguments = {"question_id": question_id, "request": request}
ASSISTANT     try:
ASSISTANT         envelope = await client.fetch_evidence(question_id, request)
ASSISTANT     except EvidenceError as exc:
ASSISTANT         deps.tool_calls.append(
ASSISTANT             ToolInvocation("fetch_evidence", arguments, error_kind=exc.error_kind)
ASSISTANT         )
ASSISTANT         return _branch_evidence_error(question_id, exc, identity_from_caller)
ASSISTANT     except Exception:
ASSISTANT         deps.tool_calls.append(
ASSISTANT             ToolInvocation("fetch_evidence", arguments, error_kind="operational")
ASSISTANT         )
ASSISTANT         raise
ASSISTANT 
ASSISTANT     deps.tool_calls.append(ToolInvocation("fetch_evidence", arguments, envelope))
ASSISTANT     deps.last_envelope = envelope
ASSISTANT     logger.debug(
ASSISTANT         "evidence fetched by planner",
ASSISTANT         extra={"subsystem": "planner", "question_id": question_id},
ASSISTANT     )
ASSISTANT     return envelope
ASSISTANT 
ASSISTANT 
ASSISTANT def _material_why(question_id: str, input_name: str) -> str:
ASSISTANT     """A one-sentence human-readable explanation of why an input is material."""
ASSISTANT     explanations: dict[str, str] = {
ASSISTANT         "market_definition": "The market boundary changes which schools are compared.",
ASSISTANT         "distance_km": "\"Near\" is not a distance — the radius determines which schools qualify.",
ASSISTANT         "grades": "The grade selection determines which year levels are included.",
ASSISTANT         "peer_filters": "The peer group definition determines which schools are compared.",
ASSISTANT         "segment_filters": "The segment definition determines which schools are included.",
ASSISTANT         "sa2_codes": "The SA2 area determines which geographic area is analysed.",
ASSISTANT         "zone_entity_code": "The zone entity code identifies the government zone to look up.",
ASSISTANT         "acara_sml_id": "The school must be identified before evidence can be fetched.",
ASSISTANT         "acara_sml_ids": "The schools must be identified before evidence can be fetched.",
ASSISTANT     }
ASSISTANT     return explanations.get(
ASSISTANT         input_name,
ASSISTANT         f"{input_name} is required by the data layer and cannot be defaulted for this question.",
ASSISTANT     )
ASSISTANT 
ASSISTANT 
ASSISTANT def _branch_evidence_error(
ASSISTANT     question_id: str,
ASSISTANT     exc: EvidenceError,
ASSISTANT     identity_from_caller: bool,
ASSISTANT ) -> Unsupported | ClarificationNeeded:
ASSISTANT     """Translate an EvidenceError into the pipeline's typed outcomes.
ASSISTANT 
ASSISTANT     Origin-aware: a bad_request for a request whose school identity was
ASSISTANT     caller-supplied is a correctable identity problem → ClarificationNeeded.
ASSISTANT     Any other bad_request — the request was deterministic and schema-valid —
ASSISTANT     is planner/contract drift → TerminalError. excluded/unknown/unanswerable
ASSISTANT     keep their contract-owned refusals; data_unavailable/internal are
ASSISTANT     operational stops, never refusals.
ASSISTANT     """
ASSISTANT     kind = exc.error_kind
ASSISTANT     logger.debug(
ASSISTANT         "evidence error in planner",
ASSISTANT         extra={"subsystem": "planner", "error_kind": kind, "question_id": question_id},
ASSISTANT     )
ASSISTANT 
ASSISTANT     if kind == "excluded_question":
ASSISTANT         reason_code = exc.reason_code or contract.reason_code_for(question_id)
ASSISTANT         reason_kind = (
ASSISTANT             "not_yet_validated"
ASSISTANT             if reason_code == "not_yet_validated"
ASSISTANT             else "excluded_by_contract"
ASSISTANT         )
ASSISTANT         return Unsupported(
ASSISTANT             reason_kind=reason_kind,
ASSISTANT             reason=exc.message,
ASSISTANT             reason_code=reason_code,
ASSISTANT         )
ASSISTANT 
ASSISTANT     if kind == "unknown_question":
ASSISTANT         return Unsupported(reason_kind="not_in_registry", reason=exc.message)
ASSISTANT 
ASSISTANT     if kind == "unanswerable":
ASSISTANT         return Unsupported(reason_kind="unanswerable", reason=exc.message)
ASSISTANT 
ASSISTANT     if kind == "bad_request":
ASSISTANT         if identity_from_caller:
ASSISTANT             return ClarificationNeeded(
ASSISTANT                 question_id=question_id,
ASSISTANT                 missing=[
ASSISTANT                     MissingInput(
ASSISTANT                         input="acara_sml_id",
ASSISTANT                         why_material=(
ASSISTANT                             "The data layer rejected the supplied school identity "
ASSISTANT                             f"({exc.message}). Confirm the school's current public "
ASSISTANT                             "ACARA_SML_ID."
ASSISTANT                         ),
ASSISTANT                         allowed_values=[],
ASSISTANT                     )
ASSISTANT                 ],
ASSISTANT                 prompt_to_user=(
ASSISTANT                     "The school identity supplied for this question was rejected by the "
ASSISTANT                     "data layer. Could you confirm the school?"
ASSISTANT                 ),
ASSISTANT             )
ASSISTANT         raise TerminalError(
ASSISTANT             f"{question_id}: the evidence emitter returned bad_request for a "
ASSISTANT             f"deterministic, schema-valid request — planner/contract drift: {exc.message}"
ASSISTANT         )
ASSISTANT 
ASSISTANT     # data_unavailable | internal — operational stop, not a refusal.
ASSISTANT     raise TerminalError(f"evidence emitter reported {kind}: {exc.message}")
ASSISTANT ````
