USER #!/usr/bin/env python
USER """Say which local model provider the harness will use and whether it is ready.
USER 
USER     .venv/bin/python authcheck.py
USER 
USER Claude account mode (the local POC default) requires
USER ``CLAUDE_CODE_OAUTH_TOKEN`` in the inherited process environment and checks it
USER with ``claude auth status``. It reports presence only and never prints any part
USER of the token. The optional Anthropic SDK mode retains the credential diagnostics
USER below and may make one metered request when explicitly selected.
USER 
USER One 401 looks the same whichever of several things is wrong, so this separates
USER them before anything expensive runs. Account mode makes no model request. The
USER explicit SDK mode makes at most one `max_tokens=1` request. Neither path touches
USER the emitter, frozen prompt, or eval tier. The script reports; it changes nothing.
USER 
USER **The mistake this file corrects.** An earlier version of this script treated
USER "the `ant` or `claude` CLI is on PATH, and `<cli> auth status` reports
USER logged in" as evidence that the Anthropic SDK's zero-arg client would find a
USER credential. It will not, for a `claude auth login` (Claude Code) session —
USER confirmed by reading `anthropic.lib.credentials._chain.default_credentials()`
USER in the installed SDK. That function resolves, in order: `ANTHROPIC_API_KEY`,
USER `ANTHROPIC_AUTH_TOKEN`, then a profile file under `~/.config/anthropic`
USER (override: `ANTHROPIC_CONFIG_DIR` / `ANTHROPIC_PROFILE`) written by `ant auth
USER login`, then workload-identity federation env vars. **`claude auth login`
USER writes to neither store.** It authenticates the Claude Code CLI itself and is
USER not something the standalone `anthropic` Python package can read — there is no
USER bridge except minting an explicit token with `claude setup-token` and setting
USER `ANTHROPIC_AUTH_TOKEN`.
USER 
USER So this script calls `anthropic.default_credentials()` directly — the same
USER function the SDK's own constructor calls — rather than inferring from CLI
USER presence. That is ground truth: if it returns `None`, the client will raise
USER before any HTTP request is attempted, whatever `claude auth status` says.
USER """
USER 
USER from __future__ import annotations
USER 
USER import asyncio
USER import os
USER import shutil
USER import subprocess
USER import sys
USER from pathlib import Path
USER 
USER PROJECT_ROOT = Path(__file__).resolve().parent
USER if str(PROJECT_ROOT) not in sys.path:
USER     sys.path.insert(0, str(PROJECT_ROOT))
USER 
USER os.environ.setdefault("LOG_LEVEL", "WARNING")
USER 
USER from config import settings  # noqa: E402
USER from harness.claude_account_cli import claude_account_status  # noqa: E402
USER 
USER OK, BAD, MEH = "  ok  ", " FAIL ", "  ??  "
USER 
USER 
USER def line(mark: str, text: str) -> None:
USER     print(f"[{mark}] {text}")
USER 
USER 
USER def describe_secret(name: str, value: str | None) -> None:
USER     """Presence and basic hygiene only; never print credential content."""
USER     if not value:
USER         line(MEH, f"{name}: not set")
USER         return
USER     problems = []
USER     if value != value.strip():
USER         problems.append("leading/trailing whitespace")
USER     if value[:1] in "\"'" or value[-1:] in "\"'":
USER         problems.append("quote characters — .env does not need them")
USER     if len(value) < 20:
USER         problems.append(f"suspiciously short ({len(value)} chars)")
USER     mark = BAD if problems else OK
USER     line(mark, f"{name}: set" + (f" — {'; '.join(problems)}" if problems else ""))
USER 
USER 
USER def describe_presence(name: str, value: str | None) -> None:
USER     """Report only presence; account tokens must never reach terminal output."""
USER     line(OK if value else MEH, f"{name}: {'set' if value else 'not set'}")
USER 
USER 
USER def cli_status() -> None:
USER     """Report what each installed CLI's own auth status says. **Diagnostic
USER     only** — a `claude` login being reported here does NOT mean the SDK can use
USER     it; see `sdk_finds_a_profile()` for the check that actually matters."""
USER     found_any = False
USER     for binary, label in (("claude", "Claude Code"), ("ant", "Anthropic SDK CLI")):
USER         path = shutil.which(binary)
USER         if not path:
USER             continue
USER         found_any = True
USER         try:
USER             result = subprocess.run(
USER                 [binary, "auth", "status"], capture_output=True, text=True, timeout=20
USER             )
USER         except (OSError, subprocess.SubprocessError) as exc:
USER             line(MEH, f"`{binary} auth status` ({label}) did not run: {exc}")
USER             continue
USER         output = (result.stdout + result.stderr).strip()
USER         line(OK if result.returncode == 0 else MEH, f"`{binary} auth status` ({label}):")
USER         for row in output.splitlines():
USER             print(f"        {row}")
USER     if not found_any:
USER         line(MEH, "neither `claude` nor `ant` is on PATH")
USER 
USER 
USER def sdk_finds_a_profile() -> tuple[bool, str]:
USER     """The question that actually matters, answered by the SDK's own logic —
USER     not inferred from which CLI is installed. No network call: this only reads
USER     env vars and, at most, a config file's existence and JSON body."""
USER     import anthropic
USER 
USER     try:
USER         result = anthropic.default_credentials(base_url="https://api.anthropic.com")
USER     except Exception as exc:  # noqa: BLE001 — a broken config file is a result
USER         return False, f"a profile exists but is broken: {type(exc).__name__}: {exc}"
USER     if result is None:
USER         return False, "none found"
USER     return True, f"found via {type(result.provider).__name__}"
USER 
USER 
USER async def try_one_request() -> tuple[bool, str]:
USER     """One request, one token. The cheapest possible question to the provider."""
USER     from harness.agent import build_anthropic_client
USER 
USER     client = build_anthropic_client()
USER     try:
USER         await client.messages.create(
USER             model=settings.MODEL_PRIMARY,
USER             max_tokens=1,
USER             messages=[{"role": "user", "content": "hi"}],
USER         )
USER     except Exception as exc:  # noqa: BLE001 — every failure is a result here
USER         return False, f"{type(exc).__name__}: {exc}"
USER     return True, "accepted"
USER 
USER 
USER def main() -> int:
USER     print(f"contract {settings.CONTRACT_VERSION} · model {settings.MODEL_PRIMARY}\n")
USER 
USER     if settings.MODEL_PROVIDER == "claude_account":
USER         print("Provider: Claude Code subscription account (not the metered SDK route).")
USER         describe_presence("CLAUDE_CODE_OAUTH_TOKEN", settings.CLAUDE_CODE_OAUTH_TOKEN)
USER         ok, detail = claude_account_status(settings.CLAUDE_CLI)
USER         line(OK if ok else BAD, f"`{settings.CLAUDE_CLI} auth status`: {detail}")
USER         if ok:
USER             print("\nAccount works. `pytest tests/live -m live -q` is ready to run.")
USER             return 0
USER         print("\nSource the machine-level file containing CLAUDE_CODE_OAUTH_TOKEN, then retry.")
USER         return 1
USER 
USER     print("Credential sources, in the order the SDK resolves them:")
USER     describe_secret("ANTHROPIC_API_KEY", settings.ANTHROPIC_API_KEY)
USER     describe_secret("ANTHROPIC_AUTH_TOKEN", settings.ANTHROPIC_AUTH_TOKEN)
USER     cli_status()
USER     print()
USER 
USER     profile_found, profile_detail = sdk_finds_a_profile()
USER     line(OK if profile_found else MEH, f"SDK profile fallback: {profile_detail}")
USER     print()
USER 
USER     usable_source = settings.ANTHROPIC_AUTH_MODE != "profile" or profile_found
USER     line(
USER         OK if usable_source else BAD,
USER         f"configured SDK auth mode: {settings.ANTHROPIC_AUTH_MODE}",
USER     )
USER     if not usable_source:
USER         line(
USER             BAD,
USER             "profile mode is the fallback because no environment credential is set, "
USER             "but the SDK finds no profile to use — the "
USER             "next request WILL fail with a TypeError before any HTTP call is "
USER             "made. See 'What a failure here means' below.",
USER         )
USER     elif settings.ANTHROPIC_AUTH_MODE != "profile" and profile_found:
USER         line(
USER             MEH,
USER             f"an env var is set, so the SDK profile found above is being "
USER             "SHADOWED — unset the env var in .env to use it instead",
USER         )
USER     print()
USER 
USER     print("Asking the provider once (max_tokens=1)...")
USER     ok, detail = asyncio.run(try_one_request())
USER     line(OK if ok else BAD, detail)
USER 
USER     if ok:
USER         print("\nCredential works. `pytest tests/live -m live -q` is safe to run.")
USER         return 0
USER 
USER     print("\nWhat a failure here means:")
USER     print("  'Could not resolve authentication method'")
USER     print("                              No credential at all was found — this is the")
USER     print("                              expected result of a `claude auth login`")
USER     print("                              (Claude Code) session with no ANTHROPIC_API_KEY")
USER     print("                              or ANTHROPIC_AUTH_TOKEN set. `claude auth login`")
USER     print("                              does NOT populate anything this SDK can read —")
USER     print("                              it authenticates the Claude Code CLI itself, not")
USER     print("                              the standalone `anthropic` package. Fix: run")
USER     print("                              `claude setup-token`, then put the token it")
USER     print("                              prints in .env as ANTHROPIC_AUTH_TOKEN.")
USER     print("  401 'Invalid bearer token'  the token IS set, but is wrong, expired, or is")
USER     print("                              not valid for the Messages API. Mint a fresh one")
USER     print("                              with `claude setup-token`.")
USER     print("  401 with an API key         the key is wrong or revoked.")
USER     print("  404                         MODEL_PRIMARY does not exist — that is a")
USER     print("                              settings problem, not an auth problem.")
USER     print("  403                         the credential is valid but not entitled.")
USER     return 1
USER 
USER 
USER if __name__ == "__main__":
USER     raise SystemExit(main())
