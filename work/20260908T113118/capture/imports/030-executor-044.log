ASSISTANT tests/unit/test_intent_boundary.py
ASSISTANT ````
ASSISTANT """Stage 1 — intent boundary tests.
ASSISTANT 
ASSISTANT Proves that `interpret_intent()` is a single-call, no-tools extraction that
ASSISTANT returns a typed `StructuredIntent`, and that the pipeline path of `ask()`
ASSISTANT correctly wires the intent stage.
ASSISTANT 
ASSISTANT It also pins the planner boundary as seen through `ask()`: planner
ASSISTANT clarifications bypass narration and the answer view; normalized, schema-valid
ASSISTANT requests reach evidence with exact arguments; planner/schema defects propagate
ASSISTANT as `TerminalError` (never as an `Unsupported` user outcome); and
ASSISTANT caller-correctable selector or identity problems stay clarifications.
ASSISTANT 
ASSISTANT All tests are fully offline: models are scripted `FunctionModel` instances that
ASSISTANT return canned responses, and the evidence client uses the stub emitter.
ASSISTANT Nothing here touches the network, the credential store, or the data project.
ASSISTANT """
ASSISTANT 
ASSISTANT from __future__ import annotations
ASSISTANT 
ASSISTANT import asyncio
ASSISTANT import sys
ASSISTANT from pathlib import Path
ASSISTANT from typing import Any
ASSISTANT 
ASSISTANT import pytest
ASSISTANT from pydantic_ai.messages import ModelMessage, ModelResponse, ToolCallPart
ASSISTANT from pydantic_ai.models.function import AgentInfo, FunctionModel
ASSISTANT 
ASSISTANT from harness.agent import ask
ASSISTANT from harness.evidence import EvidenceError
ASSISTANT from harness.errors import TerminalError
ASSISTANT from harness.intent import StructuredIntent, build_intent_agent, interpret_intent
ASSISTANT from harness.narration import NarrationOutput, NarrationValidationError
ASSISTANT from harness.outputs import ClarificationNeeded, RenderedAnswer, Unsupported
ASSISTANT from harness.tools import Deps
ASSISTANT 
ASSISTANT PROJECT_ROOT = Path(__file__).resolve().parents[2]
ASSISTANT STUB = PROJECT_ROOT / "evals" / "stub_emitter.py"
ASSISTANT 
ASSISTANT # In pydantic-ai 1.106.0, a single (non-union) output type uses "final_result"
ASSISTANT # as the tool name. Union output types (like AgentOutput) use per-member names
ASSISTANT # like "final_result_AnswerDraft". These agents have single output types.
ASSISTANT INTENT_TOOL = "final_result"
ASSISTANT NARRATION_TOOL = "final_result"
ASSISTANT 
ASSISTANT 
ASSISTANT def stub_client(**kwargs):
ASSISTANT     from harness.evidence import EvidenceClient
ASSISTANT     return EvidenceClient(python=Path(sys.executable), emitter=STUB, **kwargs)
ASSISTANT 
ASSISTANT 
ASSISTANT def make_intent_model(intent: StructuredIntent) -> FunctionModel:
ASSISTANT     """A model that returns a fixed StructuredIntent immediately."""
ASSISTANT     payload = intent.model_dump()
ASSISTANT 
ASSISTANT     def fn(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:
ASSISTANT         return ModelResponse(parts=[ToolCallPart(INTENT_TOOL, payload)])
ASSISTANT 
ASSISTANT     return FunctionModel(fn)
ASSISTANT 
ASSISTANT 
ASSISTANT def make_narration_model(answer: str, data_status_note: str | None = None) -> FunctionModel:
ASSISTANT     """A model that returns fixed narration, optionally with a stale extra field."""
ASSISTANT     payload = {"answer": answer}
ASSISTANT     if data_status_note is not None:
ASSISTANT         payload["data_status_note"] = data_status_note
ASSISTANT 
ASSISTANT     def fn(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:
ASSISTANT         return ModelResponse(parts=[ToolCallPart(NARRATION_TOOL, payload)])
ASSISTANT 
ASSISTANT     return FunctionModel(fn)
ASSISTANT 
ASSISTANT 
ASSISTANT def make_two_call_model() -> FunctionModel:
ASSISTANT     """A model that refuses to finish on the first call (triggers second request)."""
ASSISTANT     calls: list[int] = [0]
ASSISTANT 
ASSISTANT     def fn(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:
ASSISTANT         calls[0] += 1
ASSISTANT         # First call: return a plausible-but-wrong tool name to force a retry
ASSISTANT         # Second call: return the real tool
ASSISTANT         if calls[0] < 2:
ASSISTANT             return ModelResponse(parts=[ToolCallPart("not_an_output_tool", {})])
ASSISTANT         return ModelResponse(parts=[ToolCallPart(INTENT_TOOL, {
ASSISTANT             "question_id": "VC-POC-01",
ASSISTANT             "school_mentions": [],
ASSISTANT         })])
ASSISTANT 
ASSISTANT     return FunctionModel(fn)
ASSISTANT 
ASSISTANT 
ASSISTANT class _RecordingClient:
ASSISTANT     """Wraps a client, recording the exact fetch_evidence arguments."""
ASSISTANT 
ASSISTANT     def __init__(self, inner):
ASSISTANT         self._inner = inner
ASSISTANT         self.fetched: list[dict[str, Any]] = []
ASSISTANT 
ASSISTANT     async def school_directory(self, search=None, limit=25):
ASSISTANT         return await self._inner.school_directory(search=search, limit=limit)
ASSISTANT 
ASSISTANT     async def input_catalog(self):
ASSISTANT         return await self._inner.input_catalog()
ASSISTANT 
ASSISTANT     async def fetch_evidence(self, question_id, request):
ASSISTANT         self.fetched.append({"question_id": question_id, "request": request})
ASSISTANT         return await self._inner.fetch_evidence(question_id, request)
ASSISTANT 
ASSISTANT 
ASSISTANT # ---------------------------------------------------------------------------
