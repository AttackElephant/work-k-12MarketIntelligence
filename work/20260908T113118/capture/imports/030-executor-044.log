USER """Stub evidence emitter — the offline substrate for M2/M3 (architecture §11).
USER 
USER It satisfies the data project's emitter CLI contract (POC_HARNESS_HANDOFF.md,
USER "Interface protocol") and serves canned envelopes and canned exit-2 errors from
USER `evals/fixtures/stub_envelopes.json`. Golden runs therefore need no data
USER project, no DuckDB and no network. It is NOT a simulation of the data layer: it
USER computes nothing, and every value it returns was written down in advance.
USER 
USER Argv is byte-identical to the real emitter, so the harness invokes both the same
USER way and only DATA_PROJECT_ROOT changes:
USER 
USER     python evals/stub_emitter.py --question-id VC-POC-01 --request-json '{...}'
USER     python evals/stub_emitter.py --question-id VC-POC-01 --request-file req.json
USER     python evals/stub_emitter.py --input-catalog
USER     python evals/stub_emitter.py --school-directory --school-search Learning --directory-limit 25
USER     python evals/stub_emitter.py --list-questions
USER 
USER Exit codes:
USER 
USER     0   success; response JSON on stdout (or to --output)
USER     2   contract error; error JSON on stderr, carrying a v0.2.0 `error_kind`
USER     3   STUB-ONLY: no fixture case matched. Never returned by the real emitter,
USER         deliberately outside the contract's codes, and loud — a stub that
USER         invented an envelope for an unforeseen request would be a silent lie,
USER         which is the failure mode this whole substrate exists to avoid.
USER 
USER Stub-only controls are environment variables, never flags, so no call site can
USER accidentally depend on an argument the real emitter does not have:
USER 
USER     STUB_EMITTER_FIXTURES   path to an alternative bundle (default: the one above)
USER     STUB_EMITTER_CASE       force one case by name, bypassing request matching
USER """
USER 
USER from __future__ import annotations
USER 
USER import argparse
USER import copy
USER import json
USER import os
USER import sys
USER from datetime import datetime, timezone
USER from pathlib import Path
USER from typing import Any
USER 
USER PROJECT_ROOT = Path(__file__).resolve().parent.parent
USER DEFAULT_BUNDLE = PROJECT_ROOT / "evals" / "fixtures" / "stub_envelopes.json"
USER 
USER CONTRACT_VERSION = "0.3.0"
USER REGISTRY_PATH = PROJECT_ROOT / "contract" / f"poc_question_registry.v{CONTRACT_VERSION}.json"
USER 
USER EXIT_OK = 0
USER EXIT_CONTRACT_ERROR = 2
USER EXIT_NO_FIXTURE = 3
USER 
USER 
USER class NoFixture(Exception):
USER     """No canned case covers this invocation — a stub failure, not a contract error."""
USER 
USER 
USER def load_bundle(path: Path | None = None) -> dict[str, Any]:
USER     bundle_path = path or Path(os.getenv("STUB_EMITTER_FIXTURES", DEFAULT_BUNDLE))
USER     if not bundle_path.is_file():
USER         raise NoFixture(f"fixture bundle not found: {bundle_path}")
USER     bundle = json.loads(bundle_path.read_text("utf-8"))
USER     if bundle.get("contract_version") != CONTRACT_VERSION:
USER         raise NoFixture(
USER             f"fixture bundle is contract {bundle.get('contract_version')!r}, "
USER             f"stub emitter serves {CONTRACT_VERSION!r}"
USER         )
USER     return bundle
USER 
USER 
USER def registry_question_ids() -> set[str]:
USER     registry = json.loads(REGISTRY_PATH.read_text("utf-8"))
USER     return {q["question_id"] for q in registry["questions"]}
USER 
USER 
USER def matches(case: dict[str, Any], question_id: str, request: dict[str, Any]) -> bool:
USER     """Case selection: same question, every `match` key present and equal in the
USER     request, and every `match_absent` key genuinely absent.
USER 
USER     Subset matching (not equality) is what lets one canned case answer the
USER     several equivalent requests a model produces for the same question — an
USER     extra defaulted key must not miss the fixture.
USER     """
USER     if case["question_id"] != question_id:
USER         return False
USER     for key, expected in case.get("match", {}).items():
USER         if key not in request or request[key] != expected:
USER             return False
USER     for key in case.get("match_absent", []):
USER         if key in request:
USER             return False
USER     return True
USER 
USER 
USER def select_case(
USER     bundle: dict[str, Any], question_id: str, request: dict[str, Any]
USER ) -> dict[str, Any]:
USER     forced = os.getenv("STUB_EMITTER_CASE")
USER     if forced:
USER         for case in bundle["cases"]:
USER             if case["name"] == forced:
USER                 return case
USER         raise NoFixture(f"STUB_EMITTER_CASE={forced!r} names no case in the bundle")
USER 
USER     for case in bundle["cases"]:
USER         if matches(case, question_id, request):
USER             return case
USER 
USER     # Mechanical, and the real emitter's own behaviour: an ID outside the
USER     # registry is unknown_question, not a stub failure.
USER     if question_id not in registry_question_ids():
USER         return {
USER             "name": f"{question_id}/unknown-question",
USER             "question_id": question_id,
USER             "error": {
USER                 "contract_version": CONTRACT_VERSION,
USER                 "error_kind": "unknown_question",
USER                 "error": f"{question_id} is not in registry version {CONTRACT_VERSION}.",
USER             },
USER         }
USER 
USER     raise NoFixture(
USER         f"no fixture case matches question {question_id} with request "
USER         f"{json.dumps(request, sort_keys=True)} — add a case to the bundle "
USER         "rather than letting the stub invent an envelope"
USER     )
USER 
USER 
USER def finalise_response(case: dict[str, Any], request: dict[str, Any]) -> dict[str, Any]:
USER     """Return the canned envelope with the two run-scoped fields applied.
USER 
USER     `request` is overwritten with what was actually supplied, because the
USER     contract defines that field as the harness's own request echoed back;
USER     `provenance.generated_utc` is stamped with the wall clock, matching the real
USER     emitter and giving the replay-equality rule (CR-6) something to exclude.
USER     """
USER     envelope = copy.deepcopy(case["response"])
USER     envelope["request"] = request
USER     if isinstance(envelope.get("provenance"), dict):
USER         envelope["provenance"]["generated_utc"] = (
USER             datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
USER         )
USER     return envelope
USER 
USER 
USER def _emit(payload: Any, output: Path | None) -> None:
USER     text = json.dumps(payload, indent=2) + "\n"
USER     if output:
USER         output.write_text(text, "utf-8")
USER     else:
USER         sys.stdout.write(text)
USER 
USER 
USER def _fail_contract(error_envelope: dict[str, Any]) -> int:
USER     sys.stderr.write(json.dumps(error_envelope, indent=2) + "\n")
USER     return EXIT_CONTRACT_ERROR
USER 
USER 
USER def _read_request(args: argparse.Namespace) -> dict[str, Any] | dict[str, Any]:
USER     """Parse --request-json / --request-file, or return the bad_request the real
USER     emitter would return for unparseable or non-object request text."""
USER     if args.request_file:
USER         raw = Path(args.request_file).read_text("utf-8")
USER     elif args.request_json:
USER         raw = args.request_json
USER     else:
USER         raw = "{}"
USER     try:
USER         request = json.loads(raw)
USER     except json.JSONDecodeError as exc:
USER         raise ValueError(f"request is not valid JSON: {exc}") from exc
USER     if not isinstance(request, dict):
USER         raise ValueError("request must be a JSON object.")
USER     return request
USER 
USER 
USER def build_parser() -> argparse.ArgumentParser:
USER     parser = argparse.ArgumentParser(
USER         prog="stub_emitter.py",
USER         description="Stub deterministic evidence emitter (contract v0.2.0).",
USER     )
USER     parser.add_argument("--question-id")
USER     parser.add_argument("--request-json")
USER     parser.add_argument("--request-file")
USER     parser.add_argument("--output")
USER     parser.add_argument("--list-questions", action="store_true")
USER     parser.add_argument("--input-catalog", action="store_true")
USER     parser.add_argument("--school-directory", action="store_true")
USER     parser.add_argument("--school-search")
USER     parser.add_argument("--directory-limit", type=int, default=25)
USER     return parser
USER 
USER 
USER def run_school_directory(bundle: dict[str, Any], search: str | None, limit: int) -> dict:
USER     """Filter the canned directory envelope and return it with updated request metadata."""
USER     directory_envelope = bundle["preflight"]["school_directory"]
USER     records = list(directory_envelope["records"])
USER     if search:
USER         needle = search.casefold()
USER         records = [r for r in records if needle in r["school_name"].casefold()]
USER     if limit is not None and limit >= 0:
USER         records = records[:limit]
USER     result = copy.deepcopy(directory_envelope)
USER     result["records"] = records
USER     result["request"] = {
USER         "school_search": search,
USER         "school_sector": [],
USER         "school_type": [],
USER         "limit": limit,
USER     }
USER     if isinstance(result.get("provenance"), dict):
USER         result["provenance"]["generated_utc"] = (
USER             datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
USER         )
USER     return result
USER 
USER 
USER def main(argv: list[str] | None = None) -> int:
USER     args = build_parser().parse_args(argv)
USER     output = Path(args.output) if args.output else None
USER 
USER     try:
USER         bundle = load_bundle()
USER     except NoFixture as exc:
USER         sys.stderr.write(f"stub emitter: {exc}\n")
USER         return EXIT_NO_FIXTURE
USER 
USER     if args.list_questions:
USER         _emit(sorted(registry_question_ids()), output)
USER         return EXIT_OK
USER 
USER     if args.input_catalog:
USER         _emit(bundle["preflight"]["input_catalog"], output)
USER         return EXIT_OK
USER 
USER     if args.school_directory:
USER         _emit(run_school_directory(bundle, args.school_search, args.directory_limit), output)
USER         return EXIT_OK
USER 
USER     if not args.question_id:
USER         return _fail_contract(
USER             {
USER                 "contract_version": CONTRACT_VERSION,
USER                 "error_kind": "bad_request",
USER                 "error": "--question-id is required unless a preflight interface is requested.",
USER             }
USER         )
USER 
USER     try:
USER         request = _read_request(args)
USER     except (ValueError, OSError) as exc:
USER         return _fail_contract(
USER             {
USER                 "contract_version": CONTRACT_VERSION,
USER                 "error_kind": "bad_request",
USER                 "error": str(exc),
USER             }
USER         )
USER 
USER     try:
USER         case = select_case(bundle, args.question_id, request)
USER     except NoFixture as exc:
USER         sys.stderr.write(f"stub emitter: {exc}\n")
USER         return EXIT_NO_FIXTURE
USER 
USER     if "error" in case:
USER         return _fail_contract(case["error"])
USER 
USER     _emit(finalise_response(case, request), output)
USER     return EXIT_OK
USER 
USER 
USER if __name__ == "__main__":
USER     raise SystemExit(main())
USER ````
