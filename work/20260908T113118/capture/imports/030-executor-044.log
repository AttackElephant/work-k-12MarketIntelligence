USER # ---------------------------------------------------------------------------
USER # Legacy tool-loop ask() — for backward compat with tests and evals
USER # ---------------------------------------------------------------------------
USER 
USER 
USER async def ask(  # type: ignore[return]
USER     agent_or_deps: Any,
USER     deps_or_question: Any = None,
USER     question_or_record_usage: Any = None,
USER     message_history: list[Any] | None = None,
USER     record_usage: bool = True,
USER     *,
USER     # New pipeline-only keyword arguments
USER     intent_override: Any = None,
USER     narration_override: Any = None,
USER     intent_model: object | None = None,
USER     narration_model: object | None = None,
USER ) -> HarnessOutput:
USER     """Run one question through the harness.
USER 
USER     Two call signatures are supported:
USER 
USER     **Legacy (tool-loop) path** — for backward compat with tests and evals:
USER         ask(agent, deps, question, message_history=None, record_usage=True)
USER 
USER     **New pipeline path** — 4-stage pipeline with no `agent` argument:
USER         ask(deps, question, record_usage=True, *, intent_override=None, ...)
USER 
USER     The legacy path is detected by checking whether `agent_or_deps` is an
USER     `Agent` instance (it would be `Deps` in the new path). Both paths share
USER     the same budget model and telemetry.
USER     """
USER     # Detect the call signature
USER     if isinstance(agent_or_deps, Agent):
USER         # Legacy signature: ask(agent, deps, question, ...)
USER         agent: Agent[Deps, AgentOutput] = agent_or_deps
USER         deps: Deps = deps_or_question
USER         question: str = question_or_record_usage
USER         # record_usage is the keyword arg or the positional default
USER         return await _ask_legacy(
USER             agent=agent,
USER             deps=deps,
USER             question=question,
USER             message_history=message_history,
USER             record_usage=record_usage,
USER         )
USER     else:
USER         # New signature: ask(deps, question, record_usage=True, ...)
USER         deps = agent_or_deps
USER         question = deps_or_question
USER         if question_or_record_usage is not None:
USER             # Positional record_usage in the new signature
USER             record_usage = bool(question_or_record_usage)
USER         return await _ask_pipeline(
USER             deps=deps,
USER             question=question,
USER             record_usage=record_usage,
USER             intent_override=intent_override,
USER             narration_override=narration_override,
USER             intent_model=intent_model,
USER             narration_model=narration_model,
USER         )
USER 
USER 
USER async def _ask_legacy(
USER     agent: Agent[Deps, AgentOutput],
USER     deps: Deps,
USER     question: str,
USER     message_history: list[Any] | None = None,
USER     record_usage: bool = True,
USER ) -> HarnessOutput:
USER     """Run one question under the control envelope using the legacy tool loop.
USER 
USER     Budgets are enforced here, in code (ADR-004) — all four:
USER 
USER     | budget | mechanism |
USER     |---|---|
USER     | steps / tool calls | `UsageLimits` |
USER     | wall clock | ONE deadline for the whole call, shared across retry attempts |
USER     | spend | measured between steps from the run's own message history |
USER 
USER     A breach returns a typed `BudgetExceeded` carrying what the run had
USER     established — never a crash, and never a partial answer.
USER 
USER     **The deadline is the whole call, not one attempt** (closes O-9). The
USER     previous shape put `wait_for(LOOP_MAX_SECONDS)` *inside* the retry owner, so
USER     a run that kept hitting 429s could spend `MAX_ATTEMPTS x LOOP_MAX_SECONDS`
USER     plus backoff while still reporting the single-attempt figure. Here the
USER     deadline is computed once and each attempt gets only the time left; an
USER     attempt that starts past it times out immediately.
USER 
USER     `message_history` carries a clarification round-trip: the caller presents
USER     `prompt_to_user`, collects the reply, and re-invokes with the prior history
USER     plus the answer. PydanticAI's message history is the whole session store the
USER     POC needs (architecture §7).
USER     """
USER     deps.user_question = question
USER     limits = UsageLimits(
USER         request_limit=settings.LOOP_MAX_STEPS,
USER         tool_calls_limit=settings.LOOP_MAX_TOOL_CALLS,
USER     )
USER     loop = asyncio.get_running_loop()
USER     deadline = loop.time() + settings.LOOP_MAX_SECONDS
USER     started_at = datetime.now(timezone.utc)
USER     # The run object, captured so telemetry survives a budget trip: an aborted
USER     # run is exactly the one whose cost you need on record (ADR-005).
USER     runs: list[Any] = []
USER 
USER     async def _iterate() -> Any:
USER         async with agent.iter(
USER             question,
USER             deps=deps,
USER             usage_limits=limits,
USER             message_history=message_history,
USER         ) as run:
USER             runs.append(run)
USER             async for _node in run:
USER                 _check_spend(run)
USER             return run.result
USER 
USER     async def _run() -> Any:
USER         remaining = deadline - loop.time()
USER         if remaining <= 0:
USER             raise asyncio.TimeoutError
USER         return await asyncio.wait_for(_iterate(), timeout=remaining)
USER 
USER     def done(output: HarnessOutput) -> HarnessOutput:
USER         """Every exit from this function goes through here, so no branch can
USER         return without handing back its history and its usage record."""
USER         return _finish(output, runs, question, started_at, record_usage, deps)
USER 
USER     try:
USER         result = await acall_with_tenacity(_run)
USER     except UnsupportedSignal as exc:
USER         # The refusal short-circuit: an excluded or unknown question ends the run
USER         # as an answer in its own right, never as an error and never as a retry.
USER         return done(exc.unsupported)
USER     except RepairCapExceeded as exc:
USER         # v0.2.0 classifies four unrepairable failures as `bad_request`. After the
USER         # cap, the honest outcome is a refusal quoting the data layer's own
USER         # message — not another attempt, and not a fabricated answer.
USER         return done(
USER             Unsupported(reason_kind="out_of_scope", reason=exc.message, nearest_supported=None)
USER         )
USER     except SpendExceeded as exc:
USER         detail = f"{exc} (measured cost{'' if exc.complete else ', lower bound'})"
USER         return done(
USER             BudgetExceeded(limit="usd", detail=detail, learned_so_far=_learned(deps))
USER         )
USER     except UsageLimitExceeded as exc:
USER         return done(
USER             BudgetExceeded(
USER                 limit="tool_calls" if "tool" in str(exc).lower() else "steps",
USER                 detail=str(exc),
USER                 learned_so_far=_learned(deps),
USER             )
USER         )
USER     except asyncio.TimeoutError:
USER         return done(
USER             BudgetExceeded(
USER                 limit="seconds",
USER                 detail=f"exceeded {settings.LOOP_MAX_SECONDS}s wall clock for the whole call",
USER                 learned_so_far=_learned(deps),
USER             )
USER         )
USER 
USER     output = result.output
USER     if isinstance(output, AnswerDraft):
USER         assert deps.last_envelope is not None  # guaranteed by the output validator
USER         output = RenderedAnswer.from_envelope(output, deps.last_envelope)
USER     return done(output)
USER 
USER 
USER # ---------------------------------------------------------------------------
USER # New 4-stage pipeline ask()
USER # ---------------------------------------------------------------------------
USER 
USER 
USER async def _ask_pipeline(
USER     deps: Deps,
USER     question: str,
USER     record_usage: bool = True,
USER     *,
USER     intent_override: Any = None,
USER     narration_override: Any = None,
USER     intent_model: object | None = None,
USER     narration_model: object | None = None,
USER ) -> HarnessOutput:
USER     """Run one question through the 4-stage pipeline.
USER 
USER     Stage 1: Intent interpretation (LLM, no tools) → StructuredIntent
USER     Stage 2: Deterministic planning/execution (code) → envelope or typed refusal
USER     Stage 3: Deterministic answer view (code) → AnswerView
USER     Stage 4: Optional narration (LLM, no tools) → NarrationOutput → RenderedAnswer
USER 
USER     Budget handling wraps the whole pipeline: the wall-clock deadline, the spend
USER     budget, and a BudgetExceeded are the same typed outcome as the legacy path.
USER     """
USER     # Deferred imports to avoid circular import at module load time
USER     from harness.answer_view import build_answer_view
USER     from harness.intent import interpret_intent
USER     from harness.narration import _validate_narration, narrate
USER     from harness.planner import plan_and_execute
USER 
USER     deps.user_question = question
USER     loop = asyncio.get_running_loop()
USER     deadline = loop.time() + settings.LOOP_MAX_SECONDS
USER     started_at = datetime.now(timezone.utc)
USER     runs: list[Any] = []  # empty in pipeline mode; telemetry records differently
USER 
USER     def done(output: HarnessOutput) -> HarnessOutput:
USER         return _finish(output, runs, question, started_at, record_usage, deps)
USER 
USER     try:
USER         remaining = deadline - loop.time()
USER         if remaining <= 0:
USER             raise asyncio.TimeoutError
USER 
USER         # ----------------------------------------------------------- #
USER         # Stage 1: Intent interpretation
USER         # ----------------------------------------------------------- #
USER         if intent_override is not None:
USER             intent = intent_override
USER         else:
USER             intent = await asyncio.wait_for(
USER                 interpret_intent(question, model=intent_model),
USER                 timeout=remaining,
USER             )
USER         deps.intent = intent
USER 
USER         # ----------------------------------------------------------- #
USER         # Stage 2: Plan and execute
USER         # ----------------------------------------------------------- #
USER         remaining = deadline - loop.time()
USER         if remaining <= 0:
USER             raise asyncio.TimeoutError
USER 
USER         result = await asyncio.wait_for(
USER             plan_and_execute(intent, deps.client, deps),
USER             timeout=remaining,
USER         )
USER 
USER         if isinstance(result, (ClarificationNeeded, Unsupported)):
USER             return done(result)
USER 
USER         # result is the evidence envelope (dict)
USER         envelope = result
USER 
USER         # ----------------------------------------------------------- #
USER         # Stage 3: Build answer view
USER         # ----------------------------------------------------------- #
USER         view = build_answer_view(envelope)
USER         deps.answer_view = view
USER 
USER         # ----------------------------------------------------------- #
USER         # Stage 4: Narration
USER         # ----------------------------------------------------------- #
USER         remaining = deadline - loop.time()
USER         if remaining <= 0:
USER             raise asyncio.TimeoutError
USER 
USER         if narration_override is not None:
USER             narration = narration_override
USER             _validate_narration(view, deps, narration)
USER         else:
USER             narration = await asyncio.wait_for(
USER                 narrate(view, deps, model=narration_model),
USER                 timeout=remaining,
USER             )
USER 
USER         # Assemble the RenderedAnswer from the view + narration
USER         output: HarnessOutput = RenderedAnswer(
USER             answer=narration.answer,
USER             question_id=view.question_id,
USER             contract_version=view.contract_version,
USER             evidence=view.evidence,
USER             provenance=view.provenance,
USER             confidence=view.confidence,
USER             limitations=view.limitations,
USER             deterministic_signals=view.deterministic_signals,
USER             resolved_request=view.resolved_request,
USER             data_status=view.data_status,
USER             claim_eligibility=view.claim_eligibility,
USER             data_status_note=view.data_status_note,
USER         )
USER         return done(output)
USER 
USER     except SpendExceeded as exc:
USER         detail = f"{exc} (measured cost{'' if exc.complete else ', lower bound'})"
USER         return done(
USER             BudgetExceeded(limit="usd", detail=detail, learned_so_far=_learned(deps))
USER         )
USER     except asyncio.TimeoutError:
USER         return done(
USER             BudgetExceeded(
USER                 limit="seconds",
USER                 detail=f"exceeded {settings.LOOP_MAX_SECONDS}s wall clock for the whole call",
USER                 learned_so_far=_learned(deps),
USER             )
USER         )
USER 
USER 
USER def _check_spend(run: Any) -> None:
USER     """Trip the spend budget BETWEEN steps (closes O-7).
USER 
USER     Between steps is the only place it can be enforced: the cost of a request is
USER     only knowable once its response has arrived, so the budget stops the *next*
USER     request rather than the one that crossed the line. `LOOP_MAX_USD` is
USER     therefore a ceiling on what a run may commit to spending, not a hard cap on
USER     what it has spent — size it accordingly.
USER     """
USER     spent, complete = usage.spend_usd(run.all_messages())
USER     if spent > settings.LOOP_MAX_USD:
USER         logger.warning(
USER             "spend budget exceeded",
USER             extra={
USER                 "subsystem": "api",
USER                 "spent_usd": spent,
USER                 "limit_usd": settings.LOOP_MAX_USD,
USER                 "cost_complete": complete,
USER             },
USER         )
USER         raise SpendExceeded(spent, complete)
USER 
USER 
USER def _finish(
USER     output: HarnessOutput,
USER     runs: list[Any],
USER     question: str,
USER     started_at: datetime,
USER     record_usage: bool,
USER     deps: Deps,
USER ) -> HarnessOutput:
USER     """Hand the message history back to the caller, write the usage records, and
USER     return the outcome unchanged.
USER 
USER     The history goes onto `deps` on EVERY branch, including a budget trip: a
USER     caller that wants to answer a clarification needs it, and a caller
USER     inspecting a failed run needs it more. Telemetry never alters or fails a
USER     result — `record_run` swallows its own errors (ADR-005). `runs` is empty
USER     only when the agent never started (pipeline mode uses no agent).
USER     """
USER     if runs:
USER         deps.last_messages = list(runs[-1].all_messages())
USER         if record_usage:
USER             usage.record_run(
USER                 runs[-1],
USER                 question=question,
USER                 output_branch=type(output).__name__,
USER                 started_at=started_at,
USER             )
USER     return output
USER 
USER 
USER def _learned(deps: Deps) -> str:
USER     """What a budget breach can still tell the caller. Never a partial answer —
USER     a half-rendered figure is worse than none."""
USER     parts = []
