USER class SpendExceeded(Exception):
USER     """Measured spend passed `settings.LOOP_MAX_USD` between steps (O-7).
USER 
USER     Not a `HarnessError`, so the retry owner classifies it as unknown and
USER     re-raises it unchanged — retrying a run that has already spent its budget is
USER     the one thing that must not happen here.
USER     """
USER 
USER     def __init__(self, spent_usd: float, complete: bool) -> None:
USER         super().__init__(f"spent ${spent_usd:.4f} of ${settings.LOOP_MAX_USD:.2f}")
USER         self.spent_usd = spent_usd
USER         self.complete = complete
USER 
USER 
USER def build_anthropic_client() -> AsyncAnthropic:
USER     """The one place a real provider client is constructed (ADR-011, three modes).
USER 
USER     `settings.ANTHROPIC_AUTH_MODE` follows the SDK's own resolution order, so the
USER     harness and the SDK can never disagree about which credential is in play:
USER 
USER     | mode      | source                | how the client is built             |
USER     |---|---|---|
USER     | `api_key` | `ANTHROPIC_API_KEY`   | `AsyncAnthropic(api_key=...)`       |
USER     | `account` | `ANTHROPIC_AUTH_TOKEN`| `AsyncAnthropic(auth_token=...)` + the OAuth beta header |
USER     | `profile` | neither is set        | `AsyncAnthropic()` — the SDK reads an `ant auth login` profile (or WIF env vars) itself |
USER 
USER     **Profile mode passes no credential at all**, on purpose: the SDK resolves
USER     and refreshes the profile, and a harness that copied the token out of it
USER     would hold a stale one the moment it rotated.
USER 
USER     **This is `ant auth login`, not `claude auth login`.** They are different
USER     CLIs with different credential stores; `claude auth login` (Claude Code)
USER     writes to neither the env vars above nor the profile file the SDK's
USER     zero-arg constructor reads (verified against
USER     `anthropic.lib.credentials._chain.default_credentials` in the installed
USER     SDK). A Claude Code / claude.ai session bridges into this client only via
USER     `claude setup-token`, which mints an explicit `ANTHROPIC_AUTH_TOKEN` — i.e.
USER     `account` mode, not `profile` mode. `run.require_credentials()` and
USER     `authcheck.py` both check the SDK's own resolver rather than which CLI
USER     binary happens to be on PATH, for exactly this reason.
USER 
USER     `max_retries=0` in every mode — `harness.retry` is the single retry owner
USER     (ADR-003), and a second layer underneath it would multiply the attempt count
USER     and the wall clock without appearing anywhere in the deadline arithmetic.
USER     """
USER     common: dict[str, Any] = {"max_retries": settings.ANTHROPIC_MAX_RETRIES}
USER     if settings.ANTHROPIC_AUTH_MODE == "api_key":
USER         return AsyncAnthropic(api_key=settings.ANTHROPIC_API_KEY, **common)
USER     if settings.ANTHROPIC_AUTH_MODE == "account":
USER         # An OAuth bearer token on the Messages API needs this beta header; an
USER         # API key does not, and must not carry it. Without it the token is
USER         # rejected as an invalid bearer token, which reads as a bad credential
USER         # rather than as a missing header.
USER         return AsyncAnthropic(
USER             auth_token=settings.ANTHROPIC_AUTH_TOKEN,
USER             default_headers={"anthropic-beta": settings.ANTHROPIC_OAUTH_BETA},
USER             **common,
USER         )
USER     return AsyncAnthropic(**common)
USER 
USER 
USER def build_agent(
USER     model: object | None = None, instructions: str | None = None
USER ) -> Agent[Deps, AgentOutput]:
USER     """Wire provider, model, output union, tools and the rendering gate.
USER 
USER     `model` and `instructions` are the injection points for tests and evals: pass
USER     a pydantic-ai `FunctionModel` to exercise the real tool wiring, the real
USER     subprocess emitter and the real validators with no network and no credentials.
USER     The frozen prompt is the default, so what the eval tier exercises is what
USER     ships (ADR-006).
USER 
USER     This builds the LEGACY tool-loop agent. For the 4-stage pipeline, use the
USER     new `ask(deps, question)` signature (no `agent` argument).
USER     """
USER     model_settings: AnthropicModelSettings | None = None
USER     if model is None:
USER         if settings.MODEL_PROVIDER == "claude_account":
USER             model = build_claude_account_model(
USER                 binary=settings.CLAUDE_CLI,
USER                 model=settings.CLAUDE_ACCOUNT_MODEL,
USER                 timeout_seconds=settings.CLAUDE_CLI_TIMEOUT_SECONDS,
USER             )
USER         else:
USER             client = build_anthropic_client()
USER             model = AnthropicModel(
USER                 settings.ANTHROPIC_MODEL,
USER                 provider=AnthropicProvider(anthropic_client=client),
USER             )
USER             # The whole point of freezing the prompt (ADR-006). Provider-specific,
USER             # so it is set only where a real Anthropic model is wired.
USER             model_settings = AnthropicModelSettings(
USER                 anthropic_cache_instructions=True,
USER                 anthropic_cache_tool_definitions=True,
USER             )
USER 
USER     agent: Agent[Deps, AgentOutput] = Agent(
USER         model,  # type: ignore[arg-type]
USER         deps_type=Deps,
USER         output_type=AgentOutput,  # type: ignore[arg-type]
USER         instructions=instructions if instructions is not None else system_prompt(),
USER         model_settings=model_settings,
USER     )
USER 
USER     register_tools(agent)
USER 
USER     @agent.output_validator
USER     def gate(ctx: RunContext[Deps], output: AgentOutput) -> AgentOutput:
USER         problems = _validate(ctx.deps, output)
USER         if problems:
USER             ctx.deps.output_validation_failures.append(problems)
USER             logger.warning(
USER                 "model output rejected by rendering gate",
USER                 extra={
USER                     "subsystem": "model",
USER                     "output_branch": type(output).__name__,
USER                     "validation_problems": problems,
USER                 },
USER             )
USER             raise ModelRetry(" ".join(problems))
USER         return output
USER 
USER     return agent
USER 
USER 
USER def _validate(deps: Deps, output: AgentOutput) -> list[str]:
USER     """The branch-specific gates. Returns violations; empty means it stands."""
USER     if isinstance(output, AnswerDraft):
USER         if deps.last_envelope is None:
USER             return [
USER                 "You have not fetched any evidence, so there is nothing to answer from. "
USER                 "Call fetch_evidence, or return Unsupported if the contract excludes this."
USER             ]
USER         return rendering.validate_answer(
USER             answer=output.answer,
USER             data_status_note=output.data_status_note,
USER             question_id=output.question_id,
USER             envelope=deps.last_envelope,
USER             user_question=deps.user_question,
USER         )
USER 
USER     if isinstance(output, ClarificationNeeded):
USER         problems = []
USER         if deps.last_envelope is not None:
USER             problems.append(
USER                 "You already have evidence for this question. Answer it rather than asking."
USER             )
USER         if not output.missing:
USER             problems.append("ClarificationNeeded must name at least one missing input.")
USER         # The materials gate (architecture §7): the model can neither skip asking
USER         # for a material input nor burn a turn asking about defaultable trivia.
USER         material = contract.material_inputs_for(output.question_id)
USER         overreach = [m.input for m in output.missing if m.input not in material]
USER         if overreach:
USER             problems.append(
USER                 f"These inputs are not material for {output.question_id} and are defaulted "
USER                 f"by the data layer: {overreach}. Use the defaults and report the values "
USER                 "that were applied, from the envelope's filters."
USER             )
USER         return problems
USER 
USER     if isinstance(output, Unsupported):
USER         # `unanswerable` is a fact returned by the evidence layer for a valid
USER         # request, never a model judgement. The tool converts that error into an
USER         # UnsupportedSignal before output validation, so any instance reaching
USER         # this branch was invented without evidence (the VC-POC-03 live miss).
USER         if output.reason_kind == "unanswerable":
USER             return [
USER                 "Only the evidence layer may determine that a valid request is "
USER                 "unanswerable. Resolve named schools with search_schools and call "
USER                 "fetch_evidence before abstaining."
USER             ]
USER         if not refusal_reason_is_contract_text(output):
USER             return [
USER                 "A contract refusal must use the contract's own wording. Use the exclusion "
USER                 "text from the registry or from the emitter's error, not your own phrasing."
USER             ]
USER     return []
USER 
