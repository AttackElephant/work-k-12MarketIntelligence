ASSISTANT     if excluded_topic:
ASSISTANT         # Try the mapped keyword first, then the raw hint
ASSISTANT         search_terms = []
ASSISTANT         hint_lower = excluded_topic.lower()
ASSISTANT         for key, mapped in _EXCLUSION_KEYWORD_MAP.items():
ASSISTANT             if key in hint_lower:
ASSISTANT                 search_terms.append(mapped.lower())
ASSISTANT         search_terms.append(hint_lower)
ASSISTANT 
ASSISTANT         for term in search_terms:
ASSISTANT             for text in texts:
ASSISTANT                 if term in text.lower():
ASSISTANT                     return text
ASSISTANT 
ASSISTANT     # Fallback: first exclusion text alphabetically
ASSISTANT     return texts[0]
