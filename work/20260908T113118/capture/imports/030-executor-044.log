USER # ---------------------------------------------------------------------------
USER # New 4-stage pipeline ask()
USER # ---------------------------------------------------------------------------
USER 
USER 
USER async def _ask_pipeline(
USER     deps: Deps,
USER     question: str,
USER     record_usage: bool = True,
USER     *,
USER     intent_override: Any = None,
USER     narration_override: Any = None,
USER     intent_model: object | None = None,
USER     narration_model: object | None = None,
USER ) -> HarnessOutput:
USER     """Run one question through the 4-stage pipeline.
USER 
USER     Stage 1: Intent interpretation (LLM, no tools) → StructuredIntent
USER     Stage 2: Deterministic planning/execution (code) → envelope or typed refusal
USER     Stage 3: Deterministic answer view (code) → AnswerView
USER     Stage 4: Optional narration (LLM, no tools) → NarrationOutput → RenderedAnswer
USER 
USER     Budget handling wraps the whole pipeline: the wall-clock deadline, the spend
USER     budget, and a BudgetExceeded are the same typed outcome as the legacy path.
USER     """
USER     # Deferred imports to avoid circular import at module load time
USER     from harness.answer_view import build_answer_view
USER     from harness.intent import interpret_intent
USER     from harness.narration import _validate_narration, narrate
USER     from harness.planner import plan_and_execute
USER 
USER     deps.user_question = question
USER     loop = asyncio.get_running_loop()
USER     deadline = loop.time() + settings.LOOP_MAX_SECONDS
USER     started_at = datetime.now(timezone.utc)
USER     runs: list[Any] = []  # empty in pipeline mode; telemetry records differently
USER 
USER     def done(output: HarnessOutput) -> HarnessOutput:
USER         return _finish(output, runs, question, started_at, record_usage, deps)
USER 
USER     try:
USER         remaining = deadline - loop.time()
USER         if remaining <= 0:
USER             raise asyncio.TimeoutError
USER 
USER         # ----------------------------------------------------------- #
USER         # Stage 1: Intent interpretation
USER         # ----------------------------------------------------------- #
USER         if intent_override is not None:
USER             intent = intent_override
USER         else:
USER             intent = await asyncio.wait_for(
USER                 interpret_intent(question, model=intent_model),
USER                 timeout=remaining,
USER             )
USER         deps.intent = intent
USER 
USER         # ----------------------------------------------------------- #
USER         # Stage 2: Plan and execute
USER         # ----------------------------------------------------------- #
USER         remaining = deadline - loop.time()
USER         if remaining <= 0:
USER             raise asyncio.TimeoutError
USER 
USER         result = await asyncio.wait_for(
USER             plan_and_execute(intent, deps.client, deps),
USER             timeout=remaining,
USER         )
USER 
USER         if isinstance(result, (ClarificationNeeded, Unsupported)):
USER             return done(result)
USER 
USER         # result is the evidence envelope (dict)
USER         envelope = result
USER 
USER         # ----------------------------------------------------------- #
USER         # Stage 3: Build answer view
USER         # ----------------------------------------------------------- #
USER         view = build_answer_view(envelope)
USER         deps.answer_view = view
USER 
USER         # ----------------------------------------------------------- #
USER         # Stage 4: Narration
USER         # ----------------------------------------------------------- #
USER         remaining = deadline - loop.time()
USER         if remaining <= 0:
USER             raise asyncio.TimeoutError
USER 
USER         if narration_override is not None:
USER             narration = narration_override
USER             _validate_narration(view, deps, narration)
USER         else:
USER             narration = await asyncio.wait_for(
USER                 narrate(view, deps, model=narration_model),
USER                 timeout=remaining,
USER             )
USER 
USER         # Assemble the RenderedAnswer from the view + narration
USER         output: HarnessOutput = RenderedAnswer(
USER             answer=narration.answer,
USER             question_id=view.question_id,
USER             contract_version=view.contract_version,
USER             evidence=view.evidence,
USER             provenance=view.provenance,
USER             confidence=view.confidence,
USER             limitations=view.limitations,
USER             deterministic_signals=view.deterministic_signals,
USER             resolved_request=view.resolved_request,
USER             data_status=view.data_status,
USER             claim_eligibility=view.claim_eligibility,
USER             data_status_note=view.data_status_note,
USER         )
USER         return done(output)
USER 
USER     except SpendExceeded as exc:
USER         detail = f"{exc} (measured cost{'' if exc.complete else ', lower bound'})"
USER         return done(
USER             BudgetExceeded(limit="usd", detail=detail, learned_so_far=_learned(deps))
USER         )
USER     except asyncio.TimeoutError:
USER         return done(
USER             BudgetExceeded(
USER                 limit="seconds",
USER                 detail=f"exceeded {settings.LOOP_MAX_SECONDS}s wall clock for the whole call",
USER                 learned_so_far=_learned(deps),
USER             )
USER         )
USER 
USER 
USER def _check_spend(run: Any) -> None:
USER     """Trip the spend budget BETWEEN steps (closes O-7).
USER 
USER     Between steps is the only place it can be enforced: the cost of a request is
USER     only knowable once its response has arrived, so the budget stops the *next*
USER     request rather than the one that crossed the line. `LOOP_MAX_USD` is
USER     therefore a ceiling on what a run may commit to spending, not a hard cap on
USER     what it has spent — size it accordingly.
USER     """
USER     spent, complete = usage.spend_usd(run.all_messages())
USER     if spent > settings.LOOP_MAX_USD:
USER         logger.warning(
USER             "spend budget exceeded",
USER             extra={
USER                 "subsystem": "api",
USER                 "spent_usd": spent,
USER                 "limit_usd": settings.LOOP_MAX_USD,
USER                 "cost_complete": complete,
USER             },
USER         )
USER         raise SpendExceeded(spent, complete)
USER 
USER 
USER def _finish(
USER     output: HarnessOutput,
USER     runs: list[Any],
USER     question: str,
USER     started_at: datetime,
USER     record_usage: bool,
USER     deps: Deps,
USER ) -> HarnessOutput:
USER     """Hand the message history back to the caller, write the usage records, and
USER     return the outcome unchanged.
USER 
USER     The history goes onto `deps` on EVERY branch, including a budget trip: a
USER     caller that wants to answer a clarification needs it, and a caller
USER     inspecting a failed run needs it more. Telemetry never alters or fails a
USER     result — `record_run` swallows its own errors (ADR-005). `runs` is empty
USER     only when the agent never started (pipeline mode uses no agent).
USER     """
USER     if runs:
USER         deps.last_messages = list(runs[-1].all_messages())
USER         if record_usage:
USER             usage.record_run(
USER                 runs[-1],
USER                 question=question,
USER                 output_branch=type(output).__name__,
USER                 started_at=started_at,
USER             )
USER     return output
USER 
USER 
USER def _learned(deps: Deps) -> str:
USER     """What a budget breach can still tell the caller. Never a partial answer —
USER     a half-rendered figure is worse than none."""
USER     parts = []
USER     if deps.resolved_school_ids:
USER         parts.append(f"resolved school IDs {deps.resolved_school_ids}")
USER     if deps.last_envelope is not None:
USER         parts.append(f"fetched evidence for {deps.last_envelope['question_id']}")
USER     if deps.repair_attempts:
USER         parts.append(f"{deps.repair_attempts} request repair attempt(s)")
USER     return "; ".join(parts)
USER 
USER 
USER def build_deps(client: EvidenceClient | None = None) -> Deps:
USER     return Deps(client=client or EvidenceClient.from_settings())
