ASSISTANT from harness.tools import Deps
ASSISTANT 
ASSISTANT PROJECT_ROOT = Path(__file__).resolve().parents[2]
ASSISTANT STUB = PROJECT_ROOT / "evals" / "stub_emitter.py"
ASSISTANT 
ASSISTANT 
ASSISTANT def stub_client(**kwargs) -> EvidenceClient:
ASSISTANT     return EvidenceClient(python=Path(sys.executable), emitter=STUB, **kwargs)
ASSISTANT 
ASSISTANT 
ASSISTANT class _ErrorClient:
ASSISTANT     """A mock EvidenceClient that raises EvidenceError with a given kind."""
ASSISTANT 
ASSISTANT     def __init__(self, error_kind: str, message: str = "test error", reason_code: str | None = None):
ASSISTANT         self.error_kind = error_kind
ASSISTANT         self.message = message
ASSISTANT         self.reason_code = reason_code
ASSISTANT 
ASSISTANT     async def school_directory(self, search: str, limit: int = 25) -> list[dict]:
ASSISTANT         return []
ASSISTANT 
ASSISTANT     async def fetch_evidence(self, question_id: str, request: dict) -> dict:
ASSISTANT         raise EvidenceError(self.error_kind, self.message, self.reason_code)
ASSISTANT 
ASSISTANT 
ASSISTANT class _HappyClient:
ASSISTANT     """A mock EvidenceClient that returns a minimal valid envelope."""
ASSISTANT 
ASSISTANT     def __init__(self, envelope: dict | None = None):
ASSISTANT         self._envelope = envelope or {
ASSISTANT             "question_id": "VC-POC-01",
ASSISTANT             "contract_version": "0.3.0",
ASSISTANT             "evidence": [],
ASSISTANT             "provenance": {},
ASSISTANT             "confidence": {},
ASSISTANT             "limitations": [],
ASSISTANT             "result": {"data": []},
ASSISTANT             "data_status": {"status": "complete"},
ASSISTANT         }
ASSISTANT         self.fetched: list[dict] = []
ASSISTANT 
ASSISTANT     async def school_directory(self, search: str, limit: int = 25) -> list[dict]:
ASSISTANT         return [{"acara_sml_id": 40387, "school_name": search}]
ASSISTANT 
ASSISTANT     async def fetch_evidence(self, question_id: str, request: dict) -> dict:
ASSISTANT         self.fetched.append({"question_id": question_id, "request": request})
ASSISTANT         return self._envelope
ASSISTANT 
ASSISTANT 
ASSISTANT class _DirectoryClient:
ASSISTANT     """A directory-backed mock: per-search records, canned fetch result."""
ASSISTANT 
ASSISTANT     def __init__(
ASSISTANT         self,
ASSISTANT         directory: dict[str, list[dict]] | None = None,
ASSISTANT         envelope: dict | None = None,
ASSISTANT         fetch_error: EvidenceError | None = None,
ASSISTANT     ):
ASSISTANT         self.directory = directory or {}
ASSISTANT         self._envelope = envelope or {
ASSISTANT             "question_id": "VC-POC-01",
ASSISTANT             "contract_version": "0.3.0",
ASSISTANT             "evidence": [],
ASSISTANT             "provenance": {},
ASSISTANT             "confidence": {},
ASSISTANT             "limitations": [],
ASSISTANT             "result": {"data": []},
ASSISTANT             "data_status": {"status": "complete"},
ASSISTANT         }
ASSISTANT         self._fetch_error = fetch_error
ASSISTANT         self.searches: list[str] = []
ASSISTANT         self.fetched: list[dict] = []
ASSISTANT 
ASSISTANT     async def school_directory(self, search: str, limit: int = 25) -> list[dict]:
ASSISTANT         self.searches.append(search)
ASSISTANT         return list(self.directory.get(search, []))
ASSISTANT 
ASSISTANT     async def fetch_evidence(self, question_id: str, request: dict) -> dict:
ASSISTANT         self.fetched.append({"question_id": question_id, "request": request})
ASSISTANT         if self._fetch_error is not None:
ASSISTANT             raise self._fetch_error
ASSISTANT         return self._envelope
ASSISTANT 
