USER harness/intent.py
USER ````
USER """Stage 1 of the 4-stage pipeline: intent interpretation.
USER 
USER The model sees the user's question once and returns a StructuredIntent — a
USER machine-readable map of what the user is asking, which schools they named, and
USER which inputs they supplied or omitted. No tools. One model call. The pipeline
USER branches deterministically from there.
USER 
USER Why one call and no tools? Tools make intent interpretation retryable and
USER self-correcting, but intent extraction is not the kind of task that benefits from
USER exploration: it is a classification over a closed registry. One call is also the
USER only shape the pipeline's budget model supports — the intent budget is separate
USER from the narration budget, and the planner between them costs nothing.
USER 
USER `build_intent_agent()` and `interpret_intent()` are the two injection points
USER tests need: pass a `FunctionModel` as `model` to script a deterministic intent
USER without a network call. The production path calls them with `model=None`, which
USER resolves to the same provider wiring as `build_agent()`.
USER """
USER 
USER from __future__ import annotations
USER 
USER import asyncio
USER import logging
USER from typing import Any
USER 
USER from pydantic import BaseModel, Field
USER from pydantic_ai import Agent
USER from pydantic_ai.exceptions import UsageLimitExceeded
USER from pydantic_ai.usage import UsageLimits
USER 
USER from config import settings
USER from harness.claude_account_cli import build_claude_account_model
USER 
USER logger = logging.getLogger("harness.intent")
USER 
USER 
USER class StructuredIntent(BaseModel):
USER     """What the model extracted from the user's question.
USER 
USER     This is the ONLY interface between Stage 1 (model) and Stage 2 (planner).
USER     The planner is deterministic from here: it never re-reads the question.
USER     """
USER 
USER     question_id: str = Field(
USER         description=(
USER             "The registry question ID the user is asking about, e.g. 'VC-POC-01'. "
USER             "Use 'excluded' when the topic is in the excluded list. "
USER             "Use 'unknown' when no registry question covers it."
USER         )
USER     )
USER     excluded_topic: str | None = Field(
USER         default=None,
USER         description=(
USER             "When question_id == 'excluded': a short keyword hint matching the "
USER             "excluded topic, e.g. 'finance', 'transport', 'sa1'. None otherwise."
USER         ),
USER     )
USER     school_mentions: list[str] = Field(
USER         default_factory=list,
USER         description=(
USER             "Raw school names from the user's question, as the user wrote them. "
USER             "Empty when no school is named."
USER         ),
USER     )
USER     requested_metrics: list[str] = Field(
USER         default_factory=list,
USER         description=(
USER             "Natural-language metric names the user explicitly mentioned. "
USER             "Empty when the user named no metric."
USER         ),
USER     )
USER     filters: dict[str, Any] = Field(
USER         default_factory=dict,
USER         description=(
USER             "Explicit filter values the user provided (e.g. market_definition, "
USER             "distance_km, grades, sa2_codes). Do not invent values the user did not supply."
USER         ),
USER     )
USER     presentation: str = Field(
USER         default="snapshot",
USER         description=(
USER             "How the user wants the answer presented: "
USER             "'trend' (over time), 'comparison' (across schools), "
USER             "'snapshot' (one school, latest), 'area' (SA2-based), "
USER             "'reference' (glossary/lookup)."
USER         ),
USER     )
USER     missing_material_inputs: list[str] = Field(
USER         default_factory=list,
USER         description=(
USER             "Material input names that the question requires but the user did not supply. "
USER             "Only list inputs that are declared material for this question_id. "
USER             "Empty when all material inputs are present."
USER         ),
USER     )
USER 
USER 
USER def _build_intent_model(model: object | None = None) -> object:
USER     """Resolve the model for the intent agent, same logic as build_agent()."""
USER     if model is not None:
USER         return model
USER     if settings.MODEL_PROVIDER == "claude_account":
USER         return build_claude_account_model(
USER             binary=settings.CLAUDE_CLI,
USER             model=settings.CLAUDE_ACCOUNT_MODEL,
USER             timeout_seconds=settings.CLAUDE_CLI_TIMEOUT_SECONDS,
USER         )
USER     from anthropic import AsyncAnthropic
USER     from pydantic_ai.models.anthropic import AnthropicModel
USER     from pydantic_ai.providers.anthropic import AnthropicProvider
USER 
USER     from harness.agent import build_anthropic_client
USER 
USER     client = build_anthropic_client()
USER     return AnthropicModel(
USER         settings.ANTHROPIC_MODEL,
USER         provider=AnthropicProvider(anthropic_client=client),
USER     )
USER 
USER 
USER def _intent_instructions() -> str:
USER     """The frozen intent prompt, read from prompts/intent.md."""
USER     from harness.prompt import SYSTEM_PROMPT_PATH
USER 
USER     intent_path = SYSTEM_PROMPT_PATH.parent / "intent.md"
USER     if not intent_path.exists():
USER         raise FileNotFoundError(
USER             f"{intent_path} is missing. It should have been committed with the pipeline refactor."
USER         )
USER     return intent_path.read_text("utf-8")
USER 
USER 
USER def build_intent_agent(model: object | None = None) -> Agent[None, StructuredIntent]:
USER     """A single-call, no-tool agent that interprets a question into a StructuredIntent.
USER 
USER     `UsageLimits(request_limit=1)` is the contract: intent interpretation is
USER     classification, not exploration, and the pipeline's budget model gives it
USER     exactly one model call.
USER     """
USER     resolved = _build_intent_model(model)
USER     agent: Agent[None, StructuredIntent] = Agent(
USER         resolved,  # type: ignore[arg-type]
USER         output_type=StructuredIntent,
USER         instructions=_intent_instructions(),
USER     )
USER     return agent
USER 
USER 
USER async def interpret_intent(
USER     question: str,
USER     model: object | None = None,
USER ) -> StructuredIntent:
USER     """Run Stage 1: one model call, returns a StructuredIntent.
USER 
USER     Wraps the agent with a wall-clock timeout matching `LOOP_MAX_SECONDS` (the
USER     whole pipeline shares one budget envelope). A `UsageLimitExceeded` means the
USER     agent tried more than one model call, which is a programming error in the
USER     intent agent — surfaced as RuntimeError so the planner can treat it as a
USER     fatal configuration problem rather than a retryable fault.
USER     """
USER     agent = build_intent_agent(model)
USER     limits = UsageLimits(request_limit=1)
USER     try:
USER         result = await asyncio.wait_for(
USER             agent.run(question, usage_limits=limits),
USER             timeout=settings.LOOP_MAX_SECONDS,
USER         )
USER     except UsageLimitExceeded as exc:
USER         raise RuntimeError("intent exceeded 1 model request") from exc
USER     logger.debug(
USER         "intent interpreted",
USER         extra={
USER             "subsystem": "intent",
USER             "question_id": result.output.question_id,
USER             "school_mentions": result.output.school_mentions,
USER         },
USER     )
USER     return result.output
