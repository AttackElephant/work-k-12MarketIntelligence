USER harness/contract.py
USER ````
USER """Read-only access to the PINNED v0.3.0 contract artefacts.
USER 
USER Loaded once, from `contract/` — the vendored, hash-pinned copy (ADR-008), never
USER from the data project at runtime. Everything the harness needs to decide
USER mechanically comes from here: which question IDs exist, which inputs are
USER material (now declared per question by the contract, not guessed), what a
USER refusal is allowed to say, and the registry's own refusal reason codes.
USER 
USER v0.3.0 replaced the v0.2 shims this module used to carry. The registry now
USER declares each question's `input_policy` (required / material / conditional
USER material / defaultable / optional / constraints) and its `metric_list`, so
USER `material_inputs_for` reads the contract instead of `settings.MATERIAL_INPUTS`,
USER and nothing here parses prose for a "when …" condition any more.
USER 
USER Refusal text: `exclusion_texts()` is the exact set of strings the harness may
USER use as a contract refusal reason. A refusal phrased by the harness is a shadow
USER contract that will drift from the data project's own wording (O-5), so the
USER reason is checked against this set rather than trusted. `refusal_for()` exposes
USER the registry-owned reason code the emitter attaches to an excluded question.
USER """
USER 
USER from __future__ import annotations
USER 
USER import json
USER from functools import lru_cache
USER from typing import Any
USER 
USER from config import settings
USER 
USER CONTRACT_DIR = settings.PROJECT_ROOT / "contract"
USER 
USER 
USER @lru_cache(maxsize=1)
USER def registry() -> dict[str, Any]:
USER     path = CONTRACT_DIR / f"poc_question_registry.v{settings.CONTRACT_VERSION}.json"
USER     return json.loads(path.read_text("utf-8"))
USER 
USER 
USER @lru_cache(maxsize=1)
USER def questions() -> dict[str, dict[str, Any]]:
USER     return {q["question_id"]: q for q in registry()["questions"]}
USER 
USER 
USER @lru_cache(maxsize=1)
USER def excluded_questions() -> dict[str, dict[str, Any]]:
USER     """Registry-owned excluded question IDs, keyed by ID. Each entry carries an
USER     `error_kind`, a `reason_code`, and the `message` the emitter returns."""
USER     return {e["question_id"]: e for e in registry().get("excluded_questions", [])}
USER 
USER 
USER def input_policy_for(question_id: str) -> dict[str, Any]:
USER     """The contract's per-question input declaration (from the request schema).
USER 
USER     Keys: `required`, `material`, `conditional_material`, `defaultable`,
USER     `optional`, `constraints`. Empty policy for an unknown question.
USER     """
USER     q = questions().get(question_id, {})
USER     return q.get("input_policy", {})
USER 
USER 
USER def metric_list_for(question_id: str) -> str | None:
USER     """Which catalog list the question's `metrics` field draws from, as the
USER     registry states it (`profile_metrics`, `student_context_metrics`, or None).
USER 
USER     This is the explicit per-question catalogue mapping that replaced the
USER     hand-maintained metric-list guess the v0.2 prompt builder carried."""
USER     return questions().get(question_id, {}).get("metric_list")
USER 
USER 
USER def conditional_material_for(question_id: str) -> dict[str, str]:
USER     """Material inputs that apply only under a stated condition, e.g.
USER     `{"distance_km": "market_definition equals distance"}`."""
USER     return dict(input_policy_for(question_id).get("conditional_material", {}))
USER 
USER 
USER def defaultable_keys() -> frozenset[str]:
USER     """Every request field any question defaults, across the whole registry.
USER 
USER     The emitter fills these when they are omitted and echoes the applied value
USER     in `resolved_request`, so a request that carries one on top of the expected
USER     request is not wrong — this set is what the eval layer tolerates as an extra
USER     key. Derived from the contract, not a hand-kept list."""
USER     keys: set[str] = set()
USER     for q in registry()["questions"]:
USER         for name in q.get("input_policy", {}).get("defaultable", {}):
USER             # A defaultable key may be dotted (peer_filters.sectors); the top
USER             # segment is the request field the harness would see.
USER             keys.add(name.split(".", 1)[0])
USER     return frozenset(keys)
USER 
USER 
USER @lru_cache(maxsize=1)
USER def exclusion_texts() -> frozenset[str]:
USER     """Every string the contract offers as a reason for declining.
USER 
USER     The registry's excluded topics, its deferred fact layers, and the messages
USER     attached to each registry-owned excluded question (VC-POC-TRANSPORT-01, and
USER     the gated VC-POC-14 refusal). The emitter's own error message quotes the
USER     registry message, so a verbatim quote or a containing quote both pass."""
USER     data = registry()
USER     texts: set[str] = set()
USER     texts |= set(data.get("excluded_topics", []))
USER     texts |= set(data.get("scope", {}).get("deferred", []))
USER     texts |= {e["message"] for e in data.get("excluded_questions", []) if e.get("message")}
USER     for q in data["questions"]:
USER         availability = q.get("availability")
USER         if availability and availability.get("message"):
USER             texts.add(availability["message"])
USER     return frozenset(texts)
USER 
USER 
USER def is_registry_question(question_id: str) -> bool:
USER     return question_id in questions()
USER 
USER 
USER def refusal_for(question_id: str) -> dict[str, Any] | None:
USER     """The registry-owned refusal for an excluded or gated question, or None.
USER 
USER     Returns `{error_kind, reason_code, message}` for an excluded question ID and
USER     for a registered-but-disabled question (VC-POC-14's `availability`). The
USER     harness consumes the reason code rather than inventing one (ADR-009)."""
USER     excluded = excluded_questions().get(question_id)
USER     if excluded:
USER         return {
USER             "error_kind": excluded.get("error_kind", "excluded_question"),
USER             "reason_code": excluded.get("reason_code"),
USER             "message": excluded.get("message", ""),
USER         }
USER     availability = questions().get(question_id, {}).get("availability")
USER     if availability and not availability.get("available", True):
USER         return {
USER             "error_kind": availability.get("error_kind", "excluded_question"),
USER             "reason_code": availability.get("reason_code"),
USER             "message": availability.get("message", ""),
USER         }
USER     return None
USER 
USER 
USER def reason_code_for(question_id: str) -> str | None:
USER     """The registry's refusal reason code for a question, if it declares one."""
USER     refusal = refusal_for(question_id)
USER     return refusal["reason_code"] if refusal else None
USER 
USER 
USER def material_inputs_for(question_id: str) -> set[str]:
USER     """The inputs the harness must ask the user for on this question.
USER 
USER     Read from the contract's per-question `input_policy` (v0.3.0): the declared
USER     material inputs plus the keys of any conditional-material inputs, so the
USER     materials gate treats asking about a conditionally-material input (a radius
USER     for a distance market) as legitimate rather than overreach. Whether such an
USER     input is *required* on a given request is the emitter's schema decision,
USER     surfaced as `bad_request` if it is missing when the condition holds.
USER     """
USER     policy = input_policy_for(question_id)
USER     material = set(policy.get("material", []))
USER     material |= set(policy.get("conditional_material", {}))
USER     return material
USER ````
