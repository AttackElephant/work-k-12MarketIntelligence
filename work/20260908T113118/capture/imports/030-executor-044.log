ASSISTANT def _dedupe(values: list[Any]) -> list[Any]:
ASSISTANT     """Order-preserving deduplication."""
ASSISTANT     seen: set[Any] = set()
ASSISTANT     unique: list[Any] = []
ASSISTANT     for value in values:
ASSISTANT         if value not in seen:
ASSISTANT             seen.add(value)
ASSISTANT             unique.append(value)
ASSISTANT     return unique
