USER         "deferred_capability",
USER         "out_of_scope_domain",
USER         "prohibited_crosswalk"
USER       ],
USER       "description": "Registry-owned refusal reason. Required when error_kind == excluded_question."
USER     },
USER     "retryable": {
USER       "type": "boolean",
USER       "description": "Advisory: bad_request/data_unavailable/internal may be retried after repair or recovery; unknown/excluded/unanswerable must not."
USER     }
USER   },
USER   "allOf": [
USER     {
USER       "if": {
USER         "properties": {
USER           "error_kind": {
USER             "const": "excluded_question"
USER           }
USER         },
USER         "required": [
USER           "error_kind"
USER         ]
USER       },
USER       "then": {
USER         "required": [
USER           "reason_code"
USER         ]
USER       }
USER     }
USER   ]
USER }
