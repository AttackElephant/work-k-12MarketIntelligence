{}).get("peer_filters.sectors")
+        if (
+            set(filters) == {"sectors"}
+            and isinstance(default_sectors, list)
+            and isinstance(filters.get("sectors"), list)
+            and sorted(str(s) for s in filters["sectors"])
+            == sorted(str(s) for s in default_sectors)
+        ):
