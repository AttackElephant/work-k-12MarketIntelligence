USER     output = answered()
USER     text = cli.render_text(output)
USER     assert output.question_id in text
USER     assert "Provenance" in text
USER 
USER 
USER def test_a_refusal_renders_the_contract_wording_and_nothing_softer():
USER     refusal = Unsupported(
USER         reason_kind="excluded_by_contract",
