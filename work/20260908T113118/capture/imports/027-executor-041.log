USER #!/usr/bin/env python
USER """Ask the harness a question from a terminal (architecture §3).
USER 
USER     .venv/bin/python run.py "How many students at Alpha College?"
USER     .venv/bin/python run.py --stub "..."     # canned fixtures, no data project
USER     .venv/bin/python run.py --json "..."     # the HarnessOutput, machine-readable
USER 
USER This is the entry point the live eval tier and the M5 demo both need, and the
USER first thing in the repo that lets a human ask a question at all.
USER 
USER What it does, and deliberately does not do:
USER 
USER * It **renders**, it does not compose. Limitations and confidence are printed
USER   from the fields the harness attached out of the envelope (ADR-009). Nothing
USER   here paraphrases them, reorders them, or drops one for brevity — and there is
USER   no `--brief` that would.
USER * It carries **one clarification round-trip** by default (O-3): a
USER   `ClarificationNeeded` is put to the user, the reply is appended to the message
USER   history, and the run continues. A question still ambiguous after the last
USER   round returns the clarification unanswered rather than guessing.
USER * It **configures logging once**, here, as every entry point must.
USER 
USER Exit codes are outcomes, not errors — a refusal and a clarification are correct
USER results of a working system:
USER 
USER     0  answered            3  unsupported (an honest refusal)
USER     2  clarification open  4  a budget tripped        1  operational failure
USER """
USER 
USER from __future__ import annotations
USER 
USER import argparse
USER import asyncio
USER import json
USER import sys
USER from pathlib import Path
USER from typing import Any, Callable
USER 
USER PROJECT_ROOT = Path(__file__).resolve().parent
USER if str(PROJECT_ROOT) not in sys.path:
USER     sys.path.insert(0, str(PROJECT_ROOT))
USER 
USER from config import settings  # noqa: E402
USER from harness.claude_account_cli import (  # noqa: E402
USER     ClaudeAccountCliError,
USER     claude_account_status,
USER )
USER from harness.agent import ask, build_agent  # noqa: E402
USER from harness.errors import HarnessError  # noqa: E402
USER from harness.evidence import EmitterFailure, EvidenceClient  # noqa: E402
USER from harness.logging_config import configure_logging  # noqa: E402
USER from harness.outputs import (  # noqa: E402
USER     BudgetExceeded,
USER     ClarificationNeeded,
USER     HarnessOutput,
USER     RenderedAnswer,
USER     Unsupported,
USER )
USER from harness.tools import Deps  # noqa: E402
USER 
USER STUB_EMITTER = PROJECT_ROOT / "evals" / "stub_emitter.py"
USER 
USER EXIT_ANSWERED = 0
USER EXIT_FAILED = 1
USER EXIT_CLARIFICATION = 2
USER EXIT_UNSUPPORTED = 3
USER EXIT_BUDGET = 4
USER 
USER EXIT_BY_BRANCH = {
USER     RenderedAnswer: EXIT_ANSWERED,
USER     ClarificationNeeded: EXIT_CLARIFICATION,
USER     Unsupported: EXIT_UNSUPPORTED,
USER     BudgetExceeded: EXIT_BUDGET,
USER }
USER 
USER 
USER # ---------------------------------------------------------------------------
USER # rendering
USER # ---------------------------------------------------------------------------
USER 
USER 
USER def _bullets(lines: list[str]) -> str:
USER     return "\n".join(f"  - {line}" for line in lines)
USER 
USER 
USER def render_answer(output: RenderedAnswer) -> str:
USER     """Prose, then the provenance the contract obliges us to show with it.
USER 
USER     Every section here is printed from a preserved field. The four confidence
USER     axes render as the data layer stated them and carry no overall grade — the
USER     harness has no authority to assign one (ADR-009).
USER     """
USER     blocks = [output.answer.strip()]
USER 
USER     if output.data_status_note.strip():
USER         blocks.append(f"Data status:\n  {output.data_status_note.strip()}")
USER 
USER     if output.deterministic_signals:
USER         signals = [
USER             json.dumps(signal, ensure_ascii=False, sort_keys=True)
USER             for signal in output.deterministic_signals
USER         ]
USER         blocks.append("Deterministic signals (disclosed calculations):\n" + _bullets(signals))
USER 
USER     axes = [f"{axis}: {rating}" for axis, rating in sorted(output.confidence.items())]
USER     blocks.append("Confidence (as stated by the data layer):\n" + _bullets(axes))
USER 
USER     if output.limitations:
USER         blocks.append("Limitations:\n" + _bullets(output.limitations))
USER 
USER     provenance = [
USER         f"{key}: {json.dumps(value, ensure_ascii=False, sort_keys=True) if isinstance(value, (dict, list)) else value}"
USER         for key, value in sorted(output.provenance.items())
USER     ]
USER     blocks.append("Provenance:\n" + _bullets(provenance))
USER     blocks.append(f"Question {output.question_id} · contract {output.contract_version}")
USER     return "\n\n".join(blocks)
USER 
USER 
USER def render_clarification(output: ClarificationNeeded) -> str:
USER     missing = [
USER         f"{item.input} — {item.why_material}"
USER         + (f" (allowed: {', '.join(item.allowed_values)})" if item.allowed_values else "")
USER         for item in output.missing
USER     ]
USER     return "\n\n".join(
USER         [
USER             output.prompt_to_user.strip(),
USER             "Needed before this can be answered:\n" + _bullets(missing),
USER             f"Question {output.question_id} (tentative)",
USER         ]
USER     )
USER 
USER 
USER def render_unsupported(output: Unsupported) -> str:
USER     blocks = [f"Not answerable ({output.reason_kind}):", f"  {output.reason}"]
USER     if output.nearest_supported:
USER         blocks.append(f"Closest supported question: {output.nearest_supported}")
USER     return "\n".join(blocks)
USER 
USER 
USER def render_budget(output: BudgetExceeded) -> str:
USER     blocks = [f"Stopped on the {output.limit} budget: {output.detail}"]
USER     if output.learned_so_far:
USER         blocks.append(f"Established before stopping: {output.learned_so_far}")
USER     blocks.append("No partial answer is shown — a half-rendered figure is worse than none.")
USER     return "\n".join(blocks)
USER 
USER 
USER def render_text(output: HarnessOutput) -> str:
USER     if isinstance(output, RenderedAnswer):
USER         return render_answer(output)
USER     if isinstance(output, ClarificationNeeded):
USER         return render_clarification(output)
USER     if isinstance(output, Unsupported):
USER         return render_unsupported(output)
USER     return render_budget(output)
USER 
USER 
USER # ---------------------------------------------------------------------------
USER # the conversation
USER # ---------------------------------------------------------------------------
USER 
USER 
USER async def converse(
USER     agent: Any,
USER     deps: Deps,
USER     question: str,
USER     ask_user: Callable[[ClarificationNeeded], str | None] | None = None,
USER     max_clarifications: int = 1,
USER     record_usage: bool = True,
USER ) -> HarnessOutput:
USER     """Run the question, carrying up to `max_clarifications` round-trips.
USER 
USER     The state between turns is PydanticAI's own message history, handed back on
USER     `deps.last_messages` — no bespoke session store (architecture §7). An
USER     `ask_user` that returns None (or is absent) ends the conversation with the
USER     clarification unanswered, which is the honest outcome for a non-interactive
USER     caller.
USER 
USER     `record_usage=False` is for callers driving a scripted `FunctionModel`
USER     (`demo.py --replay`, `evals/replay.py`): those runs cost nothing, and writing
USER     their zero-price "usage" into the JSONL the cost report reads would put runs
USER     that never happened into the spend record (ADR-005).
USER 
USER     `agent` may be a PydanticAI `Agent` (legacy tool-loop path) or `None`
USER     (pipeline path). When `None`, the new 4-stage pipeline is used.
USER     """
USER     history: list[Any] | None = None
USER     reply = question
USER     for _round in range(max_clarifications + 1):
USER         if agent is not None:
USER             output = await ask(
USER                 agent, deps, reply, message_history=history, record_usage=record_usage
USER             )
USER         else:
USER             # Pipeline path: ask(deps, question, ...) — no agent, no message_history
USER             output = await ask(deps, reply, record_usage=record_usage)
USER         if not isinstance(output, ClarificationNeeded) or ask_user is None:
USER             return output
USER         answer = ask_user(output)
USER         if answer is None or not answer.strip():
USER             return output
USER         history = deps.last_messages
USER         reply = answer
USER     return output
USER 
USER 
USER def _prompt_on_terminal(output: ClarificationNeeded) -> str | None:
USER     print(render_clarification(output))
USER     print()
USER     try:
USER         return input("> ")
USER     except EOFError:
USER         return None
USER 
USER 
USER def build_client(use_stub: bool) -> EvidenceClient:
USER     if use_stub:
USER         # The same emitter the golden suite runs against: canned envelopes, no
USER         # data project, no database. Exercises the whole path except the data.
USER         return EvidenceClient(python=Path(sys.executable), emitter=STUB_EMITTER)
USER     if not settings.DATA_PROJECT_ROOT or not settings.EVIDENCE_EMITTER.exists():
USER         raise SystemExit(
USER             "No evidence emitter found. Set DATA_PROJECT_ROOT (env or .env) to the "
USER             f"data project — expected {settings.EVIDENCE_EMITTER} — or pass --stub to "
USER             "run against the canned fixture bundle."
USER         )
USER     return EvidenceClient.from_settings()
USER 
USER 
USER def require_credentials() -> None:
USER     """Fail with a sentence, not a stack trace, when nothing is configured.
USER 
USER     The SDK's own failure for this is a `TypeError` about header resolution,
USER     raised deep inside the first request — after the emitter has been located
USER     and the agent built. For the first thing a person runs in this repo, that is
USER     the wrong first impression of an otherwise working system.
USER 
USER     **An unset env var does not mean there is no credential** — with neither
USER     set, the SDK falls back to a profile written by `ant auth login`. But
USER     checking that by asking "is the `ant` CLI on PATH" was wrong: it treated
USER     `claude` (Claude Code) as interchangeable with `ant` (the Anthropic SDK's
USER     own login CLI), and `claude auth login` populates neither the env vars nor
USER     the profile file the SDK reads — confirmed by reading
USER     `anthropic.default_credentials()` in the installed SDK. A `claude
USER     auth login` session bridges into this SDK only via `claude setup-token`,
USER     which mints an explicit `ANTHROPIC_AUTH_TOKEN`.
USER 
USER     So the check calls the SDK's own resolver — ground truth, not a guess from
USER     which binary happens to be installed.
USER     """
USER     if settings.MODEL_PROVIDER == "claude_account":
USER         ok, detail = claude_account_status(settings.CLAUDE_CLI)
USER         if ok:
USER             return
USER         raise SystemExit(
USER             "No usable Claude subscription-account token is available. Source the "
USER             "machine-level environment containing CLAUDE_CODE_OAUTH_TOKEN, then "
USER             f"retry. Diagnostic: {detail}"
USER         )
USER 
USER     if settings.ANTHROPIC_API_KEY or settings.ANTHROPIC_AUTH_TOKEN:
USER         return
USER     import anthropic
USER 
USER     if anthropic.default_credentials(base_url="https://api.anthropic.com") is not None:
USER         return  # a real SDK-readable profile exists (ant auth login, or WIF env vars)
USER     raise SystemExit(
USER         "No Anthropic credential found. A `claude auth login` (Claude Code) session, "
USER         "if you have one, does not count — it is not something this SDK can read. "
USER         "Run `claude setup-token` and put the token it prints in .env as "
USER         "ANTHROPIC_AUTH_TOKEN, or set ANTHROPIC_API_KEY (metered API), or "
USER         "`ant auth login` for an SDK-native profile. "
USER         "`.venv/bin/python authcheck.py` says which one is in play and whether the "
USER         "provider accepts it."
USER     )
USER 
USER 
USER def build_parser() -> argparse.ArgumentParser:
USER     parser = argparse.ArgumentParser(
USER         prog="run.py",
USER         description="Ask the K-12 market intelligence harness one question.",
USER     )
USER     parser.add_argument("question", help="the question, in plain English")
USER     parser.add_argument(
USER         "--stub",
USER         action="store_true",
USER         help="use evals/stub_emitter.py instead of the data project's emitter",
USER     )
USER     parser.add_argument(
USER         "--json", action="store_true", help="print the output branch as JSON"
USER     )
USER     parser.add_argument(
USER         "--max-clarifications",
USER         type=int,
USER         default=1,
USER         help="clarification round-trips before giving up (default 1, per O-3)",
USER     )
USER     parser.add_argument(
USER         "--no-interactive",
USER         action="store_true",
USER         help="never prompt; report a clarification and exit 2",
USER     )
USER     return parser
USER 
USER 
USER def main(argv: list[str] | None = None) -> int:
USER     configure_logging()  # once per entry point, before anything else logs
USER     args = build_parser().parse_args(argv)
USER 
USER     require_credentials()
USER     client = build_client(args.stub)
USER     agent = build_agent()
USER     deps = Deps(client=client)
USER     ask_user = None if args.no_interactive else _prompt_on_terminal
USER 
USER     try:
USER         output = asyncio.run(
USER             converse(
USER                 agent,
USER                 deps,
USER                 args.question,
USER                 ask_user=ask_user,
USER                 max_clarifications=args.max_clarifications,
USER             )
USER         )
USER     except (HarnessError, EmitterFailure, ClaudeAccountCliError) as exc:
USER         # Classified and already logged at the retry boundary; the caller gets
USER         # the operational failure, never a fabricated answer.
USER         print(f"{type(exc).__name__}: {exc}", file=sys.stderr)
USER         return EXIT_FAILED
USER 
USER     if args.json:
USER         print(output.model_dump_json(indent=2))
USER     else:
USER         print(render_text(output))
USER     return EXIT_BY_BRANCH[type(output)]
USER 
USER 
USER if __name__ == "__main__":
USER     raise SystemExit(main())
USER ````
