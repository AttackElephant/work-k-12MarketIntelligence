USER ````
USER 
USER tests/unit/test_run_cli.py
USER ````
USER """M4 — the CLI entry point renders faithfully and carries a clarification.
USER 
USER `run.py` is where a human meets this system, so the two things graded here are
USER the two things a demo could quietly get wrong:
USER 
USER 1. **It renders what the harness preserved.** Every limitation string appears in
USER    the output, verbatim; the confidence axes appear as the data layer stated
USER    them, with no overall grade added; provenance is shown. A renderer that
USER    summarised any of these would pass the agent's own gates and break the
USER    contract at the last inch (ADR-009).
USER 2. **It carries one clarification round-trip on real message history** — and
USER    stops rather than guessing when there is no answer to be had (O-3).
USER 
USER The model is scripted throughout; nothing here needs a network or a credential.
USER """
USER 
USER from __future__ import annotations
USER 
USER import asyncio
USER import json
USER import sys
USER from pathlib import Path
USER from typing import Any
USER 
USER import pytest
USER from pydantic_ai.messages import ModelMessage, ModelResponse, ToolCallPart
USER from pydantic_ai.models.function import AgentInfo, FunctionModel
USER 
USER import run as cli
USER from evals import replay as replay_mod
USER from evals.schema import load_cases, load_reference_solutions
USER from harness.agent import ask, build_agent
USER from harness.evidence import EvidenceClient
USER from harness.outputs import BudgetExceeded, ClarificationNeeded, MissingInput, Unsupported
USER from harness.tools import Deps
USER 
USER PROJECT_ROOT = Path(__file__).resolve().parents[2]
USER STUB = PROJECT_ROOT / "evals" / "stub_emitter.py"
USER 
USER CASES = {c.case_id: c for c in load_cases()}
USER REFERENCES = load_reference_solutions()
USER 
USER 
USER def stub_client() -> EvidenceClient:
USER     return EvidenceClient(python=Path(sys.executable), emitter=STUB)
USER 
USER 
USER def answered() -> Any:
USER     """A real RenderedAnswer, produced by replaying a golden case through the
USER     production path — not a hand-built object that might not be reachable."""
USER     case = CASES["answer/VC-POC-01"]
USER     agent = build_agent(model=replay_mod.scripted_model(REFERENCES[case.case_id]))
USER     deps = Deps(client=stub_client())
USER     return asyncio.run(ask(agent, deps, case.phrasings[0], record_usage=False))
USER 
USER 
USER # --------------------------------------------------------------------------
USER # rendering
USER # --------------------------------------------------------------------------
USER 
USER 
USER def test_every_limitation_is_rendered_verbatim():
USER     output = answered()
USER     assert output.limitations, "the fixture should carry limitations to preserve"
USER     text = cli.render_text(output)
USER     for limitation in output.limitations:
USER         assert limitation in text
USER 
USER 
USER def test_confidence_renders_as_the_axes_the_data_layer_stated():
USER     output = answered()
USER     text = cli.render_text(output)
USER     for axis, rating in output.confidence.items():
USER         assert f"{axis}: {rating}" in text
USER     # Exactly the axes the envelope carried — nothing dropped, and nothing added.
USER     # ADR-009: the harness has no authority to assign an overall grade, so a
USER     # renderer that invented one would show up here as an extra entry.
USER     section = text.split("Confidence (as stated by the data layer):")[1].split("\n\n")[0]
USER     rendered = {line.strip("- ").split(":")[0] for line in section.strip().splitlines()}
USER     assert rendered == set(output.confidence)
USER 
