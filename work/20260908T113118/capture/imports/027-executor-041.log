USER         # Second call: return the real tool
USER         if calls[0] < 2:
USER             return ModelResponse(parts=[ToolCallPart("not_an_output_tool", {})])
USER         return ModelResponse(parts=[ToolCallPart(INTENT_TOOL, {
USER             "question_id": "VC-POC-01",
USER             "school_mentions": [],
USER         })])
USER 
USER     return FunctionModel(fn)
USER 
