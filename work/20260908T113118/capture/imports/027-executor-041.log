USER     clarification = ClarificationNeeded(
USER         question_id="VC-POC-08",
USER         missing=[
USER             MissingInput(
USER                 input="distance_km",
USER                 why_material='"Near" is not a distance.',
USER                 allowed_values=[],
USER             )
USER         ],
USER         prompt_to_user="What radius should I use?",
USER     )
USER     text = cli.render_text(clarification)
USER     assert "distance_km" in text
USER     assert '"Near" is not a distance.' in text
USER     assert "What radius should I use?" in text
