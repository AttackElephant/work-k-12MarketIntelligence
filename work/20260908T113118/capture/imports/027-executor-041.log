USER """Stage 2 — deterministic planner tests.
USER 
USER Proves that `plan_and_execute()` branches purely on the intent and the contract:
USER no model calls, no guessing. Every branch is a closed function of the
USER StructuredIntent and the evidence client's response.
USER 
USER Two kinds of evidence client:
USER - stub_client() — the real stub emitter (tests the happy path with real fixture data)
USER - _ErrorClient / _HappyClient — simple mock clients for error branch tests
USER """
USER 
USER from __future__ import annotations
USER 
USER import asyncio
USER import sys
USER from pathlib import Path
USER from typing import Any
USER 
USER import pytest
USER 
USER from harness import contract
USER from harness.errors import TerminalError
USER from harness.evidence import EvidenceError, EvidenceClient
USER from harness.intent import StructuredIntent
USER from harness.outputs import ClarificationNeeded, Unsupported
USER from harness.planner import _find_exclusion_text, plan_and_execute
USER from harness.tools import Deps
USER 
USER PROJECT_ROOT = Path(__file__).resolve().parents[2]
USER STUB = PROJECT_ROOT / "evals" / "stub_emitter.py"
USER 
USER 
USER def stub_client(**kwargs) -> EvidenceClient:
USER     return EvidenceClient(python=Path(sys.executable), emitter=STUB, **kwargs)
USER 
USER 
USER class _ErrorClient:
USER     """A mock EvidenceClient that raises EvidenceError with a given kind."""
USER 
USER     def __init__(self, error_kind: str, message: str = "test error", reason_code: str | None = None):
USER         self.error_kind = error_kind
USER         self.message = message
USER         self.reason_code = reason_code
USER 
USER     async def school_directory(self, search: str, limit: int = 25) -> list[dict]:
USER         return []
USER 
USER     async def fetch_evidence(self, question_id: str, request: dict) -> dict:
USER         raise EvidenceError(self.error_kind, self.message, self.reason_code)
USER 
USER 
USER class _HappyClient:
USER     """A mock EvidenceClient that returns a minimal valid envelope."""
USER 
USER     def __init__(self, envelope: dict | None = None):
USER         self._envelope = envelope or {
USER             "question_id": "VC-POC-01",
USER             "contract_version": "0.3.0",
USER             "evidence": [],
USER             "provenance": {},
USER             "confidence": {},
USER             "limitations": [],
USER             "result": {"data": []},
USER             "data_status": {"status": "complete"},
USER         }
USER         self.fetched: list[dict] = []
USER 
USER     async def school_directory(self, search: str, limit: int = 25) -> list[dict]:
USER         return [{"acara_sml_id": 40387, "school_name": search}]
USER 
USER     async def fetch_evidence(self, question_id: str, request: dict) -> dict:
USER         self.fetched.append({"question_id": question_id, "request": request})
USER         return self._envelope
USER 
USER 
USER def run_planner(intent: StructuredIntent, client=None) -> Any:
USER     deps = Deps(client=client or stub_client())
USER     return asyncio.run(plan_and_execute(intent, client or stub_client(), deps)), deps
USER 
USER 
USER # ---------------------------------------------------------------------------
USER # 1. Excluded topics
USER # ---------------------------------------------------------------------------
USER 
USER 
USER def test_excluded_topic_returns_unsupported():
USER     """question_id='excluded' → Unsupported(excluded_by_contract)."""
USER     intent = StructuredIntent(question_id="excluded", excluded_topic="transport")
USER     client = stub_client()
USER     deps = Deps(client=client)
USER     result = asyncio.run(plan_and_execute(intent, client, deps))
USER     assert isinstance(result, Unsupported)
USER     assert result.reason_kind == "excluded_by_contract"
