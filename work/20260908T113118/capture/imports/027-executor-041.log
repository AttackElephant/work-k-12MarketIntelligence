USER # --------------------------------------------------------------------------
USER # the clarification round-trip
USER # --------------------------------------------------------------------------
USER 
USER 
USER def _clarify_then_answer() -> FunctionModel:
USER     """Ask for a radius on the first turn; on the second — with the user's reply
USER     in the history — fetch and answer."""
USER 
USER     def script(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:
USER         turns = sum(1 for m in messages if isinstance(m, ModelResponse))
USER         if turns == 0:
USER             return ModelResponse(
USER                 parts=[
USER                     ToolCallPart(
USER                         "final_result_ClarificationNeeded",
USER                         {
USER                             "question_id": "VC-POC-08",
USER                             "missing": [
USER                                 {
USER                                     "input": "distance_km",
USER                                     "why_material": '"Near" is not a distance.',
USER                                     "allowed_values": [],
USER                                 }
USER                             ],
USER                             "prompt_to_user": "What radius should I use?",
USER                         },
USER                     )
USER                 ]
USER             )
USER         if turns == 1:
USER             return ModelResponse(
USER                 parts=[
USER                     ToolCallPart(
USER                         "fetch_evidence",
USER                         {
USER                             "question_id": "VC-POC-08",
USER                             "request": {"acara_sml_id": 40387, "distance_km": 10},
USER                         },
USER                     )
USER                 ]
USER             )
USER         return ModelResponse(
USER             parts=[
USER                 ToolCallPart(
USER                     "final_result_AnswerDraft",
USER                     {
USER                         "question_id": "VC-POC-08",
USER                         "answer": "Within 10 km the returned cohort is listed above.",
USER                         "data_status_note": "",
USER                     },
USER                 )
USER             ]
USER         )
USER 
USER     return FunctionModel(script)
USER 
USER 
USER def test_one_clarification_round_trip_answers_the_question():
USER     agent = build_agent(model=_clarify_then_answer())
USER     deps = Deps(client=stub_client())
USER     replies = iter(["10 km"])
USER     output = asyncio.run(
USER         cli.converse(
USER             agent,
USER             deps,
USER             "Which schools are near Alpha College?",
USER             ask_user=lambda _clarification: next(replies),
USER             max_clarifications=1,
USER         )
USER     )
USER     assert output.kind == "answer"
USER     assert output.question_id == "VC-POC-08"
USER 
