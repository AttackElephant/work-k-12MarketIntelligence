USER harness/planner.py
USER ````
USER """Stage 2 of the 4-stage pipeline: deterministic planning and execution.
USER 
USER `plan_and_execute()` takes a StructuredIntent and returns either:
USER - a dict (the evidence envelope) — the happy path
USER - ClarificationNeeded — a material input is missing
USER - Unsupported — an exclusion or an unknown question
USER 
USER No model calls. Every branch is a pure function of the intent and the contract.
USER The evidence call itself is the only I/O, and its error handling mirrors the
USER tool layer's `_branch_on_error_kind()` exactly: the same closed set of outcomes,
USER the same reason codes, the same contract text.
USER 
USER Why reproduce `_branch_on_error_kind` here rather than calling it? Because the
USER tool layer raises `ModelRetry`, `UnsupportedSignal`, and `RepairCapExceeded` —
USER exceptions designed for PydanticAI's agent loop. The pipeline has no loop, so
USER those signals have no handler; they would escape to the caller as unclassified
USER RuntimeErrors. The planner translates the same error semantics into the pipeline's
USER typed return values instead.
USER """
USER 
USER from __future__ import annotations
USER 
USER import logging
USER from typing import Any
USER 
USER from harness import contract
USER from harness.errors import TerminalError
USER from harness.evidence import EvidenceClient, EvidenceError
USER from harness.intent import StructuredIntent
USER from harness.outputs import ClarificationNeeded, MissingInput, Unsupported
USER from harness.tools import Deps, ToolInvocation, request_scope_problem
USER 
USER logger = logging.getLogger("harness.planner")
USER 
USER # Keyword hints the intent model may use for excluded topics, mapped to a search
USER # term that appears in the corresponding contract exclusion text. The mapping is
USER # fuzzy: the planner searches for any exclusion text that contains the keyword.
USER _EXCLUSION_KEYWORD_MAP: dict[str, str] = {
USER     "finance": "fees",
USER     "fees": "fees",
USER     "cricos": "CRICOS",
USER     "operations": "capacity",
USER     "capacity": "capacity",
USER     "transport": "public transport",
USER     "crosswalk": "School_No",
USER     "sa1": "SA1 fact",
USER     "mesh_block": "Mesh Block",
USER     "sa2": "SA2",
USER     "gtfs": "GTFS",
USER }
USER 
USER 
USER def _find_exclusion_text(excluded_topic: str | None) -> str:
USER     """Find the contract exclusion text matching a topic hint.
USER 
USER     Searches the exclusion texts for a case-insensitive substring match on the
USER     mapped keyword, then on the raw hint. Falls back to the first text in sorted
USER     order so there is always a contract-text reason (never harness prose).
USER     """
USER     texts = sorted(contract.exclusion_texts())
USER     if not texts:
USER         return ""
USER 
USER     if excluded_topic:
USER         # Try the mapped keyword first, then the raw hint
USER         search_terms = []
USER         hint_lower = excluded_topic.lower()
USER         for key, mapped in _EXCLUSION_KEYWORD_MAP.items():
USER             if key in hint_lower:
USER                 search_terms.append(mapped.lower())
USER         search_terms.append(hint_lower)
USER 
USER         for term in search_terms:
USER             for text in texts:
USER                 if term in text.lower():
USER                     return text
USER 
USER     # Fallback: first exclusion text alphabetically
USER     return texts[0]
USER 
USER 
USER async def plan_and_execute(
USER     intent: StructuredIntent,
USER     client: EvidenceClient,
USER     deps: Deps,
USER ) -> dict[str, Any] | ClarificationNeeded | Unsupported:
USER     """Deterministic Stage 2: intent → evidence envelope or typed refusal.
USER 
USER     Returns:
USER         dict — the evidence envelope (happy path)
USER         ClarificationNeeded — a material input is missing
USER         Unsupported — an exclusion, unknown question, or unanswerable request
USER     May raise:
USER         TerminalError — an operational stop (data_unavailable, internal)
USER     """
USER     question_id = intent.question_id
USER 
USER     # ------------------------------------------------------------------ #
USER     # 1. Excluded topic (intent model classified it as out of scope)
USER     # ------------------------------------------------------------------ #
USER     if question_id == "excluded":
USER         exclusion_text = _find_exclusion_text(intent.excluded_topic)
USER         logger.debug(
USER             "intent classified as excluded topic",
USER             extra={"subsystem": "planner", "excluded_topic": intent.excluded_topic},
USER         )
USER         return Unsupported(
USER             reason_kind="excluded_by_contract",
USER             reason=exclusion_text,
USER         )
USER 
USER     # ------------------------------------------------------------------ #
USER     # 2. Registry-owned excluded question (e.g. VC-POC-TRANSPORT-01)
USER     # ------------------------------------------------------------------ #
USER     excluded = contract.excluded_questions().get(question_id)
USER     if excluded:
USER         reason_code = excluded.get("reason_code")
USER         reason_kind = (
USER             "not_yet_validated"
USER             if reason_code == "not_yet_validated"
USER             else "excluded_by_contract"
USER         )
USER         return Unsupported(
USER             reason_kind=reason_kind,
USER             reason=excluded.get("message", ""),
USER             reason_code=reason_code,
USER         )
USER 
USER     # ------------------------------------------------------------------ #
USER     # 3. Registered but gated question (e.g. VC-POC-14 via availability)
USER     # ------------------------------------------------------------------ #
USER     if question_id in contract.questions():
USER         refusal = contract.refusal_for(question_id)
USER         if refusal is not None:
USER             reason_code = refusal.get("reason_code")
USER             reason_kind = (
USER                 "not_yet_validated"
USER                 if reason_code == "not_yet_validated"
USER                 else "excluded_by_contract"
USER             )
USER             return Unsupported(
USER                 reason_kind=reason_kind,
USER                 reason=refusal.get("message", ""),
USER                 reason_code=reason_code,
USER             )
USER 
USER     # ------------------------------------------------------------------ #
USER     # 4. Not in registry at all (unknown question)
USER     # ------------------------------------------------------------------ #
USER     if question_id not in contract.questions() and question_id not in contract.excluded_questions():
USER         if question_id == "unknown":
USER             return Unsupported(
USER                 reason_kind="not_in_registry",
USER                 reason="The question does not map to any approved registry question.",
USER             )
USER         return Unsupported(
USER             reason_kind="not_in_registry",
USER             reason=f"{question_id} is not a registry question.",
USER         )
USER 
USER     # ------------------------------------------------------------------ #
USER     # 5. Material inputs missing → ask for clarification
USER     # ------------------------------------------------------------------ #
USER     if intent.missing_material_inputs:
USER         material = contract.material_inputs_for(question_id)
USER         actually_missing = [inp for inp in intent.missing_material_inputs if inp in material]
USER         if actually_missing:
USER             missing_items = [
USER                 MissingInput(
USER                     input=inp,
USER                     why_material=_material_why(question_id, inp),
USER                     allowed_values=[],
USER                 )
USER                 for inp in actually_missing
USER             ]
USER             prompt_to_user = (
USER                 f"To answer this question I need "
USER                 + ", ".join(f"the {inp}" for inp in actually_missing)
USER                 + ". Could you provide "
USER                 + ("it" if len(actually_missing) == 1 else "them")
USER                 + "?"
USER             )
USER             return ClarificationNeeded(
USER                 question_id=question_id,
USER                 missing=missing_items,
USER                 prompt_to_user=prompt_to_user,
USER             )
USER 
USER     # ------------------------------------------------------------------ #
USER     # 6. Resolve schools
USER     # ------------------------------------------------------------------ #
USER     for school_name in intent.school_mentions:
USER         try:
USER             records = await client.school_directory(search=school_name, limit=25)
USER         except Exception as exc:
USER             deps.tool_calls.append(
USER                 ToolInvocation(
USER                     "search_schools",
USER                     {"search": school_name, "limit": 25},
USER                     error_kind=type(exc).__name__,
USER                 )
USER             )
USER             raise
USER 
USER         deps.searched = True
USER         resolved = [r["acara_sml_id"] for r in records if "acara_sml_id" in r]
USER         if resolved:
USER             # Take the first match: the planner trusts the intent model to have
USER             # named an unambiguous school. Ambiguity handling (ClarificationNeeded)
USER             # is the live-model path; the planner uses best-effort resolution.
USER             best = resolved[0]
USER             if best not in deps.resolved_school_ids:
USER                 deps.resolved_school_ids.append(best)
USER         deps.tool_calls.append(
USER             ToolInvocation(
USER                 "search_schools",
USER                 {"search": school_name, "limit": 25},
USER                 records,
USER             )
USER         )
USER 
USER     # ------------------------------------------------------------------ #
USER     # 7. Build the evidence request
USER     # ------------------------------------------------------------------ #
USER     request: dict[str, Any] = dict(intent.filters)
USER 
USER     # Attach resolved school IDs using the right field name for this question
USER     if deps.resolved_school_ids:
USER         q_entry = contract.questions()[question_id]
USER         required = q_entry.get("input_policy", {}).get("required", [])
USER         if "acara_sml_ids" in required:
USER             request.setdefault("acara_sml_ids", deps.resolved_school_ids)
USER         elif "acara_sml_id" in required and deps.resolved_school_ids:
USER             request.setdefault("acara_sml_id", deps.resolved_school_ids[0])
USER 
USER     # Map requested metrics to the request (NL labels are passed through for
USER     # now — the real emitter validates them; bad values return bad_request)
USER     if intent.requested_metrics:
USER         request.setdefault("metrics", intent.requested_metrics)
USER 
USER     # Apply metric scope check for VC-POC-01 and VC-POC-04
USER     scope_problem = request_scope_problem(deps.user_question, question_id, request)
USER     if scope_problem and "metrics" in request and isinstance(request["metrics"], list):
USER         # Drop non-teaching and headcount expansions the user didn't ask for
USER         cleaned = [
USER             m for m in request["metrics"]
USER             if not (
USER                 str(m).endswith("_headcount") or str(m).startswith("non_teaching_")
USER             )
USER         ]
USER         request["metrics"] = cleaned or request["metrics"]
USER 
USER     # ------------------------------------------------------------------ #
USER     # 8. Fetch evidence
USER     # ------------------------------------------------------------------ #
USER     arguments = {"question_id": question_id, "request": request}
USER     try:
USER         envelope = await client.fetch_evidence(question_id, request)
USER     except EvidenceError as exc:
USER         deps.tool_calls.append(
USER             ToolInvocation("fetch_evidence", arguments, error_kind=exc.error_kind)
USER         )
USER         return _branch_evidence_error(question_id, exc)
USER     except Exception:
USER         deps.tool_calls.append(
USER             ToolInvocation("fetch_evidence", arguments, error_kind="operational")
USER         )
USER         raise
USER 
USER     deps.tool_calls.append(ToolInvocation("fetch_evidence", arguments, envelope))
USER     deps.last_envelope = envelope
USER     logger.debug(
USER         "evidence fetched by planner",
USER         extra={"subsystem": "planner", "question_id": question_id},
USER     )
USER     return envelope
USER 
USER 
USER def _material_why(question_id: str, input_name: str) -> str:
USER     """A one-sentence human-readable explanation of why an input is material."""
USER     explanations: dict[str, str] = {
USER         "market_definition": "The market boundary changes which schools are compared.",
USER         "distance_km": "\"Near\" is not a distance — the radius determines which schools qualify.",
USER         "grades": "The grade selection determines which year levels are included.",
USER         "peer_filters": "The peer group definition determines which schools are compared.",
USER         "segment_filters": "The segment definition determines which schools are included.",
USER         "sa2_codes": "The SA2 area determines which geographic area is analysed.",
USER         "zone_entity_code": "The zone entity code identifies the government zone to look up.",
USER     }
USER     return explanations.get(
USER         input_name,
USER         f"{input_name} is required by the data layer and cannot be defaulted for this question.",
USER     )
USER 
USER 
USER def _branch_evidence_error(
USER     question_id: str,
USER     exc: EvidenceError,
USER ) -> Unsupported:
USER     """Translate an EvidenceError into an Unsupported outcome.
USER 
USER     This mirrors `_branch_on_error_kind()` in tools.py but returns typed values
USER     instead of raising PydanticAI signals. TerminalError is re-raised (never
USER     returned as Unsupported — it is an operational stop, not an honest refusal).
USER     """
USER     kind = exc.error_kind
USER     logger.debug(
USER         "evidence error in planner",
USER         extra={"subsystem": "planner", "error_kind": kind, "question_id": question_id},
USER     )
USER 
USER     if kind == "excluded_question":
USER         reason_code = exc.reason_code or contract.reason_code_for(question_id)
USER         reason_kind = (
USER             "not_yet_validated"
USER             if reason_code == "not_yet_validated"
USER             else "excluded_by_contract"
USER         )
USER         return Unsupported(
USER             reason_kind=reason_kind,
USER             reason=exc.message,
USER             reason_code=reason_code,
USER         )
USER 
USER     if kind == "unknown_question":
USER         return Unsupported(reason_kind="not_in_registry", reason=exc.message)
USER 
USER     if kind == "unanswerable":
USER         return Unsupported(reason_kind="unanswerable", reason=exc.message)
USER 
USER     if kind == "bad_request":
USER         # On a first bad_request the planner cannot repair (no model); return
USER         # out_of_scope so the caller knows the data layer rejected the request.
USER         return Unsupported(reason_kind="out_of_scope", reason=exc.message)
USER 
USER     # data_unavailable | internal — operational stop, not a refusal.
USER     raise TerminalError(f"evidence emitter reported {kind}: {exc.message}")
USER ````
USER 
