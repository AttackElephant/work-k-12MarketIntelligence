+# --------------------------------------------------------------------------- #
+# Label normalization
+# --------------------------------------------------------------------------- #
+
+
+def _normalize_label(label: Any) -> str:
+    """Unicode-safe case folding plus separator normalization.
+
+    `total_enrolments`, `Total Enrolments` and `total-enrolments` all fold to
+    `total enrolments`; Unicode letters survive the fold.
+    """
+    folded = _SEPARATOR_RE.sub(" ", str(label).casefold())
+    return folded.strip()
+
+
+def _canonical_for(label: Any, vocabulary: list[str]) -> str | None:
+    """Match a label against a pinned static vocabulary.
+
+    Direct normalized matches win; beyond that only the pinned semantic
+    aliases apply. Canonical values are returned unchanged.
+    """
+    wanted = _normalize_label(label)
+    for value in vocabulary:
+        if _normalize_label(value) == wanted:
+            return value
+    alias = _PINNED_SELECTOR_ALIASES.get(wanted)
+    if alias is not None and alias in vocabulary:
+        return alias
+    return None
+
+
+def _dedupe(values: list[Any]) -> list[Any]:
+    """Order-preserving deduplication."""
+    seen: set[Any] = set()
+    unique: list[Any] = []
+    for value in values:
+        if value not in seen:
+            seen.add(value)
+            unique.append(value)
+    return unique
+
+
+# --------------------------------------------------------------------------- #
+# Pinned-schema validation (complete draft 2020-12, local references only)
+# --------------------------------------------------------------------------- #
+
+
+@lru_cache(maxsize=1)
+def _request_validators() -> dict[str, Draft202012Validator]:
+    """Build validators from only the locally pinned, registered schemas.
+
+    The registry has no retrieval callback: an unregistered or external
+    reference therefore fails closed instead of fetching a schema at runtime.
+    """
+    schemas: dict[str, dict[str, Any]] = {}
+    resources: list[tuple[str, Resource[Any]]] = []
+    try:
+        for question_id in _schema_index()["questions"]:
+            schema = _request_schema(question_id)
+            Draft202012Validator.check_schema(schema)
+            schema_id = schema.get("$id")
+            if not isinstance(schema_id, str) or not schema_id:
+                raise TerminalError(f"{question_id} request schema has no valid $id")
+            schemas[question_id] = schema
+            resources.append((schema_id, Resource.from_contents(schema)))
+        registry = Registry().with_resources(resources)
+        return {
+            question_id: Draft202012Validator(
+                schema,
+                registry=registry,
+                format_checker=Draft202012Validator.FORMAT_CHECKER,
+            )
+            for question_id, schema in schemas.items()
+        }
+    except TerminalError:
+        raise
+    except (CannotDetermineSpecification, SchemaError, Unresolvable, ValueError) as exc:
+        raise TerminalError(f"pinned request schemas could not be resolved: {exc}") from exc
+
+
+def _instance_path(parts: Any) -> str:
+    path = "$request"
+    for part in parts:
+        path += f"[{part}]" if isinstance(part, int) else f".{part}"
+    return path
+
+
+def _schema_error_message(error: Any) -> str:
+    path = _instance_path(error.absolute_path)
+    if error.validator == "additionalProperties" and isinstance(error.instance, dict):
+        properties = error.schema.get("properties", {})
+        known = set(properties) if isinstance(properties, dict) else set()
+        unknown = sorted(key for key in error.instance if key not in known)
+        return f"{path}: unknown properties {unknown}"
+    return f"{path}: {error.message}"
+
+
+def _non_finite_paths(value: Any, path: str = "$request") -> list[str]:
+    """Reject Python-only NaN/infinities, which are not JSON numbers."""
+    if isinstance(value, float) and not math.isfinite(value):
+        return [path]
+    if isinstance(value, dict):
+        return [
+            problem
+            for key, child in value.items()
+            for problem in _non_finite_paths(child, f"{path}.{key}")
+        ]
+    if isinstance(value, list):
+        return [
+            problem
+            for index, child in enumerate(value)
+            for problem in _non_finite_paths(child, f"{path}[{index}]")
+        ]
+    return []
+
+
+def _validate_request(question_id: str, request: dict[str, Any]) -> None:
+    """Validate the planner-built request against its registered pinned schema.
+
+    Any failure — including schema load or resolution failure — is a
+    TerminalError before dispatch, never an Unsupported user outcome.
+    """
+    validator = _request_validators().get(question_id)
+    if validator is None:
+        raise TerminalError(f"{question_id} has no registered request validator")
+    problems = [f"{path}: value must be finite" for path in _non_finite_paths(request)]
+    try:
+        errors = sorted(
+            validator.iter_errors(request),
+            key=lambda error: tuple(str(part) for part in error.absolute_path),
+        )
+    except Unresolvable as exc:
+        raise TerminalError(
+            f"{question_id}: registered request schema reference could not be resolved: {exc}"
+        ) from exc
+    problems.extend(_schema_error_message(error) for error in errors)
+    if problems:
+        raise TerminalError(
+            f"{question_id}: the planner-built request does not satisfy its "
+            f"registered request schema: " + "; ".join(problems)
+        )
+
