+def test_main_uses_pipeline_path_by_default(monkeypatch, capsys):
+    """The shipping CLI passes None and never constructs the legacy agent."""
+    client = object()
+    seen: dict[str, Any] = {}
+
+    async def fake_converse(
+        agent,
+        deps,
+        question,
+        ask_user=None,
+        max_clarifications=1,
+        record_usage=True,
+    ):
+        seen.update(
+            agent=agent,
+            deps=deps,
+            question=question,
+            ask_user=ask_user,
+            max_clarifications=max_clarifications,
+            record_usage=record_usage,
+        )
+        return Unsupported(reason_kind="not_in_registry", reason="fixture refusal")
+
+    monkeypatch.setattr(cli, "configure_logging", lambda: None)
