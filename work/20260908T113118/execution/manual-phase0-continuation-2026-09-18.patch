+# --------------------------------------------------------------------------- #
+# School identity resolution (transactional, exactly-one-match)
+# --------------------------------------------------------------------------- #
+
+
+async def _resolve_mentions(
+    question_id: str,
+    mentions: list[str],
+    client: EvidenceClient,
+    deps: Deps,
+) -> tuple[list[int], ClarificationNeeded | None]:
+    """Resolve each mention through the pinned directory, exactly one match each.
+
+    Every preflight is recorded, including failures. IDs are staged locally in
+    mention order and deduplicated without reordering; nothing is committed
+    here — the caller commits to `Deps` only after every mention resolves.
+    """
+    staged: list[int] = []
+    for mention in mentions:
+        arguments = {"search": mention, "limit": 25}
+        try:
+            records = await client.school_directory(search=mention, limit=25)
+        except Exception as exc:
+            deps.tool_calls.append(
+                ToolInvocation("search_schools", arguments, error_kind=type(exc).__name__)
+            )
+            raise
+        deps.tool_calls.append(ToolInvocation("search_schools", arguments, records))
+        if not records:
+            return [], _school_match_clarification(
+                question_id,
+                mention,
+                f"'{mention}' matched no school in the pinned directory.",
+                "I couldn't find that school. Could you check the name — or give me "
+                "the school's public ACARA ID?",
+            )
+        if len(records) > 1:
+            return [], _school_match_clarification(
+                question_id,
+                mention,
+                f"'{mention}' matched {len(records)} schools; a request needs exactly one.",
+                f"More than one school matches '{mention}'. Which one did you mean?",
+            )
+        record = records[0]
+        school_id = record.get("acara_sml_id") if isinstance(record, dict) else None
+        if (
+            not isinstance(school_id, int)
+            or isinstance(school_id, bool)
+            or school_id <= 0
+        ):
+            raise TerminalError(
+                f"{question_id}: malformed school-directory record for {mention!r}; "
+                "exactly one positive integer acara_sml_id is required"
+            )
+        if school_id not in staged:
+            staged.append(school_id)
+    return staged, None
+
+
+def _school_match_clarification(
+    question_id: str, mention: str, why_material: str, prompt_to_user: str
+) -> ClarificationNeeded:
+    return ClarificationNeeded(
+        question_id=question_id,
+        missing=[
+            MissingInput(input="acara_sml_id", why_material=why_material, allowed_values=[])
+        ],
+        prompt_to_user=prompt_to_user,
