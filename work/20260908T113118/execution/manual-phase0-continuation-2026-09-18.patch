+# --------------------------------------------------------------------------- #
+# Selector normalization and routing
+# --------------------------------------------------------------------------- #
+
+
+def _selector_clarification(
+    question_id: str, field: str, value: Any, vocabulary: list[str]
+) -> ClarificationNeeded:
+    return ClarificationNeeded(
+        question_id=question_id,
+        missing=[
+            MissingInput(
+                input=field,
+                why_material=f"'{value}' is not an allowed {field} value for {question_id}.",
+                allowed_values=vocabulary,
+            )
+        ],
+        prompt_to_user=(
+            f"Which {field} did you mean? Allowed values: "
+            + ", ".join(vocabulary)
+            + "."
+        ),
+    )
+
+
+def _request_field_schema(question_id: str, path: list[str]) -> dict[str, Any]:
+    """Return the registered schema node for a mapped request-field path."""
+
+    node: Any = _request_schema(question_id)
+    for part in path:
+        properties = node.get("properties") if isinstance(node, dict) else None
+        node = properties.get(part) if isinstance(properties, dict) else None
+        if not isinstance(node, dict):
+            raise TerminalError(
+                f"{question_id}: pinned selector mapping has no request-schema field "
+                f"{'.'.join(path)}"
+            )
+    return node
+
+
+def _normalize_filter_selectors(
+    question_id: str, request: dict[str, Any]
+) -> ClarificationNeeded | None:
+    """Normalize every explicitly supplied selector backed by a static pin.
+
+    Release-derived/open fields retain their values and schema validation owns
+    wrong types and unknown keys. Static scalar, list and nested-list fields are
+    canonicalized with stable-order deduplication; unknown labels clarify.
+    """
+    prefix = f"{question_id}."
+    for mapped_field, list_name in _field_to_catalog_list().items():
+        if not mapped_field.startswith(prefix) or "<keys>" in mapped_field:
+            continue
+        vocabulary = _static_enum(list_name)
+        if vocabulary is None:
+            continue
+        path = mapped_field[len(prefix):].split(".")
+        owner: Any = request
+        for part in path[:-1]:
+            if not isinstance(owner, dict):
+                raise TerminalError(
+                    f"{question_id}: invalid selector shape for {'.'.join(path)}"
+                )
+            if part not in owner:
+                owner = None
+                break
+            owner = owner[part]
+        if owner is None:
+            continue
+        if not isinstance(owner, dict):
+            raise TerminalError(
+                f"{question_id}: invalid selector shape for {'.'.join(path)}"
+            )
+        if path[-1] not in owner:
+            continue
+        field = ".".join(path)
+        value = owner[path[-1]]
+        field_schema = _request_field_schema(question_id, path)
+        expected_type = field_schema.get("type")
+        if expected_type == "string":
+            if not isinstance(value, str):
+                raise TerminalError(
+                    f"{question_id}: invalid selector shape for {field}; expected string"
+                )
+            canonical = _canonical_for(value, vocabulary)
+            if canonical is None:
+                return _selector_clarification(question_id, field, value, vocabulary)
+            owner[path[-1]] = canonical
+        elif expected_type == "array":
+            if not isinstance(value, list) or not all(
+                isinstance(item, str) for item in value
+            ):
+                raise TerminalError(
+                    f"{question_id}: invalid selector shape for {field}; "
+                    "expected an array of strings"
+                )
+            canonical_values: list[str] = []
+            for item in value:
+                canonical = _canonical_for(item, vocabulary)
+                if canonical is None:
+                    return _selector_clarification(question_id, field, item, vocabulary)
+                canonical_values.append(canonical)
+            owner[path[-1]] = _dedupe(canonical_values)
+        else:
+            raise TerminalError(
+                f"{question_id}: unsupported pinned selector shape for {field}"
+            )
+    return None
+
+
+def _route_selectors(
+    question_id: str,
+    intent: StructuredIntent,
+    request: dict[str, Any],
+    deps: Deps,
