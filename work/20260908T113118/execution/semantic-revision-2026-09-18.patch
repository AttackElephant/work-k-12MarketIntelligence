+def test_matching_explicit_and_resolved_identities_commit_in_mention_order():
+    client = _DirectoryClient(
+        {
+            "Beta": [{"acara_sml_id": 202}],
+            "Alpha": [{"acara_sml_id": 101}],
+        }
+    )
+    deps = Deps(client=client)
+    intent = StructuredIntent(
+        question_id="VC-POC-04",
+        school_mentions=["Beta", "Alpha"],
+        filters={"acara_sml_ids": [101, 202]},
+    )
+
+    asyncio.run(plan_and_execute(intent, client, deps))
+
+    assert client.searches == ["Beta", "Alpha"]
+    assert deps.resolved_school_ids == [202, 101]
+    assert deps.searched is True
+    assert client.fetched[0]["request"]["acara_sml_ids"] == [202, 101]
+
+
