{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CB1mA1t8LXGUdMxMx2cHqW","type":"tool_result","content":"The file /Users/shane/Projects/k-12Harness/tests/conftest.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"04060cb5-94f6-4eb2-983d-98460da6793c","uuid":"0ccb2166-311f-4a86-8196-6727bbe82edb","timestamp":"2026-10-07T22:48:27.456Z","tool_use_result":{"filePath":"/Users/shane/Projects/k-12Harness/tests/conftest.py","oldString":"    with pytest.MonkeyPatch.context() as mp:\n        mp.setattr(_usage, \"append_jsonl\", guarded)\n        yield\n","newString":"    _usage.append_jsonl = guarded\n\n\n_install_usage_log_guard()\n\n\ndef pytest_unconfigure(config):\n    \"\"\"Restore the original recorder when the session ends.\"\"\"\n    _usage.append_jsonl = _ORIGINAL_APPEND_JSONL\n","originalFile":"\"\"\"Make the repo root importable, whatever pytest was invoked as.\n\nWithout this, `from evals import ...` / `from config import settings` resolve only\nbecause CI happens to run `python -m pytest` — the `-m` flag puts the CWD on\nsys.path. A bare `pytest tests/` from the repo root fails to import, because\npytest's default `prepend` import mode adds only the test file's own rootdir\n(tests/unit/) rather than the project root. That dependency was undocumented and\nunprotected; this file makes it explicit.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport sys\nfrom pathlib import Path\n\nPROJECT_ROOT = Path(__file__).resolve().parent.parent\n\nif str(PROJECT_ROOT) not in sys.path:\n    sys.path.insert(0, str(PROJECT_ROOT))\n\n\n# --- ADR-021: tests never write to logs/usage/ ------------------------------\nimport pytest  # noqa: E402\n\nfrom config import settings  # noqa: E402\nfrom harness import usage as _usage  # noqa: E402\n\n# Captured at import, before any test can monkeypatch settings.\nPROTECTED_USAGE_DIRS = (\n    settings.USAGE_LOG_DIR.resolve(),\n    (PROJECT_ROOT / \"logs\" / \"usage\").resolve(),\n)\n\n\n_ORIGINAL_APPEND_JSONL = _usage.append_jsonl\n\n\ndef _install_usage_log_guard():\n    \"\"\"Fail any test whose usage recording would land in the real logs/usage/.\n\n    Installed when this conftest is imported, which is before test modules are\n    collected, so `from harness.usage import append_jsonl` in a test module\n    captures the guard, as do the module attribute and record_run's own call.\n    \"\"\"\n    original = _ORIGINAL_APPEND_JSONL\n\n    def guarded(records, log_dir=None):\n        target = Path(log_dir if log_dir is not None else settings.USAGE_LOG_DIR).resolve()\n        for protected in PROTECTED_USAGE_DIRS:\n            if target == protected or target.is_relative_to(protected):\n                pytest.fail(\n                    f\"Test tried to write usage records to {target}, inside the \"\n                    f\"protected directory {protected} (ADR-021: tests never write \"\n                    \"to logs/usage/). Use the `usage_log_dir` fixture or pass \"\n                    \"log_dir=tmp_path.\",\n                    pytrace=False,\n                )\n        return original(records, log_dir)\n\n    with pytest.MonkeyPatch.context() as mp:\n        mp.setattr(_usage, \"append_jsonl\", guarded)\n        yield\n\n\n@pytest.fixture\ndef usage_log_dir(tmp_path, monkeypatch):\n    \"\"\"Send the usage recorder to a temporary directory and return it.\"\"\"\n    target = tmp_path / \"usage\"\n    monkeypatch.setattr(settings, \"USAGE_LOG_DIR\", target)\n    return target\n","structuredPatch":[{"oldStart":57,"oldLines":11,"newStart":57,"newLines":17,"lines":["                 )","         return original(records, log_dir)"," ","-    with pytest.MonkeyPatch.context() as mp:","-        mp.setattr(_usage, \"append_jsonl\", guarded)","-        yield","+    _usage.append_jsonl = guarded"," "," ","+_install_usage_log_guard()","+","+","+def pytest_unconfigure(config):","+    \"\"\"Restore the original recorder when the session ends.\"\"\"","+    _usage.append_jsonl = _ORIGINAL_APPEND_JSONL","+","+"," @pytest.fixture"," def usage_log_dir(tmp_path, monkeypatch):","     \"\"\"Send the usage recorder to a temporary directory and return it.\"\"\""]}],"userModified":false,"replaceAll":false}}
