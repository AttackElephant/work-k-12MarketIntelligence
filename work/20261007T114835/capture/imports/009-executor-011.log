{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JZHqeryS7KHDc3Y5F4TSAA","type":"tool_result","content":"1\t\"\"\"ADR-021: tests never write to logs/usage/. These tests show the guard in\n2\ttests/conftest.py stopping a write. They never write to the real directory,\n3\teven when they fail: the guard-less case is checked on an extracted base copy.\n4\t\"\"\"\n5\t\n6\tfrom __future__ import annotations\n7\t\n8\timport json\n9\tfrom pathlib import Path\n10\t\n11\timport pytest\n12\tfrom pydantic_ai import Agent\n13\tfrom pydantic_ai.models.test import TestModel\n14\t\n15\tfrom harness import usage\n16\tfrom harness.usage import RunSummaryRecord\n17\t\n18\tREAL = (Path(__file__).resolve().parents[2] / \"logs\" / \"usage\").resolve()\n19\t\n20\t\n21\tdef _snapshot() -> dict[str, int]:\n22\t    if not REAL.exists():\n23\t        return {}\n24\t    return {\n25\t        str(p.relative_to(REAL)): len(p.read_bytes().splitlines())\n26\t        for p in sorted(REAL.rglob(\"*\"))\n27\t        if p.is_file()\n28\t    }\n29\t\n30\t\n31\tdef _result():\n32\t    agent = Agent(TestModel(custom_output_text=\"ok\"), output_type=str)\n33\t    return agent.run_sync(\"usage-guard demonstration\")\n34\t\n35\t\n36\tdef test_recording_without_a_temporary_directory_fails_and_names_the_directory():\n37\t    result = _result()\n38\t    before = _snapshot()\n39\t    with pytest.raises(pytest.fail.Exception) as exc:\n40\t        usage.record_run(result, question=\"usage-guard demonstration\")\n41\t    assert str(REAL) in str(exc.value)\n42\t    assert \"ADR-021\" in str(exc.value)\n43\t    assert _snapshot() == before\n44\t\n45\t\n46\tdef test_append_without_a_directory_is_stopped_before_writing():\n47\t    before = _snapshot()\n48\t    with pytest.raises(pytest.fail.Exception) as exc:\n49\t        usage.append_jsonl([_summary()])\n50\t    assert str(REAL) in str(exc.value)\n51\t    assert _snapshot() == before\n52\t\n53\t\n54\tdef test_another_spelling_of_the_real_directory_is_still_stopped():\n55\t    before = _snapshot()\n56\t    for spelling in (REAL / \"x\" / \"..\", REAL / \"sub\"):\n57\t        with pytest.raises(pytest.fail.Exception) as exc:\n58\t            usage.append_jsonl([_summary()], log_dir=spelling)\n59\t        assert \"protected directory\" in str(exc.value)\n60\t    assert _snapshot() == before\n61\t\n62\t\n63\tdef test_monkeypatching_the_setting_back_to_the_real_directory_is_still_stopped(monkeypatch):\n64\t    from config import settings\n65\t\n66\t    monkeypatch.setattr(settings, \"USAGE_LOG_DIR\", REAL)\n67\t    before = _snapshot()\n68\t    with pytest.raises(pytest.fail.Exception):\n69\t        usage.append_jsonl([_summary()])\n70\t    assert _snapshot() == before\n71\t\n72\t\n73\tdef test_explicit_temporary_directory_writes_normally(tmp_path):\n74\t    path = usage.append_jsonl([_summary()], log_dir=tmp_path)\n75\t    assert tmp_path in path.parents\n76\t    assert path.read_text().strip()\n77\t\n78\t\n79\tdef test_usage_log_dir_fixture_redirects_record_run(usage_log_dir):\n80\t    result = _result()\n81\t    summary = usage.record_run(result, question=\"usage-guard demonstration\")\n82\t    assert summary is not None\n83\t    files = list(usage_log_dir.glob(\"usage-*.jsonl\"))\n84\t    assert len(files) == 1\n85\t    types = [json.loads(l)[\"record_type\"] for l in files[0].read_text().splitlines()]\n86\t    assert types.count(\"run_summary\") == 1\n87\t\n88\t\n89\tdef _summary() -> RunSummaryRecord:\n90\t    \"\"\"Build a run-summary record without recording it anywhere.\"\"\"\n91\t    from unittest import mock\n92\t\n93\t    captured: list = []\n94\t    with mock.patch.object(usage, \"append_jsonl\", lambda recs, log_dir=None: captured.extend(recs)):\n95\t        usage.record_run(_result(), question=\"x\")\n96\t    return next(r for r in captured if isinstance(r, RunSummaryRecord))\n97\t"}]},"parent_tool_use_id":null,"session_id":"04060cb5-94f6-4eb2-983d-98460da6793c","uuid":"dbbb0a91-eb9b-4151-be1c-9c46e419f05d","timestamp":"2026-10-07T22:48:20.397Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/tests/unit/test_usage_log_guard.py","content":"\"\"\"ADR-021: tests never write to logs/usage/. These tests show the guard in\ntests/conftest.py stopping a write. They never write to the real directory,\neven when they fail: the guard-less case is checked on an extracted base copy.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nfrom pathlib import Path\n\nimport pytest\nfrom pydantic_ai import Agent\nfrom pydantic_ai.models.test import TestModel\n\nfrom harness import usage\nfrom harness.usage import RunSummaryRecord\n\nREAL = (Path(__file__).resolve().parents[2] / \"logs\" / \"usage\").resolve()\n\n\ndef _snapshot() -> dict[str, int]:\n    if not REAL.exists():\n        return {}\n    return {\n        str(p.relative_to(REAL)): len(p.read_bytes().splitlines())\n        for p in sorted(REAL.rglob(\"*\"))\n        if p.is_file()\n    }\n\n\ndef _result():\n    agent = Agent(TestModel(custom_output_text=\"ok\"), output_type=str)\n    return agent.run_sync(\"usage-guard demonstration\")\n\n\ndef test_recording_without_a_temporary_directory_fails_and_names_the_directory():\n    result = _result()\n    before = _snapshot()\n    with pytest.raises(pytest.fail.Exception) as exc:\n        usage.record_run(result, question=\"usage-guard demonstration\")\n    assert str(REAL) in str(exc.value)\n    assert \"ADR-021\" in str(exc.value)\n    assert _snapshot() == before\n\n\ndef test_append_without_a_directory_is_stopped_before_writing():\n    before = _snapshot()\n    with pytest.raises(pytest.fail.Exception) as exc:\n        usage.append_jsonl([_summary()])\n    assert str(REAL) in str(exc.value)\n    assert _snapshot() == before\n\n\ndef test_another_spelling_of_the_real_directory_is_still_stopped():\n    before = _snapshot()\n    for spelling in (REAL / \"x\" / \"..\", REAL / \"sub\"):\n        with pytest.raises(pytest.fail.Exception) as exc:\n            usage.append_jsonl([_summary()], log_dir=spelling)\n        assert \"protected directory\" in str(exc.value)\n    assert _snapshot() == before\n\n\ndef test_monkeypatching_the_setting_back_to_the_real_directory_is_still_stopped(monkeypatch):\n    from config import settings\n\n    monkeypatch.setattr(settings, \"USAGE_LOG_DIR\", REAL)\n    before = _snapshot()\n    with pytest.raises(pytest.fail.Exception):\n        usage.append_jsonl([_summary()])\n    assert _snapshot() == before\n\n\ndef test_explicit_temporary_directory_writes_normally(tmp_path):\n    path = usage.append_jsonl([_summary()], log_dir=tmp_path)\n    assert tmp_path in path.parents\n    assert path.read_text().strip()\n\n\ndef test_usage_log_dir_fixture_redirects_record_run(usage_log_dir):\n    result = _result()\n    summary = usage.record_run(result, question=\"usage-guard demonstration\")\n    assert summary is not None\n    files = list(usage_log_dir.glob(\"usage-*.jsonl\"))\n    assert len(files) == 1\n    types = [json.loads(l)[\"record_type\"] for l in files[0].read_text().splitlines()]\n    assert types.count(\"run_summary\") == 1\n\n\ndef _summary() -> RunSummaryRecord:\n    \"\"\"Build a run-summary record without recording it anywhere.\"\"\"\n    from unittest import mock\n\n    captured: list = []\n    with mock.patch.object(usage, \"append_jsonl\", lambda recs, log_dir=None: captured.extend(recs)):\n        usage.record_run(_result(), question=\"x\")\n    return next(r for r in captured if isinstance(r, RunSummaryRecord))\n","numLines":97,"startLine":1,"totalLines":97}}}
