OT) not in sys.path:\n    sys.path.insert(0, str(PROJECT_ROOT))\n\n\n# --- ADR-021: tests never write to logs/usage/ ------------------------------\nimport pytest  # noqa: E402\n\nfrom config import settings  # noqa: E402\nfrom harness import usage as _usage  # noqa: E402\n\n# Captured at import, before any test can monkeypatch settings.\nPROTECTED_USAGE_DIRS = (\n    settings.USAGE_LOG_DIR.resolve(),\n    (PROJECT_ROOT / \"logs\" / \"usage\").resolve(),\n)\n\n\n@pytest.fixture(scope=\"session\", autouse=True)\ndef _usage_log_guard():\n    \"\"\"Fail any test whose usage recording would land in the real logs/usage/.\"\"\"\n    original = _usage.append_jsonl\n\n    def guarded(records, log_dir=None):\n        target = Path(log_dir if log_dir is not None else settings.USAGE_LOG_DIR).resolve()\n        for protected in PROTECTED_USAGE_DIRS:\n            if target == protected or target.is_relative_to(protected):\n                pytest.fail(\n                    f\"Test tried to write usage records to {target}, inside the \"\n                    f\"protected directory {protected} (ADR-021: tests never write \"\n                    \"to logs/usage/). Use the `usage_log_dir` fixture or pass \"\n                    \"log_dir=tmp_path.\",\n                    pytrace=False,\n                )\n        return original(records, log_dir)\n\n    with pytest.MonkeyPatch.context() as mp:\n        mp.setattr(_usage, \"append_jsonl\", guarded)\n        yield\n\n\n@pytest.fixture\ndef usage_log_dir(tmp_path, monkeypatch):\n    \"\"\"Send the usage recorder to a temporary directory and return it.\"\"\"\n    target = tmp_path / \"usage\"\n    monkeypatch.setattr(settings, \"USAGE_LOG_DIR\", target)\n    return target\n","structuredPatch":[{"oldStart":32,"oldLines":11,"newStart":32,"newLines":18,"lines":[" )"," "," ","-@pytest.fixture(scope=\"session\", autouse=True)","-def _usage_log_guard():","-    \"\"\"Fail any test whose usage recording would land in the real logs/usage/.\"\"\"","-    original = _usage.append_jsonl","+_ORIGINAL_APPEND_JSONL = _usage.append_jsonl"," ","+","+def _install_usage_log_guard():","+    \"\"\"Fail any test whose usage recording would land in the real logs/usage/.","+","+    Installed when this conftest is imported, which is before test modules are","+    collected, so `from harness.usage import append_jsonl` in a test module","+    captures the guard, as do the module attribute and record_run's own call.","+    \"\"\"","+    original = _ORIGINAL_APPEND_JSONL","+","     def guarded(records, log_dir=None):","         target = Path(log_dir if log_dir is not None else settings.USAGE_LOG_DIR).resolve()","         for protected in PROTECTED_USAGE_DIRS:"]}],"userModified":false,"replaceAll":false}}
