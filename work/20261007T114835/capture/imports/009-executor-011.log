{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SeNxKXQM5UuWKeffdR6UcR","type":"tool_result","content":"The file /Users/shane/Projects/k-12Harness/tests/unit/test_usage_log_guard.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"04060cb5-94f6-4eb2-983d-98460da6793c","uuid":"d2c5f6de-79d1-4205-951c-17fc129a63af","timestamp":"2026-10-07T22:48:29.445Z","tool_use_result":{"filePath":"/Users/shane/Projects/k-12Harness/tests/unit/test_usage_log_guard.py","oldString":"def test_another_spelling_","newString":"def test_a_from_imported_append_jsonl_is_also_stopped():\n    before = _snapshot()\n    with pytest.raises(pytest.fail.Exception) as exc:\n        imported_append_jsonl([_summary()])\n    assert str(REAL) in str(exc.value)\n    assert _snapshot() == before\n\n\ndef test_another_spelling_","originalFile":"\"\"\"ADR-021: tests never write to logs/usage/. These tests show the guard in\ntests/conftest.py stopping a write. They never write to the real directory,\neven when they fail: the guard-less case is checked on an extracted base copy.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nfrom pathlib import Path\n\nimport pytest\nfrom pydantic_ai import Agent\nfrom pydantic_ai.models.test import TestModel\n\nfrom harness import usage\nfrom harness.usage import RunSummaryRecord\nfrom harness.usage import append_jsonl as imported_append_jsonl  # from-import at module import time\n\nREAL = (Path(__file__).resolve().parents[2] / \"logs\" / \"usage\").resolve()\n\n\ndef _snapshot() -> dict[str, int]:\n    if not REAL.exists():\n        return {}\n    return {\n        str(p.relative_to(REAL)): len(p.read_bytes().splitlines())\n        for p in sorted(REAL.rglob(\"*\"))\n        if p.is_file()\n    }\n\n\ndef _result():\n    agent = Agent(TestModel(custom_output_text=\"ok\"), output_type=str)\n    return agent.run_sync(\"usage-guard demonstration\")\n\n\ndef test_recording_without_a_temporary_directory_fails_and_names_the_directory():\n    result = _result()\n    before = _snapshot()\n    with pytest.raises(pytest.fail.Exception) as exc:\n        usage.record_run(result, question=\"usage-guard demonstration\")\n    assert str(REAL) in str(exc.value)\n    assert \"ADR-021\" in str(exc.value)\n    assert _snapshot() == before\n\n\ndef test_append_without_a_directory_is_stopped_before_writing():\n    before = _snapshot()\n    with pytest.raises(pytest.fail.Exception) as exc:\n        usage.append_jsonl([_summary()])\n    assert str(REAL) in str(exc.value)\n    assert _snapshot() == before\n\n\ndef test_another_spelling_of_the_real_directory_is_still_stopped():\n    before = _snapshot()\n    for spelling in (REAL / \"x\" / \"..\", REAL / \"sub\"):\n        with pytest.raises(pytest.fail.Exception) as exc:\n            usage.append_jsonl([_summary()], log_dir=spelling)\n        assert \"protected directory\" in str(exc.value)\n    assert _snapshot() == before\n\n\ndef test_monkeypatching_the_setting_back_to_the_real_directory_is_still_stopped(monkeypatch):\n    from config import settings\n\n    monkeypatch.setattr(settings, \"USAGE_LOG_DIR\", REAL)\n    before = _snapshot()\n    with pytest.raises(pytest.fail.Exception):\n        usage.append_jsonl([_summary()])\n    assert _snapshot() == before\n\n\ndef test_explicit_temporary_directory_writes_normally(tmp_path):\n    path = usage.append_jsonl([_summary()], log_dir=tmp_path)\n    assert tmp_path in path.parents\n    assert path.read_text().strip()\n\n\ndef test_usage_log_dir_fixture_redirects_record_run(usage_log_dir):\n    result = _result()\n    summary = usage.record_run(result, question=\"usage-guard demonstration\")\n    assert summary is not None\n    files = list(usage_log_dir.glob(\"usage-*.jsonl\"))\n    assert len(files) == 1\n    types = [json.loads(l)[\"record_type\"] for l in files[0].read_text().splitlines()]\n    assert types.count(\"run_summary\") == 1\n\n\ndef _summary() -> RunSummaryRecord:\n    \"\"\"Build a run-summary record without recording it anywhere.\"\"\"\n    from unittest import mock\n\n    captured: list = []\n    with mock.patch.object(usage, \"append_jsonl\", lambda recs, log_dir=None: captured.extend(recs)):\n        usage.record_run(_result(), question=\"x\")\n    return next(r for r in captured if isinstance(r, RunSummaryRecord))\n","structuredPatch":[{"oldStart":52,"oldLines":6,"newStart":52,"newLines":14,"lines":["     assert _snapshot() == before"," "," ","+def test_a_from_imported_append_jsonl_is_also_stopped():","+    before = _snapshot()","+    with pytest.raises(pytest.fail.Exception) as exc:","+        imported_append_jsonl([_summary()])","+    assert str(REAL) in str(exc.value)","+    assert _snapshot() == before","+","+"," def test_another_spelling_of_the_real_directory_is_still_stopped():","     before = _snapshot()","     for spelling in (REAL / \"x\" / \"..\", REAL / \"sub\"):"]}],"userModified":false,"replaceAll":false}}
