{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RM4ZWx5Cbe9n6aShjqd1uv","type":"tool_result","content":"1\t\"\"\"Make the repo root importable, whatever pytest was invoked as.\n2\t\n3\tWithout this, `from evals import ...` / `from config import settings` resolve only\n4\tbecause CI happens to run `python -m pytest` — the `-m` flag puts the CWD on\n5\tsys.path. A bare `pytest tests/` from the repo root fails to import, because\n6\tpytest's default `prepend` import mode adds only the test file's own rootdir\n7\t(tests/unit/) rather than the project root. That dependency was undocumented and\n8\tunprotected; this file makes it explicit.\n9\t\"\"\"\n10\t\n11\tfrom __future__ import annotations\n12\t\n13\timport sys\n14\tfrom pathlib import Path\n15\t\n16\tPROJECT_ROOT = Path(__file__).resolve().parent.parent\n17\t\n18\tif str(PROJECT_ROOT) not in sys.path:\n19\t    sys.path.insert(0, str(PROJECT_ROOT))\n20\t\n21\t\n22\t# --- ADR-021: tests never write to logs/usage/ ------------------------------\n23\timport pytest  # noqa: E402\n24\t\n25\tfrom config import settings  # noqa: E402\n26\tfrom harness import usage as _usage  # noqa: E402\n27\t\n28\t# Captured at import, before any test can monkeypatch settings.\n29\tPROTECTED_USAGE_DIRS = (\n30\t    settings.USAGE_LOG_DIR.resolve(),\n31\t    (PROJECT_ROOT / \"logs\" / \"usage\").resolve(),\n32\t)\n33\t\n34\t\n35\t@pytest.fixture(scope=\"session\", autouse=True)\n36\tdef _usage_log_guard():\n37\t    \"\"\"Fail any test whose usage recording would land in the real logs/usage/.\"\"\"\n38\t    original = _usage.append_jsonl\n39\t\n40\t    def guarded(records, log_dir=None):\n41\t        target = Path(log_dir if log_dir is not None else settings.USAGE_LOG_DIR).resolve()\n42\t        for protected in PROTECTED_USAGE_DIRS:\n43\t            if target == protected or target.is_relative_to(protected):\n44\t                pytest.fail(\n45\t                    f\"Test tried to write usage records to {target}, inside the \"\n46\t                    f\"protected directory {protected} (ADR-021: tests never write \"\n47\t                    \"to logs/usage/). Use the `usage_log_dir` fixture or pass \"\n48\t                    \"log_dir=tmp_path.\",\n49\t                    pytrace=False,\n50\t                )\n51\t        return original(records, log_dir)\n52\t\n53\t    with pytest.MonkeyPatch.context() as mp:\n54\t        mp.setattr(_usage, \"append_jsonl\", guarded)\n55\t        yield\n56\t\n57\t\n58\t@pytest.fixture\n59\tdef usage_log_dir(tmp_path, monkeypatch):\n60\t    \"\"\"Send the usage recorder to a temporary directory and return it.\"\"\"\n61\t    target = tmp_path / \"usage\"\n62\t    monkeypatch.setattr(settings, \"USAGE_LOG_DIR\", target)\n63\t    return target\n64\t"}]},"parent_tool_use_id":null,"session_id":"04060cb5-94f6-4eb2-983d-98460da6793c","uuid":"fe6cbbd7-1db0-4efb-931c-de49f3af9cb0","timestamp":"2026-10-07T22:48:19.796Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/tests/conftest.py","content":"\"\"\"Make the repo root importable, whatever pytest was invoked as.\n\nWithout this, `from evals import ...` / `from config import settings` resolve only\nbecause CI happens to run `python -m pytest` — the `-m` flag puts the CWD on\nsys.path. A bare `pytest tests/` from the repo root fails to import, because\npytest's default `prepend` import mode adds only the test file's own rootdir\n(tests/unit/) rather than the project root. That dependency was undocumented and\nunprotected; this file makes it explicit.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport sys\nfrom pathlib import Path\n\nPROJECT_ROOT = Path(__file__).resolve().parent.parent\n\nif str(PROJECT_ROOT) not in sys.path:\n    sys.path.insert(0, str(PROJECT_ROOT))\n\n\n# --- ADR-021: tests never write to logs/usage/ ------------------------------\nimport pytest  # noqa: E402\n\nfrom config import settings  # noqa: E402\nfrom harness import usage as _usage  # noqa: E402\n\n# Captured at import, before any test can monkeypatch settings.\nPROTECTED_USAGE_DIRS = (\n    settings.USAGE_LOG_DIR.resolve(),\n    (PROJECT_ROOT / \"logs\" / \"usage\").resolve(),\n)\n\n\n@pytest.fixture(scope=\"session\", autouse=True)\ndef _usage_log_guard():\n    \"\"\"Fail any test whose usage recording would land in the real logs/usage/.\"\"\"\n    original = _usage.append_jsonl\n\n    def guarded(records, log_dir=None):\n        target = Path(log_dir if log_dir is not None else settings.USAGE_LOG_DIR).resolve()\n        for protected in PROTECTED_USAGE_DIRS:\n            if target == protected or target.is_relative_to(protected):\n                pytest.fail(\n                    f\"Test tried to write usage records to {target}, inside the \"\n                    f\"protected directory {protected} (ADR-021: tests never write \"\n                    \"to logs/usage/). Use the `usage_log_dir` fixture or pass \"\n                    \"log_dir=tmp_path.\",\n                    pytrace=False,\n                )\n        return original(records, log_dir)\n\n    with pytest.MonkeyPatch.context() as mp:\n        mp.setattr(_usage, \"append_jsonl\", guarded)\n        yield\n\n\n@pytest.fixture\ndef usage_log_dir(tmp_path, monkeypatch):\n    \"\"\"Send the usage recorder to a temporary directory and return it.\"\"\"\n    target = tmp_path / \"usage\"\n    monkeypatch.setattr(settings, \"USAGE_LOG_DIR\", target)\n    return target\n","numLines":64,"startLine":1,"totalLines":64}}}
