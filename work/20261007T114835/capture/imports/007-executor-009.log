{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017qkdceU88Zz9pFEs6CJsXa","type":"tool_result","content":"The file /Users/shane/Projects/k-12Harness/tests/unit/test_run_cli.py has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"908c0fb5-3108-4d6f-a1a1-3f2f79af6fb0","uuid":"e8efac62-21aa-4652-bdd1-ea9361b0f5a0","timestamp":"2026-10-07T22:30:12.863Z","tool_use_result":{"filePath":"/Users/shane/Projects/k-12Harness/tests/unit/test_run_cli.py","oldString":"from harness.tools import Deps\n","newString":"from harness.tools import Deps\n\npytestmark = pytest.mark.usefixtures(\"usage_log_dir\")\n","originalFile":"\"\"\"M4 — the CLI entry point renders faithfully and carries a clarification.\n\n`run.py` is where a human meets this system, so the two things graded here are\nthe two things a demo could quietly get wrong:\n\n1. **It renders what the harness preserved.** Every limitation string appears in\n   the output, verbatim; the confidence axes appear as the data layer stated\n   them, with the grade shown only when the response states one; provenance is\n   shown. A renderer that\n   summarised any of these would pass the agent's own gates and break the\n   contract at the last inch (ADR-009).\n2. **It carries one clarification round-trip on real message history** — and\n   stops rather than guessing when there is no answer to be had (O-3).\n\nThe model is scripted throughout; nothing here needs a network or a credential.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport json\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nimport pytest\nfrom pydantic_ai.messages import ModelMessage, ModelResponse, ToolCallPart\nfrom pydantic_ai.models.function import AgentInfo, FunctionModel\n\nimport run as cli\nfrom evals import replay as replay_mod\nfrom evals.schema import load_cases, load_reference_solutions\nfrom harness.agent import ask, build_agent\nfrom harness.evidence import EvidenceClient, EvidenceError\nfrom harness.intent import StructuredIntent\nfrom harness.narration import NarrationOutput\nfrom harness.outputs import BudgetExceeded, ClarificationNeeded, MissingInput, Unsupported\nfrom harness.tools import Deps\n\nPROJECT_ROOT = Path(__file__).resolve().parents[2]\nSTUB = PROJECT_ROOT / \"evals\" / \"stub_emitter.py\"\n\nCASES = {c.case_id: c for c in load_cases()}\nREFERENCES = load_reference_solutions()\n\n\ndef stub_client() -> EvidenceClient:\n    return EvidenceClient(python=Path(sys.executable), emitter=STUB)\n\n\ndef answered() -> Any:\n    \"\"\"A real RenderedAnswer, produced by replaying a golden case through the\n    production path — not a hand-built object that might not be reachable.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    agent = build_agent(model=replay_mod.scripted_model(REFERENCES[case.case_id]))\n    deps = Deps(client=stub_client())\n    return asyncio.run(ask(agent, deps, case.phrasings[0], record_usage=False))\n\n\n# --------------------------------------------------------------------------\n# rendering\n# --------------------------------------------------------------------------\n\n\ndef test_every_limitation_is_rendered_verbatim():\n    output = answered()\n    assert output.limitations, \"the fixture should carry limitations to preserve\"\n    text = cli.render_text(output)\n    for limitation in output.limitations:\n        assert limitation in text\n\n\nENVELOPES = PROJECT_ROOT / \"docs\" / \"reviews\" / \"2026-10-poc-review\" / \"_work\" / \"envelopes\"\nHEADING = \"Confidence (as stated by the data layer):\"\nGRADE_WORDS = (\"Observed\", \"Derived\", \"Modelled\", \"Indicative\", \"Unsupported\")\n\n\ndef _envelope(name: str) -> dict[str, Any]:\n    return json.loads((ENVELOPES / name).read_text(encoding=\"utf-8\"))\n\n\ndef _rendered(envelope: dict[str, Any]) -> Any:\n    from harness.outputs import AnswerDraft, RenderedAnswer\n\n    draft = AnswerDraft(question_id=envelope[\"question_id\"], answer=\"probe\")\n    return RenderedAnswer.from_envelope(draft, envelope)\n\n\ndef _block(output: Any) -> list[str]:\n    section = cli.render_text(output).split(HEADING)[1].split(\"\\n\\n\")[0]\n    return [line.strip().removeprefix(\"- \").strip() for line in section.strip().splitlines()]\n\n\ndef test_confidence_renders_as_the_axes_the_data_layer_stated():\n    output = answered()\n    lines = _block(output)\n    confidence = output.confidence\n    for axis, rating in confidence.items():\n        if axis != \"grade\":\n            assert f\"{axis}: {rating}\" in lines\n    grade = confidence[\"grade\"]\n    assert f\"grade: {grade['value']}\" in lines\n    assert f\"weakest input: {grade['weakest_input']['grade']}\" in lines\n    # ADR-009: nothing beyond what the response states may appear.\n    allowed = {a for a in confidence if a != \"grade\"} | {\"grade\", \"weakest input\"}\n    allowed |= {f\"component {n}\" for n in grade.get(\"component_grades\", {})}\n    assert {line.split(\":\")[0] for line in lines} <= allowed\n    assert not any(\"{\" in line for line in lines)\n\n\ndef test_l01_block_shows_the_stated_grade_and_weakest_input():\n    lines = _block(_rendered(_envelope(\"L01.json\")))\n    assert \"grade: Observed\" in lines\n    assert \"weakest input: Observed\" in lines\n    for rating in (\"forecast: not_applicable\", \"linkage: high\", \"source: high\", \"temporal: medium\"):\n        assert rating in lines\n    assert not any(\"{\" in line or \"'adjustments'\" in line for line in lines)\n\n\ndef test_compound_answer_shows_each_component_grade():\n    lines = _block(_rendered(_envelope(\"direct_VC-POC-13_579499.json\")))\n    assert \"component sa2_age_projection: Indicative\" in lines\n    assert \"component sa2_projection: Indicative\" in lines\n    assert not any(\"{\" in line for line in lines)\n\n\n@pytest.mark.parametrize(\"case\", [\"no_grade\", \"no_value\"])\ndef test_no_stated_grade_shows_ratings_only_and_says_so(case):\n    import copy\n\n    envelope = copy.deepcopy(_envelope(\"L01.json\"))\n    if case == \"no_grade\":\n        del envelope[\"confidence\"][\"grade\"]\n    else:\n        del envelope[\"confidence\"][\"grade\"][\"value\"]\n    lines = _block(_rendered(envelope))\n    for rating in (\"forecast: not_applicable\", \"linkage: high\", \"source: high\", \"temporal: medium\"):\n        assert rating in lines\n    assert \"grade: not stated by the data layer\" in lines\n    assert not any(word in line for line in lines for word in GRADE_WORDS)\n\n\ndef _run_main_with_probe(monkeypatch, tmp_path, argv):\n    import logging\n\n    from config import settings\n    from harness.logging_config import configure_logging\n\n    refusal = Unsupported(reason_kind=\"not_in_registry\", reason=\"probe refusal\")\n\n    async def fake_converse(*args, **kwargs):\n        logging.getLogger(\"harness.agent\").warning(\"probe-log-record\")\n        return refusal\n\n    monkeypatch.setattr(settings, \"PROJECT_ROOT\", tmp_path)\n    monkeypatch.setattr(cli, \"require_credentials\", lambda: None)\n    monkeypatch.setattr(cli, \"build_client\", lambda use_stub: object())\n    monkeypatch.setattr(cli, \"converse\", fake_converse)\n    try:\n        code = cli.main(argv)\n    finally:\n        monkeypatch.undo()\n        configure_logging()  # rebind handlers away from the captured stream\n    return code, refusal\n\n\ndef test_text_mode_stdout_carries_no_log_record(monkeypatch, tmp_path, capsys):\n    code, refusal = _run_main_with_probe(\n        monkeypatch, tmp_path, [\"--no-interactive\", \"probe question\"]\n    )\n    out = capsys.readouterr().out\n    assert code == cli.EXIT_UNSUPPORTED\n    assert out == cli.render_text(refusal) + \"\\n\"\n    for line in out.splitlines():\n        try:\n            parsed = json.loads(line)\n        except ValueError:\n            continue\n        assert not (isinstance(parsed, dict) and \"level\" in parsed)\n    log_text = (tmp_path / \"logs\" / \"harness.log\").read_text(encoding=\"utf-8\")\n    assert \"probe-log-record\" in log_text\n\n\ndef test_json_mode_stdout_is_exactly_one_json_document(monkeypatch, tmp_path, capsys):\n    code, refusal = _run_main_with_probe(\n        monkeypatch, tmp_path, [\"--json\", \"--no-interactive\", \"probe question\"]\n    )\n    out = capsys.readouterr().out\n    assert code == cli.EXIT_UNSUPPORTED\n    assert json.loads(out) == refusal.model_dump(mode=\"json\")\n    assert \"probe-log-record\" in (tmp_path / \"logs\" / \"harness.log\").read_text(encoding=\"utf-8\")\n\n\ndef test_an_answer_shows_its_provenance_and_question_id():\n    output = answered()\n    text = cli.render_text(output)\n    assert output.question_id in text\n    assert \"Provenance\" in text\n\n\ndef test_a_refusal_renders_the_contract_wording_and_nothing_softer():\n    refusal = Unsupported(\n        reason_kind=\"excluded_by_contract\",\n        reason=\"school costs, financial ratios, fees, revenue, assets, liabilities, \"\n        \"cash, or ACNC school comparisons\",\n        nearest_supported=\"VC-POC-01\",\n    )\n    text = cli.render_text(refusal)\n    assert refusal.reason in text\n    assert \"VC-POC-01\" in text\n\n\ndef test_a_budget_trip_shows_no_partial_answer():\n    trip = BudgetExceeded(\n        limit=\"usd\", detail=\"spent $1.20 of $1.00\", learned_so_far=\"resolved school IDs [40387]\"\n    )\n    text = cli.render_text(trip)\n    assert \"usd\" in text\n    assert \"resolved school IDs [40387]\" in text\n    assert \"No partial answer\" in text\n\n\ndef test_a_clarification_names_what_is_missing_and_why():\n    clarification = ClarificationNeeded(\n        question_id=\"VC-POC-08\",\n        missing=[\n            MissingInput(\n                input=\"distance_km\",\n                why_material='\"Near\" is not a distance.',\n                allowed_values=[],\n            )\n        ],\n        prompt_to_user=\"What radius should I use?\",\n    )\n    text = cli.render_text(clarification)\n    assert \"distance_km\" in text\n    assert '\"Near\" is not a distance.' in text\n    assert \"What radius should I use?\" in text\n\n\n# --------------------------------------------------------------------------\n# the clarification round-trip\n# --------------------------------------------------------------------------\n\n\ndef _clarify_then_answer() -> FunctionModel:\n    \"\"\"Ask for a radius on the first turn; on the second — with the user's reply\n    in the history — fetch and answer.\"\"\"\n\n    def script(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:\n        turns = sum(1 for m in messages if isinstance(m, ModelResponse))\n        if turns == 0:\n            return ModelResponse(\n                parts=[\n                    ToolCallPart(\n                        \"final_result_ClarificationNeeded\",\n                        {\n                            \"question_id\": \"VC-POC-08\",\n                            \"missing\": [\n                                {\n                                    \"input\": \"distance_km\",\n                                    \"why_material\": '\"Near\" is not a distance.',\n                                    \"allowed_values\": [],\n                                }\n                            ],\n                            \"prompt_to_user\": \"What radius should I use?\",\n                        },\n                    )\n                ]\n            )\n        if turns == 1:\n            return ModelResponse(\n                parts=[\n                    ToolCallPart(\n                        \"fetch_evidence\",\n                        {\n                            \"question_id\": \"VC-POC-08\",\n                            \"request\": {\"acara_sml_id\": 40387, \"distance_km\": 10},\n                        },\n                    )\n                ]\n            )\n        return ModelResponse(\n            parts=[\n                ToolCallPart(\n                    \"final_result_AnswerDraft\",\n                    {\n                        \"question_id\": \"VC-POC-08\",\n                        \"answer\": \"Within 10 km the returned cohort is listed above.\",\n                        \"data_status_note\": \"\",\n                    },\n                )\n            ]\n        )\n\n    return FunctionModel(script)\n\n\ndef test_one_clarification_round_trip_answers_the_question():\n    agent = build_agent(model=_clarify_then_answer())\n    deps = Deps(client=stub_client())\n    replies = iter([\"10 km\"])\n    output = asyncio.run(\n        cli.converse(\n            agent,\n            deps,\n            \"Which schools are near Alpha College?\",\n            ask_user=lambda _clarification: next(replies),\n            max_clarifications=1,\n        )\n    )\n    assert output.kind == \"answer\"\n    assert output.question_id == \"VC-POC-08\"\n\n\ndef test_pipeline_clarification_retains_original_request_and_prior_inputs(monkeypatch):\n    \"\"\"The pipeline's second intent turn sees the request, question and answer.\"\"\"\n    import harness.intent as intent_mod\n    import harness.narration as narration_mod\n\n    seen_questions: list[str] = []\n\n    async def scripted_intent(question: str, model=None):\n        seen_questions.append(question)\n        if len(seen_questions) == 1:\n            return StructuredIntent(\n                question_id=\"VC-POC-05\",\n                filters={\"acara_sml_id\": 40387},\n            )\n        assert \"Show the market around ACARA 40387\" in question\n        assert \"market_definition\" in question\n        assert \"SA2\" in question\n        return StructuredIntent(\n            question_id=\"VC-POC-05\",\n            filters={\"acara_sml_id\": 40387, \"market_definition\": \"sa2\"},\n        )\n\n    async def scripted_narration(view, deps, model=None):\n        return NarrationOutput(answer=\"The requested market cohort is shown.\")\n\n    monkeypatch.setattr(intent_mod, \"interpret_intent\", scripted_intent)\n    monkeypatch.setattr(narration_mod, \"narrate\", scripted_narration)\n    deps = Deps(client=stub_client())\n\n    output = asyncio.run(\n        cli.converse(\n            None,\n            deps,\n            \"Show the market around ACARA 40387\",\n            ask_user=lambda _clarification: \"SA2\",\n            max_clarifications=1,\n            record_usage=False,\n        )\n    )\n\n    assert output.kind == \"answer\"\n    assert output.question_id == \"VC-POC-05\"\n    assert deps.intent.question_id == \"VC-POC-05\"\n    assert deps.intent.filters == {\"acara_sml_id\": 40387, \"market_definition\": \"sa2\"}\n    assert len(seen_questions) == 2\n\n\n@pytest.mark.parametrize(\n    (\"reply\", \"expected_fetches\"),\n    [\n        (\"Teaching staff, please\", 0),\n        (\"Teaching staff headcount, please\", 1),\n    ],\n)\ndef test_pipeline_metric_scope_uses_only_user_wording(\n    monkeypatch, reply, expected_fetches\n):\n    \"\"\"Assistant clarification prose cannot authorize a broader metric.\"\"\"\n    import harness.intent as intent_mod\n\n    calls = 0\n\n    async def scripted_intent(question: str, model=None):\n        nonlocal calls\n        calls += 1\n        if calls == 2:\n            assert \"Headcount and non-teaching metrics\" in question\n            assert reply in question\n        return StructuredIntent(\n            question_id=\"VC-POC-01\",\n            requested_metrics=[\"teaching staff headcount\"],\n            filters={\"acara_sml_id\": 101},\n        )\n\n    class RecordingUnanswerableClient:\n        def __init__(self):\n            self.fetched: list[dict[str, Any]] = []\n\n        async def fetch_evidence(self, question_id: str, request: dict) -> dict:\n            self.fetched.append({\"question_id\": question_id, \"request\": request})\n            raise EvidenceError(\"unanswerable\", \"synthetic stop after request capture\")\n\n    monkeypatch.setattr(intent_mod, \"interpret_intent\", scripted_intent)\n    client = RecordingUnanswerableClient()\n    deps = Deps(client=client)\n\n    output = asyncio.run(\n        cli.converse(\n            None,\n            deps,\n            \"Show teaching staff at ACARA 101\",\n            ask_user=lambda _clarification: reply,\n            max_clarifications=1,\n            record_usage=False,\n        )\n    )\n\n    assert len(client.fetched) == expected_fetches\n    if expected_fetches:\n        assert client.fetched[0][\"request\"] == {\n            \"acara_sml_id\": 101,\n            \"metrics\": [\"teaching_staff_headcount\"],\n        }\n        assert isinstance(output, Unsupported)\n    else:\n        assert isinstance(output, ClarificationNeeded)\n    assert \"Headcount and non-teaching metrics\" not in deps._scope_user_question\n    assert reply in deps._scope_user_question\n\n\ndef test_a_non_interactive_caller_gets_the_clarification_not_a_guess():\n    \"\"\"The failure this prevents: a batch caller with no human attached filling\n    in a material input to avoid an awkward exit code.\"\"\"\n    agent = build_agent(model=_clarify_then_answer())\n    deps = Deps(client=stub_client())\n    output = asyncio.run(\n        cli.converse(agent, deps, \"Which schools are near Alpha College?\", ask_user=None)\n    )\n    assert isinstance(output, ClarificationNeeded)\n\n\ndef test_an_empty_reply_ends_the_conversation_rather_than_guessing():\n    agent = build_agent(model=_clarify_then_answer())\n    deps = Deps(client=stub_client())\n    output = asyncio.run(\n        cli.converse(\n            agent,\n            deps,\n            \"Which schools are near Alpha College?\",\n            ask_user=lambda _c: \"   \",\n        )\n    )\n    assert isinstance(output, ClarificationNeeded)\n\n\ndef test_zero_clarification_rounds_still_runs_the_question_once():\n    agent = build_agent(model=_clarify_then_answer())\n    deps = Deps(client=stub_client())\n    output = asyncio.run(\n        cli.converse(\n            agent,\n            deps,\n            \"Which schools are near Alpha College?\",\n            ask_user=lambda _c: \"10 km\",\n            max_clarifications=0,\n        )\n    )\n    assert isinstance(output, ClarificationNeeded)\n\n\n# --------------------------------------------------------------------------\n# exit codes and wiring\n# --------------------------------------------------------------------------\n\n\ndef test_main_uses_pipeline_path_by_default(monkeypatch, capsys):\n    \"\"\"The shipping CLI passes None and never constructs the legacy agent.\"\"\"\n    client = object()\n    seen: dict[str, Any] = {}\n\n    async def fake_converse(\n        agent,\n        deps,\n        question,\n        ask_user=None,\n        max_clarifications=1,\n        record_usage=True,\n    ):\n        seen.update(\n            agent=agent,\n            deps=deps,\n            question=question,\n            ask_user=ask_user,\n            max_clarifications=max_clarifications,\n            record_usage=record_usage,\n        )\n        return Unsupported(reason_kind=\"not_in_registry\", reason=\"fixture refusal\")\n\n    monkeypatch.setattr(cli, \"configure_logging\", lambda: None)\n    monkeypatch.setattr(cli, \"require_credentials\", lambda: None)\n    monkeypatch.setattr(cli, \"build_client\", lambda use_stub: client)\n    monkeypatch.setattr(\n        cli,\n        \"build_agent\",\n        lambda: pytest.fail(\"default CLI must not construct a legacy agent\"),\n    )\n    monkeypatch.setattr(cli, \"converse\", fake_converse)\n\n    exit_code = cli.main(\n        [\"--stub\", \"--no-interactive\", \"--max-clarifications\", \"3\", \"question\"]\n    )\n\n    assert exit_code == cli.EXIT_UNSUPPORTED\n    assert seen[\"agent\"] is None\n    assert seen[\"deps\"].client is client\n    assert seen[\"question\"] == \"question\"\n    assert seen[\"ask_user\"] is None\n    assert seen[\"max_clarifications\"] == 3\n    assert seen[\"record_usage\"] is True\n    assert \"fixture refusal\" in capsys.readouterr().out\n\n\ndef test_converse_preserves_explicit_legacy_agent_path(monkeypatch):\n    \"\"\"Replay callers that provide an agent keep the legacy ask signature.\"\"\"\n    legacy_agent = object()\n    deps = Deps(client=stub_client())\n    seen: dict[str, Any] = {}\n\n    async def fake_ask(*args, **kwargs):\n        seen[\"args\"] = args\n        seen[\"kwargs\"] = kwargs\n        return Unsupported(reason_kind=\"not_in_registry\", reason=\"fixture refusal\")\n\n    monkeypatch.setattr(cli, \"ask\", fake_ask)\n\n    output = asyncio.run(\n        cli.converse(\n            legacy_agent,\n            deps,\n            \"question\",\n            max_clarifications=0,\n            record_usage=False,\n        )\n    )\n\n    assert isinstance(output, Unsupported)\n    assert seen[\"args\"] == (legacy_agent, deps, \"question\")\n    assert seen[\"kwargs\"] == {\n        \"message_history\": None,\n        \"record_usage\": False,\n    }\n\n\n@pytest.mark.parametrize(\n    \"branch, expected\",\n    [\n        (cli.RenderedAnswer, cli.EXIT_ANSWERED),\n        (ClarificationNeeded, cli.EXIT_CLARIFICATION),\n        (Unsupported, cli.EXIT_UNSUPPORTED),\n        (BudgetExceeded, cli.EXIT_BUDGET),\n    ],\n)\ndef test_every_output_branch_has_an_exit_code(branch, expected):\n    \"\"\"A branch with no exit code would raise a KeyError at the very end of a\n    run that had otherwise worked.\"\"\"\n    assert cli.EXIT_BY_BRANCH[branch] == expected\n\n\ndef test_the_real_emitter_is_required_unless_stub_is_asked_for(monkeypatch):\n    from config import settings\n\n    monkeypatch.setattr(settings, \"EVIDENCE_EMITTER\", Path(\"/nonexistent/emit.py\"))\n    monkeypatch.setattr(settings, \"DATA_PROJECT_ROOT\", Path(\"\"))\n    with pytest.raises(SystemExit) as excinfo:\n        cli.build_client(use_stub=False)\n    assert \"DATA_PROJECT_ROOT\" in str(excinfo.value)\n\n\ndef test_a_missing_credential_is_a_sentence_not_a_stack_trace(monkeypatch):\n    \"\"\"No env var and no SDK-readable profile: there is genuinely nothing to\n    try, and the message names `claude setup-token` as the fix for a Claude\n    Code session — not `ant auth login`, which most readers of this message\n    will not have and would not help even if they did.\"\"\"\n    import anthropic\n\n    from config import settings\n\n    monkeypatch.setattr(settings, \"MODEL_PROVIDER\", \"anthropic_sdk\")\n    monkeypatch.setattr(settings, \"ANTHROPIC_API_KEY\", None)\n    monkeypatch.setattr(settings, \"ANTHROPIC_AUTH_TOKEN\", None)\n    monkeypatch.setattr(anthropic, \"default_credentials\", lambda **_: None)\n    with pytest.raises(SystemExit) as excinfo:\n        cli.require_credentials()\n    message = str(excinfo.value)\n    for route in (\"claude setup-token\", \"ANTHROPIC_AUTH_TOKEN\", \"ANTHROPIC_API_KEY\"):\n        assert route in message\n\n\n@pytest.mark.parametrize(\"var\", [\"ANTHROPIC_API_KEY\", \"ANTHROPIC_AUTH_TOKEN\"])\ndef test_either_env_credential_satisfies_the_check(monkeypatch, var):\n    import anthropic\n\n    from config import settings\n\n    monkeypatch.setattr(settings, \"MODEL_PROVIDER\", \"anthropic_sdk\")\n    monkeypatch.setattr(settings, \"ANTHROPIC_API_KEY\", None)\n    monkeypatch.setattr(settings, \"ANTHROPIC_AUTH_TOKEN\", None)\n    monkeypatch.setattr(settings, var, \"set\")\n    monkeypatch.setattr(anthropic, \"default_credentials\", lambda **_: None)\n    cli.require_credentials()\n\n\ndef test_a_claude_code_login_alone_does_not_satisfy_the_check(monkeypatch):\n    \"\"\"The bug this replaces: treating `claude` being on PATH — or `claude auth\n    status` reporting logged in — as proof the SDK can authenticate. It cannot;\n    `claude auth login` writes to neither the env vars nor the profile file\n    `anthropic.default_credentials()` reads, so the check must still block.\"\"\"\n    import anthropic\n\n    from config import settings\n\n    monkeypatch.setattr(settings, \"MODEL_PROVIDER\", \"anthropic_sdk\")\n    monkeypatch.setattr(settings, \"ANTHROPIC_API_KEY\", None)\n    monkeypatch.setattr(settings, \"ANTHROPIC_AUTH_TOKEN\", None)\n    monkeypatch.setattr(anthropic, \"default_credentials\", lambda **_: None)\n    with pytest.raises(SystemExit):\n        cli.require_credentials()\n\n\ndef test_a_real_sdk_profile_satisfies_the_check_with_no_env_var(monkeypatch):\n    \"\"\"An unset env var is not the absence of a credential — an `ant auth\n    login` profile (or workload-identity federation) is a real, SDK-readable\n    credential the check must accept without an env var set.\"\"\"\n    import anthropic\n\n    from config import settings\n\n    monkeypatch.setattr(settings, \"MODEL_PROVIDER\", \"anthropic_sdk\")\n    monkeypatch.setattr(settings, \"ANTHROPIC_API_KEY\", None)\n    monkeypatch.setattr(settings, \"ANTHROPIC_AUTH_TOKEN\", None)\n    monkeypatch.setattr(anthropic, \"default_credentials\", lambda **_: object())\n    cli.require_credentials()\n\n\ndef test_stub_mode_needs_no_data_project():\n    client = cli.build_client(use_stub=True)\n    assert client.emitter == STUB\n\n\ndef test_json_output_is_the_branch_itself():\n    output = answered()\n    payload = json.loads(output.model_dump_json())\n    assert payload[\"question_id\"] == output.question_id\n    assert payload[\"limitations\"] == output.limitations\n\n\n# --------------------------------------------------------------------------\n# the corrected auth-source check (ADR-011 follow-up)\n# --------------------------------------------------------------------------\n\n\ndef test_anthropic_credentials_use_the_sdks_own_resolver(monkeypatch):\n    \"\"\"The bug this replaces, pinned so it cannot come back: an earlier\n    version inferred \"a profile might work\" from `shutil.which(\"ant\")`, which\n    also matched a `claude` CLI that cannot bridge into this SDK at all. The\n    fix calls `anthropic.default_credentials()` — ground truth — instead.\"\"\"\n    from config import settings\n\n    monkeypatch.setattr(settings, \"MODEL_PROVIDER\", \"anthropic_sdk\")\n    source = (Path(__file__).resolve().parents[2] / \"run.py\").read_text(\"utf-8\")\n    assert \"default_credentials\" in source\n\n\ndef test_valid_claude_account_token_satisfies_the_default_check(monkeypatch):\n    from config import settings\n\n    monkeypatch.setattr(settings, \"MODEL_PROVIDER\", \"claude_account\")\n    monkeypatch.setattr(\n        cli, \"claude_account_status\", lambda _binary: (True, \"logged in\")\n    )\n    cli.require_credentials()\n\n\ndef test_missing_claude_account_token_is_a_clear_error(monkeypatch):\n    from config import settings\n\n    monkeypatch.setattr(settings, \"MODEL_PROVIDER\", \"claude_account\")\n    monkeypatch.setattr(\n        cli, \"claude_account_status\", lambda _binary: (False, \"token is not set\")\n    )\n    with pytest.raises(SystemExit, match=\"CLAUDE_CODE_OAUTH_TOKEN\"):\n        cli.require_credentials()\n","structuredPatch":[{"oldStart":37,"oldLines":6,"newStart":37,"newLines":8,"lines":[" from harness.outputs import BudgetExceeded, ClarificationNeeded, MissingInput, Unsupported"," from harness.tools import Deps"," ","+pytestmark = pytest.mark.usefixtures(\"usage_log_dir\")","+"," PROJECT_ROOT = Path(__file__).resolve().parents[2]"," STUB = PROJECT_ROOT / \"evals\" / \"stub_emitter.py\""," "]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true}}
