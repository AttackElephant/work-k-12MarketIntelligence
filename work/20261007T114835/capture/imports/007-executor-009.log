{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KFNyaLZptjFWEPqeFVRzuE","type":"tool_result","content":"The file /Users/shane/Projects/k-12Harness/tests/unit/test_agent_loop.py has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"908c0fb5-3108-4d6f-a1a1-3f2f79af6fb0","uuid":"26316830-ca5a-44c8-b892-d4423cae445d","timestamp":"2026-10-07T22:30:12.161Z","tool_use_result":{"filePath":"/Users/shane/Projects/k-12Harness/tests/unit/test_agent_loop.py","oldString":"from harness.tools import Deps, _truncate_rows, request_scope_problem\n","newString":"from harness.tools import Deps, _truncate_rows, request_scope_problem\n\npytestmark = pytest.mark.usefixtures(\"usage_log_dir\")\n","originalFile":"\"\"\"M3 — the assembled agent, with the model scripted and everything else real.\n\nTwo halves:\n\n1. **Replay.** Every golden case is run through the production path — the real\n   tools, the real subprocess emitter, the real rendering gate, the real\n   envelope assembly — with a `FunctionModel` replaying the reference solution's\n   decisions. The resulting transcript is graded by the same graders M2 built.\n   This is M3's exit condition: the machinery carries a correct decision through\n   to a correct rendered answer, on all 34 cases.\n\n2. **Guardrails.** Scripted loops that exercise the mechanical behaviour a live\n   model must never be trusted to get right: repair on `bad_request`, the repair\n   cap, the refusal short-circuit, the operational stop, the budget trip, and\n   the output gates. Each asserts on the transcript, not on a self-report.\n\nNothing here needs a network, a credential, or the data project.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport json\nimport sys\nimport time\nfrom pathlib import Path\nfrom typing import Any\n\nimport pytest\nfrom pydantic_ai.exceptions import UnexpectedModelBehavior\nfrom pydantic_ai.messages import ModelMessage, ModelResponse, ToolCallPart\nfrom pydantic_ai.models.function import AgentInfo, FunctionModel\n\nfrom config import settings\nfrom evals import replay as replay_mod\nfrom evals.graders import failures, grade_case\nfrom evals.schema import load_cases, load_reference_solutions\nfrom harness import retry as retry_mod, usage\nfrom harness.agent import ask, build_agent\nfrom harness.errors import TerminalError, TransientError\nfrom harness.evidence import EvidenceClient\nfrom harness.outputs import BudgetExceeded, RenderedAnswer, Unsupported\nfrom harness.tools import Deps, _truncate_rows, request_scope_problem\n\nPROJECT_ROOT = Path(__file__).resolve().parents[2]\nSTUB = PROJECT_ROOT / \"evals\" / \"stub_emitter.py\"\n\nCASES = load_cases()\nCASES_BY_ID = {c.case_id: c for c in CASES}\nREFERENCES = load_reference_solutions()\n\n\ndef stub_client(**kwargs) -> EvidenceClient:\n    return EvidenceClient(python=Path(sys.executable), emitter=STUB, **kwargs)\n\n\n# --------------------------------------------------------------------------\n# 1. replay every golden case through the production path\n# --------------------------------------------------------------------------\n\n\n@pytest.mark.parametrize(\"case\", CASES, ids=lambda c: c.case_id)\ndef test_golden_case_replays_and_passes_every_grader(case):\n    record = asyncio.run(replay_mod.replay(case, REFERENCES[case.case_id], stub_client()))\n    failed = failures(grade_case(case, record))\n    assert not failed, \"; \".join(f\"{r.grader}: {r.detail}\" for r in failed)\n\n\ndef test_a_replayed_answer_carries_the_envelope_the_tool_returned():\n    \"\"\"Envelope preservation is by construction, not by good behaviour: the\n    model never saw these fields, so it cannot have paraphrased them.\"\"\"\n    case = CASES_BY_ID[\"answer/VC-POC-01\"]\n    agent = build_agent(model=replay_mod.scripted_model(REFERENCES[case.case_id]))\n    deps = Deps(client=stub_client())\n    output = asyncio.run(ask(agent, deps, case.phrasings[0]))\n\n    assert isinstance(output, RenderedAnswer)\n    envelope = deps.last_envelope\n    assert output.limitations == envelope[\"limitations\"]\n    assert output.confidence == envelope[\"confidence\"]\n    assert output.provenance == envelope[\"provenance\"]\n    assert output.evidence == envelope[\"evidence\"]\n    assert output.contract_version == envelope[\"contract_version\"]\n\n\ndef test_the_model_has_no_field_in_which_to_alter_a_limitation():\n    \"\"\"The structural half of ADR-013: `AnswerDraft` is the only thing the model\n    returns, and it carries no preserved field at all.\"\"\"\n    from harness.outputs import AnswerDraft\n\n    assert set(AnswerDraft.model_fields) == {\n        \"kind\",\n        \"question_id\",\n        \"answer\",\n        \"data_status_note\",\n    }\n\n\n# --------------------------------------------------------------------------\n# 2. guardrails — scripted loops\n# --------------------------------------------------------------------------\n\n\ndef script(*steps: tuple[str, dict[str, Any]]) -> FunctionModel:\n    \"\"\"A model that makes one scripted call per turn, in order.\n\n    Indexed by responses produced, so a `ModelRetry` advances to the next step —\n    which is what a repair test wants: turn one sends the broken request, turn\n    two sends the fixed one.\n    \"\"\"\n\n    def fn(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:\n        produced = sum(1 for m in messages if isinstance(m, ModelResponse))\n        name, args = steps[min(produced, len(steps) - 1)]\n        return ModelResponse(parts=[ToolCallPart(name, args)])\n\n    return FunctionModel(fn)\n\n\ndef repeat(name: str, args: dict[str, Any]) -> FunctionModel:\n    \"\"\"A model that makes the same call forever — a stubborn agent, which is the\n    only way to prove a cap is a cap.\"\"\"\n\n    def fn(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:\n        return ModelResponse(parts=[ToolCallPart(name, args)])\n\n    return FunctionModel(fn)\n\n\ndef run(model: FunctionModel, question: str = \"q\", **client_kwargs) -> tuple[Any, Deps]:\n    agent = build_agent(model=model)\n    deps = Deps(client=stub_client(**client_kwargs))\n    return asyncio.run(ask(agent, deps, question)), deps\n\n\nANSWER_TOOL = \"final_result_AnswerDraft\"\nCLARIFY_TOOL = \"final_result_ClarificationNeeded\"\nUNSUPPORTED_TOOL = \"final_result_Unsupported\"\n\n# A grounded answer over the canonical VC-POC-01 fixture, for tests whose subject\n# is the control envelope rather than the prose.\nANSWER_ARGS = {\n    \"question_id\": \"VC-POC-01\",\n    \"answer\": \"Enrolments run 612 in 2019 and 668 in 2023.\",\n    \"data_status_note\": \"\",\n}\n\n\ndef test_bad_request_is_repaired_and_the_run_continues():\n    \"\"\"`bad_request` → ModelRetry. The second, reshaped request succeeds and the\n    run answers, with both attempts visible in the transcript.\"\"\"\n    output, deps = run(\n        script(\n            (\"fetch_evidence\", {\"question_id\": \"VC-POC-01\", \"request\": {\"acara_sml_id\": 40387}}),\n            (\n                \"fetch_evidence\",\n                {\n                    \"question_id\": \"VC-POC-01\",\n                    \"request\": {\"acara_sml_id\": 40387, \"metrics\": [\"total_enrolments\", \"teaching_fte\"]},\n                },\n            ),\n            (\n                ANSWER_TOOL,\n                {\n                    \"question_id\": \"VC-POC-01\",\n                    \"answer\": \"Enrolments run 612 in 2019 and 668 in 2023.\",\n                    \"data_status_note\": \"\",\n                },\n            ),\n        )\n    )\n    assert isinstance(output, RenderedAnswer)\n    kinds = [c.error_kind for c in deps.tool_calls if c.tool == \"fetch_evidence\"]\n    assert kinds == [\"bad_request\", None]\n    assert deps.repair_attempts == 0, \"a successful fetch resets the repair budget\"\n\n\ndef test_an_unanswerable_request_abstains_without_consuming_repair():\n    \"\"\"v0.3.0: a valid, registered request whose required fact is absent returns\n    `unanswerable`. The harness abstains AT ONCE — one call, no retry — and the\n    repair counter is never touched (item 8: unanswerable must not consume a\n    repair attempt).\"\"\"\n    output, deps = run(\n        repeat(\"fetch_evidence\", {\"question_id\": \"VC-POC-05\", \"request\": {\"acara_sml_id\": 99999}})\n    )\n    assert isinstance(output, Unsupported)\n    assert output.reason_kind == \"unanswerable\"\n    assert \"no published SA2\" in output.reason\n    attempts = [c for c in deps.tool_calls if c.tool == \"fetch_evidence\"]\n    assert len(attempts) == 1, \"unanswerable abstains immediately, it does not retry\"\n    assert deps.repair_attempts == 0, \"unanswerable must not consume a repair attempt\"\n\n\ndef test_a_repeated_bad_request_stops_at_the_cap():\n    \"\"\"A model that keeps resending a repairable-but-unrepaired `bad_request`\n    stops at the cap; the honest outcome is a refusal quoting the data layer's\n    own message, not another attempt.\"\"\"\n    output, deps = run(\n        repeat(\n            \"fetch_evidence\",\n            {\"question_id\": \"VC-POC-01\", \"request\": {\"acara_sml_id\": 40387, \"metrics\": [\"not_a_metric\"]}},\n        )\n    )\n    assert isinstance(output, Unsupported)\n    assert output.reason_kind == \"out_of_scope\"\n    attempts = [c for c in deps.tool_calls if c.tool == \"fetch_evidence\"]\n    assert len(attempts) == settings.MAX_REPAIR_ATTEMPTS + 1\n    assert all(c.error_kind == \"bad_request\" for c in attempts)\n\n\ndef test_an_excluded_question_short_circuits_and_is_never_retried():\n    \"\"\"The refusal IS the answer. One call, no retry, and the reason is the\n    emitter's own words rather than anything the harness composed.\"\"\"\n    output, deps = run(\n        repeat(\"fetch_evidence\", {\"question_id\": \"VC-POC-TRANSPORT-01\", \"request\": {}})\n    )\n    assert isinstance(output, Unsupported)\n    assert output.reason_kind == \"excluded_by_contract\"\n    assert \"public transport\" in output.reason.lower()\n    assert len([c for c in deps.tool_calls if c.tool == \"fetch_evidence\"]) == 1\n\n\ndef test_a_gated_question_preserves_its_registry_reason_code():\n    \"\"\"A registered capability awaiting validation is distinct from a general\n    contract exclusion, and the machine-readable contract reason survives.\"\"\"\n    output, deps = run(\n        repeat(\n            \"fetch_evidence\",\n            {\"question_id\": \"VC-POC-14\", \"request\": {\"acara_sml_id\": 40387}},\n        )\n    )\n    assert isinstance(output, Unsupported)\n    assert output.reason_kind == \"not_yet_validated\"\n    assert output.reason_code == \"not_yet_validated\"\n    assert len([c for c in deps.tool_calls if c.tool == \"fetch_evidence\"]) == 1\n\n\ndef test_an_unknown_question_short_circuits_to_not_in_registry():\n    output, deps = run(\n        repeat(\"fetch_evidence\", {\"question_id\": \"VC-POC-NOT-REAL\", \"request\": {}})\n    )\n    assert isinstance(output, Unsupported)\n    assert output.reason_kind == \"not_in_registry\"\n    assert len([c for c in deps.tool_calls if c.tool == \"fetch_evidence\"]) == 1\n\n\n@pytest.mark.parametrize(\n    \"question_id,request_payload\",\n    [\n        (\"VC-POC-12\", {\"sa2_codes\": [\"000000000\"]}),\n        (\"VC-POC-13\", {\"sa2_codes\": [\"000000000\"]}),\n    ],\n)\ndef test_an_operational_error_stops_the_run(question_id, request_payload):\n    \"\"\"`data_unavailable` and `internal` are operational stops: not a retry, not\n    an abstention, and never dressed up as an answer.\"\"\"\n    with pytest.raises(TerminalError):\n        run(repeat(\"fetch_evidence\", {\"question_id\": question_id, \"request\": request_payload}))\n\n\ndef test_the_tool_call_budget_returns_a_typed_outcome(monkeypatch):\n    monkeypatch.setattr(settings, \"LOOP_MAX_TOOL_CALLS\", 2)\n    output, deps = run(repeat(\"search_schools\", {\"search\": \"FIXTURE\"}))\n    assert isinstance(output, BudgetExceeded)\n    assert output.limit in (\"tool_calls\", \"steps\")\n    assert \"resolved school IDs\" in output.learned_so_far\n\n\ndef test_the_wall_clock_budget_returns_a_typed_outcome(monkeypatch):\n    monkeypatch.setattr(settings, \"LOOP_MAX_SECONDS\", 0.001)\n    output, _ = run(repeat(\"search_schools\", {\"search\": \"FIXTURE\"}))\n    assert isinstance(output, BudgetExceeded)\n    assert output.limit == \"seconds\"\n\n\ndef test_the_wall_clock_deadline_bounds_the_whole_call_not_one_attempt(monkeypatch):\n    \"\"\"O-9, closed. The deadline is computed once and shared across retry\n    attempts, so a run that keeps hitting transient faults cannot spend\n    `MAX_ATTEMPTS x LOOP_MAX_SECONDS`. Backoff is neutralised here because the\n    property under test is the deadline, not tenacity's sleep schedule.\"\"\"\n    monkeypatch.setattr(settings, \"LOOP_MAX_SECONDS\", 0.4)\n    monkeypatch.setattr(retry_mod, \"_wait\", lambda retry_state: 0.0)\n    attempts: list[int] = []\n\n    async def slow_transient_fault(messages: list[ModelMessage], info: AgentInfo):\n        attempts.append(1)\n        await asyncio.sleep(0.3)\n        raise TransientError(\"simulated 429\")\n\n    started = time.monotonic()\n    output, _ = run(FunctionModel(slow_transient_fault))\n    elapsed = time.monotonic() - started\n\n    assert isinstance(output, BudgetExceeded)\n    assert output.limit == \"seconds\"\n    assert \"whole call\" in output.detail\n    assert len(attempts) > 1, \"the transient fault should have been retried at least once\"\n    assert elapsed < settings.LOOP_MAX_SECONDS * retry_mod.MAX_ATTEMPTS, (\n        f\"took {elapsed:.2f}s against a {settings.LOOP_MAX_SECONDS}s budget — the \"\n        \"deadline is bounding one attempt, not the call\"\n    )\n\n\ndef test_the_spend_budget_returns_a_typed_outcome(monkeypatch):\n    \"\"\"O-7, closed. Cost is measured from the run's own message history between\n    steps; a breach is a typed outcome like every other budget (ADR-004).\"\"\"\n    monkeypatch.setattr(settings, \"LOOP_MAX_USD\", 0.01)\n    monkeypatch.setattr(usage, \"_cost_usd\", lambda response: 0.02)\n    output, deps = run(repeat(\"search_schools\", {\"search\": \"FIXTURE\"}))\n    assert isinstance(output, BudgetExceeded)\n    assert output.limit == \"usd\"\n    assert \"0.02\" in output.detail\n    # It trips at the first check — after the response that spent the money and\n    # before the tool call that response asked for. That is what \"enforced\n    # between steps\" means: the budget stops the NEXT request, never the one\n    # that crossed the line.\n    assert not deps.tool_calls\n    assert output.learned_so_far == \"\"\n\n\ndef test_an_unpriced_model_cannot_trip_the_spend_budget(monkeypatch):\n    \"\"\"The hazard the `cost_complete` flag exists to record: a model unknown to\n    the price database measures as $0, so the spend budget is not watching. The\n    run must still complete normally rather than tripping on a phantom figure.\"\"\"\n    monkeypatch.setattr(settings, \"LOOP_MAX_USD\", 0.0)\n    output, _ = run(\n        script(\n            (\n                \"fetch_evidence\",\n                {\n                    \"question_id\": \"VC-POC-01\",\n                    \"request\": {\n                        \"acara_sml_id\": 40387,\n                        \"metrics\": [\"total_enrolments\", \"teaching_fte\"],\n                    },\n                },\n            ),\n            (ANSWER_TOOL, ANSWER_ARGS),\n        )\n    )\n    assert isinstance(output, RenderedAnswer)\n\n\ndef test_the_message_history_comes_back_for_a_clarification_round_trip():\n    \"\"\"Architecture §7: PydanticAI's message history IS the session store. A\n    caller answering a ClarificationNeeded needs it, so `ask()` hands it back on\n    `deps` rather than making the caller reach into the agent.\"\"\"\n    output, deps = run(\n        script(\n            (\n                CLARIFY_TOOL,\n                {\n                    \"question_id\": \"VC-POC-08\",\n                    \"missing\": [\n                        {\n                            \"input\": \"distance_km\",\n                            \"why_material\": '\"Near\" is not a distance.',\n                            \"allowed_values\": [],\n                        }\n                    ],\n                    \"prompt_to_user\": \"What radius should I use?\",\n                },\n            )\n        )\n    )\n    assert output.kind == \"clarification\"\n    assert deps.last_messages, \"no history to carry the reply back on\"\n\n\ndef test_a_budget_trip_still_records_its_usage(monkeypatch, tmp_path):\n    \"\"\"ADR-005. The run that cost money and returned nothing is the one whose\n    cost record matters most, so telemetry is written on every branch.\"\"\"\n    monkeypatch.setattr(settings, \"USAGE_LOG_DIR\", tmp_path)\n    monkeypatch.setattr(settings, \"LOOP_MAX_TOOL_CALLS\", 2)\n    output, _ = run(repeat(\"search_schools\", {\"search\": \"FIXTURE\"}))\n    assert isinstance(output, BudgetExceeded)\n\n    lines = [\n        json.loads(line)\n        for path in tmp_path.glob(\"usage-*.jsonl\")\n        for line in path.read_text(\"utf-8\").splitlines()\n    ]\n    summaries = [r for r in lines if r[\"record_type\"] == \"run_summary\"]\n    assert summaries, \"a budget trip wrote no usage record\"\n    assert summaries[-1][\"output_branch\"] == \"BudgetExceeded\"\n\n\ndef test_a_budget_breach_never_returns_a_partial_answer(monkeypatch):\n    monkeypatch.setattr(settings, \"LOOP_MAX_TOOL_CALLS\", 1)\n    output, _ = run(\n        script(\n            (\n                \"fetch_evidence\",\n                {\n                    \"question_id\": \"VC-POC-01\",\n                    \"request\": {\"acara_sml_id\": 40387, \"metrics\": [\"total_enrolments\", \"teaching_fte\"]},\n                },\n            ),\n            (\"search_schools\", {\"search\": \"FIXTURE\"}),\n            (\"search_schools\", {\"search\": \"FIXTURE\"}),\n        )\n    )\n    assert isinstance(output, BudgetExceeded)\n    assert \"fetched evidence for VC-POC-01\" in output.learned_so_far\n    assert not hasattr(output, \"answer\")\n\n\n# -- the output gates --------------------------------------------------------\n\n\ndef test_an_ungrounded_answer_is_sent_back_to_the_model():\n    \"\"\"A model that keeps inventing a figure exhausts its output retries rather\n    than having the figure rendered.\"\"\"\n    deps = Deps(client=stub_client())\n    agent = build_agent(\n        model=script(\n                (\n                    \"fetch_evidence\",\n                    {\n                        \"question_id\": \"VC-POC-01\",\n                        \"request\": {\"acara_sml_id\": 40387, \"metrics\": [\"total_enrolments\", \"teaching_fte\"]},\n                    },\n                ),\n                *[\n                    (\n                        ANSWER_TOOL,\n                        {\n                            \"question_id\": \"VC-POC-01\",\n                            \"answer\": \"Enrolments grew 9.15% over the period.\",\n                            \"data_status_note\": \"\",\n                        },\n                    )\n                ]\n                * 3,\n            )\n        )\n    with pytest.raises(UnexpectedModelBehavior):\n        asyncio.run(ask(agent, deps, \"q\"))\n    assert deps.output_validation_failures\n    assert any(\"9.15\" in problem for problem in deps.output_validation_failures[-1])\n\n\ndef test_answering_without_fetching_evidence_is_refused():\n    with pytest.raises(UnexpectedModelBehavior):\n        run(\n            script(\n                *[\n                    (\n                        ANSWER_TOOL,\n                        {\n                            \"question_id\": \"VC-POC-01\",\n                            \"answer\": \"Enrolments look healthy.\",\n                            \"data_status_note\": \"\",\n                        },\n                    )\n                ]\n                * 3\n            )\n        )\n\n\ndef test_asking_about_a_defaultable_input_is_refused():\n    \"\"\"The materials gate (architecture §7) runs both ways: the model can neither\n    skip a material input nor spend a turn asking about one the data layer\n    defaults and echoes back.\"\"\"\n    with pytest.raises(UnexpectedModelBehavior):\n        run(\n            script(\n                *[\n                    (\n                        CLARIFY_TOOL,\n                        {\n                            \"question_id\": \"VC-POC-01\",\n                            \"missing\": [\n                                {\n                                    \"input\": \"year_start\",\n                                    \"why_material\": \"I need a year range.\",\n                                    \"allowed_values\": [],\n                                }\n                            ],\n                            \"prompt_to_user\": \"Which years?\",\n                        },\n                    )\n                ]\n                * 3\n            )\n        )\n\n\ndef test_asking_for_a_genuinely_material_input_is_accepted():\n    output, deps = run(\n        script(\n            (\n                CLARIFY_TOOL,\n                {\n                    \"question_id\": \"VC-POC-08\",\n                    \"missing\": [\n                        {\n                            \"input\": \"distance_km\",\n                            \"why_material\": \"\\\"Near\\\" is not a distance.\",\n                            \"allowed_values\": [],\n                        }\n                    ],\n                    \"prompt_to_user\": \"What radius should I use?\",\n                },\n            )\n        )\n    )\n    assert output.kind == \"clarification\"\n    assert not deps.tool_calls\n\n\ndef test_a_refusal_in_the_harnesss_own_words_is_refused():\n    \"\"\"ADR-009: a contract refusal must quote the contract.\"\"\"\n    with pytest.raises(UnexpectedModelBehavior):\n        run(\n            script(\n                *[\n                    (\n                        UNSUPPORTED_TOOL,\n                        {\n                            \"reason_kind\": \"excluded_by_contract\",\n                            \"reason\": \"Sorry, we do not hold that data.\",\n                            \"nearest_supported\": None,\n                        },\n                    )\n                ]\n                * 3\n            )\n        )\n\n\ndef test_model_cannot_invent_unanswerable_without_an_emitter_result():\n    \"\"\"The live VC-POC-03 miss: Claude skipped both directory searches and\n    declared two fixture schools absent. Unanswerable is emitter-owned fact.\"\"\"\n    with pytest.raises(UnexpectedModelBehavior):\n        run(\n            script(\n                *[\n                    (\n                        UNSUPPORTED_TOOL,\n                        {\n                            \"reason_kind\": \"unanswerable\",\n                            \"reason\": \"The named schools could not be matched.\",\n                            \"nearest_supported\": None,\n                        },\n                    )\n                ]\n                * 3\n            ),\n            question=\"How do students per teaching FTE compare at Alpha College and Beta Grammar?\",\n        )\n\n\ndef test_generic_teaching_staff_rejects_headcount_and_non_teaching_expansion():\n    problem = request_scope_problem(\n        \"How have enrolments and teaching staff at Alpha College moved?\",\n        \"VC-POC-01\",\n        {\n            \"acara_sml_id\": 40387,\n            \"metrics\": [\n                \"total_enrolments\",\n                \"teaching_fte\",\n                \"teaching_staff_headcount\",\n                \"non_teaching_fte\",\n            ],\n        },\n    )\n    assert problem and \"teaching_staff_headcount\" in problem and \"non_teaching_fte\" in problem\n\n\ndef test_explicit_headcount_and_non_teaching_wording_allows_those_metrics():\n    assert request_scope_problem(\n        \"Compare teaching headcount and non-teaching staff at these schools\",\n        \"VC-POC-04\",\n        {\"metrics\": [\"teaching_staff_headcount\", \"non_teaching_fte\"]},\n    ) is None\n\n\ndef test_scope_expansion_is_repaired_before_the_emitter_is_called():\n    output, deps = run(\n        script(\n            (\n                \"fetch_evidence\",\n                {\n                    \"question_id\": \"VC-POC-01\",\n                    \"request\": {\n                        \"acara_sml_id\": 40387,\n                        \"metrics\": [\n                            \"total_enrolments\",\n                            \"teaching_fte\",\n                            \"teaching_staff_headcount\",\n                            \"non_teaching_fte\",\n                        ],\n                    },\n                },\n            ),\n            (\n                \"fetch_evidence\",\n                {\n                    \"question_id\": \"VC-POC-01\",\n                    \"request\": {\n                        \"acara_sml_id\": 40387,\n                        \"metrics\": [\"total_enrolments\", \"teaching_fte\"],\n                    },\n                },\n            ),\n            (ANSWER_TOOL, ANSWER_ARGS),\n        ),\n        question=\"How have enrolments and teaching staff at Alpha College moved?\",\n    )\n    assert isinstance(output, RenderedAnswer)\n    attempts = [call for call in deps.tool_calls if call.tool == \"fetch_evidence\"]\n    assert [call.error_kind for call in attempts] == [\"request_scope\", None]\n\n\ndef test_two_named_schools_can_be_resolved_in_one_model_turn():\n    output, deps = run(\n        script(\n            (\"search_schools\", {\"search\": [\"Alpha College\", \"Beta Grammar\"]}),\n            (\n                \"fetch_evidence\",\n                {\n                    \"question_id\": \"VC-POC-03\",\n                    \"request\": {\n                        \"acara_sml_ids\": [40387, 40392],\n                        \"ratios\": [\"students_per_teaching_fte\"],\n                    },\n                },\n            ),\n            (\n                ANSWER_TOOL,\n                {\n                    \"question_id\": \"VC-POC-03\",\n                    \"answer\": \"Both returned series report 13.0 students per teaching FTE.\",\n                    \"data_status_note\": \"\",\n                },\n            ),\n        ),\n        question=(\n            \"How do students per teaching FTE compare at Alpha College and Beta Grammar?\"\n        ),\n    )\n    assert isinstance(output, RenderedAnswer)\n    searches = [call for call in deps.tool_calls if call.tool == \"search_schools\"]\n    assert len(searches) == 1\n    assert deps.resolved_school_ids == [40387, 40392]\n\n\ndef test_a_refusal_quoting_the_contract_is_accepted():\n    from harness import contract\n\n    reason = sorted(contract.exclusion_texts())[0]\n    output, _ = run(\n        script(\n            (\n                UNSUPPORTED_TOOL,\n                {\"reason_kind\": \"excluded_by_contract\", \"reason\": reason, \"nearest_supported\": None},\n            )\n        )\n    )\n    assert isinstance(output, Unsupported)\n    assert output.reason == reason\n\n\n# -- context discipline ------------------------------------------------------\n\n\ndef test_row_truncation_always_carries_a_marker():\n    \"\"\"A display that truncates without saying so is how a model comes to\n    believe a series ends where the screen did.\"\"\"\n    envelope = {\n        \"result\": {\"kind\": \"series\", \"data\": {\"rows\": [{\"i\": i} for i in range(500)]}},\n    }\n    trimmed = _truncate_rows(envelope)\n    assert len(trimmed[\"result\"][\"data\"][\"rows\"]) == settings.MAX_ROWS_IN_CONTEXT\n    assert trimmed[\"_truncated_for_context\"] == [\n        f\"rows: showing {settings.MAX_ROWS_IN_CONTEXT} of 500 rows\"\n    ]\n    assert \"_truncated_for_context\" not in envelope, \"the original envelope is not mutated\"\n\n\ndef test_truncation_does_not_narrow_what_grounding_accepts():\n    \"\"\"The gate grounds against the FULL envelope recorded on deps, so capping\n    what the model sees can never turn an honest figure into an ungrounded one.\"\"\"\n    case = CASES_BY_ID[\"answer/VC-POC-01\"]\n    agent = build_agent(model=replay_mod.scripted_model(REFERENCES[case.case_id]))\n    deps = Deps(client=stub_client())\n    asyncio.run(ask(agent, deps, case.phrasings[0]))\n    assert \"_truncated_for_context\" not in deps.last_envelope\n\n\ndef test_the_three_tools_are_the_whole_tool_surface():\n    \"\"\"Architecture §1: every extra tool is a way to answer a question the\n    contract never approved.\"\"\"\n    seen: dict[str, list[str]] = {}\n\n    def probe(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:\n        seen.setdefault(\"tools\", sorted(t.name for t in info.function_tools))\n        seen.setdefault(\"outputs\", sorted(t.name for t in info.output_tools))\n        return ModelResponse(\n            parts=[\n                ToolCallPart(\n                    UNSUPPORTED_TOOL,\n                    {\"reason_kind\": \"out_of_scope\", \"reason\": \"stop\", \"nearest_supported\": None},\n                )\n            ]\n        )\n\n    run(FunctionModel(probe))\n    assert seen[\"tools\"] == [\"fetch_evidence\", \"get_input_catalog\", \"search_schools\"]\n    assert seen[\"outputs\"] == [\n        \"final_result_AnswerDraft\",\n        \"final_result_ClarificationNeeded\",\n        \"final_result_Unsupported\",\n    ]\n\n\ndef test_a_fragment_of_a_contract_exclusion_is_not_a_quotation():\n    \"\"\"Substring matching alone would let \"fees\" pass as contract text. A\n    refusal has to quote the contract, not overlap with it.\"\"\"\n    from harness.outputs import Unsupported as U\n    from harness.tools import refusal_reason_is_contract_text\n\n    assert not refusal_reason_is_contract_text(\n        U(reason_kind=\"excluded_by_contract\", reason=\"fees\")\n    )\n    assert refusal_reason_is_contract_text(\n        U(\n            reason_kind=\"excluded_by_contract\",\n            reason=\"public transport, train, tram, bus, walking access, drive time, \"\n            \"traffic, catchments, or campus locations\",\n        )\n    )\n\n\n@pytest.mark.xfail(\n    strict=True,\n    reason=(\n        \"O-8: distance_km is conditionally material for VC-POC-05 (only when \"\n        \"market_definition == distance). v0.3's registry now DECLARES that condition \"\n        \"(input_policy.conditional_material), but the ClarificationNeeded output carries no \"\n        \"market_definition value, so the gate still cannot evaluate the condition and treats \"\n        \"asking for a radius as allowed. Wiring the condition into the gate is the remaining \"\n        \"step; if this starts passing, update O-8 in docs/decisions.md and delete this marker.\"\n    ),\n)\ndef test_a_radius_is_not_material_when_the_market_is_not_distance():\n    from harness.agent import _validate\n    from harness.outputs import ClarificationNeeded, MissingInput\n\n    asking_for_a_radius = ClarificationNeeded(\n        question_id=\"VC-POC-05\",\n        missing=[MissingInput(input=\"distance_km\", why_material=\"how far?\", allowed_values=[])],\n        prompt_to_user=\"What radius should I use?\",\n    )\n    assert _validate(Deps(client=stub_client()), asking_for_a_radius)\n","structuredPatch":[{"oldStart":42,"oldLines":6,"newStart":42,"newLines":8,"lines":[" from harness.outputs import BudgetExceeded, RenderedAnswer, Unsupported"," from harness.tools import Deps, _truncate_rows, request_scope_problem"," ","+pytestmark = pytest.mark.usefixtures(\"usage_log_dir\")","+"," PROJECT_ROOT = Path(__file__).resolve().parents[2]"," STUB = PROJECT_ROOT / \"evals\" / \"stub_emitter.py\""," "]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true}}
