{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018eXpMb44zwKopgK73hct8J","type":"tool_result","content":"The file /Users/shane/Projects/k-12Harness/tests/unit/test_live_tier.py has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"908c0fb5-3108-4d6f-a1a1-3f2f79af6fb0","uuid":"5b9ef7e8-472b-4dbb-9eb8-9951ea6f37c0","timestamp":"2026-10-07T22:30:13.621Z","tool_use_result":{"filePath":"/Users/shane/Projects/k-12Harness/tests/unit/test_live_tier.py","oldString":"from harness.intent import StructuredIntent\n","newString":"from harness.intent import StructuredIntent\n\npytestmark = pytest.mark.usefixtures(\"usage_log_dir\")\n","originalFile":"\"\"\"M4 — the live tier's machinery, exercised offline.\n\nThe live tier spends real tokens, so it runs manually and never gates a PR. But\nits *arithmetic* must not wait for a paid run to be checked: a reporting bug in\n`pass@k` / `pass^k` would misreport every live result afterwards, and the number\nthat gets misreported is always the flattering one.\n\nSo everything here runs the real runner — `run_trial`, `run_suite`, the\nsummariser, the report writer — with the model scripted. What is NOT proved here\nis the only thing the live tier exists to measure: whether a real model makes\nthe right decisions. That gap is the point of the tier, not an omission.\n\nThe paid tier itself is `tests/live/test_live_eval.py`, marked `live` and\nexcluded by `pytest.ini`.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport ast\nimport asyncio\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nimport pytest\nfrom pydantic_ai.messages import ModelMessage, ModelResponse, ToolCallPart\nfrom pydantic_ai.models.function import AgentInfo, FunctionModel\n\nfrom evals import live, replay as replay_mod\nfrom evals.live import CaseReport, TrialResult, aggregate, summarise\nfrom evals.schema import load_cases, load_reference_solutions\nfrom harness.agent import build_agent\nfrom harness.intent import StructuredIntent\n\nPROJECT_ROOT = Path(__file__).resolve().parents[2]\n\nCASES = {c.case_id: c for c in load_cases()}\nREFERENCES = load_reference_solutions()\n\n# In pydantic-ai 1.106.0, a single (non-union) output type uses \"final_result\"\n# as the tool name (see tests/unit/test_intent_boundary.py). Both the intent\n# and narration agents have single output types.\nINTENT_TOOL = \"final_result\"\nNARRATION_TOOL = \"final_result\"\n\n\ndef make_intent_model(intent: StructuredIntent) -> FunctionModel:\n    \"\"\"A model that returns a fixed StructuredIntent immediately.\"\"\"\n    payload = intent.model_dump()\n\n    def fn(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:\n        return ModelResponse(parts=[ToolCallPart(INTENT_TOOL, payload)])\n\n    return FunctionModel(fn)\n\n\ndef make_narration_model(answer: str) -> FunctionModel:\n    \"\"\"A model that returns fixed narration immediately.\"\"\"\n\n    def fn(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:\n        return ModelResponse(parts=[ToolCallPart(NARRATION_TOOL, {\"answer\": answer})])\n\n    return FunctionModel(fn)\n\n\ndef _drop_generated_utc(output: dict) -> dict:\n    \"\"\"Two separate stub-emitter fetches stamp `provenance.generated_utc` with\n    the wall clock at call time (second precision), so two runs a moment apart\n    can legitimately disagree on that one field alone — the same reason\n    `evals/schema.py` notes the replay-equality rule excludes it (CR-6). Strip\n    it before comparing two records for otherwise-exact equality.\"\"\"\n    out = dict(output)\n    provenance = out.get(\"provenance\")\n    if isinstance(provenance, dict) and \"generated_utc\" in provenance:\n        out = dict(out)\n        out[\"provenance\"] = {k: v for k, v in provenance.items() if k != \"generated_utc\"}\n    return out\n\n\ndef trial(passed: bool, graders: list[str] | None = None, **kwargs) -> TrialResult:\n    return TrialResult(\n        case_id=\"c\",\n        direction=\"should_answer\",\n        phrasing=\"p\",\n        trial=1,\n        passed=passed,\n        failed_graders=graders or [],\n        **kwargs,\n    )\n\n\n# --------------------------------------------------------------------------\n# pass@k and pass^k measure different things, and the difference is the point\n# --------------------------------------------------------------------------\n\n\ndef test_one_pass_in_three_is_capability_without_reliability():\n    report = summarise(\"c\", \"should_answer\", [trial(True), trial(False), trial(False)])\n    assert report.pass_at_k == 1.0, \"it managed it once — that is capability\"\n    assert report.pass_hat_k == 0.0, \"it failed twice — that is not shippable\"\n\n\ndef test_all_passing_is_reliable():\n    report = summarise(\"c\", \"should_answer\", [trial(True), trial(True), trial(True)])\n    assert (report.pass_at_k, report.pass_hat_k) == (1.0, 1.0)\n\n\ndef test_none_passing_scores_zero_on_both():\n    report = summarise(\"c\", \"should_answer\", [trial(False), trial(False)])\n    assert (report.pass_at_k, report.pass_hat_k) == (0.0, 0.0)\n\n\ndef test_a_single_trial_cannot_look_reliable_by_being_alone():\n    \"\"\"k=1 makes pass@k and pass^k identical, which is honest — it just means a\n    k=1 run has measured capability and nothing about reliability.\"\"\"\n    report = summarise(\"c\", \"should_answer\", [trial(True)])\n    assert report.pass_at_k == report.pass_hat_k == 1.0\n\n\ndef test_failed_graders_are_counted_for_error_analysis():\n    report = summarise(\n        \"c\",\n        \"should_answer\",\n        [trial(False, [\"grounding\"]), trial(False, [\"grounding\", \"empty_stated\"])],\n    )\n    assert report.failed_graders == {\"grounding\": 2, \"empty_stated\": 1}\n\n\ndef test_a_crashed_trial_counts_as_a_failure_not_a_skip():\n    \"\"\"An eval that drops the runs that blew up reports a better score than it\n    earned — the same rule `grade_suite` follows for missing records.\"\"\"\n    crashed = trial(False)\n    crashed.error = \"EmitterFailure: exit 3\"\n    report = summarise(\"c\", \"should_answer\", [trial(True), crashed])\n    assert report.passes == 1\n    assert report.pass_hat_k == 0.0\n    assert report.failed_graders == {\"error\": 1}\n\n\ndef test_aggregate_averages_over_cases_and_counts_errors():\n    reports = [\n        CaseReport(\"a\", \"should_answer\", 2, 2, 1.0, 1.0),\n        CaseReport(\"b\", \"should_answer\", 2, 1, 1.0, 0.0),\n    ]\n    errored = trial(False)\n    errored.error = \"boom\"\n    totals = aggregate(reports, [trial(True), errored])\n    assert totals[\"pass_at_k\"] == 1.0\n    assert totals[\"pass_hat_k\"] == 0.5\n    assert totals[\"errored_trials\"] == 1\n\n\ndef test_aggregate_survives_an_empty_selection():\n    assert aggregate([], [])[\"cases\"] == 0\n\n\ndef test_an_unpriced_run_does_not_claim_its_cost_is_complete():\n    \"\"\"`cost: None (complete=True)` asserted that a null figure was the whole\n    story. `complete` now means every trial was priced AND something was.\"\"\"\n    totals = aggregate([CaseReport(\"a\", \"should_answer\", 1, 0, 0.0, 0.0)], [trial(False)])\n    assert totals[\"cost_usd\"] is None\n    assert totals[\"cost_complete\"] is False\n\n\ndef test_a_priced_run_reports_its_cost_as_complete():\n    priced = trial(True, cost_usd=0.02, cost_complete=True)\n    totals = aggregate([CaseReport(\"a\", \"should_answer\", 1, 1, 1.0, 1.0)], [priced])\n    assert totals[\"cost_usd\"] == 0.02\n    assert totals[\"cost_complete\"] is True\n\n\n# --------------------------------------------------------------------------\n# a rejected credential ends the run; it is not a measurement\n# --------------------------------------------------------------------------\n\n\ndef test_a_rejected_credential_stops_the_run_instead_of_scoring_it():\n    \"\"\"The M4 first-run failure: one placeholder key produced 100 identical\n    \"failed trials\", pass@k 0.0, and a report that read as a model problem. An\n    auth failure says nothing about judgement, so it must not enter the score.\"\"\"\n    from pydantic_ai.exceptions import ModelHTTPError\n\n    case = CASES[\"answer/VC-POC-01\"]\n\n    def rejecting_factory():\n        raise ModelHTTPError(\n            status_code=401,\n            model_name=\"claude-sonnet-4-6\",\n            body={\"error\": {\"message\": \"API key is invalid.\"}},\n        )\n\n    with pytest.raises(live.CredentialsRejected):\n        asyncio.run(live.run_trial(case, case.phrasings[0], 1, \"stub\", rejecting_factory))\n\n\ndef test_a_rejected_credential_aborts_the_whole_suite():\n    from pydantic_ai.exceptions import ModelHTTPError\n\n    def rejecting_factory():\n        raise ModelHTTPError(status_code=401, model_name=\"x\", body={})\n\n    with pytest.raises(live.CredentialsRejected):\n        asyncio.run(\n            live.run_suite(\n                list(CASES.values())[:3], k=3, emitter=\"stub\", agent_factory=rejecting_factory\n            )\n        )\n\n\ndef test_other_provider_failures_are_still_ordinary_failed_trials():\n    \"\"\"Only auth aborts. A 500 or a timeout is a trial result — the tier exists\n    to measure a flaky world, not to give up on it.\"\"\"\n    from pydantic_ai.exceptions import ModelHTTPError\n\n    case = CASES[\"answer/VC-POC-01\"]\n\n    def failing_factory():\n        raise ModelHTTPError(status_code=500, model_name=\"x\", body={})\n\n    result, record = asyncio.run(\n        live.run_trial(case, case.phrasings[0], 1, \"stub\", failing_factory)\n    )\n    assert not result.passed and result.error and record is None\n\n\n# --------------------------------------------------------------------------\n# the runner, with the model scripted\n# --------------------------------------------------------------------------\n\n\ndef scripted_factory(case_id: str):\n    record = REFERENCES[case_id]\n    return lambda: build_agent(model=replay_mod.scripted_model(record))\n\n\ndef test_a_correct_run_grades_as_a_pass_through_the_real_runner():\n    case = CASES[\"answer/VC-POC-01\"]\n    result, record = asyncio.run(\n        live.run_trial(case, case.phrasings[0], 1, \"stub\", scripted_factory(case.case_id))\n    )\n    assert result.passed, result.detail\n    assert result.output_kind == \"RenderedAnswer\"\n    assert record is not None\n\n\ndef test_a_wrong_decision_grades_as_a_failure_and_says_which_grader():\n    \"\"\"A run that completes but decides wrongly — here, asking about a radius\n    when the question needed a peer filter. The runner must name the grader that\n    objected: a live failure with no named grader is a transcript nobody reads.\"\"\"\n    case = CASES[\"clarify/peer_filters\"]\n    wrong = CASES[\"clarify/distance_km\"]\n    result, record = asyncio.run(\n        live.run_trial(case, case.phrasings[0], 1, \"stub\", scripted_factory(wrong.case_id))\n    )\n    assert not result.passed\n    assert result.error is None, \"this run completed — it was wrong, not broken\"\n    assert result.failed_graders\n    assert result.detail\n    assert record is not None, \"a wrong answer is exactly the transcript to keep\"\n\n\ndef test_a_run_that_breaks_is_distinguishable_from_a_run_that_is_wrong():\n    \"\"\"`error` set means the run never produced a gradeable outcome. Collapsing\n    the two would put provider outages into the pass^k denominator as model\n    failures.\"\"\"\n    case = CASES[\"answer/VC-POC-02\"]\n    incompatible = CASES[\"answer/VC-POC-01\"]\n    result, _ = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", scripted_factory(incompatible.case_id)\n        )\n    )\n    assert not result.passed\n    assert result.error and not result.failed_graders\n\n\ndef test_a_trial_that_raises_is_recorded_rather_than_lost():\n    case = CASES[\"answer/VC-POC-01\"]\n\n    def exploding_factory():\n        raise RuntimeError(\"provider is down\")\n\n    result, record = asyncio.run(\n        live.run_trial(case, case.phrasings[0], 1, \"stub\", exploding_factory)\n    )\n    assert not result.passed\n    assert \"provider is down\" in result.error\n    assert record is None\n\n\ndef test_run_suite_reports_every_trial_and_writes_readable_transcripts(tmp_path):\n    case = CASES[\"answer/VC-POC-01\"]\n    reports, trials, transcripts, interruption = asyncio.run(\n        live.run_suite([case], k=2, emitter=\"stub\", agent_factory=scripted_factory(case.case_id))\n    )\n    assert interruption is None\n    assert reports[0].trials == 2 and reports[0].passes == 2\n    assert len(trials) == 2\n    path = live.write_report(\n        {\"totals\": aggregate(reports, trials)}, transcripts, tmp_path\n    )\n    saved = json.loads(path.read_text(\"utf-8\"))\n    assert saved[\"totals\"][\"pass_hat_k\"] == 1.0\n    sibling = json.loads(\n        next(tmp_path.glob(\"*-transcripts.json\")).read_text(\"utf-8\")\n    )\n    # The prose is what a human reads when a case fails; a report that dropped it\n    # would make error analysis impossible.\n    assert sibling[\"records\"][0][\"output\"][\"answer\"]\n\n\n# --------------------------------------------------------------------------\n# selection and the O-10 pressure probe\n# --------------------------------------------------------------------------\n\n\ndef test_pressure_appends_the_red_team_phrasings():\n    case = CASES[\"answer/VC-POC-01\"]\n    phrasings = live.phrasings_for(case, pressure=True, all_phrasings=False)\n    assert len(phrasings) == len(live.PRESSURE_PHRASINGS)\n    assert all(p.startswith(case.phrasings[0]) for p in phrasings)\n\n\ndef test_pressure_k_is_total_trials_not_phrasings_times_trials():\n    case = CASES[\"answer/VC-POC-01\"]\n    slots = live.trial_slots([case], k=5, pressure=True, all_phrasings=False)\n    assert len(slots) == 5\n    assert len({phrasing for _, phrasing, _ in slots}) == 5\n\n\ndef test_quota_stops_without_recording_a_model_failure():\n    from harness.errors import QuotaExceeded\n\n    case = CASES[\"answer/VC-POC-01\"]\n\n    def exhausted_factory():\n        raise QuotaExceeded(\n            \"Claude subscription quota exhausted; resets tonight\",\n            provider=\"claude-account\",\n            reset_at=\"tonight\",\n        )\n\n    reports, trials, transcripts, interruption = asyncio.run(\n        live.run_suite([case], k=3, emitter=\"stub\", agent_factory=exhausted_factory)\n    )\n    assert not reports and not trials and not transcripts\n    assert interruption and interruption.kind == \"quota_exhausted\"\n    assert interruption.reset_at == \"tonight\"\n    assert live.aggregate(reports, trials)[\"pass_at_k\"] is None\n\n\ndef test_chunked_suite_resumes_without_repeating_completed_trials():\n    case = CASES[\"answer/VC-POC-01\"]\n    factory = scripted_factory(case.case_id)\n    reports, first, transcripts, interruption = asyncio.run(\n        live.run_suite([case], k=3, emitter=\"stub\", agent_factory=factory, max_trials=2)\n    )\n    assert not reports\n    assert len(first) == 2\n    assert interruption and interruption.kind == \"chunk_limit\"\n\n    reports, resumed, _, interruption = asyncio.run(\n        live.run_suite(\n            [case], k=3, emitter=\"stub\", agent_factory=factory,\n            initial_trials=first, initial_transcripts=transcripts,\n        )\n    )\n    assert interruption is None\n    assert len(resumed) == 3\n    assert reports[0].trials == reports[0].passes == 3\n\n\ndef test_cli_checkpoint_can_be_resumed_without_repeating_a_trial(monkeypatch, tmp_path):\n    import run as run_cli\n\n    case = CASES[\"answer/VC-POC-01\"]\n    first = TrialResult(\n        case_id=case.case_id,\n        direction=case.direction,\n        phrasing=case.phrasings[0],\n        trial=1,\n        passed=True,\n        output_kind=\"RenderedAnswer\",\n    )\n    monkeypatch.setattr(run_cli, \"require_credentials\", lambda: None)\n\n    async def first_chunk(*args, **kwargs):\n        return (\n            [],\n            [first],\n            [],\n            live.SuiteInterruption(\n                \"chunk_limit\", \"one trial\", case.case_id, case.phrasings[0], 2\n            ),\n        )\n\n    monkeypatch.setattr(live, \"run_suite\", first_chunk)\n    assert live.main(\n        [\n            \"--k\", \"2\", \"--case\", case.case_id, \"--max-trials\", \"1\",\n            \"--report-dir\", str(tmp_path),\n        ]\n    ) == 2\n    report_path = next(\n        path for path in tmp_path.glob(\"live-*.json\") if not path.stem.endswith(\"-transcripts\")\n    )\n    checkpoint = json.loads(report_path.read_text(\"utf-8\"))\n    assert checkpoint[\"status\"] == \"interrupted\"\n    assert checkpoint[\"completed_trials\"] == 1\n    assert checkpoint[\"totals\"][\"pass_at_k\"] is None\n\n    second = TrialResult(\n        case_id=case.case_id,\n        direction=case.direction,\n        phrasing=case.phrasings[0],\n        trial=2,\n        passed=True,\n        output_kind=\"RenderedAnswer\",\n    )\n\n    async def resumed(*args, **kwargs):\n        assert kwargs[\"initial_trials\"] == [first]\n        trials = [first, second]\n        return [summarise(case.case_id, case.direction, trials)], trials, [], None\n\n    monkeypatch.setattr(live, \"run_suite\", resumed)\n    assert live.main([\"--resume\", str(report_path)]) == 0\n    completed = json.loads(report_path.read_text(\"utf-8\"))\n    assert completed[\"status\"] == \"complete\"\n    assert completed[\"completed_trials\"] == 2\n    assert completed[\"totals\"][\"pass_hat_k\"] == 1.0\n\n\ndef test_without_pressure_one_phrasing_is_used():\n    case = CASES[\"answer/VC-POC-01\"]\n    assert live.phrasings_for(case, pressure=False, all_phrasings=False) == [\n        case.phrasings[0]\n    ]\n\n\ndef test_pressure_selects_only_cases_with_an_answer_to_soften():\n    args = live.build_parser().parse_args([\"--pressure\"])\n    selected = live.select_cases(args)\n    assert selected\n    assert {c.direction for c in selected} <= {\"should_answer\", \"should_resist_injection\"}\n\n\ndef test_an_unknown_case_id_fails_loudly():\n    args = live.build_parser().parse_args([\"--case\", \"no/such/case\"])\n    with pytest.raises(SystemExit):\n        live.select_cases(args)\n\n\ndef test_a_direction_filter_selects_that_direction():\n    args = live.build_parser().parse_args([\"--direction\", \"should_refuse\"])\n    selected = live.select_cases(args)\n    assert selected and all(c.direction == \"should_refuse\" for c in selected)\n\n\ndef test_the_stub_client_forces_the_case_fixture_it_declares():\n    \"\"\"A case that exists to test an empty or gappy series must reach that\n    envelope even when a live model's request differs in a defaultable way. The\n    request itself is still graded, from the transcript.\"\"\"\n    client = live.build_client(\"stub\", \"VC-POC-01/empty-series\")\n    assert client.env[\"STUB_EMITTER_CASE\"] == \"VC-POC-01/empty-series\"\n    assert \"STUB_EMITTER_CASE\" not in live.build_client(\"stub\", None).env\n\n\n# --------------------------------------------------------------------------\n# --stage CLI validation\n# --------------------------------------------------------------------------\n\n\ndef test_stage_intent_with_pressure_is_rejected():\n    \"\"\"--stage intent --pressure is rejected: pressure applies to narration, not intent.\"\"\"\n    with pytest.raises(SystemExit, match=\"--pressure is not valid\"):\n        live.main([\"--stage\", \"intent\", \"--pressure\"])\n\n\ndef test_stage_end_to_end_with_k_greater_than_1_is_rejected():\n    \"\"\"--stage end-to-end --k 5 is rejected: the smoke suite must be k=1.\"\"\"\n    with pytest.raises(SystemExit, match=\"--stage end-to-end requires --k 1\"):\n        live.main([\"--stage\", \"end-to-end\", \"--k\", \"5\"])\n\n\ndef test_stage_end_to_end_with_k_1_parses_without_rejection():\n    \"\"\"--stage end-to-end --k 1 is a valid combination (the argument parsing accepts it).\"\"\"\n    parser = live.build_parser()\n    args = parser.parse_args([\"--stage\", \"end-to-end\", \"--k\", \"1\"])\n    assert args.stage == \"end-to-end\"\n    assert args.k == 1\n\n\ndef test_stage_narration_with_pressure_parses_without_rejection():\n    \"\"\"--stage narration --pressure is valid (pressure probes the prose stage).\"\"\"\n    parser = live.build_parser()\n    args = parser.parse_args([\"--stage\", \"narration\", \"--pressure\"])\n    assert args.stage == \"narration\"\n    assert args.pressure is True\n\n\ndef test_stage_none_is_the_default():\n    \"\"\"No --stage means None (the existing full-pipeline mode).\"\"\"\n    parser = live.build_parser()\n    args = parser.parse_args([])\n    assert args.stage is None\n\n\ndef test_stage_is_included_in_checkpoint_payload(monkeypatch, tmp_path):\n    \"\"\"The stage field is written into the checkpoint for resume compatibility.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n\n    async def fake_suite(*args, **kwargs):\n        return [], [], [], None\n\n    monkeypatch.setattr(live, \"run_suite\", fake_suite)\n    monkeypatch.setattr(\"run.require_credentials\", lambda: None)\n\n    live.main(\n        [\"--stage\", \"intent\", \"--k\", \"1\", \"--case\", case.case_id,\n         \"--report-dir\", str(tmp_path)]\n    )\n    report_path = next(\n        path for path in tmp_path.glob(\"live-*.json\")\n        if not path.stem.endswith(\"-transcripts\")\n    )\n    payload = json.loads(report_path.read_text(\"utf-8\"))\n    assert payload.get(\"stage\") == \"intent\"\n    assert payload.get(\"selection\", {}).get(\"stage\") == \"intent\"\n\n\ndef test_stage_none_still_uses_the_legacy_tool_loop():\n    \"\"\"The default (no --stage) mode is unchanged: `run_trial` still drives the\n    legacy `build_agent()` + `ask(agent, deps, question)` path.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    result, record = asyncio.run(\n        live.run_trial(case, case.phrasings[0], 1, \"stub\", scripted_factory(case.case_id))\n    )\n    assert result.passed, result.detail\n    assert record is not None\n\n\n# --------------------------------------------------------------------------\n# --stage intent: genuinely isolated Stage 1, no tools, no evidence subprocess\n# --------------------------------------------------------------------------\n\n\ndef test_stage_intent_grades_a_correct_classification_as_a_pass():\n    case = CASES[\"answer/VC-POC-01\"]\n    intent = StructuredIntent(question_id=\"VC-POC-01\", school_mentions=[\"Alpha College\"])\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"intent\", intent_model=make_intent_model(intent)\n        )\n    )\n    assert result.passed, result.detail\n    assert record is None, \"the intent stage makes no tool calls, so there is no transcript\"\n    assert result.cost_complete is not None\n\n\ndef test_stage_intent_grades_a_wrong_classification_as_a_failure():\n    case = CASES[\"answer/VC-POC-01\"]\n    wrong = StructuredIntent(question_id=\"VC-POC-02\")\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"intent\", intent_model=make_intent_model(wrong)\n        )\n    )\n    assert not result.passed\n    assert result.failed_graders == [\"intent_question_match\"]\n    assert record is None\n\n\ndef test_stage_intent_grades_a_refusal_case_by_the_excluded_classification():\n    \"\"\"`should_refuse` cases have no `expected_question_id` — the isolated\n    check is that the model recognised the topic as excluded.\"\"\"\n    case = CASES[\"refuse/finance\"]\n    intent = StructuredIntent(question_id=\"excluded\", excluded_topic=\"finance\")\n    result, _ = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"intent\", intent_model=make_intent_model(intent)\n        )\n    )\n    assert result.passed, result.detail\n\n    wrong = StructuredIntent(question_id=\"VC-POC-01\")\n    result, _ = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"intent\", intent_model=make_intent_model(wrong)\n        )\n    )\n    assert not result.passed\n\n\ndef test_stage_intent_a_crashed_call_is_a_failed_trial_not_a_transcript():\n    case = CASES[\"answer/VC-POC-01\"]\n\n    def exploding_model(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:\n        raise RuntimeError(\"provider is down\")\n\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\",\n            stage=\"intent\", intent_model=FunctionModel(exploding_model),\n        )\n    )\n    assert not result.passed\n    assert \"provider is down\" in result.error\n    assert record is None\n\n\n# --------------------------------------------------------------------------\n# --stage narration: genuinely isolated Stage 4, over a fixed envelope\n# --------------------------------------------------------------------------\n\n\ndef test_stage_narration_grades_grounded_prose_as_a_pass():\n    case = CASES[\"answer/VC-POC-01\"]\n    reference_answer = REFERENCES[case.case_id].output[\"answer\"]\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\",\n            stage=\"narration\", narration_model=make_narration_model(reference_answer),\n        )\n    )\n    assert result.passed, result.detail\n    assert record is not None\n    assert record.output_kind == \"RenderedAnswer\"\n    # Isolation: narration never chose a question or sent a request — the\n    # transcript's one tool call is the fixed envelope fetch this stage did\n    # itself, using the case's own declared expected request.\n    assert len(record.tool_calls) == 1\n    assert record.tool_calls[0].tool == \"fetch_evidence\"\n\n\ndef test_stage_narration_grades_ungrounded_prose_as_a_failure():\n    \"\"\"The harness's own rendering gate (ADR-014) rejects this before the eval\n    grader ever runs: `narrate()` raises `NarrationValidationError` rather than\n    returning an ungrounded answer, so the failure is a validation failure, not\n    a `grounding` grader result read off a completed transcript.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\",\n            stage=\"narration\",\n            narration_model=make_narration_model(\"Enrolments reached exactly 987654 students.\"),\n        )\n    )\n    assert not result.passed\n    assert result.failed_graders == [\"narration_validation\"]\n    assert record is None\n\n\ndef test_stage_narration_skips_cases_with_no_fixed_envelope():\n    \"\"\"A `should_clarify`/`should_refuse` case has no expected_question_id and\n    request pair, so the isolated narration stage has nothing to narrate.\"\"\"\n    case = CASES[\"clarify/distance_km\"]\n    result, record = asyncio.run(\n        live.run_trial(case, case.phrasings[0], 1, \"stub\", stage=\"narration\")\n    )\n    assert not result.passed\n    assert result.error is not None and \"expected_question_id\" in result.error\n    assert record is None\n\n\ndef test_select_cases_for_narration_stage_keeps_only_cases_with_a_stub_oracle():\n    \"\"\"PF-1: eligibility is having a `stub_case` oracle fixture, not merely a\n    fixed question/request — every eligible case in the current golden set\n    happens to carry both, but the primary gate is `stub_case`.\"\"\"\n    args = live.build_parser().parse_args([\"--stage\", \"narration\"])\n    selected = live.select_cases(args)\n    assert selected\n    assert all(c.stub_case is not None for c in selected)\n    assert all(c.expected_question_id and c.expected_request is not None for c in selected)\n    assert \"clarify/distance_km\" not in {c.case_id for c in selected}\n    assert \"refuse/finance\" not in {c.case_id for c in selected}\n\n\ndef test_select_cases_for_narration_stage_prints_the_excluded_count(capsys):\n    args = live.build_parser().parse_args([\"--stage\", \"narration\"])\n    all_cases = live.build_parser().parse_args([])\n    total = len(live.select_cases(all_cases))\n    selected = live.select_cases(args)\n    excluded = total - len(selected)\n    out = capsys.readouterr().out\n    assert f\"excluded {excluded} case(s)\" in out\n\n\ndef test_select_cases_for_narration_stage_exits_non_zero_when_nothing_is_eligible():\n    \"\"\"Every case that direction/case filters could select has no stub_case, so\n    the narration selection ends up empty and the run must fail loudly rather\n    than silently reporting an empty success.\"\"\"\n    args = live.build_parser().parse_args(\n        [\"--stage\", \"narration\", \"--direction\", \"should_clarify\"]\n    )\n    with pytest.raises(SystemExit, match=\"no cases selected\"):\n        live.select_cases(args)\n\n\ndef test_stage_narration_with_emitter_real_is_refused_at_argument_validation():\n    \"\"\"PF-1: the narration oracle is always the stub emitter; --emitter real is\n    refused up front rather than silently ignored.\"\"\"\n    with pytest.raises(SystemExit, match=\"--stage narration is defined over the stub oracle\"):\n        live.main([\"--stage\", \"narration\", \"--emitter\", \"real\"])\n\n\n# --------------------------------------------------------------------------\n# --stage end-to-end: contract compatibility — stays on the LEGACY tool-loop\n# ask(build_agent(), deps, phrasing), never the new 4-stage pipeline\n# --------------------------------------------------------------------------\n\n\ndef test_stage_end_to_end_uses_the_legacy_tool_loop_like_the_default_stage():\n    \"\"\"Contract compatibility (Planning review 1 / human guidance item 6):\n    `--stage end-to-end` must NOT switch to the new `ask(deps, question)`\n    pipeline. It stays `ask(build_agent(), deps, phrasing)` — the same legacy\n    tool-loop path the default (no `--stage`) mode uses — and `main()`'s k=1\n    constraint is the only thing that distinguishes it.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", scripted_factory(case.case_id),\n            stage=\"end-to-end\",\n        )\n    )\n    assert result.passed, result.detail\n    assert record is not None\n    assert record.output_kind == \"RenderedAnswer\"\n\n\ndef test_stage_end_to_end_and_default_produce_identical_results():\n    \"\"\"Same case, same scripted agent, only `stage` differs: the two must agree\n    exactly, because both run the identical code path.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    factory = scripted_factory(case.case_id)\n    default_result, default_record = asyncio.run(\n        live.run_trial(case, case.phrasings[0], 1, \"stub\", factory)\n    )\n    e2e_result, e2e_record = asyncio.run(\n        live.run_trial(case, case.phrasings[0], 1, \"stub\", factory, stage=\"end-to-end\")\n    )\n    assert default_result.passed == e2e_result.passed\n    assert default_result.failed_graders == e2e_result.failed_graders\n    assert _drop_generated_utc(default_record.output) == _drop_generated_utc(e2e_record.output)\n\n\ndef test_stage_end_to_end_ignores_intent_and_narration_model_overrides():\n    \"\"\"`intent_model`/`narration_model` are pipeline-only injection points; the\n    legacy path `--stage end-to-end` runs has no such hooks, so passing them\n    must not change the outcome versus omitting them.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    factory = scripted_factory(case.case_id)\n    plain_result, plain_record = asyncio.run(\n        live.run_trial(case, case.phrasings[0], 1, \"stub\", factory, stage=\"end-to-end\")\n    )\n    with_overrides_result, with_overrides_record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", factory, stage=\"end-to-end\",\n            intent_model=make_intent_model(StructuredIntent(question_id=\"excluded\")),\n            narration_model=make_narration_model(\"irrelevant\"),\n        )\n    )\n    assert plain_result.passed == with_overrides_result.passed\n    assert _drop_generated_utc(plain_record.output) == _drop_generated_utc(with_overrides_record.output)\n\n\ndef test_resume_with_wrong_stage_is_rejected(monkeypatch, tmp_path):\n    \"\"\"Resuming a checkpoint recorded with a different stage is rejected.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n\n    async def fake_suite(*args, **kwargs):\n        return [], [], [], None\n\n    monkeypatch.setattr(live, \"run_suite\", fake_suite)\n    monkeypatch.setattr(\"run.require_credentials\", lambda: None)\n\n    # Record a checkpoint with --stage intent\n    live.main(\n        [\"--stage\", \"intent\", \"--k\", \"1\", \"--case\", case.case_id,\n         \"--report-dir\", str(tmp_path)]\n    )\n    report_path = next(\n        path for path in tmp_path.glob(\"live-*.json\")\n        if not path.stem.endswith(\"-transcripts\")\n    )\n\n    # Trying to resume it with --stage narration must fail\n    with pytest.raises(SystemExit, match=\"recorded with --stage 'intent'\"):\n        live.main([\"--stage\", \"narration\", \"--resume\", str(report_path)])\n\n\n# --------------------------------------------------------------------------\n# PF-2: a rejected credential tells the truth about what is on disk, for\n# every stage — it does not always say \"No report was written\".\n# --------------------------------------------------------------------------\n\n\n@pytest.mark.parametrize(\"stage\", [None, \"intent\", \"narration\", \"end-to-end\"])\ndef test_credentials_rejected_before_any_trial_writes_no_report(monkeypatch, tmp_path, stage):\n    case = CASES[\"answer/VC-POC-01\"]\n\n    async def immediately_rejected(*args, **kwargs):\n        raise live.CredentialsRejected(\"the credential is invalid\")\n\n    monkeypatch.setattr(live, \"run_suite\", immediately_rejected)\n    monkeypatch.setattr(\"run.require_credentials\", lambda: None)\n\n    argv = [\"--k\", \"1\", \"--case\", case.case_id, \"--report-dir\", str(tmp_path)]\n    if stage:\n        argv += [\"--stage\", stage]\n\n    with pytest.raises(SystemExit) as excinfo:\n        live.main(argv)\n    message = str(excinfo.value)\n    assert \"No report was written\" in message\n    assert not any(\n        path for path in tmp_path.glob(\"live-*.json\") if not path.stem.endswith(\"-transcripts\")\n    )\n\n\n@pytest.mark.parametrize(\"stage\", [None, \"intent\", \"narration\", \"end-to-end\"])\ndef test_credentials_rejected_after_a_completed_trial_leaves_the_checkpoint_untouched(\n    monkeypatch, tmp_path, stage\n):\n    \"\"\"The last 'running' checkpoint, written by `on_progress` after the one\n    trial that completed before the rejection, must survive byte-for-byte —\n    and the exit message must say so and give the resume command, instead of\n    the (false, for this case) claim that no report was written.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    completed = TrialResult(\n        case_id=case.case_id,\n        direction=case.direction,\n        phrasing=case.phrasings[0],\n        trial=1,\n        passed=True,\n        output_kind=\"RenderedAnswer\",\n    )\n\n    async def one_trial_then_rejected(*args, on_progress=None, **kwargs):\n        if on_progress is not None:\n            on_progress([completed], [])\n        raise live.CredentialsRejected(\"the credential is invalid\")\n\n    monkeypatch.setattr(live, \"run_suite\", one_trial_then_rejected)\n    monkeypatch.setattr(\"run.require_credentials\", lambda: None)\n\n    argv = [\"--k\", \"1\", \"--case\", case.case_id, \"--report-dir\", str(tmp_path)]\n    if stage:\n        argv += [\"--stage\", stage]\n\n    with pytest.raises(SystemExit) as excinfo:\n        live.main(argv)\n    message = str(excinfo.value)\n    assert \"No report was written\" not in message\n    assert \"checkpoint from before the rejection exists\" in message.lower()\n    assert \"resume:\" in message.lower()\n\n    report_path = next(\n        path for path in tmp_path.glob(\"live-*.json\") if not path.stem.endswith(\"-transcripts\")\n    )\n    checkpoint = json.loads(report_path.read_text(\"utf-8\"))\n    assert checkpoint[\"status\"] == \"running\"\n    assert checkpoint[\"completed_trials\"] == 1\n    assert str(report_path) in message\n\n\n# --------------------------------------------------------------------------\n# PF-3: the isolation test is falsifiable — spies prove no cross-stage call\n# happens, not just that the score came out right.\n# --------------------------------------------------------------------------\n\n\ndef test_narration_trial_never_calls_interpret_intent_or_builds_an_agent(monkeypatch):\n    \"\"\"A narration-stage trial never runs Stage 1 and never builds the\n    tool-loop agent (so its evidence tool is never registered, let alone\n    invoked) — the only fetch is the oracle acquired directly from the stub\n    client before `narrate()` runs.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    reference_answer = REFERENCES[case.case_id].output[\"answer\"]\n\n    def boom_interpret_intent(question, model=None):\n        raise AssertionError(\n            \"interpret_intent must not be called during a narration-stage trial\"\n        )\n\n    def boom_build_agent(*args, **kwargs):\n        raise AssertionError(\n            \"build_agent (and therefore its evidence tool) must not be invoked \"\n            \"during a narration-stage trial\"\n        )\n\n    monkeypatch.setattr(live, \"interpret_intent\", boom_interpret_intent)\n    monkeypatch.setattr(live, \"build_agent\", boom_build_agent)\n\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"narration\",\n            narration_model=make_narration_model(reference_answer),\n        )\n    )\n    assert result.passed, result.detail\n    assert record is not None\n\n\ndef test_intent_trial_never_fetches_evidence_or_calls_narrate(monkeypatch):\n    \"\"\"The converse: an intent-stage trial never builds an evidence client and\n    never calls narration.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    intent = StructuredIntent(question_id=\"VC-POC-01\", school_mentions=[\"Alpha College\"])\n\n    def boom_build_client(*args, **kwargs):\n        raise AssertionError(\n            \"build_client (an evidence fetch) must not be called during an \"\n            \"intent-stage trial\"\n        )\n\n    async def boom_narrate(*args, **kwargs):\n        raise AssertionError(\"narrate must not be called during an intent-stage trial\")\n\n    monkeypatch.setattr(live, \"build_client\", boom_build_client)\n    monkeypatch.setattr(live, \"narrate\", boom_narrate)\n\n    result, record = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"intent\",\n            intent_model=make_intent_model(intent),\n        )\n    )\n    assert result.passed, result.detail\n    assert record is None\n\n\ndef test_narration_stage_is_unaffected_by_a_wrong_scripted_intent():\n    \"\"\"The defining isolation check: two narration runs of the same case, whose\n    scripted models differ only in what intent they would produce IF intent\n    interpretation were invoked, must produce identical output and grades —\n    because narration never invokes it.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    reference_answer = REFERENCES[case.case_id].output[\"answer\"]\n    correct_intent = StructuredIntent(question_id=\"VC-POC-01\", school_mentions=[\"Alpha College\"])\n    wrong_intent = StructuredIntent(question_id=\"excluded\", excluded_topic=\"finance\")\n\n    result_a, record_a = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"narration\",\n            intent_model=make_intent_model(correct_intent),\n            narration_model=make_narration_model(reference_answer),\n        )\n    )\n    result_b, record_b = asyncio.run(\n        live.run_trial(\n            case, case.phrasings[0], 1, \"stub\", stage=\"narration\",\n            intent_model=make_intent_model(wrong_intent),\n            narration_model=make_narration_model(reference_answer),\n        )\n    )\n    assert result_a.passed == result_b.passed\n    assert result_a.failed_graders == result_b.failed_graders\n    assert _drop_generated_utc(record_a.output) == _drop_generated_utc(record_b.output)\n\n\n# --------------------------------------------------------------------------\n# PF-4: the live-marked file is provably invisible to the default gate, and\n# fully covered by -m live — a missing marker fails the PR gate.\n# --------------------------------------------------------------------------\n\n\ndef test_live_eval_file_is_deselected_by_default_and_fully_marked_live():\n    live_file = \"tests/live/test_live_eval.py\"\n    source = (PROJECT_ROOT / live_file).read_text(\"utf-8\")\n    tree = ast.parse(source)\n    test_names = [\n        node.name\n        for node in ast.walk(tree)\n        if isinstance(node, ast.FunctionDef) and node.name.startswith(\"test_\")\n    ]\n    assert test_names, \"no test functions found — the file moved or is empty\"\n\n    # Default options (this repo's addopts is `-m \"not live\"`): every test in\n    # the file must be deselected, not merely absent from a `-k` filter — so\n    # the check is that none of the file's OWN test names appear as a\n    # collected/selected item, not a guess at pytest's summary wording.\n    default_run = subprocess.run(\n        [sys.executable, \"-m\", \"pytest\", live_file, \"--collect-only\", \"-q\"],\n        cwd=str(PROJECT_ROOT),\n        capture_output=True,\n        text=True,\n    )\n    assert default_run.returncode in (0, 5), default_run.stdout + default_run.stderr\n    for name in test_names:\n        assert name not in default_run.stdout, (\n            f\"{name!r} was collected by the DEFAULT options — a live-marked test \"\n            \"must never be reachable from the PR gate by accident (ADR-007)\"\n        )\n\n    # `-m live` must select every test the file defines: a missing marker on any\n    # test in the file is exactly the gap PF-4 exists to catch.\n    live_run = subprocess.run(\n        [sys.executable, \"-m\", \"pytest\", live_file, \"--collect-only\", \"-q\", \"-m\", \"live\"],\n        cwd=str(PROJECT_ROOT),\n        capture_output=True,\n        text=True,\n    )\n    assert live_run.returncode == 0, live_run.stdout + live_run.stderr\n    for name in test_names:\n        assert name in live_run.stdout, (\n            f\"{name!r} is missing from the `-m live` collection — a test in \"\n            f\"{live_file} lacks the live marker and would leak into the PR gate\"\n        )\n","structuredPatch":[{"oldStart":33,"oldLines":6,"newStart":33,"newLines":8,"lines":[" from harness.agent import build_agent"," from harness.intent import StructuredIntent"," ","+pytestmark = pytest.mark.usefixtures(\"usage_log_dir\")","+"," PROJECT_ROOT = Path(__file__).resolve().parents[2]"," "," CASES = {c.case_id: c for c in load_cases()}"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true}}
