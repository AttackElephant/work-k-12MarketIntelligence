{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DrdmeUAM6U2kZxa3ZFHpA6","type":"tool_result","content":"1\t#!/usr/bin/env python\n2\t\"\"\"Ask the harness a question from a terminal (architecture §3).\n3\t\n4\t    .venv/bin/python run.py \"How many students at Alpha College?\"\n5\t    .venv/bin/python run.py --stub \"...\"     # canned fixtures, no data project\n6\t    .venv/bin/python run.py --json \"...\"     # the HarnessOutput, machine-readable\n7\t\n8\tThis is the entry point the live eval tier and the M5 demo both need, and the\n9\tfirst thing in the repo that lets a human ask a question at all.\n10\t\n11\tWhat it does, and deliberately does not do:\n12\t\n13\t* It **renders**, it does not compose. Limitations and confidence are printed\n14\t  from the fields the harness attached out of the envelope (ADR-009). Nothing\n15\t  here paraphrases them, reorders them, or drops one for brevity — and there is\n16\t  no `--brief` that would.\n17\t* It carries **one clarification round-trip** by default (O-3): a\n18\t  `ClarificationNeeded` is put to the user, the reply is appended to the message\n19\t  history, and the run continues. A question still ambiguous after the last\n20\t  round returns the clarification unanswered rather than guessing.\n21\t* It **configures logging once**, here, as every entry point must.\n22\t\n23\tExit codes are outcomes, not errors — a refusal and a clarification are correct\n24\tresults of a working system:\n25\t\n26\t    0  answered            3  unsupported (an honest refusal)\n27\t    2  clarification open  4  a budget tripped        1  operational failure\n28\t\"\"\"\n29\t\n30\tfrom __future__ import annotations\n31\t\n32\timport argparse\n33\timport asyncio\n34\timport json\n35\timport sys\n36\tfrom pathlib import Path\n37\tfrom typing import Any, Callable\n38\t\n39\tPROJECT_ROOT = Path(__file__).resolve().parent\n40\tif str(PROJECT_ROOT) not in sys.path:\n41\t    sys.path.insert(0, str(PROJECT_ROOT))\n42\t\n43\tfrom config import settings  # noqa: E402\n44\tfrom harness.claude_account_cli import (  # noqa: E402\n45\t    ClaudeAccountCliError,\n46\t    claude_account_status,\n47\t)\n48\tfrom harness.agent import ask, build_agent  # noqa: E402\n49\tfrom harness.errors import HarnessError  # noqa: E402\n50\tfrom harness.evidence import EmitterFailure, EvidenceClient  # noqa: E402\n51\tfrom harness.logging_config import configure_logging  # noqa: E402\n52\tfrom harness.outputs import (  # noqa: E402\n53\t    BudgetExceeded,\n54\t    ClarificationNeeded,\n55\t    HarnessOutput,\n56\t    RenderedAnswer,\n57\t    Unsupported,\n58\t)\n59\tfrom harness.tools import Deps  # noqa: E402\n60\t\n61\tSTUB_EMITTER = PROJECT_ROOT / \"evals\" / \"stub_emitter.py\"\n62\t\n63\tEXIT_ANSWERED = 0\n64\tEXIT_FAILED = 1\n65\tEXIT_CLARIFICATION = 2\n66\tEXIT_UNSUPPORTED = 3\n67\tEXIT_BUDGET = 4\n68\t\n69\tEXIT_BY_BRANCH = {\n70\t    RenderedAnswer: EXIT_ANSWERED,\n71\t    ClarificationNeeded: EXIT_CLARIFICATION,\n72\t    Unsupported: EXIT_UNSUPPORTED,\n73\t    BudgetExceeded: EXIT_BUDGET,\n74\t}\n75\t\n76\t\n77\t# ---------------------------------------------------------------------------\n78\t# rendering\n79\t# ---------------------------------------------------------------------------\n80\t\n81\t\n82\tdef _bullets(lines: list[str]) -> str:\n83\t    return \"\\n\".join(f\"  - {line}\" for line in lines)\n84\t\n85\t\n86\tdef render_answer(output: RenderedAnswer) -> str:\n87\t    \"\"\"Prose, then the provenance the contract obliges us to show with it.\n88\t\n89\t    Every section here is printed from a preserved field. The four confidence\n90\t    axes render as the data layer stated them and carry no overall grade — the\n91\t    harness has no authority to assign one (ADR-009).\n92\t    \"\"\"\n93\t    blocks = [output.answer.strip()]\n94\t\n95\t    if output.data_status_note.strip():\n96\t        blocks.append(f\"Data status:\\n  {output.data_status_note.strip()}\")\n97\t\n98\t    if output.deterministic_signals:\n99\t        signals = [\n100\t            json.dumps(signal, ensure_ascii=False, sort_keys=True)\n101\t            for signal in output.deterministic_signals\n102\t        ]\n103\t        blocks.append(\"Deterministic signals (disclosed calculations):\\n\" + _bullets(signals))\n104\t\n105\t    axes = [f\"{axis}: {rating}\" for axis, rating in sorted(output.confidence.items())]\n106\t    blocks.append(\"Confidence (as stated by the data layer):\\n\" + _bullets(axes))\n107\t\n108\t    if output.limitations:\n109\t        blocks.append(\"Limitations:\\n\" + _bullets(output.limitations))\n110\t\n111\t    provenance = [\n112\t        f\"{key}: {json.dumps(value, ensure_ascii=False, sort_keys=True) if isinstance(value, (dict, list)) else value}\"\n113\t        for key, value in sorted(output.provenance.items())\n114\t    ]\n115\t    blocks.append(\"Provenance:\\n\" + _bullets(provenance))\n116\t    blocks.append(f\"Question {output.question_id} · contract {output.contract_version}\")\n117\t    return \"\\n\\n\".join(blocks)\n118\t\n119\t\n120\tdef render_clarification(output: ClarificationNeeded) -> str:\n121\t    missing = [\n122\t        f\"{item.input} — {item.why_material}\"\n123\t        + (f\" (allowed: {', '.join(item.allowed_values)})\" if item.allowed_values else \"\")\n124\t        for item in output.missing\n125\t    ]\n126\t    return \"\\n\\n\".join(\n127\t        [\n128\t            output.prompt_to_user.strip(),\n129\t            \"Needed before this can be answered:\\n\" + _bullets(missing),\n130\t            f\"Question {output.question_id} (tentative)\",\n131\t        ]\n132\t    )\n133\t\n134\t\n135\tdef render_unsupported(output: Unsupported) -> str:\n136\t    blocks = [f\"Not answerable ({output.reason_kind}):\", f\"  {output.reason}\"]\n137\t    if output.nearest_supported:\n138\t        blocks.append(f\"Closest supported question: {output.nearest_supported}\")\n139\t    return \"\\n\".join(blocks)\n140\t\n141\t\n142\tdef render_budget(output: BudgetExceeded) -> str:\n143\t    blocks = [f\"Stopped on the {output.limit} budget: {output.detail}\"]\n144\t    if output.learned_so_far:\n145\t        blocks.append(f\"Established before stopping: {output.learned_so_far}\")\n146\t    blocks.append(\"No partial answer is shown — a half-rendered figure is worse than none.\")\n147\t    return \"\\n\".join(blocks)\n148\t\n149\t\n150\tdef render_text(output: HarnessOutput) -> str:\n151\t    if isinstance(output, RenderedAnswer):\n152\t        return render_answer(output)\n153\t    if isinstance(output, ClarificationNeeded):\n154\t        return render_clarification(output)\n155\t    if isinstance(output, Unsupported):\n156\t        return render_unsupported(output)\n157\t    return render_budget(output)\n158\t\n159\t\n160\t# ---------------------------------------------------------------------------\n161\t# the conversation\n162\t# ---------------------------------------------------------------------------\n163\t\n164\t\n165\tasync def converse(\n166\t    agent: Any,\n167\t    deps: Deps,\n168\t    question: str,\n169\t    ask_user: Callable[[ClarificationNeeded], str | None] | None = None,\n170\t    max_clarifications: int = 1,\n171\t    record_usage: bool = True,\n172\t) -> HarnessOutput:\n173\t    \"\"\"Run the question, carrying up to `max_clarifications` round-trips.\n174\t\n175\t    The state between turns is PydanticAI's own message history, handed back on\n176\t    `deps.last_messages` — no bespoke session store (architecture §7). An\n177\t    `ask_user` that returns None (or is absent) ends the conversation with the\n178\t    clarification unanswered, which is the honest outcome for a non-interactive\n179\t    caller.\n180\t\n181\t    `record_usage=False` is for callers driving a scripted `FunctionModel`\n182\t    (`demo.py --replay`, `evals/replay.py`): those runs cost nothing, and writing\n183\t    their zero-price \"usage\" into the JSONL the cost report reads would put runs\n184\t    that never happened into the spend record (ADR-005).\n185\t\n186\t    `agent` may be a PydanticAI `Agent` (legacy tool-loop path) or `None`\n187\t    (pipeline path). When `None`, the new 4-stage pipeline is used.\n188\t    \"\"\"\n189\t    history: list[Any] | None = None\n190\t    pipeline_turns: list[tuple[ClarificationNeeded, str]] = []\n191\t    pipeline_user_replies: list[str] = []\n192\t    reply = question\n193\t    for _round in range(max_clarifications + 1):\n194\t        if agent is not None:\n195\t            output = await ask(\n196\t                agent, deps, reply, message_history=history, record_usage=record_usage\n197\t            )\n198\t        else:\n199\t            # The pipeline has no PydanticAI message history. Carry the original\n200\t            # request and each clarification exchange explicitly into the next\n201\t            # intent interpretation so a short answer (for example \"SA2\") does\n202\t            # not become a context-free new question.\n203\t            pipeline_question = question\n204\t            if pipeline_turns:\n205\t                exchanges = \"\\n\\n\".join(\n206\t                    \"Clarification requested:\\n\"\n207\t                    f\"Question ID: {clarification.question_id or 'unknown'}\\n\"\n208\t                    f\"Missing inputs: {', '.join(item.input for item in clarification.missing)}\\n\"\n209\t                    f\"Prompt: {clarification.prompt_to_user}\\n\"\n210\t                    f\"User response: {answer}\"\n211\t                    for clarification, answer in pipeline_turns\n212\t                )\n213\t                pipeline_question = (\n214\t                    f\"Original user request:\\n{question}\\n\\n\"\n215\t                    f\"Clarification exchanges:\\n{exchanges}\\n\\n\"\n216\t                    \"Interpret the completed request using all information above.\"\n217\t                )\n218\t            # Stage 1 needs the full transcript, but deterministic scope checks\n219\t            # may treat only actual user wording as authorization. Keep that\n220\t            # authority channel separate from assistant prompts and metadata.\n221\t            deps._scope_user_question = \"\\n\".join(\n222\t                [question, *pipeline_user_replies]\n223\t            )\n224\t            output = await ask(deps, pipeline_question, record_usage=record_usage)\n225\t        if not isinstance(output, ClarificationNeeded) or ask_user is None:\n226\t            return output\n227\t        answer = ask_user(output)\n228\t        if answer is None or not answer.strip():\n229\t            return output\n230\t        history = deps.last_messages\n231\t        if agent is None:\n232\t            pipeline_turns.append((output, answer.strip()))\n233\t            pipeline_user_replies.append(answer.strip())\n234\t        reply = answer\n235\t    return output\n236\t\n237\t\n238\tdef _prompt_on_terminal(output: ClarificationNeeded) -> str | None:\n239\t    print(render_clarification(output))\n240\t    print()\n241\t    try:\n242\t        return input(\"> \")\n243\t    except EOFError:\n244\t        return None\n245\t\n246\t\n247\tdef build_client(use_stub: bool) -> EvidenceClient:\n248\t    if use_stub:\n249\t        # The same emitter the golden suite runs against: canned envelopes, no\n250\t        # data project, no database. Exercises the whole path except the data.\n251\t        return EvidenceClient(python=Path(sys.executable), emitter=STUB_EMITTER)\n252\t    if not settings.DATA_PROJECT_ROOT or not settings.EVIDENCE_EMITTER.exists():\n253\t        raise SystemExit(\n254\t            \"No evidence emitter found. Set DATA_PROJECT_ROOT (env or .env) to the \"\n255\t            f\"data project — expected {settings.EVIDENCE_EMITTER} — or pass --stub to \"\n256\t            \"run against the canned fixture bundle.\"\n257\t        )\n258\t    return EvidenceClient.from_settings()\n259\t\n260\t\n261\tdef require_credentials() -> None:\n262\t    \"\"\"Fail with a sentence, not a stack trace, when nothing is configured.\n263\t\n264\t    The SDK's own failure for this is a `TypeError` about header resolution,\n265\t    raised deep inside the first request — after the emitter has been located\n266\t    and the agent built. For the first thing a person runs in this repo, that is\n267\t    the wrong first impression of an otherwise working system.\n268\t\n269\t    **An unset env var does not mean there is no credential** — with neither\n270\t    set, the SDK falls back to a profile written by `ant auth login`. But\n271\t    checking that by asking \"is the `ant` CLI on PATH\" was wrong: it treated\n272\t    `claude` (Claude Code) as interchangeable with `ant` (the Anthropic SDK's\n273\t    own login CLI), and `claude auth login` populates neither the env vars nor\n274\t    the profile file the SDK reads — confirmed by reading\n275\t    `anthropic.default_credentials()` in the installed SDK. A `claude\n276\t    auth login` session bridges into this SDK only via `claude setup-token`,\n277\t    which mints an explicit `ANTHROPIC_AUTH_TOKEN`.\n278\t\n279\t    So the check calls the SDK's own resolver — ground truth, not a guess from\n280\t    which binary happens to be installed.\n281\t    \"\"\"\n282\t    if settings.MODEL_PROVIDER == \"claude_account\":\n283\t        ok, detail = claude_account_status(settings.CLAUDE_CLI)\n284\t        if ok:\n285\t            return\n286\t        raise SystemExit(\n287\t            \"No usable Claude subscription-account token is available. Source the \"\n288\t            \"machine-level environment containing CLAUDE_CODE_OAUTH_TOKEN, then \"\n289\t            f\"retry. Diagnostic: {detail}\"\n290\t        )\n291\t\n292\t    if settings.ANTHROPIC_API_KEY or settings.ANTHROPIC_AUTH_TOKEN:\n293\t        return\n294\t    import anthropic\n295\t\n296\t    if anthropic.default_credentials(base_url=\"https://api.anthropic.com\") is not None:\n297\t        return  # a real SDK-readable profile exists (ant auth login, or WIF env vars)\n298\t    raise SystemExit(\n299\t        \"No Anthropic credential found. A `claude auth login` (Claude Code) session, \"\n300\t        \"if you have one, does not count — it is not something this SDK can read. \"\n301\t        \"Run `claude setup-token` and put the token it prints in .env as \"\n302\t        \"ANTHROPIC_AUTH_TOKEN, or set ANTHROPIC_API_KEY (metered API), or \"\n303\t        \"`ant auth login` for an SDK-native profile. \"\n304\t        \"`.venv/bin/python authcheck.py` says which one is in play and whether the \"\n305\t        \"provider accepts it.\"\n306\t    )\n307\t\n308\t\n309\tdef build_parser() -> argparse.ArgumentParser:\n310\t    parser = argparse.ArgumentParser(\n311\t        prog=\"run.py\",\n312\t        description=\"Ask the K-12 market intelligence harness one question.\",\n313\t    )\n314\t    parser.add_argument(\"question\", help=\"the question, in plain English\")\n315\t    parser.add_argument(\n316\t        \"--stub\",\n317\t        action=\"store_true\",\n318\t        help=\"use evals/stub_emitter.py instead of the data project's emitter\",\n319\t    )\n320\t    parser.add_argument(\n321\t        \"--json\", action=\"store_true\", help=\"print the output branch as JSON\"\n322\t    )\n323\t    parser.add_argument(\n324\t        \"--max-clarifications\",\n325\t        type=int,\n326\t        default=1,\n327\t        help=\"clarification round-trips before giving up (default 1, per O-3)\",\n328\t    )\n329\t    parser.add_argument(\n330\t        \"--no-interactive\",\n331\t        action=\"store_true\",\n332\t        help=\"never prompt; report a clarification and exit 2\",\n333\t    )\n334\t    return parser\n335\t\n336\t\n337\tdef main(argv: list[str] | None = None) -> int:\n338\t    configure_logging()  # once per entry point, before anything else logs\n339\t    args = build_parser().parse_args(argv)\n340\t\n341\t    require_credentials()\n342\t    client = build_client(args.stub)\n343\t    deps = Deps(client=client)\n344\t    ask_user = None if args.no_interactive else _prompt_on_terminal\n345\t\n346\t    try:\n347\t        output = asyncio.run(\n348\t            converse(\n349\t                None,\n350\t                deps,\n351\t                args.question,\n352\t                ask_user=ask_user,\n353\t                max_clarifications=args.max_clarifications,\n354\t            )\n355\t        )\n356\t    except (HarnessError, EmitterFailure, ClaudeAccountCliError) as exc:\n357\t        # Classified and already logged at the retry boundary; the caller gets\n358\t        # the operational failure, never a fabricated answer.\n359\t        print(f\"{type(exc).__name__}: {exc}\", file=sys.stderr)\n360\t        return EXIT_FAILED\n361\t\n362\t    if args.json:\n363\t        print(output.model_dump_json(indent=2))\n364\t    else:\n365\t        print(render_text(output))\n366\t    return EXIT_BY_BRANCH[type(output)]\n367\t\n368\t\n369\tif __name__ == \"__main__\":\n370\t    raise SystemExit(main())\n371\t"}]},"parent_tool_use_id":null,"session_id":"1d720d32-2e38-4c91-ace7-0965c0cbf441","uuid":"faa77b80-329d-43e8-8e02-52e3f01b26ad","timestamp":"2026-10-06T02:26:56.763Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/run.py","content":"#!/usr/bin/env python\n\"\"\"Ask the harness a question from a terminal (architecture §3).\n\n    .venv/bin/python run.py \"How many students at Alpha College?\"\n    .venv/bin/python run.py --stub \"...\"     # canned fixtures, no data project\n    .venv/bin/python run.py --json \"...\"     # the HarnessOutput, machine-readable\n\nThis is the entry point the live eval tier and the M5 demo both need, and the\nfirst thing in the repo that lets a human ask a question at all.\n\nWhat it does, and deliberately does not do:\n\n* It **renders**, it does not compose. Limitations and confidence are printed\n  from the fields the harness attached out of the envelope (ADR-009). Nothing\n  here paraphrases them, reorders them, or drops one for brevity — and there is\n  no `--brief` that would.\n* It carries **one clarification round-trip** by default (O-3): a\n  `ClarificationNeeded` is put to the user, the reply is appended to the message\n  history, and the run continues. A question still ambiguous after the last\n  round returns the clarification unanswered rather than guessing.\n* It **configures logging once**, here, as every entry point must.\n\nExit codes are outcomes, not errors — a refusal and a clarification are correct\nresults of a working system:\n\n    0  answered            3  unsupported (an honest refusal)\n    2  clarification open  4  a budget tripped        1  operational failure\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport asyncio\nimport json\nimport sys\nfrom pathlib import Path\nfrom typing import Any, Callable\n\nPROJECT_ROOT = Path(__file__).resolve().parent\nif str(PROJECT_ROOT) not in sys.path:\n    sys.path.insert(0, str(PROJECT_ROOT))\n\nfrom config import settings  # noqa: E402\nfrom harness.claude_account_cli import (  # noqa: E402\n    ClaudeAccountCliError,\n    claude_account_status,\n)\nfrom harness.agent import ask, build_agent  # noqa: E402\nfrom harness.errors import HarnessError  # noqa: E402\nfrom harness.evidence import EmitterFailure, EvidenceClient  # noqa: E402\nfrom harness.logging_config import configure_logging  # noqa: E402\nfrom harness.outputs import (  # noqa: E402\n    BudgetExceeded,\n    ClarificationNeeded,\n    HarnessOutput,\n    RenderedAnswer,\n    Unsupported,\n)\nfrom harness.tools import Deps  # noqa: E402\n\nSTUB_EMITTER = PROJECT_ROOT / \"evals\" / \"stub_emitter.py\"\n\nEXIT_ANSWERED = 0\nEXIT_FAILED = 1\nEXIT_CLARIFICATION = 2\nEXIT_UNSUPPORTED = 3\nEXIT_BUDGET = 4\n\nEXIT_BY_BRANCH = {\n    RenderedAnswer: EXIT_ANSWERED,\n    ClarificationNeeded: EXIT_CLARIFICATION,\n    Unsupported: EXIT_UNSUPPORTED,\n    BudgetExceeded: EXIT_BUDGET,\n}\n\n\n# ---------------------------------------------------------------------------\n# rendering\n# ---------------------------------------------------------------------------\n\n\ndef _bullets(lines: list[str]) -> str:\n    return \"\\n\".join(f\"  - {line}\" for line in lines)\n\n\ndef render_answer(output: RenderedAnswer) -> str:\n    \"\"\"Prose, then the provenance the contract obliges us to show with it.\n\n    Every section here is printed from a preserved field. The four confidence\n    axes render as the data layer stated them and carry no overall grade — the\n    harness has no authority to assign one (ADR-009).\n    \"\"\"\n    blocks = [output.answer.strip()]\n\n    if output.data_status_note.strip():\n        blocks.append(f\"Data status:\\n  {output.data_status_note.strip()}\")\n\n    if output.deterministic_signals:\n        signals = [\n            json.dumps(signal, ensure_ascii=False, sort_keys=True)\n            for signal in output.deterministic_signals\n        ]\n        blocks.append(\"Deterministic signals (disclosed calculations):\\n\" + _bullets(signals))\n\n    axes = [f\"{axis}: {rating}\" for axis, rating in sorted(output.confidence.items())]\n    blocks.append(\"Confidence (as stated by the data layer):\\n\" + _bullets(axes))\n\n    if output.limitations:\n        blocks.append(\"Limitations:\\n\" + _bullets(output.limitations))\n\n    provenance = [\n        f\"{key}: {json.dumps(value, ensure_ascii=False, sort_keys=True) if isinstance(value, (dict, list)) else value}\"\n        for key, value in sorted(output.provenance.items())\n    ]\n    blocks.append(\"Provenance:\\n\" + _bullets(provenance))\n    blocks.append(f\"Question {output.question_id} · contract {output.contract_version}\")\n    return \"\\n\\n\".join(blocks)\n\n\ndef render_clarification(output: ClarificationNeeded) -> str:\n    missing = [\n        f\"{item.input} — {item.why_material}\"\n        + (f\" (allowed: {', '.join(item.allowed_values)})\" if item.allowed_values else \"\")\n        for item in output.missing\n    ]\n    return \"\\n\\n\".join(\n        [\n            output.prompt_to_user.strip(),\n            \"Needed before this can be answered:\\n\" + _bullets(missing),\n            f\"Question {output.question_id} (tentative)\",\n        ]\n    )\n\n\ndef render_unsupported(output: Unsupported) -> str:\n    blocks = [f\"Not answerable ({output.reason_kind}):\", f\"  {output.reason}\"]\n    if output.nearest_supported:\n        blocks.append(f\"Closest supported question: {output.nearest_supported}\")\n    return \"\\n\".join(blocks)\n\n\ndef render_budget(output: BudgetExceeded) -> str:\n    blocks = [f\"Stopped on the {output.limit} budget: {output.detail}\"]\n    if output.learned_so_far:\n        blocks.append(f\"Established before stopping: {output.learned_so_far}\")\n    blocks.append(\"No partial answer is shown — a half-rendered figure is worse than none.\")\n    return \"\\n\".join(blocks)\n\n\ndef render_text(output: HarnessOutput) -> str:\n    if isinstance(output, RenderedAnswer):\n        return render_answer(output)\n    if isinstance(output, ClarificationNeeded):\n        return render_clarification(output)\n    if isinstance(output, Unsupported):\n        return render_unsupported(output)\n    return render_budget(output)\n\n\n# ---------------------------------------------------------------------------\n# the conversation\n# ---------------------------------------------------------------------------\n\n\nasync def converse(\n    agent: Any,\n    deps: Deps,\n    question: str,\n    ask_user: Callable[[ClarificationNeeded], str | None] | None = None,\n    max_clarifications: int = 1,\n    record_usage: bool = True,\n) -> HarnessOutput:\n    \"\"\"Run the question, carrying up to `max_clarifications` round-trips.\n\n    The state between turns is PydanticAI's own message history, handed back on\n    `deps.last_messages` — no bespoke session store (architecture §7). An\n    `ask_user` that returns None (or is absent) ends the conversation with the\n    clarification unanswered, which is the honest outcome for a non-interactive\n    caller.\n\n    `record_usage=False` is for callers driving a scripted `FunctionModel`\n    (`demo.py --replay`, `evals/replay.py`): those runs cost nothing, and writing\n    their zero-price \"usage\" into the JSONL the cost report reads would put runs\n    that never happened into the spend record (ADR-005).\n\n    `agent` may be a PydanticAI `Agent` (legacy tool-loop path) or `None`\n    (pipeline path). When `None`, the new 4-stage pipeline is used.\n    \"\"\"\n    history: list[Any] | None = None\n    pipeline_turns: list[tuple[ClarificationNeeded, str]] = []\n    pipeline_user_replies: list[str] = []\n    reply = question\n    for _round in range(max_clarifications + 1):\n        if agent is not None:\n            output = await ask(\n                agent, deps, reply, message_history=history, record_usage=record_usage\n            )\n        else:\n            # The pipeline has no PydanticAI message history. Carry the original\n            # request and each clarification exchange explicitly into the next\n            # intent interpretation so a short answer (for example \"SA2\") does\n            # not become a context-free new question.\n            pipeline_question = question\n            if pipeline_turns:\n                exchanges = \"\\n\\n\".join(\n                    \"Clarification requested:\\n\"\n                    f\"Question ID: {clarification.question_id or 'unknown'}\\n\"\n                    f\"Missing inputs: {', '.join(item.input for item in clarification.missing)}\\n\"\n                    f\"Prompt: {clarification.prompt_to_user}\\n\"\n                    f\"User response: {answer}\"\n                    for clarification, answer in pipeline_turns\n                )\n                pipeline_question = (\n                    f\"Original user request:\\n{question}\\n\\n\"\n                    f\"Clarification exchanges:\\n{exchanges}\\n\\n\"\n                    \"Interpret the completed request using all information above.\"\n                )\n            # Stage 1 needs the full transcript, but deterministic scope checks\n            # may treat only actual user wording as authorization. Keep that\n            # authority channel separate from assistant prompts and metadata.\n            deps._scope_user_question = \"\\n\".join(\n                [question, *pipeline_user_replies]\n            )\n            output = await ask(deps, pipeline_question, record_usage=record_usage)\n        if not isinstance(output, ClarificationNeeded) or ask_user is None:\n            return output\n        answer = ask_user(output)\n        if answer is None or not answer.strip():\n            return output\n        history = deps.last_messages\n        if agent is None:\n            pipeline_turns.append((output, answer.strip()))\n            pipeline_user_replies.append(answer.strip())\n        reply = answer\n    return output\n\n\ndef _prompt_on_terminal(output: ClarificationNeeded) -> str | None:\n    print(render_clarification(output))\n    print()\n    try:\n        return input(\"> \")\n    except EOFError:\n        return None\n\n\ndef build_client(use_stub: bool) -> EvidenceClient:\n    if use_stub:\n        # The same emitter the golden suite runs against: canned envelopes, no\n        # data project, no database. Exercises the whole path except the data.\n        return EvidenceClient(python=Path(sys.executable), emitter=STUB_EMITTER)\n    if not settings.DATA_PROJECT_ROOT or not settings.EVIDENCE_EMITTER.exists():\n        raise SystemExit(\n            \"No evidence emitter found. Set DATA_PROJECT_ROOT (env or .env) to the \"\n            f\"data project — expected {settings.EVIDENCE_EMITTER} — or pass --stub to \"\n            \"run against the canned fixture bundle.\"\n        )\n    return EvidenceClient.from_settings()\n\n\ndef require_credentials() -> None:\n    \"\"\"Fail with a sentence, not a stack trace, when nothing is configured.\n\n    The SDK's own failure for this is a `TypeError` about header resolution,\n    raised deep inside the first request — after the emitter has been located\n    and the agent built. For the first thing a person runs in this repo, that is\n    the wrong first impression of an otherwise working system.\n\n    **An unset env var does not mean there is no credential** — with neither\n    set, the SDK falls back to a profile written by `ant auth login`. But\n    checking that by asking \"is the `ant` CLI on PATH\" was wrong: it treated\n    `claude` (Claude Code) as interchangeable with `ant` (the Anthropic SDK's\n    own login CLI), and `claude auth login` populates neither the env vars nor\n    the profile file the SDK reads — confirmed by reading\n    `anthropic.default_credentials()` in the installed SDK. A `claude\n    auth login` session bridges into this SDK only via `claude setup-token`,\n    which mints an explicit `ANTHROPIC_AUTH_TOKEN`.\n\n    So the check calls the SDK's own resolver — ground truth, not a guess from\n    which binary happens to be installed.\n    \"\"\"\n    if settings.MODEL_PROVIDER == \"claude_account\":\n        ok, detail = claude_account_status(settings.CLAUDE_CLI)\n        if ok:\n            return\n        raise SystemExit(\n            \"No usable Claude subscription-account token is available. Source the \"\n            \"machine-level environment containing CLAUDE_CODE_OAUTH_TOKEN, then \"\n            f\"retry. Diagnostic: {detail}\"\n        )\n\n    if settings.ANTHROPIC_API_KEY or settings.ANTHROPIC_AUTH_TOKEN:\n        return\n    import anthropic\n\n    if anthropic.default_credentials(base_url=\"https://api.anthropic.com\") is not None:\n        return  # a real SDK-readable profile exists (ant auth login, or WIF env vars)\n    raise SystemExit(\n        \"No Anthropic credential found. A `claude auth login` (Claude Code) session, \"\n        \"if you have one, does not count — it is not something this SDK can read. \"\n        \"Run `claude setup-token` and put the token it prints in .env as \"\n        \"ANTHROPIC_AUTH_TOKEN, or set ANTHROPIC_API_KEY (metered API), or \"\n        \"`ant auth login` for an SDK-native profile. \"\n        \"`.venv/bin/python authcheck.py` says which one is in play and whether the \"\n        \"provider accepts it.\"\n    )\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(\n        prog=\"run.py\",\n        description=\"Ask the K-12 market intelligence harness one question.\",\n    )\n    parser.add_argument(\"question\", help=\"the question, in plain English\")\n    parser.add_argument(\n        \"--stub\",\n        action=\"store_true\",\n        help=\"use evals/stub_emitter.py instead of the data project's emitter\",\n    )\n    parser.add_argument(\n        \"--json\", action=\"store_true\", help=\"print the output branch as JSON\"\n    )\n    parser.add_argument(\n        \"--max-clarifications\",\n        type=int,\n        default=1,\n        help=\"clarification round-trips before giving up (default 1, per O-3)\",\n    )\n    parser.add_argument(\n        \"--no-interactive\",\n        action=\"store_true\",\n        help=\"never prompt; report a clarification and exit 2\",\n    )\n    return parser\n\n\ndef main(argv: list[str] | None = None) -> int:\n    configure_logging()  # once per entry point, before anything else logs\n    args = build_parser().parse_args(argv)\n\n    require_credentials()\n    client = build_client(args.stub)\n    deps = Deps(client=client)\n    ask_user = None if args.no_interactive else _prompt_on_terminal\n\n    try:\n        output = asyncio.run(\n            converse(\n                None,\n                deps,\n                args.question,\n                ask_user=ask_user,\n                max_clarifications=args.max_clarifications,\n            )\n        )\n    except (HarnessError, EmitterFailure, ClaudeAccountCliError) as exc:\n        # Classified and already logged at the retry boundary; the caller gets\n        # the operational failure, never a fabricated answer.\n        print(f\"{type(exc).__name__}: {exc}\", file=sys.stderr)\n        return EXIT_FAILED\n\n    if args.json:\n        print(output.model_dump_json(indent=2))\n    else:\n        print(render_text(output))\n    return EXIT_BY_BRANCH[type(output)]\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","numLines":371,"startLine":1,"totalLines":371}}}
