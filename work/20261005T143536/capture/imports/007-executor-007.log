{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Jumpjodk6SM2z7gXrnDu6y","type":"tool_result","content":"1\t\"\"\"M4 — the CLI entry point renders faithfully and carries a clarification.\n2\t\n3\t`run.py` is where a human meets this system, so the two things graded here are\n4\tthe two things a demo could quietly get wrong:\n5\t\n6\t1. **It renders what the harness preserved.** Every limitation string appears in\n7\t   the output, verbatim; the confidence axes appear as the data layer stated\n8\t   them, with no overall grade added; provenance is shown. A renderer that\n9\t   summarised any of these would pass the agent's own gates and break the\n10\t   contract at the last inch (ADR-009).\n11\t2. **It carries one clarification round-trip on real message history** — and\n12\t   stops rather than guessing when there is no answer to be had (O-3).\n13\t\n14\tThe model is scripted throughout; nothing here needs a network or a credential.\n15\t\"\"\"\n16\t\n17\tfrom __future__ import annotations\n18\t\n19\timport asyncio\n20\timport json\n21\timport sys\n22\tfrom pathlib import Path\n23\tfrom typing import Any\n24\t\n25\timport pytest\n26\tfrom pydantic_ai.messages import ModelMessage, ModelResponse, ToolCallPart\n27\tfrom pydantic_ai.models.function import AgentInfo, FunctionModel\n28\t\n29\timport run as cli\n30\tfrom evals import replay as replay_mod\n31\tfrom evals.schema import load_cases, load_reference_solutions\n32\tfrom harness.agent import ask, build_agent\n33\tfrom harness.evidence import EvidenceClient, EvidenceError\n34\tfrom harness.intent import StructuredIntent\n35\tfrom harness.narration import NarrationOutput\n36\tfrom harness.outputs import BudgetExceeded, ClarificationNeeded, MissingInput, Unsupported\n37\tfrom harness.tools import Deps\n38\t\n39\tPROJECT_ROOT = Path(__file__).resolve().parents[2]\n40\tSTUB = PROJECT_ROOT / \"evals\" / \"stub_emitter.py\"\n41\t\n42\tCASES = {c.case_id: c for c in load_cases()}\n43\tREFERENCES = load_reference_solutions()\n44\t\n45\t\n46\tdef stub_client() -> EvidenceClient:\n47\t    return EvidenceClient(python=Path(sys.executable), emitter=STUB)\n48\t\n49\t\n50\tdef answered() -> Any:\n51\t    \"\"\"A real RenderedAnswer, produced by replaying a golden case through the\n52\t    production path — not a hand-built object that might not be reachable.\"\"\"\n53\t    case = CASES[\"answer/VC-POC-01\"]\n54\t    agent = build_agent(model=replay_mod.scripted_model(REFERENCES[case.case_id]))\n55\t    deps = Deps(client=stub_client())\n56\t    return asyncio.run(ask(agent, deps, case.phrasings[0], record_usage=False))\n57\t\n58\t\n59\t# --------------------------------------------------------------------------\n60\t# rendering\n61\t# --------------------------------------------------------------------------\n62\t\n63\t\n64\tdef test_every_limitation_is_rendered_verbatim():\n65\t    output = answered()\n66\t    assert output.limitations, \"the fixture should carry limitations to preserve\"\n67\t    text = cli.render_text(output)\n68\t    for limitation in output.limitations:\n69\t        assert limitation in text\n70\t\n71\t\n72\tdef test_confidence_renders_as_the_axes_the_data_layer_stated():\n73\t    output = answered()\n74\t    text = cli.render_text(output)\n75\t    for axis, rating in output.confidence.items():\n76\t        assert f\"{axis}: {rating}\" in text\n77\t    # Exactly the axes the envelope carried — nothing dropped, and nothing added.\n78\t    # ADR-009: the harness has no authority to assign an overall grade, so a\n79\t    # renderer that invented one would show up here as an extra entry.\n80\t    section = text.split(\"Confidence (as stated by the data layer):\")[1].split(\"\\n\\n\")[0]\n81\t    rendered = {line.strip(\"- \").split(\":\")[0] for line in section.strip().splitlines()}\n82\t    assert rendered == set(output.confidence)\n83\t\n84\t\n85\tdef test_an_answer_shows_its_provenance_and_question_id():\n86\t    output = answered()\n87\t    text = cli.render_text(output)\n88\t    assert output.question_id in text\n89\t    assert \"Provenance\" in text\n90\t\n91\t\n92\tdef test_a_refusal_renders_the_contract_wording_and_nothing_softer():\n93\t    refusal = Unsupported(\n94\t        reason_kind=\"excluded_by_contract\",\n95\t        reason=\"school costs, financial ratios, fees, revenue, assets, liabilities, \"\n96\t        \"cash, or ACNC school comparisons\",\n97\t        nearest_supported=\"VC-POC-01\",\n98\t    )\n99\t    text = cli.render_text(refusal)\n100\t    assert refusal.reason in text\n101\t    assert \"VC-POC-01\" in text\n102\t\n103\t\n104\tdef test_a_budget_trip_shows_no_partial_answer():\n105\t    trip = BudgetExceeded(\n106\t        limit=\"usd\", detail=\"spent $1.20 of $1.00\", learned_so_far=\"resolved school IDs [40387]\"\n107\t    )\n108\t    text = cli.render_text(trip)\n109\t    assert \"usd\" in text\n110\t    assert \"resolved school IDs [40387]\" in text\n111\t    assert \"No partial answer\" in text\n112\t\n113\t\n114\tdef test_a_clarification_names_what_is_missing_and_why():\n115\t    clarification = ClarificationNeeded(\n116\t        question_id=\"VC-POC-08\",\n117\t        missing=[\n118\t            MissingInput(\n119\t                input=\"distance_km\",\n120\t                why_material='\"Near\" is not a distance.',\n121\t                allowed_values=[],\n122\t            )\n123\t        ],\n124\t        prompt_to_user=\"What radius should I use?\",\n125\t    )\n126\t    text = cli.render_text(clarification)\n127\t    assert \"distance_km\" in text\n128\t    assert '\"Near\" is not a distance.' in text\n129\t    assert \"What radius should I use?\" in text\n130\t\n131\t\n132\t# --------------------------------------------------------------------------\n133\t# the clarification round-trip\n134\t# --------------------------------------------------------------------------\n135\t\n136\t\n137\tdef _clarify_then_answer() -> FunctionModel:\n138\t    \"\"\"Ask for a radius on the first turn; on the second — with the user's reply\n139\t    in the history — fetch and answer.\"\"\"\n140\t\n141\t    def script(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:\n142\t        turns = sum(1 for m in messages if isinstance(m, ModelResponse))\n143\t        if turns == 0:\n144\t            return ModelResponse(\n145\t                parts=[\n146\t                    ToolCallPart(\n147\t                        \"final_result_ClarificationNeeded\",\n148\t                        {\n149\t                            \"question_id\": \"VC-POC-08\",\n150\t                            \"missing\": [\n151\t                                {\n152\t                                    \"input\": \"distance_km\",\n153\t                                    \"why_material\": '\"Near\" is not a distance.',\n154\t                                    \"allowed_values\": [],\n155\t                                }\n156\t                            ],\n157\t                            \"prompt_to_user\": \"What radius should I use?\",\n158\t                        },\n159\t                    )\n160\t                ]\n161\t            )\n162\t        if turns == 1:\n163\t            return ModelResponse(\n164\t                parts=[\n165\t                    ToolCallPart(\n166\t                        \"fetch_evidence\",\n167\t                        {\n168\t                            \"question_id\": \"VC-POC-08\",\n169\t                            \"request\": {\"acara_sml_id\": 40387, \"distance_km\": 10},\n170\t                        },\n171\t                    )\n172\t                ]\n173\t            )\n174\t        return ModelResponse(\n175\t            parts=[\n176\t                ToolCallPart(\n177\t                    \"final_result_AnswerDraft\",\n178\t                    {\n179\t                        \"question_id\": \"VC-POC-08\",\n180\t                        \"answer\": \"Within 10 km the returned cohort is listed above.\",\n181\t                        \"data_status_note\": \"\",\n182\t                    },\n183\t                )\n184\t            ]\n185\t        )\n186\t\n187\t    return FunctionModel(script)\n188\t\n189\t\n190\tdef test_one_clarification_round_trip_answers_the_question():\n191\t    agent = build_agent(model=_clarify_then_answer())\n192\t    deps = Deps(client=stub_client())\n193\t    replies = iter([\"10 km\"])\n194\t    output = asyncio.run(\n195\t        cli.converse(\n196\t            agent,\n197\t            deps,\n198\t            \"Which schools are near Alpha College?\",\n199\t            ask_user=lambda _clarification: next(replies),\n200\t            max_clarifications=1,\n201\t        )\n202\t    )\n203\t    assert output.kind == \"answer\"\n204\t    assert output.question_id == \"VC-POC-08\"\n205\t\n206\t\n207\tdef test_pipeline_clarification_retains_original_request_and_prior_inputs(monkeypatch):\n208\t    \"\"\"The pipeline's second intent turn sees the request, question and answer.\"\"\"\n209\t    import harness.intent as intent_mod\n210\t    import harness.narration as narration_mod\n211\t\n212\t    seen_questions: list[str] = []\n213\t\n214\t    async def scripted_intent(question: str, model=None):\n215\t        seen_questions.append(question)\n216\t        if len(seen_questions) == 1:\n217\t            return StructuredIntent(\n218\t                question_id=\"VC-POC-05\",\n219\t                filters={\"acara_sml_id\": 40387},\n220\t            )\n221\t        assert \"Show the market around ACARA 40387\" in question\n222\t        assert \"market_definition\" in question\n223\t        assert \"SA2\" in question\n224\t        return StructuredIntent(\n225\t            question_id=\"VC-POC-05\",\n226\t            filters={\"acara_sml_id\": 40387, \"market_definition\": \"sa2\"},\n227\t        )\n228\t\n229\t    async def scripted_narration(view, deps, model=None):\n230\t        return NarrationOutput(answer=\"The requested market cohort is shown.\")\n231\t\n232\t    monkeypatch.setattr(intent_mod, \"interpret_intent\", scripted_intent)\n233\t    monkeypatch.setattr(narration_mod, \"narrate\", scripted_narration)\n234\t    deps = Deps(client=stub_client())\n235\t\n236\t    output = asyncio.run(\n237\t        cli.converse(\n238\t            None,\n239\t            deps,\n240\t            \"Show the market around ACARA 40387\",\n241\t            ask_user=lambda _clarification: \"SA2\",\n242\t            max_clarifications=1,\n243\t            record_usage=False,\n244\t        )\n245\t    )\n246\t\n247\t    assert output.kind == \"answer\"\n248\t    assert output.question_id == \"VC-POC-05\"\n249\t    assert deps.intent.question_id == \"VC-POC-05\"\n250\t    assert deps.intent.filters == {\"acara_sml_id\": 40387, \"market_definition\": \"sa2\"}\n251\t    assert len(seen_questions) == 2\n252\t\n253\t\n254\t@pytest.mark.parametrize(\n255\t    (\"reply\", \"expected_fetches\"),\n256\t    [\n257\t        (\"Teaching staff, please\", 0),\n258\t        (\"Teaching staff headcount, please\", 1),\n259\t    ],\n260\t)\n261\tdef test_pipeline_metric_scope_uses_only_user_wording(\n262\t    monkeypatch, reply, expected_fetches\n263\t):\n264\t    \"\"\"Assistant clarification prose cannot authorize a broader metric.\"\"\"\n265\t    import harness.intent as intent_mod\n266\t\n267\t    calls = 0\n268\t\n269\t    async def scripted_intent(question: str, model=None):\n270\t        nonlocal calls\n271\t        calls += 1\n272\t        if calls == 2:\n273\t            assert \"Headcount and non-teaching metrics\" in question\n274\t            assert reply in question\n275\t        return StructuredIntent(\n276\t            question_id=\"VC-POC-01\",\n277\t            requested_metrics=[\"teaching staff headcount\"],\n278\t            filters={\"acara_sml_id\": 101},\n279\t        )\n280\t\n281\t    class RecordingUnanswerableClient:\n282\t        def __init__(self):\n283\t            self.fetched: list[dict[str, Any]] = []\n284\t\n285\t        async def fetch_evidence(self, question_id: str, request: dict) -> dict:\n286\t            self.fetched.append({\"question_id\": question_id, \"request\": request})\n287\t            raise EvidenceError(\"unanswerable\", \"synthetic stop after request capture\")\n288\t\n289\t    monkeypatch.setattr(intent_mod, \"interpret_intent\", scripted_intent)\n290\t    client = RecordingUnanswerableClient()\n291\t    deps = Deps(client=client)\n292\t\n293\t    output = asyncio.run(\n294\t        cli.converse(\n295\t            None,\n296\t            deps,\n297\t            \"Show teaching staff at ACARA 101\",\n298\t            ask_user=lambda _clarification: reply,\n299\t            max_clarifications=1,\n300\t            record_usage=False,\n301\t        )\n302\t    )\n303\t\n304\t    assert len(client.fetched) == expected_fetches\n305\t    if expected_fetches:\n306\t        assert client.fetched[0][\"request\"] == {\n307\t            \"acara_sml_id\": 101,\n308\t            \"metrics\": [\"teaching_staff_headcount\"],\n309\t        }\n310\t        assert isinstance(output, Unsupported)\n311\t    else:\n312\t        assert isinstance(output, ClarificationNeeded)\n313\t    assert \"Headcount and non-teaching metrics\" not in deps._scope_user_question\n314\t    assert reply in deps._scope_user_question\n315\t\n316\t\n317\tdef test_a_non_interactive_caller_gets_the_clarification_not_a_guess():\n318\t    \"\"\"The failure this prevents: a batch caller with no human attached filling\n319\t    in a material input to avoid an awkward exit code.\"\"\"\n320\t    agent = build_agent(model=_clarify_then_answer())\n321\t    deps = Deps(client=stub_client())\n322\t    output = asyncio.run(\n323\t        cli.converse(agent, deps, \"Which schools are near Alpha College?\", ask_user=None)\n324\t    )\n325\t    assert isinstance(output, ClarificationNeeded)\n326\t\n327\t\n328\tdef test_an_empty_reply_ends_the_conversation_rather_than_guessing():\n329\t    agent = build_agent(model=_clarify_then_answer())\n330\t    deps = Deps(client=stub_client())\n331\t    output = asyncio.run(\n332\t        cli.converse(\n333\t            agent,\n334\t            deps,\n335\t            \"Which schools are near Alpha College?\",\n336\t            ask_user=lambda _c: \"   \",\n337\t        )\n338\t    )\n339\t    assert isinstance(output, ClarificationNeeded)\n340\t\n341\t\n342\tdef test_zero_clarification_rounds_still_runs_the_question_once():\n343\t    agent = build_agent(model=_clarify_then_answer())\n344\t    deps = Deps(client=stub_client())\n345\t    output = asyncio.run(\n346\t        cli.converse(\n347\t            agent,\n348\t            deps,\n349\t            \"Which schools are near Alpha College?\",\n350\t            ask_user=lambda _c: \"10 km\",\n351\t            max_clarifications=0,\n352\t        )\n353\t    )\n354\t    assert isinstance(output, ClarificationNeeded)\n355\t\n356\t\n357\t# --------------------------------------------------------------------------\n358\t# exit codes and wiring\n359\t# --------------------------------------------------------------------------\n360\t\n361\t\n362\tdef test_main_uses_pipeline_path_by_default(monkeypatch, capsys):\n363\t    \"\"\"The shipping CLI passes None and never constructs the legacy agent.\"\"\"\n364\t    client = object()\n365\t    seen: dict[str, Any] = {}\n366\t\n367\t    async def fake_converse(\n368\t        agent,\n369\t        deps,\n370\t        question,\n371\t        ask_user=None,\n372\t        max_clarifications=1,\n373\t        record_usage=True,\n374\t    ):\n375\t        seen.update(\n376\t            agent=agent,\n377\t            deps=deps,\n378\t            question=question,\n379\t            ask_user=ask_user,\n380\t            max_clarifications=max_clarifications,\n381\t            record_usage=record_usage,\n382\t        )\n383\t        return Unsupported(reason_kind=\"not_in_registry\", reason=\"fixture refusal\")\n384\t\n385\t    monkeypatch.setattr(cli, \"configure_logging\", lambda: None)\n386\t    monkeypatch.setattr(cli, \"require_credentials\", lambda: None)\n387\t    monkeypatch.setattr(cli, \"build_client\", lambda use_stub: client)\n388\t    monkeypatch.setattr(\n389\t        cli,\n390\t        \"build_agent\",\n391\t        lambda: pytest.fail(\"default CLI must not construct a legacy agent\"),\n392\t    )\n393\t    monkeypatch.setattr(cli, \"converse\", fake_converse)\n394\t\n395\t    exit_code = cli.main(\n396\t        [\"--stub\", \"--no-interactive\", \"--max-clarifications\", \"3\", \"question\"]\n397\t    )\n398\t\n399\t    assert exit_code == cli.EXIT_UNSUPPORTED\n400\t    assert seen[\"agent\"] is None\n401\t    assert seen[\"deps\"].client is client\n402\t    assert seen[\"question\"] == \"question\"\n403\t    assert seen[\"ask_user\"] is None\n404\t    assert seen[\"max_clarifications\"] == 3\n405\t    assert seen[\"record_usage\"] is True\n406\t    assert \"fixture refusal\" in capsys.readouterr().out\n407\t\n408\t\n409\tdef test_converse_preserves_explicit_legacy_agent_path(monkeypatch):\n410\t    \"\"\"Replay callers that provide an agent keep the legacy ask signature.\"\"\"\n411\t    legacy_agent = object()\n412\t    deps = Deps(client=stub_client())\n413\t    seen: dict[str, Any] = {}\n414\t\n415\t    async def fake_ask(*args, **kwargs):\n416\t        seen[\"args\"] = args\n417\t        seen[\"kwargs\"] = kwargs\n418\t        return Unsupported(reason_kind=\"not_in_registry\", reason=\"fixture refusal\")\n419\t\n420\t    monkeypatch.setattr(cli, \"ask\", fake_ask)\n421\t\n422\t    output = asyncio.run(\n423\t        cli.converse(\n424\t            legacy_agent,\n425\t            deps,\n426\t            \"question\",\n427\t            max_clarifications=0,\n428\t            record_usage=False,\n429\t        )\n430\t    )\n431\t\n432\t    assert isinstance(output, Unsupported)\n433\t    assert seen[\"args\"] == (legacy_agent, deps, \"question\")\n434\t    assert seen[\"kwargs\"] == {\n435\t        \"message_history\": None,\n436\t        \"record_usage\": False,\n437\t    }\n438\t\n439\t\n440\t@pytest.mark.parametrize(\n441\t    \"branch, expected\",\n442\t    [\n443\t        (cli.RenderedAnswer, cli.EXIT_ANSWERED),\n444\t        (ClarificationNeeded, cli.EXIT_CLARIFICATION),\n445\t        (Unsupported, cli.EXIT_UNSUPPORTED),\n446\t        (BudgetExceeded, cli.EXIT_BUDGET),\n447\t    ],\n448\t)\n449\tdef test_every_output_branch_has_an_exit_code(branch, expected):\n450\t    \"\"\"A branch with no exit code would raise a KeyError at the very end of a\n451\t    run that had otherwise worked.\"\"\"\n452\t    assert cli.EXIT_BY_BRANCH[branch] == expected\n453\t\n454\t\n455\tdef test_the_real_emitter_is_required_unless_stub_is_asked_for(monkeypatch):\n456\t    from config import settings\n457\t\n458\t    monkeypatch.setattr(settings, \"EVIDENCE_EMITTER\", Path(\"/nonexistent/emit.py\"))\n459\t    monkeypatch.setattr(settings, \"DATA_PROJECT_ROOT\", Path(\"\"))\n460\t    with pytest.raises(SystemExit) as excinfo:\n461\t        cli.build_client(use_stub=False)\n462\t    assert \"DATA_PROJECT_ROOT\" in str(excinfo.value)\n463\t\n464\t\n465\tdef test_a_missing_credential_is_a_sentence_not_a_stack_trace(monkeypatch):\n466\t    \"\"\"No env var and no SDK-readable profile: there is genuinely nothing to\n467\t    try, and the message names `claude setup-token` as the fix for a Claude\n468\t    Code session — not `ant auth login`, which most readers of this message\n469\t    will not have and would not help even if they did.\"\"\"\n470\t    import anthropic\n471\t\n472\t    from config import settings\n473\t\n474\t    monkeypatch.setattr(settings, \"MODEL_PROVIDER\", \"anthropic_sdk\")\n475\t    monkeypatch.setattr(settings, \"ANTHROPIC_API_KEY\", None)\n476\t    monkeypatch.setattr(settings, \"ANTHROPIC_AUTH_TOKEN\", None)\n477\t    monkeypatch.setattr(anthropic, \"default_credentials\", lambda **_: None)\n478\t    with pytest.raises(SystemExit) as excinfo:\n479\t        cli.require_credentials()\n480\t    message = str(excinfo.value)\n481\t    for route in (\"claude setup-token\", \"ANTHROPIC_AUTH_TOKEN\", \"ANTHROPIC_API_KEY\"):\n482\t        assert route in message\n483\t\n484\t\n485\t@pytest.mark.parametrize(\"var\", [\"ANTHROPIC_API_KEY\", \"ANTHROPIC_AUTH_TOKEN\"])\n486\tdef test_either_env_credential_satisfies_the_check(monkeypatch, var):\n487\t    import anthropic\n488\t\n489\t    from config import settings\n490\t\n491\t    monkeypatch.setattr(settings, \"MODEL_PROVIDER\", \"anthropic_sdk\")\n492\t    monkeypatch.setattr(settings, \"ANTHROPIC_API_KEY\", None)\n493\t    monkeypatch.setattr(settings, \"ANTHROPIC_AUTH_TOKEN\", None)\n494\t    monkeypatch.setattr(settings, var, \"set\")\n495\t    monkeypatch.setattr(anthropic, \"default_credentials\", lambda **_: None)\n496\t    cli.require_credentials()\n497\t\n498\t\n499\tdef test_a_claude_code_login_alone_does_not_satisfy_the_check(monkeypatch):\n500\t    \"\"\"The bug this replaces: treating `claude` being on PATH — or `claude auth\n501\t    status` reporting logged in — as proof the SDK can authenticate. It cannot;\n502\t    `claude auth login` writes to neither the env vars nor the profile file\n503\t    `anthropic.default_credentials()` reads, so the check must still block.\"\"\"\n504\t    import anthropic\n505\t\n506\t    from config import settings\n507\t\n508\t    monkeypatch.setattr(settings, \"MODEL_PROVIDER\", \"anthropic_sdk\")\n509\t    monkeypatch.setattr(settings, \"ANTHROPIC_API_KEY\", None)\n510\t    monkeypatch.setattr(settings, \"ANTHROPIC_AUTH_TOKEN\", None)\n511\t    monkeypatch.setattr(anthropic, \"default_credentials\", lambda **_: None)\n512\t    with pytest.raises(SystemExit):\n513\t        cli.require_credentials()\n514\t\n515\t\n516\tdef test_a_real_sdk_profile_satisfies_the_check_with_no_env_var(monkeypatch):\n517\t    \"\"\"An unset env var is not the absence of a credential — an `ant auth\n518\t    login` profile (or workload-identity federation) is a real, SDK-readable\n519\t    credential the check must accept without an env var set.\"\"\"\n520\t    import anthropic\n521\t\n522\t    from config import settings\n523\t\n524\t    monkeypatch.setattr(settings, \"MODEL_PROVIDER\", \"anthropic_sdk\")\n525\t    monkeypatch.setattr(settings, \"ANTHROPIC_API_KEY\", None)\n526\t    monkeypatch.setattr(settings, \"ANTHROPIC_AUTH_TOKEN\", None)\n527\t    monkeypatch.setattr(anthropic, \"default_credentials\", lambda **_: object())\n528\t    cli.require_credentials()\n529\t\n530\t\n531\tdef test_stub_mode_needs_no_data_project():\n532\t    client = cli.build_client(use_stub=True)\n533\t    assert client.emitter == STUB\n534\t\n535\t\n536\tdef test_json_output_is_the_branch_itself():\n537\t    output = answered()\n538\t    payload = json.loads(output.model_dump_json())\n539\t    assert payload[\"question_id\"] == output.question_id\n540\t    assert payload[\"limitations\"] == output.limitations\n541\t\n542\t\n543\t# --------------------------------------------------------------------------\n544\t# the corrected auth-source check (ADR-011 follow-up)\n545\t# --------------------------------------------------------------------------\n546\t\n547\t\n548\tdef test_anthropic_credentials_use_the_sdks_own_resolver(monkeypatch):\n549\t    \"\"\"The bug this replaces, pinned so it cannot come back: an earlier\n550\t    version inferred \"a profile might work\" from `shutil.which(\"ant\")`, which\n551\t    also matched a `claude` CLI that cannot bridge into this SDK at all. The\n552\t    fix calls `anthropic.default_credentials()` — ground truth — instead.\"\"\"\n553\t    from config import settings\n554\t\n555\t    monkeypatch.setattr(settings, \"MODEL_PROVIDER\", \"anthropic_sdk\")\n556\t    source = (Path(__file__).resolve().parents[2] / \"run.py\").read_text(\"utf-8\")\n557\t    assert \"default_credentials\" in source\n558\t\n559\t\n560\tdef test_valid_claude_account_token_satisfies_the_default_check(monkeypatch):\n561\t    from config import settings\n562\t\n563\t    monkeypatch.setattr(settings, \"MODEL_PROVIDER\", \"claude_account\")\n564\t    monkeypatch.setattr(\n565\t        cli, \"claude_account_status\", lambda _binary: (True, \"logged in\")\n566\t    )\n567\t    cli.require_credentials()\n568\t\n569\t\n570\tdef test_missing_claude_account_token_is_a_clear_error(monkeypatch):\n571\t    from config import settings\n572\t\n573\t    monkeypatch.setattr(settings, \"MODEL_PROVIDER\", \"claude_account\")\n574\t    monkeypatch.setattr(\n575\t        cli, \"claude_account_status\", lambda _binary: (False, \"token is not set\")\n576\t    )\n577\t    with pytest.raises(SystemExit, match=\"CLAUDE_CODE_OAUTH_TOKEN\"):\n578\t        cli.require_credentials()\n579\t"}]},"parent_tool_use_id":null,"session_id":"1d720d32-2e38-4c91-ace7-0965c0cbf441","uuid":"cf4a1f50-7f9d-4fb0-9390-f998b405a944","timestamp":"2026-10-06T02:26:57.399Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/tests/unit/test_run_cli.py","content":"\"\"\"M4 — the CLI entry point renders faithfully and carries a clarification.\n\n`run.py` is where a human meets this system, so the two things graded here are\nthe two things a demo could quietly get wrong:\n\n1. **It renders what the harness preserved.** Every limitation string appears in\n   the output, verbatim; the confidence axes appear as the data layer stated\n   them, with no overall grade added; provenance is shown. A renderer that\n   summarised any of these would pass the agent's own gates and break the\n   contract at the last inch (ADR-009).\n2. **It carries one clarification round-trip on real message history** — and\n   stops rather than guessing when there is no answer to be had (O-3).\n\nThe model is scripted throughout; nothing here needs a network or a credential.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport json\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nimport pytest\nfrom pydantic_ai.messages import ModelMessage, ModelResponse, ToolCallPart\nfrom pydantic_ai.models.function import AgentInfo, FunctionModel\n\nimport run as cli\nfrom evals import replay as replay_mod\nfrom evals.schema import load_cases, load_reference_solutions\nfrom harness.agent import ask, build_agent\nfrom harness.evidence import EvidenceClient, EvidenceError\nfrom harness.intent import StructuredIntent\nfrom harness.narration import NarrationOutput\nfrom harness.outputs import BudgetExceeded, ClarificationNeeded, MissingInput, Unsupported\nfrom harness.tools import Deps\n\nPROJECT_ROOT = Path(__file__).resolve().parents[2]\nSTUB = PROJECT_ROOT / \"evals\" / \"stub_emitter.py\"\n\nCASES = {c.case_id: c for c in load_cases()}\nREFERENCES = load_reference_solutions()\n\n\ndef stub_client() -> EvidenceClient:\n    return EvidenceClient(python=Path(sys.executable), emitter=STUB)\n\n\ndef answered() -> Any:\n    \"\"\"A real RenderedAnswer, produced by replaying a golden case through the\n    production path — not a hand-built object that might not be reachable.\"\"\"\n    case = CASES[\"answer/VC-POC-01\"]\n    agent = build_agent(model=replay_mod.scripted_model(REFERENCES[case.case_id]))\n    deps = Deps(client=stub_client())\n    return asyncio.run(ask(agent, deps, case.phrasings[0], record_usage=False))\n\n\n# --------------------------------------------------------------------------\n# rendering\n# --------------------------------------------------------------------------\n\n\ndef test_every_limitation_is_rendered_verbatim():\n    output = answered()\n    assert output.limitations, \"the fixture should carry limitations to preserve\"\n    text = cli.render_text(output)\n    for limitation in output.limitations:\n        assert limitation in text\n\n\ndef test_confidence_renders_as_the_axes_the_data_layer_stated():\n    output = answered()\n    text = cli.render_text(output)\n    for axis, rating in output.confidence.items():\n        assert f\"{axis}: {rating}\" in text\n    # Exactly the axes the envelope carried — nothing dropped, and nothing added.\n    # ADR-009: the harness has no authority to assign an overall grade, so a\n    # renderer that invented one would show up here as an extra entry.\n    section = text.split(\"Confidence (as stated by the data layer):\")[1].split(\"\\n\\n\")[0]\n    rendered = {line.strip(\"- \").split(\":\")[0] for line in section.strip().splitlines()}\n    assert rendered == set(output.confidence)\n\n\ndef test_an_answer_shows_its_provenance_and_question_id():\n    output = answered()\n    text = cli.render_text(output)\n    assert output.question_id in text\n    assert \"Provenance\" in text\n\n\ndef test_a_refusal_renders_the_contract_wording_and_nothing_softer():\n    refusal = Unsupported(\n        reason_kind=\"excluded_by_contract\",\n        reason=\"school costs, financial ratios, fees, revenue, assets, liabilities, \"\n        \"cash, or ACNC school comparisons\",\n        nearest_supported=\"VC-POC-01\",\n    )\n    text = cli.render_text(refusal)\n    assert refusal.reason in text\n    assert \"VC-POC-01\" in text\n\n\ndef test_a_budget_trip_shows_no_partial_answer():\n    trip = BudgetExceeded(\n        limit=\"usd\", detail=\"spent $1.20 of $1.00\", learned_so_far=\"resolved school IDs [40387]\"\n    )\n    text = cli.render_text(trip)\n    assert \"usd\" in text\n    assert \"resolved school IDs [40387]\" in text\n    assert \"No partial answer\" in text\n\n\ndef test_a_clarification_names_what_is_missing_and_why():\n    clarification = ClarificationNeeded(\n        question_id=\"VC-POC-08\",\n        missing=[\n            MissingInput(\n                input=\"distance_km\",\n                why_material='\"Near\" is not a distance.',\n                allowed_values=[],\n            )\n        ],\n        prompt_to_user=\"What radius should I use?\",\n    )\n    text = cli.render_text(clarification)\n    assert \"distance_km\" in text\n    assert '\"Near\" is not a distance.' in text\n    assert \"What radius should I use?\" in text\n\n\n# --------------------------------------------------------------------------\n# the clarification round-trip\n# --------------------------------------------------------------------------\n\n\ndef _clarify_then_answer() -> FunctionModel:\n    \"\"\"Ask for a radius on the first turn; on the second — with the user's reply\n    in the history — fetch and answer.\"\"\"\n\n    def script(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:\n        turns = sum(1 for m in messages if isinstance(m, ModelResponse))\n        if turns == 0:\n            return ModelResponse(\n                parts=[\n                    ToolCallPart(\n                        \"final_result_ClarificationNeeded\",\n                        {\n                            \"question_id\": \"VC-POC-08\",\n                            \"missing\": [\n                                {\n                                    \"input\": \"distance_km\",\n                                    \"why_material\": '\"Near\" is not a distance.',\n                                    \"allowed_values\": [],\n                                }\n                            ],\n                            \"prompt_to_user\": \"What radius should I use?\",\n                        },\n                    )\n                ]\n            )\n        if turns == 1:\n            return ModelResponse(\n                parts=[\n                    ToolCallPart(\n                        \"fetch_evidence\",\n                        {\n                            \"question_id\": \"VC-POC-08\",\n                            \"request\": {\"acara_sml_id\": 40387, \"distance_km\": 10},\n                        },\n                    )\n                ]\n            )\n        return ModelResponse(\n            parts=[\n                ToolCallPart(\n                    \"final_result_AnswerDraft\",\n                    {\n                        \"question_id\": \"VC-POC-08\",\n                        \"answer\": \"Within 10 km the returned cohort is listed above.\",\n                        \"data_status_note\": \"\",\n                    },\n                )\n            ]\n        )\n\n    return FunctionModel(script)\n\n\ndef test_one_clarification_round_trip_answers_the_question():\n    agent = build_agent(model=_clarify_then_answer())\n    deps = Deps(client=stub_client())\n    replies = iter([\"10 km\"])\n    output = asyncio.run(\n        cli.converse(\n            agent,\n            deps,\n            \"Which schools are near Alpha College?\",\n            ask_user=lambda _clarification: next(replies),\n            max_clarifications=1,\n        )\n    )\n    assert output.kind == \"answer\"\n    assert output.question_id == \"VC-POC-08\"\n\n\ndef test_pipeline_clarification_retains_original_request_and_prior_inputs(monkeypatch):\n    \"\"\"The pipeline's second intent turn sees the request, question and answer.\"\"\"\n    import harness.intent as intent_mod\n    import harness.narration as narration_mod\n\n    seen_questions: list[str] = []\n\n    async def scripted_intent(question: str, model=None):\n        seen_questions.append(question)\n        if len(seen_questions) == 1:\n            return StructuredIntent(\n                question_id=\"VC-POC-05\",\n                filters={\"acara_sml_id\": 40387},\n            )\n        assert \"Show the market around ACARA 40387\" in question\n        assert \"market_definition\" in question\n        assert \"SA2\" in question\n        return StructuredIntent(\n            question_id=\"VC-POC-05\",\n            filters={\"acara_sml_id\": 40387, \"market_definition\": \"sa2\"},\n        )\n\n    async def scripted_narration(view, deps, model=None):\n        return NarrationOutput(answer=\"The requested market cohort is shown.\")\n\n    monkeypatch.setattr(intent_mod, \"interpret_intent\", scripted_intent)\n    monkeypatch.setattr(narration_mod, \"narrate\", scripted_narration)\n    deps = Deps(client=stub_client())\n\n    output = asyncio.run(\n        cli.converse(\n            None,\n            deps,\n            \"Show the market around ACARA 40387\",\n            ask_user=lambda _clarification: \"SA2\",\n            max_clarifications=1,\n            record_usage=False,\n        )\n    )\n\n    assert output.kind == \"answer\"\n    assert output.question_id == \"VC-POC-05\"\n    assert deps.intent.question_id == \"VC-POC-05\"\n    assert deps.intent.filters == {\"acara_sml_id\": 40387, \"market_definition\": \"sa2\"}\n    assert len(seen_questions) == 2\n\n\n@pytest.mark.parametrize(\n    (\"reply\", \"expected_fetches\"),\n    [\n        (\"Teaching staff, please\", 0),\n        (\"Teaching staff headcount, please\", 1),\n    ],\n)\ndef test_pipeline_metric_scope_uses_only_user_wording(\n    monkeypatch, reply, expected_fetches\n):\n    \"\"\"Assistant clarification prose cannot authorize a broader metric.\"\"\"\n    import harness.intent as intent_mod\n\n    calls = 0\n\n    async def scripted_intent(question: str, model=None):\n        nonlocal calls\n        calls += 1\n        if calls == 2:\n            assert \"Headcount and non-teaching metrics\" in question\n            assert reply in question\n        return StructuredIntent(\n            question_id=\"VC-POC-01\",\n            requested_metrics=[\"teaching staff headcount\"],\n            filters={\"acara_sml_id\": 101},\n        )\n\n    class RecordingUnanswerableClient:\n        def __init__(self):\n            self.fetched: list[dict[str, Any]] = []\n\n        async def fetch_evidence(self, question_id: str, request: dict) -> dict:\n            self.fetched.append({\"question_id\": question_id, \"request\": request})\n            raise EvidenceError(\"unanswerable\", \"synthetic stop after request capture\")\n\n    monkeypatch.setattr(intent_mod, \"interpret_intent\", scripted_intent)\n    client = RecordingUnanswerableClient()\n    deps = Deps(client=client)\n\n    output = asyncio.run(\n        cli.converse(\n            None,\n            deps,\n            \"Show teaching staff at ACARA 101\",\n            ask_user=lambda _clarification: reply,\n            max_clarifications=1,\n            record_usage=False,\n        )\n    )\n\n    assert len(client.fetched) == expected_fetches\n    if expected_fetches:\n        assert client.fetched[0][\"request\"] == {\n            \"acara_sml_id\": 101,\n            \"metrics\": [\"teaching_staff_headcount\"],\n        }\n        assert isinstance(output, Unsupported)\n    else:\n        assert isinstance(output, ClarificationNeeded)\n    assert \"Headcount and non-teaching metrics\" not in deps._scope_user_question\n    assert reply in deps._scope_user_question\n\n\ndef test_a_non_interactive_caller_gets_the_clarification_not_a_guess():\n    \"\"\"The failure this prevents: a batch caller with no human attached filling\n    in a material input to avoid an awkward exit code.\"\"\"\n    agent = build_agent(model=_clarify_then_answer())\n    deps = Deps(client=stub_client())\n    output = asyncio.run(\n        cli.converse(agent, deps, \"Which schools are near Alpha College?\", ask_user=None)\n    )\n    assert isinstance(output, ClarificationNeeded)\n\n\ndef test_an_empty_reply_ends_the_conversation_rather_than_guessing():\n    agent = build_agent(model=_clarify_then_answer())\n    deps = Deps(client=stub_client())\n    output = asyncio.run(\n        cli.converse(\n            agent,\n            deps,\n            \"Which schools are near Alpha College?\",\n            ask_user=lambda _c: \"   \",\n        )\n    )\n    assert isinstance(output, ClarificationNeeded)\n\n\ndef test_zero_clarification_rounds_still_runs_the_question_once():\n    agent = build_agent(model=_clarify_then_answer())\n    deps = Deps(client=stub_client())\n    output = asyncio.run(\n        cli.converse(\n            agent,\n            deps,\n            \"Which schools are near Alpha College?\",\n            ask_user=lambda _c: \"10 km\",\n            max_clarifications=0,\n        )\n    )\n    assert isinstance(output, ClarificationNeeded)\n\n\n# --------------------------------------------------------------------------\n# exit codes and wiring\n# --------------------------------------------------------------------------\n\n\ndef test_main_uses_pipeline_path_by_default(monkeypatch, capsys):\n    \"\"\"The shipping CLI passes None and never constructs the legacy agent.\"\"\"\n    client = object()\n    seen: dict[str, Any] = {}\n\n    async def fake_converse(\n        agent,\n        deps,\n        question,\n        ask_user=None,\n        max_clarifications=1,\n        record_usage=True,\n    ):\n        seen.update(\n            agent=agent,\n            deps=deps,\n            question=question,\n            ask_user=ask_user,\n            max_clarifications=max_clarifications,\n            record_usage=record_usage,\n        )\n        return Unsupported(reason_kind=\"not_in_registry\", reason=\"fixture refusal\")\n\n    monkeypatch.setattr(cli, \"configure_logging\", lambda: None)\n    monkeypatch.setattr(cli, \"require_credentials\", lambda: None)\n    monkeypatch.setattr(cli, \"build_client\", lambda use_stub: client)\n    monkeypatch.setattr(\n        cli,\n        \"build_agent\",\n        lambda: pytest.fail(\"default CLI must not construct a legacy agent\"),\n    )\n    monkeypatch.setattr(cli, \"converse\", fake_converse)\n\n    exit_code = cli.main(\n        [\"--stub\", \"--no-interactive\", \"--max-clarifications\", \"3\", \"question\"]\n    )\n\n    assert exit_code == cli.EXIT_UNSUPPORTED\n    assert seen[\"agent\"] is None\n    assert seen[\"deps\"].client is client\n    assert seen[\"question\"] == \"question\"\n    assert seen[\"ask_user\"] is None\n    assert seen[\"max_clarifications\"] == 3\n    assert seen[\"record_usage\"] is True\n    assert \"fixture refusal\" in capsys.readouterr().out\n\n\ndef test_converse_preserves_explicit_legacy_agent_path(monkeypatch):\n    \"\"\"Replay callers that provide an agent keep the legacy ask signature.\"\"\"\n    legacy_agent = object()\n    deps = Deps(client=stub_client())\n    seen: dict[str, Any] = {}\n\n    async def fake_ask(*args, **kwargs):\n        seen[\"args\"] = args\n        seen[\"kwargs\"] = kwargs\n        return Unsupported(reason_kind=\"not_in_registry\", reason=\"fixture refusal\")\n\n    monkeypatch.setattr(cli, \"ask\", fake_ask)\n\n    output = asyncio.run(\n        cli.converse(\n            legacy_agent,\n            deps,\n            \"question\",\n            max_clarifications=0,\n            record_usage=False,\n        )\n    )\n\n    assert isinstance(output, Unsupported)\n    assert seen[\"args\"] == (legacy_agent, deps, \"question\")\n    assert seen[\"kwargs\"] == {\n        \"message_history\": None,\n        \"record_usage\": False,\n    }\n\n\n@pytest.mark.parametrize(\n    \"branch, expected\",\n    [\n        (cli.RenderedAnswer, cli.EXIT_ANSWERED),\n        (ClarificationNeeded, cli.EXIT_CLARIFICATION),\n        (Unsupported, cli.EXIT_UNSUPPORTED),\n        (BudgetExceeded, cli.EXIT_BUDGET),\n    ],\n)\ndef test_every_output_branch_has_an_exit_code(branch, expected):\n    \"\"\"A branch with no exit code would raise a KeyError at the very end of a\n    run that had otherwise worked.\"\"\"\n    assert cli.EXIT_BY_BRANCH[branch] == expected\n\n\ndef test_the_real_emitter_is_required_unless_stub_is_asked_for(monkeypatch):\n    from config import settings\n\n    monkeypatch.setattr(settings, \"EVIDENCE_EMITTER\", Path(\"/nonexistent/emit.py\"))\n    monkeypatch.setattr(settings, \"DATA_PROJECT_ROOT\", Path(\"\"))\n    with pytest.raises(SystemExit) as excinfo:\n        cli.build_client(use_stub=False)\n    assert \"DATA_PROJECT_ROOT\" in str(excinfo.value)\n\n\ndef test_a_missing_credential_is_a_sentence_not_a_stack_trace(monkeypatch):\n    \"\"\"No env var and no SDK-readable profile: there is genuinely nothing to\n    try, and the message names `claude setup-token` as the fix for a Claude\n    Code session — not `ant auth login`, which most readers of this message\n    will not have and would not help even if they did.\"\"\"\n    import anthropic\n\n    from config import settings\n\n    monkeypatch.setattr(settings, \"MODEL_PROVIDER\", \"anthropic_sdk\")\n    monkeypatch.setattr(settings, \"ANTHROPIC_API_KEY\", None)\n    monkeypatch.setattr(settings, \"ANTHROPIC_AUTH_TOKEN\", None)\n    monkeypatch.setattr(anthropic, \"default_credentials\", lambda **_: None)\n    with pytest.raises(SystemExit) as excinfo:\n        cli.require_credentials()\n    message = str(excinfo.value)\n    for route in (\"claude setup-token\", \"ANTHROPIC_AUTH_TOKEN\", \"ANTHROPIC_API_KEY\"):\n        assert route in message\n\n\n@pytest.mark.parametrize(\"var\", [\"ANTHROPIC_API_KEY\", \"ANTHROPIC_AUTH_TOKEN\"])\ndef test_either_env_credential_satisfies_the_check(monkeypatch, var):\n    import anthropic\n\n    from config import settings\n\n    monkeypatch.setattr(settings, \"MODEL_PROVIDER\", \"anthropic_sdk\")\n    monkeypatch.setattr(settings, \"ANTHROPIC_API_KEY\", None)\n    monkeypatch.setattr(settings, \"ANTHROPIC_AUTH_TOKEN\", None)\n    monkeypatch.setattr(settings, var, \"set\")\n    monkeypatch.setattr(anthropic, \"default_credentials\", lambda **_: None)\n    cli.require_credentials()\n\n\ndef test_a_claude_code_login_alone_does_not_satisfy_the_check(monkeypatch):\n    \"\"\"The bug this replaces: treating `claude` being on PATH — or `claude auth\n    status` reporting logged in — as proof the SDK can authenticate. It cannot;\n    `claude auth login` writes to neither the env vars nor the profile file\n    `anthropic.default_credentials()` reads, so the check must still block.\"\"\"\n    import anthropic\n\n    from config import settings\n\n    monkeypatch.setattr(settings, \"MODEL_PROVIDER\", \"anthropic_sdk\")\n    monkeypatch.setattr(settings, \"ANTHROPIC_API_KEY\", None)\n    monkeypatch.setattr(settings, \"ANTHROPIC_AUTH_TOKEN\", None)\n    monkeypatch.setattr(anthropic, \"default_credentials\", lambda **_: None)\n    with pytest.raises(SystemExit):\n        cli.require_credentials()\n\n\ndef test_a_real_sdk_profile_satisfies_the_check_with_no_env_var(monkeypatch):\n    \"\"\"An unset env var is not the absence of a credential — an `ant auth\n    login` profile (or workload-identity federation) is a real, SDK-readable\n    credential the check must accept without an env var set.\"\"\"\n    import anthropic\n\n    from config import settings\n\n    monkeypatch.setattr(settings, \"MODEL_PROVIDER\", \"anthropic_sdk\")\n    monkeypatch.setattr(settings, \"ANTHROPIC_API_KEY\", None)\n    monkeypatch.setattr(settings, \"ANTHROPIC_AUTH_TOKEN\", None)\n    monkeypatch.setattr(anthropic, \"default_credentials\", lambda **_: object())\n    cli.require_credentials()\n\n\ndef test_stub_mode_needs_no_data_project():\n    client = cli.build_client(use_stub=True)\n    assert client.emitter == STUB\n\n\ndef test_json_output_is_the_branch_itself():\n    output = answered()\n    payload = json.loads(output.model_dump_json())\n    assert payload[\"question_id\"] == output.question_id\n    assert payload[\"limitations\"] == output.limitations\n\n\n# --------------------------------------------------------------------------\n# the corrected auth-source check (ADR-011 follow-up)\n# --------------------------------------------------------------------------\n\n\ndef test_anthropic_credentials_use_the_sdks_own_resolver(monkeypatch):\n    \"\"\"The bug this replaces, pinned so it cannot come back: an earlier\n    version inferred \"a profile might work\" from `shutil.which(\"ant\")`, which\n    also matched a `claude` CLI that cannot bridge into this SDK at all. The\n    fix calls `anthropic.default_credentials()` — ground truth — instead.\"\"\"\n    from config import settings\n\n    monkeypatch.setattr(settings, \"MODEL_PROVIDER\", \"anthropic_sdk\")\n    source = (Path(__file__).resolve().parents[2] / \"run.py\").read_text(\"utf-8\")\n    assert \"default_credentials\" in source\n\n\ndef test_valid_claude_account_token_satisfies_the_default_check(monkeypatch):\n    from config import settings\n\n    monkeypatch.setattr(settings, \"MODEL_PROVIDER\", \"claude_account\")\n    monkeypatch.setattr(\n        cli, \"claude_account_status\", lambda _binary: (True, \"logged in\")\n    )\n    cli.require_credentials()\n\n\ndef test_missing_claude_account_token_is_a_clear_error(monkeypatch):\n    from config import settings\n\n    monkeypatch.setattr(settings, \"MODEL_PROVIDER\", \"claude_account\")\n    monkeypatch.setattr(\n        cli, \"claude_account_status\", lambda _binary: (False, \"token is not set\")\n    )\n    with pytest.raises(SystemExit, match=\"CLAUDE_CODE_OAUTH_TOKEN\"):\n        cli.require_credentials()\n","numLines":579,"startLine":1,"totalLines":579}}}
