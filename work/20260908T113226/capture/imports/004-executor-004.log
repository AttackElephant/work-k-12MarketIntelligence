: 500,\n            \"cache_read_input_tokens\": 2000,\n            \"cache_creation_input_tokens\": 100,\n        },\n        \"modelUsage\": {\n            \"claude-sonnet-4-6\": {\n                \"input_tokens\": 1000,\n                \"output_tokens\": 500,\n                \"cache_read_input_tokens\": 2000,\n                \"cache_creation_input_tokens\": 100,\n            },\n            \"claude-haiku-4-6\": {\n                \"input_tokens\": 50,\n                \"output_tokens\": 10,\n            },\n        },\n    }\n    usage = claude_account_cli._request_usage(envelope)\n\n    # Main + helper model counts are summed into the aggregate.\n    assert usage.input_tokens == 3100 + 50\n    assert usage.output_tokens == 500 + 10\n    assert usage.cache_read_tokens == 2000\n    assert usage.cache_write_tokens == 100\n\n    # Per-model breakdown is recorded as integer-only, model-name-keyed\n    # entries (DECIDED C2, option (a): no schema change).\n    for key, value in usage.details.items():\n        assert isinstance(value, int)\n    assert usage.details[\"claude-sonnet-4-6.input_tokens\"] == 3100\n    assert usage.details[\"claude-sonnet-4-6.output_tokens\"] == 500\n    assert usage.details[\"claude-haiku-4-6.input_tokens\"] == 50\n    assert usage.details[\"claude-haiku-4-6.output_tokens\"] == 10\n    # The raw top-level block is also recorded for auditability alongside\n    # the per-model breakdown, in case the two disagree.\n    assert usage.details[\"usage.input_tokens\"] == 3100\n    assert usage.details[\"usage.output_tokens\"] == 500\n\n\ndef test_request_usage_contains_no_raw_result_text_and_no_token(monkeypatch):\n    monkeypatch.setenv(\"CLAUDE_CODE_OAUTH_TOKEN\", SECRET_TOKEN)\n    envelope = {\n        \"type\": \"result\",\n        \"result\": f\"Here is your answer, token={SECRET_TOKEN}\",\n        \"usage\": {\n            \"input_tokens\": 1000,\n            \"output_tokens\": 500,\n            \"cache_read_input_tokens\": 2000,\n            \"cache_creation_input_tokens\": 100,\n        },\n        \"modelUsage\": {\n            \"claude-sonnet-4-6\": {\"input_tokens\": 1000, \"output_tokens\": 500},\n        },\n    }\n    usage = claude_account_cli._request_usage(envelope)\n\n    rendered = json.dumps({\"usage\": usage.__dict__, \"details\": usage.details})\n    assert \"Here is your answer\" not in rendered\n    assert SECRET_TOKEN not in rendered\n    assert all(isinstance(v, int) for v in usage.details.values())\n\n\ndef test_request_usage_tolerates_a_missing_usage_block():\n    usage = claude_account_cli._request_usage({})\n    assert usage.input_tokens == 0\n    assert usage.output_tokens == 0\n    assert usage.cache_read_tokens == 0\n    assert usage.cache_write_tokens == 0\n    assert usage.details == {}\n\n\ndef test_request_usage_tolerates_a_partial_usage_block():\n    usage = claude_account_cli._request_usage({\"usage\": {\"output_tokens\": 7}})\n    assert usage.input_tokens == 0\n    assert usage.output_tokens == 7\n    assert usage.cache_read_tokens == 0\n    assert usage.cache_write_tokens == 0\n\n\ndef test_request_usage_ignores_a_malformed_model_usage_map():\n    envelope = {\n        \"usage\": {\"input_tokens\": 5},\n        \"modelUsage\": \"not-a-map\",\n    }\n    usage = claude_account_cli._request_usage(envelope)\n    assert usage.input_tokens == 5\n\n\ndef test_build_claude_account_model_returns_populated_usage(monkeypatch):\n    monkeypatch.setenv(\"CLAUDE_CODE_OAUTH_TOKEN\", SECRET_TOKEN)\n    monkeypatch.setattr(claude_account_cli.shutil, \"which\", lambda _: \"/usr/bin/claude\")\n\n    stdout = json.dumps(\n        {\n            \"type\": \"result\",\n            \"is_error\": False,\n            \"structured_output\": {\n                \"tool_name\": \"final_result_AnswerDraft\",\n                \"arguments_json\": \"{}\",\n            },\n            \"usage\": {\n                \"input_tokens\": 1000,\n                \"output_tokens\": 500,\n                \"cache_read_input_tokens\": 2000,\n                \"cache_creation_input_tokens\": 100,\n            },\n        }\n    ).encode()\n\n    class FakeProcess:\n        returncode = 0\n\n        async def communicate(self, _input):\n            return stdout, b\"\"\n\n        def kill(self):\n            pass\n\n        async def wait(self):\n            return None\n\n    async def fake_create_subprocess_exec(*args, **kwargs):\n        return FakeProcess()\n\n    monkeypatch.setattr(\n        claude_account_cli.asyncio, \"create_subprocess_exec\", fake_create_subprocess_exec\n    )\n\n    class Tool:\n        name = \"final_result_AnswerDraft\"\n        kind = \"output\"\n        description = \"d\"\n        parameters_json_schema = {\"type\": \"object\"}\n\n    class Info:\n        function_tools: list = []\n        output_tools = [Tool()]\n\n    model = claude_account_cli.build_claude_account_model(model=\"claude-sonnet-4-6\")\n    messages = [ModelRequest(parts=[UserPromptPart(content=\"question\")])]\n\n    async def run():\n        return await claude_account_cli._invoke_claude(\n            messages,\n            Info(),\n            binary=\"claude\",\n            model=\"claude-sonnet-4-6\",\n            timeout_seconds=10,\n        )\n\n    import asyncio as asyncio_module\n\n    response = asyncio_module.run(run())\n\n    assert response.usage.input_tokens == 3100\n    assert response.usage.output_tokens == 500\n    assert response.usage.cache_read_tokens == 2000\n    assert response.usage.cache_write_tokens == 100","originalFile":"\"\"\"Claude subscription-account transport: auth isolation and typed actions.\"\"\"\n\nimport json\n\nimport pytest\nfrom pydantic_ai.messages import ModelRequest, SystemPromptPart, ToolReturnPart, UserPromptPart\n\nfrom harness import claude_account_cli\nfrom harness.errors import AuthError, QuotaExceeded\n\nSECRET_TOKEN = \"secret-account-token\"\n\n\ndef test_account_environment_requires_the_explicit_subscription_token(monkeypatch):\n    monkeypatch.delenv(\"CLAUDE_CODE_OAUTH_TOKEN\", raising=False)\n    with pytest.raises(claude_account_cli.ClaudeAccountCliError, match=\"source\"):\n        claude_account_cli._account_environment()\n\n\ndef test_account_environment_removes_every_metered_or_third_party_route(monkeypatch):\n    monkeypatch.setenv(\"CLAUDE_CODE_OAUTH_TOKEN\", \"secret-account-token\")\n    for name in claude_account_cli._NON_ACCOUNT_ENV_VARS:\n        monkeypatch.setenv(name, \"must-not-reach-child\")\n\n    env = claude_account_cli._account_environment()\n\n    assert env[\"CLAUDE_CODE_OAUTH_TOKEN\"] == \"secret-account-token\"\n    assert all(name not in env for name in claude_account_cli._NON_ACCOUNT_ENV_VARS)\n\n\ndef test_auth_status_uses_claude_with_the_isolated_environment(monkeypatch):\n    class Result:\n        returncode = 0\n        stdout = json.dumps(\n            {\"loggedIn\": True, \"authMethod\": \"claude.ai\", \"apiProvider\": \"firstParty\"}\n        )\n        stderr = \"\"\n\n    monkeypatch.setenv(\"CLAUDE_CODE_OAUTH_TOKEN\", \"secret-account-token\")\n    monkeypatch.setattr(claude_account_cli.shutil, \"which\", lambda _: \"/usr/bin/claude\")\n\n    def fake_run(command, **kwargs):\n        assert command == [\"/usr/bin/claude\", \"auth\", \"status\", \"--json\"]\n        assert kwargs[\"env\"][\"CLAUDE_CODE_OAUTH_TOKEN\"] == \"secret-account-token\"\n        return Result()\n\n    monkeypatch.setattr(claude_account_cli.subprocess, \"run\", fake_run)\n    ok, detail = claude_account_cli.claude_account_status()\n    assert ok is True\n    assert detail == \"logged in (claude.ai, firstParty)\"\n\n\ndef test_auth_status_never_returns_the_token(monkeypatch):\n    monkeypatch.setenv(\"CLAUDE_CODE_OAUTH_TOKEN\", \"secret-account-token\")\n    monkeypatch.setattr(claude_account_cli.shutil, \"which\", lambda _: None)\n    ok, detail = claude_account_cli.claude_account_status()\n    assert ok is False\n    assert \"secret-account-token\" not in detail\n\n\ndef test_action_schema_only_permits_pydantic_ai_tools():\n    schema = claude_account_cli._action_schema(\n        [\"fetch_evidence\", \"final_AnswerDraft\"]\n    )\n    assert schema[\"properties\"][\"tool_name\"][\"enum\"] == [\n        \"fetch_evidence\",\n        \"final_AnswerDraft\",\n    ]\n    assert schema[\"properties\"][\"arguments_json\"][\"type\"] == \"string\"\n    assert schema[\"additionalProperties\"] is False\n\n\ndef test_structured_action_reads_claude_result_envelope():\n    expected = {\"tool_name\": \"fetch_evidence\", \"arguments_json\": \"{}\"}\n    stdout = json.dumps({\"type\": \"result\", \"structured_output\": expected}).encode()\n    assert claude_account_cli._structured_action(stdout) == expected\n\n\ndef test_session_limit_is_a_concise_typed_quota_error_even_with_an_action():\n    stdout = json.dumps(\n        {\n            \"type\": \"result\",\n            \"is_error\": True,\n            \"api_error_status\": 429,\n            \"result\": \"You've hit your session limit · resets 11:30pm (Australia/Melbourne)\",\n            \"structured_output\": {\"tool_name\": \"final_result_AnswerDraft\", \"arguments_json\": \"{}\"},\n            \"usage\": {\"cache_creation_input_tokens\": 20617},\n        }\n    ).encode()\n\n    with pytest.raises(QuotaExceeded) as caught:\n        claude_account_cli._raise_for_result_error(stdout)\n\n    assert caught.value.reset_at == \"11:30pm (Australia/Melbourne)\"\n    assert str(caught.value) == (\n        \"Claude subscription quota exhausted; resets 11:30pm (Australia/Melbourne)\"\n    )\n    assert \"usage\" not in str(caught.value)\n\n\ndef test_non_quota_cli_error_is_concise():\n    stdout = json.dumps(\n        {\"is_error\": True, \"api_error_status\": 400, \"result\": \"Invalid request\", \"usage\": {\"large\": \"blob\"}}\n    ).encode()\n    with pytest.raises(claude_account_cli.ClaudeAccountCliError, match=\"HTTP 400.*Invalid request\"):\n        claude_account_cli._raise_for_result_error(stdout)\n\n\ndef test_cli_not_logged_in_is_a_typed_auth_failure():\n    stdout = json.dumps(\n        {\"is_error\": True, \"api_error_status\": None, \"result\": \"Not logged in · Please run /login\"}\n    ).encode()\n    with pytest.raises(AuthError, match=\"authentication is not usable\"):\n        claude_account_cli._raise_for_result_error(stdout)\n\n\ndef test_command_disables_every_cli_action_surface():\n    command = claude_account_cli._claude_command(\n        \"/usr/bin/claude\", \"schema\", '{\"mcpServers\":{}}', None\n    )\n    assert command[command.index(\"--tools\") + 1] == \"\"\n    assert \"--strict-mcp-config\" in command\n    assert command[command.index(\"--mcp-config\") + 1] == '{\"mcpServers\":{}}'\n    assert \"--disable-slash-commands\" in command\n    assert \"--no-session-persistence\" in command\n    assert command[command.index(\"--permission-mode\") + 1] == \"dontAsk\"\n    assert command[command.index(\"--setting-sources\") + 1] == \"\"\n    assert \"--system-prompt\" in command\n\n\ndef test_stable_application_policy_moves_out_of_the_changing_conversation():\n    messages = [\n        ModelRequest(\n            parts=[SystemPromptPart(content=\"FROZEN POLICY\"), UserPromptPart(content=\"question\")]\n        )\n    ]\n    system, history = claude_account_cli._split_system_prompt(messages)\n    assert \"FROZEN POLICY\" in system\n    rendered = json.dumps(history)\n    assert \"FROZEN POLICY\" not in rendered\n    assert \"question\" in rendered\n\n\ndef test_repeated_model_request_instructions_are_kept_once_in_conversation():\n    messages = [\n        ModelRequest(parts=[UserPromptPart(content=\"question\")], instructions=\"FROZEN POLICY\"),\n        ModelRequest(parts=[UserPromptPart(content=\"follow-up\")], instructions=\"FROZEN POLICY\"),\n    ]\n    system, history = claude_account_cli._split_system_prompt(messages)\n    assert \"FROZEN POLICY\" not in system\n    assert json.dumps(history).count(\"FROZEN POLICY\") == 1\n\n\ndef test_successful_evidence_turn_exposes_only_terminal_output_tools():\n    class Tool:\n        def __init__(self, name):\n            self.name = name\n            self.kind = \"function\"\n            self.description = \"d\"\n            self.parameters_json_schema = {\"type\": \"object\"}\n\n    class Info:\n        function_tools = [Tool(\"search_schools\"), Tool(\"fetch_evidence\")]\n        output_tools = [Tool(\"final_result_AnswerDraft\")]\n\n    messages = [\n        ModelRequest(\n            parts=[ToolReturnPart(tool_name=\"fetch_evidence\", content={\"question_id\": \"VC-POC-04\"})]\n        )\n    ]\n    _, history = claude_account_cli._split_system_prompt(messages)\n    prompt, names = claude_account_cli._prompt(history, Info())\n    assert names == [\"final_result_AnswerDraft\"]\n    assert '\"name\": \"fetch_evidence\"' not in prompt\n\n\ndef test_cli_errors_redact_the_account_token(monkeypatch):\n    monkeypatch.setenv(\"CLAUDE_CODE_OAUTH_TOKEN\", \"secret-account-token\")\n    assert (\n        claude_account_cli._redact_account_token(\"bad secret-account-token\")\n        == \"bad [REDACTED]\"\n    )\n\n\ndef test_account_model_has_no_http_provider():\n    model = claude_account_cli.build_claude_account_model(model=\"claude-sonnet-4-6\")\n    assert model.model_name == \"claude-account:claude-sonnet-4-6\"\n    assert model.provider is None\n","structuredPatch":[{"oldStart":186,"oldLines":3,"newStart":186,"newLines":186,"lines":["     model = claude_account_cli.build_claude_account_model(model=\"claude-sonnet-4-6\")","     assert model.model_name == \"claude-account:claude-sonnet-4-6\"","     assert model.provider is None","+","+","+def test_request_usage_maps_the_cli_usage_block_per_genai_prices_convention():","+    envelope = {","+        \"usage\": {","+            \"input_tokens\": 1000,","+            \"output_tokens\": 500,","+            \"cache_read_input_tokens\": 2000,","+            \"cache_creation_input_tokens\": 100,","+        }","+    }","+    usage = claude_account_cli._request_usage(envelope)","+    # Anthropic reports input EXCLUDING cache; RequestUsage (genai-prices","+    # convention, enforced by tests/unit/test_usage.py) INCLUDES cache read","+    # and write in input_tokens.","+    assert usage.input_tokens == 3100","+    assert usage.output_tokens == 500","+    assert usage.cache_read_tokens == 2000","+    assert usage.cache_write_tokens == 100","+","+","+def test_request_usage_aggregates_a_helper_model_into_the_total_and_details():","+    envelope = {","+        \"usage\": {","+            \"input_tokens\": 1000,","+            \"output_tokens\": 500,","+            \"cache_read_input_tokens\": 2000,","+            \"cache_creation_input_tokens\": 100,","+        },","+        \"modelUsage\": {","+            \"claude-sonnet-4-6\": {","+                \"input_tokens\": 1000,","+                \"output_tokens\": 500,","+                \"cache_read_input_tokens\": 2000,","+                \"cache_creation_input_tokens\": 100,","+            },","+            \"claude-haiku-4-6\": {","+                \"input_tokens\": 50,","+                \"output_tokens\": 10,","+            },","+        },","+    }","+    usage = claude_account_cli._request_usage(envelope)","+","+    # Main + helper model counts are summed into the aggregate.","+    assert usage.input_tokens == 3100 + 50","+    assert usage.output_tokens == 500 + 10","+    assert usage.cache_read_tokens == 2000","+    assert usage.cache_write_tokens == 100","+","+    # Per-model breakdown is recorded as integer-only, model-name-keyed","+    # entries (DECIDED C2, option (a): no schema change).","+    for key, value in usage.details.items():","+        assert isinstance(value, int)","+    assert usage.details[\"claude-sonnet-4-6.input_tokens\"] == 3100","+    assert usage.details[\"claude-sonnet-4-6.output_tokens\"] == 500","+    assert usage.details[\"claude-haiku-4-6.input_tokens\"] == 50","+    assert usage.details[\"claude-haiku-4-6.output_tokens\"] == 10","+    # The raw top-level block is also recorded for auditability alongside","+    # the per-model breakdown, in case the two disagree.","+    assert usage.details[\"usage.input_tokens\"] == 3100","+    assert usage.details[\"usage.output_tokens\"] == 500","+","+","+def test_request_usage_contains_no_raw_result_text_and_no_token(monkeypatch):","+    monkeypatch.setenv(\"CLAUDE_CODE_OAUTH_TOKEN\", SECRET_TOKEN)","+    envelope = {","+        \"type\": \"result\",","+        \"result\": f\"Here is your answer, token={SECRET_TOKEN}\",","+        \"usage\": {","+            \"input_tokens\": 1000,","+            \"output_tokens\": 500,","+            \"cache_read_input_tokens\": 2000,","+            \"cache_creation_input_tokens\": 100,","+        },","+        \"modelUsage\": {","+            \"claude-sonnet-4-6\": {\"input_tokens\": 1000, \"output_tokens\": 500},","+        },","+    }","+    usage = claude_account_cli._request_usage(envelope)","+","+    rendered = json.dumps({\"usage\": usage.__dict__, \"details\": usage.details})","+    assert \"Here is your answer\" not in rendered","+    assert SECRET_TOKEN not in rendered","+    assert all(isinstance(v, int) for v in usage.details.values())","+","+","+def test_request_usage_tolerates_a_missing_usage_block():","+    usage = claude_account_cli._request_usage({})","+    assert usage.input_tokens == 0","+    assert usage.output_tokens == 0","+    assert usage.cache_read_tokens == 0","+    assert usage.cache_write_tokens == 0","+    assert usage.details == {}","+","+","+def test_request_usage_tolerates_a_partial_usage_block():","+    usage = claude_account_cli._request_usage({\"usage\": {\"output_tokens\": 7}})","+    assert usage.input_tokens == 0","+    assert usage.output_tokens == 7","+    assert usage.cache_read_tokens == 0","+    assert usage.cache_write_tokens == 0","+","+","+def test_request_usage_ignores_a_malformed_model_usage_map():","+    envelope = {","+        \"usage\": {\"input_tokens\": 5},","+        \"modelUsage\": \"not-a-map\",","+    }","+    usage = claude_account_cli._request_usage(envelope)","+    assert usage.input_tokens == 5","+","+","+def test_build_claude_account_model_returns_populated_usage(monkeypatch):","+    monkeypatch.setenv(\"CLAUDE_CODE_OAUTH_TOKEN\", SECRET_TOKEN)","+    monkeypatch.setattr(claude_account_cli.shutil, \"which\", lambda _: \"/usr/bin/claude\")","+","+    stdout = json.dumps(","+        {","+            \"type\": \"result\",","+            \"is_error\": False,","+            \"structured_output\": {","+                \"tool_name\": \"final_result_AnswerDraft\",","+                \"arguments_json\": \"{}\",","+            },","+            \"usage\": {","+                \"input_tokens\": 1000,","+                \"output_tokens\": 500,","+                \"cache_read_input_tokens\": 2000,","+                \"cache_creation_input_tokens\": 100,","+            },","+        }","+    ).encode()","+","+    class FakeProcess:","+        returncode = 0","+","+        async def communicate(self, _input):","+            return stdout, b\"\"","+","+        def kill(self):","+            pass","+","+        async def wait(self):","+            return None","+","+    async def fake_create_subprocess_exec(*args, **kwargs):","+        return FakeProcess()","+","+    monkeypatch.setattr(","+        claude_account_cli.asyncio, \"create_subprocess_exec\", fake_create_subprocess_exec","+    )","+","+    class Tool:","+        name = \"final_result_AnswerDraft\"","+        kind = \"output\"","+        description = \"d\"","+        parameters_json_schema = {\"type\": \"object\"}","+","+    class Info:","+        function_tools: list = []","+        output_tools = [Tool()]","+","+    model = claude_account_cli.build_claude_account_model(model=\"claude-sonnet-4-6\")","+    messages = [ModelRequest(parts=[UserPromptPart(content=\"question\")])]","+","+    async def run():","+        return await claude_account_cli._invoke_claude(","+            messages,","+            Info(),","+            binary=\"claude\",","+            model=\"claude-sonnet-4-6\",","+            timeout_seconds=10,","+        )","+","+    import asyncio as asyncio_module","+","+    response = asyncio_module.run(run())","+","+    assert response.usage.input_tokens == 3100","+    assert response.usage.output_tokens == 500","+    assert response.usage.cache_read_tokens == 2000","+    assert response.usage.cache_write_tokens == 100"]}],"userModified":false,"replaceAll":false}}
