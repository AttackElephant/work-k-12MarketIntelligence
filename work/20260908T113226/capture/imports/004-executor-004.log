{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AHvPhdoiBeH7SHUFbdRSSE","type":"tool_result","content":"1\t\"\"\"Claude subscription-account transport: auth isolation and typed actions.\"\"\"\n2\t\n3\timport json\n4\t\n5\timport pytest\n6\tfrom pydantic_ai.messages import ModelRequest, SystemPromptPart, ToolReturnPart, UserPromptPart\n7\t\n8\tfrom harness import claude_account_cli\n9\tfrom harness.errors import AuthError, QuotaExceeded\n10\t\n11\t\n12\tdef test_account_environment_requires_the_explicit_subscription_token(monkeypatch):\n13\t    monkeypatch.delenv(\"CLAUDE_CODE_OAUTH_TOKEN\", raising=False)\n14\t    with pytest.raises(claude_account_cli.ClaudeAccountCliError, match=\"source\"):\n15\t        claude_account_cli._account_environment()\n16\t\n17\t\n18\tdef test_account_environment_removes_every_metered_or_third_party_route(monkeypatch):\n19\t    monkeypatch.setenv(\"CLAUDE_CODE_OAUTH_TOKEN\", \"secret-account-token\")\n20\t    for name in claude_account_cli._NON_ACCOUNT_ENV_VARS:\n21\t        monkeypatch.setenv(name, \"must-not-reach-child\")\n22\t\n23\t    env = claude_account_cli._account_environment()\n24\t\n25\t    assert env[\"CLAUDE_CODE_OAUTH_TOKEN\"] == \"secret-account-token\"\n26\t    assert all(name not in env for name in claude_account_cli._NON_ACCOUNT_ENV_VARS)\n27\t\n28\t\n29\tdef test_auth_status_uses_claude_with_the_isolated_environment(monkeypatch):\n30\t    class Result:\n31\t        returncode = 0\n32\t        stdout = json.dumps(\n33\t            {\"loggedIn\": True, \"authMethod\": \"claude.ai\", \"apiProvider\": \"firstParty\"}\n34\t        )\n35\t        stderr = \"\"\n36\t\n37\t    monkeypatch.setenv(\"CLAUDE_CODE_OAUTH_TOKEN\", \"secret-account-token\")\n38\t    monkeypatch.setattr(claude_account_cli.shutil, \"which\", lambda _: \"/usr/bin/claude\")\n39\t\n40\t    def fake_run(command, **kwargs):\n41\t        assert command == [\"/usr/bin/claude\", \"auth\", \"status\", \"--json\"]\n42\t        assert kwargs[\"env\"][\"CLAUDE_CODE_OAUTH_TOKEN\"] == \"secret-account-token\"\n43\t        return Result()\n44\t\n45\t    monkeypatch.setattr(claude_account_cli.subprocess, \"run\", fake_run)\n46\t    ok, detail = claude_account_cli.claude_account_status()\n47\t    assert ok is True\n48\t    assert detail == \"logged in (claude.ai, firstParty)\"\n49\t\n50\t\n51\tdef test_auth_status_never_returns_the_token(monkeypatch):\n52\t    monkeypatch.setenv(\"CLAUDE_CODE_OAUTH_TOKEN\", \"secret-account-token\")\n53\t    monkeypatch.setattr(claude_account_cli.shutil, \"which\", lambda _: None)\n54\t    ok, detail = claude_account_cli.claude_account_status()\n55\t    assert ok is False\n56\t    assert \"secret-account-token\" not in detail\n57\t\n58\t\n59\tdef test_action_schema_only_permits_pydantic_ai_tools():\n60\t    schema = claude_account_cli._action_schema(\n61\t        [\"fetch_evidence\", \"final_AnswerDraft\"]\n62\t    )\n63\t    assert schema[\"properties\"][\"tool_name\"][\"enum\"] == [\n64\t        \"fetch_evidence\",\n65\t        \"final_AnswerDraft\",\n66\t    ]\n67\t    assert schema[\"properties\"][\"arguments_json\"][\"type\"] == \"string\"\n68\t    assert schema[\"additionalProperties\"] is False\n69\t\n70\t\n71\tdef test_structured_action_reads_claude_result_envelope():\n72\t    expected = {\"tool_name\": \"fetch_evidence\", \"arguments_json\": \"{}\"}\n73\t    stdout = json.dumps({\"type\": \"result\", \"structured_output\": expected}).encode()\n74\t    assert claude_account_cli._structured_action(stdout) == expected\n75\t\n76\t\n77\tdef test_session_limit_is_a_concise_typed_quota_error_even_with_an_action():\n78\t    stdout = json.dumps(\n79\t        {\n80\t            \"type\": \"result\",\n81\t            \"is_error\": True,\n82\t            \"api_error_status\": 429,\n83\t            \"result\": \"You've hit your session limit · resets 11:30pm (Australia/Melbourne)\",\n84\t            \"structured_output\": {\"tool_name\": \"final_result_AnswerDraft\", \"arguments_json\": \"{}\"},\n85\t            \"usage\": {\"cache_creation_input_tokens\": 20617},\n86\t        }\n87\t    ).encode()\n88\t\n89\t    with pytest.raises(QuotaExceeded) as caught:\n90\t        claude_account_cli._raise_for_result_error(stdout)\n91\t\n92\t    assert caught.value.reset_at == \"11:30pm (Australia/Melbourne)\"\n93\t    assert str(caught.value) == (\n94\t        \"Claude subscription quota exhausted; resets 11:30pm (Australia/Melbourne)\"\n95\t    )\n96\t    assert \"usage\" not in str(caught.value)\n97\t\n98\t\n99\tdef test_non_quota_cli_error_is_concise():\n100\t    stdout = json.dumps(\n101\t        {\"is_error\": True, \"api_error_status\": 400, \"result\": \"Invalid request\", \"usage\": {\"large\": \"blob\"}}\n102\t    ).encode()\n103\t    with pytest.raises(claude_account_cli.ClaudeAccountCliError, match=\"HTTP 400.*Invalid request\"):\n104\t        claude_account_cli._raise_for_result_error(stdout)\n105\t\n106\t\n107\tdef test_cli_not_logged_in_is_a_typed_auth_failure():\n108\t    stdout = json.dumps(\n109\t        {\"is_error\": True, \"api_error_status\": None, \"result\": \"Not logged in · Please run /login\"}\n110\t    ).encode()\n111\t    with pytest.raises(AuthError, match=\"authentication is not usable\"):\n112\t        claude_account_cli._raise_for_result_error(stdout)\n113\t\n114\t\n115\tdef test_command_disables_every_cli_action_surface():\n116\t    command = claude_account_cli._claude_command(\n117\t        \"/usr/bin/claude\", \"schema\", '{\"mcpServers\":{}}', None\n118\t    )\n119\t    assert command[command.index(\"--tools\") + 1] == \"\"\n120\t    assert \"--strict-mcp-config\" in command\n121\t    assert command[command.index(\"--mcp-config\") + 1] == '{\"mcpServers\":{}}'\n122\t    assert \"--disable-slash-commands\" in command\n123\t    assert \"--no-session-persistence\" in command\n124\t    assert command[command.index(\"--permission-mode\") + 1] == \"dontAsk\"\n125\t    assert command[command.index(\"--setting-sources\") + 1] == \"\"\n126\t    assert \"--system-prompt\" in command\n127\t\n128\t\n129\tdef test_stable_application_policy_moves_out_of_the_changing_conversation():\n130\t    messages = [\n131\t        ModelRequest(\n132\t            parts=[SystemPromptPart(content=\"FROZEN POLICY\"), UserPromptPart(content=\"question\")]\n133\t        )\n134\t    ]\n135\t    system, history = claude_account_cli._split_system_prompt(messages)\n136\t    assert \"FROZEN POLICY\" in system\n137\t    rendered = json.dumps(history)\n138\t    assert \"FROZEN POLICY\" not in rendered\n139\t    assert \"question\" in rendered\n140\t\n141\t\n142\tdef test_repeated_model_request_instructions_are_kept_once_in_conversation():\n143\t    messages = [\n144\t        ModelRequest(parts=[UserPromptPart(content=\"question\")], instructions=\"FROZEN POLICY\"),\n145\t        ModelRequest(parts=[UserPromptPart(content=\"follow-up\")], instructions=\"FROZEN POLICY\"),\n146\t    ]\n147\t    system, history = claude_account_cli._split_system_prompt(messages)\n148\t    assert \"FROZEN POLICY\" not in system\n149\t    assert json.dumps(history).count(\"FROZEN POLICY\") == 1\n150\t\n151\t\n152\tdef test_successful_evidence_turn_exposes_only_terminal_output_tools():\n153\t    class Tool:\n154\t        def __init__(self, name):\n155\t            self.name = name\n156\t            self.kind = \"function\"\n157\t            self.description = \"d\"\n158\t            self.parameters_json_schema = {\"type\": \"object\"}\n159\t\n160\t    class Info:\n161\t        function_tools = [Tool(\"search_schools\"), Tool(\"fetch_evidence\")]\n162\t        output_tools = [Tool(\"final_result_AnswerDraft\")]\n163\t\n164\t    messages = [\n165\t        ModelRequest(\n166\t            parts=[ToolReturnPart(tool_name=\"fetch_evidence\", content={\"question_id\": \"VC-POC-04\"})]\n167\t        )\n168\t    ]\n169\t    _, history = claude_account_cli._split_system_prompt(messages)\n170\t    prompt, names = claude_account_cli._prompt(history, Info())\n171\t    assert names == [\"final_result_AnswerDraft\"]\n172\t    assert '\"name\": \"fetch_evidence\"' not in prompt\n173\t\n174\t\n175\tdef test_cli_errors_redact_the_account_token(monkeypatch):\n176\t    monkeypatch.setenv(\"CLAUDE_CODE_OAUTH_TOKEN\", \"secret-account-token\")\n177\t    assert (\n178\t        claude_account_cli._redact_account_token(\"bad secret-account-token\")\n179\t        == \"bad [REDACTED]\"\n180\t    )\n181\t\n182\t\n183\tdef test_account_model_has_no_http_provider():\n184\t    model = claude_account_cli.build_claude_account_model(model=\"claude-sonnet-4-6\")\n185\t    assert model.model_name == \"claude-account:claude-sonnet-4-6\"\n186\t    assert model.provider is None\n187\t"}]},"parent_tool_use_id":null,"session_id":"4a975106-0ac1-4d93-9678-77f65344e100","uuid":"4303d64a-8739-4010-9d4b-b18e6c9aa90d","timestamp":"2026-09-27T13:12:32.140Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/tests/unit/test_claude_account_cli.py","content":"\"\"\"Claude subscription-account transport: auth isolation and typed actions.\"\"\"\n\nimport json\n\nimport pytest\nfrom pydantic_ai.messages import ModelRequest, SystemPromptPart, ToolReturnPart, UserPromptPart\n\nfrom harness import claude_account_cli\nfrom harness.errors import AuthError, QuotaExceeded\n\n\ndef test_account_environment_requires_the_explicit_subscription_token(monkeypatch):\n    monkeypatch.delenv(\"CLAUDE_CODE_OAUTH_TOKEN\", raising=False)\n    with pytest.raises(claude_account_cli.ClaudeAccountCliError, match=\"source\"):\n        claude_account_cli._account_environment()\n\n\ndef test_account_environment_removes_every_metered_or_third_party_route(monkeypatch):\n    monkeypatch.setenv(\"CLAUDE_CODE_OAUTH_TOKEN\", \"secret-account-token\")\n    for name in claude_account_cli._NON_ACCOUNT_ENV_VARS:\n        monkeypatch.setenv(name, \"must-not-reach-child\")\n\n    env = claude_account_cli._account_environment()\n\n    assert env[\"CLAUDE_CODE_OAUTH_TOKEN\"] == \"secret-account-token\"\n    assert all(name not in env for name in claude_account_cli._NON_ACCOUNT_ENV_VARS)\n\n\ndef test_auth_status_uses_claude_with_the_isolated_environment(monkeypatch):\n    class Result:\n        returncode = 0\n        stdout = json.dumps(\n            {\"loggedIn\": True, \"authMethod\": \"claude.ai\", \"apiProvider\": \"firstParty\"}\n        )\n        stderr = \"\"\n\n    monkeypatch.setenv(\"CLAUDE_CODE_OAUTH_TOKEN\", \"secret-account-token\")\n    monkeypatch.setattr(claude_account_cli.shutil, \"which\", lambda _: \"/usr/bin/claude\")\n\n    def fake_run(command, **kwargs):\n        assert command == [\"/usr/bin/claude\", \"auth\", \"status\", \"--json\"]\n        assert kwargs[\"env\"][\"CLAUDE_CODE_OAUTH_TOKEN\"] == \"secret-account-token\"\n        return Result()\n\n    monkeypatch.setattr(claude_account_cli.subprocess, \"run\", fake_run)\n    ok, detail = claude_account_cli.claude_account_status()\n    assert ok is True\n    assert detail == \"logged in (claude.ai, firstParty)\"\n\n\ndef test_auth_status_never_returns_the_token(monkeypatch):\n    monkeypatch.setenv(\"CLAUDE_CODE_OAUTH_TOKEN\", \"secret-account-token\")\n    monkeypatch.setattr(claude_account_cli.shutil, \"which\", lambda _: None)\n    ok, detail = claude_account_cli.claude_account_status()\n    assert ok is False\n    assert \"secret-account-token\" not in detail\n\n\ndef test_action_schema_only_permits_pydantic_ai_tools():\n    schema = claude_account_cli._action_schema(\n        [\"fetch_evidence\", \"final_AnswerDraft\"]\n    )\n    assert schema[\"properties\"][\"tool_name\"][\"enum\"] == [\n        \"fetch_evidence\",\n        \"final_AnswerDraft\",\n    ]\n    assert schema[\"properties\"][\"arguments_json\"][\"type\"] == \"string\"\n    assert schema[\"additionalProperties\"] is False\n\n\ndef test_structured_action_reads_claude_result_envelope():\n    expected = {\"tool_name\": \"fetch_evidence\", \"arguments_json\": \"{}\"}\n    stdout = json.dumps({\"type\": \"result\", \"structured_output\": expected}).encode()\n    assert claude_account_cli._structured_action(stdout) == expected\n\n\ndef test_session_limit_is_a_concise_typed_quota_error_even_with_an_action():\n    stdout = json.dumps(\n        {\n            \"type\": \"result\",\n            \"is_error\": True,\n            \"api_error_status\": 429,\n            \"result\": \"You've hit your session limit · resets 11:30pm (Australia/Melbourne)\",\n            \"structured_output\": {\"tool_name\": \"final_result_AnswerDraft\", \"arguments_json\": \"{}\"},\n            \"usage\": {\"cache_creation_input_tokens\": 20617},\n        }\n    ).encode()\n\n    with pytest.raises(QuotaExceeded) as caught:\n        claude_account_cli._raise_for_result_error(stdout)\n\n    assert caught.value.reset_at == \"11:30pm (Australia/Melbourne)\"\n    assert str(caught.value) == (\n        \"Claude subscription quota exhausted; resets 11:30pm (Australia/Melbourne)\"\n    )\n    assert \"usage\" not in str(caught.value)\n\n\ndef test_non_quota_cli_error_is_concise():\n    stdout = json.dumps(\n        {\"is_error\": True, \"api_error_status\": 400, \"result\": \"Invalid request\", \"usage\": {\"large\": \"blob\"}}\n    ).encode()\n    with pytest.raises(claude_account_cli.ClaudeAccountCliError, match=\"HTTP 400.*Invalid request\"):\n        claude_account_cli._raise_for_result_error(stdout)\n\n\ndef test_cli_not_logged_in_is_a_typed_auth_failure():\n    stdout = json.dumps(\n        {\"is_error\": True, \"api_error_status\": None, \"result\": \"Not logged in · Please run /login\"}\n    ).encode()\n    with pytest.raises(AuthError, match=\"authentication is not usable\"):\n        claude_account_cli._raise_for_result_error(stdout)\n\n\ndef test_command_disables_every_cli_action_surface():\n    command = claude_account_cli._claude_command(\n        \"/usr/bin/claude\", \"schema\", '{\"mcpServers\":{}}', None\n    )\n    assert command[command.index(\"--tools\") + 1] == \"\"\n    assert \"--strict-mcp-config\" in command\n    assert command[command.index(\"--mcp-config\") + 1] == '{\"mcpServers\":{}}'\n    assert \"--disable-slash-commands\" in command\n    assert \"--no-session-persistence\" in command\n    assert command[command.index(\"--permission-mode\") + 1] == \"dontAsk\"\n    assert command[command.index(\"--setting-sources\") + 1] == \"\"\n    assert \"--system-prompt\" in command\n\n\ndef test_stable_application_policy_moves_out_of_the_changing_conversation():\n    messages = [\n        ModelRequest(\n            parts=[SystemPromptPart(content=\"FROZEN POLICY\"), UserPromptPart(content=\"question\")]\n        )\n    ]\n    system, history = claude_account_cli._split_system_prompt(messages)\n    assert \"FROZEN POLICY\" in system\n    rendered = json.dumps(history)\n    assert \"FROZEN POLICY\" not in rendered\n    assert \"question\" in rendered\n\n\ndef test_repeated_model_request_instructions_are_kept_once_in_conversation():\n    messages = [\n        ModelRequest(parts=[UserPromptPart(content=\"question\")], instructions=\"FROZEN POLICY\"),\n        ModelRequest(parts=[UserPromptPart(content=\"follow-up\")], instructions=\"FROZEN POLICY\"),\n    ]\n    system, history = claude_account_cli._split_system_prompt(messages)\n    assert \"FROZEN POLICY\" not in system\n    assert json.dumps(history).count(\"FROZEN POLICY\") == 1\n\n\ndef test_successful_evidence_turn_exposes_only_terminal_output_tools():\n    class Tool:\n        def __init__(self, name):\n            self.name = name\n            self.kind = \"function\"\n            self.description = \"d\"\n            self.parameters_json_schema = {\"type\": \"object\"}\n\n    class Info:\n        function_tools = [Tool(\"search_schools\"), Tool(\"fetch_evidence\")]\n        output_tools = [Tool(\"final_result_AnswerDraft\")]\n\n    messages = [\n        ModelRequest(\n            parts=[ToolReturnPart(tool_name=\"fetch_evidence\", content={\"question_id\": \"VC-POC-04\"})]\n        )\n    ]\n    _, history = claude_account_cli._split_system_prompt(messages)\n    prompt, names = claude_account_cli._prompt(history, Info())\n    assert names == [\"final_result_AnswerDraft\"]\n    assert '\"name\": \"fetch_evidence\"' not in prompt\n\n\ndef test_cli_errors_redact_the_account_token(monkeypatch):\n    monkeypatch.setenv(\"CLAUDE_CODE_OAUTH_TOKEN\", \"secret-account-token\")\n    assert (\n        claude_account_cli._redact_account_token(\"bad secret-account-token\")\n        == \"bad [REDACTED]\"\n    )\n\n\ndef test_account_model_has_no_http_provider():\n    model = claude_account_cli.build_claude_account_model(model=\"claude-sonnet-4-6\")\n    assert model.model_name == \"claude-account:claude-sonnet-4-6\"\n    assert model.provider is None\n","numLines":187,"startLine":1,"totalLines":187}}}
