{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Hpdivo855BVn8DT7MqWqSv","type":"tool_result","content":"1\tfrom __future__ import annotations as _annotations\n2\t\n3\timport dataclasses\n4\tfrom copy import copy\n5\tfrom dataclasses import dataclass, fields\n6\tfrom typing import Annotated, Any\n7\t\n8\tfrom genai_prices.data_snapshot import get_snapshot\n9\tfrom pydantic import AliasChoices, BeforeValidator, Field\n10\tfrom typing_extensions import deprecated, overload\n11\t\n12\tfrom . import _utils\n13\tfrom .exceptions import UsageLimitExceeded\n14\t\n15\t__all__ = 'RequestUsage', 'RunUsage', 'Usage', 'UsageLimits'\n16\t\n17\t\n18\t@dataclass(repr=False, kw_only=True)\n19\tclass UsageBase:\n20\t    input_tokens: Annotated[\n21\t        int,\n22\t        # `request_tokens` is deprecated, but we still want to support deserializing model responses stored in a DB before the name was changed\n23\t        Field(validation_alias=AliasChoices('input_tokens', 'request_tokens')),\n24\t    ] = 0\n25\t    \"\"\"Number of input/prompt tokens.\"\"\"\n26\t\n27\t    cache_write_tokens: int = 0\n28\t    \"\"\"Number of tokens written to the cache.\"\"\"\n29\t    cache_read_tokens: int = 0\n30\t    \"\"\"Number of tokens read from the cache.\"\"\"\n31\t\n32\t    output_tokens: Annotated[\n33\t        int,\n34\t        # `response_tokens` is deprecated, but we still want to support deserializing model responses stored in a DB before the name was changed\n35\t        Field(validation_alias=AliasChoices('output_tokens', 'response_tokens')),\n36\t    ] = 0\n37\t    \"\"\"Number of output/completion tokens.\"\"\"\n38\t\n39\t    input_audio_tokens: int = 0\n40\t    \"\"\"Number of audio input tokens.\"\"\"\n41\t    cache_audio_read_tokens: int = 0\n42\t    \"\"\"Number of audio tokens read from the cache.\"\"\"\n43\t    output_audio_tokens: int = 0\n44\t    \"\"\"Number of audio output tokens.\"\"\"\n45\t\n46\t    details: Annotated[\n47\t        dict[str, int],\n48\t        # `details` can not be `None` any longer, but we still want to support deserializing model responses stored in a DB before this was changed\n49\t        BeforeValidator(lambda d: d or {}),\n50\t    ] = dataclasses.field(default_factory=dict[str, int])\n51\t    \"\"\"Any extra details returned by the model.\"\"\"\n52\t\n53\t    def __copy__(self) -> UsageBase:\n54\t        \"\"\"Shallow copy that also copies mutable fields like `details`.\"\"\"\n55\t        cls = type(self)\n56\t        new = cls.__new__(cls)\n57\t        new.__dict__.update(self.__dict__)\n58\t        new.details = self.details.copy()\n59\t        return new\n60\t\n61\t    @property\n62\t    @deprecated('`request_tokens` is deprecated, use `input_tokens` instead')\n63\t    def request_tokens(self) -> int:\n64\t        return self.input_tokens\n65\t\n66\t    @property\n67\t    @deprecated('`response_tokens` is deprecated, use `output_tokens` instead')\n68\t    def response_tokens(self) -> int:\n69\t        return self.output_tokens\n70\t\n71\t    @property\n72\t    def total_tokens(self) -> int:\n73\t        \"\"\"Sum of `input_tokens + output_tokens`.\"\"\"\n74\t        return self.input_tokens + self.output_tokens\n75\t\n76\t    def opentelemetry_attributes(self) -> dict[str, int]:\n77\t        \"\"\"Get the token usage values as OpenTelemetry attributes.\"\"\"\n78\t        result: dict[str, int] = {}\n79\t        if self.input_tokens:\n80\t            result['gen_ai.usage.input_tokens'] = self.input_tokens\n81\t        if self.output_tokens:\n82\t            result['gen_ai.usage.output_tokens'] = self.output_tokens\n83\t\n84\t        details = self.details.copy()\n85\t        if self.cache_write_tokens:\n86\t            result['gen_ai.usage.cache_creation.input_tokens'] = self.cache_write_tokens\n87\t            # For backwards compat\n88\t            details['cache_write_tokens'] = self.cache_write_tokens\n89\t        if self.cache_read_tokens:\n90\t            result['gen_ai.usage.cache_read.input_tokens'] = self.cache_read_tokens\n91\t            # For backwards compat\n92\t            details['cache_read_tokens'] = self.cache_read_tokens\n93\t        if self.input_audio_tokens:\n94\t            details['input_audio_tokens'] = self.input_audio_tokens\n95\t        if self.cache_audio_read_tokens:\n96\t            details['cache_audio_read_tokens'] = self.cache_audio_read_tokens\n97\t        if self.output_audio_tokens:\n98\t            details['output_audio_tokens'] = self.output_audio_tokens\n99\t        if details:\n100\t            prefix = 'gen_ai.usage.details.'\n101\t            for key, value in details.items():\n102\t                # Skipping check for value since spec implies all detail values are relevant\n103\t                if value:\n104\t                    result[prefix + key] = value\n105\t        return result\n106\t\n107\t    def __repr__(self):\n108\t        kv_pairs = (f'{f.name}={value!r}' for f in fields(self) if (value := getattr(self, f.name)))\n109\t        return f'{self.__class__.__qualname__}({\", \".join(kv_pairs)})'\n110\t\n111\t    def has_values(self) -> bool:\n112\t        \"\"\"Whether any values are set and non-zero.\"\"\"\n113\t        return any(dataclasses.asdict(self).values())\n114\t\n115\t\n116\t@dataclass(repr=False, kw_only=True)\n117\tclass RequestUsage(UsageBase):\n118\t    \"\"\"LLM usage associated with a single request.\n119\t\n120\t    This is an implementation of `genai_prices.types.AbstractUsage` so it can be used to calculate the price of the\n121\t    request using [genai-prices](https://github.com/pydantic/genai-prices).\n122\t    \"\"\"\n123\t\n124\t    @property\n125\t    def requests(self):\n126\t        return 1\n127\t\n128\t    def incr(self, incr_usage: RequestUsage) -> None:\n129\t        \"\"\"Increment the usage in place.\n130\t\n131\t        Args:\n132\t            incr_usage: The usage to increment by.\n133\t        \"\"\"\n134\t        return _incr_usage_tokens(self, incr_usage)\n135\t\n136\t    def __add__(self, other: RequestUsage) -> RequestUsage:\n137\t        \"\"\"Add two RequestUsages together.\n138\t\n139\t        This is provided so it's trivial to sum usage information from multiple parts of a response.\n140\t\n141\t        **WARNING:** this CANNOT be used to sum multiple requests without breaking some pricing calculations.\n142\t        \"\"\"\n143\t        new_usage = copy(self)\n144\t        new_usage.incr(other)\n145\t        return new_usage\n146\t\n147\t    @classmethod\n148\t    def extract(\n149\t        cls,\n150\t        data: Any,\n151\t        *,\n152\t        provider: str,\n153\t        provider_url: str,\n154\t        provider_fallback: str,\n155\t        api_flavor: str = 'default',\n156\t        details: dict[str, Any] | None = None,\n157\t    ) -> RequestUsage:\n158\t        \"\"\"Extract usage information from the response data using genai-prices.\n159\t\n160\t        Args:\n161\t            data: The response data from the model API.\n162\t            provider: The actual provider ID\n163\t            provider_url: The provider base_url\n164\t            provider_fallback: The fallback provider ID to use if the actual provider is not found in genai-prices.\n165\t                For example, an OpenAI model should set this to \"openai\" in case it has an obscure provider ID.\n166\t            api_flavor: The API flavor to use when extracting usage information,\n167\t                e.g. 'chat' or 'responses' for OpenAI.\n168\t            details: Becomes the `details` field on the returned `RequestUsage` for convenience.\n169\t        \"\"\"\n170\t        details = details or {}\n171\t        for provider_id, provider_api_url in [(None, provider_url), (provider, None), (provider_fallback, None)]:\n172\t            try:\n173\t                provider_obj = get_snapshot().find_provider(None, provider_id, provider_api_url)\n174\t                _model_ref, extracted_usage = provider_obj.extract_usage(data, api_flavor=api_flavor)\n175\t                return cls(**{k: v for k, v in extracted_usage.__dict__.items() if v is not None}, details=details)\n176\t            except Exception:\n177\t                pass\n178\t        return cls(details=details)\n179\t\n180\t\n181\t@dataclass(repr=False, kw_only=True)\n182\tclass RunUsage(UsageBase):\n183\t    \"\"\"LLM usage associated with an agent run.\n184\t\n185\t    Responsibility for calculating request usage is on the model; Pydantic AI simply sums the usage information across requests.\n186\t    \"\"\"\n187\t\n188\t    requests: int = 0\n189\t    \"\"\"Number of requests made to the LLM API.\"\"\"\n190\t\n191\t    tool_calls: int = 0\n192\t    \"\"\"Number of successful tool calls executed during the run.\"\"\"\n193\t\n194\t    input_tokens: int = 0\n195\t    \"\"\"Total number of input/prompt tokens.\"\"\"\n196\t\n197\t    cache_write_tokens: int = 0\n198\t    \"\"\"Total number of tokens written to the cache.\"\"\"\n199\t\n200\t    cache_read_tokens: int = 0\n201\t    \"\"\"Total number of tokens read from the cache.\"\"\"\n202\t\n203\t    input_audio_tokens: int = 0\n204\t    \"\"\"Total number of audio input tokens.\"\"\"\n205\t\n206\t    cache_audio_read_tokens: int = 0\n207\t    \"\"\"Total number of audio tokens read from the cache.\"\"\"\n208\t\n209\t    output_tokens: int = 0\n210\t    \"\"\"Total number of output/completion tokens.\"\"\"\n211\t\n212\t    details: dict[str, int] = dataclasses.field(default_factory=dict[str, int])\n213\t    \"\"\"Any extra details returned by the model.\"\"\"\n214\t\n215\t    def incr(self, incr_usage: RunUsage | RequestUsage) -> None:\n216\t        \"\"\"Increment the usage in place.\n217\t\n218\t        Args:\n219\t            incr_usage: The usage to increment by.\n220\t        \"\"\"\n221\t        if isinstance(incr_usage, RunUsage):\n222\t            self.requests += incr_usage.requests\n223\t            self.tool_calls += incr_usage.tool_calls\n224\t        return _incr_usage_tokens(self, incr_usage)\n225\t\n226\t    def __add__(self, other: RunUsage | RequestUsage) -> RunUsage:\n227\t        \"\"\"Add two RunUsages together.\n228\t\n229\t        This is provided so it's trivial to sum usage information from multiple runs.\n230\t        \"\"\"\n231\t        new_usage = copy(self)\n232\t        new_usage.incr(other)\n233\t        return new_usage\n234\t\n235\t\n236\tdef _incr_usage_tokens(slf: RunUsage | RequestUsage, incr_usage: RunUsage | RequestUsage) -> None:\n237\t    \"\"\"Increment the usage in place.\n238\t\n239\t    Args:\n240\t        slf: The usage to increment.\n241\t        incr_usage: The usage to increment by.\n242\t    \"\"\"\n243\t    slf.input_tokens += incr_usage.input_tokens\n244\t    slf.cache_write_tokens += incr_usage.cache_write_tokens\n245\t    slf.cache_read_tokens += incr_usage.cache_read_tokens\n246\t    slf.input_audio_tokens += incr_usage.input_audio_tokens\n247\t    slf.cache_audio_read_tokens += incr_usage.cache_audio_read_tokens\n248\t    slf.output_tokens += incr_usage.output_tokens\n249\t\n250\t    for key, value in incr_usage.details.items():\n251\t        # Note: value can be None at runtime from model responses despite the type annotation\n252\t        if isinstance(value, (int, float)):\n253\t            slf.details[key] = slf.details.get(key, 0) + value\n254\t\n255\t\n256\t@dataclass(repr=False, kw_only=True)\n257\t@deprecated('`Usage` is deprecated, use `RunUsage` instead')\n258\tclass Usage(RunUsage):\n259\t    \"\"\"Deprecated alias for `RunUsage`.\"\"\"\n260\t\n261\t\n262\t@dataclass(repr=False, kw_only=True)\n263\tclass UsageLimits:\n264\t    \"\"\"Limits on model usage.\n265\t\n266\t    The request count is tracked by pydantic_ai, and the request limit is checked before each request to the model.\n267\t    Token counts are provided in responses from the model, and the token limits are checked after each response.\n268\t\n269\t    Each of the limits can be set to `None` to disable that limit.\n270\t    \"\"\"\n271\t\n272\t    request_limit: int | None = 50\n273\t    \"\"\"The maximum number of requests allowed to the model.\"\"\"\n274\t    tool_calls_limit: int | None = None\n275\t    \"\"\"The maximum number of successful tool calls allowed to be executed.\"\"\"\n276\t    input_tokens_limit: int | None = None\n277\t    \"\"\"The maximum number of input/prompt tokens allowed.\"\"\"\n278\t    output_tokens_limit: int | None = None\n279\t    \"\"\"The maximum number of output/response tokens allowed.\"\"\"\n280\t    total_tokens_limit: int | None = None\n281\t    \"\"\"The maximum number of tokens allowed in requests and responses combined.\"\"\"\n282\t    count_tokens_before_request: bool = False\n283\t    \"\"\"If True, perform a token counting pass before sending the request to the model,\n284\t    to enforce `input_tokens_limit` ahead of time.\n285\t\n286\t    This may incur additional overhead (from calling the model's `count_tokens` API before making the actual request)\n287\t    and is disabled by default.\n288\t\n289\t    Supported by:\n290\t\n291\t    - Anthropic\n292\t    - Google\n293\t    - Bedrock Converse\n294\t    - OpenAI Responses\n295\t    \"\"\"\n296\t\n297\t    @property\n298\t    @deprecated('`request_tokens_limit` is deprecated, use `input_tokens_limit` instead')\n299\t    def request_tokens_limit(self) -> int | None:\n300\t        return self.input_tokens_limit\n301\t\n302\t    @property\n303\t    @deprecated('`response_tokens_limit` is deprecated, use `output_tokens_limit` instead')\n304\t    def response_tokens_limit(self) -> int | None:\n305\t        return self.output_tokens_limit\n306\t\n307\t    @overload\n308\t    def __init__(\n309\t        self,\n310\t        *,\n311\t        request_limit: int | None = 50,\n312\t        tool_calls_limit: int | None = None,\n313\t        input_tokens_limit: int | None = None,\n314\t        output_tokens_limit: int | None = None,\n315\t        total_tokens_limit: int | None = None,\n316\t        count_tokens_before_request: bool = False,\n317\t    ) -> None:\n318\t        self.request_limit = request_limit\n319\t        self.tool_calls_limit = tool_calls_limit\n320\t        self.input_tokens_limit = input_tokens_limit\n321\t        self.output_tokens_limit = output_tokens_limit\n322\t        self.total_tokens_limit = total_tokens_limit\n323\t        self.count_tokens_before_request = count_tokens_before_request\n324\t\n325\t    @overload\n326\t    @deprecated(\n327\t        'Use `input_tokens_limit` instead of `request_tokens_limit` and `output_tokens_limit` and `total_tokens_limit`'\n328\t    )\n329\t    def __init__(\n330\t        self,\n331\t        *,\n332\t        request_limit: int | None = 50,\n333\t        tool_calls_limit: int | None = None,\n334\t        request_tokens_limit: int | None = None,\n335\t        response_tokens_limit: int | None = None,\n336\t        total_tokens_limit: int | None = None,\n337\t        count_tokens_before_request: bool = False,\n338\t    ) -> None:\n339\t        self.request_limit = request_limit\n340\t        self.tool_calls_limit = tool_calls_limit\n341\t        self.input_tokens_limit = request_tokens_limit\n342\t        self.output_tokens_limit = response_tokens_limit\n343\t        self.total_tokens_limit = total_tokens_limit\n344\t        self.count_tokens_before_request = count_tokens_before_request\n345\t\n346\t    def __init__(\n347\t        self,\n348\t        *,\n349\t        request_limit: int | None = 50,\n350\t        tool_calls_limit: int | None = None,\n351\t        input_tokens_limit: int | None = None,\n352\t        output_tokens_limit: int | None = None,\n353\t        total_tokens_limit: int | None = None,\n354\t        count_tokens_before_request: bool = False,\n355\t        # deprecated:\n356\t        request_tokens_limit: int | None = None,\n357\t        response_tokens_limit: int | None = None,\n358\t    ):\n359\t        self.request_limit = request_limit\n360\t        self.tool_calls_limit = tool_calls_limit\n361\t        self.input_tokens_limit = input_tokens_limit if input_tokens_limit is not None else request_tokens_limit\n362\t        self.output_tokens_limit = output_tokens_limit if output_tokens_limit is not None else response_tokens_limit\n363\t        self.total_tokens_limit = total_tokens_limit\n364\t        self.count_tokens_before_request = count_tokens_before_request\n365\t\n366\t    def has_token_limits(self) -> bool:\n367\t        \"\"\"Returns `True` if this instance places any limits on token counts.\n368\t\n369\t        If this returns `False`, the `check_tokens` method will never raise an error.\n370\t\n371\t        This is useful because if we have token limits, we need to check them after receiving each streamed message.\n372\t        If there are no limits, we can skip that processing in the streaming response iterator.\n373\t        \"\"\"\n374\t        return any(\n375\t            limit is not None for limit in (self.input_tokens_limit, self.output_tokens_limit, self.total_tokens_limit)\n376\t        )\n377\t\n378\t    def check_before_request(self, usage: RunUsage) -> None:\n379\t        \"\"\"Raises a `UsageLimitExceeded` exception if the next request would exceed any of the limits.\"\"\"\n380\t        request_limit = self.request_limit\n381\t        if request_limit is not None and usage.requests >= request_limit:\n382\t            raise UsageLimitExceeded(f'The next request would exceed the request_limit of {request_limit}')\n383\t\n384\t        input_tokens = usage.input_tokens\n385\t        if self.input_tokens_limit is not None and input_tokens > self.input_tokens_limit:\n386\t            raise UsageLimitExceeded(\n387\t                f'The next request would exceed the input_tokens_limit of {self.input_tokens_limit} ({input_tokens=})'\n388\t            )\n389\t\n390\t        total_tokens = usage.total_tokens\n391\t        if self.total_tokens_limit is not None and total_tokens > self.total_tokens_limit:\n392\t            raise UsageLimitExceeded(  # pragma: lax no cover\n393\t                f'The next request would exceed the total_tokens_limit of {self.total_tokens_limit} ({total_tokens=})'\n394\t            )\n395\t\n396\t    def check_tokens(self, usage: RunUsage) -> None:\n397\t        \"\"\"Raises a `UsageLimitExceeded` exception if the usage exceeds any of the token limits.\"\"\"\n398\t        input_tokens = usage.input_tokens\n399\t        if self.input_tokens_limit is not None and input_tokens > self.input_tokens_limit:\n400\t            raise UsageLimitExceeded(f'Exceeded the input_tokens_limit of {self.input_tokens_limit} ({input_tokens=})')\n401\t\n402\t        output_tokens = usage.output_tokens\n403\t        if self.output_tokens_limit is not None and output_tokens > self.output_tokens_limit:\n404\t            raise UsageLimitExceeded(\n405\t                f'Exceeded the output_tokens_limit of {self.output_tokens_limit} ({output_tokens=})'\n406\t            )\n407\t\n408\t        total_tokens = usage.total_tokens\n409\t        if self.total_tokens_limit is not None and total_tokens > self.total_tokens_limit:\n410\t            raise UsageLimitExceeded(f'Exceeded the total_tokens_limit of {self.total_tokens_limit} ({total_tokens=})')\n411\t\n412\t    def check_before_tool_call(self, projected_usage: RunUsage) -> None:\n413\t        \"\"\"Raises a `UsageLimitExceeded` exception if the next tool call(s) would exceed the tool call limit.\"\"\"\n414\t        tool_calls_limit = self.tool_calls_limit\n415\t        tool_calls = projected_usage.tool_calls\n416\t        if tool_calls_limit is not None and tool_calls > tool_calls_limit:\n417\t            raise UsageLimitExceeded(\n418\t                f'The next tool call(s) would exceed the tool_calls_limit of {tool_calls_limit} ({tool_calls=}).'\n419\t            )\n420\t\n421\t    __repr__ = _utils.dataclasses_no_defaults_repr\n422\t"}]},"parent_tool_use_id":null,"session_id":"4a975106-0ac1-4d93-9678-77f65344e100","uuid":"12bbe57a-6039-48fb-93cf-308be431fd59","timestamp":"2026-09-27T13:13:05.225Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/.venv/lib/python3.14/site-packages/pydantic_ai/usage.py","content":"from __future__ import annotations as _annotations\n\nimport dataclasses\nfrom copy import copy\nfrom dataclasses import dataclass, fields\nfrom typing import Annotated, Any\n\nfrom genai_prices.data_snapshot import get_snapshot\nfrom pydantic import AliasChoices, BeforeValidator, Field\nfrom typing_extensions import deprecated, overload\n\nfrom . import _utils\nfrom .exceptions import UsageLimitExceeded\n\n__all__ = 'RequestUsage', 'RunUsage', 'Usage', 'UsageLimits'\n\n\n@dataclass(repr=False, kw_only=True)\nclass UsageBase:\n    input_tokens: Annotated[\n        int,\n        # `request_tokens` is deprecated, but we still want to support deserializing model responses stored in a DB before the name was changed\n        Field(validation_alias=AliasChoices('input_tokens', 'request_tokens')),\n    ] = 0\n    \"\"\"Number of input/prompt tokens.\"\"\"\n\n    cache_write_tokens: int = 0\n    \"\"\"Number of tokens written to the cache.\"\"\"\n    cache_read_tokens: int = 0\n    \"\"\"Number of tokens read from the cache.\"\"\"\n\n    output_tokens: Annotated[\n        int,\n        # `response_tokens` is deprecated, but we still want to support deserializing model responses stored in a DB before the name was changed\n        Field(validation_alias=AliasChoices('output_tokens', 'response_tokens')),\n    ] = 0\n    \"\"\"Number of output/completion tokens.\"\"\"\n\n    input_audio_tokens: int = 0\n    \"\"\"Number of audio input tokens.\"\"\"\n    cache_audio_read_tokens: int = 0\n    \"\"\"Number of audio tokens read from the cache.\"\"\"\n    output_audio_tokens: int = 0\n    \"\"\"Number of audio output tokens.\"\"\"\n\n    details: Annotated[\n        dict[str, int],\n        # `details` can not be `None` any longer, but we still want to support deserializing model responses stored in a DB before this was changed\n        BeforeValidator(lambda d: d or {}),\n    ] = dataclasses.field(default_factory=dict[str, int])\n    \"\"\"Any extra details returned by the model.\"\"\"\n\n    def __copy__(self) -> UsageBase:\n        \"\"\"Shallow copy that also copies mutable fields like `details`.\"\"\"\n        cls = type(self)\n        new = cls.__new__(cls)\n        new.__dict__.update(self.__dict__)\n        new.details = self.details.copy()\n        return new\n\n    @property\n    @deprecated('`request_tokens` is deprecated, use `input_tokens` instead')\n    def request_tokens(self) -> int:\n        return self.input_tokens\n\n    @property\n    @deprecated('`response_tokens` is deprecated, use `output_tokens` instead')\n    def response_tokens(self) -> int:\n        return self.output_tokens\n\n    @property\n    def total_tokens(self) -> int:\n        \"\"\"Sum of `input_tokens + output_tokens`.\"\"\"\n        return self.input_tokens + self.output_tokens\n\n    def opentelemetry_attributes(self) -> dict[str, int]:\n        \"\"\"Get the token usage values as OpenTelemetry attributes.\"\"\"\n        result: dict[str, int] = {}\n        if self.input_tokens:\n            result['gen_ai.usage.input_tokens'] = self.input_tokens\n        if self.output_tokens:\n            result['gen_ai.usage.output_tokens'] = self.output_tokens\n\n        details = self.details.copy()\n        if self.cache_write_tokens:\n            result['gen_ai.usage.cache_creation.input_tokens'] = self.cache_write_tokens\n            # For backwards compat\n            details['cache_write_tokens'] = self.cache_write_tokens\n        if self.cache_read_tokens:\n            result['gen_ai.usage.cache_read.input_tokens'] = self.cache_read_tokens\n            # For backwards compat\n            details['cache_read_tokens'] = self.cache_read_tokens\n        if self.input_audio_tokens:\n            details['input_audio_tokens'] = self.input_audio_tokens\n        if self.cache_audio_read_tokens:\n            details['cache_audio_read_tokens'] = self.cache_audio_read_tokens\n        if self.output_audio_tokens:\n            details['output_audio_tokens'] = self.output_audio_tokens\n        if details:\n            prefix = 'gen_ai.usage.details.'\n            for key, value in details.items():\n                # Skipping check for value since spec implies all detail values are relevant\n                if value:\n                    result[prefix + key] = value\n        return result\n\n    def __repr__(self):\n        kv_pairs = (f'{f.name}={value!r}' for f in fields(self) if (value := getattr(self, f.name)))\n        return f'{self.__class__.__qualname__}({\", \".join(kv_pairs)})'\n\n    def has_values(self) -> bool:\n        \"\"\"Whether any values are set and non-zero.\"\"\"\n        return any(dataclasses.asdict(self).values())\n\n\n@dataclass(repr=False, kw_only=True)\nclass RequestUsage(UsageBase):\n    \"\"\"LLM usage associated with a single request.\n\n    This is an implementation of `genai_prices.types.AbstractUsage` so it can be used to calculate the price of the\n    request using [genai-prices](https://github.com/pydantic/genai-prices).\n    \"\"\"\n\n    @property\n    def requests(self):\n        return 1\n\n    def incr(self, incr_usage: RequestUsage) -> None:\n        \"\"\"Increment the usage in place.\n\n        Args:\n            incr_usage: The usage to increment by.\n        \"\"\"\n        return _incr_usage_tokens(self, incr_usage)\n\n    def __add__(self, other: RequestUsage) -> RequestUsage:\n        \"\"\"Add two RequestUsages together.\n\n        This is provided so it's trivial to sum usage information from multiple parts of a response.\n\n        **WARNING:** this CANNOT be used to sum multiple requests without breaking some pricing calculations.\n        \"\"\"\n        new_usage = copy(self)\n        new_usage.incr(other)\n        return new_usage\n\n    @classmethod\n    def extract(\n        cls,\n        data: Any,\n        *,\n        provider: str,\n        provider_url: str,\n        provider_fallback: str,\n        api_flavor: str = 'default',\n        details: dict[str, Any] | None = None,\n    ) -> RequestUsage:\n        \"\"\"Extract usage information from the response data using genai-prices.\n\n        Args:\n            data: The response data from the model API.\n            provider: The actual provider ID\n            provider_url: The provider base_url\n            provider_fallback: The fallback provider ID to use if the actual provider is not found in genai-prices.\n                For example, an OpenAI model should set this to \"openai\" in case it has an obscure provider ID.\n            api_flavor: The API flavor to use when extracting usage information,\n                e.g. 'chat' or 'responses' for OpenAI.\n            details: Becomes the `details` field on the returned `RequestUsage` for convenience.\n        \"\"\"\n        details = details or {}\n        for provider_id, provider_api_url in [(None, provider_url), (provider, None), (provider_fallback, None)]:\n            try:\n                provider_obj = get_snapshot().find_provider(None, provider_id, provider_api_url)\n                _model_ref, extracted_usage = provider_obj.extract_usage(data, api_flavor=api_flavor)\n                return cls(**{k: v for k, v in extracted_usage.__dict__.items() if v is not None}, details=details)\n            except Exception:\n                pass\n        return cls(details=details)\n\n\n@dataclass(repr=False, kw_only=True)\nclass RunUsage(UsageBase):\n    \"\"\"LLM usage associated with an agent run.\n\n    Responsibility for calculating request usage is on the model; Pydantic AI simply sums the usage information across requests.\n    \"\"\"\n\n    requests: int = 0\n    \"\"\"Number of requests made to the LLM API.\"\"\"\n\n    tool_calls: int = 0\n    \"\"\"Number of successful tool calls executed during the run.\"\"\"\n\n    input_tokens: int = 0\n    \"\"\"Total number of input/prompt tokens.\"\"\"\n\n    cache_write_tokens: int = 0\n    \"\"\"Total number of tokens written to the cache.\"\"\"\n\n    cache_read_tokens: int = 0\n    \"\"\"Total number of tokens read from the cache.\"\"\"\n\n    input_audio_tokens: int = 0\n    \"\"\"Total number of audio input tokens.\"\"\"\n\n    cache_audio_read_tokens: int = 0\n    \"\"\"Total number of audio tokens read from the cache.\"\"\"\n\n    output_tokens: int = 0\n    \"\"\"Total number of output/completion tokens.\"\"\"\n\n    details: dict[str, int] = dataclasses.field(default_factory=dict[str, int])\n    \"\"\"Any extra details returned by the model.\"\"\"\n\n    def incr(self, incr_usage: RunUsage | RequestUsage) -> None:\n        \"\"\"Increment the usage in place.\n\n        Args:\n            incr_usage: The usage to increment by.\n        \"\"\"\n        if isinstance(incr_usage, RunUsage):\n            self.requests += incr_usage.requests\n            self.tool_calls += incr_usage.tool_calls\n        return _incr_usage_tokens(self, incr_usage)\n\n    def __add__(self, other: RunUsage | RequestUsage) -> RunUsage:\n        \"\"\"Add two RunUsages together.\n\n        This is provided so it's trivial to sum usage information from multiple runs.\n        \"\"\"\n        new_usage = copy(self)\n        new_usage.incr(other)\n        return new_usage\n\n\ndef _incr_usage_tokens(slf: RunUsage | RequestUsage, incr_usage: RunUsage | RequestUsage) -> None:\n    \"\"\"Increment the usage in place.\n\n    Args:\n        slf: The usage to increment.\n        incr_usage: The usage to increment by.\n    \"\"\"\n    slf.input_tokens += incr_usage.input_tokens\n    slf.cache_write_tokens += incr_usage.cache_write_tokens\n    slf.cache_read_tokens += incr_usage.cache_read_tokens\n    slf.input_audio_tokens += incr_usage.input_audio_tokens\n    slf.cache_audio_read_tokens += incr_usage.cache_audio_read_tokens\n    slf.output_tokens += incr_usage.output_tokens\n\n    for key, value in incr_usage.details.items():\n        # Note: value can be None at runtime from model responses despite the type annotation\n        if isinstance(value, (int, float)):\n            slf.details[key] = slf.details.get(key, 0) + value\n\n\n@dataclass(repr=False, kw_only=True)\n@deprecated('`Usage` is deprecated, use `RunUsage` instead')\nclass Usage(RunUsage):\n    \"\"\"Deprecated alias for `RunUsage`.\"\"\"\n\n\n@dataclass(repr=False, kw_only=True)\nclass UsageLimits:\n    \"\"\"Limits on model usage.\n\n    The request count is tracked by pydantic_ai, and the request limit is checked before each request to the model.\n    Token counts are provided in responses from the model, and the token limits are checked after each response.\n\n    Each of the limits can be set to `None` to disable that limit.\n    \"\"\"\n\n    request_limit: int | None = 50\n    \"\"\"The maximum number of requests allowed to the model.\"\"\"\n    tool_calls_limit: int | None = None\n    \"\"\"The maximum number of successful tool calls allowed to be executed.\"\"\"\n    input_tokens_limit: int | None = None\n    \"\"\"The maximum number of input/prompt tokens allowed.\"\"\"\n    output_tokens_limit: int | None = None\n    \"\"\"The maximum number of output/response tokens allowed.\"\"\"\n    total_tokens_limit: int | None = None\n    \"\"\"The maximum number of tokens allowed in requests and responses combined.\"\"\"\n    count_tokens_before_request: bool = False\n    \"\"\"If True, perform a token counting pass before sending the request to the model,\n    to enforce `input_tokens_limit` ahead of time.\n\n    This may incur additional overhead (from calling the model's `count_tokens` API before making the actual request)\n    and is disabled by default.\n\n    Supported by:\n\n    - Anthropic\n    - Google\n    - Bedrock Converse\n    - OpenAI Responses\n    \"\"\"\n\n    @property\n    @deprecated('`request_tokens_limit` is deprecated, use `input_tokens_limit` instead')\n    def request_tokens_limit(self) -> int | None:\n        return self.input_tokens_limit\n\n    @property\n    @deprecated('`response_tokens_limit` is deprecated, use `output_tokens_limit` instead')\n    def response_tokens_limit(self) -> int | None:\n        return self.output_tokens_limit\n\n    @overload\n    def __init__(\n        self,\n        *,\n        request_limit: int | None = 50,\n        tool_calls_limit: int | None = None,\n        input_tokens_limit: int | None = None,\n        output_tokens_limit: int | None = None,\n        total_tokens_limit: int | None = None,\n        count_tokens_before_request: bool = False,\n    ) -> None:\n        self.request_limit = request_limit\n        self.tool_calls_limit = tool_calls_limit\n        self.input_tokens_limit = input_tokens_limit\n        self.output_tokens_limit = output_tokens_limit\n        self.total_tokens_limit = total_tokens_limit\n        self.count_tokens_before_request = count_tokens_before_request\n\n    @overload\n    @deprecated(\n        'Use `input_tokens_limit` instead of `request_tokens_limit` and `output_tokens_limit` and `total_tokens_limit`'\n    )\n    def __init__(\n        self,\n        *,\n        request_limit: int | None = 50,\n        tool_calls_limit: int | None = None,\n        request_tokens_limit: int | None = None,\n        response_tokens_limit: int | None = None,\n        total_tokens_limit: int | None = None,\n        count_tokens_before_request: bool = False,\n    ) -> None:\n        self.request_limit = request_limit\n        self.tool_calls_limit = tool_calls_limit\n        self.input_tokens_limit = request_tokens_limit\n        self.output_tokens_limit = response_tokens_limit\n        self.total_tokens_limit = total_tokens_limit\n        self.count_tokens_before_request = count_tokens_before_request\n\n    def __init__(\n        self,\n        *,\n        request_limit: int | None = 50,\n        tool_calls_limit: int | None = None,\n        input_tokens_limit: int | None = None,\n        output_tokens_limit: int | None = None,\n        total_tokens_limit: int | None = None,\n        count_tokens_before_request: bool = False,\n        # deprecated:\n        request_tokens_limit: int | None = None,\n        response_tokens_limit: int | None = None,\n    ):\n        self.request_limit = request_limit\n        self.tool_calls_limit = tool_calls_limit\n        self.input_tokens_limit = input_tokens_limit if input_tokens_limit is not None else request_tokens_limit\n        self.output_tokens_limit = output_tokens_limit if output_tokens_limit is not None else response_tokens_limit\n        self.total_tokens_limit = total_tokens_limit\n        self.count_tokens_before_request = count_tokens_before_request\n\n    def has_token_limits(self) -> bool:\n        \"\"\"Returns `True` if this instance places any limits on token counts.\n\n        If this returns `False`, the `check_tokens` method will never raise an error.\n\n        This is useful because if we have token limits, we need to check them after receiving each streamed message.\n        If there are no limits, we can skip that processing in the streaming response iterator.\n        \"\"\"\n        return any(\n            limit is not None for limit in (self.input_tokens_limit, self.output_tokens_limit, self.total_tokens_limit)\n        )\n\n    def check_before_request(self, usage: RunUsage) -> None:\n        \"\"\"Raises a `UsageLimitExceeded` exception if the next request would exceed any of the limits.\"\"\"\n        request_limit = self.request_limit\n        if request_limit is not None and usage.requests >= request_limit:\n            raise UsageLimitExceeded(f'The next request would exceed the request_limit of {request_limit}')\n\n        input_tokens = usage.input_tokens\n        if self.input_tokens_limit is not None and input_tokens > self.input_tokens_limit:\n            raise UsageLimitExceeded(\n                f'The next request would exceed the input_tokens_limit of {self.input_tokens_limit} ({input_tokens=})'\n            )\n\n        total_tokens = usage.total_tokens\n        if self.total_tokens_limit is not None and total_tokens > self.total_tokens_limit:\n            raise UsageLimitExceeded(  # pragma: lax no cover\n                f'The next request would exceed the total_tokens_limit of {self.total_tokens_limit} ({total_tokens=})'\n            )\n\n    def check_tokens(self, usage: RunUsage) -> None:\n        \"\"\"Raises a `UsageLimitExceeded` exception if the usage exceeds any of the token limits.\"\"\"\n        input_tokens = usage.input_tokens\n        if self.input_tokens_limit is not None and input_tokens > self.input_tokens_limit:\n            raise UsageLimitExceeded(f'Exceeded the input_tokens_limit of {self.input_tokens_limit} ({input_tokens=})')\n\n        output_tokens = usage.output_tokens\n        if self.output_tokens_limit is not None and output_tokens > self.output_tokens_limit:\n            raise UsageLimitExceeded(\n                f'Exceeded the output_tokens_limit of {self.output_tokens_limit} ({output_tokens=})'\n            )\n\n        total_tokens = usage.total_tokens\n        if self.total_tokens_limit is not None and total_tokens > self.total_tokens_limit:\n            raise UsageLimitExceeded(f'Exceeded the total_tokens_limit of {self.total_tokens_limit} ({total_tokens=})')\n\n    def check_before_tool_call(self, projected_usage: RunUsage) -> None:\n        \"\"\"Raises a `UsageLimitExceeded` exception if the next tool call(s) would exceed the tool call limit.\"\"\"\n        tool_calls_limit = self.tool_calls_limit\n        tool_calls = projected_usage.tool_calls\n        if tool_calls_limit is not None and tool_calls > tool_calls_limit:\n            raise UsageLimitExceeded(\n                f'The next tool call(s) would exceed the tool_calls_limit of {tool_calls_limit} ({tool_calls=}).'\n            )\n\n    __repr__ = _utils.dataclasses_no_defaults_repr\n","numLines":422,"startLine":1,"totalLines":422}}}
