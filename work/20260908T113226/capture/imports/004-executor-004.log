{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CDhdEk3UrCFWybeNRXJw8g","type":"tool_result","content":"1\t\"\"\"Pydantic-AI adapter for Claude Code subscription-account inference.\n2\t\n3\tThe adapter invokes ``claude --print`` once per Pydantic-AI turn. Claude has\n4\tno tools or MCP servers of its own; it may only select one action from the\n5\tschema supplied by the outer harness. Pydantic-AI remains responsible for\n6\texecuting evidence tools, validating outputs, retries, and control limits.\n7\t\n8\tAuthentication is deliberately narrow. ``CLAUDE_CODE_OAUTH_TOKEN`` must\n9\talready be present in the process environment (normally by sourcing the\n10\tmachine-level secrets file). API credentials and third-party-provider switches\n11\tare removed from the child environment so this route cannot silently fall back\n12\tto separately metered Anthropic API, Bedrock, Vertex, or Foundry usage.\n13\t\"\"\"\n14\t\n15\tfrom __future__ import annotations\n16\t\n17\timport asyncio\n18\timport json\n19\timport os\n20\timport re\n21\timport shutil\n22\timport subprocess\n23\timport tempfile\n24\timport uuid\n25\tfrom typing import Any\n26\t\n27\tfrom pydantic_ai import ModelMessagesTypeAdapter\n28\tfrom pydantic_ai.messages import ModelMessage, ModelResponse, ToolCallPart\n29\tfrom pydantic_ai.models.function import AgentInfo, FunctionModel\n30\t\n31\tfrom harness.errors import AuthError, QuotaExceeded\n32\t\n33\t\n34\tclass ClaudeAccountCliError(RuntimeError):\n35\t    \"\"\"The account-backed Claude CLI could not produce a model action.\"\"\"\n36\t\n37\t\n38\t_NON_ACCOUNT_ENV_VARS = (\n39\t    \"ANTHROPIC_API_KEY\",\n40\t    \"ANTHROPIC_AUTH_TOKEN\",\n41\t    \"CLAUDE_CODE_USE_BEDROCK\",\n42\t    \"CLAUDE_CODE_USE_VERTEX\",\n43\t    \"CLAUDE_CODE_USE_FOUNDRY\",\n44\t)\n45\t\n46\t_SYSTEM_PROMPT = (\n47\t    \"Return exactly one object satisfying the supplied JSON schema. You have no \"\n48\t    \"tools and must not attempt to act outside this text-generation request.\"\n49\t)\n50\t\n51\t\n52\tdef _redact_account_token(text: str) -> str:\n53\t    token = os.environ.get(\"CLAUDE_CODE_OAUTH_TOKEN\")\n54\t    return text.replace(token, \"[REDACTED]\") if token else text\n55\t\n56\t\n57\tdef _account_environment() -> dict[str, str]:\n58\t    \"\"\"Return a child environment that can only select Claude account auth.\"\"\"\n59\t    env = dict(os.environ)\n60\t    if not env.get(\"CLAUDE_CODE_OAUTH_TOKEN\"):\n61\t        raise ClaudeAccountCliError(\n62\t            \"CLAUDE_CODE_OAUTH_TOKEN is not set; source the machine-level \"\n63\t            \"secrets file before running the harness\"\n64\t        )\n65\t    for name in _NON_ACCOUNT_ENV_VARS:\n66\t        env.pop(name, None)\n67\t    return env\n68\t\n69\t\n70\tdef claude_account_status(binary: str = \"claude\") -> tuple[bool, str]:\n71\t    \"\"\"Check the exact token-backed environment used for inference.\"\"\"\n72\t    resolved = shutil.which(binary)\n73\t    if not resolved:\n74\t        return False, f\"`{binary}` is not on PATH\"\n75\t    try:\n76\t        env = _account_environment()\n77\t        result = subprocess.run(\n78\t            [resolved, \"auth\", \"status\", \"--json\"],\n79\t            capture_output=True,\n80\t            text=True,\n81\t            timeout=20,\n82\t            check=False,\n83\t            env=env,\n84\t        )\n85\t    except (OSError, subprocess.SubprocessError, ClaudeAccountCliError) as exc:\n86\t        return False, str(exc)\n87\t\n88\t    detail = (result.stdout + result.stderr).strip()\n89\t    if result.returncode != 0:\n90\t        return False, _redact_account_token(detail) or f\"exit {result.returncode}\"\n91\t    try:\n92\t        status = json.loads(result.stdout)\n93\t    except json.JSONDecodeError:\n94\t        return False, \"`claude auth status --json` returned invalid JSON\"\n95\t    if not status.get(\"loggedIn\"):\n96\t        return False, \"Claude CLI reports loggedIn=false\"\n97\t    method = status.get(\"authMethod\", \"unknown\")\n98\t    provider = status.get(\"apiProvider\", \"unknown\")\n99\t    return True, f\"logged in ({method}, {provider})\"\n100\t\n101\t\n102\tdef _action_schema(tool_names: list[str]) -> dict[str, Any]:\n103\t    return {\n104\t        \"type\": \"object\",\n105\t        \"properties\": {\n106\t            \"tool_name\": {\"type\": \"string\", \"enum\": tool_names},\n107\t            \"arguments_json\": {\n108\t                \"type\": \"string\",\n109\t                \"description\": \"A JSON-encoded object satisfying the selected tool schema\",\n110\t            },\n111\t        },\n112\t        \"required\": [\"tool_name\", \"arguments_json\"],\n113\t        \"additionalProperties\": False,\n114\t    }\n115\t\n116\t\n117\tdef _split_system_prompt(\n118\t    messages: list[ModelMessage],\n119\t) -> tuple[str, list[dict[str, Any]]]:\n120\t    \"\"\"Remove duplicate Pydantic instructions from later request messages.\n121\t\n122\t    Pydantic repeats the 13 KB frozen policy on every ModelRequest. Preserve its\n123\t    first occurrence in the conversation, where the proven CLI route expects\n124\t    it, and remove later copies. SystemPromptPart remains supported separately.\n125\t    \"\"\"\n126\t    history = json.loads(ModelMessagesTypeAdapter.dump_json(messages))\n127\t    instructions: list[str] = []\n128\t    embedded_instructions: str | None = None\n129\t    cleaned: list[dict[str, Any]] = []\n130\t    for message in history:\n131\t        copy = dict(message)\n132\t        # Current Pydantic-AI serialises instructions on ModelRequest itself\n133\t        # (and repeats them on later requests), rather than as a\n134\t        # SystemPromptPart. Support both shapes so upgrades cannot silently\n135\t        # reintroduce the repeated 13 KB policy.\n136\t        request_instructions = copy.pop(\"instructions\", None)\n137\t        if isinstance(request_instructions, str) and embedded_instructions is None:\n138\t            embedded_instructions = request_instructions\n139\t            copy[\"instructions\"] = request_instructions\n140\t        parts = []\n141\t        for part in message.get(\"parts\", []):\n142\t            if part.get(\"part_kind\") == \"system-prompt\":\n143\t                content = part.get(\"content\")\n144\t                if isinstance(content, str) and content not in instructions:\n145\t                    instructions.append(content)\n146\t            else:\n147\t                parts.append(part)\n148\t        copy[\"parts\"] = parts\n149\t        if parts:\n150\t            cleaned.append(copy)\n151\t    system = _SYSTEM_PROMPT\n152\t    if instructions:\n153\t        system += \"\\n\\n\" + \"\\n\\n\".join(instructions)\n154\t    return system, cleaned\n155\t\n156\t\n157\tdef _has_evidence_result(history: list[dict[str, Any]]) -> bool:\n158\t    return any(\n159\t        part.get(\"part_kind\") == \"tool-return\" and part.get(\"tool_name\") == \"fetch_evidence\"\n160\t        for message in history\n161\t        for part in message.get(\"parts\", [])\n162\t    )\n163\t\n164\t\n165\tdef _prompt(\n166\t    history: list[dict[str, Any]], info: AgentInfo\n167\t) -> tuple[str, list[str]]:\n168\t    # Once evidence has returned successfully, the question is settled. Hiding\n169\t    # function-tool schemas from the rendering turn shrinks the changing suffix\n170\t    # and prevents an unnecessary second fetch; output validation can still ask\n171\t    # the model to repair its terminal draft.\n172\t    available = (\n173\t        list(info.output_tools)\n174\t        if _has_evidence_result(history)\n175\t        else [*info.function_tools, *info.output_tools]\n176\t    )\n177\t    tools = [\n178\t        {\n179\t            \"name\": tool.name,\n180\t            \"kind\": tool.kind,\n181\t            \"description\": tool.description,\n182\t            \"arguments_schema\": tool.parameters_json_schema,\n183\t        }\n184\t        for tool in available\n185\t    ]\n186\t    prompt = (\n187\t        \"You are the model inside a Pydantic-AI tool loop. Follow the system \"\n188\t        \"instructions contained in the conversation. Select exactly one available \"\n189\t        \"tool for the next step. Function tools continue the loop; output tools end \"\n190\t        \"it. arguments_json must be a JSON-encoded object satisfying the selected \"\n191\t        \"tool's arguments_schema.\\n\\n\"\n192\t        f\"AVAILABLE TOOLS:\\n{json.dumps(tools, ensure_ascii=False)}\\n\\n\"\n193\t        f\"CONVERSATION:\\n{json.dumps(history, ensure_ascii=False)}\"\n194\t    )\n195\t    return prompt, [tool.name for tool in available]\n196\t\n197\t\n198\tdef _structured_action(stdout: bytes) -> dict[str, Any]:\n199\t    \"\"\"Extract structured output from Claude CLI's JSON result envelope.\"\"\"\n200\t    try:\n201\t        envelope = json.loads(stdout.decode(\"utf-8\"))\n202\t    except (UnicodeDecodeError, json.JSONDecodeError) as exc:\n203\t        raise ClaudeAccountCliError(f\"invalid JSON from `claude --print`: {exc}\") from exc\n204\t\n205\t    action = envelope.get(\"structured_output\")\n206\t    if action is None:\n207\t        action = envelope.get(\"result\")\n208\t        if isinstance(action, str):\n209\t            try:\n210\t                action = json.loads(action)\n211\t            except json.JSONDecodeError as exc:\n212\t                raise ClaudeAccountCliError(\n213\t                    \"`claude --print` result did not contain structured output\"\n214\t                ) from exc\n215\t    if not isinstance(action, dict):\n216\t        raise ClaudeAccountCliError(\"`claude --print` returned no structured action\")\n217\t    return action\n218\t\n219\t\n220\tdef _result_envelope(stdout: bytes) -> dict[str, Any] | None:\n221\t    \"\"\"Best-effort decoding for CLI failures without ever echoing raw JSON.\"\"\"\n222\t    try:\n223\t        envelope = json.loads(stdout.decode(\"utf-8\"))\n224\t    except (UnicodeDecodeError, json.JSONDecodeError):\n225\t        return None\n226\t    return envelope if isinstance(envelope, dict) else None\n227\t\n228\t\n229\tdef _raise_for_result_error(stdout: bytes) -> None:\n230\t    \"\"\"Turn Claude's structured error result into a concise typed exception.\"\"\"\n231\t    envelope = _result_envelope(stdout)\n232\t    if not envelope or not envelope.get(\"is_error\"):\n233\t        return\n234\t\n235\t    status = envelope.get(\"api_error_status\")\n236\t    result = envelope.get(\"result\")\n237\t    detail = result.strip() if isinstance(result, str) else \"Claude CLI request failed\"\n238\t    lowered = detail.lower()\n239\t    if \"not logged in\" in lowered or \"please run /login\" in lowered:\n240\t        raise AuthError(\n241\t            \"Claude subscription authentication is not usable; run `claude /login` \"\n242\t            \"and refresh CLAUDE_CODE_OAUTH_TOKEN\",\n243\t            status_code=401,\n244\t        )\n245\t    definitive_limit = (\n246\t        \"session limit\" in lowered\n247\t        or \"usage limit\" in lowered\n248\t        or \"resets\" in lowered\n249\t        or (\"hit your\" in lowered and \"limit\" in lowered)\n250\t    )\n251\t    if status == 429 and definitive_limit:\n252\t        match = re.search(r\"\\bresets?\\s+(.+)$\", detail, flags=re.IGNORECASE)\n253\t        reset_at = match.group(1).strip() if match else None\n254\t        message = \"Claude subscription quota exhausted\"\n255\t        if reset_at:\n256\t            message += f\"; resets {reset_at}\"\n257\t        raise QuotaExceeded(message, provider=\"claude-account\", reset_at=reset_at)\n258\t\n259\t    status_text = f\" (HTTP {status})\" if isinstance(status, int) else \"\"\n260\t    raise ClaudeAccountCliError(f\"Claude CLI request failed{status_text}: {detail}\")\n261\t\n262\t\n263\tdef _claude_command(\n264\t    resolved: str,\n265\t    schema: str,\n266\t    empty_mcp: str,\n267\t    model: str | None,\n268\t    system_prompt: str = _SYSTEM_PROMPT,\n269\t) -> list[str]:\n270\t    command = [\n271\t        resolved,\n272\t        \"--print\",\n273\t        \"--output-format\",\n274\t        \"json\",\n275\t        \"--json-schema\",\n276\t        schema,\n277\t        \"--system-prompt\",\n278\t        system_prompt,\n279\t        \"--tools\",\n280\t        \"\",\n281\t        \"--strict-mcp-config\",\n282\t        \"--mcp-config\",\n283\t        empty_mcp,\n284\t        \"--disable-slash-commands\",\n285\t        \"--no-session-persistence\",\n286\t        \"--permission-mode\",\n287\t        \"dontAsk\",\n288\t        \"--setting-sources\",\n289\t        \"\",\n290\t    ]\n291\t    if model:\n292\t        command.extend([\"--model\", model])\n293\t    return command\n294\t\n295\t\n296\tasync def _invoke_claude(\n297\t    messages: list[ModelMessage],\n298\t    info: AgentInfo,\n299\t    *,\n300\t    binary: str,\n301\t    model: str | None,\n302\t    timeout_seconds: int,\n303\t) -> ModelResponse:\n304\t    resolved = shutil.which(binary)\n305\t    if not resolved:\n306\t        raise ClaudeAccountCliError(f\"`{binary}` is not on PATH\")\n307\t\n308\t    system_prompt, history = _split_system_prompt(messages)\n309\t    prompt, tool_names = _prompt(history, info)\n310\t    if not tool_names:\n311\t        raise ClaudeAccountCliError(\"Pydantic-AI supplied no function or output tools\")\n312\t\n313\t    schema = json.dumps(_action_schema(tool_names), separators=(\",\", \":\"))\n314\t    empty_mcp = json.dumps({\"mcpServers\": {}}, separators=(\",\", \":\"))\n315\t    with tempfile.TemporaryDirectory(prefix=\"k12-harness-claude-\") as temp:\n316\t        command = _claude_command(resolved, schema, empty_mcp, model, system_prompt)\n317\t\n318\t        process = await asyncio.create_subprocess_exec(\n319\t            *command,\n320\t            cwd=temp,\n321\t            stdin=asyncio.subprocess.PIPE,\n322\t            stdout=asyncio.subprocess.PIPE,\n323\t            stderr=asyncio.subprocess.PIPE,\n324\t            env=_account_environment(),\n325\t        )\n326\t        try:\n327\t            stdout, stderr = await asyncio.wait_for(\n328\t                process.communicate(prompt.encode(\"utf-8\")),\n329\t                timeout=timeout_seconds,\n330\t            )\n331\t        except BaseException:\n332\t            if process.returncode is None:\n333\t                process.kill()\n334\t                await process.wait()\n335\t            raise\n336\t\n337\t    # A quota response can carry a syntactically valid structured_output at the\n338\t    # same time as is_error=true. The account state wins: accepting that action\n339\t    # would contaminate the measurement at the reset boundary.\n340\t    _raise_for_result_error(stdout)\n341\t    if process.returncode != 0:\n342\t        detail = _redact_account_token(\n343\t            (stderr or stdout).decode(\"utf-8\", errors=\"replace\").strip()\n344\t        )\n345\t        raise ClaudeAccountCliError(\n346\t            f\"`claude --print` exited {process.returncode}: {detail[-2000:]}\"\n347\t        )\n348\t    action = _structured_action(stdout)\n349\t    if action.get(\"tool_name\") not in tool_names or not isinstance(\n350\t        action.get(\"arguments_json\"), str\n351\t    ):\n352\t        raise ClaudeAccountCliError(f\"invalid action from `claude --print`: {action!r}\")\n353\t    try:\n354\t        arguments = json.loads(action[\"arguments_json\"])\n355\t    except json.JSONDecodeError as exc:\n356\t        raise ClaudeAccountCliError(\n357\t            f\"invalid tool arguments from `claude --print`: {exc}\"\n358\t        ) from exc\n359\t    if not isinstance(arguments, dict):\n360\t        raise ClaudeAccountCliError(\"tool arguments from `claude --print` are not an object\")\n361\t\n362\t    return ModelResponse(\n363\t        parts=[\n364\t            ToolCallPart(\n365\t                tool_name=action[\"tool_name\"],\n366\t                args=arguments,\n367\t                tool_call_id=f\"claude-{uuid.uuid4().hex}\",\n368\t            )\n369\t        ],\n370\t        model_name=model or \"account-default\",\n371\t        provider_name=\"claude-account\",\n372\t        finish_reason=\"tool_call\",\n373\t    )\n374\t\n375\t\n376\tdef build_claude_account_model(\n377\t    *,\n378\t    binary: str = \"claude\",\n379\t    model: str | None = None,\n380\t    timeout_seconds: int = 110,\n381\t) -> FunctionModel:\n382\t    \"\"\"Build a model that delegates each turn to locked-down ``claude -p``.\"\"\"\n383\t\n384\t    async def request(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:\n385\t        return await _invoke_claude(\n386\t            messages,\n387\t            info,\n388\t            binary=binary,\n389\t            model=model,\n390\t            timeout_seconds=timeout_seconds,\n391\t        )\n392\t\n393\t    return FunctionModel(request, model_name=f\"claude-account:{model or 'default'}\")\n394\t"}]},"parent_tool_use_id":null,"session_id":"4a975106-0ac1-4d93-9678-77f65344e100","uuid":"c80f4b56-2809-4bb5-aa4c-13a176127c64","timestamp":"2026-09-27T13:12:31.739Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/harness/claude_account_cli.py","content":"\"\"\"Pydantic-AI adapter for Claude Code subscription-account inference.\n\nThe adapter invokes ``claude --print`` once per Pydantic-AI turn. Claude has\nno tools or MCP servers of its own; it may only select one action from the\nschema supplied by the outer harness. Pydantic-AI remains responsible for\nexecuting evidence tools, validating outputs, retries, and control limits.\n\nAuthentication is deliberately narrow. ``CLAUDE_CODE_OAUTH_TOKEN`` must\nalready be present in the process environment (normally by sourcing the\nmachine-level secrets file). API credentials and third-party-provider switches\nare removed from the child environment so this route cannot silently fall back\nto separately metered Anthropic API, Bedrock, Vertex, or Foundry usage.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport json\nimport os\nimport re\nimport shutil\nimport subprocess\nimport tempfile\nimport uuid\nfrom typing import Any\n\nfrom pydantic_ai import ModelMessagesTypeAdapter\nfrom pydantic_ai.messages import ModelMessage, ModelResponse, ToolCallPart\nfrom pydantic_ai.models.function import AgentInfo, FunctionModel\n\nfrom harness.errors import AuthError, QuotaExceeded\n\n\nclass ClaudeAccountCliError(RuntimeError):\n    \"\"\"The account-backed Claude CLI could not produce a model action.\"\"\"\n\n\n_NON_ACCOUNT_ENV_VARS = (\n    \"ANTHROPIC_API_KEY\",\n    \"ANTHROPIC_AUTH_TOKEN\",\n    \"CLAUDE_CODE_USE_BEDROCK\",\n    \"CLAUDE_CODE_USE_VERTEX\",\n    \"CLAUDE_CODE_USE_FOUNDRY\",\n)\n\n_SYSTEM_PROMPT = (\n    \"Return exactly one object satisfying the supplied JSON schema. You have no \"\n    \"tools and must not attempt to act outside this text-generation request.\"\n)\n\n\ndef _redact_account_token(text: str) -> str:\n    token = os.environ.get(\"CLAUDE_CODE_OAUTH_TOKEN\")\n    return text.replace(token, \"[REDACTED]\") if token else text\n\n\ndef _account_environment() -> dict[str, str]:\n    \"\"\"Return a child environment that can only select Claude account auth.\"\"\"\n    env = dict(os.environ)\n    if not env.get(\"CLAUDE_CODE_OAUTH_TOKEN\"):\n        raise ClaudeAccountCliError(\n            \"CLAUDE_CODE_OAUTH_TOKEN is not set; source the machine-level \"\n            \"secrets file before running the harness\"\n        )\n    for name in _NON_ACCOUNT_ENV_VARS:\n        env.pop(name, None)\n    return env\n\n\ndef claude_account_status(binary: str = \"claude\") -> tuple[bool, str]:\n    \"\"\"Check the exact token-backed environment used for inference.\"\"\"\n    resolved = shutil.which(binary)\n    if not resolved:\n        return False, f\"`{binary}` is not on PATH\"\n    try:\n        env = _account_environment()\n        result = subprocess.run(\n            [resolved, \"auth\", \"status\", \"--json\"],\n            capture_output=True,\n            text=True,\n            timeout=20,\n            check=False,\n            env=env,\n        )\n    except (OSError, subprocess.SubprocessError, ClaudeAccountCliError) as exc:\n        return False, str(exc)\n\n    detail = (result.stdout + result.stderr).strip()\n    if result.returncode != 0:\n        return False, _redact_account_token(detail) or f\"exit {result.returncode}\"\n    try:\n        status = json.loads(result.stdout)\n    except json.JSONDecodeError:\n        return False, \"`claude auth status --json` returned invalid JSON\"\n    if not status.get(\"loggedIn\"):\n        return False, \"Claude CLI reports loggedIn=false\"\n    method = status.get(\"authMethod\", \"unknown\")\n    provider = status.get(\"apiProvider\", \"unknown\")\n    return True, f\"logged in ({method}, {provider})\"\n\n\ndef _action_schema(tool_names: list[str]) -> dict[str, Any]:\n    return {\n        \"type\": \"object\",\n        \"properties\": {\n            \"tool_name\": {\"type\": \"string\", \"enum\": tool_names},\n            \"arguments_json\": {\n                \"type\": \"string\",\n                \"description\": \"A JSON-encoded object satisfying the selected tool schema\",\n            },\n        },\n        \"required\": [\"tool_name\", \"arguments_json\"],\n        \"additionalProperties\": False,\n    }\n\n\ndef _split_system_prompt(\n    messages: list[ModelMessage],\n) -> tuple[str, list[dict[str, Any]]]:\n    \"\"\"Remove duplicate Pydantic instructions from later request messages.\n\n    Pydantic repeats the 13 KB frozen policy on every ModelRequest. Preserve its\n    first occurrence in the conversation, where the proven CLI route expects\n    it, and remove later copies. SystemPromptPart remains supported separately.\n    \"\"\"\n    history = json.loads(ModelMessagesTypeAdapter.dump_json(messages))\n    instructions: list[str] = []\n    embedded_instructions: str | None = None\n    cleaned: list[dict[str, Any]] = []\n    for message in history:\n        copy = dict(message)\n        # Current Pydantic-AI serialises instructions on ModelRequest itself\n        # (and repeats them on later requests), rather than as a\n        # SystemPromptPart. Support both shapes so upgrades cannot silently\n        # reintroduce the repeated 13 KB policy.\n        request_instructions = copy.pop(\"instructions\", None)\n        if isinstance(request_instructions, str) and embedded_instructions is None:\n            embedded_instructions = request_instructions\n            copy[\"instructions\"] = request_instructions\n        parts = []\n        for part in message.get(\"parts\", []):\n            if part.get(\"part_kind\") == \"system-prompt\":\n                content = part.get(\"content\")\n                if isinstance(content, str) and content not in instructions:\n                    instructions.append(content)\n            else:\n                parts.append(part)\n        copy[\"parts\"] = parts\n        if parts:\n            cleaned.append(copy)\n    system = _SYSTEM_PROMPT\n    if instructions:\n        system += \"\\n\\n\" + \"\\n\\n\".join(instructions)\n    return system, cleaned\n\n\ndef _has_evidence_result(history: list[dict[str, Any]]) -> bool:\n    return any(\n        part.get(\"part_kind\") == \"tool-return\" and part.get(\"tool_name\") == \"fetch_evidence\"\n        for message in history\n        for part in message.get(\"parts\", [])\n    )\n\n\ndef _prompt(\n    history: list[dict[str, Any]], info: AgentInfo\n) -> tuple[str, list[str]]:\n    # Once evidence has returned successfully, the question is settled. Hiding\n    # function-tool schemas from the rendering turn shrinks the changing suffix\n    # and prevents an unnecessary second fetch; output validation can still ask\n    # the model to repair its terminal draft.\n    available = (\n        list(info.output_tools)\n        if _has_evidence_result(history)\n        else [*info.function_tools, *info.output_tools]\n    )\n    tools = [\n        {\n            \"name\": tool.name,\n            \"kind\": tool.kind,\n            \"description\": tool.description,\n            \"arguments_schema\": tool.parameters_json_schema,\n        }\n        for tool in available\n    ]\n    prompt = (\n        \"You are the model inside a Pydantic-AI tool loop. Follow the system \"\n        \"instructions contained in the conversation. Select exactly one available \"\n        \"tool for the next step. Function tools continue the loop; output tools end \"\n        \"it. arguments_json must be a JSON-encoded object satisfying the selected \"\n        \"tool's arguments_schema.\\n\\n\"\n        f\"AVAILABLE TOOLS:\\n{json.dumps(tools, ensure_ascii=False)}\\n\\n\"\n        f\"CONVERSATION:\\n{json.dumps(history, ensure_ascii=False)}\"\n    )\n    return prompt, [tool.name for tool in available]\n\n\ndef _structured_action(stdout: bytes) -> dict[str, Any]:\n    \"\"\"Extract structured output from Claude CLI's JSON result envelope.\"\"\"\n    try:\n        envelope = json.loads(stdout.decode(\"utf-8\"))\n    except (UnicodeDecodeError, json.JSONDecodeError) as exc:\n        raise ClaudeAccountCliError(f\"invalid JSON from `claude --print`: {exc}\") from exc\n\n    action = envelope.get(\"structured_output\")\n    if action is None:\n        action = envelope.get(\"result\")\n        if isinstance(action, str):\n            try:\n                action = json.loads(action)\n            except json.JSONDecodeError as exc:\n                raise ClaudeAccountCliError(\n                    \"`claude --print` result did not contain structured output\"\n                ) from exc\n    if not isinstance(action, dict):\n        raise ClaudeAccountCliError(\"`claude --print` returned no structured action\")\n    return action\n\n\ndef _result_envelope(stdout: bytes) -> dict[str, Any] | None:\n    \"\"\"Best-effort decoding for CLI failures without ever echoing raw JSON.\"\"\"\n    try:\n        envelope = json.loads(stdout.decode(\"utf-8\"))\n    except (UnicodeDecodeError, json.JSONDecodeError):\n        return None\n    return envelope if isinstance(envelope, dict) else None\n\n\ndef _raise_for_result_error(stdout: bytes) -> None:\n    \"\"\"Turn Claude's structured error result into a concise typed exception.\"\"\"\n    envelope = _result_envelope(stdout)\n    if not envelope or not envelope.get(\"is_error\"):\n        return\n\n    status = envelope.get(\"api_error_status\")\n    result = envelope.get(\"result\")\n    detail = result.strip() if isinstance(result, str) else \"Claude CLI request failed\"\n    lowered = detail.lower()\n    if \"not logged in\" in lowered or \"please run /login\" in lowered:\n        raise AuthError(\n            \"Claude subscription authentication is not usable; run `claude /login` \"\n            \"and refresh CLAUDE_CODE_OAUTH_TOKEN\",\n            status_code=401,\n        )\n    definitive_limit = (\n        \"session limit\" in lowered\n        or \"usage limit\" in lowered\n        or \"resets\" in lowered\n        or (\"hit your\" in lowered and \"limit\" in lowered)\n    )\n    if status == 429 and definitive_limit:\n        match = re.search(r\"\\bresets?\\s+(.+)$\", detail, flags=re.IGNORECASE)\n        reset_at = match.group(1).strip() if match else None\n        message = \"Claude subscription quota exhausted\"\n        if reset_at:\n            message += f\"; resets {reset_at}\"\n        raise QuotaExceeded(message, provider=\"claude-account\", reset_at=reset_at)\n\n    status_text = f\" (HTTP {status})\" if isinstance(status, int) else \"\"\n    raise ClaudeAccountCliError(f\"Claude CLI request failed{status_text}: {detail}\")\n\n\ndef _claude_command(\n    resolved: str,\n    schema: str,\n    empty_mcp: str,\n    model: str | None,\n    system_prompt: str = _SYSTEM_PROMPT,\n) -> list[str]:\n    command = [\n        resolved,\n        \"--print\",\n        \"--output-format\",\n        \"json\",\n        \"--json-schema\",\n        schema,\n        \"--system-prompt\",\n        system_prompt,\n        \"--tools\",\n        \"\",\n        \"--strict-mcp-config\",\n        \"--mcp-config\",\n        empty_mcp,\n        \"--disable-slash-commands\",\n        \"--no-session-persistence\",\n        \"--permission-mode\",\n        \"dontAsk\",\n        \"--setting-sources\",\n        \"\",\n    ]\n    if model:\n        command.extend([\"--model\", model])\n    return command\n\n\nasync def _invoke_claude(\n    messages: list[ModelMessage],\n    info: AgentInfo,\n    *,\n    binary: str,\n    model: str | None,\n    timeout_seconds: int,\n) -> ModelResponse:\n    resolved = shutil.which(binary)\n    if not resolved:\n        raise ClaudeAccountCliError(f\"`{binary}` is not on PATH\")\n\n    system_prompt, history = _split_system_prompt(messages)\n    prompt, tool_names = _prompt(history, info)\n    if not tool_names:\n        raise ClaudeAccountCliError(\"Pydantic-AI supplied no function or output tools\")\n\n    schema = json.dumps(_action_schema(tool_names), separators=(\",\", \":\"))\n    empty_mcp = json.dumps({\"mcpServers\": {}}, separators=(\",\", \":\"))\n    with tempfile.TemporaryDirectory(prefix=\"k12-harness-claude-\") as temp:\n        command = _claude_command(resolved, schema, empty_mcp, model, system_prompt)\n\n        process = await asyncio.create_subprocess_exec(\n            *command,\n            cwd=temp,\n            stdin=asyncio.subprocess.PIPE,\n            stdout=asyncio.subprocess.PIPE,\n            stderr=asyncio.subprocess.PIPE,\n            env=_account_environment(),\n        )\n        try:\n            stdout, stderr = await asyncio.wait_for(\n                process.communicate(prompt.encode(\"utf-8\")),\n                timeout=timeout_seconds,\n            )\n        except BaseException:\n            if process.returncode is None:\n                process.kill()\n                await process.wait()\n            raise\n\n    # A quota response can carry a syntactically valid structured_output at the\n    # same time as is_error=true. The account state wins: accepting that action\n    # would contaminate the measurement at the reset boundary.\n    _raise_for_result_error(stdout)\n    if process.returncode != 0:\n        detail = _redact_account_token(\n            (stderr or stdout).decode(\"utf-8\", errors=\"replace\").strip()\n        )\n        raise ClaudeAccountCliError(\n            f\"`claude --print` exited {process.returncode}: {detail[-2000:]}\"\n        )\n    action = _structured_action(stdout)\n    if action.get(\"tool_name\") not in tool_names or not isinstance(\n        action.get(\"arguments_json\"), str\n    ):\n        raise ClaudeAccountCliError(f\"invalid action from `claude --print`: {action!r}\")\n    try:\n        arguments = json.loads(action[\"arguments_json\"])\n    except json.JSONDecodeError as exc:\n        raise ClaudeAccountCliError(\n            f\"invalid tool arguments from `claude --print`: {exc}\"\n        ) from exc\n    if not isinstance(arguments, dict):\n        raise ClaudeAccountCliError(\"tool arguments from `claude --print` are not an object\")\n\n    return ModelResponse(\n        parts=[\n            ToolCallPart(\n                tool_name=action[\"tool_name\"],\n                args=arguments,\n                tool_call_id=f\"claude-{uuid.uuid4().hex}\",\n            )\n        ],\n        model_name=model or \"account-default\",\n        provider_name=\"claude-account\",\n        finish_reason=\"tool_call\",\n    )\n\n\ndef build_claude_account_model(\n    *,\n    binary: str = \"claude\",\n    model: str | None = None,\n    timeout_seconds: int = 110,\n) -> FunctionModel:\n    \"\"\"Build a model that delegates each turn to locked-down ``claude -p``.\"\"\"\n\n    async def request(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:\n        return await _invoke_claude(\n            messages,\n            info,\n            binary=binary,\n            model=model,\n            timeout_seconds=timeout_seconds,\n        )\n\n    return FunctionModel(request, model_name=f\"claude-account:{model or 'default'}\")\n","numLines":394,"startLine":1,"totalLines":394}}}
