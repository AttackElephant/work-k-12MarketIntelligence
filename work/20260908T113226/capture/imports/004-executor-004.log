{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NKy81WcUva2BKTrUy8krb4","type":"tool_result","content":"1\t\"\"\"Per-request LLM usage and cost tracking (ADR-005).\n2\t\n3\tEvery LLM request in a harness run becomes one JSON line in\n4\t``logs/usage/usage-YYYY-MM-DD.jsonl`` (UTC date), plus one ``run_summary``\n5\tline per run. DuckDB reads the files at query time (``sql/usage_views.sql``,\n6\t``python -m harness.usage report``) — nothing here ever opens\n7\t``data/analytics.duckdb``, preserving the single-writer posture (ADR-005)\n8\tand the read-only agent path (ADR-001).\n9\t\n10\tToken convention (genai-prices, used by pydantic-ai's ``RequestUsage``):\n11\t``input_tokens`` INCLUDES cache read and cache write tokens, so\n12\tcache hit rate = ``cache_read_tokens / input_tokens``.\n13\t\n14\tCosts come from ``ModelResponse.cost()`` (genai-prices price snapshot, ships\n15\twith pydantic-ai-slim). They are estimates, not invoices; ``cost_usd`` is\n16\tnull when the model is unknown to the price database.\n17\t\"\"\"\n18\t\n19\tfrom __future__ import annotations\n20\t\n21\timport argparse\n22\timport hashlib\n23\timport json\n24\timport logging\n25\tfrom collections.abc import Sequence\n26\tfrom datetime import datetime, timezone\n27\tfrom pathlib import Path\n28\tfrom typing import Any, Literal\n29\t\n30\tfrom pydantic import BaseModel\n31\tfrom pydantic_ai.messages import ModelMessage, ModelRequest, ModelResponse\n32\tfrom pydantic_ai.usage import RunUsage\n33\t\n34\tfrom config import settings\n35\t\n36\tlogger = logging.getLogger(\"harness.usage\")\n37\t\n38\tQUESTION_PREVIEW_CHARS = 120\n39\tSCHEMA_VERSION = 1\n40\t\n41\t\n42\tclass LlmRequestRecord(BaseModel):\n43\t    \"\"\"One JSONL line per LLM request within a run.\"\"\"\n44\t\n45\t    record_type: Literal[\"request\"] = \"request\"\n46\t    schema_version: int = SCHEMA_VERSION\n47\t    run_id: str\n48\t    request_index: int\n49\t    ts: str                                  # ISO-8601 UTC, response receipt time\n50\t    question_hash: str\n51\t    question_preview: str\n52\t    attempt: int\n53\t    model: str | None\n54\t    provider: str | None\n55\t    input_tokens: int                        # includes cache read+write tokens\n56\t    output_tokens: int\n57\t    cache_read_tokens: int\n58\t    cache_write_tokens: int\n59\t    cost_usd: float | None\n60\t    latency_ms: int | None\n61\t    tool_call_count: int\n62\t    tool_names: list[str]\n63\t    finish_reason: str | None\n64\t    provider_response_id: str | None\n65\t    details: dict[str, Any]\n66\t\n67\t\n68\tclass RunSummaryRecord(BaseModel):\n69\t    \"\"\"One JSONL line per run_harness() call.\"\"\"\n70\t\n71\t    record_type: Literal[\"run_summary\"] = \"run_summary\"\n72\t    schema_version: int = SCHEMA_VERSION\n73\t    run_id: str\n74\t    ts: str                                  # ISO-8601 UTC, run end\n75\t    question_hash: str\n76\t    question_preview: str\n77\t    attempt: int\n78\t    output_branch: str | None                # e.g. \"PeerBenchmarkResult\", \"BudgetExceeded\"\n79\t    requests: int\n80\t    steps: int                               # ModelResponses observed in the history\n81\t    tool_calls: int\n82\t    input_tokens: int\n83\t    output_tokens: int\n84\t    cache_read_tokens: int\n85\t    cache_write_tokens: int\n86\t    cost_usd: float | None\n87\t    cost_complete: bool                      # False if any per-request cost was unknown\n88\t    duration_ms: int | None\n89\t    models: list[str]\n90\t\n91\t\n92\tdef _question_fields(question: str) -> tuple[str, str]:\n93\t    digest = hashlib.sha256(question.encode(\"utf-8\")).hexdigest()[:16]\n94\t    return digest, question[:QUESTION_PREVIEW_CHARS]\n95\t\n96\t\n97\tdef _cost_usd(response: ModelResponse) -> float | None:\n98\t    # LookupError: model unknown to genai-prices; AssertionError: model_name is\n99\t    # None; ValueError: token fields inconsistent. All mean \"no reliable price\".\n100\t    try:\n101\t        return round(float(response.cost().total_price), 8)\n102\t    except (LookupError, ValueError, AssertionError):\n103\t        return None\n104\t\n105\t\n106\tdef spend_usd(messages: Sequence[ModelMessage]) -> tuple[float, bool]:\n107\t    \"\"\"Cost so far, and whether every response in the history could be priced.\n108\t\n109\t    The measurement half of the spend budget (O-7): ``ask()`` calls this between\n110\t    steps and trips ``BudgetExceeded(limit=\"usd\")`` when it passes\n111\t    ``settings.LOOP_MAX_USD``. Returns ``(0.0, True)`` for an empty history.\n112\t\n113\t    ``complete`` is False when any response's model is unknown to the price\n114\t    database, which makes the total a LOWER BOUND. The budget trips on that\n115\t    lower bound: a trip is then always deserved, but an unpriced model can\n116\t    overspend without one — so ``cost_complete`` in the run summary is the field\n117\t    that says whether the budget was actually watching. An offline\n118\t    ``FunctionModel`` run prices at nothing and reports ``complete=False``,\n119\t    which is why the spend budget cannot trip on the golden suite.\n120\t    \"\"\"\n121\t    total = 0.0\n122\t    complete = True\n123\t    for message in messages:\n124\t        if isinstance(message, ModelResponse):\n125\t            cost = _cost_usd(message)\n126\t            if cost is None:\n127\t                complete = False\n128\t            else:\n129\t                total += cost\n130\t    return round(total, 8), complete\n131\t\n132\t\n133\tdef extract_request_records(\n134\t    messages: list[ModelMessage],\n135\t    *,\n136\t    run_id: str,\n137\t    question: str,\n138\t    attempt: int = 1,\n139\t) -> list[LlmRequestRecord]:\n140\t    \"\"\"Build one record per ModelResponse in a run's message history.\"\"\"\n141\t    question_hash, question_preview = _question_fields(question)\n142\t    records: list[LlmRequestRecord] = []\n143\t    prev_request_ts: datetime | None = None\n144\t    for message in messages:\n145\t        if isinstance(message, ModelRequest):\n146\t            prev_request_ts = message.timestamp\n147\t        elif isinstance(message, ModelResponse):\n148\t            latency_ms = None\n149\t            if prev_request_ts is not None and message.timestamp is not None:\n150\t                latency_ms = int(\n151\t                    (message.timestamp - prev_request_ts).total_seconds() * 1000\n152\t                )\n153\t            tool_calls = message.tool_calls\n154\t            records.append(\n155\t                LlmRequestRecord(\n156\t                    run_id=run_id,\n157\t                    request_index=len(records),\n158\t                    ts=message.timestamp.astimezone(timezone.utc).isoformat(),\n159\t                    question_hash=question_hash,\n160\t                    question_preview=question_preview,\n161\t                    attempt=attempt,\n162\t                    model=message.model_name,\n163\t                    provider=message.provider_name,\n164\t                    input_tokens=message.usage.input_tokens,\n165\t                    output_tokens=message.usage.output_tokens,\n166\t                    cache_read_tokens=message.usage.cache_read_tokens,\n167\t                    cache_write_tokens=message.usage.cache_write_tokens,\n168\t                    cost_usd=_cost_usd(message),\n169\t                    latency_ms=latency_ms,\n170\t                    tool_call_count=len(tool_calls),\n171\t                    tool_names=[part.tool_name for part in tool_calls],\n172\t                    finish_reason=message.finish_reason,\n173\t                    provider_response_id=message.provider_response_id,\n174\t                    details=dict(message.usage.details or {}),\n175\t                )\n176\t            )\n177\t    return records\n178\t\n179\t\n180\tdef summarize_run(\n181\t    records: Sequence[LlmRequestRecord],\n182\t    run_usage: RunUsage,\n183\t    *,\n184\t    run_id: str,\n185\t    question: str,\n186\t    attempt: int = 1,\n187\t    output_branch: str | None = None,\n188\t    started_at: datetime | None = None,\n189\t) -> RunSummaryRecord:\n190\t    question_hash, question_preview = _question_fields(question)\n191\t    ended_at = datetime.now(timezone.utc)\n192\t    costs = [r.cost_usd for r in records]\n193\t    known_costs = [c for c in costs if c is not None]\n194\t    return RunSummaryRecord(\n195\t        run_id=run_id,\n196\t        ts=ended_at.isoformat(),\n197\t        question_hash=question_hash,\n198\t        question_preview=question_preview,\n199\t        attempt=attempt,\n200\t        output_branch=output_branch,\n201\t        requests=run_usage.requests,\n202\t        steps=len(records),\n203\t        tool_calls=run_usage.tool_calls,\n204\t        input_tokens=run_usage.input_tokens,\n205\t        output_tokens=run_usage.output_tokens,\n206\t        cache_read_tokens=run_usage.cache_read_tokens,\n207\t        cache_write_tokens=run_usage.cache_write_tokens,\n208\t        cost_usd=round(sum(known_costs), 8) if known_costs else None,\n209\t        cost_complete=len(known_costs) == len(costs),\n210\t        duration_ms=(\n211\t            int((ended_at - started_at).total_seconds() * 1000)\n212\t            if started_at is not None\n213\t            else None\n214\t        ),\n215\t        models=sorted({r.model for r in records if r.model is not None}),\n216\t    )\n217\t\n218\t\n219\tdef append_jsonl(\n220\t    records: Sequence[BaseModel],\n221\t    log_dir: Path | None = None,\n222\t) -> Path:\n223\t    \"\"\"Append one JSON line per record to log_dir/usage-YYYY-MM-DD.jsonl (UTC).\"\"\"\n224\t    log_dir = log_dir if log_dir is not None else settings.USAGE_LOG_DIR\n225\t    log_dir.mkdir(parents=True, exist_ok=True)\n226\t    path = log_dir / f\"usage-{datetime.now(timezone.utc):%Y-%m-%d}.jsonl\"\n227\t    with open(path, \"a\", encoding=\"utf-8\") as f:\n228\t        for record in records:\n229\t            f.write(record.model_dump_json() + \"\\n\")\n230\t    return path\n231\t\n232\t\n233\tdef record_run(\n234\t    result: Any,\n235\t    *,\n236\t    question: str,\n237\t    attempt: int = 1,\n238\t    output_branch: str | None = None,\n239\t    started_at: datetime | None = None,\n240\t    log_dir: Path | None = None,\n241\t) -> RunSummaryRecord | None:\n242\t    \"\"\"Extract and persist usage for a completed pydantic-ai run.\n243\t\n244\t    ``result`` is an AgentRunResult (``result.all_messages()``, ``result.usage``,\n245\t    ``result.run_id``). Never raises: a successful run must not fail on telemetry.\n246\t    Returns the summary, or None if recording failed.\n247\t    \"\"\"\n248\t    try:\n249\t        records = extract_request_records(\n250\t            result.all_messages(),\n251\t            run_id=result.run_id,\n252\t            question=question,\n253\t            attempt=attempt,\n254\t        )\n255\t        summary = summarize_run(\n256\t            records,\n257\t            result.usage,                    # property; the method form is deprecated\n258\t            run_id=result.run_id,\n259\t            question=question,\n260\t            attempt=attempt,\n261\t            output_branch=output_branch,\n262\t            started_at=started_at,\n263\t        )\n264\t        append_jsonl([*records, summary], log_dir=log_dir)\n265\t        logger.info(\n266\t            \"recorded usage for run\",\n267\t            extra={\n268\t                \"run_id\": summary.run_id,\n269\t                \"requests\": summary.requests,\n270\t                \"steps\": summary.steps,\n271\t                \"tool_calls\": summary.tool_calls,\n272\t                \"cost_usd\": summary.cost_usd,\n273\t                \"cost_complete\": summary.cost_complete,\n274\t                \"subsystem\": \"usage\",\n275\t            },\n276\t        )\n277\t        return summary\n278\t    except Exception as e:\n279\t        # Telemetry must never fail a successful run (ADR-005) — an ADR-level\n280\t        # override of the Reference fail-fast routing. Structured fields per\n281\t        # General-Reference-Logging-Config SECTION: LOGGING-PATTERN.\n282\t        logger.error(\n283\t            \"usage recording failed (run continues unaffected)\",\n284\t            exc_info=True,\n285\t            extra={\n286\t                \"error_class\": type(e).__name__,\n287\t                \"retryable\": False,\n288\t                \"subsystem\": \"usage\",\n289\t                \"user_facing\": False,\n290\t            },\n291\t        )\n292\t        return None\n293\t\n294\t\n295\t# ---------------------------------------------------------------------------\n296\t# Reporting CLI: python -m harness.usage report [--days 30] [--log-dir PATH]\n297\t# ---------------------------------------------------------------------------\n298\t\n299\t# {days} is substituted with a validated int — no user-controlled strings.\n300\t_REPORTS: list[tuple[str, str]] = [\n301\t    (\n302\t        \"Cost by day\",\n303\t        \"\"\"\n304\t        SELECT date_trunc('day', ts::TIMESTAMPTZ) AS day,\n305\t               round(sum(cost_usd), 4)            AS cost_usd,\n306\t               sum(input_tokens)                  AS input_tokens,\n307\t               sum(output_tokens)                 AS output_tokens,\n308\t               count(*)                           AS requests\n309\t        FROM v_usage_requests\n310\t        WHERE ts::TIMESTAMPTZ >= now() - to_days({days})\n311\t        GROUP BY 1 ORDER BY 1\n312\t        \"\"\",\n313\t    ),\n314\t    (\n315\t        \"Cost by model\",\n316\t        \"\"\"\n317\t        SELECT model,\n318\t               round(sum(cost_usd), 4) AS cost_usd,\n319\t               sum(input_tokens)       AS input_tokens,\n320\t               sum(output_tokens)      AS output_tokens,\n321\t               count(*)                AS requests\n322\t        FROM v_usage_requests\n323\t        WHERE ts::TIMESTAMPTZ >= now() - to_days({days})\n324\t        GROUP BY 1 ORDER BY 2 DESC NULLS LAST\n325\t        \"\"\",\n326\t    ),\n327\t    (\n328\t        \"Cache hit rate by day (ADR-006 regression view)\",\n329\t        \"\"\"\n330\t        SELECT date_trunc('day', ts::TIMESTAMPTZ) AS day,\n331\t               round(sum(cache_read_tokens)::DOUBLE / nullif(sum(input_tokens), 0), 4)\n332\t                                                  AS cache_hit_rate,\n333\t               sum(cache_write_tokens)            AS cache_write_tokens\n334\t        FROM v_usage_requests\n335\t        WHERE ts::TIMESTAMPTZ >= now() - to_days({days})\n336\t        GROUP BY 1 ORDER BY 1\n337\t        \"\"\",\n338\t    ),\n339\t    (\n340\t        \"Cost by output branch\",\n341\t        \"\"\"\n342\t        SELECT output_branch,\n343\t               count(*)                AS runs,\n344\t               round(sum(cost_usd), 4) AS cost_usd,\n345\t               round(avg(cost_usd), 4) AS avg_cost_usd,\n346\t               round(max(cost_usd), 4) AS max_cost_usd\n347\t        FROM v_usage_runs\n348\t        WHERE ts::TIMESTAMPTZ >= now() - to_days({days})\n349\t        GROUP BY 1 ORDER BY 3 DESC NULLS LAST\n350\t        \"\"\",\n351\t    ),\n352\t    (\n353\t        \"Top 10 most expensive questions\",\n354\t        \"\"\"\n355\t        SELECT question_hash,\n356\t               any_value(question_preview) AS question_preview,\n357\t               count(*)                    AS runs,\n358\t               round(sum(cost_usd), 4)     AS cost_usd\n359\t        FROM v_usage_runs\n360\t        WHERE ts::TIMESTAMPTZ >= now() - to_days({days})\n361\t        GROUP BY 1 ORDER BY 4 DESC NULLS LAST LIMIT 10\n362\t        \"\"\",\n363\t    ),\n364\t    (\n365\t        \"Latency by model (ms)\",\n366\t        \"\"\"\n367\t        SELECT model,\n368\t               round(quantile_cont(latency_ms, 0.5))  AS p50_ms,\n369\t               round(quantile_cont(latency_ms, 0.95)) AS p95_ms,\n370\t               count(*)                               AS requests\n371\t        FROM v_usage_requests\n372\t        WHERE latency_ms IS NOT NULL\n373\t          AND ts::TIMESTAMPTZ >= now() - to_days({days})\n374\t        GROUP BY 1 ORDER BY 1\n375\t        \"\"\",\n376\t    ),\n377\t]\n378\t\n379\t\n380\tdef report(days: int = 30, log_dir: Path | None = None) -> None:\n381\t    import duckdb\n382\t\n383\t    log_dir = (log_dir if log_dir is not None else settings.USAGE_LOG_DIR).resolve()\n384\t    glob = str(log_dir / \"usage-*.jsonl\")\n385\t    if not list(log_dir.glob(\"usage-*.jsonl\")):\n386\t        # Handled anomaly (empty result), not a crash — WARNING per the level\n387\t        # semantics; still printed so an interactive caller sees the outcome.\n388\t        logger.warning(\"no usage logs found\", extra={\"log_dir\": str(log_dir), \"subsystem\": \"usage\"})\n389\t        print(f\"No usage logs found under {log_dir}\")\n390\t        return\n391\t\n392\t    # In-memory connection only — never data/analytics.duckdb (ADR-005).\n393\t    con = duckdb.connect()\n394\t    views_sql = (settings.PROJECT_ROOT / \"sql\" / \"usage_views.sql\").read_text()\n395\t    # The checked-in views use a repo-relative glob; substitute the absolute\n396\t    # log dir so the CLI works regardless of cwd (launchd/cron discipline).\n397\t    logger.debug(\"creating usage views\", extra={\"sql\": views_sql, \"glob\": glob, \"subsystem\": \"usage\"})\n398\t    con.execute(views_sql.replace(\"logs/usage/usage-*.jsonl\", glob))\n399\t    for title, sql in _REPORTS:\n400\t        query = sql.format(days=int(days))\n401\t        logger.debug(\"running report query\", extra={\"report\": title, \"sql\": query, \"subsystem\": \"usage\"})\n402\t        print(f\"\\n== {title} (last {days} days) ==\")\n403\t        print(con.sql(query))\n404\t\n405\t\n406\tdef _main() -> None:\n407\t    # Configure logging ONCE, here at the entry point (the single control point;\n408\t    # verbosity comes from LOG_LEVEL). Other entry points must do the same.\n409\t    from harness.logging_config import configure_logging\n410\t\n411\t    configure_logging()\n412\t    parser = argparse.ArgumentParser(prog=\"python -m harness.usage\")\n413\t    sub = parser.add_subparsers(dest=\"command\", required=True)\n414\t    p_report = sub.add_parser(\"report\", help=\"print usage/cost rollups\")\n415\t    p_report.add_argument(\"--days\", type=int, default=30)\n416\t    p_report.add_argument(\"--log-dir\", type=Path, default=None)\n417\t    args = parser.parse_args()\n418\t    if args.command == \"report\":\n419\t        report(days=args.days, log_dir=args.log_dir)\n420\t\n421\t\n422\tif __name__ == \"__main__\":\n423\t    _main()\n424\t"}]},"parent_tool_use_id":null,"session_id":"4a975106-0ac1-4d93-9678-77f65344e100","uuid":"e15d5976-3615-4db2-aa5d-dc3438507bb1","timestamp":"2026-09-27T13:12:34.706Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/harness/usage.py","content":"\"\"\"Per-request LLM usage and cost tracking (ADR-005).\n\nEvery LLM request in a harness run becomes one JSON line in\n``logs/usage/usage-YYYY-MM-DD.jsonl`` (UTC date), plus one ``run_summary``\nline per run. DuckDB reads the files at query time (``sql/usage_views.sql``,\n``python -m harness.usage report``) — nothing here ever opens\n``data/analytics.duckdb``, preserving the single-writer posture (ADR-005)\nand the read-only agent path (ADR-001).\n\nToken convention (genai-prices, used by pydantic-ai's ``RequestUsage``):\n``input_tokens`` INCLUDES cache read and cache write tokens, so\ncache hit rate = ``cache_read_tokens / input_tokens``.\n\nCosts come from ``ModelResponse.cost()`` (genai-prices price snapshot, ships\nwith pydantic-ai-slim). They are estimates, not invoices; ``cost_usd`` is\nnull when the model is unknown to the price database.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport logging\nfrom collections.abc import Sequence\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any, Literal\n\nfrom pydantic import BaseModel\nfrom pydantic_ai.messages import ModelMessage, ModelRequest, ModelResponse\nfrom pydantic_ai.usage import RunUsage\n\nfrom config import settings\n\nlogger = logging.getLogger(\"harness.usage\")\n\nQUESTION_PREVIEW_CHARS = 120\nSCHEMA_VERSION = 1\n\n\nclass LlmRequestRecord(BaseModel):\n    \"\"\"One JSONL line per LLM request within a run.\"\"\"\n\n    record_type: Literal[\"request\"] = \"request\"\n    schema_version: int = SCHEMA_VERSION\n    run_id: str\n    request_index: int\n    ts: str                                  # ISO-8601 UTC, response receipt time\n    question_hash: str\n    question_preview: str\n    attempt: int\n    model: str | None\n    provider: str | None\n    input_tokens: int                        # includes cache read+write tokens\n    output_tokens: int\n    cache_read_tokens: int\n    cache_write_tokens: int\n    cost_usd: float | None\n    latency_ms: int | None\n    tool_call_count: int\n    tool_names: list[str]\n    finish_reason: str | None\n    provider_response_id: str | None\n    details: dict[str, Any]\n\n\nclass RunSummaryRecord(BaseModel):\n    \"\"\"One JSONL line per run_harness() call.\"\"\"\n\n    record_type: Literal[\"run_summary\"] = \"run_summary\"\n    schema_version: int = SCHEMA_VERSION\n    run_id: str\n    ts: str                                  # ISO-8601 UTC, run end\n    question_hash: str\n    question_preview: str\n    attempt: int\n    output_branch: str | None                # e.g. \"PeerBenchmarkResult\", \"BudgetExceeded\"\n    requests: int\n    steps: int                               # ModelResponses observed in the history\n    tool_calls: int\n    input_tokens: int\n    output_tokens: int\n    cache_read_tokens: int\n    cache_write_tokens: int\n    cost_usd: float | None\n    cost_complete: bool                      # False if any per-request cost was unknown\n    duration_ms: int | None\n    models: list[str]\n\n\ndef _question_fields(question: str) -> tuple[str, str]:\n    digest = hashlib.sha256(question.encode(\"utf-8\")).hexdigest()[:16]\n    return digest, question[:QUESTION_PREVIEW_CHARS]\n\n\ndef _cost_usd(response: ModelResponse) -> float | None:\n    # LookupError: model unknown to genai-prices; AssertionError: model_name is\n    # None; ValueError: token fields inconsistent. All mean \"no reliable price\".\n    try:\n        return round(float(response.cost().total_price), 8)\n    except (LookupError, ValueError, AssertionError):\n        return None\n\n\ndef spend_usd(messages: Sequence[ModelMessage]) -> tuple[float, bool]:\n    \"\"\"Cost so far, and whether every response in the history could be priced.\n\n    The measurement half of the spend budget (O-7): ``ask()`` calls this between\n    steps and trips ``BudgetExceeded(limit=\"usd\")`` when it passes\n    ``settings.LOOP_MAX_USD``. Returns ``(0.0, True)`` for an empty history.\n\n    ``complete`` is False when any response's model is unknown to the price\n    database, which makes the total a LOWER BOUND. The budget trips on that\n    lower bound: a trip is then always deserved, but an unpriced model can\n    overspend without one — so ``cost_complete`` in the run summary is the field\n    that says whether the budget was actually watching. An offline\n    ``FunctionModel`` run prices at nothing and reports ``complete=False``,\n    which is why the spend budget cannot trip on the golden suite.\n    \"\"\"\n    total = 0.0\n    complete = True\n    for message in messages:\n        if isinstance(message, ModelResponse):\n            cost = _cost_usd(message)\n            if cost is None:\n                complete = False\n            else:\n                total += cost\n    return round(total, 8), complete\n\n\ndef extract_request_records(\n    messages: list[ModelMessage],\n    *,\n    run_id: str,\n    question: str,\n    attempt: int = 1,\n) -> list[LlmRequestRecord]:\n    \"\"\"Build one record per ModelResponse in a run's message history.\"\"\"\n    question_hash, question_preview = _question_fields(question)\n    records: list[LlmRequestRecord] = []\n    prev_request_ts: datetime | None = None\n    for message in messages:\n        if isinstance(message, ModelRequest):\n            prev_request_ts = message.timestamp\n        elif isinstance(message, ModelResponse):\n            latency_ms = None\n            if prev_request_ts is not None and message.timestamp is not None:\n                latency_ms = int(\n                    (message.timestamp - prev_request_ts).total_seconds() * 1000\n                )\n            tool_calls = message.tool_calls\n            records.append(\n                LlmRequestRecord(\n                    run_id=run_id,\n                    request_index=len(records),\n                    ts=message.timestamp.astimezone(timezone.utc).isoformat(),\n                    question_hash=question_hash,\n                    question_preview=question_preview,\n                    attempt=attempt,\n                    model=message.model_name,\n                    provider=message.provider_name,\n                    input_tokens=message.usage.input_tokens,\n                    output_tokens=message.usage.output_tokens,\n                    cache_read_tokens=message.usage.cache_read_tokens,\n                    cache_write_tokens=message.usage.cache_write_tokens,\n                    cost_usd=_cost_usd(message),\n                    latency_ms=latency_ms,\n                    tool_call_count=len(tool_calls),\n                    tool_names=[part.tool_name for part in tool_calls],\n                    finish_reason=message.finish_reason,\n                    provider_response_id=message.provider_response_id,\n                    details=dict(message.usage.details or {}),\n                )\n            )\n    return records\n\n\ndef summarize_run(\n    records: Sequence[LlmRequestRecord],\n    run_usage: RunUsage,\n    *,\n    run_id: str,\n    question: str,\n    attempt: int = 1,\n    output_branch: str | None = None,\n    started_at: datetime | None = None,\n) -> RunSummaryRecord:\n    question_hash, question_preview = _question_fields(question)\n    ended_at = datetime.now(timezone.utc)\n    costs = [r.cost_usd for r in records]\n    known_costs = [c for c in costs if c is not None]\n    return RunSummaryRecord(\n        run_id=run_id,\n        ts=ended_at.isoformat(),\n        question_hash=question_hash,\n        question_preview=question_preview,\n        attempt=attempt,\n        output_branch=output_branch,\n        requests=run_usage.requests,\n        steps=len(records),\n        tool_calls=run_usage.tool_calls,\n        input_tokens=run_usage.input_tokens,\n        output_tokens=run_usage.output_tokens,\n        cache_read_tokens=run_usage.cache_read_tokens,\n        cache_write_tokens=run_usage.cache_write_tokens,\n        cost_usd=round(sum(known_costs), 8) if known_costs else None,\n        cost_complete=len(known_costs) == len(costs),\n        duration_ms=(\n            int((ended_at - started_at).total_seconds() * 1000)\n            if started_at is not None\n            else None\n        ),\n        models=sorted({r.model for r in records if r.model is not None}),\n    )\n\n\ndef append_jsonl(\n    records: Sequence[BaseModel],\n    log_dir: Path | None = None,\n) -> Path:\n    \"\"\"Append one JSON line per record to log_dir/usage-YYYY-MM-DD.jsonl (UTC).\"\"\"\n    log_dir = log_dir if log_dir is not None else settings.USAGE_LOG_DIR\n    log_dir.mkdir(parents=True, exist_ok=True)\n    path = log_dir / f\"usage-{datetime.now(timezone.utc):%Y-%m-%d}.jsonl\"\n    with open(path, \"a\", encoding=\"utf-8\") as f:\n        for record in records:\n            f.write(record.model_dump_json() + \"\\n\")\n    return path\n\n\ndef record_run(\n    result: Any,\n    *,\n    question: str,\n    attempt: int = 1,\n    output_branch: str | None = None,\n    started_at: datetime | None = None,\n    log_dir: Path | None = None,\n) -> RunSummaryRecord | None:\n    \"\"\"Extract and persist usage for a completed pydantic-ai run.\n\n    ``result`` is an AgentRunResult (``result.all_messages()``, ``result.usage``,\n    ``result.run_id``). Never raises: a successful run must not fail on telemetry.\n    Returns the summary, or None if recording failed.\n    \"\"\"\n    try:\n        records = extract_request_records(\n            result.all_messages(),\n            run_id=result.run_id,\n            question=question,\n            attempt=attempt,\n        )\n        summary = summarize_run(\n            records,\n            result.usage,                    # property; the method form is deprecated\n            run_id=result.run_id,\n            question=question,\n            attempt=attempt,\n            output_branch=output_branch,\n            started_at=started_at,\n        )\n        append_jsonl([*records, summary], log_dir=log_dir)\n        logger.info(\n            \"recorded usage for run\",\n            extra={\n                \"run_id\": summary.run_id,\n                \"requests\": summary.requests,\n                \"steps\": summary.steps,\n                \"tool_calls\": summary.tool_calls,\n                \"cost_usd\": summary.cost_usd,\n                \"cost_complete\": summary.cost_complete,\n                \"subsystem\": \"usage\",\n            },\n        )\n        return summary\n    except Exception as e:\n        # Telemetry must never fail a successful run (ADR-005) — an ADR-level\n        # override of the Reference fail-fast routing. Structured fields per\n        # General-Reference-Logging-Config SECTION: LOGGING-PATTERN.\n        logger.error(\n            \"usage recording failed (run continues unaffected)\",\n            exc_info=True,\n            extra={\n                \"error_class\": type(e).__name__,\n                \"retryable\": False,\n                \"subsystem\": \"usage\",\n                \"user_facing\": False,\n            },\n        )\n        return None\n\n\n# ---------------------------------------------------------------------------\n# Reporting CLI: python -m harness.usage report [--days 30] [--log-dir PATH]\n# ---------------------------------------------------------------------------\n\n# {days} is substituted with a validated int — no user-controlled strings.\n_REPORTS: list[tuple[str, str]] = [\n    (\n        \"Cost by day\",\n        \"\"\"\n        SELECT date_trunc('day', ts::TIMESTAMPTZ) AS day,\n               round(sum(cost_usd), 4)            AS cost_usd,\n               sum(input_tokens)                  AS input_tokens,\n               sum(output_tokens)                 AS output_tokens,\n               count(*)                           AS requests\n        FROM v_usage_requests\n        WHERE ts::TIMESTAMPTZ >= now() - to_days({days})\n        GROUP BY 1 ORDER BY 1\n        \"\"\",\n    ),\n    (\n        \"Cost by model\",\n        \"\"\"\n        SELECT model,\n               round(sum(cost_usd), 4) AS cost_usd,\n               sum(input_tokens)       AS input_tokens,\n               sum(output_tokens)      AS output_tokens,\n               count(*)                AS requests\n        FROM v_usage_requests\n        WHERE ts::TIMESTAMPTZ >= now() - to_days({days})\n        GROUP BY 1 ORDER BY 2 DESC NULLS LAST\n        \"\"\",\n    ),\n    (\n        \"Cache hit rate by day (ADR-006 regression view)\",\n        \"\"\"\n        SELECT date_trunc('day', ts::TIMESTAMPTZ) AS day,\n               round(sum(cache_read_tokens)::DOUBLE / nullif(sum(input_tokens), 0), 4)\n                                                  AS cache_hit_rate,\n               sum(cache_write_tokens)            AS cache_write_tokens\n        FROM v_usage_requests\n        WHERE ts::TIMESTAMPTZ >= now() - to_days({days})\n        GROUP BY 1 ORDER BY 1\n        \"\"\",\n    ),\n    (\n        \"Cost by output branch\",\n        \"\"\"\n        SELECT output_branch,\n               count(*)                AS runs,\n               round(sum(cost_usd), 4) AS cost_usd,\n               round(avg(cost_usd), 4) AS avg_cost_usd,\n               round(max(cost_usd), 4) AS max_cost_usd\n        FROM v_usage_runs\n        WHERE ts::TIMESTAMPTZ >= now() - to_days({days})\n        GROUP BY 1 ORDER BY 3 DESC NULLS LAST\n        \"\"\",\n    ),\n    (\n        \"Top 10 most expensive questions\",\n        \"\"\"\n        SELECT question_hash,\n               any_value(question_preview) AS question_preview,\n               count(*)                    AS runs,\n               round(sum(cost_usd), 4)     AS cost_usd\n        FROM v_usage_runs\n        WHERE ts::TIMESTAMPTZ >= now() - to_days({days})\n        GROUP BY 1 ORDER BY 4 DESC NULLS LAST LIMIT 10\n        \"\"\",\n    ),\n    (\n        \"Latency by model (ms)\",\n        \"\"\"\n        SELECT model,\n               round(quantile_cont(latency_ms, 0.5))  AS p50_ms,\n               round(quantile_cont(latency_ms, 0.95)) AS p95_ms,\n               count(*)                               AS requests\n        FROM v_usage_requests\n        WHERE latency_ms IS NOT NULL\n          AND ts::TIMESTAMPTZ >= now() - to_days({days})\n        GROUP BY 1 ORDER BY 1\n        \"\"\",\n    ),\n]\n\n\ndef report(days: int = 30, log_dir: Path | None = None) -> None:\n    import duckdb\n\n    log_dir = (log_dir if log_dir is not None else settings.USAGE_LOG_DIR).resolve()\n    glob = str(log_dir / \"usage-*.jsonl\")\n    if not list(log_dir.glob(\"usage-*.jsonl\")):\n        # Handled anomaly (empty result), not a crash — WARNING per the level\n        # semantics; still printed so an interactive caller sees the outcome.\n        logger.warning(\"no usage logs found\", extra={\"log_dir\": str(log_dir), \"subsystem\": \"usage\"})\n        print(f\"No usage logs found under {log_dir}\")\n        return\n\n    # In-memory connection only — never data/analytics.duckdb (ADR-005).\n    con = duckdb.connect()\n    views_sql = (settings.PROJECT_ROOT / \"sql\" / \"usage_views.sql\").read_text()\n    # The checked-in views use a repo-relative glob; substitute the absolute\n    # log dir so the CLI works regardless of cwd (launchd/cron discipline).\n    logger.debug(\"creating usage views\", extra={\"sql\": views_sql, \"glob\": glob, \"subsystem\": \"usage\"})\n    con.execute(views_sql.replace(\"logs/usage/usage-*.jsonl\", glob))\n    for title, sql in _REPORTS:\n        query = sql.format(days=int(days))\n        logger.debug(\"running report query\", extra={\"report\": title, \"sql\": query, \"subsystem\": \"usage\"})\n        print(f\"\\n== {title} (last {days} days) ==\")\n        print(con.sql(query))\n\n\ndef _main() -> None:\n    # Configure logging ONCE, here at the entry point (the single control point;\n    # verbosity comes from LOG_LEVEL). Other entry points must do the same.\n    from harness.logging_config import configure_logging\n\n    configure_logging()\n    parser = argparse.ArgumentParser(prog=\"python -m harness.usage\")\n    sub = parser.add_subparsers(dest=\"command\", required=True)\n    p_report = sub.add_parser(\"report\", help=\"print usage/cost rollups\")\n    p_report.add_argument(\"--days\", type=int, default=30)\n    p_report.add_argument(\"--log-dir\", type=Path, default=None)\n    args = parser.parse_args()\n    if args.command == \"report\":\n        report(days=args.days, log_dir=args.log_dir)\n\n\nif __name__ == \"__main__\":\n    _main()\n","numLines":424,"startLine":1,"totalLines":424}}}
