{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014ETScaq6onMsFenEEB2Wqf","type":"tool_result","content":"1\t\"\"\"Unit tests for harness/usage.py (ADR-005). Zero network, zero analytics.duckdb.\"\"\"\n2\t\n3\timport json\n4\tfrom datetime import datetime, timedelta, timezone\n5\t\n6\timport duckdb\n7\timport pytest\n8\tfrom pydantic_ai import Agent\n9\tfrom pydantic_ai.messages import ModelRequest, ModelResponse, TextPart, ToolCallPart, UserPromptPart\n10\tfrom pydantic_ai.models.test import TestModel\n11\tfrom pydantic_ai.usage import RequestUsage, RunUsage\n12\t\n13\tfrom harness import usage\n14\t\n15\tT0 = datetime(2026, 6, 12, 1, 0, 0, tzinfo=timezone.utc)\n16\t\n17\t# Anthropic reports input_tokens EXCLUDING cache tokens; pydantic-ai's\n18\t# RequestUsage follows the genai-prices convention where input_tokens INCLUDES\n19\t# them — so 1000 uncached + 2000 cache-read + 100 cache-write arrives as:\n20\tUSAGE_SONNET = RequestUsage(\n21\t    input_tokens=3100,\n22\t    cache_read_tokens=2000,\n23\t    cache_write_tokens=100,\n24\t    output_tokens=500,\n25\t)\n26\t# Expected genai-prices cost on claude-sonnet-4-6 ($3/M uncached input,\n27\t# 0.1x cache read, 1.25x cache write, $15/M output): $0.011475.\n28\tEXPECTED_COST = 0.011475\n29\t\n30\t\n31\tdef _history(model_name=\"claude-sonnet-4-6\"):\n32\t    return [\n33\t        ModelRequest(parts=[UserPromptPart(content=\"What is X?\")], timestamp=T0),\n34\t        ModelResponse(\n35\t            parts=[\n36\t                TextPart(content=\"Let me check.\"),\n37\t                ToolCallPart(tool_name=\"run_sql\", args={\"sql\": \"SELECT 1\"}),\n38\t            ],\n39\t            usage=USAGE_SONNET,\n40\t            model_name=model_name,\n41\t            provider_name=\"anthropic\",\n42\t            provider_url=\"https://api.anthropic.com\",\n43\t            timestamp=T0 + timedelta(seconds=2),\n44\t        ),\n45\t    ]"}]},"parent_tool_use_id":null,"session_id":"4a975106-0ac1-4d93-9678-77f65344e100","uuid":"664371a8-c587-48f6-872f-62abad96a25b","timestamp":"2026-09-27T13:13:11.500Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/shane/Projects/k-12Harness/tests/unit/test_usage.py","content":"\"\"\"Unit tests for harness/usage.py (ADR-005). Zero network, zero analytics.duckdb.\"\"\"\n\nimport json\nfrom datetime import datetime, timedelta, timezone\n\nimport duckdb\nimport pytest\nfrom pydantic_ai import Agent\nfrom pydantic_ai.messages import ModelRequest, ModelResponse, TextPart, ToolCallPart, UserPromptPart\nfrom pydantic_ai.models.test import TestModel\nfrom pydantic_ai.usage import RequestUsage, RunUsage\n\nfrom harness import usage\n\nT0 = datetime(2026, 6, 12, 1, 0, 0, tzinfo=timezone.utc)\n\n# Anthropic reports input_tokens EXCLUDING cache tokens; pydantic-ai's\n# RequestUsage follows the genai-prices convention where input_tokens INCLUDES\n# them — so 1000 uncached + 2000 cache-read + 100 cache-write arrives as:\nUSAGE_SONNET = RequestUsage(\n    input_tokens=3100,\n    cache_read_tokens=2000,\n    cache_write_tokens=100,\n    output_tokens=500,\n)\n# Expected genai-prices cost on claude-sonnet-4-6 ($3/M uncached input,\n# 0.1x cache read, 1.25x cache write, $15/M output): $0.011475.\nEXPECTED_COST = 0.011475\n\n\ndef _history(model_name=\"claude-sonnet-4-6\"):\n    return [\n        ModelRequest(parts=[UserPromptPart(content=\"What is X?\")], timestamp=T0),\n        ModelResponse(\n            parts=[\n                TextPart(content=\"Let me check.\"),\n                ToolCallPart(tool_name=\"run_sql\", args={\"sql\": \"SELECT 1\"}),\n            ],\n            usage=USAGE_SONNET,\n            model_name=model_name,\n            provider_name=\"anthropic\",\n            provider_url=\"https://api.anthropic.com\",\n            timestamp=T0 + timedelta(seconds=2),\n        ),\n    ]","numLines":45,"startLine":1,"totalLines":205}}}
