{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017WnayvcrpLiERKgvi9R3GN","type":"tool_result","content":"The file /Users/shane/Projects/k-12Harness/harness/claude_account_cli.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"4a975106-0ac1-4d93-9678-77f65344e100","uuid":"bab9540f-1b56-459a-a6f0-6d2b7df2b651","timestamp":"2026-09-27T13:14:10.744Z","tool_use_result":{"filePath":"/Users/shane/Projects/k-12Harness/harness/claude_account_cli.py","oldString":"def _raise_for_result_error(stdout: bytes) -> None:","newString":"def _usage_block_counts(block: dict[str, Any]) -> tuple[int, int, int, int]:\n    \"\"\"Pull (base_input, output, cache_read, cache_write) ints out of a usage dict.\n\n    Tolerant of missing keys, non-int values, and either the Anthropic-style\n    snake_case names or a camelCase variant; never raises. Booleans are\n    excluded so `isinstance(x, int)` cannot smuggle a stray `True`/`False`\n    through as a token count.\n    \"\"\"\n\n    def _int(*keys: str) -> int:\n        for key in keys:\n            value = block.get(key)\n            if isinstance(value, int) and not isinstance(value, bool):\n                return value\n        return 0\n\n    base_input = _int(\"input_tokens\", \"inputTokens\")\n    output = _int(\"output_tokens\", \"outputTokens\")\n    cache_read = _int(\"cache_read_input_tokens\", \"cacheReadInputTokens\")\n    cache_write = _int(\"cache_creation_input_tokens\", \"cacheCreationInputTokens\")\n    return base_input, output, cache_read, cache_write\n\n\ndef _request_usage(envelope: dict[str, Any]) -> RequestUsage:\n    \"\"\"Map the CLI success envelope's `usage`/`modelUsage` into a `RequestUsage`.\n\n    ``input_tokens`` is set to base input plus cache read/write, per the\n    genai-prices convention pydantic-ai's ``RequestUsage`` follows (input\n    INCLUDES cache), even though the CLI reports it excluding cache. When the\n    envelope's `modelUsage` map names one or more models (main plus any\n    helper model), their counts are summed into the returned aggregate\n    instead of the top-level `usage` block, and a per-model, integer-only\n    breakdown keyed by model name is recorded in `details` alongside the raw\n    top-level totals for auditability (DECIDED C2, option (a): no schema\n    change). A missing or partial `usage`/`modelUsage` block yields zeroed\n    usage rather than raising (ADR-005 telemetry-never-fails). Only numeric\n    counts and model names are read here — never the CLI `result` text and\n    never any token/credential.\n    \"\"\"\n    top = envelope.get(\"usage\")\n    top = top if isinstance(top, dict) else {}\n    model_usage = envelope.get(\"modelUsage\")\n    model_usage = model_usage if isinstance(model_usage, dict) else {}\n\n    per_model: dict[str, tuple[int, int, int, int]] = {\n        name: _usage_block_counts(entry)\n        for name, entry in model_usage.items()\n        if isinstance(name, str) and isinstance(entry, dict)\n    }\n\n    if per_model:\n        base_input = sum(counts[0] for counts in per_model.values())\n        output_tokens = sum(counts[1] for counts in per_model.values())\n        cache_read_tokens = sum(counts[2] for counts in per_model.values())\n        cache_write_tokens = sum(counts[3] for counts in per_model.values())\n    else:\n        base_input, output_tokens, cache_read_tokens, cache_write_tokens = _usage_block_counts(top)\n\n    input_tokens = base_input + cache_read_tokens + cache_write_tokens\n\n    details: dict[str, int] = {}\n    if top:\n        top_base_input, top_output, top_cache_read, top_cache_write = _usage_block_counts(top)\n        details[\"usage.input_tokens\"] = top_base_input + top_cache_read + top_cache_write\n        details[\"usage.output_tokens\"] = top_output\n        details[\"usage.cache_read_tokens\"] = top_cache_read\n        details[\"usage.cache_write_tokens\"] = top_cache_write\n    for name, (m_input, m_output, m_cache_read, m_cache_write) in per_model.items():\n        details[f\"{name}.input_tokens\"] = m_input + m_cache_read + m_cache_write\n        details[f\"{name}.output_tokens\"] = m_output\n        details[f\"{name}.cache_read_tokens\"] = m_cache_read\n        details[f\"{name}.cache_write_tokens\"] = m_cache_write\n\n    return RequestUsage(\n        input_tokens=input_tokens,\n        output_tokens=output_tokens,\n        cache_read_tokens=cache_read_tokens,\n        cache_write_tokens=cache_write_tokens,\n        details=details,\n    )\n\n\ndef _raise_for_result_error(stdout: bytes) -> None:","originalFile":"\"\"\"Pydantic-AI adapter for Claude Code subscription-account inference.\n\nThe adapter invokes ``claude --print`` once per Pydantic-AI turn. Claude has\nno tools or MCP servers of its own; it may only select one action from the\nschema supplied by the outer harness. Pydantic-AI remains responsible for\nexecuting evidence tools, validating outputs, retries, and control limits.\n\nAuthentication is deliberately narrow. ``CLAUDE_CODE_OAUTH_TOKEN`` must\nalready be present in the process environment (normally by sourcing the\nmachine-level secrets file). API credentials and third-party-provider switches\nare removed from the child environment so this route cannot silently fall back\nto separately metered Anthropic API, Bedrock, Vertex, or Foundry usage.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport json\nimport os\nimport re\nimport shutil\nimport subprocess\nimport tempfile\nimport uuid\nfrom typing import Any\n\nfrom pydantic_ai import ModelMessagesTypeAdapter\nfrom pydantic_ai.messages import ModelMessage, ModelResponse, ToolCallPart\nfrom pydantic_ai.models.function import AgentInfo, FunctionModel\nfrom pydantic_ai.usage import RequestUsage\n\nfrom harness.errors import AuthError, QuotaExceeded\n\n\nclass ClaudeAccountCliError(RuntimeError):\n    \"\"\"The account-backed Claude CLI could not produce a model action.\"\"\"\n\n\n_NON_ACCOUNT_ENV_VARS = (\n    \"ANTHROPIC_API_KEY\",\n    \"ANTHROPIC_AUTH_TOKEN\",\n    \"CLAUDE_CODE_USE_BEDROCK\",\n    \"CLAUDE_CODE_USE_VERTEX\",\n    \"CLAUDE_CODE_USE_FOUNDRY\",\n)\n\n_SYSTEM_PROMPT = (\n    \"Return exactly one object satisfying the supplied JSON schema. You have no \"\n    \"tools and must not attempt to act outside this text-generation request.\"\n)\n\n\ndef _redact_account_token(text: str) -> str:\n    token = os.environ.get(\"CLAUDE_CODE_OAUTH_TOKEN\")\n    return text.replace(token, \"[REDACTED]\") if token else text\n\n\ndef _account_environment() -> dict[str, str]:\n    \"\"\"Return a child environment that can only select Claude account auth.\"\"\"\n    env = dict(os.environ)\n    if not env.get(\"CLAUDE_CODE_OAUTH_TOKEN\"):\n        raise ClaudeAccountCliError(\n            \"CLAUDE_CODE_OAUTH_TOKEN is not set; source the machine-level \"\n            \"secrets file before running the harness\"\n        )\n    for name in _NON_ACCOUNT_ENV_VARS:\n        env.pop(name, None)\n    return env\n\n\ndef claude_account_status(binary: str = \"claude\") -> tuple[bool, str]:\n    \"\"\"Check the exact token-backed environment used for inference.\"\"\"\n    resolved = shutil.which(binary)\n    if not resolved:\n        return False, f\"`{binary}` is not on PATH\"\n    try:\n        env = _account_environment()\n        result = subprocess.run(\n            [resolved, \"auth\", \"status\", \"--json\"],\n            capture_output=True,\n            text=True,\n            timeout=20,\n            check=False,\n            env=env,\n        )\n    except (OSError, subprocess.SubprocessError, ClaudeAccountCliError) as exc:\n        return False, str(exc)\n\n    detail = (result.stdout + result.stderr).strip()\n    if result.returncode != 0:\n        return False, _redact_account_token(detail) or f\"exit {result.returncode}\"\n    try:\n        status = json.loads(result.stdout)\n    except json.JSONDecodeError:\n        return False, \"`claude auth status --json` returned invalid JSON\"\n    if not status.get(\"loggedIn\"):\n        return False, \"Claude CLI reports loggedIn=false\"\n    method = status.get(\"authMethod\", \"unknown\")\n    provider = status.get(\"apiProvider\", \"unknown\")\n    return True, f\"logged in ({method}, {provider})\"\n\n\ndef _action_schema(tool_names: list[str]) -> dict[str, Any]:\n    return {\n        \"type\": \"object\",\n        \"properties\": {\n            \"tool_name\": {\"type\": \"string\", \"enum\": tool_names},\n            \"arguments_json\": {\n                \"type\": \"string\",\n                \"description\": \"A JSON-encoded object satisfying the selected tool schema\",\n            },\n        },\n        \"required\": [\"tool_name\", \"arguments_json\"],\n        \"additionalProperties\": False,\n    }\n\n\ndef _split_system_prompt(\n    messages: list[ModelMessage],\n) -> tuple[str, list[dict[str, Any]]]:\n    \"\"\"Remove duplicate Pydantic instructions from later request messages.\n\n    Pydantic repeats the 13 KB frozen policy on every ModelRequest. Preserve its\n    first occurrence in the conversation, where the proven CLI route expects\n    it, and remove later copies. SystemPromptPart remains supported separately.\n    \"\"\"\n    history = json.loads(ModelMessagesTypeAdapter.dump_json(messages))\n    instructions: list[str] = []\n    embedded_instructions: str | None = None\n    cleaned: list[dict[str, Any]] = []\n    for message in history:\n        copy = dict(message)\n        # Current Pydantic-AI serialises instructions on ModelRequest itself\n        # (and repeats them on later requests), rather than as a\n        # SystemPromptPart. Support both shapes so upgrades cannot silently\n        # reintroduce the repeated 13 KB policy.\n        request_instructions = copy.pop(\"instructions\", None)\n        if isinstance(request_instructions, str) and embedded_instructions is None:\n            embedded_instructions = request_instructions\n            copy[\"instructions\"] = request_instructions\n        parts = []\n        for part in message.get(\"parts\", []):\n            if part.get(\"part_kind\") == \"system-prompt\":\n                content = part.get(\"content\")\n                if isinstance(content, str) and content not in instructions:\n                    instructions.append(content)\n            else:\n                parts.append(part)\n        copy[\"parts\"] = parts\n        if parts:\n            cleaned.append(copy)\n    system = _SYSTEM_PROMPT\n    if instructions:\n        system += \"\\n\\n\" + \"\\n\\n\".join(instructions)\n    return system, cleaned\n\n\ndef _has_evidence_result(history: list[dict[str, Any]]) -> bool:\n    return any(\n        part.get(\"part_kind\") == \"tool-return\" and part.get(\"tool_name\") == \"fetch_evidence\"\n        for message in history\n        for part in message.get(\"parts\", [])\n    )\n\n\ndef _prompt(\n    history: list[dict[str, Any]], info: AgentInfo\n) -> tuple[str, list[str]]:\n    # Once evidence has returned successfully, the question is settled. Hiding\n    # function-tool schemas from the rendering turn shrinks the changing suffix\n    # and prevents an unnecessary second fetch; output validation can still ask\n    # the model to repair its terminal draft.\n    available = (\n        list(info.output_tools)\n        if _has_evidence_result(history)\n        else [*info.function_tools, *info.output_tools]\n    )\n    tools = [\n        {\n            \"name\": tool.name,\n            \"kind\": tool.kind,\n            \"description\": tool.description,\n            \"arguments_schema\": tool.parameters_json_schema,\n        }\n        for tool in available\n    ]\n    prompt = (\n        \"You are the model inside a Pydantic-AI tool loop. Follow the system \"\n        \"instructions contained in the conversation. Select exactly one available \"\n        \"tool for the next step. Function tools continue the loop; output tools end \"\n        \"it. arguments_json must be a JSON-encoded object satisfying the selected \"\n        \"tool's arguments_schema.\\n\\n\"\n        f\"AVAILABLE TOOLS:\\n{json.dumps(tools, ensure_ascii=False)}\\n\\n\"\n        f\"CONVERSATION:\\n{json.dumps(history, ensure_ascii=False)}\"\n    )\n    return prompt, [tool.name for tool in available]\n\n\ndef _structured_action(stdout: bytes) -> dict[str, Any]:\n    \"\"\"Extract structured output from Claude CLI's JSON result envelope.\"\"\"\n    try:\n        envelope = json.loads(stdout.decode(\"utf-8\"))\n    except (UnicodeDecodeError, json.JSONDecodeError) as exc:\n        raise ClaudeAccountCliError(f\"invalid JSON from `claude --print`: {exc}\") from exc\n\n    action = envelope.get(\"structured_output\")\n    if action is None:\n        action = envelope.get(\"result\")\n        if isinstance(action, str):\n            try:\n                action = json.loads(action)\n            except json.JSONDecodeError as exc:\n                raise ClaudeAccountCliError(\n                    \"`claude --print` result did not contain structured output\"\n                ) from exc\n    if not isinstance(action, dict):\n        raise ClaudeAccountCliError(\"`claude --print` returned no structured action\")\n    return action\n\n\ndef _result_envelope(stdout: bytes) -> dict[str, Any] | None:\n    \"\"\"Best-effort decoding for CLI failures without ever echoing raw JSON.\"\"\"\n    try:\n        envelope = json.loads(stdout.decode(\"utf-8\"))\n    except (UnicodeDecodeError, json.JSONDecodeError):\n        return None\n    return envelope if isinstance(envelope, dict) else None\n\n\ndef _raise_for_result_error(stdout: bytes) -> None:\n    \"\"\"Turn Claude's structured error result into a concise typed exception.\"\"\"\n    envelope = _result_envelope(stdout)\n    if not envelope or not envelope.get(\"is_error\"):\n        return\n\n    status = envelope.get(\"api_error_status\")\n    result = envelope.get(\"result\")\n    detail = result.strip() if isinstance(result, str) else \"Claude CLI request failed\"\n    lowered = detail.lower()\n    if \"not logged in\" in lowered or \"please run /login\" in lowered:\n        raise AuthError(\n            \"Claude subscription authentication is not usable; run `claude /login` \"\n            \"and refresh CLAUDE_CODE_OAUTH_TOKEN\",\n            status_code=401,\n        )\n    definitive_limit = (\n        \"session limit\" in lowered\n        or \"usage limit\" in lowered\n        or \"resets\" in lowered\n        or (\"hit your\" in lowered and \"limit\" in lowered)\n    )\n    if status == 429 and definitive_limit:\n        match = re.search(r\"\\bresets?\\s+(.+)$\", detail, flags=re.IGNORECASE)\n        reset_at = match.group(1).strip() if match else None\n        message = \"Claude subscription quota exhausted\"\n        if reset_at:\n            message += f\"; resets {reset_at}\"\n        raise QuotaExceeded(message, provider=\"claude-account\", reset_at=reset_at)\n\n    status_text = f\" (HTTP {status})\" if isinstance(status, int) else \"\"\n    raise ClaudeAccountCliError(f\"Claude CLI request failed{status_text}: {detail}\")\n\n\ndef _claude_command(\n    resolved: str,\n    schema: str,\n    empty_mcp: str,\n    model: str | None,\n    system_prompt: str = _SYSTEM_PROMPT,\n) -> list[str]:\n    command = [\n        resolved,\n        \"--print\",\n        \"--output-format\",\n        \"json\",\n        \"--json-schema\",\n        schema,\n        \"--system-prompt\",\n        system_prompt,\n        \"--tools\",\n        \"\",\n        \"--strict-mcp-config\",\n        \"--mcp-config\",\n        empty_mcp,\n        \"--disable-slash-commands\",\n        \"--no-session-persistence\",\n        \"--permission-mode\",\n        \"dontAsk\",\n        \"--setting-sources\",\n        \"\",\n    ]\n    if model:\n        command.extend([\"--model\", model])\n    return command\n\n\nasync def _invoke_claude(\n    messages: list[ModelMessage],\n    info: AgentInfo,\n    *,\n    binary: str,\n    model: str | None,\n    timeout_seconds: int,\n) -> ModelResponse:\n    resolved = shutil.which(binary)\n    if not resolved:\n        raise ClaudeAccountCliError(f\"`{binary}` is not on PATH\")\n\n    system_prompt, history = _split_system_prompt(messages)\n    prompt, tool_names = _prompt(history, info)\n    if not tool_names:\n        raise ClaudeAccountCliError(\"Pydantic-AI supplied no function or output tools\")\n\n    schema = json.dumps(_action_schema(tool_names), separators=(\",\", \":\"))\n    empty_mcp = json.dumps({\"mcpServers\": {}}, separators=(\",\", \":\"))\n    with tempfile.TemporaryDirectory(prefix=\"k12-harness-claude-\") as temp:\n        command = _claude_command(resolved, schema, empty_mcp, model, system_prompt)\n\n        process = await asyncio.create_subprocess_exec(\n            *command,\n            cwd=temp,\n            stdin=asyncio.subprocess.PIPE,\n            stdout=asyncio.subprocess.PIPE,\n            stderr=asyncio.subprocess.PIPE,\n            env=_account_environment(),\n        )\n        try:\n            stdout, stderr = await asyncio.wait_for(\n                process.communicate(prompt.encode(\"utf-8\")),\n                timeout=timeout_seconds,\n            )\n        except BaseException:\n            if process.returncode is None:\n                process.kill()\n                await process.wait()\n            raise\n\n    # A quota response can carry a syntactically valid structured_output at the\n    # same time as is_error=true. The account state wins: accepting that action\n    # would contaminate the measurement at the reset boundary.\n    _raise_for_result_error(stdout)\n    if process.returncode != 0:\n        detail = _redact_account_token(\n            (stderr or stdout).decode(\"utf-8\", errors=\"replace\").strip()\n        )\n        raise ClaudeAccountCliError(\n            f\"`claude --print` exited {process.returncode}: {detail[-2000:]}\"\n        )\n    action = _structured_action(stdout)\n    if action.get(\"tool_name\") not in tool_names or not isinstance(\n        action.get(\"arguments_json\"), str\n    ):\n        raise ClaudeAccountCliError(f\"invalid action from `claude --print`: {action!r}\")\n    try:\n        arguments = json.loads(action[\"arguments_json\"])\n    except json.JSONDecodeError as exc:\n        raise ClaudeAccountCliError(\n            f\"invalid tool arguments from `claude --print`: {exc}\"\n        ) from exc\n    if not isinstance(arguments, dict):\n        raise ClaudeAccountCliError(\"tool arguments from `claude --print` are not an object\")\n\n    return ModelResponse(\n        parts=[\n            ToolCallPart(\n                tool_name=action[\"tool_name\"],\n                args=arguments,\n                tool_call_id=f\"claude-{uuid.uuid4().hex}\",\n            )\n        ],\n        model_name=model or \"account-default\",\n        provider_name=\"claude-account\",\n        finish_reason=\"tool_call\",\n    )\n\n\ndef build_claude_account_model(\n    *,\n    binary: str = \"claude\",\n    model: str | None = None,\n    timeout_seconds: int = 110,\n) -> FunctionModel:\n    \"\"\"Build a model that delegates each turn to locked-down ``claude -p``.\"\"\"\n\n    async def request(messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:\n        return await _invoke_claude(\n            messages,\n            info,\n            binary=binary,\n            model=model,\n            timeout_seconds=timeout_seconds,\n        )\n\n    return FunctionModel(request, model_name=f\"claude-account:{model or 'default'}\")\n","structuredPatch":[{"oldStart":227,"oldLines":6,"newStart":227,"newLines":88,"lines":["     return envelope if isinstance(envelope, dict) else None"," "," ","+def _usage_block_counts(block: dict[str, Any]) -> tuple[int, int, int, int]:","+    \"\"\"Pull (base_input, output, cache_read, cache_write) ints out of a usage dict.","+","+    Tolerant of missing keys, non-int values, and either the Anthropic-style","+    snake_case names or a camelCase variant; never raises. Booleans are","+    excluded so `isinstance(x, int)` cannot smuggle a stray `True`/`False`","+    through as a token count.","+    \"\"\"","+","+    def _int(*keys: str) -> int:","+        for key in keys:","+            value = block.get(key)","+            if isinstance(value, int) and not isinstance(value, bool):","+                return value","+        return 0","+","+    base_input = _int(\"input_tokens\", \"inputTokens\")","+    output = _int(\"output_tokens\", \"outputTokens\")","+    cache_read = _int(\"cache_read_input_tokens\", \"cacheReadInputTokens\")","+    cache_write = _int(\"cache_creation_input_tokens\", \"cacheCreationInputTokens\")","+    return base_input, output, cache_read, cache_write","+","+","+def _request_usage(envelope: dict[str, Any]) -> RequestUsage:","+    \"\"\"Map the CLI success envelope's `usage`/`modelUsage` into a `RequestUsage`.","+","+    ``input_tokens`` is set to base input plus cache read/write, per the","+    genai-prices convention pydantic-ai's ``RequestUsage`` follows (input","+    INCLUDES cache), even though the CLI reports it excluding cache. When the","+    envelope's `modelUsage` map names one or more models (main plus any","+    helper model), their counts are summed into the returned aggregate","+    instead of the top-level `usage` block, and a per-model, integer-only","+    breakdown keyed by model name is recorded in `details` alongside the raw","+    top-level totals for auditability (DECIDED C2, option (a): no schema","+    change). A missing or partial `usage`/`modelUsage` block yields zeroed","+    usage rather than raising (ADR-005 telemetry-never-fails). Only numeric","+    counts and model names are read here — never the CLI `result` text and","+    never any token/credential.","+    \"\"\"","+    top = envelope.get(\"usage\")","+    top = top if isinstance(top, dict) else {}","+    model_usage = envelope.get(\"modelUsage\")","+    model_usage = model_usage if isinstance(model_usage, dict) else {}","+","+    per_model: dict[str, tuple[int, int, int, int]] = {","+        name: _usage_block_counts(entry)","+        for name, entry in model_usage.items()","+        if isinstance(name, str) and isinstance(entry, dict)","+    }","+","+    if per_model:","+        base_input = sum(counts[0] for counts in per_model.values())","+        output_tokens = sum(counts[1] for counts in per_model.values())","+        cache_read_tokens = sum(counts[2] for counts in per_model.values())","+        cache_write_tokens = sum(counts[3] for counts in per_model.values())","+    else:","+        base_input, output_tokens, cache_read_tokens, cache_write_tokens = _usage_block_counts(top)","+","+    input_tokens = base_input + cache_read_tokens + cache_write_tokens","+","+    details: dict[str, int] = {}","+    if top:","+        top_base_input, top_output, top_cache_read, top_cache_write = _usage_block_counts(top)","+        details[\"usage.input_tokens\"] = top_base_input + top_cache_read + top_cache_write","+        details[\"usage.output_tokens\"] = top_output","+        details[\"usage.cache_read_tokens\"] = top_cache_read","+        details[\"usage.cache_write_tokens\"] = top_cache_write","+    for name, (m_input, m_output, m_cache_read, m_cache_write) in per_model.items():","+        details[f\"{name}.input_tokens\"] = m_input + m_cache_read + m_cache_write","+        details[f\"{name}.output_tokens\"] = m_output","+        details[f\"{name}.cache_read_tokens\"] = m_cache_read","+        details[f\"{name}.cache_write_tokens\"] = m_cache_write","+","+    return RequestUsage(","+        input_tokens=input_tokens,","+        output_tokens=output_tokens,","+        cache_read_tokens=cache_read_tokens,","+        cache_write_tokens=cache_write_tokens,","+        details=details,","+    )","+","+"," def _raise_for_result_error(stdout: bytes) -> None:","     \"\"\"Turn Claude's structured error result into a concise typed exception.\"\"\"","     envelope = _result_envelope(stdout)"]}],"userModified":false,"replaceAll":false}}
